shape=box;
	subprogram_body
	program_body
	task_body
        }
        subgraph cluster_ALL_DECL_ITEM_DECL { label="SUBUNIT_BODY";

	decl_s
	null_comp_decl
	subgraph cluster_ALL_DECL_ITEM_ID_DECL { label="SUBUNIT_BODY";

	  type_decl
	  subtype_decl
	  task_decl
	}

        }

      }

    }

  }

}
