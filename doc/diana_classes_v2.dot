graph DIANA_Classes {
  layout=osage;
  fontname="Verdana"; fontsize=9;
  pack=10;
  packmode=array_tu2;
  sep=5;

  node [
    shape=box,
    fontname="Liberation Sans",
    fontsize=11,
    height=0,
    width=0,
    margin=0.04,
    fixedsize=false,
    peripheries=1
  ];
  subgraph cluster_top_grp1				{ label=""; sortv=0; peripheries=0;

    subgraph cluster_STANDARD_IDL			{ label="STANDARD_IDL"; sortv=0; peripheries=1;
      root
      txtrep
      num_val
      nil
      list
      sourceline
      error
      symbol_rep
      hash
      void
    
      subgraph cluster_BOOLEAN			{ label="BOOLEAN";
        false
        true
      }
    }
    trou_post_standard_idl  [label=""; sortv=1; invis=true; peripheries=0;]

			// TYPE_SPEC
    subgraph cluster_TYPE_SPEC			{ label="TYPE_SPEC";sortv=2; peripheries=1;

      subgraph cluster_group_universal			{ label=""; sortv=0; peripheries=0;
        subgraph cluster_group_universal_1		{ label=""; sortv=0; peripheries=0;
        universal_integer	[sortv=0]
        universal_fixed	[sortv=1]
        }

        subgraph cluster_group_universal_2		{ label=""; sortv=1; peripheries=0;
	universal_real	[sortv=0]
	incomplete	[sortv=1]
        }
      }
      trou_post_group_universal  [label=""; sortv=1; invis=true; peripheries=0;]

      subgraph cluster_DERIVABLE_SPEC			{ label="DERIVABLE_SPEC"; sortv=2;

        subgraph cluster_FULL_TYPE_SPEC			{ label="FULL_TYPE_SPEC"; sortv=0;

	subgraph cluster_NON_TASK			{ label="NON_TASK"; sortv=0;

	  subgraph cluster_SCALAR			{ label="SCALAR";

	    subgraph cluster_group_discrete		{ label=""; sortv=0; peripheries=0;
	      enumeration	[sortv=0;]
	      Integer	[sortv=1;]
	    }
	    subgraph cluster_REAL			{ label="REAL";
	      float
 	      fixed
	    }
	  }

	  subgraph cluster_UNCONSTRAINED		{ label="UNCONSTRAINED";
	    access

	    subgraph cluster_UNCONSTRAINED_COMPOSITE	{ label="UNCONSTRAINED_COMPOSITE";
	      array
	      record
	    }
	  }

	  subgraph cluster_CONSTRAINED		{ label="CONSTRAINED";
	    constrained_array
	    constrained_record
	    constrained_access
	  }
	}
          trou_post_non_task  [label=""; sortv=1; invis=true; peripheries=0;]

	task_spec	[sortv=2]

        }
        trou_post_full_type_spec  [label=""; sortv=1; invis=true; peripheries=0;]

        subgraph cluster_PRIVATE_SPEC			{ label="PRIVATE_SPEC"; sortv=2;
	private
	l_private
        }
      }
    }
    trou_post_type_spec  [label=""; sortv=3; invis=true; peripheries=0;]

    subgraph cluster_NON_DIANA			{ label="NON_DIANA"; sortv=4; peripheries=1;
      user_root
      real_val
      trans_with
      lib_info
      def
      implicit_conv
      nullary_call

      subgraph cluster_UNSPECIFIED_TYPE {
        label="UNSPECIFIED_TYPE";
        any_integer
        any_real
        any_access
        any_composite
        any_string
        any_access_of
      }
    }
  }
//
//				ALL_SOURCE
//
  subgraph cluster_ALL_SOURCE			{ label="ALL_SOURCE"; sortv=0;
    
    subgraph cluster_all_source_grp_compilation	{ label=""; sortv=0;
      compilation		[sortv=0]
      compilation_unit 	[sortv=1]
    }
			// all_source.CONTEXT_ELEM
    subgraph cluster_CONTEXT_ELEM		{ label="CONTEXT_ELEM"; sortv=1;
      context_pragma
      with
    }
			// all_source.ALL_DECL
    subgraph cluster_ALL_DECL			{ label="ALL_DECL"; sortv=2;

      subgraph cluster_ITEM_grp1		{ label=""; sortv=0;
        subunit		[sortv=0]
        block_master	[sortv=1]
      }
      trou_post_item  [label=""; sortv=1; invis=true; peripheries=0;]

			// all_source.all_decl.ITEM
      subgraph cluster_ITEM			{ label="ITEM"; sortv=2;

        subgraph cluster_group_subunit		{ label=""; sortv=0; peripheries=0;

			// all_source.all_decl.item.SUBUNIT_BODY
	subgraph cluster_SUBUNIT_BODY		{ label="SUBUNIT_BODY"; sortv=0; peripheries=1;
	  subprogram_body
	  package_body
	  task_body
	}
			// all_source.all_decl.item.DSCRMT_PARAM_DECL
	subgraph cluster_DSCRMT_PARAM_DECL	{ label="DSCRMT_PARAM_DECL"; sortv=1; peripheries=1;

	  dscrmt_decl

	  subgraph cluster_PARAM		{ label="PARAM";
	    in
	    in_out
	    out
            }
          }
        }
        trou_post_group_subunit [label=""; sortv=1; invis=true; peripheries=0;]

			// all_source.all_decl.item.DECL
        subgraph cluster_DECL			{ label="DECL"; sortv=2;

          null_comp_decl	[sortv=0]
          trou [label=""; sortv=1; invis=true; peripheries=0;]

			// all_source.all_decl.item.decl.ID_DECL
          subgraph cluster_ID_DECL		{ label="ID_DECL"; sortv=2;

            subgraph cluster_goup_ID_DECL	{ label=""; peripheries=0; sortv=0;
	    type_decl	[sortv=0]
	    subtype_decl	[sortv=1]
	    task_decl	[sortv=2]
	  }
            subgraph cluster_UNIT_DECL		{ label="UNIT_DECL"; sortv=1;

              generic_decl

              subgraph cluster_NON_GENERIC_DECL	{ label="NON_GENERIC_DECL";
                subprog_entry_decl
                package_decl
              }
            }
            subgraph cluster_SIMPLE_RENAME_DECL	{ label="SIMPLE_RENAME_DECL"; sortv=3;
              renames_obj_decl
              renames_exc_decl
            }
	}

			// all_source.all_decl.item.decl.ID_S_DECL
          subgraph cluster_ID_S_DECL		{ label="ID_S_DECL"; sortv=3;

            number_decl
            deferred_constant_decl
            exception_decl

            subgraph cluster_EXP_DECL		{ label="EXP_DECL";

              subgraph cluster_OBJECT_DECL	{ label="OBJECT_DECL";
                constant_decl
                variable_decl
              }
            }
          }

			// all_source.all_decl.item.decl.USE_PRAGMA
          subgraph cluster_USE_PRAGMA		{ label="USE_PRAGMA"; sortv=4;
	  use_pragma_s
            pragma
            use
          }

			// all_source.all_decl.item.decl.REP
          subgraph cluster_REP		{ label="REP"; sortv=5;

            record_rep

            subgraph cluster_NAMED_REP {
              label="NAMED_REP";
              length_enum_rep
              address
            }
          }
        }
      }
    }

    subgraph cluster_group_type_def		{ label=""; sortv=3; peripheries=0;

//      trou_post_header [label=""; sortv=1; invis=true; peripheries=0;]

			// all_source.TYPE_DEF
      subgraph cluster_TYPE_DEF		{ label="TYPE_DEF"; sortv=2; peripheries=1;
        enumeration_def
        record_def
        private_def
        l_private_def
        formal_dscrt_def
        formal_fixed_def
        formal_float_def
        formal_integer_def

        subgraph cluster_CONSTRAINED_DEF	{ label="CONSTRAINED_DEF";
	subtype_indication
	integer_def
	float_def
	fixed_def
        }

        subgraph cluster_ARR_ACC_DER_DEF	{ label="ARR_ACC_DER_DEF";
	derived_def
	constrained_array_def
	unconstrained_array_def
	access_def
        }
      }
      trou_post_TYPE_DEF [label=""; sortv=3; invis=true; peripheries=0;]

			// all_source.CONSTRAINT
      subgraph cluster_CONSTRAINT		{ label="CONSTRAINT"; sortv=4; peripheries=1;
        index_constraint
        dscrmt_constraint

        subgraph cluster_DISCRETE_RANGE		{ label="DISCRETE_RANGE";
	discrete_subtype

	subgraph cluster_RANGE		{ label="RANGE";
	  range
	  range_attribute
	}
        }

        subgraph cluster_REAL_CONSTRAINT	{ label="REAL_CONSTRAINT";
	float_constraint
	fixed_constraint
        }
      }
      trou_post_constraint [label=""; sortv=5; invis=true; peripheries=0;]

     subgraph cluster_group_variant		{ label=""; sortv=6; peripheries=0;

        comp_list [sortv=0; peripheries=1;]

        subgraph cluster_VARIANT_PART		{ label="VARIANT_PART"; sortv=1; peripheries=1;
	variant_part
        }
        trou_post_variant_part [label=""; sortv=2; invis=true; peripheries=0;]

        subgraph cluster_VARIANT_ELEM		{ label="VARIANT_ELEM"; sortv=3; peripheries=1;
	variant
	variant_pragma
        }
      }

    }

    subgraph cluster_group_header		{ label=""; peripheries=0; sortv=4;

			// all_source.HEADER
      subgraph cluster_HEADER			{ label="HEADER"; sortv=0; peripheries=1;
        package_spec
			// all_source.header.SUBP_ENTRY_HEADER

        subgraph cluster_SUBP_ENTRY_HEADER	{ label="SUBP_ENTRY_HEADER"; sortv=0;peripheries=1;
	procedure_spec
	function_spec
	entry
        }
      }

      subgraph cluster_group_alignment		{ label=""; peripheries=0; sortv=4;

        subgraph cluster_ALIGNMENT_CLAUSE		{ label="ALIGNMENT_CLAUSE"; sortv=1; peripheries=1;
          alignment
        }

        subgraph cluster_COMP_REP_ELEM		{ label="COMP_REP_ELEM"; sortv=2; peripheries=1;
	comp_rep
	comp_rep_pragma
        }
      }
    }
    index [sortv=5]

			// all_source.DEF_NAME
    subgraph cluster_DEF_NAME			{ label="DEF_NAME"; sortv=6;
      
      subgraph cluster_SOURCE_NAME		{ label="SOURCE_NAME";
        entry_id
        exception_id
        
        subgraph cluster_OBJECT_NAME		{ label="OBJECT_NAME";
          
          subgraph cluster_INIT_OBJECT_NAME	{ label="INIT_OBJECT_NAME";
            number_id
            iteration_id
            
            subgraph cluster_VC_NAME		{ label="VC_NAME";
              variable_id
              constant_id
            }
            
            subgraph cluster_COMP_NAME		{ label="COMP_NAME";
              component_id
              discriminant_id
            }
            
            subgraph cluster_PARAM_NAME		{ label="PARAM_NAME";
              in_id
              
              subgraph cluster_PARAM_IO_O	{ label="PARAM_IO_O";
                in_out_id
                out_id
              }
            }
          }
          
          subgraph cluster_ENUM_LITERAL		{ label="ENUM_LITERAL";
            enumeration_id
            character_id
          }
        }
        
        subgraph cluster_TYPE_NAME		{ label="TYPE_NAME";
          type_id
          subtype_id
          private_type_id
          l_private_type_id
        }
        
        subgraph cluster_UNIT_NAME		{ label="UNIT_NAME";
          task_body_id
          
          subgraph cluster_NON_TASK_NAME	{ label="NON_TASK_NAME";
            generic_id
            
            subgraph cluster_SUBPROG_PACK_NAME	{ label="SUBPROG_PACK_NAME";
              package_id
              
              subgraph cluster_SUBPROG_NAME	{ label="SUBPROG_NAME";
                procedure_id
                function_id
                operator_id
              }
            }
          }
        }
        
        subgraph cluster_LABEL_NAME		{ label="LABEL_NAME";
          label_id
          block_loop_id
        }
      }
      
      subgraph cluster_PREDEF_NAME		{ label="PREDEF_NAME";
        attribute_id
        argument_id
        bltn_operator_id
        pragma_id
      }
    }

			// all_source.GENERAL_ASSOC

    subgraph cluster_GENERAL_ASSOC		{ label="GENERAL_ASSOC"; sortv=8;

      subgraph cluster_NAMED_ASSOC		{ label="NAMED_ASSOC"; sortv=0;
        named
        assoc
      }
      trou_post_named_assoc  [label=""; sortv=1; invis=true; peripheries=0;]

      subgraph cluster_EXP			{ label="EXP"; sortv=2;
        
        subgraph cluster_NAME			{ label="NAME";
          
          subgraph cluster_DESIGNATOR		{ label="DESIGNATOR";
            
            subgraph cluster_USED_NAME		{ label="USED_NAME";
              used_op
              used_name_id
            }
            
            subgraph cluster_USED_OBJECT	{ label="USED_OBJECT";
              used_char
              used_object_id
            }
          }
          
          subgraph cluster_NAME_EXP		{ label="NAME_EXP";
            indexed
            slice
            all
            
            subgraph cluster_NAME_VAL		{ label="NAME_VAL";
              selected
              attribute
              function_call
            }
          }
        }
        
        subgraph cluster_EXP_EXP		{ label="EXP_EXP";
          qualified_allocator
          subtype_allocator
          
          subgraph cluster_AGG_EXP		{ label="AGG_EXP";
            aggregate
            string_literal
          }
          
          subgraph cluster_EXP_VAL		{ label="EXP_VAL";
            short_circuit
            numeric_literal
            null_access
            
            subgraph cluster_EXP_VAL_EXP	{ label="EXP_VAL_EXP";
              parenthesized
              
              subgraph cluster_MEMBERSHIP	{ label="MEMBERSHIP";
                range_membership
                type_membership
              }
              
              subgraph cluster_QUAL_CONV	{ label="QUAL_CONV";
                conversion
                qualified
              }
            }
          }
        }
      }
    }

			// all_source.STM_ELEM
    subgraph cluster_STM_ELEM			{ label="STM_ELEM"; sortv=9;
      stm_pragma

      subgraph cluster_STM			{ label="STM";
        labeled
        null_stm
        accept
        terminate
        abort

        subgraph cluster_STM_WITH_EXP		{ label="STM_WITH_EXP";
          case
          return
          delay

          subgraph cluster_STM_WITH_EXP_NAME	{ label="STM_WITH_EXP_NAME";
            assign
            exit
            code

            subgraph cluster_CALL_STM		{ label="CALL_STM";
              procedure_call
              entry_call
            }
          }
        }

        subgraph cluster_CLAUSES_STM		{ label="CLAUSES_STM";
          if
          selective_wait
        }

        subgraph cluster_BLOCK_LOOP		{ label="BLOCK_LOOP";
          loop
          block
        }

        subgraph cluster_STM_WITH_NAME		{ label="STM_WITH_NAME";
          goto
          raise
        }

        subgraph cluster_ENTRY_STM		{ label="ENTRY_STM";
          cond_entry
          timed_entry
        }
      }
    }

    subgraph cluster_short_grp { label=""; sortv=10; peripheries=0;

      subgraph cluster_SHORT_CIRCUIT_OP		{ label="SHORT_CIRCUIT_OP"; sortv=0;peripheries=1;
        and_then
        or_else
      }
    
      subgraph cluster_MEMBERSHIP_OP		{ label="MEMBERSHIP_OP"; sortv=1;peripheries=1;
        in_op
        not_in
      }
    }
    

  subgraph cluster_iteration_grp		{ label=""; sortv=11; peripheries=0;

// all_source.ITERATION

    subgraph cluster_ITERATION		{ label="ITERATION"; sortv=0; peripheries=1;
      
      while
      
      subgraph cluster_FOR_REV		{ label="FOR_REV";
        for
        reverse
      }
    }
    subgraph cluster_TEST_CLAUSE_ELEM		{ label="TEST_CLAUSE_ELEM"; sortv=1; peripheries=1;
      select_alt_pragma

      subgraph cluster_TEST_CLAUSE		{ label="TEST_CLAUSE"; sortv=38;
        cond_clause
        select_alternative
      }
    }
  }

  subgraph cluster_unit_desc_grp		{ label=""; sortv=7; peripheries=0;

    subgraph cluster_UNIT_DESC		{ label="UNIT_DESC"; sortv=0; peripheries=1;
      
      derived_subprog
      implicit_not_eq
      
      subgraph cluster_BODY			{ label="BODY";
        block_body
        stub
      }
      
      subgraph cluster_UNIT_KIND		{ label="UNIT_KIND";
        
        subgraph cluster_GENERIC_PARAM		{ label="GENERIC_PARAM";
          name_default
          box_default
          no_default
        }
        
        subgraph cluster_RENAME_INSTANT		{ label="RENAME_INSTANT";
          renames_unit
          instantiation
        }
      }
    }

    trou_post_unif_desc  [label=""; sortv=1; invis=true; peripheries=0;]

    subgraph cluster_alternative_grp		{ label=""; sortv=2; peripheries=0;

      subgraph cluster_ALTERNATIVE_ELEM		{ label="ALTERNATIVE_ELEM"; sortv=0; peripheries=1;
        alternative
        alternative_pragma
      }
      subgraph cluster_CHOICE			{ label="CHOICE"; sortv=1; peripheries=1;
        choice_exp
        choice_range
        choice_others
      }
    }
  }
}
}
