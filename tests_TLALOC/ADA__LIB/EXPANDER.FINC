namespace ANON_87_57_aga
  VAR _FST_1, D
  VAR _LST_1, D
  VAR _LEN_1, D
  VAR _STR_1, D
  VAR _PTR_1, Q
  VAR _CNT_1, D
  VAR _EMIS_1, D
end namespace
	LI	0
	SD  1, ANON_87_57_aga._FST_1
	LI	2
	LI	5
	DEC
	SHL
	LI	1
	SUB
	SD  1, ANON_87_57_aga._LST_1
	LD  1, ANON_87_57_aga._LST_1
	LD  1, ANON_87_57_aga._FST_1
	SUB
	INC
	CLAMP0
	SD  1, ANON_87_57_aga._LEN_1
	LI	1
	SD  1, ANON_87_57_aga._STR_1
	SA  1, ANON_87_57_aga._PTR_1
	LI	0
	SD  1, ANON_87_57_aga._EMIS_1
	LD  1, ANON_87_57_aga._LEN_1
	LD  1, ANON_87_57_aga._EMIS_1
	SUB
	SD  1, ANON_87_57_aga._CNT_1
	LD  1, ANON_87_57_aga._CNT_1
	LI	0
	CLE
	BT  L4
L3:
	LI	0
	SIB  1, ANON_87_57_aga._PTR_1, 0
	LA  1, ANON_87_57_aga._PTR_1
	LD  1, ANON_87_57_aga._STR_1
	ADD
	SA  1, ANON_87_57_aga._PTR_1
	LD  1, ANON_87_57_aga._EMIS_1
	INC
	SD  1, ANON_87_57_aga._EMIS_1
	LD  1, ANON_87_57_aga._CNT_1
	DEC
	DUP
	SD  1, ANON_87_57_aga._CNT_1
	LI	0
	CGT
	BT  L3
L4:

