     ¬¬¬¬--| TTE DE LISTE¶        N1¬: INTEGER¬¬:= DI( XD_TER_NBR, H1 );¬¬¬¬--| N DE¬LA TTE¶        NV¬: INTEGER¬¬:= DI( XD_TER_NBR, V );¬¬¬¬--| N DE¬L'LME
0030 NT¶      BEGIN¶        IF N1 = NV THEN¬¬¬¬¬¬¬¬--| N IDENTIQUES¶¬RETURN TRUE;¬¬¬¬¬¬¬¬--| L'LMENT EST DANS LA LISTE¶        ELSIF NV < N1 THEN¬¬¬¬¬¬¬¬--
     | N D'LMENT INFRIEUR¶¬RETURN FALSE;¬¬¬¬¬¬¬¬--| L'LMENT N'EST¬PAS DANS LA LISTE (ORDONNE CROISSANTE)¶        ELSE¬¬¬¬¬¬¬¬¬--| LE N¬D'LMENT¬EST POSTRIEU
     R¶¬RETURN MEMBER( TAIL( L1 ), V );¬¬¬¬¬¬--| REFAIRE L'OPRATION SUR LE RESTE DE¬LA LISTE¶        END IF;¶      END;¶    END IF;¶  END MEMBER;¶  --|||||
     |||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||¶  --|¬¬FUNCTION R_UNION¶  FUNCTION R_UNION ( L1 :SEQ_TYPE;
      V :TREE ) RETURN SEQ_TYPE IS¶  BEGIN¶    IF IS_EMPTY( L1¬) THEN¬¬¬¬¬¬¬¬--| LISTE¬VIDE¶      RETURN INSERT( L1, V );¬¬¬¬¬¬¬¬--| RETOURNER LA LISTE AVE
     C L'LMENT EN TTE¶    ELSE¬¬¬¬¬¬¬¬¬¬--| LISTE¬NON VIDE¶      DECLARE¶        H1¬: TREE¬:= HEAD( L1 );¬¬¬¬¬¬--| LIRE LA TTE DE¬LISTE¶      BEGIN¶       
      IF H1 = V THEN¬¬¬¬¬¬¬¬--| SI C'EST L'LMENT¶¬RETURN L1;¬¬¬¬¬¬¬¬--| RETOURNER LA LISTE¶        END IF;¶        DECLARE¶¬N1 : INTEGER¬:= DI( XD_RULE_NBR
     ,¬D( XD_RULEINFO, H1 ) );¬¬¬--| PRENDRE LE N DE RGLE TTE DE LISTE¶¬NV : INTEGER¬:= DI( XD_RULE_NBR,¬D( XD_RULEINFO, V )¬);¬¬¬--| PRENDRE LE N DE RGLE 
     LMENT¶        BEGIN¶¬IF N1 < NV THEN¬¬¬¬¬¬¬¬--| LA TTE EST ANTRIEURE¶¬  DECLARE¶¬    T1 : SEQ_TYPE¬:= TAIL( L1 );¬¬¬¬¬¬--| PRENDRE LE RESTE DE LISTE¶¬
         L  : SEQ_TYPE¬:= R_UNION( T1, V );¬¬¬¬¬--| RETENTER L'OPRATION¶¬  BEGIN¶¬    IF SAME( T1, L ) THEN¬¬¬¬¬¬¬--| LE RESTE DE LISTE EST INCHANG (CONTEN
0040 AIT L'LMENT)¶¬      RETURN L1;¬¬¬¬¬¬¬¬--| RETOURNER LA LISTE¶¬    ELSE¬¬¬¬¬¬¬¬¬--| L'UNION EST ORIGINALE¶¬      RETURN INSERT( L, H1 );¬¬¬¬¬¬¬--| RETO
     URNER UNE LISTE AVEC LA TTE 1 PRFIXE¶¬    END IF;¶¬  END;¶¬ELSE¬¬¬¬¬¬¬¬¬--| L'LMENT EST ANTRIEUR¶¬  RETURN INSERT( L1, V );¬¬¬¬¬¬¬--| RETOURNER UNE LI
     STE AVEC L'LMENT PRFIX¶¬END IF;¶        END;¶      END;¶    END IF;¶  END R_UNION;¶  --|||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||
     |||||||||||||||||||||||||||||||||¶  --|¬¬FUNCTION R_UNION¶  FUNCTION R_UNION ( L1 :SEQ_TYPE; L2 :SEQ_TYPE )¬RETURN SEQ_TYPE IS¶  BEGIN¶    IF IS_EMPTY
     ( L1¬) THEN¬¬¬¬¬¬¬¬--| LISTE¬1 VIDE¶      RETURN L2;¬¬¬¬¬¬¬¬¬--| RETOURNER LA LISTE 2 COMME UNION¶    ELSIF¬IS_EMPTY(¬L2 ) OR ELSE SAME( L1, L2 ) THEN
     ¬¬¬¬¬--| LISTE¬2 VIDE OU¬IDENTIQUE¬ LA LISTE 1¶      RETURN L1;¬¬¬¬¬¬¬¬¬--| RETOURNER LA LISTE 1 COMME UNION¶    ELSE¶      DECLARE¬¬¬¬¬¬¬¬¬--| CAS GN
     RAL¶        H1¬: TREE¬:= HEAD( L1 );¬¬¬¬¬¬--| PRENDRE LA TTE¬DE LISTE 1¶        H2¬: TREE¬:= HEAD( L2 );¬¬¬¬¬¬--| ET LA¬TTE DE LISTE 1¶        T1, T2:
      SEQ_TYPE;¶      BEGIN¶        IF H1 = H2 THEN¬¬¬¬¬¬¬¬--| SI TTES IDENTIQUES¶¬T1 := TAIL( L1 );¬¬¬¬¬¬¬¬--| PRENDRE LE RESTE 1¶¬T2 := TAIL( L2 );¬¬¬¬¬¬
     ¬¬--| ET LE¬RESTE 2¶¬DECLARE¶¬  L : SEQ_TYPE¬:= R_UNION( T1, T2 );¬¬¬¬¬--| FAIRE¬L'UNION DES RESTES¶¬BEGIN¶¬  IF SAME( L, T1 ) THEN¬¬¬¬¬¬¬--| UNION¬CO
     RRESPONDANT AU RESTE 1 (QUI¬CONTIENT LE RESTE 2)¶¬    RETURN L1;¬¬¬¬¬¬¬¬--| RETOURNER LA LISTE 1¶¬  ELSIF SAME( L, T2¬) THEN¬¬¬¬¬¬¬--| UNION¬CORRESPON

0050 DANT AU RESTE 2 (QUI¬CONTIENT LE RESTE 1)¶¬    RETURN L2;¬¬¬¬¬¬¬¬--| RETOURNER LA LISTE 2¶¬  ELSE¶¬    RETURN INSERT( L, H1 );¬¬¬¬¬¬¬--| PRFIXER LA TT
     E COMMUNE  L'UNION ORIGINALE DES RESTES¶¬  END IF;¶¬END;¶        ELSE¬¬¬¬¬¬¬¬¬--| LES TTES DIFFRENT¶¬IF DI( XD_RULE_NBR,¬D( XD_RULEINFO, H1 ) )¬¬¬¬¬--
     | LE N¬DE TTE 1¶¬¬¬> DI( XD_RULE_NBR, D( XD_RULEINFO,H2 ) ) THEN¬¬¬--| EST POSTRIEUR AU N DE TTE 2¶¬  RETURN R_UNION( L2, L1 );¬¬¬¬¬¬¬--| RETENTER L'U
     NION EN PERMUTANT LES LISTES (POUR TOMBER AU CAS SUIVANT)¶¬ELSE¬¬¬¬¬¬¬¬¬--| LE N¬DE TTE 1¬EST ANTRIEUR AU N¬DE TTE 2¶¬  T1 := TAIL( L1 );¬¬¬¬¬¬¬¬--| P
     RENDRE LE RESTE 1¶¬  DECLARE¶¬    L¬: SEQ_TYPE¬:= R_UNION( T1, L2 );¬¬¬¬--| UNIR LE RESTE 1¬ LA LISTE 2¶¬  BEGIN¶¬    IF SAME( L, T1 ) THEN¬¬¬¬¬¬¬--| 
     SI UNION CORRESPONDANT AU¬RESTE 1 (QUI CONTIENT LA LISTE 2)¶¬      RETURN L1;¬¬¬¬¬¬¬¬--| RETOURNER LA LISTE 1¶¬    ELSE¬¬¬¬¬¬¬¬¬--| UNION¬ORIGINALE¶¬ 
          RETURN INSERT( L, H1 );¬¬¬¬¬¬¬--| RETOURNER UNE LISTE AVEC LA TTE 1 PRFIXE ¬L'UNION ORIGINALE¶¬    END IF;¶¬  END;¶¬END IF;¶        END IF;¶     
      END;¶    END IF;¶  END R_UNION;¶¶--|--------------------------------------------------------------------------------------------------¶END TERM_LIST;
