     IN¶    RETURN L1.FIRST¬= L2.FIRST;¶  END;¶  --||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||¶  --|¬¬
     FUNCTION UNION¶  FUNCTION UNION ( L1 :SEQ_TYPE; V :TREE ) RETURN¬SEQ_TYPE IS¶  BEGIN¶    IF IS_EMPTY( L1¬) THEN¬¬¬¬¬¬¬¬--| LA LISTE EST VIDE¶      RET
