     ¶        N1¬: INTEGER¬:= DI( XD_TER_NBR, H1 );¬¬¬¬¬--| N DE¬TERMINAL DE LA TTE¶        NV¬: INTEGER¬:= DI( XD_TER_NBR, V );¬¬¬¬¬--| N DE¬TERMINAL DE L
     'LMENT¶      BEGIN¶        IF N1 = NV THEN¬¬¬¬¬¬¬¬--| SI MME N¶¬RETURN L1;¬¬¬¬¬¬¬¬--| RETOURNER LA LISTE INCHANGE¶        ELSIF N1 < NV THEN¬¬¬¬¬¬¬¬--
     | N DIFFRENTS, CELUI DE LA LISTE STRICTEMENT INFRIEUR¶¬DECLARE¶¬  T1¬: SEQ_TYPE¬:= TAIL( L1 );¬¬¬¬¬--| PRENDRE LA SUITE DE LISTE¶¬  L¬: SEQ_TYPE¬:= UN
