     ¶¬  RETURN L1;¬¬¬¬¬¬¬¬--| RENDRE LA LISTE¬1¶¬ELSIF SAME( L, T2 )¬THEN¬¬¬¬¬¬¬--| L'UNION DES RESTES EST LE¬RESTE 2 (LE RESTE 2¬CONTIENT LE RESTE 1)¶¬  
0020 RETURN L2;¬¬¬¬¬¬¬¬--| RENDRE LA LISTE¬2¶¬ELSE¬¬¬¬¬¬¬¬¬--| L'UNION DES RESTES DIFFRE DES DEUX¬RESTES (CHAQUE RESTE A DES LMENTS NON¬CONTENUS DANS L'AUT
     RE)¶¬  RETURN INSERT( L,¬H1 );¬¬¬¬¬¬¬--| PRFIXER LA TTE COMMUNE  LA LISTE¬UNION DES¬RESTES¶¬END IF;¶¶        ELSIF N1 > N2 THEN¬¬¬¬¬¬¬¬--| LA TTE 1 ES
     T APRS LA TTE 2¶¬RETURN UNION( L2, L1 );¬¬¬¬¬¬¬--| RETENTER L'UNION EN PERMUTANT LES LISTES (POUR VENIR AU¬CAS SUIVANT)¶        ELSE¬¬¬¬¬¬¬¬¬--| LA TT
     E 2 EST APRS LA TTE 1¶¬T1 := TAIL( L1 );¬¬¬¬¬¬¬¬--| PRENDRE LE RESTE DE LA LISTE  TTE¬ANTRIEURE¶¬L := UNION( T1, L2 );¬¬¬¬¬¬¬--| RETENTER L'UNION SUR 
