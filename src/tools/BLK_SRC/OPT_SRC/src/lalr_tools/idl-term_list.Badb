     RIEUR¶¬RETURN INSERT( L1, V );¬¬¬¬¬¬¬--| INSRER L'LMENT EN TTE¬(PLUS PETITS N EN TTE)¶        END IF;¶      END;¶    END IF;¶  END UNION;¶  --||||||||
     ||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||¶  --|¬¬FUNCTION UNION¶  FUNCTION UNION ( L1 :SEQ_TYPE; L2 :SE
     Q_TYPE ) RETURN SEQ_TYPE IS¶  BEGIN¶    IF IS_EMPTY( L1¬) THEN¶      RETURN L2;¶    ELSIF¬IS_EMPTY(¬L2 ) OR ELSE SAME( L1, L2 ) THEN¶      RETURN L1;¶
         ELSE¶      DECLARE¶        H1¬: TREE¬¬:= HEAD( L1 );¶        H2¬: TREE¬¬:= HEAD( L2 );¶        N1¬: INTEGER¬¬:= DI( XD_TER_NBR, H1 );¬¬¬¬--| N DE¬
     TERMINAL DE LA TTE¬1¶        N2¬: INTEGER¬¬:= DI( XD_TER_NBR, H2 );¬¬¬¬--| N DE¬TERMINAL DE LA TTE¬2¶        T1, T2, L¬: SEQ_TYPE;¶      BEGIN¶       
      IF N1 = N2 THEN¬¬¬¬¬¬¬¬--| MMES¬N DE TTES¶¬T1 := TAIL( L1 );¬¬¬¬¬¬¬¬--| PRENDRE LE RESTE 1¶¬T2 := TAIL( L2 );¬¬¬¬¬¬¬¬--| LE RESTE 2¶¬L := UNION( T1, 
