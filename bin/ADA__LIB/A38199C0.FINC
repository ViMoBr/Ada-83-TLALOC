elab_spec:				;    SPEC ELAB

					; CODE_PACKAGE_SPEC
; EXPANDER.DECLARATIONS.CODE_TYPE_DECL : skip PRIVATE L (deferred to full type)
; EXPANDER.DECLARATIONS.CODE_TYPE_DECL : skip INCOMPLETE INC (deferred to full type)
; CODE_ACCESS_DECL cd_level void ? FALSE

					; _L ACCESS TYPE INFO
_L = '_L'
namespace _L
VAR use__info, q
VAR SIZ, d
	LVA	0, SIZ
	Sa	0, use__info
	LI	64
	Sd	0, SIZ
VAR DESIG__u, q
	La 0, STANDARD.A38199C0._INC.use__info
	Sa	0, DESIG__u
end namespace
					;    BODY ELAB

					; _INC RECORD TYPE INFO
_INC = '_INC'
namespace _INC
VAR use__info, q
VAR SIZ, d
	LVA	0, SIZ
	Sa	0, use__info
USEINFO 0, D, 	La 0, STANDARD._INTEGER.use__info
USEINFO 0, C, 	La 0, STANDARD._INTEGER.use__info
virtual at 0				; calcul des offsets statiques
STATOFS D, 4
STATOFS C, 4
size = $
end virtual
	LI	 size*8
	Sd	0, SIZ
end namespace
begin:					;---------- package BDY INSTRUCTIONS
