	LI	8
	DIV
	MUL
	ADD					; add offset to start address
	ULb	, STANDARD.EXPANDER_L1.UTILS._GOTO_LBL_REC.DEFINED
	BF	L34
STR STR_L35, "; !!! CODE_LABELED : etiquette emise deux fois"	; constante string="; !!! CODE_LABELED : etiquette emise deux fois"
	LCA	STR_L35.data_ptr
	CALL	STANDARD.TEXT_IO. ,PUT_LINE_L60
	LCA	STANDARD.PROGRAM_ERROR__exc.data_ptr
	Sa	0, STANDARD.EXCEPTIONS_CURRENT_disp
	BRA	STANDARD.exc_raise_
	BRA	L33
L34:
L33:					; post if
VAR	IL37_disp, d				; compteur boucle LOOP__5
	Ld	1, STANDARD.EXPANDER_L1.UTILS.GOTO_PEND_BASE_disp
; CODE_NUMERIC_LITERAL DN_INTEGER
