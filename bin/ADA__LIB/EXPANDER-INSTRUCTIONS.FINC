					; doublet resultat record anonyme
	La  1,	-STM_S_ofs
	CALL	STANDARD.IDL. ,LIST_L22
	La  ,  0
	BLKMOV

 hexa_show 'var elab STM_ELEM ', $
 hexa_show ' disp ', STM_ELEM_disp
VAR STM_ELEM_disp, q			; variable record : pointeur aux data record
VAR STM_ELEM__u, q				; variable record : pointeur aux useinfo
VAR STM_ELEM__dat, STANDARD.IDL._TREE.size
