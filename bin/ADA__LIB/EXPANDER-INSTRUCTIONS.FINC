begin:					;---------- BDY INSTRUCTIONS
LOOP__2:
	LI	0					; lieu resultat sur pile
	LVA 2,	STM_SEQ_disp
	CALL	STANDARD.IDL. ,IS_EMPTY_L23
	LI	1
	OUX
	BF	L6
	LVA  2,	STANDARD.EXPANDER_L1.INSTRUCTIONS.CODE_STM_S_L112.BLOCK__1.STM_ELEM_disp
	LVA  2,	STANDARD.EXPANDER_L1.INSTRUCTIONS.CODE_STM_S_L112.BLOCK__1.STM_SEQ_disp
