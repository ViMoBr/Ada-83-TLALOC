if defined CODE_STM_S_L114_
PRO	CODE_STM_S_L114				;---------- PRO CODE_STM_S
 hexa_show 'CODE_STM_S_L114 ', $
PRMS					;    debut parametrage
	PRM STM_S_ofs				; in
endPRMS					;    fin parametrage
ELB 1					;    BODY ELAB
					;    end elab
begin:					;---------- BDY INSTRUCTIONS
namespace	BLOCK__1
ELB 2					;    BODY ELAB
 hexa_show 'var elab STM_SEQ ', $
VAR STM_SEQ_disp, q				; variable record : pointeur aux data record
VAR STM_SEQ__u, q				; variable record : pointeur aux useinfo
VAR STM_SEQ__dat, STANDARD.IDL._SEQ_TYPE.size
	LVA	2, STM_SEQ__dat
	Sa	2, STM_SEQ_disp				; record fin
	LVA	2, STANDARD.IDL._SEQ_TYPE.SIZ
	Sa	2, STM_SEQ__u
	La  2, STM_SEQ_disp
	LI	STANDARD.IDL._SEQ_TYPE.size
VAR	ANON_22_29_disp, q
VAR	ANON_22_29__u,    q
VAR	ANON_22_29__dat, STANDARD.IDL._SEQ_TYPE.size
	LVA 2, ANON_22_29__dat
	Sa  2, ANON_22_29_disp
	La  0, STANDARD.IDL._SEQ_TYPE.use__info
	Sa  2, ANON_22_29__u
	LVA 2, ANON_22_29_disp
					; doublet resultat record anonyme
	La  1,	-STM_S_ofs
	CALL	STANDARD.IDL. ,LIST_L22
	La  ,  0
	BLKMOV

 hexa_show ' disp ', STM_SEQ_disp
 hexa_show 'var elab STM_ELEM ', $
VAR STM_ELEM_disp, q			; variable record : pointeur aux data record
VAR STM_ELEM__u, q				; variable record : pointeur aux useinfo
VAR STM_ELEM__dat, STANDARD.IDL._TREE.size
	LVA	2, STM_ELEM__dat
	Sa	2, STM_ELEM_disp			; record fin
	LVA	2, STANDARD.IDL._TREE.SIZ
	Sa	2, STM_ELEM__u
	La  2, STM_ELEM_disp
					; store represented component PT range 0 .. 1 width 2
	DUP
	Ld
	LI	0
	LI	0
	LI	2
	BFI
	Sd

 hexa_show ' disp ', STM_ELEM_disp
					;    end elab
begin:					;---------- BDY INSTRUCTIONS
LOOP__2:
	LI	0					; lieu resultat sur pile
	LVA 2,	STM_SEQ_disp
	CALL	STANDARD.IDL. ,IS_EMPTY_L23
	LI	1
	OUX
	BF	L5
	LVA  2,	STANDARD.EXPANDER_L1.INSTRUCTIONS.CODE_STM_S_L114.BLOCK__1.STM_ELEM_disp
	LVA  2,	STANDARD.EXPANDER_L1.INSTRUCTIONS.CODE_STM_S_L114.BLOCK__1.STM_SEQ_disp
	CALL	STANDARD.IDL. ,POP_L24
	LVA 2,	STM_ELEM_disp
	CALL	STANDARD.EXPANDER_L1.INSTRUCTIONS. ,CODE_STM_ELEM_L119
	BRA	LOOP__2
L5:					; post loop LOOP__2
	UNLINK 2
endPRO
ret_lbl:
	UNLINK 1
	RTD	prm_siz
excep:
endPRO					;---------- end PRO CODE_STM_S
end if

