	Sa	2, STM_SEQ_disp				; record fin
	LVA	2, STANDARD.IDL._SEQ_TYPE.SIZ
	Sa	2, STM_SEQ__u
; CODE_VC_NAME DN_VARIABLE_ID
	La  2, STM_SEQ_disp
