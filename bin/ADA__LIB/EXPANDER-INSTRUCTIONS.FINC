	CALL	STANDARD.EXPANDER_L1.INSTRUCTIONS. ,CODE_STM_ELEM_L117
	BRA	LOOP__2
L6:					; post loop LOOP__2
	UNLINK 2
endPRO
ret_lbl:
	UNLINK 1
	RTD	prm_siz
excep:
endPRO					;---------- end PRO CODE_STM_S
