					; doublet resultat record anonyme
	La  1,	-STM_S_ofs
	CALL	STANDARD.IDL. ,LIST_L22
	La  ,  0
	BLKMOV

VAR STM_ELEM_disp, q			; variable record : pointeur aux data record
