namespace INSTANCE2				;---------- GENERIC PACKAGE INSTANTIATION
elab_spec:				;    SPEC ELAB

BRA post_LD_T1
LD_T1.elab:
	Lb -1, 0
	RTD 0
post_LD_T1:
BRA post_ST_T1
ST_T1.elab:
	Sb -1, 0
	RTD 0
post_ST_T1:
BRA post_INADR_T1
INADR_T1.elab:
	RTD 0
post_INADR_T1:
BRA post_OUTADR_T1
OUTADR_T1.elab:
	La
	RTD 0
post_OUTADR_T1:
VAR T1__outadr_ofs, q
	LCA OUTADR_T1.elab
	Sa	 2, T1__outadr_ofs
VAR T1__inadr_ofs, q
	LCA INADR_T1.elab
	Sa	 2, T1__inadr_ofs
VAR T1__st_ofs, q
	LCA ST_T1.elab
	Sa	 2, T1__st_ofs
VAR T1__ld_ofs, q
	LCA LD_T1.elab
	Sa	 2, T1__ld_ofs
VAR T1__u_ofs, q
	La	 0, STANDARD._CHARACTER.use__info
	Sa	 2, T1__u_ofs
BRA post_LD_T2
LD_T2.elab:
	Lb -1, 0
	RTD 0
post_LD_T2:
BRA post_ST_T2
ST_T2.elab:
	Sb -1, 0
	RTD 0
post_ST_T2:
BRA post_INADR_T2
INADR_T2.elab:
	RTD 0
