VAR T2__st_ofs, q
	LCA ST_T2.elab
	Sa	 2, T2__st_ofs
VAR T2__ld_ofs, q
	LCA LD_T2.elab
	Sa	 2, T2__ld_ofs
VAR T2__u_ofs, q
	La	 0, STANDARD._CHARACTER.use__info
	Sa	 2, T2__u_ofs
VAR GFP_disp, q				; Lieu du Generic Frame Pointer 
					; CODE_PACKAGE_SPEC

					; _PARENT ENUMERATION TYPE INFO
_PARENT = '_PARENT'
namespace _PARENT
VAR use__info, q
BEGIN_BLOC_DEF
db 0, 2, "E1"
db 1, 2, "E2"
db 2, 2, "E3"
END_BLOC_DEF
IMAGES	BYTES_BLOC
CST LST, d, 2
CST FST, d, 0
CST SIZ, d, 8	; SIZ en bits !
postpone
  align_q
end postpone
	LCA	SIZ
	Sa	2, use__info
end namespace
