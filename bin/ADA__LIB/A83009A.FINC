PRMS					;    debut parametrage
	PRM P1_ofs				; in
	PRM result__ofs				; resultat de fonction
endPRMS					;    fin parametrage
ELB 3
begin:
	LI	0					; lieu result
	LVA	 2, GFP_disp
	Lb	 3, -P1_ofs
	CALL	STANDARD.A83009A_L1.G_PACK. ,HF_L8
	Sb	 3, -result__ofs			; retour resultat
	UNLINK	 3
	RTD	prm_siz-8
endPRO					;---------- end PRO HF
end if
					; sub program entry decl (in instantiation TRUE )
if defined HF_L28_
