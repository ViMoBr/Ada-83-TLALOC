if defined HP_L25_
PRO	HP_L25				;---------- PRO HP
PRMS					;    debut parametrage
	PRM P1_ofs				; in
	PRM P2_ofs				; in
endPRMS					;    fin parametrage
ELB 3
begin:
	LVA	 2, GFP_disp
	Lb	 3, -P2_ofs
	Lb	 3, -P1_ofs
	CALL	STANDARD.A83009A_L1.G_PACK. ,HP_L6
	UNLINK	 3
	RTD	prm_siz
endPRO					;---------- end PRO HP
end if
					; sub program entry decl (in instantiation TRUE )
