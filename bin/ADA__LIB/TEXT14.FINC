VAR F1_disp, q				; variable record : pointeur aux data record
VAR F1__u, q				; variable record : pointeur aux useinfo
VAR F1__dat, STANDARD.TEXT_IO._FILE_TYPE.size
	LVA	1, F1__dat
	Sa	1, F1_disp				; record fin
	LVA	1, STANDARD.TEXT_IO._FILE_TYPE.SIZ
	Sa	1, F1__u
; CODE_VC_NAME DN_VARIABLE_ID
	LIVa 1, F1_disp, STANDARD.TEXT_IO._FILE_TYPE.ID
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	1
	NEG
	Sd
	LIVa 1, F1_disp, STANDARD.TEXT_IO._FILE_TYPE.IS_OPENED
	LI	0
	Sb
	LIVa 1, F1_disp, STANDARD.TEXT_IO._FILE_TYPE.PAGE_LENGTH
	Ld 0,	STANDARD.TEXT_IO.UNBOUNDED_disp
	Sd
	LIVa 1, F1_disp, STANDARD.TEXT_IO._FILE_TYPE.LINE_LENGTH
	Ld 0,	STANDARD.TEXT_IO.UNBOUNDED_disp
	Sd
	LIVa 1, F1_disp, STANDARD.TEXT_IO._FILE_TYPE.PAGE
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	1
	Sd
	LIVa 1, F1_disp, STANDARD.TEXT_IO._FILE_TYPE.LINE
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	1
	Sd
	LIVa 1, F1_disp, STANDARD.TEXT_IO._FILE_TYPE.COL
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	1
	Sd
	LIVa 1, F1_disp, STANDARD.TEXT_IO._FILE_TYPE.IS_DEFAULT_IO
	LI	0
	Sb
	LIVa 1, F1_disp, STANDARD.TEXT_IO._FILE_TYPE.LOOK_AHEAD
	LI	 0
	Sb
	LIVa 1, F1_disp, STANDARD.TEXT_IO._FILE_TYPE.HAS_LOOK_AHEAD
	LI	0
	Sb
	LIVa 1, F1_disp, STANDARD.TEXT_IO._FILE_TYPE.AT_END_OF_FILE
	LI	0
	Sb

VAR F2_disp, q				; variable record : pointeur aux data record
