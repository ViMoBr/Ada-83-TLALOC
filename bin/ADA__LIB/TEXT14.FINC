if defined CHECK_L14_
PRO	CHECK_L14				;---------- PRO CHECK
PRMS					;    debut parametrage
	PRM LABEL_ofs				; in
	PRM COND_ofs				; in
endPRMS					;    fin parametrage
ELB 2					;    BODY ELAB
					;    end elab
begin:					;---------- BDY INSTRUCTIONS
					; debut if
	Lb  2,	-COND_ofs
	BF	L18
	Ld 1,	STANDARD.TEXT14_L1.N_OK_disp
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	1
	ADD
	Sd  1,	N_OK_disp
	BRA	L17
L18:
	Ld 1,	STANDARD.TEXT14_L1.N_KO_disp
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	1
	ADD
	Sd  1,	N_KO_disp
STR STR_L19, "* ECHEC "			; constante string="* ECHEC "
	LCA	STR_L19.data_ptr
	CALL	STANDARD.TEXT_IO. ,PUT_L56
	La  2,	-LABEL_ofs
	CALL	STANDARD.TEXT_IO. ,PUT_LINE_L60
L17:					; post if
ret_lbl:
	UNLINK 2
	RTD	prm_siz
excep:
endPRO					;---------- end PRO CHECK
end if
					;    end elab
begin:					;---------- BDY INSTRUCTIONS
STR STR_L22, "=== U1. Comptabilite COL/LINE en sortie ==="	; constante string="=== U1. Comptabilite COL/LINE en sortie ==="
	LCA	STR_L22.data_ptr
	CALL	STANDARD.TEXT_IO. ,PUT_LINE_L60
STR STR_L23, ""				; constante string=""
	LCA	STR_L23.data_ptr
STR STR_L24, "TEXT14_A.TXT"			; constante string="TEXT14_A.TXT"
	LCA	STR_L24.data_ptr
	LI  1
	LVA  1,	F1_disp
	CALL	STANDARD.TEXT_IO. ,CREATE_L1
	LI	0					; lieu resultat sur pile
	LVA 1,	F1_disp
	CALL	STANDARD.TEXT_IO. ,COL_L43
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	1
	CEQ
STR STR_L25, "U1.1 COL initiale"		; constante string="U1.1 COL initiale"
	LCA	STR_L25.data_ptr
	CALL	STANDARD.TEXT14_L1. ,CHECK_L14
	LI	0					; lieu resultat sur pile
	LVA 1,	F1_disp
	CALL	STANDARD.TEXT_IO. ,LINE_L45
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	1
	CEQ
STR STR_L26, "U1.2 LINE initiale"		; constante string="U1.2 LINE initiale"
	LCA	STR_L26.data_ptr
	CALL	STANDARD.TEXT14_L1. ,CHECK_L14
	LI	0					; lieu resultat sur pile
	LVA 1,	F1_disp
	CALL	STANDARD.TEXT_IO. ,PAGE_L47
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	1
	CEQ
STR STR_L27, "U1.3 PAGE initiale"		; constante string="U1.3 PAGE initiale"
	LCA	STR_L27.data_ptr
	CALL	STANDARD.TEXT14_L1. ,CHECK_L14
STR STR_L28, "ABC"				; constante string="ABC"
	LCA	STR_L28.data_ptr
	LVA 1,	F1_disp
	CALL	STANDARD.TEXT_IO. ,PUT_L55
	LI	0					; lieu resultat sur pile
	LVA 1,	F1_disp
	CALL	STANDARD.TEXT_IO. ,COL_L43
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	4
	CEQ
STR STR_L29, "U1.4 COL apres PUT chaine"	; constante string="U1.4 COL apres PUT chaine"
	LCA	STR_L29.data_ptr
	CALL	STANDARD.TEXT14_L1. ,CHECK_L14
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	1
	LVA 1,	F1_disp
	CALL	STANDARD.TEXT_IO. ,NEW_LINE_L25
	LI	0					; lieu resultat sur pile
	LVA 1,	F1_disp
	CALL	STANDARD.TEXT_IO. ,COL_L43
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	1
	CEQ
STR STR_L30, "U1.5 COL apres NEW_LINE"		; constante string="U1.5 COL apres NEW_LINE"
	LCA	STR_L30.data_ptr
	CALL	STANDARD.TEXT14_L1. ,CHECK_L14
	LI	0					; lieu resultat sur pile
	LVA 1,	F1_disp
	CALL	STANDARD.TEXT_IO. ,LINE_L45
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	2
	CEQ
STR STR_L31, "U1.6 LINE apres NEW_LINE"		; constante string="U1.6 LINE apres NEW_LINE"
	LCA	STR_L31.data_ptr
	CALL	STANDARD.TEXT14_L1. ,CHECK_L14
	LI	90
	LVA 1,	F1_disp
	CALL	STANDARD.TEXT_IO. ,PUT_L51
	LI	0					; lieu resultat sur pile
	LVA 1,	F1_disp
	CALL	STANDARD.TEXT_IO. ,COL_L43
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	2
	CEQ
STR STR_L32, "U1.7 COL apres PUT caractere"	; constante string="U1.7 COL apres PUT caractere"
	LCA	STR_L32.data_ptr
	CALL	STANDARD.TEXT14_L1. ,CHECK_L14
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	1
	LVA 1,	F1_disp
	CALL	STANDARD.TEXT_IO. ,NEW_LINE_L25
STR STR_L33, "=== U2. SET_COL en sortie (avant / arriere) ==="	; constante string="=== U2. SET_COL en sortie (avant / arriere) ==="
	LCA	STR_L33.data_ptr
	CALL	STANDARD.TEXT_IO. ,PUT_LINE_L60
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	8
	LVA 1,	F1_disp
	CALL	STANDARD.TEXT_IO. ,SET_COL_L39
	LI	0					; lieu resultat sur pile
	LVA 1,	F1_disp
	CALL	STANDARD.TEXT_IO. ,COL_L43
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	8
	CEQ
STR STR_L34, "U2.1 SET_COL en avant"		; constante string="U2.1 SET_COL en avant"
	LCA	STR_L34.data_ptr
	CALL	STANDARD.TEXT14_L1. ,CHECK_L14
	LI	88
	LVA 1,	F1_disp
	CALL	STANDARD.TEXT_IO. ,PUT_L51
	LI	0					; lieu resultat sur pile
	LVA 1,	F1_disp
	CALL	STANDARD.TEXT_IO. ,COL_L43
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	9
	CEQ
STR STR_L35, "U2.2 COL apres X"		; constante string="U2.2 COL apres X"
	LCA	STR_L35.data_ptr
	CALL	STANDARD.TEXT14_L1. ,CHECK_L14
; CODE_NUMERIC_LITERAL DN_INTEGER
