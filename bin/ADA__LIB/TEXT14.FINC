end namespace


					; _COULEUR ENUMERATION TYPE INFO
_COULEUR = '_COULEUR'
namespace _COULEUR
VAR use__info, q
BEGIN_BLOC_DEF
db 0, 5, "ROUGE"
db 1, 4, "VERT"
db 2, 4, "BLEU"
END_BLOC_DEF
IMAGES	BYTES_BLOC
CST LST, d, 2
CST FST, d, 0
CST SIZ, d, 8	; SIZ en bits !
postpone
  align_q
end postpone
	LCA	SIZ
	Sa	1, use__info
end namespace
