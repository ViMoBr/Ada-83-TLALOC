	CALL	STANDARD.TEXT14_L1. ,CHECK_L14
	LI	0					; lieu resultat sur pile
	LVA 1,	F1_disp
	CALL	STANDARD.TEXT_IO. ,LINE_L45
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	4
	CEQ
STR STR_L37, "U2.4 SET_COL en arriere, LINE"	; constante string="U2.4 SET_COL en arriere, LINE"
	LCA	STR_L37.data_ptr
	CALL	STANDARD.TEXT14_L1. ,CHECK_L14
STR STR_L38, "=== U3. Coupure implicite a LINE_LENGTH bornee ==="	; constante string="=== U3. Coupure implicite a LINE_LENGTH bornee ==="
	LCA	STR_L38.data_ptr
	CALL	STANDARD.TEXT_IO. ,PUT_LINE_L60
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	5
	LVA 1,	F1_disp
	CALL	STANDARD.TEXT_IO. ,SET_LINE_LENGTH_L17
	LI	0					; lieu resultat sur pile
	LVA 1,	F1_disp
	CALL	STANDARD.TEXT_IO. ,LINE_LENGTH_L21
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	5
	CEQ
