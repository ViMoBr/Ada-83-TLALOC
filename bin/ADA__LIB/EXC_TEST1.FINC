	PRM SECTION_ofs				; in
	PRM NUMERO_ofs				; in
endPRMS					;    fin parametrage
ELB 2					;    BODY ELAB
					;    end elab
begin:					;---------- BDY INSTRUCTIONS
					; debut if
	Lb  2,	-OK_ofs
	BF	L12
	Ld 1,	STANDARD.EXC_TEST1_L1.NB_OK_disp
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	1
	ADD
	Sd  1,	NB_OK_disp
	BRA	L11
L12:
	Ld 1,	STANDARD.EXC_TEST1_L1.NB_ECHECS_disp
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	1
	ADD
	Sd  1,	NB_ECHECS_disp
STR STR_L13, "* ECHEC section"		; constante string="* ECHEC section"
	LCA	STR_L13.data_ptr
	CALL	STANDARD.TEXT_IO. ,PUT_L56
	Ld 1,	STANDARD.EXC_TEST1_L1.IO_ENT.DEFAULT_BASE_disp
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	3
	Ld  2,	-SECTION_ofs
	CALL	STANDARD.EXC_TEST1_L1.IO_ENT. ,PUT_L64
STR STR_L14, " test"			; constante string=" test"
	LCA	STR_L14.data_ptr
	CALL	STANDARD.TEXT_IO. ,PUT_L56
	Ld 1,	STANDARD.EXC_TEST1_L1.IO_ENT.DEFAULT_BASE_disp
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	3
	Ld  2,	-NUMERO_ofs
	CALL	STANDARD.EXC_TEST1_L1.IO_ENT. ,PUT_L64
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	1
	CALL	STANDARD.TEXT_IO. ,NEW_LINE_L26
L11:					; post if
ret_lbl:
	UNLINK 2
	RTD	prm_siz
excep:
endPRO					;---------- end PRO CHECK
end if

