	Sd  1,	NB_ECHECS_disp

VAR V_disp, d				; variable entiere
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	0
	Sd  1,	V_disp

VAR CNT_disp, d				; variable entiere
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	0
	Sd  1,	CNT_disp

IO_ENT = 'IO_ENT'
namespace IO_ENT				;---------- GENERIC PACKAGE INSTANTIATION
elab_spec:				;    SPEC ELAB

BRA post_LD_NUM
LD_NUM.elab:
	Ld -1, 0
	RTD 0
post_LD_NUM:
BRA post_ST_NUM
ST_NUM.elab:
	Sd -1, 0
	RTD 0
post_ST_NUM:
BRA post_INADR_NUM
INADR_NUM.elab:
	RTD 0
post_INADR_NUM:
BRA post_OUTADR_NUM
OUTADR_NUM.elab:
	La
	RTD 0
post_OUTADR_NUM:
VAR NUM__outadr_ofs, q
	LCA OUTADR_NUM.elab
	Sa	 1, NUM__outadr_ofs
VAR NUM__inadr_ofs, q
	LCA INADR_NUM.elab
	Sa	 1, NUM__inadr_ofs
VAR NUM__st_ofs, q
	LCA ST_NUM.elab
	Sa	 1, NUM__st_ofs
VAR NUM__ld_ofs, q
	LCA LD_NUM.elab
	Sa	 1, NUM__ld_ofs
VAR NUM__u_ofs, q
	La	 0, STANDARD._INTEGER.use__info
	Sa	 1, NUM__u_ofs
VAR GFP_disp, q				; Lieu du Generic Frame Pointer 
					; CODE_PACKAGE_SPEC
VAR DEFAULT_WIDTH_disp, d			; variable entiere
	LI	 11
	Sd  1,	DEFAULT_WIDTH_disp

VAR DEFAULT_BASE_disp, d			; variable entiere
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	10
	Sd  1,	DEFAULT_BASE_disp

