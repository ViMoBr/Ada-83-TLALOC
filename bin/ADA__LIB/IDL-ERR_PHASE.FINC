PRO	ERR_PHASE_L8				;---------- PRO ERR_PHASE
PRMS					;    debut parametrage
	PRM ACCES_TEXTE_ofs			; in
endPRMS					;    fin parametrage
ELB 1					;    BODY ELAB
VAR FULL_LIST_disp, d			; variable bool char enum
	LI	0
	Sb  1,	FULL_LIST_disp

VAR IFILE_disp, q				; variable record : pointeur aux data record
VAR IFILE__u, q				; variable record : pointeur aux useinfo
VAR IFILE__dat, STANDARD.TEXT_IO.FILE_TYPE.size
	LVA	1, IFILE__dat
	Sa	1, IFILE_disp				; record fin
	LVA	1, STANDARD.TEXT_IO.FILE_TYPE.SIZ
	Sa	1, IFILE__u
	LIVa 1, IFILE_disp, STANDARD.TEXT_IO.FILE_TYPE.ID
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	1
	NEG
	Sd
	LIVa 1, IFILE_disp, STANDARD.TEXT_IO.FILE_TYPE.IS_OPENED
	LI	0
	Sb
	LIVa 1, IFILE_disp, STANDARD.TEXT_IO.FILE_TYPE.PAGE_LENGTH
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	72
	Sd
	LIVa 1, IFILE_disp, STANDARD.TEXT_IO.FILE_TYPE.LINE_LENGTH
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	256
	Sd
	LIVa 1, IFILE_disp, STANDARD.TEXT_IO.FILE_TYPE.PAGE
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	1
	Sd
	LIVa 1, IFILE_disp, STANDARD.TEXT_IO.FILE_TYPE.LINE
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	1
	Sd
	LIVa 1, IFILE_disp, STANDARD.TEXT_IO.FILE_TYPE.COL
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	1
	Sd
	LIVa 1, IFILE_disp, STANDARD.TEXT_IO.FILE_TYPE.IS_DEFAULT_IO
	LI	0
	Sb
	LIVa 1, IFILE_disp, STANDARD.TEXT_IO.FILE_TYPE.LOOK_AHEAD
	LI	 0
	Sb
	LIVa 1, IFILE_disp, STANDARD.TEXT_IO.FILE_TYPE.HAS_LOOK_AHEAD
	LI	0
	Sb
	LIVa 1, IFILE_disp, STANDARD.TEXT_IO.FILE_TYPE.AT_END_OF_FILE
	LI	0
	Sb

VAR LINE_COUNT_disp, d			; variable entiere
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	0
	Sd  1,	LINE_COUNT_disp

VAR ERR_COUNT_disp, d			; variable entiere

					;    end elab
begin:					;---------- BDY INSTRUCTIONS
; CODE & concat STRING
VAR	ANON_19_24_data, q
VAR	ANON_19_24_info, q
VAR	ANON_19_61_data, q
VAR	ANON_19_61_info, q
VAR	ANON_19_24_len,  q
VAR	ANON_19_61_len,  q
VAR	ANON_19_24_disp, q
VAR	ANON_19_24__u,   q
namespace ANON_19_24_info
  VAR SIZ,      d
  VAR COMP_SIZ, d
  VAR FST_1,    d
  VAR LST_1,    d
end namespace
VAR	ANON_19_24_slice_data, q
VAR	ANON_19_24_slice_len,  q
VAR	ANON_19_24_disp, q
VAR	ANON_19_24__u,   q
namespace ANON_19_24_info
  VAR SIZ,      d
  VAR COMP_SIZ, d
  VAR FST_1,    d
  VAR LST_1,    d
end namespace
	Ld 0,	STANDARD.IDL.LIB_PATH_LENGTH_disp
	INC
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	1
	SUB
	LI	1
	MUL
	Sa  1, ANON_19_24_slice_len
	Sa  1, ANON_19_24_slice_data
	La  1, ANON_19_24_slice_data
	Sa  1, ANON_19_24_disp
	LVA 1, ANON_19_24_info.SIZ
	Sa  1, ANON_19_24__u
	LI	1
	Sd  1, ANON_19_24_info.FST_1
	La  1, ANON_19_24_slice_len
	Sd  1, ANON_19_24_info.LST_1
	LI	8
	Sd  1, ANON_19_24_info.COMP_SIZ
	La  1, ANON_19_24_slice_len
	LI	8
	MUL
	Sd  1, ANON_19_24_info.SIZ
	LVA 1, ANON_19_24_disp
	DUP
	La  ,  0
	Sa  1, ANON_19_24_data
	La  ,  8
	Sa  1, ANON_19_24_info
	LId 1, ANON_19_24_info, STRING.LST_1
	INC
	LId 1, ANON_19_24_info, STRING.FST_1
	SUB
	Sa  1, ANON_19_24_len
STR ANON_19_61, "$$$.TMP"			; constante string="$$$.TMP"
	LCA	ANON_19_61.data_ptr
	DUP
	La  ,  0
	Sa  1, ANON_19_61_data
	La  ,  8
	Sa  1, ANON_19_61_info
	LId 1, ANON_19_61_info, STRING.LST_1
	INC
	LId 1, ANON_19_61_info, STRING.FST_1
	SUB
	Sa  1, ANON_19_61_len
	La  1, ANON_19_24_len
	La  1, ANON_19_61_len
	ADD
	CO_VAR
	Sa  1, ANON_19_24_disp
	LI	1
	Sd  1, ANON_19_24_info.FST_1
	La  1, ANON_19_24_len
	La  1, ANON_19_61_len
	ADD
	Sd  1, ANON_19_24_info.LST_1
	LI	8
	Sd  1, ANON_19_24_info.COMP_SIZ
	La  1, ANON_19_24_len
	La  1, ANON_19_61_len
	ADD
	LI	8
	MUL
	Sd  1, ANON_19_24_info.SIZ
	LVA 1, ANON_19_24_info.SIZ
	Sa  1, ANON_19_24__u
	La  1, ANON_19_24_disp
	La  1, ANON_19_24_len
	La  1, ANON_19_24_data
	BLKMOV
	La  1, ANON_19_24_disp
	La  1, ANON_19_24_len
	ADD
	La  1, ANON_19_61_len
	La  1, ANON_19_61_data
	BLKMOV
	LVA 1, ANON_19_24_disp
	CALL	STANDARD.IDL. ,OPEN_IDL_TREE_FILE_L2
	LI	0					; lieu resultat sur pile
	LI  3
	CALL	STANDARD.IDL. ,DI_L17
	Sd  1,	ERR_COUNT_disp
					; debut if
	Ld 1,	ERR_COUNT_disp
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	0
	CEQ
	BF	L2
	BRA	L1
L2:
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	1
	CALL	STANDARD.TEXT_IO. ,NEW_LINE_L26
L1:					; post if
STR STR_L3, ""				; constante string=""
	LCA	STR_L3.data_ptr
	La  1,	-ACCES_TEXTE_ofs
	LI  0
	LVA  1,	IFILE_disp
	CALL	STANDARD.TEXT_IO. ,OPEN_L2
namespace	BLOCK__1
ELB 2					;    BODY ELAB
VAR SOURCE_LIST_disp, q			; variable record : pointeur aux data record
VAR SOURCE_LIST__u, q			; variable record : pointeur aux useinfo
VAR SOURCE_LIST__dat, STANDARD.IDL.SEQ_TYPE.size
	LVA	2, SOURCE_LIST__dat
	Sa	2, SOURCE_LIST_disp			; record fin
	LVA	2, STANDARD.IDL.SEQ_TYPE.SIZ
	Sa	2, SOURCE_LIST__u
	La  2, SOURCE_LIST_disp
	LI	STANDARD.IDL.SEQ_TYPE.size
VAR	ANON_28_32_disp, q
VAR	ANON_28_32__u,    q
VAR	ANON_28_32__dat, STANDARD.IDL.SEQ_TYPE.size
	LVA 2, ANON_28_32__dat
	Sa  2, ANON_28_32_disp
	La  0, STANDARD.IDL.SEQ_TYPE.use__info
	Sa  2, ANON_28_32__u
	LVA 2, ANON_28_32_disp
					; doublet resultat record anonyme
	CALL	STANDARD.IDL. ,LIST_L18
	La  ,  0
	BLKMOV

VAR ERRORLIST_disp, q			; variable record : pointeur aux data record
VAR ERRORLIST__u, q				; variable record : pointeur aux useinfo
VAR ERRORLIST__dat, STANDARD.IDL.SEQ_TYPE.size
	LVA	2, ERRORLIST__dat
	Sa	2, ERRORLIST_disp			; record fin
	LVA	2, STANDARD.IDL.SEQ_TYPE.SIZ
	Sa	2, ERRORLIST__u

VAR SOURCENBR_disp, d			; variable entiere
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	0
	Sd  2,	SOURCENBR_disp

VAR NB_PREFIX_CHARS_disp, d			; variable entiere

					;    end elab
begin:					;---------- BDY INSTRUCTIONS
LOOP__2:
					; debut if
	LI	0					; lieu resultat sur pile
	LVA 2,	SOURCE_LIST_disp
	CALL	STANDARD.IDL. ,IS_EMPTY_L19
	BF	L6
	LI	002147483647
	Sd  2,	SOURCENBR_disp
	LVA 2,	ERRORLIST_disp
	La
	LI	STANDARD.IDL.SEQ_TYPE.size
