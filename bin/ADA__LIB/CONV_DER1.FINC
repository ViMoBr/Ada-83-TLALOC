					; _R RECORD TYPE INFO
_R = '_R'
namespace _R
VAR use__info, q
VAR SIZ, d
	LVA	1, SIZ
	Sa	1, use__info
USEINFO 1, A, 	La 0, STANDARD._INTEGER.use__info
USEINFO 1, B, 	La 0, STANDARD._INTEGER.use__info
USEINFO 1, C, 	La 0, STANDARD._INTEGER.use__info
virtual at 0				; calcul des offsets statiques
STATOFS A, 4, 4
STATOFS B, 4, 4
STATOFS C, 4, 4
size = $
end virtual
	LI	 size*8
	Sd	1, SIZ
end namespace

					; _DR RECORD TYPE INFO
_DR = '_DR'
namespace _DR
VAR use__info, q
VAR SIZ, d
	LVA	1, SIZ
	Sa	1, use__info
USEINFO 1, A, 	La 0, STANDARD._INTEGER.use__info
USEINFO 1, B, 	La 0, STANDARD._INTEGER.use__info
USEINFO 1, C, 	La 0, STANDARD._INTEGER.use__info
virtual at 0				; calcul des offsets statiques
STATOFS A, 4, 4
STATOFS B, 4, 4
STATOFS C, 4, 4
size = $
end virtual
	LI	 size*8
	Sd	1, SIZ
end namespace
