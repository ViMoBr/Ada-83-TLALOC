USEINFO 0, U2, 	La 0, STANDARD.IDL.SEM_PHASE_L11.UNIV_OPS.UDIGIT.use__info
virtual at 0				; calcul des offsets statiques
STATOFS U1, 2
STATOFS U2, 2
size = $
end virtual
	LI	 size*8
	Sd	0, SIZ
end namespace

