begin:					;---------- BDY INSTRUCTIONS
					; debut if
	La 1, -A_ofs
	LId	, 0, STANDARD.IDL.SEM_PHASE_L11.UNIV_OPS.VECTOR.L
	La 1, -B_ofs
	LId	, 0, STANDARD.IDL.SEM_PHASE_L11.UNIV_OPS.VECTOR.L
	CNE
	BF	L166
; CODE_RETURN : EXPR TYPE = DN_ENUMERATION
	La 1, -A_ofs
	LId	, 0, STANDARD.IDL.SEM_PHASE_L11.UNIV_OPS.VECTOR.L
	La 1, -B_ofs
	LId	, 0, STANDARD.IDL.SEM_PHASE_L11.UNIV_OPS.VECTOR.L
	CLT
	Sb  1,	-result__ofs
	BRA ret_lbl
	BRA	L165
L166:
L165:					; post if
VAR	IL168_disp, d				; compteur boucle LOOP__20
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	1
	Sd  1,	IL168_disp
VAR	LMT_IL168_disp, d			; limite boucle LOOP__20
	La 1, -A_ofs
	LId	, 0, STANDARD.IDL.SEM_PHASE_L11.UNIV_OPS.VECTOR.L
	Sd  1,	LMT_IL168_disp
	Ld  1,	IL168_disp				; test null range LOOP__20
	Ld  1,	LMT_IL168_disp
	CGT
	BT	L167
	Ld  1,	IL168_disp				; inversion range LOOP__20
	Ld  1,	LMT_IL168_disp
	Sd  1,	IL168_disp
	Sd  1,	LMT_IL168_disp
LOOP__20:					; corps boucle LOOP__20
					; debut if
	La 1, -A_ofs
	LIVA 	, 0, STANDARD.IDL.SEM_PHASE_L11.UNIV_OPS.VECTOR.D
; EXPRESSIONS.CODE_INDEXED adresse component id
	Ld	1, IL168_disp
	Ld	 0, STANDARD.IDL.SEM_PHASE_L11.UNIV_OPS.VECTOR_DIGITS.FST_1	; (index - FST_1) * SIZ_1
	SUB
	Ld	 0, STANDARD.IDL.SEM_PHASE_L11.UNIV_OPS.VECTOR_DIGITS.COMP_SIZ
	LI	8
	DIV
	MUL
	ADD					; add offset to start address
	Lw
	La 1, -B_ofs
	LIVA 	, 0, STANDARD.IDL.SEM_PHASE_L11.UNIV_OPS.VECTOR.D
; EXPRESSIONS.CODE_INDEXED adresse component id
	Ld	1, IL168_disp
	Ld	 0, STANDARD.IDL.SEM_PHASE_L11.UNIV_OPS.VECTOR_DIGITS.FST_1	; (index - FST_1) * SIZ_1
	SUB
	Ld	 0, STANDARD.IDL.SEM_PHASE_L11.UNIV_OPS.VECTOR_DIGITS.COMP_SIZ
	LI	8
	DIV
	MUL
	ADD					; add offset to start address
	Lw
	CNE
	BF	L170
; CODE_RETURN : EXPR TYPE = DN_ENUMERATION
	La 1, -A_ofs
	LIVA 	, 0, STANDARD.IDL.SEM_PHASE_L11.UNIV_OPS.VECTOR.D
; EXPRESSIONS.CODE_INDEXED adresse component id
	Ld	1, IL168_disp
	Ld	 0, STANDARD.IDL.SEM_PHASE_L11.UNIV_OPS.VECTOR_DIGITS.FST_1	; (index - FST_1) * SIZ_1
	SUB
	Ld	 0, STANDARD.IDL.SEM_PHASE_L11.UNIV_OPS.VECTOR_DIGITS.COMP_SIZ
	LI	8
	DIV
	MUL
	ADD					; add offset to start address
	Lw
	La 1, -B_ofs
	LIVA 	, 0, STANDARD.IDL.SEM_PHASE_L11.UNIV_OPS.VECTOR.D
; EXPRESSIONS.CODE_INDEXED adresse component id
	Ld	1, IL168_disp
	Ld	 0, STANDARD.IDL.SEM_PHASE_L11.UNIV_OPS.VECTOR_DIGITS.FST_1	; (index - FST_1) * SIZ_1
	SUB
	Ld	 0, STANDARD.IDL.SEM_PHASE_L11.UNIV_OPS.VECTOR_DIGITS.COMP_SIZ
	LI	8
	DIV
	MUL
	ADD					; add offset to start address
	Lw
	CLT
	Sb  1,	-result__ofs
	BRA ret_lbl
	BRA	L169
L170:
L169:					; post if
	Ld  1,	IL168_disp				; test de sortie LOOP__20
	Ld  1,	LMT_IL168_disp
	CEQ
	BT	L167
	Ld  1,	IL168_disp				; mise a jour compteur LOOP__20
	DEC
	Sd  1,	IL168_disp
	BRA	LOOP__20				; iteration suivante LOOP__20
L167:					; post loop LOOP__20
; CODE_RETURN : EXPR TYPE = DN_ENUMERATION
	LI	0
	Sb  1,	-result__ofs
	BRA ret_lbl
ret_lbl:
	UNLINK 1
	RTD	prm_siz-8
excep:
endPRO					;---------- end PRO V_LESS
end if
begin:					;---------- package BDY INSTRUCTIONS
end namespace 				;---------- end package BDY UNIV_OPS

