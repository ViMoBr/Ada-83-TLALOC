if defined DIGIT_MUL_L17_
PRO	DIGIT_MUL_L17				;---------- PRO DIGIT_MUL
PRMS					;    debut parametrage
	PRM A_ofs				; in
	PRM B_ofs				; in
	PRM HIGH_ofs				; out
	PRM LOW_ofs				; out
endPRMS					;    fin parametrage
ELB 1					;    BODY ELAB
VAR A1_disp, w				; variable entiere
	Lw  1,	-A_ofs
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	100
	DIV
	Sw  1,	A1_disp

VAR B1_disp, w				; variable entiere
	Lw  1,	-B_ofs
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	100
	DIV
	Sw  1,	B1_disp

VAR A2_disp, w				; variable entiere
	Lw  1,	-A_ofs
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	100
	MODI
	Sw  1,	A2_disp

VAR B2_disp, w				; variable entiere
	Lw  1,	-B_ofs
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	100
	MODI
	Sw  1,	B2_disp

VAR XX_disp, w				; variable entiere
	Lw 1,	A1_disp
	Lw 1,	B2_disp
	MUL
	Lw 1,	A2_disp
	Lw 1,	B1_disp
	MUL
	ADD
	Sw  1,	XX_disp

VAR LL_disp, w				; variable entiere
	Lw 1,	A2_disp
	Lw 1,	B2_disp
	MUL
	Lw 1,	XX_disp
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	100
	MODI
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	100
	MUL
	ADD
	Sw  1,	LL_disp

					;    end elab
begin:					;---------- BDY INSTRUCTIONS
	Lw 1,	LL_disp
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	10000
	MODI
	SIw  1,	-LOW_ofs
	Lw 1,	A1_disp
	Lw 1,	B1_disp
	MUL
	Lw 1,	LL_disp
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	10000
	DIV
	ADD
	Lw 1,	XX_disp
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	100
	DIV
	ADD
	SIw  1,	-HIGH_ofs
ret_lbl:
	UNLINK 1
	RTD	prm_siz
excep:
endPRO					;---------- end PRO DIGIT_MUL
end if

if defined DIGIT_DIV_L18_
PRO	DIGIT_DIV_L18				;---------- PRO DIGIT_DIV
PRMS					;    debut parametrage
	PRM H_ofs				; in
	PRM L_ofs				; in
	PRM A_ofs				; in
	PRM result__ofs				; resultat de fonction
endPRMS					;    fin parametrage
ELB 1					;    BODY ELAB
VAR QUO_disp, w				; variable entiere

VAR PH_disp, w				; variable entiere

VAR PL_disp, w				; variable entiere

					;    end elab
begin:					;---------- BDY INSTRUCTIONS
					; debut if
	Lw  1,	-H_ofs
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	0
	CEQ
	BF	L20
; CODE_RETURN : EXPR TYPE = DN_INTEGER
	Lw  1,	-L_ofs
	Lw  1,	-A_ofs
	DIV
	Sw  1,	-result__ofs
	BRA ret_lbl
	BRA	L19
L20:
	Lw  1,	-A_ofs
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	100
	CLT
	BF	L21
; CODE_RETURN : EXPR TYPE = DN_INTEGER
	LI	0					; lieu resultat sur pile
	Lw  1,	-A_ofs
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	100
	MUL
	Lw  1,	-L_ofs
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	100
	MODI
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	100
	MUL
	Lw  1,	-H_ofs
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	100
	MUL
	Lw  1,	-L_ofs
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	100
	DIV
	ADD
	CALL	STANDARD.IDL.SEM_PHASE_L11.UNIV_OPS. ,DIGIT_DIV_L18
	Sw  1,	-result__ofs
	BRA ret_lbl
	BRA	L19
L21:
					; debut if
	Lw  1,	-H_ofs
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	100
	CGE
	BF	L23
	Lw  1,	-H_ofs
	Lw  1,	-A_ofs
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	99
	ADD
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	100
	DIV
	DIV
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	100
	MUL
	Sw  1,	QUO_disp
	BRA	L22
L23:
	Lw  1,	-H_ofs
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	100
	MUL
	Lw  1,	-L_ofs
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	100
	DIV
	ADD
	Lw  1,	-A_ofs
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	99
	ADD
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	100
	DIV
	DIV
	Sw  1,	QUO_disp
L22:					; post if
	LVA  1,	PL_disp
	LVA  1,	PH_disp
	Lw 1,	QUO_disp
	Lw  1,	-A_ofs
	CALL	STANDARD.IDL.SEM_PHASE_L11.UNIV_OPS. ,DIGIT_MUL_L17
					; debut if
	Lw  1,	-L_ofs
	Lw 1,	PL_disp
	CGE
	BF	L25
; CODE_RETURN : EXPR TYPE = DN_INTEGER
	Lw 1,	QUO_disp
	LI	0					; lieu resultat sur pile
	Lw  1,	-A_ofs
	Lw  1,	-L_ofs
	Lw 1,	PL_disp
	SUB
	Lw  1,	-H_ofs
	Lw 1,	PH_disp
	SUB
	CALL	STANDARD.IDL.SEM_PHASE_L11.UNIV_OPS. ,DIGIT_DIV_L18
	ADD
	Sw  1,	-result__ofs
	BRA ret_lbl
	BRA	L24
L25:
; CODE_RETURN : EXPR TYPE = DN_INTEGER
	Lw 1,	QUO_disp
	LI	0					; lieu resultat sur pile
	Lw  1,	-A_ofs
	Lw  1,	-L_ofs
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	10000
	ADD
	Lw 1,	PL_disp
	SUB
	Lw  1,	-H_ofs
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	1
	SUB
	Lw 1,	PH_disp
	SUB
	CALL	STANDARD.IDL.SEM_PHASE_L11.UNIV_OPS. ,DIGIT_DIV_L18
	ADD
	Sw  1,	-result__ofs
	BRA ret_lbl
L24:					; post if
L19:					; post if
ret_lbl:
	UNLINK 1
	RTD	prm_siz-8
excep:
endPRO					;---------- end PRO DIGIT_DIV
end if

