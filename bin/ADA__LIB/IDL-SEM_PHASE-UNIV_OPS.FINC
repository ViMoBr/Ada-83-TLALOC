					; debut if
	La 1, -V_ofs
	LIw	, 0, STANDARD.IDL.SEM_PHASE_L11.UNIV_OPS.VECTOR.S
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	1
	NEG
	CEQ
	BF	L43
	LIVA 	3, ENTETE_disp, STANDARD.IDL.TREE.ABSS
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	1
	Sw
	BRA	L42
L43:
