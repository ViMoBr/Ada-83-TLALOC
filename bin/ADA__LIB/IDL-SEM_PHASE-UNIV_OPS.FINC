if ~ definite UNCHECKED_CONVERSION
include 'UNCHECKED_CONVERSION.FINC'
end if
UNIV_OPS = 'UNIV_OPS'
namespace UNIV_OPS				;---------- PACKAGE (BDY)
					;    BODY ELAB
VAR NUM_VAL_disp, d				; variable entiere
	LI	2
	Sd  0,	NUM_VAL_disp


					; _UDIGIT_PAIR_TYPE RECORD TYPE INFO
_UDIGIT_PAIR_TYPE = '_UDIGIT_PAIR_TYPE'
namespace _UDIGIT_PAIR_TYPE
VAR use__info, q
VAR SIZ, d
	LVA	0, SIZ
	Sa	0, use__info
USEINFO 0, U1, 	La 1, STANDARD.IDL.SEM_PHASE_L11.UNIV_OPS._UDIGIT.use__info
USEINFO 0, U2, 	La 1, STANDARD.IDL.SEM_PHASE_L11.UNIV_OPS._UDIGIT.use__info
virtual at 0				; calcul des offsets statiques
STATOFS U1, 2
STATOFS U2, 2
size = $
end virtual
	LI	 size*8
	Sd	0, SIZ
end namespace

					; array decl constrained array type info
_VECTOR_DIGITS_PAIRS = '_VECTOR_DIGITS_PAIRS'
namespace _VECTOR_DIGITS_PAIRS
VAR use__info, q
VAR SIZ, d
	LVA	0, SIZ
	Sa	0, use__info
VAR _COMP_SIZ, d
VAR _FST_1, d
VAR _LST_1, d
	LI	32
	Sd	0, _COMP_SIZ
	Ld	0, _COMP_SIZ
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	1
	Sd	0, _FST_1
; CODE_NUMERIC_LITERAL DN_UNIVERSAL_INTEGER
	LI	126
; CODE CONVERSION SOURCE DN_UNIVERSAL_INTEGER TARGET DN_INTEGER
	Sd	0, _LST_1
	Ld	0, _LST_1
	Ld	0, _FST_1
	SUB
	INC
	MUL
	Sd	0, SIZ
  virtual at 4
COMP_SIZ = $
	rd 1 
FST_1 = $
	rd 1 
LST_1 = $
	rd 1 
  end virtual
end namespace

					; _VECTOR_PAIRS RECORD TYPE INFO
_VECTOR_PAIRS = '_VECTOR_PAIRS'
namespace _VECTOR_PAIRS
VAR use__info, q
VAR SIZ, d
	LVA	0, SIZ
	Sa	0, use__info
USEINFO 0, L, 	La 0, STANDARD._NATURAL.use__info
USEINFO 0, S, 	La 1, STANDARD.IDL.SEM_PHASE_L11.UNIV_OPS._UDIGIT.use__info
USEINFO 0, P, 	La 0, STANDARD.IDL.SEM_PHASE_L11.UNIV_OPS._VECTOR_DIGITS_PAIRS.use__info
; STSB
; NON STATIQUE DN_CONSTRAINED_ARRAY
; OFFSET NON STATIQUE A FAIRE
; OFFSET NON STATIQUE A FAIRE
; OFFSET NON STATIQUE A FAIRE
end namespace

if defined DIGIT_MUL_L1_
PRO	DIGIT_MUL_L1				;---------- PRO DIGIT_MUL
PRMS					;    debut parametrage
	PRM A_ofs				; in
	PRM B_ofs				; in
	PRM HIGH_ofs				; out
	PRM LOW_ofs				; out
endPRMS					;    fin parametrage
ELB 1					;    BODY ELAB
VAR A1_disp, w				; variable entiere
	Lw  1,	-A_ofs
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	100
	DIV
	Sw  1,	A1_disp

VAR B1_disp, w				; variable entiere
	Lw  1,	-B_ofs
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	100
	DIV
	Sw  1,	B1_disp

VAR A2_disp, w				; variable entiere
	Lw  1,	-A_ofs
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	100
	MODI
	Sw  1,	A2_disp

VAR B2_disp, w				; variable entiere
	Lw  1,	-B_ofs
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	100
	MODI
	Sw  1,	B2_disp

VAR XX_disp, w				; variable entiere
	Lw 1,	A1_disp
	Lw 1,	B2_disp
	MUL
	Lw 1,	A2_disp
	Lw 1,	B1_disp
	MUL
	ADD
	Sw  1,	XX_disp

VAR LL_disp, w				; variable entiere
	Lw 1,	A2_disp
	Lw 1,	B2_disp
	MUL
	Lw 1,	XX_disp
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	100
	MODI
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	100
	MUL
	ADD
	Sw  1,	LL_disp

					;    end elab
begin:					;---------- BDY INSTRUCTIONS
	Lw 1,	LL_disp
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	10000
	MODI
	SIw  1,	-LOW_ofs
	Lw 1,	A1_disp
	Lw 1,	B1_disp
	MUL
	Lw 1,	LL_disp
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	10000
	DIV
	ADD
	Lw 1,	XX_disp
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	100
	DIV
	ADD
	SIw  1,	-HIGH_ofs
ret_lbl:
	UNLINK 1
	RTD	prm_siz
excep:
endPRO					;---------- end PRO DIGIT_MUL
end if

if defined DIGIT_DIV_L2_
PRO	DIGIT_DIV_L2				;---------- PRO DIGIT_DIV
PRMS					;    debut parametrage
	PRM H_ofs				; in
	PRM L_ofs				; in
	PRM A_ofs				; in
	PRM result__ofs				; resultat de fonction
endPRMS					;    fin parametrage
ELB 1					;    BODY ELAB
VAR QUO_disp, w				; variable entiere

VAR PH_disp, w				; variable entiere

VAR PL_disp, w				; variable entiere

					;    end elab
begin:					;---------- BDY INSTRUCTIONS
					; debut if
	Lw  1,	-H_ofs
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	0
	CEQ
	BF	L4
; CODE_RETURN : EXPR TYPE = DN_INTEGER
	Lw  1,	-L_ofs
	Lw  1,	-A_ofs
	DIV
	Sw  1,	-result__ofs
	BRA ret_lbl
	BRA	L3
L4:
	Lw  1,	-A_ofs
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	100
	CLT
	BF	L5
; CODE_RETURN : EXPR TYPE = DN_INTEGER
	LI	0					; lieu resultat sur pile
	Lw  1,	-A_ofs
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	100
	MUL
	Lw  1,	-L_ofs
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	100
	MODI
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	100
	MUL
	Lw  1,	-H_ofs
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	100
	MUL
	Lw  1,	-L_ofs
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	100
	DIV
	ADD
	CALL	STANDARD.IDL.SEM_PHASE_L11.UNIV_OPS. ,DIGIT_DIV_L2
	Sw  1,	-result__ofs
	BRA ret_lbl
	BRA	L3
L5:
					; debut if
	Lw  1,	-H_ofs
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	100
	CGE
	BF	L7
	Lw  1,	-H_ofs
	Lw  1,	-A_ofs
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	99
	ADD
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	100
	DIV
	DIV
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	100
	MUL
	Sw  1,	QUO_disp
	BRA	L6
L7:
	Lw  1,	-H_ofs
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	100
	MUL
	Lw  1,	-L_ofs
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	100
	DIV
	ADD
	Lw  1,	-A_ofs
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	99
	ADD
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	100
	DIV
	DIV
	Sw  1,	QUO_disp
L6:					; post if
	LVA  1,	PL_disp
	LVA  1,	PH_disp
	Lw 1,	QUO_disp
	Lw  1,	-A_ofs
	CALL	STANDARD.IDL.SEM_PHASE_L11.UNIV_OPS. ,DIGIT_MUL_L1
					; debut if
	Lw  1,	-L_ofs
	Lw 1,	PL_disp
	CGE
	BF	L9
; CODE_RETURN : EXPR TYPE = DN_INTEGER
	Lw 1,	QUO_disp
	LI	0					; lieu resultat sur pile
	Lw  1,	-A_ofs
	Lw  1,	-L_ofs
	Lw 1,	PL_disp
	SUB
	Lw  1,	-H_ofs
	Lw 1,	PH_disp
	SUB
	CALL	STANDARD.IDL.SEM_PHASE_L11.UNIV_OPS. ,DIGIT_DIV_L2
	ADD
	Sw  1,	-result__ofs
	BRA ret_lbl
	BRA	L8
L9:
; CODE_RETURN : EXPR TYPE = DN_INTEGER
	Lw 1,	QUO_disp
	LI	0					; lieu resultat sur pile
	Lw  1,	-A_ofs
	Lw  1,	-L_ofs
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	10000
	ADD
	Lw 1,	PL_disp
	SUB
	Lw  1,	-H_ofs
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	1
	SUB
	Lw 1,	PH_disp
	SUB
	CALL	STANDARD.IDL.SEM_PHASE_L11.UNIV_OPS. ,DIGIT_DIV_L2
	ADD
	Sw  1,	-result__ofs
	BRA ret_lbl
L8:					; post if
L3:					; post if
ret_lbl:
	UNLINK 1
	RTD	prm_siz-8
excep:
endPRO					;---------- end PRO DIGIT_DIV
end if

