VAR GFP_disp, q				; Lieu du Generic Frame Pointer 
if defined CAST_UDIGIT_PAIR_L63_
PRO	CAST_UDIGIT_PAIR_L63			;---------- PRO CAST_UDIGIT_PAIR
PRMS					;    debut parametrage
	PRM result__ofs				; resultat de fonction
endPRMS					;    fin parametrage
ELB 3
begin:
	LI	0					; lieu result
	LVA	 2, GFP_disp
	La 	 3, -S_ofs
	CALL	STANDARD.UNCHECKED_CONVERSION. ,	UNLINK	 3
	RTD	prm_siz-8
endPRO					;---------- end PRO CAST_UDIGIT_PAIR
end if
					;    end elab
begin:					;---------- BDY INSTRUCTIONS
	La 1, -V_ofs
	LIVA 	, 0, STANDARD.IDL.SEM_PHASE_L7.UNIV_OPS.VECTOR.L
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	2
	LIw	2, ENTETE_disp, STANDARD.IDL.TREE.NSIZ
; CODE CONVERSION SOURCE DN_INTEGER TARGET DN_INTEGER
	MUL
	Sd
					; debut if
	LIw	2, ENTETE_disp, STANDARD.IDL.TREE.ABSS
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	2
	MODI
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	1
	CEQ
	BF	L65
	La 1, -V_ofs
	LIVA 	, 0, STANDARD.IDL.SEM_PHASE_L7.UNIV_OPS.VECTOR.S
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	1
	NEG
	Sw
	BRA	L64
L65:
	LIw	2, ENTETE_disp, STANDARD.IDL.TREE.ABSS
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	2
	MODI
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	0
	CEQ
	BF	L66
	La 1, -V_ofs
	LIVA 	, 0, STANDARD.IDL.SEM_PHASE_L7.UNIV_OPS.VECTOR.S
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	1
	Sw
	BRA	L64
L66:
L64:					; post if
VAR	IL68_disp, b				; compteur boucle LOOP__4
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	1
	Sb  2,	IL68_disp
VAR	LMT_IL68_disp, b			; limite boucle LOOP__4
	LIw	2, ENTETE_disp, STANDARD.IDL.TREE.NSIZ
	Sb  2,	LMT_IL68_disp
	Lb  2,	IL68_disp				; test null range LOOP__4
	Lb  2,	LMT_IL68_disp
	CGT
	BT	L67
LOOP__4:					; corps boucle LOOP__4
	LIVA 	2, VDP_disp, STANDARD.IDL.SEM_PHASE_L7.UNIV_OPS.VECTOR_PAIRS.P
; EXPRESSIONS.CODE_INDEXED adresse component id
	Lb	2, IL68_disp
	Ld	 0, STANDARD.IDL.SEM_PHASE_L7.UNIV_OPS.VECTOR_DIGITS_PAIRS.FST_1	; (index - FST_1) * SIZ_1
	SUB
	Ld	 0, STANDARD.IDL.SEM_PHASE_L7.UNIV_OPS.VECTOR_DIGITS_PAIRS.COMP_SIZ
	LI	8
	DIV
	MUL
	ADD					; add offset to start address
VAR	ANON_211_23_disp, q
VAR	ANON_211_23__u,    q
VAR	ANON_211_23__dat, STANDARD.IDL.SEM_PHASE_L7.UNIV_OPS.UDIGIT_PAIR_TYPE.size
	LVA 2, ANON_211_23__dat
