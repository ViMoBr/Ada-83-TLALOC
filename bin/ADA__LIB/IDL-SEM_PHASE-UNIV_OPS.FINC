UNIV_OPS = 'UNIV_OPS'
namespace UNIV_OPS				;---------- PACKAGE
elab_spec:				;    SPEC ELAB


					; UDIGIT TYPE RANGE INFO
UDIGIT = 'UDIGIT'
namespace UDIGIT
VAR use__info, q
VAR SIZ, d
	LVA	0, SIZ
	Sa	0, use__info
VAR FST, w
VAR LST, w
	LI	16
	Sd	0, SIZ
; CODE_NUMERIC_LITERAL DN_UNIVERSAL_INTEGER
	LI	00032768
	NEG
	Sw	0, FST
; CODE_NUMERIC_LITERAL DN_UNIVERSAL_INTEGER
	LI	32767
	Sw	0, LST
end namespace

					; array decl constrained array type info
VECTOR_DIGITS = 'VECTOR_DIGITS'
namespace VECTOR_DIGITS
VAR use__info, q
VAR SIZ, d
	LVA	0, SIZ
	Sa	0, use__info
VAR COMP_SIZ, d
VAR FST_1, d
VAR LST_1, d
	LI	16
	Sd	0, COMP_SIZ
	Ld	0, COMP_SIZ
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	1
	Sd	0, FST_1
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	252
	Sd	0, LST_1
	Ld	0, LST_1
	INC
	Ld	0, FST_1
	SUB
	MUL
	Sd	0, SIZ
  virtual at 4
COMP_SIZ = $
	rd 1 
FST_1 = $
	rd 1 
LST_1 = $
	rd 1 
  end virtual
end namespace

					; VECTOR RECORD TYPE INFO
VECTOR = 'VECTOR'
namespace VECTOR
VAR use__info, q
VAR SIZ, d
	LVA	0, SIZ
	Sa	0, use__info
USEINFO 0, L, 	La 0, STANDARD.NATURAL.use__info
USEINFO 0, S, 	La 0, STANDARD.IDL.SEM_PHASE_L11.UNIV_OPS.UDIGIT.use__info
USEINFO 0, D, 	La 0, STANDARD.IDL.SEM_PHASE_L11.UNIV_OPS.VECTOR_DIGITS.use__info
virtual at 0				; calcul des offsets statiques
STATOFS L, 4
STATOFS S, 2
STATOFS D, 504
size = $
end virtual
	LI	 size*8
	Sd	0, SIZ
end namespace
					;    BODY ELAB
VAR NUM_VAL_disp, d				; variable entiere
	LI	2
	Sd  0,	NUM_VAL_disp


					; UDIGIT_PAIR_TYPE RECORD TYPE INFO
