					; VECTOR_PAIRS RECORD TYPE INFO
VECTOR_PAIRS = 'VECTOR_PAIRS'
namespace VECTOR_PAIRS
VAR use__info, q
VAR SIZ, d
	LVA	0, SIZ
	Sa	0, use__info
USEINFO 0, L, 	La 0, STANDARD.NATURAL.use__info
USEINFO 0, S, 	La 0, STANDARD.IDL.SEM_PHASE_L7.UNIV_OPS.UDIGIT.use__info
USEINFO 0, P, 	La 0, STANDARD.IDL.SEM_PHASE_L7.UNIV_OPS.VECTOR_DIGITS_PAIRS.use__info
