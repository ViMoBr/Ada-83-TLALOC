	La  0, STANDARD.IDL.SEM_PHASE_L7.UNIV_OPS.UDIGIT_PAIR_TYPE.use__info
	Sa  2, ANON_211_23__u
	LVA 2, ANON_211_23_disp
					; doublet resultat record anonyme
VAR	ANON_211_41_disp, q
