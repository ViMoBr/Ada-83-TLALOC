UNIV_OPS = 'UNIV_OPS'
namespace UNIV_OPS				;---------- PACKAGE (BDY)
					;    BODY ELAB
 hexa_show 'var elab NUM_VAL ', $
 hexa_show ' disp ', NUM_VAL_disp
VAR NUM_VAL_disp, d				; variable entiere
	LI	2
	Sd  0,	STANDARD.IDL.SEM_PHASE_L11.UNIV_OPS.NUM_VAL_disp


					; _UDIGIT_PAIR_TYPE RECORD TYPE INFO
_UDIGIT_PAIR_TYPE = '_UDIGIT_PAIR_TYPE'
namespace _UDIGIT_PAIR_TYPE
VAR use__info, q
VAR SIZ, d
	LVA	0, SIZ
	Sa	0, use__info
USEINFO 0, U1, 	La 1, STANDARD.IDL.SEM_PHASE_L11.UNIV_OPS._UDIGIT.use__info
USEINFO 0, U2, 	La 1, STANDARD.IDL.SEM_PHASE_L11.UNIV_OPS._UDIGIT.use__info
virtual at 0				; calcul des offsets statiques
STATOFS U1, 2, 2
STATOFS U2, 2, 2
size = $
end virtual
	LI	 size*8
	Sd	0, SIZ
end namespace

					; array decl constrained array type info
_VECTOR_DIGITS_PAIRS = '_VECTOR_DIGITS_PAIRS'
namespace _VECTOR_DIGITS_PAIRS
VAR use__info, q
VAR SIZ, d
	LVA	0, SIZ
	Sa	0, use__info
VAR _COMP_SIZ, d
VAR _FST_1, d
VAR _LST_1, d
	LI	32
	Sd	0, _COMP_SIZ
	Ld	0, _COMP_SIZ
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	1
	Sd	0, _FST_1
; CODE_NUMERIC_LITERAL DN_UNIVERSAL_INTEGER
	LI	126
; CODE CONVERSION SOURCE DN_UNIVERSAL_INTEGER TARGET DN_INTEGER
	DUP
	ULb	0, STANDARD.IDL._ATTR_NBR.FST
	CLT
	BT	STANDARD.ce_raise_
	DUP
	ULb	0, STANDARD.IDL._ATTR_NBR.LST
	CGT
	BT	STANDARD.ce_raise_
	Sd	0, _LST_1
	Ld	0, _LST_1
	Ld	0, _FST_1
	SUB
	INC
	CLAMP0
	MUL
	Sd	0, SIZ
  virtual at 4
COMP_SIZ = $
	rd 1 
FST_1 = $
	rd 1 
LST_1 = $
	rd 1 
  end virtual
end namespace

					; _VECTOR_PAIRS RECORD TYPE INFO
_VECTOR_PAIRS = '_VECTOR_PAIRS'
namespace _VECTOR_PAIRS
VAR use__info, q
VAR SIZ, d
	LVA	0, SIZ
	Sa	0, use__info
USEINFO 0, L, 	La 0, STANDARD._NATURAL.use__info
USEINFO 0, S, 	La 1, STANDARD.IDL.SEM_PHASE_L11.UNIV_OPS._UDIGIT.use__info
USEINFO 0, P, 	La 0, STANDARD.IDL.SEM_PHASE_L11.UNIV_OPS._VECTOR_DIGITS_PAIRS.use__info
virtual at 0				; calcul des offsets statiques
STATOFS L, 4, 4
STATOFS S, 2, 2
STATOFS P, 504, 8
size = $
end virtual
	LI	 size*8
	Sd	0, SIZ
end namespace

if defined DIGIT_MUL_L1_
PRO	DIGIT_MUL_L1				;---------- PRO DIGIT_MUL
 hexa_show 'DIGIT_MUL_L1 ', $
PRMS					;    debut parametrage
	PRM A_ofs				; in
	PRM B_ofs				; in
	PRM HIGH_ofs				; out
	PRM LOW_ofs				; out
endPRMS					;    fin parametrage
ELB 1					;    BODY ELAB
 hexa_show 'var elab A1 ', $
 hexa_show ' disp ', A1_disp
VAR A1_disp, w				; variable entiere
	Lw  1,	-A_ofs
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	100
	DUP
	LI	0
	CEQ
	BT	STANDARD.ne_raise_
	DIV
	Sw  1,	A1_disp

 hexa_show 'var elab B1 ', $
 hexa_show ' disp ', B1_disp
VAR B1_disp, w				; variable entiere
	Lw  1,	-B_ofs
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	100
	DUP
	LI	0
	CEQ
	BT	STANDARD.ne_raise_
	DIV
	Sw  1,	B1_disp

 hexa_show 'var elab A2 ', $
 hexa_show ' disp ', A2_disp
VAR A2_disp, w				; variable entiere
	Lw  1,	-A_ofs
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	100
	DUP
	LI	0
	CEQ
	BT	STANDARD.ne_raise_
	MODI
	Sw  1,	A2_disp

 hexa_show 'var elab B2 ', $
 hexa_show ' disp ', B2_disp
VAR B2_disp, w				; variable entiere
	Lw  1,	-B_ofs
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	100
	DUP
	LI	0
	CEQ
	BT	STANDARD.ne_raise_
	MODI
	Sw  1,	B2_disp

 hexa_show 'var elab XX ', $
 hexa_show ' disp ', XX_disp
VAR XX_disp, w				; variable entiere
	Lw 1,	A1_disp
	Lw 1,	B2_disp
	MUL
	Lw 1,	A2_disp
	Lw 1,	B1_disp
	MUL
	ADD
	Sw  1,	XX_disp

 hexa_show 'var elab LL ', $
 hexa_show ' disp ', LL_disp
VAR LL_disp, w				; variable entiere
	Lw 1,	A2_disp
	Lw 1,	B2_disp
	MUL
	Lw 1,	XX_disp
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	100
	DUP
	LI	0
	CEQ
	BT	STANDARD.ne_raise_
	MODI
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	100
	MUL
	ADD
	Sw  1,	LL_disp

					;    end elab
begin:					;---------- BDY INSTRUCTIONS
	Lw 1,	LL_disp
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	10000
	DUP
	LI	0
	CEQ
	BT	STANDARD.ne_raise_
	MODI
	SIw  1,	-LOW_ofs
	Lw 1,	A1_disp
	Lw 1,	B1_disp
	MUL
	Lw 1,	LL_disp
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	10000
	DUP
	LI	0
	CEQ
	BT	STANDARD.ne_raise_
	DIV
	ADD
	Lw 1,	XX_disp
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	100
	DUP
	LI	0
	CEQ
	BT	STANDARD.ne_raise_
	DIV
	ADD
	SIw  1,	-HIGH_ofs
ret_lbl:
	UNLINK 1
	RTD	prm_siz
excep:
endPRO					;---------- end PRO DIGIT_MUL
end if

if defined DIGIT_DIV_L4_
PRO	DIGIT_DIV_L4				;---------- PRO DIGIT_DIV
 hexa_show 'DIGIT_DIV_L4 ', $
PRMS					;    debut parametrage
	PRM H_ofs				; in
	PRM L_ofs				; in
	PRM A_ofs				; in
	PRM result__ofs				; resultat de fonction
endPRMS					;    fin parametrage
ELB 1					;    BODY ELAB
 hexa_show 'var elab QUO ', $
 hexa_show ' disp ', QUO_disp
VAR QUO_disp, w				; variable entiere

 hexa_show 'var elab PH ', $
 hexa_show ' disp ', PH_disp
VAR PH_disp, w				; variable entiere

 hexa_show 'var elab PL ', $
 hexa_show ' disp ', PL_disp
VAR PL_disp, w				; variable entiere

					;    end elab
begin:					;---------- BDY INSTRUCTIONS
					; debut if
	Lw  1,	-H_ofs
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	0
	CEQ
	BF	L8
; CODE_RETURN : EXPR TYPE = DN_INTEGER  VUE COMPLETE = DN_INTEGER
	Lw  1,	-L_ofs
	Lw  1,	-A_ofs
	DUP
	LI	0
	CEQ
	BT	STANDARD.ne_raise_
	DIV
	Sw  1,	-result__ofs
	BRA ret_lbl
	BRA	L7
L8:
	Lw  1,	-A_ofs
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	100
	CLT
	BF	L9
; CODE_RETURN : EXPR TYPE = DN_INTEGER  VUE COMPLETE = DN_INTEGER
	LI	0					; lieu resultat sur pile
	Lw  1,	-A_ofs
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	100
	MUL
	Lw  1,	-L_ofs
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	100
	DUP
	LI	0
	CEQ
	BT	STANDARD.ne_raise_
	MODI
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	100
	MUL
	Lw  1,	-H_ofs
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	100
	MUL
	Lw  1,	-L_ofs
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	100
	DUP
	LI	0
	CEQ
	BT	STANDARD.ne_raise_
	DIV
	ADD
	CALL	STANDARD.IDL.SEM_PHASE_L11.UNIV_OPS. ,DIGIT_DIV_L4
	Sw  1,	-result__ofs
	BRA ret_lbl
	BRA	L7
L9:
					; debut if
	Lw  1,	-H_ofs
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	100
	CGE
	BF	L11
	Lw  1,	-H_ofs
	Lw  1,	-A_ofs
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	99
	ADD
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	100
	DUP
	LI	0
	CEQ
	BT	STANDARD.ne_raise_
	DIV
	DUP
	LI	0
	CEQ
	BT	STANDARD.ne_raise_
	DIV
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	100
	MUL
	Sw  1,	QUO_disp
	BRA	L10
L11:
	Lw  1,	-H_ofs
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	100
	MUL
	Lw  1,	-L_ofs
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	100
	DUP
	LI	0
	CEQ
	BT	STANDARD.ne_raise_
	DIV
	ADD
	Lw  1,	-A_ofs
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	99
	ADD
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	100
	DUP
	LI	0
	CEQ
	BT	STANDARD.ne_raise_
	DIV
	DUP
	LI	0
	CEQ
	BT	STANDARD.ne_raise_
	DIV
	Sw  1,	QUO_disp
L10:					; post if
	LVA  1,	STANDARD.IDL.SEM_PHASE_L11.UNIV_OPS.DIGIT_DIV_L4.PL_disp
	LVA  1,	STANDARD.IDL.SEM_PHASE_L11.UNIV_OPS.DIGIT_DIV_L4.PH_disp
	Lw 1,	QUO_disp
	Lw  1,	-A_ofs
	CALL	STANDARD.IDL.SEM_PHASE_L11.UNIV_OPS. ,DIGIT_MUL_L1
					; debut if
	Lw  1,	-L_ofs
	Lw 1,	PL_disp
	CGE
	BF	L13
; CODE_RETURN : EXPR TYPE = DN_INTEGER  VUE COMPLETE = DN_INTEGER
	Lw 1,	QUO_disp
	LI	0					; lieu resultat sur pile
	Lw  1,	-A_ofs
	Lw  1,	-L_ofs
	Lw 1,	PL_disp
	SUB
	Lw  1,	-H_ofs
	Lw 1,	PH_disp
	SUB
	CALL	STANDARD.IDL.SEM_PHASE_L11.UNIV_OPS. ,DIGIT_DIV_L4
	ADD
	Sw  1,	-result__ofs
	BRA ret_lbl
	BRA	L12
L13:
; CODE_RETURN : EXPR TYPE = DN_INTEGER  VUE COMPLETE = DN_INTEGER
	Lw 1,	QUO_disp
	LI	0					; lieu resultat sur pile
	Lw  1,	-A_ofs
	Lw  1,	-L_ofs
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	10000
	ADD
	Lw 1,	PL_disp
	SUB
	Lw  1,	-H_ofs
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	1
	SUB
	Lw 1,	PH_disp
	SUB
	CALL	STANDARD.IDL.SEM_PHASE_L11.UNIV_OPS. ,DIGIT_DIV_L4
	ADD
	Sw  1,	-result__ofs
	BRA ret_lbl
L12:					; post if
L7:					; post if
ret_lbl:
	UNLINK 1
	RTD	prm_siz-8
excep:
endPRO					;---------- end PRO DIGIT_DIV
end if

