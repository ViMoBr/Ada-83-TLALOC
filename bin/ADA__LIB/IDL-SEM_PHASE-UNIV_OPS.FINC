ELB 3					;    BODY ELAB
VAR ENTETE_disp, q				; variable record : pointeur aux data record
VAR ENTETE__u, q				; variable record : pointeur aux useinfo
VAR ENTETE__dat, STANDARD.IDL.TREE.size
	LVA	3, ENTETE__dat
	Sa	3, ENTETE_disp				; record fin
	LVA	3, STANDARD.IDL.TREE.SIZ
	Sa	3, ENTETE__u
; CODE_VC_NAME DN_VARIABLE_ID
	La  3, ENTETE_disp
	LI	STANDARD.IDL.TREE.size
VAR	ANON_118_24_disp, q
VAR	ANON_118_24__u,    q
VAR	ANON_118_24__dat, STANDARD.IDL.TREE.size
	LVA 3, ANON_118_24__dat
	Sa  3, ANON_118_24_disp
	La  0, STANDARD.IDL.TREE.use__info
	Sa  3, ANON_118_24__u
	LVA 3, ANON_118_24_disp
					; doublet resultat record anonyme
	LVA 2,	STANDARD.IDL.SEM_PHASE_L7.UNIV_OPS.U_INT_L1.CAS_RETOUR_BLOC_UDIGITS.R_disp
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	0
	CALL	STANDARD.IDL.IDL_MAN. ,DABS_L30
	La  ,  0
	BLKMOV

					;    end elab
begin:					;---------- BDY INSTRUCTIONS
					; debut if
	La 1, -V_ofs
	LIw	, 0, STANDARD.IDL.SEM_PHASE_L7.UNIV_OPS.VECTOR.S
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	1
	NEG
	CEQ
	BF	L43
	LIVA 	3, ENTETE_disp, STANDARD.IDL.TREE.ABSS
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	1
	Sw
	BRA	L42
L43:
	LIVA 	3, ENTETE_disp, STANDARD.IDL.TREE.ABSS
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	0
	Sw
L42:					; post if
	LVA 3,	ENTETE_disp
	LVA 2,	STANDARD.IDL.SEM_PHASE_L7.UNIV_OPS.U_INT_L1.CAS_RETOUR_BLOC_UDIGITS.R_disp
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	0
