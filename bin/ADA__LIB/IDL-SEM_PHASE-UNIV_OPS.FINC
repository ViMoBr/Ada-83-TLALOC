namespace	CAS_RETOUR_BLOC_UDIGITS
ELB 2					;    BODY ELAB
VAR W_LEN_disp, w				; variable entiere
	La 1, -V_ofs
	LId	, 0, STANDARD.IDL.SEM_PHASE_L11.UNIV_OPS.VECTOR.L
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	1
	ADD
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	2
	DIV
; CODE CONVERSION SOURCE DN_INTEGER TARGET DN_INTEGER
	Sw  2,	W_LEN_disp

VAR R_disp, q				; variable record : pointeur aux data record
VAR R__u, q				; variable record : pointeur aux useinfo
VAR R__dat, STANDARD.IDL.TREE.size
	LVA	2, R__dat
	Sa	2, R_disp				; record fin
	LVA	2, STANDARD.IDL.TREE.SIZ
	Sa	2, R__u
; CODE_VC_NAME DN_VARIABLE_ID
	La  2, R_disp
	LI	STANDARD.IDL.TREE.size
VAR	ANON_113_19_disp, q
VAR	ANON_113_19__u,    q
VAR	ANON_113_19__dat, STANDARD.IDL.TREE.size
	LVA 2, ANON_113_19__dat
	Sa  2, ANON_113_19_disp
	La  0, STANDARD.IDL.TREE.use__info
	Sa  2, ANON_113_19__u
	LVA 2, ANON_113_19_disp
					; doublet resultat record anonyme
	Lw 2,	W_LEN_disp
	LI  2
	CALL	STANDARD.IDL.IDL_MAN. ,MAKE_L48
	La  ,  0
	BLKMOV

					;    end elab
