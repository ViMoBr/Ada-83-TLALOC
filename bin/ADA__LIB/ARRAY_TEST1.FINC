if defined AFFICHE_L8_
PRO	AFFICHE_L8				;---------- PRO AFFICHE
PRMS					;    debut parametrage
	PRM X_ofs				; in
endPRMS					;    fin parametrage
ELB 2					;    BODY ELAB
					;    end elab
begin:					;---------- BDY INSTRUCTIONS
	Ld 1,	STANDARD.ARRAY_TEST1_L1.INT_IO.DEFAULT_BASE_disp
	Ld 1,	STANDARD.ARRAY_TEST1_L1.INT_IO.DEFAULT_WIDTH_disp
	LVA	2, -X_ofs
	LIa	, , 8
	Ld	, _STRING.FST_1
	CALL	STANDARD.ARRAY_TEST1_L1.INT_IO. ,PUT_L5
	Ld 1,	STANDARD.ARRAY_TEST1_L1.INT_IO.DEFAULT_BASE_disp
	Ld 1,	STANDARD.ARRAY_TEST1_L1.INT_IO.DEFAULT_WIDTH_disp
	LVA	2, -X_ofs
	LIa	, , 8
	Ld	, _STRING.LST_1
	CALL	STANDARD.ARRAY_TEST1_L1.INT_IO. ,PUT_L5
	Ld 1,	STANDARD.ARRAY_TEST1_L1.INT_IO.DEFAULT_BASE_disp
	Ld 1,	STANDARD.ARRAY_TEST1_L1.INT_IO.DEFAULT_WIDTH_disp
	LVA	2, -X_ofs
	LIa	, , 8
	Ld	, _STRING.LST_1
	LVA	2, -X_ofs
	LIa	, , 8
	Ld	, _STRING.FST_1
	SUB
	INC
	CLAMP0
	CALL	STANDARD.ARRAY_TEST1_L1.INT_IO. ,PUT_L5
STR STR_L9, " ["				; constante string=" ["
	LCA	STR_L9.data_ptr
	CALL	STANDARD.TEXT_IO. ,PUT_L56
	La  2,	-X_ofs
	CALL	STANDARD.TEXT_IO. ,PUT_L56
STR STR_L10, "]"				; constante string="]"
	LCA	STR_L10.data_ptr
	CALL	STANDARD.TEXT_IO. ,PUT_LINE_L60
ret_lbl:
	UNLINK 2
	RTD	prm_siz
excep:
endPRO					;---------- end PRO AFFICHE
end if

if defined SOMME_L11_
PRO	SOMME_L11				;---------- PRO SOMME
PRMS					;    debut parametrage
	PRM T_ofs				; in
	PRM result__ofs				; resultat de fonction
endPRMS					;    fin parametrage
ELB 2					;    BODY ELAB
VAR R_disp, d				; variable entiere
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	0
	Sd  2,	R_disp

					;    end elab
begin:					;---------- BDY INSTRUCTIONS
VAR	IL13_disp, d				; compteur boucle LOOP__1
	LVA	2, -T_ofs
	LIa	, , 8
	Ld	, _VECTEUR.FST_1
	Sd  2,	IL13_disp
VAR	LMT_IL13_disp, d			; limite boucle LOOP__1
	LVA	2, -T_ofs
	LIa	, , 8
	Ld	, _VECTEUR.LST_1
	Sd  2,	LMT_IL13_disp
	Ld  2,	IL13_disp				; test null range LOOP__1
	Ld  2,	LMT_IL13_disp
	CGT
	BT	L12
LOOP__1:					; corps boucle LOOP__1
	Ld 2,	R_disp
	LVA	2, -T_ofs
	LIa	, , 0				; array data start address on stack
	Ld	2, IL13_disp
	LVA	2, -T_ofs
	LIa	, 0,  8
	Ld	, STANDARD.ARRAY_TEST1_L1._VECTEUR.FST_1	; (index - FST_1) * SIZ_1
	SUB
	LVA	2, -T_ofs
	LIa	, , 8
	Ld	, STANDARD.ARRAY_TEST1_L1._VECTEUR.COMP_SIZ
	LI	8
	DIV
	MUL
	ADD					; add offset to start address
	Ld
	ADD
	Sd  2,	R_disp
	Ld  2,	IL13_disp				; test de sortie LOOP__1
	Ld  2,	LMT_IL13_disp
	CEQ
	BT	L12
	Ld  2,	IL13_disp				; mise a jour compteur LOOP__1
	INC
	Sd  2,	IL13_disp
	BRA	LOOP__1				; iteration suivante LOOP__1
L12:					; post loop LOOP__1
; CODE_RETURN : EXPR TYPE = DN_INTEGER
	Ld 2,	R_disp
	Sd  2,	-result__ofs
	BRA ret_lbl
ret_lbl:
	UNLINK 2
	RTD	prm_siz-8
excep:
endPRO					;---------- end PRO SOMME
end if
					;    end elab
begin:					;---------- BDY INSTRUCTIONS
STR STR_L14, "=== 1. Contraint 1D : indexation, FIRST/LAST/LENGTH ==="	; constante string="=== 1. Contraint 1D : indexation, FIRST/LAST/LENGTH ==="
	LCA	STR_L14.data_ptr
	CALL	STANDARD.TEXT_IO. ,PUT_LINE_L60
VAR	IL16_disp, d				; compteur boucle LOOP__2
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	1
	Sd  1,	IL16_disp
VAR	LMT_IL16_disp, d			; limite boucle LOOP__2
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	5
	Sd  1,	LMT_IL16_disp
	Ld  1,	IL16_disp				; test null range LOOP__2
	Ld  1,	LMT_IL16_disp
	CGT
	BT	L15
LOOP__2:					; corps boucle LOOP__2
	La	 1, V_disp				; array data start address on stack
	Ld	1, IL16_disp
	LId	1, V__u, STANDARD.ARRAY_TEST1_L1._VEC5.FST_1	; (index - FST_1) * SIZ_1
	SUB
	LId	1, V__u, STANDARD.ARRAY_TEST1_L1._VEC5.COMP_SIZ
	LI	8
	DIV
	MUL
	ADD					; add offset to start address
	Ld	1, IL16_disp
	Ld	1, IL16_disp
	MUL
	Sd
	Ld  1,	IL16_disp				; test de sortie LOOP__2
	Ld  1,	LMT_IL16_disp
	CEQ
	BT	L15
	Ld  1,	IL16_disp				; mise a jour compteur LOOP__2
	INC
	Sd  1,	IL16_disp
	BRA	LOOP__2				; iteration suivante LOOP__2
L15:					; post loop LOOP__2
	Ld 1,	STANDARD.ARRAY_TEST1_L1.INT_IO.DEFAULT_BASE_disp
	Ld 1,	STANDARD.ARRAY_TEST1_L1.INT_IO.DEFAULT_WIDTH_disp
	La	 1, V_disp				; array data start address on stack
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	1
	LId	1, V__u, STANDARD.ARRAY_TEST1_L1._VEC5.FST_1	; (index - FST_1) * SIZ_1
	SUB
	LId	1, V__u, STANDARD.ARRAY_TEST1_L1._VEC5.COMP_SIZ
	LI	8
	DIV
	MUL
	ADD					; add offset to start address
	Ld
	CALL	STANDARD.ARRAY_TEST1_L1.INT_IO. ,PUT_L5
	Ld 1,	STANDARD.ARRAY_TEST1_L1.INT_IO.DEFAULT_BASE_disp
	Ld 1,	STANDARD.ARRAY_TEST1_L1.INT_IO.DEFAULT_WIDTH_disp
	La	 1, V_disp				; array data start address on stack
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	3
	LId	1, V__u, STANDARD.ARRAY_TEST1_L1._VEC5.FST_1	; (index - FST_1) * SIZ_1
	SUB
	LId	1, V__u, STANDARD.ARRAY_TEST1_L1._VEC5.COMP_SIZ
	LI	8
	DIV
	MUL
	ADD					; add offset to start address
