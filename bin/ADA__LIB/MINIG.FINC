PRO	MINIG_L1				;---------- PRO MINIG
ELB 1					;    BODY ELAB
_V__type = '_V__type'
namespace _V__type				; array var constrained array type info
VAR use__info, q
VAR SIZ, d
	LVA	1, SIZ
	Sa	1, use__info
VAR _COMP_SIZ, d
VAR _FST_1, d
VAR _LST_1, d
	LI	8
	Sd	1, _COMP_SIZ
	Ld	1, _COMP_SIZ
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	1
	Sd	1, _FST_1
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	4
	Sd	1, _LST_1
	Ld	1, _LST_1
	Ld	1, _FST_1
	SUB
	INC
	CLAMP0
	MUL
	Sd	1, SIZ
  virtual at 4
COMP_SIZ = $
	rd 1 
FST_1 = $
	rd 1 
LST_1 = $
	rd 1 
  end virtual
end namespace
VAR V_disp, q				; variable array : pointeur aux data
VAR V__u, q				; variable array : useinfo pointeur au rec info
	La 1, _V__type.use__info
	Sa	1, V__u				; array info ptr at __u
	Ld	1, _V__type.SIZ
	LI	8
	DIV
	CO_VAR
	Sa	1, V_disp				; array data ptr at _disp

; GENERIC_SUBPROGRAM_SPEC

if defined P_L2_
PRO	P_L2					;---------- PRO P
virtual at 8
	T3__u_ofs = $
	rq 1
	T3__ld_ofs = $
	rq 1
	T3__st_ofs = $
	rq 1
	T3__inadr_ofs = $
	rq 1
	T3__outadr_ofs = $
	rq 1
end virtual
PRMS					;    debut parametrage
	PRM GFP_ofs
endPRMS					;    fin parametrage
ELB 2					;    BODY ELAB
_S__type = '_S__type'
namespace _S__type				; array var constrained array type info
VAR use__info, q
VAR SIZ, d
	LVA	2, SIZ
	Sa	2, use__info
VAR _COMP_SIZ, d
VAR _FST_1, d
VAR _LST_1, d
	LI	8
	Sd	2, _COMP_SIZ
	Ld	2, _COMP_SIZ
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	1
	Sd	2, _FST_1
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	2
	Sd	2, _LST_1
	Ld	2, _LST_1
	Ld	2, _FST_1
	SUB
	INC
	CLAMP0
	MUL
	Sd	2, SIZ
  virtual at 4
COMP_SIZ = $
	rd 1 
FST_1 = $
	rd 1 
LST_1 = $
	rd 1 
  end virtual
end namespace
VAR S_disp, q				; variable array : pointeur aux data
VAR S__u, q				; variable array : useinfo pointeur au rec info
	La 2, _S__type.use__info
	Sa	2, S__u				; array info ptr at __u
	Ld	2, _S__type.SIZ
	LI	8
	DIV
	CO_VAR
	Sa	2, S_disp				; array data ptr at _disp

					;    end elab
begin:					;---------- BDY INSTRUCTIONS
namespace	BLOCK__1
ELB 3					;    BODY ELAB
					;    end elab
begin:					;---------- BDY INSTRUCTIONS
	LVA 2,	STANDARD.MINIG_L1.P.S_disp
	La
	LId	2, STANDARD.MINIG_L1.P.S__u, 0
	LI	8
	DIV
	LVA 2,	STANDARD.MINIG_L1.P.S_disp
	La
	BLKMOV
	UNLINK 3
endPRO
ret_lbl:
	UNLINK 2
	RTD
excep:
endPRO					;---------- end PRO P
end if
					;    end elab
begin:					;---------- BDY INSTRUCTIONS
ret_lbl:
	UNLINK 1
	RTD
excep:
endPRO					;---------- end PRO MINIG
