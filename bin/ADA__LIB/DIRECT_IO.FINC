begin:					;---------- BDY INSTRUCTIONS
					; debut if
	La 1, -FILE_ofs
	LIb	, 0, STANDARD.DIRECT_IO.FILE_TYPE.IS_OPENED
	LI	0
	CEQ
	BF	L23
	BRA	L22
L23:
L22:					; post if
