if ~ definite SYSTEM
include 'SYSTEM.FINC'
end if
if ~ definite MACHINE_CODE
include 'MACHINE_CODE.FINC'
end if
DIRECT_IO = 'DIRECT_IO'
namespace DIRECT_IO
					;---------- GENERIC PACKAGE BODY ----------

PRMS
	PRM ELEMENT_TYPE__u_ofs
	PRM ELEMENT_TYPE__ld_ofs
	PRM ELEMENT_TYPE__st_ofs
	PRM ELEMENT_TYPE__inadr_ofs
	PRM ELEMENT_TYPE__outadr_ofs
endPRMS
; CODE_TYPE_DECL : skip PRIVATE FILE_TYPE (deferred to full type)

					; FILE_MODE ENUMERATION TYPE INFO
FILE_MODE = 'FILE_MODE'
namespace FILE_MODE
VAR use__info, q
BEGIN_BLOC_DEF
db 0, 7, "IN_FILE"
db 1, 10, "INOUT_FILE"
db 2, 8, "OUT_FILE"
END_BLOC_DEF
IMAGES	BYTES_BLOC
CST LST, d, 2
CST FST, d, 0
CST SIZ, d, 8	; SIZ en bits !
postpone
  align_q
end postpone
	LCA	SIZ
	Sa	0, use__info
end namespace

					; COUNT TYPE RANGE INFO
COUNT = 'COUNT'
namespace COUNT
VAR use__info, q
VAR SIZ, d
	LVA	0, SIZ
	Sa	0, use__info
VAR FST, d
VAR LST, d
	LI	32
	Sd	0, SIZ
	LI	0
	Sd	0, FST
	LI	002147483647
	Sd	0, LST
end namespace

					; POSITIVE_COUNT INTEGER SUBTYPE INFO
POSITIVE_COUNT = 'POSITIVE_COUNT'
namespace POSITIVE_COUNT
VAR use__info, q
VAR SIZ, d
	LVA	0, SIZ
	Sa	0, use__info
VAR FST, d
VAR LST, d
	LI	32
	Sd	0, SIZ
	LI	1
	Sd	0, FST
	LI	002147483647
	Sd	0, LST
VAR PARENT__u, q
	La	0, STANDARD.DIRECT_IO.COUNT.use__info
	Sa	0, PARENT__u
end namespace
FILE_NAME_BUFFER = 'FILE_NAME_BUFFER'
namespace FILE_NAME_BUFFER			; FILE_NAME_BUFFER CONSTRAINED ARRAY SUBTYPE INFO
VAR use__info, q
VAR SIZ, d
	LVA	0, SIZ
	Sa	0, use__info
VAR COMP_SIZ, d
VAR FST_1, d
VAR LST_1, d
	LI	8
	Sd	0, COMP_SIZ
	Ld	0, COMP_SIZ
	LI	1
	Sd	0, FST_1
	LI	256
	Sd	0, LST_1
	Ld	0, LST_1
	INC
	Ld	0, FST_1
	SUB
	MUL
	Sd	0, SIZ
  virtual at 4
COMP_SIZ = $
	rd 1 
FST_1 = $
	rd 1 
LST_1 = $
	rd 1 
  end virtual
end namespace

					; FILE_TYPE RECORD TYPE INFO
FILE_TYPE = 'FILE_TYPE'
namespace FILE_TYPE
VAR use__info, q
VAR SIZ, d
	LVA	0, SIZ
	Sa	0, use__info
USEINFO 0, ID, 	La 0, STANDARD.INTEGER.use__info
USEINFO 0, NAME, 	La 0, STANDARD.DIRECT_IO.FILE_NAME_BUFFER.use__info
USEINFO 0, NAME_LEN, 	La 0, STANDARD.POSITIVE.use__info
USEINFO 0, IS_OPENED, 	La 0, STANDARD.BOOLEAN.use__info
USEINFO 0, MODE, 	La 0, STANDARD.DIRECT_IO.FILE_MODE.use__info
USEINFO 0, INDEX, 	La 0, STANDARD.DIRECT_IO.POSITIVE_COUNT.use__info
USEINFO 0, AT_END_OF_FILE, 	La 0, STANDARD.BOOLEAN.use__info
virtual at 0				; calcul des offsets statiques
STATOFS ID, 4
STATOFS NAME, 256
STATOFS NAME_LEN, 4
STATOFS IS_OPENED, 1
STATOFS MODE, 1
STATOFS INDEX, 4
STATOFS AT_END_OF_FILE, 1
size = $
end virtual
	LI	 size*8
	Sd	0, SIZ
end namespace
					;    BODY ELAB

if defined CREATE_L1_
PRO	CREATE_L1				;---------- PRO CREATE
PRMS					;    debut parametrage
	PRM FILE_ofs				; in out
	PRM MODE_ofs				; in
	PRM NAME_ofs				; in
	PRM FORM_ofs				; in
	PRM GFP_ofs
endPRMS					;    fin parametrage
ELB 1					;    BODY ELAB
VAR ERR_OR_ID_disp, d			; variable entiere


if defined CREATE_SYSTEM_CALL_L1_
PRO	CREATE_SYSTEM_CALL_L1			;---------- PRO CREATE_SYSTEM_CALL
PRMS					;    debut parametrage
	PRM NAME_ofs				; in
	PRM GFP_ofs
	PRM result__ofs				; resultat de fonction
endPRMS					;    fin parametrage
ELB 2					;    BODY ELAB
					;    end elab
begin:					;---------- BDY INSTRUCTIONS
	LA 2 ,	-8
	SYS_FILE_CREATE
	SD 2 ,	-24
ret_lbl:
	UNLINK 2
	RTD	prm_siz-8
excep:
endPRO					;---------- end PRO CREATE_SYSTEM_CALL
end if
					;    end elab
begin:					;---------- BDY INSTRUCTIONS
	LI	0					; lieu resultat sur pile
	La  1,	-GFP_ofs				; propagation GFP generique
	La  1,	-NAME_ofs
	CALL	STANDARD.DIRECT_IO.CREATE_L1. ,CREATE_SYSTEM_CALL_L1
	Sd  1,	ERR_OR_ID_disp
					; debut if
	Ld 1,	ERR_OR_ID_disp
	LI	0
	CGE
	BF	L3
	La 1, -FILE_ofs
	LIVa 	, 0, STANDARD.DIRECT_IO.FILE_TYPE.ID
	Ld 1,	ERR_OR_ID_disp
	Sd
	La 1, -FILE_ofs
	LIVa 	, 0, STANDARD.DIRECT_IO.FILE_TYPE.NAME
	LVA	1, -NAME_ofs
	LIa	, , 8
	Ld	, STRING.LST_1
	INC
	LVA	1, -NAME_ofs
	LIa	, , 8
	Ld	, STRING.FST_1
	SUB
	INC
	LI	1
	SUB
	LI	1
	MUL
	La  1,	-NAME_ofs
	La
	BLKMOV
	La 1, -FILE_ofs
	LIVa 	, 0, STANDARD.DIRECT_IO.FILE_TYPE.NAME_LEN
	LVA	1, -NAME_ofs
	LIa	, , 8
	Ld	, STRING.LST_1
	INC
	LVA	1, -NAME_ofs
	LIa	, , 8
	Ld	, STRING.FST_1
	SUB
	Sd
	La 1, -FILE_ofs
	LIVa 	, 0, STANDARD.DIRECT_IO.FILE_TYPE.IS_OPENED
	LI	1
	Sb
	La 1, -FILE_ofs
	LIVa 	, 0, STANDARD.DIRECT_IO.FILE_TYPE.MODE
	Lb  1,	-MODE_ofs
	Sb
	La 1, -FILE_ofs
	LIVa 	, 0, STANDARD.DIRECT_IO.FILE_TYPE.INDEX
	LI	1
	Sd
	La 1, -FILE_ofs
	LIVa 	, 0, STANDARD.DIRECT_IO.FILE_TYPE.AT_END_OF_FILE
	LI	0
	Sb
	BRA	L2
L3:
L2:					; post if
ret_lbl:
	UNLINK 1
	RTD	prm_siz
excep:
endPRO					;---------- end PRO CREATE
end if

