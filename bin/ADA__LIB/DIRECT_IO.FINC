	La 1, -FILE_ofs
	LIb	, 0, STANDARD.DIRECT_IO.FILE_TYPE.MODE
	LI	2
	CEQ
	BF	L25
	BRA	L24
L25:
L24:					; post if
					; debut if
	Ld  1,	-FROM_ofs
	LI	0
	CLE
	BF	L27
	BRA	L26
L27:
L26:					; post if
	LI	0					; lieu resultat sur pile
	La  1,	-GFP_ofs				; propagation GFP generique
	Ld  1,	-FROM_ofs
	LI	1
	SUB
	Ld 1,	SIZE_BYTES_disp
	MUL
	La 1, -FILE_ofs
