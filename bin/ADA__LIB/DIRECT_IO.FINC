include 'MACHINE_CODE.FINC'
DIRECT_IO = 'DIRECT_IO'
namespace DIRECT_IO				;---------- GENERIC PACKAGE
PRMS
	PRM ELEMENT_TYPE__u_ofs
	PRM ELEMENT_TYPE__ld_ofs
	PRM ELEMENT_TYPE__st_ofs
endPRMS
; CODE_TYPE_DECL : skip PRIVATE FILE_TYPE (deferred to full type)
FILE_MODE = 'FILE_MODE'
namespace FILE_MODE				; FILE_MODE ENUMERATION TYPE INFO
BEGIN_BLOC_DEF
db 0, 7, "IN_FILE"
db 1, 10, "INOUT_FILE"
db 2, 8, "OUT_FILE"
END_BLOC_DEF
IMAGES	BYTES_BLOC
CST LST, d, 2
CST FST, d, 0
CST SIZ, d, 8	; SIZ en bits !
postpone
  align_q
end postpone
VAR use__info, q
	LCA	SIZ
	Sa	0, use__info
end namespace

COUNT = 'COUNT'
namespace COUNT				; COUNT TYPE RANGE INFO
VAR use__info, q
VAR SIZ, d
	LVA	0, SIZ
	Sa	0, use__info
VAR FST, d
VAR LST, d
	LI	32
	Sb	0, SIZ
	LI	0
	Sd	0, FST
	LI	2147483647
	Sd	0, LST
end namespace

POSITIVE_COUNT = 'POSITIVE_COUNT'
namespace POSITIVE_COUNT			; POSITIVE_COUNT INTEGER SUBTYPE INFO
VAR use__info, q
VAR SIZ, d
	LVA	 0, SIZ
	Sa	 0, use__info
end namespace

FILE_NAME_BUFFER = 'FILE_NAME_BUFFER'
namespace FILE_NAME_BUFFER			; FILE_NAME_BUFFER CONSTRAINED ARRAY SUBTYPE INFO
VAR SIZ, d
  namespace info
VAR COMP_SIZ, d
VAR FST_1, d
VAR LST_1, d
	LI	1
	Sd	0, COMP_SIZ
	Ld	0, COMP_SIZ
	LI	1
	Sd	0, FST_1
	LI	256
	Sd	0, LST_1
	Ld	0, LST_1
	INC
	Ld	0, FST_1
	SUB
	MUL
	Sd	0, SIZ
  end namespace
  virtual at 4
COMP_SIZ = $
	rd 1 
FST_1 = $
	rd 1 
LST_1 = $
	rd 1 
  end virtual
end namespace

FILE_TYPE = 'FILE_TYPE'
namespace FILE_TYPE				; FILE_TYPE RECORD TYPE INFO
VAR use__info, q
VAR SIZ, d
	LVA	0, SIZ
	Sa	0, use__info
USEINFO 0, ID, 	LVA	0, STANDARD.INTEGER.SIZ
USEINFO 0, NAME, 	LVA	0, STANDARD.DIRECT_IO.FILE_NAME_BUFFER.SIZ
USEINFO 0, NAME_LEN, 	LVA	0, STANDARD.POSITIVE.SIZ
USEINFO 0, IS_OPENED, 	LCA	STANDARD.BOOLEAN.SIZ
USEINFO 0, MODE, 	LCA	STANDARD.DIRECT_IO.FILE_MODE.SIZ
USEINFO 0, INDEX, 	LVA	0, STANDARD.DIRECT_IO.POSITIVE_COUNT.SIZ
USEINFO 0, AT_END_OF_FILE, 	LCA	STANDARD.BOOLEAN.SIZ
virtual at 0
STATOFS ID, 4
STATOFS NAME, 256
STATOFS NAME_LEN, 4
STATOFS IS_OPENED, 1
STATOFS MODE, 1
STATOFS INDEX, 4
STATOFS AT_END_OF_FILE, 1
size = $
end virtual
end namespace

