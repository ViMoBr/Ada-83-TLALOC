	LIVa 	, 0, STANDARD.DIRECT_IO.FILE_TYPE.NAME
namespace ANON_128_37			; ensemble doublet @data/@info pour slice anonyme source
VAR ANON_128_37_disp, q
VAR ANON_128_37__u, q
VAR SIZ, d
VAR COMP_SIZ, d
VAR FST_1, d
VAR LST_1, d
	Sa	1, ANON_128_37_disp
	LVA	1, SIZ
	Sa	1, ANON_128_37__u
	LI	8
	Sd	1, COMP_SIZ
	LI	1
	Sd	1, FST_1
	La 1, -FILE_ofs
	LId	, 0, STANDARD.DIRECT_IO.FILE_TYPE.NAME_LEN
	Sd	1, LST_1
	Ld	1, LST_1
	INC
	Ld	1, FST_1
	SUB
	LI	8
	MUL
	Sd	1, SIZ
	LVA	1, ANON_128_37_disp
end namespace
	CALL	STANDARD.DIRECT_IO.DELETE_L4. ,DELETE_SYSTEM_CALL_L8
	Sd  1,	ERR_CODE_disp
	La 1, -FILE_ofs
	LIVa 	, 0, STANDARD.DIRECT_IO.FILE_TYPE.IS_OPENED
	LI	0
	Sb
ret_lbl:
	UNLINK 1
	RTD	prm_siz
excep:
