if ~ definite REPORT
include 'REPORT.FINC'
end if
PRO	A2A031A_L1				;---------- PRO A2A031A
ELB 1					;    BODY ELAB

					; _ENUM ENUMERATION TYPE INFO
_ENUM = '_ENUM'
namespace _ENUM
VAR use__info, q
BEGIN_BLOC_DEF
db 0, 2, "E1"
db 1, 2, "E2"
db 2, 2, "E3"
END_BLOC_DEF
IMAGES	BYTES_BLOC
CST LST, d, 2
CST FST, d, 0
CST SIZ, d, 8	; SIZ en bits !
postpone
  align_q
end postpone
	LCA	SIZ
	Sa	1, use__info
end namespace

					; _REC RECORD TYPE INFO
_REC = '_REC'
namespace _REC
VAR use__info, q
VAR SIZ, d
	LVA	1, SIZ
	Sa	1, use__info
USEINFO 1, A, 	La 1, STANDARD.A2A031A_L1._ENUM.use__info
USEINFO 1, B, 	La 1, STANDARD.A2A031A_L1._ENUM.use__info
USEINFO 1, C, 	La 0, STANDARD._INTEGER.use__info
USEINFO 1, D, 	La 0, STANDARD._INTEGER.use__info
USEINFO 1, E, 	La 0, STANDARD._FLOAT.use__info
virtual at 0				; calcul des offsets statiques
STATOFS A, 1
STATOFS B, 1
STATOFS C, 4
STATOFS D, 4
STATOFS E, 4
size = $
end virtual
	LI	 size*8
	Sd	1, SIZ
end namespace
VAR VAR_disp, q				; variable record : pointeur aux data record
VAR VAR__u, q				; variable record : pointeur aux useinfo
VAR VAR__dat, STANDARD.A2A031A_L1._REC.size
	LVA	1, VAR__dat
	Sa	1, VAR_disp				; record fin
	LVA	1, STANDARD.A2A031A_L1._REC.SIZ
	Sa	1, VAR__u
; CODE_VC_NAME DN_VARIABLE_ID

VAR EVAR_disp, b				; variable entiere
	LI	1
	Sb  1,	EVAR_disp

					;    end elab
begin:					;---------- BDY INSTRUCTIONS
STR STR_L2, "CHECK USE OF ! AS SEPARATOR IN PLACE OF |"	; constante string="CHECK USE OF ! AS SEPARATOR IN PLACE OF |"
	LCA	STR_L2.data_ptr
STR STR_L3, "A2A031A"			; constante string="A2A031A"
	LCA	STR_L3.data_ptr
	CALL	STANDARD.REPORT. ,TEST_L1
					; debut case
	Lb 1,	EVAR_disp
	DUP
	LI	2
	CEQ
	BT	L5
	DUP
	LI	1
	CEQ
	BT	L6
	DUP
	LI	0
	CEQ
	BT	L6
	DROP
	BRA	L4
L5:
	DROP
	BRA	L4
L6:
	DROP
	BRA	L4
L4:
					; fin case
	LVA 1,	VAR_disp
	La
					; Assign_record_aggregate type DN_RECORD
	DUP
	LVA	, STANDARD.A2A031A_L1._REC.A
	LI	1
	Sb
	DUP
	LVA	, STANDARD.A2A031A_L1._REC.B
	LI	1
	Sb
	DUP
	LVA	, STANDARD.A2A031A_L1._REC.C
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	0
	Sd
	DUP
	LVA	, STANDARD.A2A031A_L1._REC.D
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	0
	Sd
	DROP
	CALL	STANDARD.REPORT. ,RESULT_L6
; CHOICE_EXP in EXCEPTIONS todo
; CHOICE_EXP in EXCEPTIONS todo
; CHOICE_EXP in EXCEPTIONS todo
	BRA	L7
L8:
L7:
ret_lbl:
	UNLINK 1
	RTD
excep:
endPRO					;---------- end PRO A2A031A
