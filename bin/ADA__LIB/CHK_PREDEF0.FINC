STR STR_L17, "BOOLEAN  "			; constante string="BOOLEAN  "
	LCA	STR_L17.data_ptr
	CALL	STANDARD.CHK_PREDEF0_L1. ,SHOW_BOOL_L12
ret_lbl:
	UNLINK 1
	RTD
excep:
endPRO					;---------- end PRO CHK_PREDEF0
