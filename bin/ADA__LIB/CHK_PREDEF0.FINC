VAR GFP_disp, q				; Lieu du Generic Frame Pointer 
PRO	SHOW_BOOL_L12				;---------- PRO SHOW_BOOL
PRMS					;    debut parametrage
	PRM LABEL_ofs				; in
endPRMS					;    fin parametrage
ELB 2
begin:
	LVA	 1, GFP_disp
	La 	 2, -LABEL_ofs
	CALL	STANDARD.CHK_PREDEF0_L1. ,SHOW_BOUNDS_L2
	UNLINK	 2
	RTD	prm_siz
endPRO					;---------- end PRO SHOW_BOOL
end if
					;    end elab
begin:					;---------- BDY INSTRUCTIONS
STR STR_L15, "INTEGER  "			; constante string="INTEGER  "
	LCA	STR_L15.data_ptr
	CALL	STANDARD.CHK_PREDEF0_L1. ,SHOW_INT_L10
STR STR_L16, "CHARACTER"			; constante string="CHARACTER"
