CASE_ST1 = 'CASE_ST1'
PRO	CASE_ST1_L1				;---------- PRO CASE_ST1
 hexa_show 'CASE_ST1_L1 ', $
ELB 1					;    BODY ELAB
 hexa_show 'var elab OK_COUNT ', $
VAR OK_COUNT_disp, d			; variable entiere
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	0
	Sd  1,	OK_COUNT_disp

 hexa_show ' disp ', OK_COUNT_disp
 hexa_show 'var elab FAIL_COUNT ', $
VAR FAIL_COUNT_disp, d			; variable entiere
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	0
	Sd  1,	FAIL_COUNT_disp

 hexa_show ' disp ', FAIL_COUNT_disp

					; _LOW INTEGER SUBTYPE INFO
_LOW = '_LOW'
namespace _LOW
VAR use__info, q
VAR SIZ, d
	LVA	1, SIZ
	Sa	1, use__info
VAR FST, d
VAR LST, d
	LI	32
	Sd	1, SIZ
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	5
	NEG
	Sd	1, FST
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	3
	Sd	1, LST
VAR PARENT__u, q
	La	0, STANDARD._INTEGER.use__info
	Sa	1, PARENT__u
end namespace

					; _MID INTEGER SUBTYPE INFO
_MID = '_MID'
namespace _MID
VAR use__info, q
VAR SIZ, d
	LVA	1, SIZ
	Sa	1, use__info
VAR FST, d
VAR LST, d
	LI	32
	Sd	1, SIZ
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	10
	Sd	1, FST
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	20
	Sd	1, LST
VAR PARENT__u, q
	La	0, STANDARD._INTEGER.use__info
	Sa	1, PARENT__u
end namespace

					; _COLOR ENUMERATION TYPE INFO
_COLOR = '_COLOR'
namespace _COLOR
VAR use__info, q
BEGIN_BLOC_DEF
db 0, 5, "ROUGE"
db 1, 6, "ORANGE"
db 2, 5, "JAUNE"
db 3, 4, "VERT"
db 4, 4, "BLEU"
db 5, 6, "INDIGO"
db 6, 6, "VIOLET"
END_BLOC_DEF 8, 0, 6
	; SIZ en bits !
	LCA	SIZ
	Sa	1, use__info
end namespace

					; _CHAUD ENUMERATION SUBTYPE INFO
_CHAUD = '_CHAUD'
namespace _CHAUD
VAR use__info, q
VAR SIZ, d
	LVA	1, SIZ
	Sa	1, use__info
VAR FST, b
VAR LST, b
	LI	8
	Sd	1, SIZ
	LI	0
	Sb	1, FST
	LI	2
	Sb	1, LST
VAR PARENT__u, q
	La 1	, STANDARD.CASE_ST1_L1._COLOR.use__info
	Sa	1, PARENT__u
end namespace

					; _FROID ENUMERATION SUBTYPE INFO
_FROID = '_FROID'
namespace _FROID
VAR use__info, q
VAR SIZ, d
	LVA	1, SIZ
	Sa	1, use__info
VAR FST, b
VAR LST, b
	LI	8
	Sd	1, SIZ
	LI	3
	Sb	1, FST
	LI	6
	Sb	1, LST
VAR PARENT__u, q
	La 1	, STANDARD.CASE_ST1_L1._COLOR.use__info
	Sa	1, PARENT__u
end namespace
INT_IO = 'INT_IO'
namespace INT_IO				;---------- GENERIC PACKAGE INSTANTIATION
elab_spec:				;    SPEC ELAB

; F4A SET  cle=NUM  actuel=DN_INTEGER
BRA post_LD_NUM
LD_NUM.elab:
	Ld -1, 0
	RTD 0
post_LD_NUM:
BRA post_ST_NUM
ST_NUM.elab:
	Sd -1, 0
	RTD 0
post_ST_NUM:
BRA post_INADR_NUM
INADR_NUM.elab:
	RTD 0
post_INADR_NUM:
BRA post_OUTADR_NUM
OUTADR_NUM.elab:
	La
	RTD 0
post_OUTADR_NUM:
VAR NUM__outadr_ofs, q
	LCA OUTADR_NUM.elab
	Sa	 1, NUM__outadr_ofs
VAR NUM__inadr_ofs, q
	LCA INADR_NUM.elab
	Sa	 1, NUM__inadr_ofs
VAR NUM__st_ofs, q
	LCA ST_NUM.elab
	Sa	 1, NUM__st_ofs
VAR NUM__ld_ofs, q
	LCA LD_NUM.elab
	Sa	 1, NUM__ld_ofs
VAR NUM__u_ofs, q
	La	 0, STANDARD._INTEGER.use__info
	Sa	 1, NUM__u_ofs
VAR GFP_disp, q				; Lieu du Generic Frame Pointer 
					; CODE_PACKAGE_SPEC
 hexa_show ' spec ', $
 hexa_show 'var elab DEFAULT_WIDTH ', $
VAR DEFAULT_WIDTH_disp, d			; variable entiere
	LI	 11
	DUP
	Ld	0, STANDARD.TEXT_IO._FIELD.FST
	CLT
	BT	STANDARD.ce_raise_
	DUP
	Ld	0, STANDARD.TEXT_IO._FIELD.LST
	CGT
	BT	STANDARD.ce_raise_
	Sd  1,	STANDARD.CASE_ST1_L1.INT_IO.DEFAULT_WIDTH_disp

 hexa_show ' disp ', DEFAULT_WIDTH_disp
 hexa_show 'var elab DEFAULT_BASE ', $
VAR DEFAULT_BASE_disp, d			; variable entiere
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	10
	DUP
	Ld	0, STANDARD.TEXT_IO._NUMBER_BASE.FST
	CLT
	BT	STANDARD.ce_raise_
	DUP
	Ld	0, STANDARD.TEXT_IO._NUMBER_BASE.LST
	CGT
	BT	STANDARD.ce_raise_
	Sd  1,	STANDARD.CASE_ST1_L1.INT_IO.DEFAULT_BASE_disp

 hexa_show ' disp ', DEFAULT_BASE_disp
					; sub program entry decl (in instantiation TRUE )
if defined GET_L2_
PRO	GET_L2				;---------- PRO GET
 hexa_show 'GET_L2 ', $
PRMS					;    debut parametrage
	PRM FILE_ofs				; in
	PRM ITEM_ofs				; out
	PRM WIDTH_ofs				; in
endPRMS					;    fin parametrage
ELB 2
begin:
	LVA	 1, GFP_disp
	Ld	 2, -WIDTH_ofs
	La 	 2, -ITEM_ofs
	La 	 2, -FILE_ofs
	CALL	STANDARD.TEXT_IO.INTEGER_IO. ,GET_L61
	UNLINK	 2
	RTD	prm_siz
endPRO					;---------- end PRO GET
end if
					; sub program entry decl (in instantiation TRUE )
