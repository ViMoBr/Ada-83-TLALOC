	ULb  2,	-C_ofs
	DUP
	LI	0
	CGE
	BF	L31
	DUP
	LI	2
	CGT
	BF	L29
L31:
	DUP
	LI	3
	CGE
	BF	L32
	DUP
	LI	6
	CGT
	BF	L30
L32:
	DROP
	BRA	L28
L29:
	DROP
; CODE_RETURN : EXPR TYPE = DN_INTEGER  VUE COMPLETE = DN_INTEGER
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	1
	Sq  2,	-result__ofs
	BRA ret_lbl
	BRA	L28
L30:
	DROP
; CODE_RETURN : EXPR TYPE = DN_INTEGER  VUE COMPLETE = DN_INTEGER
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	2
	Sq  2,	-result__ofs
	BRA ret_lbl
	BRA	L28
L28:
					; fin case
ret_lbl:
	UNLINK 2
	RTD	prm_siz-8
excep:
endPRO					;---------- end PRO TEMP
end if

if defined MIXTE_L33_
PRO	MIXTE_L33				;---------- PRO MIXTE
 hexa_show 'MIXTE_L33 ', $
