	DUP
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	42
	CEQ
	BT	L37
	DROP
	BRA	L38
L37:
	DROP
; CODE_RETURN : EXPR TYPE = DN_INTEGER  VUE COMPLETE = DN_INTEGER
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	1
	Sq  2,	-result__ofs
	BRA ret_lbl
	BRA	L36
L38:
; CODE_RETURN : EXPR TYPE = DN_INTEGER  VUE COMPLETE = DN_INTEGER
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	0
	Sq  2,	-result__ofs
	BRA ret_lbl
	BRA	L36
L36:
					; fin case
ret_lbl:
	UNLINK 2
	RTD	prm_siz-8
excep:
endPRO					;---------- end PRO MIXTE
