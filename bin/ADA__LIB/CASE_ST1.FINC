if defined CHECK_L8_
PRO	CHECK_L8				;---------- PRO CHECK
 hexa_show 'CHECK_L8 ', $
PRMS					;    debut parametrage
	PRM COND_ofs				; in
	PRM SECTION_ofs				; in
	PRM NUM_ofs				; in
endPRMS					;    fin parametrage
ELB 2					;    BODY ELAB
					;    end elab
begin:					;---------- BDY INSTRUCTIONS
					; debut if
	ULb  2,	-COND_ofs
	BF	L12
	Ld 1,	STANDARD.CASE_ST1_L1.OK_COUNT_disp
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	1
	ADD
	Sd  1,	STANDARD.CASE_ST1_L1.OK_COUNT_disp
	BRA	L11
L12:
	Ld 1,	STANDARD.CASE_ST1_L1.FAIL_COUNT_disp
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	1
	ADD
	Sd  1,	STANDARD.CASE_ST1_L1.FAIL_COUNT_disp
STR STR_L13, "* ECHEC section"		; constante string="* ECHEC section"
	LCA	STR_L13.data_ptr
	CALL	STANDARD.TEXT_IO. ,PUT_L56
	Ld 1,	STANDARD.CASE_ST1_L1.INT_IO.DEFAULT_BASE_disp
	DUP
	Ld	0, STANDARD.TEXT_IO._NUMBER_BASE.FST
	CLT
	BT	STANDARD.ce_raise_
	DUP
	Ld	0, STANDARD.TEXT_IO._NUMBER_BASE.LST
	CGT
	BT	STANDARD.ce_raise_
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	2
	DUP
	Ld	0, STANDARD.TEXT_IO._FIELD.FST
	CLT
	BT	STANDARD.ce_raise_
	DUP
	Ld	0, STANDARD.TEXT_IO._FIELD.LST
	CGT
	BT	STANDARD.ce_raise_
	Ld  2,	-SECTION_ofs
	CALL	STANDARD.CASE_ST1_L1.INT_IO. ,PUT_L5
STR STR_L14, " test"			; constante string=" test"
	LCA	STR_L14.data_ptr
	CALL	STANDARD.TEXT_IO. ,PUT_L56
	Ld 1,	STANDARD.CASE_ST1_L1.INT_IO.DEFAULT_BASE_disp
	DUP
	Ld	0, STANDARD.TEXT_IO._NUMBER_BASE.FST
	CLT
	BT	STANDARD.ce_raise_
	DUP
	Ld	0, STANDARD.TEXT_IO._NUMBER_BASE.LST
	CGT
	BT	STANDARD.ce_raise_
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	3
	DUP
	Ld	0, STANDARD.TEXT_IO._FIELD.FST
	CLT
	BT	STANDARD.ce_raise_
	DUP
	Ld	0, STANDARD.TEXT_IO._FIELD.LST
	CGT
	BT	STANDARD.ce_raise_
	Ld  2,	-NUM_ofs
	CALL	STANDARD.CASE_ST1_L1.INT_IO. ,PUT_L5
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	1
	DUP
	ULd	0, STANDARD.TEXT_IO._POSITIVE_COUNT.FST
	CLT
	BT	STANDARD.ce_raise_
	DUP
	ULd	0, STANDARD.TEXT_IO._POSITIVE_COUNT.LST
	CGT
	BT	STANDARD.ce_raise_
	CALL	STANDARD.TEXT_IO. ,NEW_LINE_L26
L11:					; post if
ret_lbl:
	UNLINK 2
	RTD	prm_siz
excep:
endPRO					;---------- end PRO CHECK
end if

if defined CLASSE_L15_
PRO	CLASSE_L15				;---------- PRO CLASSE
 hexa_show 'CLASSE_L15 ', $
PRMS					;    debut parametrage
	PRM N_ofs				; in
	PRM result__ofs				; resultat de fonction
endPRMS					;    fin parametrage
ELB 2					;    BODY ELAB
					;    end elab
begin:					;---------- BDY INSTRUCTIONS
					; debut case
	Ld  2,	-N_ofs
	DUP
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	5
	NEG
	CGE
	BF	L23
	DUP
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	3
	CGT
	BF	L19
L23:
	DUP
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	10
	CGE
	BF	L24
	DUP
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	20
	CGT
	BF	L20
L24:
	DUP
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	4
	CEQ
	BT	L21
	DUP
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	5
	CEQ
	BT	L21
	DROP
	BRA	L22
L19:
	DROP
; CODE_RETURN : EXPR TYPE = DN_INTEGER  VUE COMPLETE = DN_INTEGER
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	1
	Sq  2,	-result__ofs
	BRA ret_lbl
	BRA	L18
L20:
	DROP
; CODE_RETURN : EXPR TYPE = DN_INTEGER  VUE COMPLETE = DN_INTEGER
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	2
	Sq  2,	-result__ofs
	BRA ret_lbl
	BRA	L18
L21:
	DROP
; CODE_RETURN : EXPR TYPE = DN_INTEGER  VUE COMPLETE = DN_INTEGER
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	3
	Sq  2,	-result__ofs
	BRA ret_lbl
	BRA	L18
L22:
; CODE_RETURN : EXPR TYPE = DN_INTEGER  VUE COMPLETE = DN_INTEGER
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	0
	Sq  2,	-result__ofs
	BRA ret_lbl
	BRA	L18
L18:
					; fin case
ret_lbl:
	UNLINK 2
	RTD	prm_siz-8
excep:
endPRO					;---------- end PRO CLASSE
end if

if defined TEMP_L25_
PRO	TEMP_L25				;---------- PRO TEMP
 hexa_show 'TEMP_L25 ', $
