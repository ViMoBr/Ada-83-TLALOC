elab_spec:				;    SPEC ELAB



					; _BOOLEAN ENUMERATION TYPE INFO
_BOOLEAN = '_BOOLEAN'
namespace _BOOLEAN
VAR use__info, q
BEGIN_BLOC_DEF
db 0, 5, "FALSE"
db 1, 4, "TRUE"
END_BLOC_DEF
IMAGES	BYTES_BLOC
CST LST, d, 1
CST FST, d, 0
CST SIZ, d, 1	; SIZ en bits !
postpone
  align_q
end postpone
	LCA	SIZ
	Sa	0, use__info
end namespace

					; _SHORT_INTEGER TYPE RANGE INFO
_SHORT_INTEGER = '_SHORT_INTEGER'
namespace _SHORT_INTEGER
VAR use__info, q
VAR SIZ, d
	LVA	0, SIZ
	Sa	0, use__info
VAR FST, w
VAR LST, w
	LI	16
	Sd	0, SIZ
; CODE_NUMERIC_LITERAL DN_UNIVERSAL_INTEGER
	LI	2
; CODE_NUMERIC_LITERAL DN_UNIVERSAL_INTEGER
	LI	15
	DEC
	SHL
	NEG
	Sw	0, FST
; CODE_NUMERIC_LITERAL DN_UNIVERSAL_INTEGER
	LI	2
; CODE_NUMERIC_LITERAL DN_UNIVERSAL_INTEGER
	LI	15
	DEC
	SHL
; CODE_NUMERIC_LITERAL DN_UNIVERSAL_INTEGER
	LI	1
	SUB
	Sw	0, LST
end namespace

					; _INTEGER TYPE RANGE INFO
_INTEGER = '_INTEGER'
namespace _INTEGER
VAR use__info, q
VAR SIZ, d
	LVA	0, SIZ
	Sa	0, use__info
VAR FST, d
VAR LST, d
	LI	32
	Sd	0, SIZ
; CODE_NUMERIC_LITERAL DN_UNIVERSAL_INTEGER
	LI	2
; CODE_NUMERIC_LITERAL DN_UNIVERSAL_INTEGER
	LI	31
	DEC
	SHL
	NEG
	Sd	0, FST
; CODE_NUMERIC_LITERAL DN_UNIVERSAL_INTEGER
	LI	2
; CODE_NUMERIC_LITERAL DN_UNIVERSAL_INTEGER
	LI	31
	DEC
	SHL
; CODE_NUMERIC_LITERAL DN_UNIVERSAL_INTEGER
	LI	1
	SUB
	Sd	0, LST
end namespace

					; _LONG_INTEGER TYPE RANGE INFO
_LONG_INTEGER = '_LONG_INTEGER'
namespace _LONG_INTEGER
VAR use__info, q
VAR SIZ, d
	LVA	0, SIZ
	Sa	0, use__info
VAR FST, q
VAR LST, q
	LI	64
	Sd	0, SIZ
; CODE_NUMERIC_LITERAL DN_UNIVERSAL_INTEGER
	LI	2
; CODE_NUMERIC_LITERAL DN_UNIVERSAL_INTEGER
	LI	63
	DEC
	SHL
	NEG
	Sq	0, FST
; CODE_NUMERIC_LITERAL DN_UNIVERSAL_INTEGER
	LI	2
; CODE_NUMERIC_LITERAL DN_UNIVERSAL_INTEGER
	LI	63
	DEC
	SHL
; CODE_NUMERIC_LITERAL DN_UNIVERSAL_INTEGER
	LI	1
	SUB
	Sq	0, LST
end namespace

					; _FLOAT FLOAT TYPE INFO
_FLOAT = '_FLOAT'
namespace _FLOAT
VAR use__info, q
VAR SIZ, d
VAR FST, q
VAR LST, q
	LVA	0, SIZ
	Sa	0, use__info
	LI	 32
	Sd	0, SIZ
; CODE_NUMERIC_LITERAL DN_UNIVERSAL_REAL
	LIF	1.0E38
	FNEG
	Sq	0, FST
; CODE_NUMERIC_LITERAL DN_UNIVERSAL_REAL
	LIF	1.0E38
	Sq	0, LST
end namespace

					; _LONG_FLOAT FLOAT TYPE INFO
_LONG_FLOAT = '_LONG_FLOAT'
namespace _LONG_FLOAT
VAR use__info, q
VAR SIZ, d
VAR FST, q
VAR LST, q
	LVA	0, SIZ
	Sa	0, use__info
	LI	 64
	Sd	0, SIZ
; CODE_NUMERIC_LITERAL DN_UNIVERSAL_REAL
	LIF	1.0E308
	FNEG
	Sq	0, FST
; CODE_NUMERIC_LITERAL DN_UNIVERSAL_REAL
	LIF	1.0E308
	Sq	0, LST
end namespace

