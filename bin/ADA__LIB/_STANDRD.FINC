

BOOLEAN = 'BOOLEAN'
namespace BOOLEAN				; BOOLEAN ENUMERATION TYPE INFO
BEGIN_BLOC_DEF
db 0, 5, "FALSE"
db 1, 4, "TRUE"
END_BLOC_DEF
IMAGES	BYTES_BLOC
CST LST, d, 1
CST FST, d, 0
CST SIZ, d, 1	; SIZ en bits !
end namespace

SHORT_INTEGER = 'SHORT_INTEGER'
namespace SHORT_INTEGER			; SHORT_INTEGER TYPE RANGE INFO
VAR SIZ, d
VAR FST, w
VAR LST, w
	LI	16
	Sb	0, SIZ
	LI	2
	LI	15
	DEC
	SHL
	NEG
	Sw	0, FST
	LI	2
	LI	15
	DEC
	SHL
	LI	1
	SUB
	Sw	0, LST
end namespace

INTEGER = 'INTEGER'
namespace INTEGER				; INTEGER TYPE RANGE INFO
VAR SIZ, d
VAR FST, d
VAR LST, d
	LI	32
	Sb	0, SIZ
	LI	2
	LI	31
	DEC
	SHL
	NEG
	Sd	0, FST
	LI	2
	LI	31
	DEC
	SHL
	LI	1
	SUB
	Sd	0, LST
end namespace

LONG_INTEGER = 'LONG_INTEGER'
