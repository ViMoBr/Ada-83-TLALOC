					; doublet resultat record anonyme
	LVA  2,	STANDARD.EXPANDER_L1.CODE_ROOT_L35.COMPLTN_UNIT_S_disp	; array actual
	CALL	STANDARD.IDL. ,LIST_L22
	La  ,  0
	BLKMOV

 hexa_show 'var elab COMPLTN_UNIT ', $
 hexa_show ' disp ', COMPLTN_UNIT_disp
VAR COMPLTN_UNIT_disp, q			; variable record : pointeur aux data record
VAR COMPLTN_UNIT__u, q			; variable record : pointeur aux useinfo
VAR COMPLTN_UNIT__dat, STANDARD.IDL._TREE.size
	LVA	3, COMPLTN_UNIT__dat
	Sa	3, COMPLTN_UNIT_disp			; record fin
	LVA	3, STANDARD.IDL._TREE.SIZ
	Sa	3, COMPLTN_UNIT__u
; CODE_VC_NAME DN_VARIABLE_ID
	La  3, COMPLTN_UNIT_disp
					; store represented component PT range 0 .. 1 width 2
	DUP
	Ld
	LI	0
	LI	0
	LI	2
	BFI
	Sd

					;    end elab
begin:					;---------- BDY INSTRUCTIONS
LOOP__2:
	LI	0					; lieu resultat sur pile
	LVA 3,	COMPLTN_UNIT_SEQ_disp
	CALL	STANDARD.IDL. ,IS_EMPTY_L23
	LI	1
	OUX
	BF	L159
	LVA  3,	STANDARD.EXPANDER_L1.CODE_ROOT_L35.BLOCK__1.COMPLTN_UNIT_disp
	LVA  3,	STANDARD.EXPANDER_L1.CODE_ROOT_L35.BLOCK__1.COMPLTN_UNIT_SEQ_disp
	CALL	STANDARD.IDL. ,POP_L24
; CODE & concat _STRING
VAR	ANON_371_32_L160_G_data, q
VAR	ANON_371_32_L160_G_info, q
VAR	ANON_371_49_L160_D_data, q
VAR	ANON_371_49_L160_D_info, q
