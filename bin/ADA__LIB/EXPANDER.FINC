	CALL	STANDARD.IDL. ,LIST_L22
	La  ,  0
	BLKMOV

 hexa_show 'var elab COMPLTN_UNIT ', $
 hexa_show ' disp ', COMPLTN_UNIT_disp
VAR COMPLTN_UNIT_disp, q			; variable record : pointeur aux data record
VAR COMPLTN_UNIT__u, q			; variable record : pointeur aux useinfo
VAR COMPLTN_UNIT__dat, STANDARD.IDL._TREE.size
