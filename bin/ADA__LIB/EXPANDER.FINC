	CALL	STANDARD.IDL. ,GET_LIB_PREFIX_L29
	DUP
	La  ,  0
	Sa  3, ANON_329_32_L136_G_data
	La  ,  8
	Sa  3, ANON_329_32_L136_G_info
	LId 3, ANON_329_32_L136_G_info, _STRING.LST_1
	LId 3, ANON_329_32_L136_G_info, _STRING.FST_1
	SUB
	INC
	Sa  3, ANON_329_32_L136_G_len
VAR	ANON_329_49_disp, q
VAR	ANON_329_49__u,   q
namespace ANON_329_49_info
  VAR SIZ, d
  VAR _COMP_SIZ, d
  VAR _FST_1, d
  VAR _LST_1, d
end namespace
	LVA 3, ANON_329_49_info.SIZ
	Sa  3, ANON_329_49__u
	LVA 3, ANON_329_49_disp
VAR	ANON_329_61_disp, q
VAR	ANON_329_61__u,    q
VAR	ANON_329_61__dat, STANDARD.IDL._TREE.size
