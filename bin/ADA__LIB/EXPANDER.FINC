; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	5
	DEC
	SHL
; CODE_NUMERIC_LITERAL DN_UNIVERSAL_INTEGER
	LI	1
	SUB
	Sd  1, ANON_69_57_aga._LST_1
	Ld  1, ANON_69_57_aga._LST_1
	Ld  1, ANON_69_57_aga._FST_1
	SUB
	INC
	CLAMP0
	Sd  1, ANON_69_57_aga._LEN_1
	LI	1
	Sd  1, ANON_69_57_aga._STR_1
	Sa  1, ANON_69_57_aga._PTR_1
	LI	0
	Sd  1, ANON_69_57_aga._EMIS_1
	Ld  1, ANON_69_57_aga._LEN_1
	Ld  1, ANON_69_57_aga._EMIS_1
