	Sa  2, ANON_322_33__u
	LVA 2, ANON_322_33_disp
					; doublet resultat record anonyme
	La  2,	-ROOT_ofs
	LI  1
	CALL	STANDARD.IDL. ,D_L17
	La  ,  0
	BLKMOV

