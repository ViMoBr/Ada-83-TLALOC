	SIb  1, ANON_69_57_aga._PTR_1, 0
	La  1, ANON_69_57_aga._PTR_1
	Ld  1, ANON_69_57_aga._STR_1
	ADD
	Sa  1, ANON_69_57_aga._PTR_1
	Ld  1, ANON_69_57_aga._EMIS_1
	INC
	Sd  1, ANON_69_57_aga._EMIS_1
	Ld  1, ANON_69_57_aga._CNT_1
	DEC
	DUP
	Sd  1, ANON_69_57_aga._CNT_1
	LI	0
