VAR	ANON_409_32__u,   q
namespace ANON_409_32_info
  VAR SIZ, d
  VAR _COMP_SIZ, d
  VAR _FST_1, d
  VAR _LST_1, d
end namespace
	LVA 3, ANON_409_32_info.SIZ
	Sa  3, ANON_409_32__u
	LVA 3, ANON_409_32_disp
	CALL	STANDARD.IDL. ,GET_LIB_PREFIX_L29
	DUP
	La  ,  0
	Sa  3, ANON_409_32_L162_G_data
	La  ,  8
	Sa  3, ANON_409_32_L162_G_info
	LId 3, ANON_409_32_L162_G_info, _STRING.LST_1
	LId 3, ANON_409_32_L162_G_info, _STRING.FST_1
	SUB
	INC
	CLAMP0
	Sa  3, ANON_409_32_L162_G_len
VAR	ANON_409_49_disp, q
VAR	ANON_409_49__u,   q
namespace ANON_409_49_info
  VAR SIZ, d
  VAR _COMP_SIZ, d
  VAR _FST_1, d
  VAR _LST_1, d
end namespace
	LVA 3, ANON_409_49_info.SIZ
	Sa  3, ANON_409_49__u
	LVA 3, ANON_409_49_disp
VAR	ANON_409_61_disp, q
VAR	ANON_409_61__u,    q
VAR	ANON_409_61__dat, STANDARD.IDL._TREE.size
	LVA 3, ANON_409_61__dat
	Sa  3, ANON_409_61_disp
	La  0, STANDARD.IDL._TREE.use__info
	Sa  3, ANON_409_61__u
	LVA 3, ANON_409_61_disp
					; doublet resultat record anonyme
	LVA 3,	COMPLTN_UNIT_disp
	LI  143
	CALL	STANDARD.IDL. ,D_L17
	CALL	STANDARD.IDL. ,PRINT_NAME_L25
	DUP
	La  ,  0
	Sa  3, ANON_409_49_L162_D_data
	La  ,  8
	Sa  3, ANON_409_49_L162_D_info
	LId 3, ANON_409_49_L162_D_info, _STRING.LST_1
	LId 3, ANON_409_49_L162_D_info, _STRING.FST_1
	SUB
	INC
	CLAMP0
	Sa  3, ANON_409_49_L162_D_len
	La  3, ANON_409_32_L162_G_len
	La  3, ANON_409_49_L162_D_len
	ADD
	CO_VAR
	Sa  3, ANON_409_32_L162_R_disp
	LI	1
	Sd  3, ANON_409_32_L162_R_info._FST_1
	La  3, ANON_409_32_L162_G_len
	La  3, ANON_409_49_L162_D_len
	ADD
	Sd  3, ANON_409_32_L162_R_info._LST_1
	LI	8
	Sd  3, ANON_409_32_L162_R_info._COMP_SIZ
	La  3, ANON_409_32_L162_G_len
	La  3, ANON_409_49_L162_D_len
	ADD
	LI	8
	MUL
	Sd  3, ANON_409_32_L162_R_info.SIZ
	LVA 3, ANON_409_32_L162_R_info.SIZ
	Sa  3, ANON_409_32_L162_R__u
	La  3, ANON_409_32_L162_R_disp
	La  3, ANON_409_32_L162_G_len
	La  3, ANON_409_32_L162_G_data
	BLKMOV
	La  3, ANON_409_32_L162_R_disp
	La  3, ANON_409_32_L162_G_len
	ADD
	La  3, ANON_409_49_L162_D_len
	La  3, ANON_409_49_L162_D_data
	BLKMOV
	LVA 3, ANON_409_32_L162_R_disp
	CALL	STANDARD.EXPANDER_L1.UTILS. ,OPEN_OUTPUT_FILE_L6
	LVA 3,	COMPLTN_UNIT_disp
	CALL	STANDARD.EXPANDER_L1.STRUCTURES. ,CODE_COMPILATION_UNIT_L148
	CALL	STANDARD.EXPANDER_L1.UTILS. ,CLOSE_OUTPUT_FILE_L7
	BRA	LOOP__2
L161:					; post loop LOOP__2
	UNLINK 3
endPRO
