	LVA 3,	COMPLTN_UNIT_disp
	LI  143
	CALL	STANDARD.IDL. ,D_L17
	CALL	STANDARD.IDL. ,PRINT_NAME_L25
	DUP
	La  ,  0
	Sa  3, ANON_329_49_L136_D_data
	La  ,  8
	Sa  3, ANON_329_49_L136_D_info
	LId 3, ANON_329_49_L136_D_info, _STRING.LST_1
	LId 3, ANON_329_49_L136_D_info, _STRING.FST_1
	SUB
	INC
	Sa  3, ANON_329_49_L136_D_len
	La  3, ANON_329_32_L136_G_len
	La  3, ANON_329_49_L136_D_len
	ADD
	CO_VAR
	Sa  3, ANON_329_32_L136_R_disp
	LI	1
	Sd  3, ANON_329_32_L136_R_info._FST_1
	La  3, ANON_329_32_L136_G_len
	La  3, ANON_329_49_L136_D_len
	ADD
	Sd  3, ANON_329_32_L136_R_info._LST_1
	LI	8
	Sd  3, ANON_329_32_L136_R_info._COMP_SIZ
	La  3, ANON_329_32_L136_G_len
	La  3, ANON_329_49_L136_D_len
	ADD
	LI	8
	MUL
	Sd  3, ANON_329_32_L136_R_info.SIZ
	LVA 3, ANON_329_32_L136_R_info.SIZ
	Sa  3, ANON_329_32_L136_R__u
	La  3, ANON_329_32_L136_R_disp
	La  3, ANON_329_32_L136_G_len
	La  3, ANON_329_32_L136_G_data
	BLKMOV
	La  3, ANON_329_32_L136_R_disp
	La  3, ANON_329_32_L136_G_len
	ADD
	La  3, ANON_329_49_L136_D_len
	La  3, ANON_329_49_L136_D_data
