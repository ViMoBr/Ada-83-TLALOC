	LVA  3,	STANDARD.EXPANDER_L1.CODE_ROOT_L35.BLOCK__1.COMPLTN_UNIT_disp
	LVA  3,	STANDARD.EXPANDER_L1.CODE_ROOT_L35.BLOCK__1.COMPLTN_UNIT_SEQ_disp
	CALL	STANDARD.IDL. ,POP_L24
; CODE & concat _STRING
