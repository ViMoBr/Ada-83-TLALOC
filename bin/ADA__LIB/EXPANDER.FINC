namespace ANON_82_57_aga
  VAR _FST_1, d
  VAR _LST_1, d
  VAR _LEN_1, d
  VAR _STR_1, d
  VAR _PTR_1, q
  VAR _CNT_1, d
  VAR _EMIS_1, d
end namespace
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	0
	Sd  1, ANON_82_57_aga._FST_1
; CODE_NUMERIC_LITERAL DN_UNIVERSAL_INTEGER
	LI	2
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	5
	DEC
	SHL
; CODE_NUMERIC_LITERAL DN_UNIVERSAL_INTEGER
	LI	1
	SUB
	Sd  1, ANON_82_57_aga._LST_1
	Ld  1, ANON_82_57_aga._LST_1
	Ld  1, ANON_82_57_aga._FST_1
	SUB
	INC
	CLAMP0
	Sd  1, ANON_82_57_aga._LEN_1
	LI	1
	Sd  1, ANON_82_57_aga._STR_1
	Sa  1, ANON_82_57_aga._PTR_1
	LI	0
	Sd  1, ANON_82_57_aga._EMIS_1
	Ld  1, ANON_82_57_aga._LEN_1
	Ld  1, ANON_82_57_aga._EMIS_1
	SUB
	Sd  1, ANON_82_57_aga._CNT_1
	Ld  1, ANON_82_57_aga._CNT_1
	LI	0
	CLE
	BT  L4
L3:
	LI	0
	SIb  1, ANON_82_57_aga._PTR_1, 0
	La  1, ANON_82_57_aga._PTR_1
	Ld  1, ANON_82_57_aga._STR_1
	ADD
	Sa  1, ANON_82_57_aga._PTR_1
	Ld  1, ANON_82_57_aga._EMIS_1
	INC
	Sd  1, ANON_82_57_aga._EMIS_1
	Ld  1, ANON_82_57_aga._CNT_1
	DEC
	DUP
	Sd  1, ANON_82_57_aga._CNT_1
	LI	0
	CGT
	BT  L3
L4:

