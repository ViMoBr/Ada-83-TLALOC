	LVA	3, STANDARD.IDL._TREE.SIZ
	Sa	3, COMPLTN_UNIT__u
; CODE_VC_NAME DN_VARIABLE_ID
	La  3, COMPLTN_UNIT_disp
					; store represented component PT range 0 .. 1 width 2
	DUP
	Ld
	LI	0
	LI	0
	LI	2
	BFI
	Sd

