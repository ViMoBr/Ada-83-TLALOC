VAR	ANON_360_33__u,    q
VAR	ANON_360_33__dat, STANDARD.IDL._TREE.size
	LVA 2, ANON_360_33__dat
	Sa  2, ANON_360_33_disp
	La  0, STANDARD.IDL._TREE.use__info
	Sa  2, ANON_360_33__u
	LVA 2, ANON_360_33_disp
					; doublet resultat record anonyme
	La  2,	-ROOT_ofs
	LI  1
	CALL	STANDARD.IDL. ,D_L17
	La  ,  0
	BLKMOV

