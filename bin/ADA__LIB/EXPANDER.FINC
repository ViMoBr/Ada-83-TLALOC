	Sa	3, COMPLTN_UNIT_SEQ_disp			; record fin
	LVA	3, STANDARD.IDL.SEQ_TYPE.SIZ
	Sa	3, COMPLTN_UNIT_SEQ__u
; CODE_VC_NAME DN_VARIABLE_ID
	La  3, COMPLTN_UNIT_SEQ_disp
	LI	STANDARD.IDL.SEQ_TYPE.size
VAR	ANON_306_38_disp, q
VAR	ANON_306_38__u,    q
