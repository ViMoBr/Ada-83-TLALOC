	Sa	3, COMPLTN_UNIT_disp			; record fin
	LVA	3, STANDARD.IDL.TREE.SIZ
	Sa	3, COMPLTN_UNIT__u
; CODE_VC_NAME DN_VARIABLE_ID

					;    end elab
begin:					;---------- BDY INSTRUCTIONS
LOOP__2:
	LI	0					; lieu resultat sur pile
	LVA 3,	COMPLTN_UNIT_SEQ_disp
	CALL	STANDARD.IDL. ,IS_EMPTY_L23
	LI	1
	OUX
	BF	L135
	LVA  3,	COMPLTN_UNIT_disp
	LVA  3,	COMPLTN_UNIT_SEQ_disp
	CALL	STANDARD.IDL. ,POP_L24
; CODE & concat STRING
VAR	ANON_329_32_data, q
VAR	ANON_329_32_info, q
VAR	ANON_329_49_data, q
VAR	ANON_329_49_info, q
VAR	ANON_329_32_len,  q
VAR	ANON_329_49_len,  q
VAR	ANON_329_32_disp, q
VAR	ANON_329_32__u,   q
namespace ANON_329_32_info
  VAR SIZ,      d
  VAR _COMP_SIZ, d
  VAR _FST_1,    d
  VAR _LST_1,    d
end namespace
VAR	ANON_329_32_disp, q
VAR	ANON_329_32__u,   q
namespace ANON_329_32_info
  VAR SIZ, d
  VAR _COMP_SIZ, d
  VAR _FST_1, d
  VAR _LST_1, d
end namespace
	LVA 3, ANON_329_32_info.SIZ
	Sa  3, ANON_329_32__u
	LVA 3, ANON_329_32_disp
	CALL	STANDARD.IDL. ,GET_LIB_PREFIX_L29
	DUP
	La  ,  0
	Sa  3, ANON_329_32_data
	La  ,  8
	Sa  3, ANON_329_32_info
	LId 3, ANON_329_32_info, STRING.LST_1
	LId 3, ANON_329_32_info, STRING.FST_1
	SUB
	INC
	Sa  3, ANON_329_32_len
VAR	ANON_329_49_disp, q
VAR	ANON_329_49__u,   q
namespace ANON_329_49_info
  VAR SIZ, d
  VAR _COMP_SIZ, d
  VAR _FST_1, d
  VAR _LST_1, d
end namespace
	LVA 3, ANON_329_49_info.SIZ
	Sa  3, ANON_329_49__u
	LVA 3, ANON_329_49_disp
VAR	ANON_329_61_disp, q
VAR	ANON_329_61__u,    q
VAR	ANON_329_61__dat, STANDARD.IDL.TREE.size
	LVA 3, ANON_329_61__dat
	Sa  3, ANON_329_61_disp
	La  0, STANDARD.IDL.TREE.use__info
	Sa  3, ANON_329_61__u
	LVA 3, ANON_329_61_disp
					; doublet resultat record anonyme
	LVA 3,	COMPLTN_UNIT_disp
	LI  143
	CALL	STANDARD.IDL. ,D_L17
	CALL	STANDARD.IDL. ,PRINT_NAME_L25
	DUP
	La  ,  0
	Sa  3, ANON_329_49_data
	La  ,  8
	Sa  3, ANON_329_49_info
	LId 3, ANON_329_49_info, STRING.LST_1
	LId 3, ANON_329_49_info, STRING.FST_1
	SUB
	INC
	Sa  3, ANON_329_49_len
	La  3, ANON_329_32_len
	La  3, ANON_329_49_len
	ADD
	CO_VAR
	Sa  3, ANON_329_32_disp
	LI	1
	Sd  3, ANON_329_32_info._FST_1
	La  3, ANON_329_32_len
	La  3, ANON_329_49_len
	ADD
	Sd  3, ANON_329_32_info._LST_1
	LI	8
	Sd  3, ANON_329_32_info._COMP_SIZ
	La  3, ANON_329_32_len
	La  3, ANON_329_49_len
	ADD
	LI	8
	MUL
	Sd  3, ANON_329_32_info.SIZ
	LVA 3, ANON_329_32_info.SIZ
	Sa  3, ANON_329_32__u
	La  3, ANON_329_32_disp
	La  3, ANON_329_32_len
	La  3, ANON_329_32_data
	BLKMOV
	La  3, ANON_329_32_disp
	La  3, ANON_329_32_len
	ADD
	La  3, ANON_329_49_len
	La  3, ANON_329_49_data
	BLKMOV
	LVA 3, ANON_329_32_disp
	CALL	STANDARD.EXPANDER_L1.UTILS. ,OPEN_OUTPUT_FILE_L2
	LVA 3,	COMPLTN_UNIT_disp
	CALL	STANDARD.EXPANDER_L1.STRUCTURES. ,CODE_COMPILATION_UNIT_L126
	CALL	STANDARD.EXPANDER_L1.UTILS. ,CLOSE_OUTPUT_FILE_L3
	BRA	LOOP__2
L135:					; post loop LOOP__2
	UNLINK 3
endPRO
