VAR	ANON_483_25__dat, STANDARD.IDL._TREE.size
	LVA 2, ANON_483_25__dat
	Sa  2, ANON_483_25_disp
	La  0, STANDARD.IDL._TREE.use__info
	Sa  2, ANON_483_25__u
	LVA 2, ANON_483_25_disp
