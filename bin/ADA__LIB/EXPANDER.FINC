	Sa  1, ANON_68_57_aga._PTR_1
	Ld  1, ANON_68_57_aga._EMIS_1
	INC
	Sd  1, ANON_68_57_aga._EMIS_1
	Ld  1, ANON_68_57_aga._CNT_1
	DEC
	DUP
