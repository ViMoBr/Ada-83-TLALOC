begin:					;---------- BDY INSTRUCTIONS
namespace	BLOCK__1
ELB 3					;    BODY ELAB
VAR COMPLTN_UNIT_SEQ_disp, q			; variable record : pointeur aux data record
VAR COMPLTN_UNIT_SEQ__u, q			; variable record : pointeur aux useinfo
VAR COMPLTN_UNIT_SEQ__dat, STANDARD.IDL.SEQ_TYPE.size
