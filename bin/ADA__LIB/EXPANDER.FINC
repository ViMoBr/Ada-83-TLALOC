					; LOOP_CODE ENUMERATION TYPE INFO
LOOP_CODE = 'LOOP_CODE'
namespace LOOP_CODE
VAR use__info, q
BEGIN_BLOC_DEF
db 0, 3, "DEC"
db 1, 2, "GT"
db 2, 3, "INC"
db 3, 2, "LT"
END_BLOC_DEF
IMAGES	BYTES_BLOC
CST LST, d, 3
CST FST, d, 0
CST SIZ, d, 8	; SIZ en bits !
postpone
  align_q
end postpone
	LCA	SIZ
	Sa	1, use__info
end namespace
