if defined CODE_ROOT_L35_
PRO	CODE_ROOT_L35				;---------- PRO CODE_ROOT
 hexa_show 'CODE_ROOT_L35 ', $
PRMS					;    debut parametrage
	PRM ROOT_ofs				; in
endPRMS					;    fin parametrage
ELB 2					;    BODY ELAB
 hexa_show 'var elab USER_ROOT ', $
 hexa_show ' disp ', USER_ROOT_disp
VAR USER_ROOT_disp, q			; variable record : pointeur aux data record
VAR USER_ROOT__u, q				; variable record : pointeur aux useinfo
VAR USER_ROOT__dat, STANDARD.IDL._TREE.size
	LVA	2, USER_ROOT__dat
	Sa	2, USER_ROOT_disp			; record fin
	LVA	2, STANDARD.IDL._TREE.SIZ
	Sa	2, USER_ROOT__u
; CODE_VC_NAME DN_CONSTANT_ID
	La  2, USER_ROOT_disp
	LI	STANDARD.IDL._TREE.size
VAR	ANON_361_33_disp, q
VAR	ANON_361_33__u,    q
VAR	ANON_361_33__dat, STANDARD.IDL._TREE.size
	LVA 2, ANON_361_33__dat
	Sa  2, ANON_361_33_disp
	La  0, STANDARD.IDL._TREE.use__info
	Sa  2, ANON_361_33__u
	LVA 2, ANON_361_33_disp
					; doublet resultat record anonyme
	La  2,	-ROOT_ofs
	LI  1
	CALL	STANDARD.IDL. ,D_L17
	La  ,  0
	BLKMOV

