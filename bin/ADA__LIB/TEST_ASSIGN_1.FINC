if ~ definite TEXT_IO
include 'TEXT_IO.FINC'
end if
PRO	TEST_ASSIGN_1_L1			;---------- PRO TEST_ASSIGN_1
ELB 1					;    BODY ELAB

					; COULEUR ENUMERATION TYPE INFO
COULEUR = 'COULEUR'
namespace COULEUR
VAR use__info, q
BEGIN_BLOC_DEF
db 0, 5, "ROUGE"
db 1, 4, "BLEU"
db 2, 5, "BLANC"
END_BLOC_DEF
IMAGES	BYTES_BLOC
CST LST, d, 2
CST FST, d, 0
CST SIZ, d, 8	; SIZ en bits !
postpone
  align_q
end postpone
	LCA	SIZ
	Sa	1, use__info
end namespace

					; SUBREC RECORD TYPE INFO
SUBREC = 'SUBREC'
namespace SUBREC
VAR use__info, q
VAR SIZ, d
	LVA	1, SIZ
	Sa	1, use__info
USEINFO 1, X, 	La 0, STANDARD.INTEGER.use__info
USEINFO 1, Y, 	La 0, STANDARD.INTEGER.use__info
virtual at 0				; calcul des offsets statiques
STATOFS X, 4
STATOFS Y, 4
size = $
end virtual
	LI	 size*8
	Sd	1, SIZ
end namespace

					; array decl constrained array type info
TABLE = 'TABLE'
namespace TABLE
VAR use__info, q
VAR SIZ, d
	LVA	1, SIZ
	Sa	1, use__info
VAR COMP_SIZ, d
VAR FST_1, d
VAR LST_1, d
	LI	64
	Sd	1, COMP_SIZ
	Ld	1, COMP_SIZ
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	1
	Sd	1, FST_1
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	8
	Sd	1, LST_1
	Ld	1, LST_1
	INC
	Ld	1, FST_1
	SUB
	MUL
	Sd	1, SIZ
  virtual at 4
COMP_SIZ = $
	rd 1 
FST_1 = $
	rd 1 
LST_1 = $
	rd 1 
  end virtual
end namespace
VAR A_disp, q				; variable array : pointeur aux data
VAR A__u, q				; variable array : useinfo pointeur au rec info
	La 1, TABLE.use__info
	Sa	1, A__u				; array info ptr at __u
	Ld	1, TABLE.SIZ
	LI	8
	DIV
	CO_VAR
	Sa	1, A_disp				; array data ptr at _disp


					; RECTEST RECORD TYPE INFO
RECTEST = 'RECTEST'
namespace RECTEST
VAR use__info, q
VAR SIZ, d
	LVA	1, SIZ
	Sa	1, use__info
USEINFO 1, I, 	La 0, STANDARD.INTEGER.use__info
USEINFO 1, F, 	La 0, STANDARD.FLOAT.use__info
USEINFO 1, E, 	La 1, STANDARD.TEST_ASSIGN_1_L1.COULEUR.use__info
USEINFO 1, C, 	La 1, STANDARD.TEST_ASSIGN_1_L1.SUBREC.use__info
USEINFO 1, A, 	La 1, STANDARD.TEST_ASSIGN_1_L1.TABLE.use__info
virtual at 0				; calcul des offsets statiques
STATOFS I, 4
STATOFS F, 4
STATOFS E, 1
STATOFS C, 8
STATOFS A, 64
size = $
end virtual
	LI	 size*8
	Sd	1, SIZ
end namespace
INT_IO = 'INT_IO'
namespace INT_IO				;---------- GENERIC PACKAGE INSTANTIATION
