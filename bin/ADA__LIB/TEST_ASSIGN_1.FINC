begin:					;---------- BDY INSTRUCTIONS
	LIVA 	1, R_disp, STANDARD.TEST_ASSIGN_1_L1.RECTEST.I
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	12
	Sd
