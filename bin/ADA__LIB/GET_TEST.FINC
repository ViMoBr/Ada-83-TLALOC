include 'TEXT_IO.FINC'
PRO	GET_TEST_L1				;---------- PRO GET_TEST
ELB 1					;    BODY ELAB
FIO = 'FIO'
namespace FIO				;---------- GENERIC PACKAGE INSTANTIATION
elab_spec:				;    SPEC ELAB

VAR GFP_disp, q				; Lieu du Generic Frame Pointer 
VAR DEFAULT_FORE_disp, d			; variable entiere
	LI	2
	Sd  1,	DEFAULT_FORE_disp

VAR DEFAULT_AFT_disp, d			; variable entiere
	LI	6
	LI	1
	SUB
	Sd  1,	DEFAULT_AFT_disp

VAR DEFAULT_EXP_disp, d			; variable entiere
	LI	3
	Sd  1,	DEFAULT_EXP_disp

if defined GET_L67_
PRO	GET_L67				;---------- PRO GET
PRMS					;    debut parametrage
	PRM FILE_ofs				; in
	PRM ITEM_ofs				; out
	PRM WIDTH_ofs				; in
endPRMS					;    fin parametrage
ELB 2
begin:
	LVA	 1, GFP_disp
	Lq	 2, -WIDTH_ofs
	La 	 2, -ITEM_ofs
	La 	 2, -FILE_ofs
	CALL	STANDARD.TEXT_IO.FLOAT_IO. ,GET_L67
	UNLINK	 2
	RTD	prm_siz
endPRO					;---------- end PRO GET
end if
if defined GET_L68_
PRO	GET_L68				;---------- PRO GET
PRMS					;    debut parametrage
	PRM ITEM_ofs				; out
	PRM WIDTH_ofs				; in
endPRMS					;    fin parametrage
ELB 2
begin:
	LVA	 1, GFP_disp
	Lq	 2, -WIDTH_ofs
	La 	 2, -ITEM_ofs
	CALL	STANDARD.TEXT_IO.FLOAT_IO. ,GET_L68
	UNLINK	 2
	RTD	prm_siz
endPRO					;---------- end PRO GET
end if
if defined PUT_L69_
PRO	PUT_L69				;---------- PRO PUT
PRMS					;    debut parametrage
	PRM FILE_ofs				; in
	PRM ITEM_ofs				; in
	PRM FORE_ofs				; in
	PRM AFT_ofs				; in
	PRM EXP_ofs				; in
endPRMS					;    fin parametrage
ELB 2
begin:
	LVA	 1, GFP_disp
	Lq	 2, -EXP_ofs
	Lq	 2, -AFT_ofs
	Lq	 2, -FORE_ofs
	Lq	 2, -ITEM_ofs
	La 	 2, -FILE_ofs
	CALL	STANDARD.TEXT_IO.FLOAT_IO. ,PUT_L69
	UNLINK	 2
	RTD	prm_siz
endPRO					;---------- end PRO PUT
end if
if defined PUT_L70_
PRO	PUT_L70				;---------- PRO PUT
PRMS					;    debut parametrage
	PRM ITEM_ofs				; in
	PRM FORE_ofs				; in
	PRM AFT_ofs				; in
	PRM EXP_ofs				; in
endPRMS					;    fin parametrage
ELB 2
begin:
	LVA	 1, GFP_disp
	Lq	 2, -EXP_ofs
	Lq	 2, -AFT_ofs
	Lq	 2, -FORE_ofs
	Lq	 2, -ITEM_ofs
	CALL	STANDARD.TEXT_IO.FLOAT_IO. ,PUT_L70
	UNLINK	 2
	RTD	prm_siz
endPRO					;---------- end PRO PUT
end if
if defined GET_L71_
PRO	GET_L71				;---------- PRO GET
PRMS					;    debut parametrage
	PRM FROM_ofs				; in
	PRM ITEM_ofs				; out
	PRM LAST_ofs				; out
endPRMS					;    fin parametrage
ELB 2
begin:
	LVA	 1, GFP_disp
	La 	 2, -LAST_ofs
	La 	 2, -ITEM_ofs
	La 	 2, -FROM_ofs
	CALL	STANDARD.TEXT_IO.FLOAT_IO. ,GET_L71
	UNLINK	 2
	RTD	prm_siz
endPRO					;---------- end PRO GET
end if
if defined PUT_L72_
PRO	PUT_L72				;---------- PRO PUT
PRMS					;    debut parametrage
	PRM TO_ofs				; out
	PRM ITEM_ofs				; in
	PRM AFT_ofs				; in
	PRM EXP_ofs				; in
endPRMS					;    fin parametrage
ELB 2
begin:
	LVA	 1, GFP_disp
	Lq	 2, -EXP_ofs
	Lq	 2, -AFT_ofs
	Lq	 2, -ITEM_ofs
	La 	 2, -TO_ofs
	CALL	STANDARD.TEXT_IO.FLOAT_IO. ,PUT_L72
	UNLINK	 2
	RTD	prm_siz
endPRO					;---------- end PRO PUT
end if
					;---------- end generic package instantiation FIO
end namespace

VAR X_disp, q				; variable flottante

STRING = 'STRING'
namespace STRING				; array var constrained array type info
VAR SIZ, d
  namespace info
VAR COMP_SIZ, d
VAR FST_1, d
VAR LST_1, d
	LI	1
	Sd	1, COMP_SIZ
	Ld	1, COMP_SIZ
	LI	1
	Sd	1, FST_1
	LI	40
	Sd	1, LST_1
	Ld	1, LST_1
	INC
	Ld	1, FST_1
	SUB
	MUL
	Sd	1, SIZ
  end namespace
  virtual at 4
COMP_SIZ = $
	rd 1 
FST_1 = $
	rd 1 
LST_1 = $
	rd 1 
  end virtual
end namespace

VAR CHN_disp, q				; variable array : pointeur aux data
VAR CHN__u, q				; variable array : useinfo pointeur au rec info
	Ld	1, STRING.SIZ
	CO_VAR
	Sa	1, CHN_disp				; array data ptr at _disp
	LVA 1, STRING.SIZ
	Sa	1, CHN__u				; array info ptr at __u

VAR LEN_disp, d				; variable entiere

VAR C_disp, b				; variable bool char

					;    end elab
begin:					;---------- BDY INSTRUCTIONS
STR STR_L8, 'Entrez un flottant : '		; constante string='Entrez un flottant : '
	LCA	STR_L8.data_ptr
	CALL	STANDARD.TEXT_IO. ,PUT_L56
	LVA  1,	LEN_disp
	LVA  1,	CHN_disp
	CALL	STANDARD.TEXT_IO. ,GET_LINE_L58
STR STR_L9, 'Lu : ['			; constante string='Lu : ['
	LCA	STR_L9.data_ptr
	CALL	STANDARD.TEXT_IO. ,PUT_L56
	La 1, CHN_disp
	LI	1
	LId	1, CHN__u, STRING.FST_1
	SUB
	LI	1
	MUL
	ADD
namespace ANON_12_8				; ensemble doublet @data/@info pour slice anonyme source
VAR ANON_12_8_disp, q
VAR ANON_12_8__u, q
VAR SIZ, d
VAR COMP_SIZ, d
VAR FST_1, d
VAR LST_1, d
	Sa	1, ANON_12_8_disp
	LVA	1, SIZ
	Sa	1, ANON_12_8__u
	LI	1
	Sd	1, COMP_SIZ
	LI	1
	Sd	1, FST_1
	Ld 1,	LEN_disp
	Sd	1, LST_1
	Ld	1, LST_1
	INC
	Ld	1, FST_1
	SUB
	LI	1
	MUL
	Sd	1, SIZ
	LVA	1, ANON_12_8_disp
end namespace
	CALL	STANDARD.TEXT_IO. ,PUT_L56
STR STR_L10, ']'				; constante string=']'
	LCA	STR_L10.data_ptr
	CALL	STANDARD.TEXT_IO. ,PUT_LINE_L60
namespace	BLOCK__1
ELB 2					;    BODY ELAB
VAR F_disp, q				; variable record : pointeur aux data record
VAR F__u, q				; variable record : pointeur aux useinfo
VAR F__dat, STANDARD.TEXT_IO.FILE_TYPE.size
	LVA	2, F__dat
	Sa	2, F_disp				; record fin
	LVA	2, STANDARD.TEXT_IO.FILE_TYPE.SIZ
	Sa	2, F__u
	LIVa 2, F_disp, STANDARD.TEXT_IO.FILE_TYPE.ID
	LI	1
	NEG
	Sd
	LIVa 2, F_disp, STANDARD.TEXT_IO.FILE_TYPE.IS_OPENED
	LI	0
	Sb
	LIVa 2, F_disp, STANDARD.TEXT_IO.FILE_TYPE.IS_DEFAULT_IO
	LI	0
	Sb
	LIVa 2, F_disp, STANDARD.TEXT_IO.FILE_TYPE.LOOK_AHEAD
	LI	 0
	Sb
	LIVa 2, F_disp, STANDARD.TEXT_IO.FILE_TYPE.HAS_LOOK_AHEAD
	LI	0
	Sb
	LIVa 2, F_disp, STANDARD.TEXT_IO.FILE_TYPE.AT_END_OF_FILE
	LI	0
	Sb

					;    end elab
begin:					;---------- BDY INSTRUCTIONS
STR STR_L11, '=== Test 1 : FIO.PUT 3.14159 dans fichier ==='	; constante string='=== Test 1 : FIO.PUT 3.14159 dans fichier ==='
	LCA	STR_L11.data_ptr
	CALL	STANDARD.TEXT_IO. ,PUT_LINE_L60
STR STR_L12, ''				; constante string=''
	LCA	STR_L12.data_ptr
STR STR_L13, 'ftest.dat'			; constante string='ftest.dat'
	LCA	STR_L13.data_ptr
	LI  1
	LVA  2,	F_disp
	CALL	STANDARD.TEXT_IO. ,CREATE_L1
	LI	3
	LI	5
	LI	2
	LIF	3.14159
	LVa 2,	F_disp
	CALL	STANDARD.GET_TEST_L1.FIO. ,PUT_L69
	LI	1
	LVa 2,	F_disp
	CALL	STANDARD.TEXT_IO. ,NEW_LINE_L25
	LVA  2,	F_disp
	CALL	STANDARD.TEXT_IO. ,CLOSE_L3
STR STR_L14, 'Ecriture OK'			; constante string='Ecriture OK'
	LCA	STR_L14.data_ptr
	CALL	STANDARD.TEXT_IO. ,PUT_LINE_L60
STR STR_L15, '=== Test 2 : FIO.GET depuis fichier ==='	; constante string='=== Test 2 : FIO.GET depuis fichier ==='
	LCA	STR_L15.data_ptr
	CALL	STANDARD.TEXT_IO. ,PUT_LINE_L60
STR STR_L16, ''				; constante string=''
	LCA	STR_L16.data_ptr
STR STR_L17, 'ftest.dat'			; constante string='ftest.dat'
	LCA	STR_L17.data_ptr
	LI  0
	LVA  2,	F_disp
	CALL	STANDARD.TEXT_IO. ,OPEN_L2
	LI	0
	LVA  1,	X_disp
	LVa 2,	F_disp
	CALL	STANDARD.GET_TEST_L1.FIO. ,GET_L67
	LVA  2,	F_disp
	CALL	STANDARD.TEXT_IO. ,CLOSE_L3
STR STR_L18, 'Relu depuis fichier : '		; constante string='Relu depuis fichier : '
	LCA	STR_L18.data_ptr
	CALL	STANDARD.TEXT_IO. ,PUT_L56
	LI	3
	LI	6
	LI	2
	Lq 1,	X_disp
	CALL	STANDARD.GET_TEST_L1.FIO. ,PUT_L70
	LI	1
	CALL	STANDARD.TEXT_IO. ,NEW_LINE_L26
STR STR_L19, '=== Test 3 : verification GET_LINE ==='	; constante string='=== Test 3 : verification GET_LINE ==='
	LCA	STR_L19.data_ptr
	CALL	STANDARD.TEXT_IO. ,PUT_LINE_L60
STR STR_L20, ''				; constante string=''
	LCA	STR_L20.data_ptr
STR STR_L21, 'ftest.dat'			; constante string='ftest.dat'
	LCA	STR_L21.data_ptr
	LI  0
	LVA  2,	F_disp
	CALL	STANDARD.TEXT_IO. ,OPEN_L2
	LVA  1,	LEN_disp
	LVA  1,	CHN_disp
	LVa 2,	F_disp
	CALL	STANDARD.TEXT_IO. ,GET_LINE_L57
	LVA  2,	F_disp
	CALL	STANDARD.TEXT_IO. ,CLOSE_L3
STR STR_L22, 'Contenu brut : ['		; constante string='Contenu brut : ['
	LCA	STR_L22.data_ptr
	CALL	STANDARD.TEXT_IO. ,PUT_L56
	La 1, CHN_disp
	LI	1
	LId	1, CHN__u, STRING.FST_1
	SUB
	LI	1
	MUL
	ADD
namespace ANON_42_10			; ensemble doublet @data/@info pour slice anonyme source
VAR ANON_42_10_disp, q
VAR ANON_42_10__u, q
VAR SIZ, d
VAR COMP_SIZ, d
VAR FST_1, d
VAR LST_1, d
	Sa	2, ANON_42_10_disp
	LVA	2, SIZ
	Sa	2, ANON_42_10__u
	LI	1
	Sd	2, COMP_SIZ
	LI	1
	Sd	2, FST_1
	Ld 1,	LEN_disp
	Sd	2, LST_1
	Ld	2, LST_1
	INC
	Ld	2, FST_1
	SUB
	LI	1
	MUL
	Sd	2, SIZ
	LVA	2, ANON_42_10_disp
end namespace
	CALL	STANDARD.TEXT_IO. ,PUT_L56
STR STR_L23, ']'				; constante string=']'
	LCA	STR_L23.data_ptr
	CALL	STANDARD.TEXT_IO. ,PUT_LINE_L60
STR STR_L24, '=== Test 4 : FIO.PUT stdout ==='	; constante string='=== Test 4 : FIO.PUT stdout ==='
	LCA	STR_L24.data_ptr
	CALL	STANDARD.TEXT_IO. ,PUT_LINE_L60
	LI	3
	LI	5
	LI	2
	LIF	2.71828
	CALL	STANDARD.GET_TEST_L1.FIO. ,PUT_L70
	LI	1
	CALL	STANDARD.TEXT_IO. ,NEW_LINE_L26
	UNLINK 2
endPRO
ret_lbl:
	UNLINK 1
	RTD
excep:
endPRO					;---------- end PRO GET_TEST
