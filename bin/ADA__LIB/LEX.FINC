	LIa	, , 8
	Ld	, STANDARD.STRING.COMP_SIZ
	LI	8
	DIV
	MUL
	ADD					; add offset to start address
	Lb
	MUL
	ADD
	Sd  1,	I_disp
	Ld 1,	I_disp
	Ld 0,	STANDARD.LEX.HASH_SIZE_disp
	MODI
	Sd  1,	I_disp
LOOP__1:
	La	 0, HASH_TABLE_disp			; array data start address on stack
	Ld 1,	I_disp
	LId	0, HASH_TABLE__u, STANDARD.LEX.HASH_TABLE.FST_1	; (index - FST_1) * SIZ_1
	SUB
	LId	0, HASH_TABLE__u, STANDARD.LEX.HASH_TABLE.COMP_SIZ
	LI	8
	DIV
	MUL
	ADD					; add offset to start address
	Lb
	LI	90
	CNE
	DUP
	BF	L5
	DROP
