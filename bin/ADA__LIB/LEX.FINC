begin:					;---------- package BDY INSTRUCTIONS
VAR	LTL125_disp, b				; compteur boucle LOOP__7
	LI	1
	Sb  0,	LTL125_disp
VAR	LMT_LTL125_disp, b			; limite boucle LOOP__7
	LI	89
	Sb  0,	LMT_LTL125_disp
	Lb  0,	LTL125_disp				; test null range LOOP__7
	Lb  0,	LMT_LTL125_disp
	CGT
	BT	L124
LOOP__7:					; corps boucle LOOP__7
	La	 0, HASH_TABLE_disp			; array data start address on stack
	LI	0					; lieu resultat sur pile
VAR	ANON_691_27_disp, q
VAR	ANON_691_27__u,   q
namespace ANON_691_27_info
  VAR SIZ, d
  VAR _COMP_SIZ, d
  VAR _FST_1, d
  VAR _LST_1, d
end namespace
	LVA 0, ANON_691_27_info.SIZ
	Sa  0, ANON_691_27__u
	LVA 0, ANON_691_27_disp
	Lb  0,	LTL125_disp
	CALL	STANDARD.LEX. ,LEX_IMAGE_L3
	CALL	STANDARD.LEX. ,HASH_POS_L3
	LId	0, HASH_TABLE__u, STANDARD.LEX._HASH_TABLE.FST_1	; (index - FST_1) * SIZ_1
	SUB
	LId	0, HASH_TABLE__u, STANDARD.LEX._HASH_TABLE.COMP_SIZ
	LI	8
	DIV
	MUL
	ADD					; add offset to start address
	Lb	0, LTL125_disp
	Sb
	Lb  0,	LTL125_disp				; test de sortie LOOP__7
	Lb  0,	LMT_LTL125_disp
	CEQ
	BT	L124
	Lb  0,	LTL125_disp				; mise a jour compteur LOOP__7
	INC
	Sb  0,	LTL125_disp
	BRA	LOOP__7				; iteration suivante LOOP__7
L124:					; post loop LOOP__7
end namespace 				;---------- end package BDY LEX

