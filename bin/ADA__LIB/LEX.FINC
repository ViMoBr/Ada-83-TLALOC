	La  1,	-TXT_ofs
	CNE
L5:
	BF	L4
	Ld 1,	I_disp
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	1
	ADD
	Sd  1,	I_disp
					; debut if
	Ld 1,	I_disp
	Ld 0,	STANDARD.LEX.HASH_SIZE_disp
	CEQ
	BF	L7
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	0
	Sd  1,	I_disp
	BRA	L6
L7:
L6:					; post if
	BRA	LOOP__1
L4:					; post loop LOOP__1
; CODE_RETURN : EXPR TYPE = DN_INTEGER
	Ld 1,	I_disp
	Sd  1,	-result__ofs
	BRA ret_lbl
ret_lbl:
	UNLINK 1
	RTD	prm_siz-8
excep:
endPRO					;---------- end PRO HASH_POS
end if

