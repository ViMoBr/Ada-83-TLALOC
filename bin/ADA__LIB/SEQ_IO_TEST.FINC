					; COULEUR ENUMERATION TYPE INFO
COULEUR = 'COULEUR'
namespace COULEUR
VAR use__info, q
BEGIN_BLOC_DEF
db 0, 5, "ROUGE"
db 1, 4, "VERT"
db 2, 4, "BLEU"
db 3, 5, "BLANC"
db 4, 4, "NOIR"
END_BLOC_DEF
IMAGES	BYTES_BLOC
CST LST, d, 4
CST FST, d, 0
CST SIZ, d, 8	; SIZ en bits !
postpone
  align_q
end postpone
	LCA	SIZ
	Sa	1, use__info
end namespace

					; POINT RECORD TYPE INFO
POINT = 'POINT'
namespace POINT
VAR use__info, q
VAR SIZ, d
	LVA	1, SIZ
	Sa	1, use__info
USEINFO 1, X, 	La 0, STANDARD.INTEGER.use__info
USEINFO 1, Y, 	La 0, STANDARD.INTEGER.use__info
USEINFO 1, Z, 	La 0, STANDARD.INTEGER.use__info
virtual at 0				; calcul des offsets statiques
STATOFS X, 4
STATOFS Y, 4
STATOFS Z, 4
size = $
end virtual
	LI	 size*8
	Sd	1, SIZ
end namespace

					; array decl constrained array type info
VECTEUR = 'VECTEUR'
namespace VECTEUR
VAR use__info, q
VAR SIZ, d
	LVA	1, SIZ
	Sa	1, use__info
VAR COMP_SIZ, d
VAR FST_1, d
VAR LST_1, d
	LI	32
	Sd	1, COMP_SIZ
	Ld	1, COMP_SIZ
	LI	1
	Sd	1, FST_1
	LI	4
	Sd	1, LST_1
	Ld	1, LST_1
	INC
	Ld	1, FST_1
	SUB
	MUL
	Sd	1, SIZ
  virtual at 4
COMP_SIZ = $
	rd 1 
FST_1 = $
	rd 1 
LST_1 = $
	rd 1 
  end virtual
end namespace
INT_IO = 'INT_IO'
namespace INT_IO				;---------- GENERIC PACKAGE INSTANTIATION
elab_spec:				;    SPEC ELAB

BRA post_LD_INTEGER
LD_INTEGER.elab:
	Ld -1, 0
	RTD 0
post_LD_INTEGER:
BRA post_ST_INTEGER
ST_INTEGER.elab:
	Sd -1, 0
	RTD 0
post_ST_INTEGER:
BRA post_INADR_INTEGER
INADR_INTEGER.elab:
	RTD 0
post_INADR_INTEGER:
BRA post_OUTADR_INTEGER
OUTADR_INTEGER.elab:
	La
	RTD 0
