; CODE_TYPE_DECL : skip PRIVATE TIME (deferred to full type)

					; YEAR_NUMBER INTEGER SUBTYPE INFO
YEAR_NUMBER = 'YEAR_NUMBER'
namespace YEAR_NUMBER
VAR use__info, q
VAR SIZ, d
	LVA	0, SIZ
	Sa	0, use__info
VAR FST, d
VAR LST, d
	LI	32
	Sd	0, SIZ
	LI	1901
	Sd	0, FST
	LI	2099
	Sd	0, LST
VAR PARENT__u, q
	La	0, STANDARD.INTEGER.use__info
	Sa	0, PARENT__u
end namespace

					; MONTH_NUMBER INTEGER SUBTYPE INFO
MONTH_NUMBER = 'MONTH_NUMBER'
namespace MONTH_NUMBER
VAR use__info, q
VAR SIZ, d
	LVA	0, SIZ
	Sa	0, use__info
VAR FST, d
VAR LST, d
	LI	32
	Sd	0, SIZ
	LI	1
	Sd	0, FST
	LI	12
	Sd	0, LST
VAR PARENT__u, q
	La	0, STANDARD.INTEGER.use__info
	Sa	0, PARENT__u
end namespace

					; DAY_NUMBER INTEGER SUBTYPE INFO
DAY_NUMBER = 'DAY_NUMBER'
namespace DAY_NUMBER
VAR use__info, q
VAR SIZ, d
	LVA	0, SIZ
	Sa	0, use__info
VAR FST, d
