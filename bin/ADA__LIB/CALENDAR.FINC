; CODE CONVERSION SOURCE DN_INTEGER TARGET DN_FIXED
	LI	000536870912
	LI	 1
	CVTIX
	SUB
	Sq  1,	FRAC_PART_disp

VAR Y_disp, q				; variable entiere

VAR M_disp, q				; variable entiere

VAR D_disp, q				; variable entiere

					;    end elab
begin:					;---------- BDY INSTRUCTIONS
	LVA  1,	STANDARD.CALENDAR.SPLIT_L6.D_disp
	LVA  1,	STANDARD.CALENDAR.SPLIT_L6.M_disp
	LVA  1,	STANDARD.CALENDAR.SPLIT_L6.Y_disp
