CALENDAR = 'CALENDAR'
namespace CALENDAR				;---------- PACKAGE
elab_spec:				;    SPEC ELAB

; CODE_TYPE_DECL : skip PRIVATE TIME (deferred to full type)

					; YEAR_NUMBER INTEGER SUBTYPE INFO
YEAR_NUMBER = 'YEAR_NUMBER'
namespace YEAR_NUMBER
VAR use__info, q
VAR SIZ, d
	LVA	0, SIZ
	Sa	0, use__info
VAR FST, d
VAR LST, d
	LI	32
	Sd	0, SIZ
	LI	1901
	Sd	0, FST
	LI	2099
	Sd	0, LST
VAR PARENT__u, q
	La	0, STANDARD.INTEGER.use__info
	Sa	0, PARENT__u
end namespace

					; MONTH_NUMBER INTEGER SUBTYPE INFO
MONTH_NUMBER = 'MONTH_NUMBER'
namespace MONTH_NUMBER
VAR use__info, q
VAR SIZ, d
	LVA	0, SIZ
	Sa	0, use__info
VAR FST, d
VAR LST, d
	LI	32
	Sd	0, SIZ
	LI	1
	Sd	0, FST
	LI	12
	Sd	0, LST
VAR PARENT__u, q
	La	0, STANDARD.INTEGER.use__info
	Sa	0, PARENT__u
end namespace

					; DAY_NUMBER INTEGER SUBTYPE INFO
DAY_NUMBER = 'DAY_NUMBER'
namespace DAY_NUMBER
VAR use__info, q
VAR SIZ, d
	LVA	0, SIZ
	Sa	0, use__info
VAR FST, d
VAR LST, d
	LI	32
	Sd	0, SIZ
	LI	1
	Sd	0, FST
	LI	31
	Sd	0, LST
VAR PARENT__u, q
	La	0, STANDARD.INTEGER.use__info
	Sa	0, PARENT__u
end namespace
;  CODE_SUBTYPE_DECL : TYPE_SPEC.TY PAS FAIT DN_FIXED

					; TIME TYPE RANGE INFO
TIME = 'TIME'
namespace TIME
VAR use__info, q
VAR SIZ, d
	LVA	0, SIZ
	Sa	0, use__info
VAR FST, q
VAR LST, q
	LI	64
	Sd	0, SIZ
	LI	2
	LI	63
	DEC
	SHL
	NEG
	Sq	0, FST
	LI	2
	LI	63
	DEC
	SHL
	LI	1
	SUB
	Sq	0, LST
end namespace
					;    BODY ELAB

if defined CLOCK_L1_
PRO	CLOCK_L1				;---------- PRO CLOCK
PRMS					;    debut parametrage
	PRM result__ofs				; resultat de fonction
endPRMS					;    fin parametrage
ELB 1					;    BODY ELAB
					;    end elab
begin:					;---------- BDY INSTRUCTIONS
	LI	0
	Sq  1,	-result__ofs
	BRA ret_lbl
ret_lbl:
	UNLINK 1
	RTD
excep:
endPRO					;---------- end PRO CLOCK
end if

