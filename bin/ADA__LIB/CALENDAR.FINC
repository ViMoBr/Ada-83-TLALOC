	Sd	0, SIZ
	LI	1
	Sd	0, FST
	LI	31
	Sd	0, LST
VAR PARENT__u, q
	La	0, STANDARD.INTEGER.use__info
	Sa	0, PARENT__u
end namespace
;  CODE_SUBTYPE_DECL : TYPE_SPEC.TY PAS FAIT DN_FIXED

					; TIME TYPE RANGE INFO
TIME = 'TIME'
namespace TIME
VAR use__info, q
VAR SIZ, d
	LVA	0, SIZ
	Sa	0, use__info
VAR FST, q
VAR LST, q
	LI	64
	Sd	0, SIZ
	LI	2
	LI	63
	DEC
	SHL
	NEG
	Sq	0, FST
	LI	2
	LI	63
	DEC
	SHL
	LI	1
	SUB
	Sq	0, LST
end namespace
