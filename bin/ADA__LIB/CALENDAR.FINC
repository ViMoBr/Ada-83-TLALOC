if defined DAYS_FROM_CIVIL_L7_
PRO	DAYS_FROM_CIVIL_L7			;---------- PRO DAYS_FROM_CIVIL
PRMS					;    debut parametrage
	PRM Y_IN_ofs				; in
	PRM M_IN_ofs				; in
	PRM D_IN_ofs				; in
	PRM result__ofs				; resultat de fonction
endPRMS					;    fin parametrage
ELB 1					;    BODY ELAB
VAR Y_disp, q				; variable entiere

VAR M_ADJ_disp, q				; variable entiere

VAR ERA_disp, q				; variable entiere

VAR YOE_disp, q				; variable entiere

VAR DOY_disp, q				; variable entiere

VAR DOE_disp, q				; variable entiere

					;    end elab
begin:					;---------- BDY INSTRUCTIONS
					; debut if
	Lq  1,	-M_IN_ofs
	LI	2
	CLE
	BF	L9
	Lq  1,	-Y_IN_ofs
	LI	1
	SUB
	Sq  1,	Y_disp
	Lq  1,	-M_IN_ofs
	LI	9
	ADD
	Sq  1,	M_ADJ_disp
	BRA	L8
L9:
	Lq  1,	-Y_IN_ofs
	Sq  1,	Y_disp
	Lq  1,	-M_IN_ofs
	LI	3
	SUB
	Sq  1,	M_ADJ_disp
L8:					; post if
					; debut if
	Lq 1,	Y_disp
	LI	0
	CGE
	BF	L11
	Lq 1,	Y_disp
	LI	400
	DIV
	Sq  1,	ERA_disp
	BRA	L10
L11:
	Lq 1,	Y_disp
	LI	399
	SUB
	LI	400
	DIV
	Sq  1,	ERA_disp
L10:					; post if
	Lq 1,	Y_disp
	Lq 1,	ERA_disp
	LI	400
	MUL
	SUB
	Sq  1,	YOE_disp
	LI	153
	Lq 1,	M_ADJ_disp
	MUL
	LI	2
	ADD
	LI	5
	DIV
	Lq  1,	-D_IN_ofs
	ADD
	LI	1
	SUB
	Sq  1,	DOY_disp
	Lq 1,	YOE_disp
	LI	365
	MUL
	Lq 1,	YOE_disp
	LI	4
	DIV
	ADD
	Lq 1,	YOE_disp
	LI	100
	DIV
	SUB
	Lq 1,	DOY_disp
	ADD
	Sq  1,	DOE_disp
; CODE_RETURN : EXPR TYPE = DN_INTEGER
	Lq 1,	ERA_disp
	LI	00146097
	MUL
	Lq 1,	DOE_disp
	ADD
	Sq  1,	-result__ofs
	BRA ret_lbl
ret_lbl:
	UNLINK 1
	RTD	prm_siz-8
excep:
endPRO					;---------- end PRO DAYS_FROM_CIVIL
end if

if defined CIVIL_FROM_DAYS_L12_
PRO	CIVIL_FROM_DAYS_L12			;---------- PRO CIVIL_FROM_DAYS
PRMS					;    debut parametrage
	PRM DAYS_ofs				; in
	PRM Y_ofs				; out
	PRM M_ofs				; out
	PRM D_ofs				; out
endPRMS					;    fin parametrage
ELB 1					;    BODY ELAB
VAR ERA_disp, q				; variable entiere

VAR DOE_disp, q				; variable entiere

VAR YOE_disp, q				; variable entiere

VAR Y_OUT_disp, q				; variable entiere

VAR DOY_disp, q				; variable entiere

VAR MP_disp, q				; variable entiere

VAR M_OUT_disp, q				; variable entiere

VAR D_OUT_disp, q				; variable entiere

VAR TMP_disp, q				; variable entiere

					;    end elab
begin:					;---------- BDY INSTRUCTIONS
					; debut if
	Lq  1,	-DAYS_ofs
	LI	0
	CGE
	BF	L14
	Lq  1,	-DAYS_ofs
	Sq  1,	TMP_disp
	BRA	L13
L14:
	Lq  1,	-DAYS_ofs
	LI	00146096
	SUB
	Sq  1,	TMP_disp
L13:					; post if
	Lq 1,	TMP_disp
	LI	00146097
	DIV
	Sq  1,	ERA_disp
	Lq  1,	-DAYS_ofs
	Lq 1,	ERA_disp
	LI	00146097
	MUL
	SUB
	Sq  1,	DOE_disp
	Lq 1,	DOE_disp
	Lq 1,	DOE_disp
	LI	1460
	DIV
	SUB
	Lq 1,	DOE_disp
	LI	00036524
	DIV
	ADD
	Lq 1,	DOE_disp
	LI	00146096
	DIV
	SUB
	LI	365
	DIV
	Sq  1,	YOE_disp
	Lq 1,	YOE_disp
	Lq 1,	ERA_disp
	LI	400
	MUL
	ADD
	Sq  1,	Y_OUT_disp
	Lq 1,	DOE_disp
	LI	365
	Lq 1,	YOE_disp
	MUL
	Lq 1,	YOE_disp
	LI	4
	DIV
	ADD
	Lq 1,	YOE_disp
	LI	100
	DIV
	SUB
	SUB
	Sq  1,	DOY_disp
	LI	5
	Lq 1,	DOY_disp
	MUL
	LI	2
	ADD
	LI	153
	DIV
	Sq  1,	MP_disp
	Lq 1,	DOY_disp
	LI	153
	Lq 1,	MP_disp
	MUL
	LI	2
	ADD
	LI	5
	DIV
	SUB
	LI	1
	ADD
	Sq  1,	D_OUT_disp
					; debut if
	Lq 1,	MP_disp
	LI	10
	CLT
	BF	L16
	Lq 1,	MP_disp
	LI	3
	ADD
	Sq  1,	M_OUT_disp
	BRA	L15
L16:
	Lq 1,	MP_disp
	LI	9
	SUB
	Sq  1,	M_OUT_disp
	Lq 1,	Y_OUT_disp
	LI	1
	ADD
	Sq  1,	Y_OUT_disp
L15:					; post if
	Lq 1,	Y_OUT_disp
	SIq  1,	-Y_ofs
	Lq 1,	M_OUT_disp
	SIq  1,	-M_ofs
	Lq 1,	D_OUT_disp
	SIq  1,	-D_ofs
ret_lbl:
	UNLINK 1
	RTD	prm_siz
excep:
endPRO					;---------- end PRO CIVIL_FROM_DAYS
end if

if defined CLOCK_L1_
PRO	CLOCK_L1				;---------- PRO CLOCK
PRMS					;    debut parametrage
	PRM result__ofs				; resultat de fonction
endPRMS					;    fin parametrage
ELB 1					;    BODY ELAB

					; LINUX_TIMEVAL RECORD TYPE INFO
LINUX_TIMEVAL = 'LINUX_TIMEVAL'
namespace LINUX_TIMEVAL
VAR use__info, q
VAR SIZ, d
	LVA	1, SIZ
	Sa	1, use__info
USEINFO 1, SEC, 	La 0, STANDARD.LONG_INTEGER.use__info
USEINFO 1, NANOSEC, 	La 0, STANDARD.LONG_INTEGER.use__info
virtual at 0				; calcul des offsets statiques
STATOFS SEC, 8
STATOFS NANOSEC, 8
size = $
end virtual
	LI	 size*8
	Sd	1, SIZ
end namespace
VAR LTV_disp, q				; variable record : pointeur aux data record
VAR LTV__u, q				; variable record : pointeur aux useinfo
VAR LTV__dat, STANDARD.CALENDAR.CLOCK_L1.LINUX_TIMEVAL.size
	LVA	1, LTV__dat
	Sa	1, LTV_disp				; record fin
	LVA	1, STANDARD.CALENDAR.CLOCK_L1.LINUX_TIMEVAL.SIZ
	Sa	1, LTV__u

VAR T_disp, q				; variable entiere


if defined GETTIME_SYSCALL_L17_
PRO	GETTIME_SYSCALL_L17			;---------- PRO GETTIME_SYSCALL
PRMS					;    debut parametrage
	PRM TV_ofs				; out
endPRMS					;    fin parametrage
ELB 2					;    BODY ELAB
					;    end elab
begin:					;---------- BDY INSTRUCTIONS
	LIA 2 ,	-8
	SYS_CLOCK_GETTIME
ret_lbl:
	UNLINK 2
	RTD	prm_siz
excep:
endPRO					;---------- end PRO GETTIME_SYSCALL
end if
					;    end elab
begin:					;---------- BDY INSTRUCTIONS
	LVA  1,	LTV_disp
	CALL	STANDARD.CALENDAR.CLOCK_L1. ,GETTIME_SYSCALL_L17
	LIq	1, LTV_disp, STANDARD.CALENDAR.CLOCK_L1.LINUX_TIMEVAL.SEC
	Lq 0,	STANDARD.CALENDAR.EPOCH_DIFF_S_disp
	ADD
	Lq 0,	STANDARD.CALENDAR.SCALE_disp
	MUL
	LIq	1, LTV_disp, STANDARD.CALENDAR.CLOCK_L1.LINUX_TIMEVAL.NANOSEC
	Lq 0,	STANDARD.CALENDAR.SCALE_disp
	MUL
	Lq 0,	STANDARD.CALENDAR.NS_PER_SEC_disp
	DIV
	ADD
	Sq  1,	T_disp
; CODE_RETURN : EXPR TYPE = DN_PRIVATE
	Lq 1,	T_disp
; EXPRESSIONS.CODE_CONVERSION cible non faite DN_PRIVATE
	Sa  1,	-result__ofs
	BRA ret_lbl
ret_lbl:
	UNLINK 1
	RTD
excep:
endPRO					;---------- end PRO CLOCK
end if

if defined YEAR_L2_
