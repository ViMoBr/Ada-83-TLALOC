LONGINT_IO = 'LONGINT_IO'
namespace LONGINT_IO			;---------- GENERIC PACKAGE INSTANTIATION
elab_spec:				;    SPEC ELAB

BRA post_LD_LONG_INTEGER
LD_LONG_INTEGER.elab:
	Lq -1, 0
	RTD 0
post_LD_LONG_INTEGER:
BRA post_ST_LONG_INTEGER
ST_LONG_INTEGER.elab:
	Sq -1, 0
	RTD 0
post_ST_LONG_INTEGER:
BRA post_INADR_LONG_INTEGER
INADR_LONG_INTEGER.elab:
	RTD 0
post_INADR_LONG_INTEGER:
BRA post_OUTADR_LONG_INTEGER
OUTADR_LONG_INTEGER.elab:
	La
	RTD 0
post_OUTADR_LONG_INTEGER:
VAR LONG_INTEGER__outadr_ofs, q
	LCA OUTADR_LONG_INTEGER.elab
	Sa	 0, LONG_INTEGER__outadr_ofs
VAR LONG_INTEGER__inadr_ofs, q
	LCA INADR_LONG_INTEGER.elab
	Sa	 0, LONG_INTEGER__inadr_ofs
VAR LONG_INTEGER__st_ofs, q
	LCA ST_LONG_INTEGER.elab
	Sa	 0, LONG_INTEGER__st_ofs
VAR LONG_INTEGER__ld_ofs, q
	LCA LD_LONG_INTEGER.elab
	Sa	 0, LONG_INTEGER__ld_ofs
VAR LONG_INTEGER__u_ofs, q
	La	 0, STANDARD.LONG_INTEGER.use__info
	Sa	 0, LONG_INTEGER__u_ofs
VAR GFP_disp, q				; Lieu du Generic Frame Pointer 
VAR DEFAULT_WIDTH_disp, d			; variable entiere
	LI	 20
	Sd  0,	DEFAULT_WIDTH_disp

VAR DEFAULT_BASE_disp, d			; variable entiere
	LI	10
	Sd  0,	DEFAULT_BASE_disp

if defined GET_L61_
PRO	GET_L61				;---------- PRO GET
PRMS					;    debut parametrage
	PRM FILE_ofs				; in
	PRM ITEM_ofs				; out
	PRM WIDTH_ofs				; in
endPRMS					;    fin parametrage
ELB 1
begin:
	LVA	 0, GFP_disp
	Ld	 1, -WIDTH_ofs
	La 	 1, -ITEM_ofs
	La 	 1, -FILE_ofs
	CALL	STANDARD.TEXT_IO.INTEGER_IO. ,GET_L61
	UNLINK	 1
	RTD	prm_siz
endPRO					;---------- end PRO GET
end if
if defined GET_L62_
