if defined SECONDS_L5_
PRO	SECONDS_L5				;---------- PRO SECONDS
PRMS					;    debut parametrage
	PRM DATE_ofs				; in
	PRM result__ofs				; resultat de fonction
endPRMS					;    fin parametrage
ELB 1					;    BODY ELAB
VAR T_disp, q				; variable entiere

VAR SEC_TOTAL_disp, q			; variable entiere

VAR FRAC_PART_disp, q			; variable entiere

VAR SEC_OF_DAY_disp, q			; variable entiere

VAR RESULT_disp, q				; variable entiere

					;    end elab
begin:					;---------- BDY INSTRUCTIONS
	La  1,	-DATE_ofs
	Sq  1,	T_disp
	Lq 1,	T_disp
	Lq 0,	STANDARD.CALENDAR.SCALE_disp
	DIV
	Sq  1,	SEC_TOTAL_disp
	Lq 1,	T_disp
	Lq 1,	SEC_TOTAL_disp
	Lq 0,	STANDARD.CALENDAR.SCALE_disp
	MUL
	SUB
	Sq  1,	FRAC_PART_disp
STR STR_L18, "T : "				; constante string="T : "
	LCA	STR_L18.data_ptr
	CALL	STANDARD.TEXT_IO. ,PUT_L56
	Ld 0,	STANDARD.CALENDAR.LONGINT_IO.DEFAULT_BASE_disp
	Ld 0,	STANDARD.CALENDAR.LONGINT_IO.DEFAULT_WIDTH_disp
	Lq 1,	T_disp
	CALL	STANDARD.CALENDAR.LONGINT_IO. ,PUT_L64
	LI	1
	CALL	STANDARD.TEXT_IO. ,NEW_LINE_L26
STR STR_L19, "SEC_TOTAL : "			; constante string="SEC_TOTAL : "
	LCA	STR_L19.data_ptr
	CALL	STANDARD.TEXT_IO. ,PUT_L56
	Ld 0,	STANDARD.CALENDAR.LONGINT_IO.DEFAULT_BASE_disp
	Ld 0,	STANDARD.CALENDAR.LONGINT_IO.DEFAULT_WIDTH_disp
	Lq 1,	SEC_TOTAL_disp
	CALL	STANDARD.CALENDAR.LONGINT_IO. ,PUT_L64
	LI	1
	CALL	STANDARD.TEXT_IO. ,NEW_LINE_L26
STR STR_L20, "FRAC_PART : "			; constante string="FRAC_PART : "
	LCA	STR_L20.data_ptr
	CALL	STANDARD.TEXT_IO. ,PUT_L56
	Ld 0,	STANDARD.CALENDAR.LONGINT_IO.DEFAULT_BASE_disp
	Ld 0,	STANDARD.CALENDAR.LONGINT_IO.DEFAULT_WIDTH_disp
	Lq 1,	FRAC_PART_disp
	CALL	STANDARD.CALENDAR.LONGINT_IO. ,PUT_L64
	LI	1
	CALL	STANDARD.TEXT_IO. ,NEW_LINE_L26
	Lq 1,	SEC_TOTAL_disp
	Lq 0,	STANDARD.CALENDAR.SECONDS_PER_DAY_disp
	REMI
	Sq  1,	SEC_OF_DAY_disp
STR STR_L21, "SEC_OF_DAY : "			; constante string="SEC_OF_DAY : "
	LCA	STR_L21.data_ptr
	CALL	STANDARD.TEXT_IO. ,PUT_L56
	Ld 0,	STANDARD.CALENDAR.LONGINT_IO.DEFAULT_BASE_disp
	Ld 0,	STANDARD.CALENDAR.LONGINT_IO.DEFAULT_WIDTH_disp
	Lq 1,	SEC_OF_DAY_disp
	CALL	STANDARD.CALENDAR.LONGINT_IO. ,PUT_L64
	LI	1
	CALL	STANDARD.TEXT_IO. ,NEW_LINE_L26
					; debut if
	Lq 1,	SEC_OF_DAY_disp
	LI	0
	CLT
	BF	L23
	Lq 1,	SEC_OF_DAY_disp
	Lq 0,	STANDARD.CALENDAR.SECONDS_PER_DAY_disp
	ADD
	Sq  1,	SEC_OF_DAY_disp
	BRA	L22
L23:
L22:					; post if
	Lq 1,	SEC_OF_DAY_disp
	Sq  1,	RESULT_disp
STR STR_L24, "RESULT : "			; constante string="RESULT : "
	LCA	STR_L24.data_ptr
	CALL	STANDARD.TEXT_IO. ,PUT_L56
	Ld 0,	STANDARD.CALENDAR.LONGINT_IO.DEFAULT_BASE_disp
	Ld 0,	STANDARD.CALENDAR.LONGINT_IO.DEFAULT_WIDTH_disp
	Lq 1,	RESULT_disp
	CALL	STANDARD.CALENDAR.LONGINT_IO. ,PUT_L64
	LI	1
	CALL	STANDARD.TEXT_IO. ,NEW_LINE_L26
; CODE_RETURN : EXPR TYPE = DN_FIXED
	Lq 1,	RESULT_disp
	LI	050000000000
	MUL
	LI	 93
	DIV
; FIXED to FIXED a faire
	Sq  1,	-result__ofs
	BRA ret_lbl
ret_lbl:
	UNLINK 1
	RTD	prm_siz-8
excep:
endPRO					;---------- end PRO SECONDS
end if

if defined SPLIT_L6_
PRO	SPLIT_L6				;---------- PRO SPLIT
PRMS					;    debut parametrage
	PRM DATE_ofs				; in
	PRM YEAR_ofs				; out
	PRM MONTH_ofs				; out
	PRM DAY_ofs				; out
	PRM SECONDS_ofs				; out
endPRMS					;    fin parametrage
ELB 1					;    BODY ELAB
VAR Y_disp, q				; variable entiere

VAR M_disp, q				; variable entiere

VAR D_disp, q				; variable entiere

VAR T_disp, q				; variable entiere

VAR SEC_TOTAL_disp, q			; variable entiere

VAR FRAC_PART_disp, q			; variable entiere

VAR DAYS_FROM_1900_disp, q			; variable entiere

VAR SEC_OF_DAY_disp, q			; variable entiere

VAR DUR_INTERNAL_disp, q			; variable entiere

					;    end elab
begin:					;---------- BDY INSTRUCTIONS
	La  1,	-DATE_ofs
	Sq  1,	T_disp
	Lq 1,	T_disp
	Lq 0,	STANDARD.CALENDAR.SCALE_disp
	DIV
	Sq  1,	SEC_TOTAL_disp
	Lq 1,	T_disp
	Lq 1,	SEC_TOTAL_disp
	Lq 0,	STANDARD.CALENDAR.SCALE_disp
	MUL
	SUB
	Sq  1,	FRAC_PART_disp
	Lq 1,	SEC_TOTAL_disp
	Lq 0,	STANDARD.CALENDAR.SECONDS_PER_DAY_disp
	DIV
	Sq  1,	DAYS_FROM_1900_disp
	Lq 1,	SEC_TOTAL_disp
	Lq 1,	DAYS_FROM_1900_disp
	Lq 0,	STANDARD.CALENDAR.SECONDS_PER_DAY_disp
	MUL
	SUB
	Sq  1,	SEC_OF_DAY_disp
					; debut if
	Lq 1,	SEC_OF_DAY_disp
	LI	0
	CLT
	BF	L26
	Lq 1,	SEC_OF_DAY_disp
	Lq 0,	STANDARD.CALENDAR.SECONDS_PER_DAY_disp
	ADD
	Sq  1,	SEC_OF_DAY_disp
	Lq 1,	DAYS_FROM_1900_disp
	LI	1
	SUB
	Sq  1,	DAYS_FROM_1900_disp
	BRA	L25
L26:
L25:					; post if
					; debut if
	Lq 1,	FRAC_PART_disp
	LI	0
	CLT
	BF	L28
	Lq 1,	FRAC_PART_disp
	Lq 0,	STANDARD.CALENDAR.SCALE_disp
	ADD
	Sq  1,	FRAC_PART_disp
	Lq 1,	SEC_OF_DAY_disp
	LI	1
	SUB
	Sq  1,	SEC_OF_DAY_disp
					; debut if
	Lq 1,	SEC_OF_DAY_disp
	LI	0
	CLT
	BF	L30
	Lq 1,	SEC_OF_DAY_disp
	Lq 0,	STANDARD.CALENDAR.SECONDS_PER_DAY_disp
	ADD
	Sq  1,	SEC_OF_DAY_disp
	Lq 1,	DAYS_FROM_1900_disp
	LI	1
	SUB
	Sq  1,	DAYS_FROM_1900_disp
	BRA	L29
L30:
L29:					; post if
	BRA	L27
L28:
L27:					; post if
	LVA  1,	D_disp
	LVA  1,	M_disp
	LVA  1,	Y_disp
	Lq 1,	DAYS_FROM_1900_disp
	Lq 0,	STANDARD.CALENDAR.DAYS_1900_disp
	ADD
	CALL	STANDARD.CALENDAR. ,CIVIL_FROM_DAYS_L12
	Lq 1,	SEC_OF_DAY_disp
	Lq 0,	STANDARD.CALENDAR.SCALE_disp
	MUL
	Lq 1,	FRAC_PART_disp
	ADD
	Sq  1,	DUR_INTERNAL_disp
	Lq 1,	Y_disp
	SId  1,	-YEAR_ofs
	Lq 1,	M_disp
	SId  1,	-MONTH_ofs
	Lq 1,	D_disp
	SId  1,	-DAY_ofs
	LIF	 1.86000000000000E-09
	LI	050000000000
	CVTIF
	FMUL
	LI	 93
	CVTIF
	FDIV
	CVTFI
	Lq 1,	DUR_INTERNAL_disp
	LI	050000000000
	MUL
	LI	 93
	DIV
	MUL
	SIq  1,	-SECONDS_ofs
ret_lbl:
	UNLINK 1
	RTD	prm_siz
excep:
endPRO					;---------- end PRO SPLIT
end if

if defined TIME_OF_L7_
PRO	TIME_OF_L7				;---------- PRO TIME_OF
PRMS					;    debut parametrage
	PRM YEAR_ofs				; in
	PRM MONTH_ofs				; in
	PRM DAY_ofs				; in
	PRM SECONDS_ofs				; in
	PRM result__ofs				; resultat de fonction
endPRMS					;    fin parametrage
ELB 1					;    BODY ELAB
VAR DAYS_FROM_HINNANT_disp, q			; variable entiere

VAR DAYS_FROM_1900_LOCAL_disp, q		; variable entiere

VAR DUR_INTERNAL_disp, q			; variable entiere

VAR T_disp, q				; variable entiere

					;    end elab
begin:					;---------- BDY INSTRUCTIONS
	LI	0					; lieu resultat sur pile
	Ld  1,	-DAY_ofs
	Ld  1,	-MONTH_ofs
	Ld  1,	-YEAR_ofs
	CALL	STANDARD.CALENDAR. ,DAYS_FROM_CIVIL_L7
	Sq  1,	DAYS_FROM_HINNANT_disp
	Lq 1,	DAYS_FROM_HINNANT_disp
	Lq 0,	STANDARD.CALENDAR.DAYS_1900_disp
	SUB
	Sq  1,	DAYS_FROM_1900_LOCAL_disp
	Lq  1,	-SECONDS_ofs
	LIF	 1.86000000000000E-09
	LI	050000000000
	CVTIF
	FMUL
	LI	 93
	CVTIF
	FDIV
	CVTFI
	DIV
	Sq  1,	DUR_INTERNAL_disp
	Lq 1,	DAYS_FROM_1900_LOCAL_disp
	Lq 0,	STANDARD.CALENDAR.SECONDS_PER_DAY_disp
	MUL
	Lq 0,	STANDARD.CALENDAR.SCALE_disp
	MUL
	Lq 1,	DUR_INTERNAL_disp
	ADD
	Sq  1,	T_disp
; CODE_RETURN : EXPR TYPE = DN_PRIVATE
	Lq 1,	T_disp
; EXPRESSIONS.CODE_CONVERSION cible non faite DN_PRIVATE
	Sa  1,	-result__ofs
	BRA ret_lbl
; CHOICE_OTHERS in EXCEPTIONS todo
	BRA	L31
L32:
L31:
ret_lbl:
	UNLINK 1
	RTD	prm_siz-8
excep:
endPRO					;---------- end PRO TIME_OF
end if

