endPRMS					;    fin parametrage
ELB 1					;    BODY ELAB
VAR SECONDS_TOTAL_disp, q			; variable entiere
	LI	0					; lieu resultat sur pile
	La  1,	-DATE_ofs
	CALL	STANDARD.CALENDAR. ,WHOLE_SECONDS_L20
	Sq  1,	SECONDS_TOTAL_disp

VAR DAYS_FROM_1900_disp, q			; variable entiere
	Lq 1,	SECONDS_TOTAL_disp
	Lq 0,	STANDARD.CALENDAR.SECONDS_PER_DAY_disp
	DUP
	LI	0
	CEQ
	BT	STANDARD.ne_raise_
	DIV
	Sq  1,	DAYS_FROM_1900_disp

VAR Y_disp, q				; variable entiere

VAR M_disp, q				; variable entiere

VAR D_disp, q				; variable entiere

					;    end elab
begin:					;---------- BDY INSTRUCTIONS
	LVA  1,	STANDARD.CALENDAR.YEAR_L2.D_disp
	LVA  1,	STANDARD.CALENDAR.YEAR_L2.M_disp
	LVA  1,	STANDARD.CALENDAR.YEAR_L2.Y_disp
	Lq 1,	DAYS_FROM_1900_disp
	Lq 0,	STANDARD.CALENDAR.DAYS_1900_disp
	ADD
	CALL	STANDARD.CALENDAR. ,CIVIL_FROM_DAYS_L8
; CODE_RETURN : EXPR TYPE = DN_INTEGER  VUE COMPLETE = DN_INTEGER
	Lq 1,	Y_disp
; CODE CONVERSION SOURCE DN_INTEGER TARGET DN_INTEGER
	DUP
	Ld	0, STANDARD.CALENDAR._YEAR_NUMBER.FST
	CLT
	BT	STANDARD.ce_raise_
	DUP
	Ld	0, STANDARD.CALENDAR._YEAR_NUMBER.LST
	CGT
	BT	STANDARD.ce_raise_
	DUP
	Ld	0, STANDARD.CALENDAR._YEAR_NUMBER.FST
	CLT
	BT	STANDARD.ce_raise_
	DUP
	Ld	0, STANDARD.CALENDAR._YEAR_NUMBER.LST
	CGT
	BT	STANDARD.ce_raise_
	Sd  1,	-result__ofs
	BRA ret_lbl
ret_lbl:
	UNLINK 1
	RTD	prm_siz-8
excep:
endPRO					;---------- end PRO YEAR
end if

