VAR EPOCH_DIFF_S_disp, q			; variable entiere
	LI	002208988800
	Sq  0,	EPOCH_DIFF_S_disp

VAR SCALE_disp, q				; variable entiere
	LI	000536870912
	Sq  0,	SCALE_disp

VAR DAYS_1900_disp, q			; variable entiere
