	LI	000536870912
	LI	 1
	CVTIX
	CEQ
	BF	L24
; CODE_RETURN : EXPR TYPE = DN_INTEGER  VUE COMPLETE = DN_INTEGER
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	0
	Sq  1,	-result__ofs
	BRA ret_lbl
	BRA	L23
L24:
; CODE_RETURN : EXPR TYPE = DN_INTEGER  VUE COMPLETE = DN_INTEGER
	Lq 1,	D_disp
; CODE_NUMERIC_LITERAL DN_FIXED
	LI	 1
	LI	000536870912
	LI	 2
	CVTIX
	SUB
; CODE CONVERSION SOURCE DN_FIXED TARGET DN_INTEGER
	LI	 1
	LI	 536870912
	CVTXI
	Sq  1,	-result__ofs
	BRA ret_lbl
L23:					; post if
ret_lbl:
	UNLINK 1
	RTD	prm_siz-8
excep:
endPRO					;---------- end PRO WHOLE_SECONDS
end if

if defined YEAR_L2_
PRO	YEAR_L2				;---------- PRO YEAR
PRMS					;    debut parametrage
