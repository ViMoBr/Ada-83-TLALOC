if defined DAYS_FROM_CIVIL_L1_
PRO	DAYS_FROM_CIVIL_L1			;---------- PRO DAYS_FROM_CIVIL
PRMS					;    debut parametrage
	PRM Y_IN_ofs				; in
	PRM M_IN_ofs				; in
	PRM D_IN_ofs				; in
	PRM result__ofs				; resultat de fonction
endPRMS					;    fin parametrage
ELB 1					;    BODY ELAB
VAR Y_disp, q				; variable entiere

VAR M_ADJ_disp, q				; variable entiere

VAR ERA_disp, q				; variable entiere

VAR YOE_disp, q				; variable entiere

VAR DOY_disp, q				; variable entiere

VAR DOE_disp, q				; variable entiere

					;    end elab
begin:					;---------- BDY INSTRUCTIONS
					; debut if
	Lq  1,	-M_IN_ofs
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	2
	CLE
	BF	L5
	Lq  1,	-Y_IN_ofs
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	1
	SUB
	Sq  1,	Y_disp
	Lq  1,	-M_IN_ofs
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	9
	ADD
	Sq  1,	M_ADJ_disp
	BRA	L4
L5:
	Lq  1,	-Y_IN_ofs
	Sq  1,	Y_disp
	Lq  1,	-M_IN_ofs
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	3
	SUB
	Sq  1,	M_ADJ_disp
L4:					; post if
					; debut if
	Lq 1,	Y_disp
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	0
	CGE
	BF	L7
	Lq 1,	Y_disp
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	400
	DUP
	LI	0
	CEQ
	BT	STANDARD.ne_raise_
	DIV
	Sq  1,	ERA_disp
	BRA	L6
L7:
	Lq 1,	Y_disp
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	399
	SUB
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	400
	DUP
	LI	0
	CEQ
	BT	STANDARD.ne_raise_
	DIV
	Sq  1,	ERA_disp
L6:					; post if
	Lq 1,	Y_disp
	Lq 1,	ERA_disp
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	400
	MUL
	SUB
	Sq  1,	YOE_disp
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	153
	Lq 1,	M_ADJ_disp
	MUL
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	2
	ADD
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	5
	DUP
	LI	0
	CEQ
	BT	STANDARD.ne_raise_
	DIV
	Lq  1,	-D_IN_ofs
	ADD
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	1
	SUB
	Sq  1,	DOY_disp
	Lq 1,	YOE_disp
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	365
	MUL
	Lq 1,	YOE_disp
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	4
	DUP
	LI	0
	CEQ
	BT	STANDARD.ne_raise_
	DIV
	ADD
	Lq 1,	YOE_disp
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	100
	DUP
	LI	0
	CEQ
	BT	STANDARD.ne_raise_
	DIV
	SUB
	Lq 1,	DOY_disp
	ADD
	Sq  1,	DOE_disp
; CODE_RETURN : EXPR TYPE = DN_INTEGER  VUE COMPLETE = DN_INTEGER
	Lq 1,	ERA_disp
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	00146097
	MUL
	Lq 1,	DOE_disp
	ADD
	Sq  1,	-result__ofs
	BRA ret_lbl
ret_lbl:
	UNLINK 1
	RTD	prm_siz-8
excep:
endPRO					;---------- end PRO DAYS_FROM_CIVIL
end if

if defined CIVIL_FROM_DAYS_L8_
PRO	CIVIL_FROM_DAYS_L8			;---------- PRO CIVIL_FROM_DAYS
PRMS					;    debut parametrage
	PRM DAYS_ofs				; in
	PRM Y_ofs				; out
	PRM M_ofs				; out
	PRM D_ofs				; out
endPRMS					;    fin parametrage
ELB 1					;    BODY ELAB
VAR ERA_disp, q				; variable entiere

VAR DOE_disp, q				; variable entiere

VAR YOE_disp, q				; variable entiere

VAR Y_OUT_disp, q				; variable entiere

VAR DOY_disp, q				; variable entiere

VAR MP_disp, q				; variable entiere

VAR M_OUT_disp, q				; variable entiere

VAR D_OUT_disp, q				; variable entiere

VAR TMP_disp, q				; variable entiere

					;    end elab
begin:					;---------- BDY INSTRUCTIONS
					; debut if
	Lq  1,	-DAYS_ofs
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	0
	CGE
	BF	L12
	Lq  1,	-DAYS_ofs
	Sq  1,	TMP_disp
	BRA	L11
L12:
	Lq  1,	-DAYS_ofs
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	00146096
	SUB
	Sq  1,	TMP_disp
L11:					; post if
	Lq 1,	TMP_disp
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	00146097
	DUP
	LI	0
	CEQ
	BT	STANDARD.ne_raise_
	DIV
	Sq  1,	ERA_disp
	Lq  1,	-DAYS_ofs
	Lq 1,	ERA_disp
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	00146097
	MUL
	SUB
	Sq  1,	DOE_disp
	Lq 1,	DOE_disp
	Lq 1,	DOE_disp
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	1460
	DUP
	LI	0
	CEQ
	BT	STANDARD.ne_raise_
	DIV
	SUB
	Lq 1,	DOE_disp
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	00036524
	DUP
	LI	0
	CEQ
	BT	STANDARD.ne_raise_
	DIV
	ADD
	Lq 1,	DOE_disp
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	00146096
	DUP
	LI	0
	CEQ
	BT	STANDARD.ne_raise_
	DIV
	SUB
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	365
	DUP
	LI	0
	CEQ
	BT	STANDARD.ne_raise_
	DIV
	Sq  1,	YOE_disp
	Lq 1,	YOE_disp
	Lq 1,	ERA_disp
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	400
	MUL
	ADD
	Sq  1,	Y_OUT_disp
	Lq 1,	DOE_disp
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	365
	Lq 1,	YOE_disp
	MUL
	Lq 1,	YOE_disp
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	4
	DUP
	LI	0
	CEQ
	BT	STANDARD.ne_raise_
	DIV
	ADD
	Lq 1,	YOE_disp
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	100
	DUP
	LI	0
	CEQ
	BT	STANDARD.ne_raise_
	DIV
	SUB
	SUB
	Sq  1,	DOY_disp
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	5
	Lq 1,	DOY_disp
	MUL
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	2
	ADD
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	153
	DUP
	LI	0
	CEQ
	BT	STANDARD.ne_raise_
	DIV
	Sq  1,	MP_disp
	Lq 1,	DOY_disp
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	153
	Lq 1,	MP_disp
	MUL
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	2
	ADD
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	5
	DUP
	LI	0
	CEQ
	BT	STANDARD.ne_raise_
	DIV
	SUB
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	1
	ADD
	Sq  1,	D_OUT_disp
					; debut if
	Lq 1,	MP_disp
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	10
	CLT
	BF	L14
	Lq 1,	MP_disp
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	3
	ADD
	Sq  1,	M_OUT_disp
	BRA	L13
L14:
	Lq 1,	MP_disp
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	9
	SUB
	Sq  1,	M_OUT_disp
	Lq 1,	Y_OUT_disp
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	1
	ADD
	Sq  1,	Y_OUT_disp
L13:					; post if
	Lq 1,	Y_OUT_disp
	SIq  1,	-Y_ofs
	Lq 1,	M_OUT_disp
	SIq  1,	-M_ofs
	Lq 1,	D_OUT_disp
	SIq  1,	-D_ofs
ret_lbl:
	UNLINK 1
	RTD	prm_siz
excep:
endPRO					;---------- end PRO CIVIL_FROM_DAYS
end if

if defined CLOCK_L1_
PRO	CLOCK_L1				;---------- PRO CLOCK
PRMS					;    debut parametrage
	PRM result__ofs				; resultat de fonction
endPRMS					;    fin parametrage
ELB 1					;    BODY ELAB

					; _LINUX_TIMEVAL RECORD TYPE INFO
_LINUX_TIMEVAL = '_LINUX_TIMEVAL'
namespace _LINUX_TIMEVAL
VAR use__info, q
VAR SIZ, d
	LVA	1, SIZ
	Sa	1, use__info
USEINFO 1, SEC, 	La 0, STANDARD._LONG_INTEGER.use__info
USEINFO 1, NANOSEC, 	La 0, STANDARD._LONG_INTEGER.use__info
virtual at 0				; calcul des offsets statiques
STATOFS SEC, 8
STATOFS NANOSEC, 8
size = $
end virtual
	LI	 size*8
	Sd	1, SIZ
end namespace
VAR LTV_disp, q				; variable record : pointeur aux data record
VAR LTV__u, q				; variable record : pointeur aux useinfo
VAR LTV__dat, STANDARD.CALENDAR.CLOCK_L1._LINUX_TIMEVAL.size
	LVA	1, LTV__dat
	Sa	1, LTV_disp				; record fin
	LVA	1, STANDARD.CALENDAR.CLOCK_L1._LINUX_TIMEVAL.SIZ
	Sa	1, LTV__u
; CODE_VC_NAME DN_VARIABLE_ID

VAR T_disp, q				; variable fixed

VAR NANOSEC_PART_disp, q			; variable fixed


if defined GETTIME_SYSCALL_L15_
PRO	GETTIME_SYSCALL_L15			;---------- PRO GETTIME_SYSCALL
PRMS					;    debut parametrage
	PRM TV_ofs				; out
endPRMS					;    fin parametrage
ELB 2					;    BODY ELAB
					;    end elab
begin:					;---------- BDY INSTRUCTIONS
	LIA 2 ,	-8
	SYS_CLOCK_GETTIME
ret_lbl:
	UNLINK 2
	RTD	prm_siz
excep:
endPRO					;---------- end PRO GETTIME_SYSCALL
end if
					;    end elab
begin:					;---------- BDY INSTRUCTIONS
	LVA  1,	STANDARD.CALENDAR.CLOCK_L1.LTV_disp
	CALL	STANDARD.CALENDAR.CLOCK_L1. ,GETTIME_SYSCALL_L15
	LIq	1, STANDARD.CALENDAR.CLOCK_L1.LTV_disp, STANDARD.CALENDAR.CLOCK_L1._LINUX_TIMEVAL.NANOSEC
; CODE CONVERSION SOURCE DN_INTEGER TARGET DN_FLOAT
	CVTIF					; CODE_CONVERSION FLOAT TARGET FROM DN_INTEGER
; CODE_NUMERIC_LITERAL DN_FLOAT
	LIF	1.0E-9
	FMUL
; CODE CONVERSION SOURCE DN_FLOAT TARGET DN_FIXED
	LI	000536870912
	CVTIF
	FMUL
	CVTFIR
	Sq  1,	NANOSEC_PART_disp
	LIq	1, STANDARD.CALENDAR.CLOCK_L1.LTV_disp, STANDARD.CALENDAR.CLOCK_L1._LINUX_TIMEVAL.SEC
	Lq 0,	STANDARD.CALENDAR.EPOCH_DIFF_S_disp
	ADD
; CODE CONVERSION SOURCE DN_INTEGER TARGET DN_FIXED
	LI	000536870912
	LI	 1
	CVTIX
	Lq 1,	NANOSEC_PART_disp
	ADD
	Sq  1,	T_disp
; CODE_RETURN : EXPR TYPE = DN_PRIVATE  VUE COMPLETE = DN_FIXED
	Lq 1,	T_disp
; CODE CONVERSION SOURCE DN_FIXED TARGET DN_FIXED
	Sq  1,	-result__ofs
	BRA ret_lbl
ret_lbl:
	UNLINK 1
	RTD
excep:
endPRO					;---------- end PRO CLOCK
end if

if defined WHOLE_SECONDS_L20_
PRO	WHOLE_SECONDS_L20			;---------- PRO WHOLE_SECONDS
