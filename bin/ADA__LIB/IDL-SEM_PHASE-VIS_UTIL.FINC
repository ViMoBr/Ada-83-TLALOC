PARAM_CURSOR_TYPE = 'PARAM_CURSOR_TYPE'
namespace PARAM_CURSOR_TYPE
VAR use__info, q
VAR SIZ, d
	LVA	0, SIZ
	Sa	0, use__info
USEINFO 0, PARAM_LIST, 	La 0, STANDARD.IDL.SEQ_TYPE.use__info
USEINFO 0, PARAM, 	La 0, STANDARD.IDL.TREE.use__info
USEINFO 0, ID_LIST, 	La 0, STANDARD.IDL.SEQ_TYPE.use__info
USEINFO 0, ID, 	La 0, STANDARD.IDL.TREE.use__info
virtual at 0				; calcul des offsets statiques
STATOFS PARAM_LIST, 8
STATOFS PARAM, 4
STATOFS ID_LIST, 8
STATOFS ID, 4
size = $
end virtual
	LI	 size*8
	Sd	0, SIZ
end namespace
					;    BODY ELAB

if defined INIT_PARAM_CURSOR_L1_
PRO	INIT_PARAM_CURSOR_L1			;---------- PRO INIT_PARAM_CURSOR
PRMS					;    debut parametrage
	PRM CURSOR_ofs				; out
	PRM PARAM_LIST_ofs				; in
endPRMS					;    fin parametrage
ELB 1					;    BODY ELAB
					;    end elab
begin:					;---------- BDY INSTRUCTIONS
	La 1, -CURSOR_ofs
	LIVA 	, 0, STANDARD.IDL.SEM_PHASE_L7.VIS_UTIL.PARAM_CURSOR_TYPE.PARAM_LIST
	LI	STANDARD.IDL.SEQ_TYPE.size
	La  1,	-PARAM_LIST_ofs
	BLKMOV
	La 1, -CURSOR_ofs
	LIVA 	, 0, STANDARD.IDL.SEM_PHASE_L7.VIS_UTIL.PARAM_CURSOR_TYPE.ID_LIST
	DUP
	LVA	, STANDARD.IDL.SEQ_TYPE.FIRST
	LI	STANDARD.IDL.TREE.size
	LVA 0,	STANDARD.IDL.TREE_NIL_disp
	La  ,  0
	BLKMOV
	DUP
	LVA	, STANDARD.IDL.SEQ_TYPE.NEXT
	LI	STANDARD.IDL.TREE.size
	LVA 0,	STANDARD.IDL.TREE_NIL_disp
	La  ,  0
	BLKMOV
	DROP
ret_lbl:
	UNLINK 1
	RTD	prm_siz
excep:
endPRO					;---------- end PRO INIT_PARAM_CURSOR
end if

if defined ADVANCE_PARAM_CURSOR_L2_
