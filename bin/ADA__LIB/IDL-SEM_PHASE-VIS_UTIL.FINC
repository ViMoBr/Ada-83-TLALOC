L314:
L313:					; post if
	Ld  2,	IL312_disp				; test de sortie LOOP__21
	Ld  2,	LMT_IL312_disp
	CEQ
	BT	L311
	Ld  2,	IL312_disp				; mise a jour compteur LOOP__21
	INC
	Sd  2,	IL312_disp
	BRA	LOOP__21				; iteration suivante LOOP__21
L311:					; post loop LOOP__21
; CODE_RETURN : EXPR TYPE = DN_CONSTRAINED_ARRAY
	LVA 2,	A_WORK_disp
VAR	RET_INFO_L315, q
