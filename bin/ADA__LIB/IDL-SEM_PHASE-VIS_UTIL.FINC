	BRA	L19
L20:
L19:					; post if
	La 1, -CURSOR_ofs
	LIVA 	, 0, STANDARD.IDL.SEM_PHASE_L7.VIS_UTIL.PARAM_CURSOR_TYPE.ID_LIST
	LI	STANDARD.IDL.SEQ_TYPE.size
