	PRM ID_ofs				; in
	PRM DEFSET_ofs				; out
endPRMS					;    fin parametrage
ELB 1					;    BODY ELAB
VAR NEST_UNIQUE_disp, q			; variable record : pointeur aux data record
VAR NEST_UNIQUE__u, q			; variable record : pointeur aux useinfo
VAR NEST_UNIQUE__dat, STANDARD.IDL.TREE.size
	LVA	1, NEST_UNIQUE__dat
	Sa	1, NEST_UNIQUE_disp			; record fin
	LVA	1, STANDARD.IDL.TREE.SIZ
	Sa	1, NEST_UNIQUE__u
	La  1, NEST_UNIQUE_disp
	LI	STANDARD.IDL.TREE.size
	LVA 0,	STANDARD.IDL.TREE_VOID_disp
	La  ,  0
	BLKMOV

VAR USED_UNIQUE_disp, q			; variable record : pointeur aux data record
VAR USED_UNIQUE__u, q			; variable record : pointeur aux useinfo
VAR USED_UNIQUE__dat, STANDARD.IDL.TREE.size
