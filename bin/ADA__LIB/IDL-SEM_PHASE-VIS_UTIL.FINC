	BLKMOV

VAR NEST_OVLOAD_disp, q			; variable record : pointeur aux data record
VAR NEST_OVLOAD__u, q			; variable record : pointeur aux useinfo
VAR NEST_OVLOAD__dat, STANDARD.IDL.SEQ_TYPE.size
	LVA	1, NEST_OVLOAD__dat
	Sa	1, NEST_OVLOAD_disp			; record fin
	LVA	1, STANDARD.IDL.SEQ_TYPE.SIZ
	Sa	1, NEST_OVLOAD__u
	La 1, NEST_OVLOAD_disp
	DUP
	LVA	, STANDARD.IDL.SEQ_TYPE.FIRST
	LI	STANDARD.IDL.TREE.size
	LVA 0,	STANDARD.IDL.TREE_NIL_disp
	La  ,  0
	BLKMOV
	DUP
	LVA	, STANDARD.IDL.SEQ_TYPE.NEXT
	LI	STANDARD.IDL.TREE.size
	LVA 0,	STANDARD.IDL.TREE_NIL_disp
	La  ,  0
	BLKMOV
	DROP

VAR USED_OVLOAD_disp, q			; variable record : pointeur aux data record
VAR USED_OVLOAD__u, q			; variable record : pointeur aux useinfo
VAR USED_OVLOAD__dat, STANDARD.IDL.SEQ_TYPE.size
	LVA	1, USED_OVLOAD__dat
	Sa	1, USED_OVLOAD_disp			; record fin
	LVA	1, STANDARD.IDL.SEQ_TYPE.SIZ
	Sa	1, USED_OVLOAD__u
