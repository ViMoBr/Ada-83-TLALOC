	DUP
	LVA	, STANDARD.IDL.SEQ_TYPE.FIRST
	LI	STANDARD.IDL.TREE.size
	LVA 0,	STANDARD.IDL.TREE_NIL_disp
	La  ,  0
	BLKMOV
	DUP
	LVA	, STANDARD.IDL.SEQ_TYPE.NEXT
	LI	STANDARD.IDL.TREE.size
	LVA 0,	STANDARD.IDL.TREE_NIL_disp
	La  ,  0
	BLKMOV
	DROP

VAR NEST_UNIQUE_LEVEL_disp, d			; variable entiere
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	0
	Sd  1,	NEST_UNIQUE_LEVEL_disp

VAR USED_IS_OK_disp, d			; variable bool char enum
	LI	1
	Sb  1,	USED_IS_OK_disp

VAR DEFLIST_disp, q				; variable record : pointeur aux data record
VAR DEFLIST__u, q				; variable record : pointeur aux useinfo
VAR DEFLIST__dat, STANDARD.IDL.SEQ_TYPE.size
	LVA	1, DEFLIST__dat
	Sa	1, DEFLIST_disp				; record fin
	LVA	1, STANDARD.IDL.SEQ_TYPE.SIZ
	Sa	1, DEFLIST__u
	La  1, DEFLIST_disp
	LI	STANDARD.IDL.SEQ_TYPE.size
VAR	ANON_131_30_disp, q
VAR	ANON_131_30__u,    q
VAR	ANON_131_30__dat, STANDARD.IDL.SEQ_TYPE.size
	LVA 1, ANON_131_30__dat
	Sa  1, ANON_131_30_disp
	La  0, STANDARD.IDL.SEQ_TYPE.use__info
	Sa  1, ANON_131_30__u
	LVA 1, ANON_131_30_disp
					; doublet resultat record anonyme
VAR	ANON_131_36_disp, q
VAR	ANON_131_36__u,    q
VAR	ANON_131_36__dat, STANDARD.IDL.TREE.size
	LVA 1, ANON_131_36__dat
	Sa  1, ANON_131_36_disp
	La  0, STANDARD.IDL.TREE.use__info
	Sa  1, ANON_131_36__u
	LVA 1, ANON_131_36_disp
					; doublet resultat record anonyme
	La  1,	-ID_ofs
	LI  13
	CALL	STANDARD.IDL. ,D_L13
	CALL	STANDARD.IDL. ,LIST_L18
	La  ,  0
	BLKMOV

