_FORMAL_ARRAY_DATA = '_FORMAL_ARRAY_DATA'
namespace _FORMAL_ARRAY_DATA
VAR use__info, q
VAR SIZ, d
	LVA	0, SIZ
	Sa	0, use__info
USEINFO 0, ID, 	La 0, STANDARD.IDL._TREE.use__info
USEINFO 0, SYM, 	La 0, STANDARD.IDL._TREE.use__info
USEINFO 0, ACTUAL, 	La 0, STANDARD.IDL._TREE.use__info
virtual at 0				; calcul des offsets statiques
STATOFS ID, 4
STATOFS SYM, 4
STATOFS ACTUAL, 4
size = $
end virtual
	LI	 size*8
	Sd	0, SIZ
end namespace

