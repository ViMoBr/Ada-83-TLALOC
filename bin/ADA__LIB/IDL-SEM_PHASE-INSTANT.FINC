	Sa	1, TEMP_disp				; record fin
	LVA	1, STANDARD.IDL._SEQ_TYPE.SIZ
	Sa	1, TEMP__u
; CODE_VC_NAME DN_VARIABLE_ID
	La  1, TEMP_disp
	LI	STANDARD.IDL._SEQ_TYPE.size
	La  1,	-L_ofs
	La  ,  0
	BLKMOV

VAR COUNT_disp, d				; variable entiere
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	0
	Sd  1,	COUNT_disp

					;    end elab
begin:					;---------- BDY INSTRUCTIONS
LOOP__1:
	LI	0					; lieu resultat sur pile
	LVA 1,	TEMP_disp
	CALL	STANDARD.IDL. ,IS_EMPTY_L23
	LI	1
	OUX
	BF	L10
	Ld 1,	COUNT_disp
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	1
	ADD
	Sd  1,	COUNT_disp
	LVA 1,	TEMP_disp
	La
	LI	STANDARD.IDL._SEQ_TYPE.size
VAR	ANON_51_16_disp, q
VAR	ANON_51_16__u,    q
VAR	ANON_51_16__dat, STANDARD.IDL._SEQ_TYPE.size
	LVA 1, ANON_51_16__dat
	Sa  1, ANON_51_16_disp
	La  0, STANDARD.IDL._SEQ_TYPE.use__info
	Sa  1, ANON_51_16__u
	LVA 1, ANON_51_16_disp
					; doublet resultat record anonyme
	LVA 1,	TEMP_disp
	CALL	STANDARD.IDL.IDL_MAN. ,TAIL_L32
	La
	BLKMOV
	BRA	LOOP__1
L10:					; post loop LOOP__1
; CODE_RETURN : EXPR TYPE = DN_INTEGER
	Ld 1,	COUNT_disp
	Sd  1,	-result__ofs
	BRA ret_lbl
ret_lbl:
	UNLINK 1
	RTD	prm_siz-8
excep:
endPRO					;---------- end PRO LENGTH
end if

