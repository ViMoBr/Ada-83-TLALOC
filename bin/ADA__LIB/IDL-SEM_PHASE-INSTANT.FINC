INSTANT = 'INSTANT'
namespace INSTANT				;---------- PACKAGE
elab_spec:				;    SPEC ELAB

					;    BODY ELAB

					; FORMAL_ARRAY_DATA RECORD TYPE INFO
FORMAL_ARRAY_DATA = 'FORMAL_ARRAY_DATA'
namespace FORMAL_ARRAY_DATA
VAR use__info, q
VAR SIZ, d
	LVA	0, SIZ
	Sa	0, use__info
USEINFO 0, ID, 	La 0, STANDARD.IDL.TREE.use__info
USEINFO 0, SYM, 	La 0, STANDARD.IDL.TREE.use__info
USEINFO 0, ACTUAL, 	La 0, STANDARD.IDL.TREE.use__info
virtual at 0				; calcul des offsets statiques
STATOFS ID, 4
STATOFS SYM, 4
STATOFS ACTUAL, 4
size = $
end virtual
	LI	 size*8
	Sd	0, SIZ
end namespace

					; FORMAL_ARRAY_TYPE UNCONSTRAINED ARRAY SUBTYPE INFO
FORMAL_ARRAY_TYPE = 'FORMAL_ARRAY_TYPE'
namespace FORMAL_ARRAY_TYPE
VAR use__info, q
VAR SIZ, d
	LVA	0, SIZ
	Sa	0, use__info
	LI	1
	NEG
	Sd	0, SIZ
  virtual at 4				; use info offsets pour acces sur array contraint

COMP_SIZ = $
	rd 1 
FST_1 = $
	rd 1 
LST_1 = $
	rd 1 
  end virtual
end namespace

if defined LENGTH_L8_
PRO	LENGTH_L8				;---------- PRO LENGTH
PRMS					;    debut parametrage
	PRM L_ofs				; in
	PRM result__ofs				; resultat de fonction
endPRMS					;    fin parametrage
ELB 1					;    BODY ELAB
VAR TEMP_disp, q				; variable record : pointeur aux data record
VAR TEMP__u, q				; variable record : pointeur aux useinfo
VAR TEMP__dat, STANDARD.IDL.SEQ_TYPE.size
	LVA	1, TEMP__dat
	Sa	1, TEMP_disp				; record fin
	LVA	1, STANDARD.IDL.SEQ_TYPE.SIZ
	Sa	1, TEMP__u
; CODE_VC_NAME DN_VARIABLE_ID
	La  1, TEMP_disp
	LI	STANDARD.IDL.SEQ_TYPE.size
	La  1,	-L_ofs
	La  ,  0
	BLKMOV

VAR COUNT_disp, d				; variable entiere
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	0
	Sd  1,	COUNT_disp

					;    end elab
begin:					;---------- BDY INSTRUCTIONS
LOOP__1:
	LI	0					; lieu resultat sur pile
	LVA 1,	TEMP_disp
	CALL	STANDARD.IDL. ,IS_EMPTY_L19
	LI	1
	OUX
	BF	L9
	Ld 1,	COUNT_disp
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	1
	ADD
	Sd  1,	COUNT_disp
	LVA 1,	TEMP_disp
	La
	LI	STANDARD.IDL.SEQ_TYPE.size
VAR	ANON_51_16_disp, q
VAR	ANON_51_16__u,    q
VAR	ANON_51_16__dat, STANDARD.IDL.SEQ_TYPE.size
	LVA 1, ANON_51_16__dat
	Sa  1, ANON_51_16_disp
	La  0, STANDARD.IDL.SEQ_TYPE.use__info
	Sa  1, ANON_51_16__u
	LVA 1, ANON_51_16_disp
					; doublet resultat record anonyme
	LVA 1,	TEMP_disp
	CALL	STANDARD.IDL.IDL_MAN. ,TAIL_L24
	La
	BLKMOV
	BRA	LOOP__1
L9:					; post loop LOOP__1
; CODE_RETURN : EXPR TYPE = DN_INTEGER
	Ld 1,	COUNT_disp
	Sd  1,	-result__ofs
	BRA ret_lbl
ret_lbl:
	UNLINK 1
	RTD	prm_siz-8
excep:
endPRO					;---------- end PRO LENGTH
end if

if defined WALK_INSTANTIATION_L1_
PRO	WALK_INSTANTIATION_L1			;---------- PRO WALK_INSTANTIATION
PRMS					;    debut parametrage
	PRM UNIT_ID_ofs				; in
	PRM INSTANTIATION_ofs			; in
	PRM H_ofs				; in
endPRMS					;    fin parametrage
ELB 1					;    BODY ELAB
VAR GEN_ASSOC_S_disp, q			; variable record : pointeur aux data record
VAR GEN_ASSOC_S__u, q			; variable record : pointeur aux useinfo
VAR GEN_ASSOC_S__dat, STANDARD.IDL.TREE.size
	LVA	1, GEN_ASSOC_S__dat
	Sa	1, GEN_ASSOC_S_disp			; record fin
	LVA	1, STANDARD.IDL.TREE.SIZ
	Sa	1, GEN_ASSOC_S__u
; CODE_VC_NAME DN_CONSTANT_ID
	La  1, GEN_ASSOC_S_disp
	LI	STANDARD.IDL.TREE.size
VAR	ANON_58_36_disp, q
VAR	ANON_58_36__u,    q
VAR	ANON_58_36__dat, STANDARD.IDL.TREE.size
	LVA 1, ANON_58_36__dat
	Sa  1, ANON_58_36_disp
	La  0, STANDARD.IDL.TREE.use__info
	Sa  1, ANON_58_36__u
	LVA 1, ANON_58_36_disp
					; doublet resultat record anonyme
	La  1,	-INSTANTIATION_ofs
	LI  18
	CALL	STANDARD.IDL. ,D_L13
	La  ,  0
	BLKMOV

VAR NAME_disp, q				; variable record : pointeur aux data record
VAR NAME__u, q				; variable record : pointeur aux useinfo
VAR NAME__dat, STANDARD.IDL.TREE.size
	LVA	1, NAME__dat
	Sa	1, NAME_disp				; record fin
	LVA	1, STANDARD.IDL.TREE.SIZ
	Sa	1, NAME__u
; CODE_VC_NAME DN_VARIABLE_ID
	La  1, NAME_disp
	LI	STANDARD.IDL.TREE.size
VAR	ANON_59_28_disp, q
VAR	ANON_59_28__u,    q
VAR	ANON_59_28__dat, STANDARD.IDL.TREE.size
	LVA 1, ANON_59_28__dat
	Sa  1, ANON_59_28_disp
	La  0, STANDARD.IDL.TREE.use__info
	Sa  1, ANON_59_28__u
	LVA 1, ANON_59_28_disp
					; doublet resultat record anonyme
	La  1,	-INSTANTIATION_ofs
	LI  48
	CALL	STANDARD.IDL. ,D_L13
	La  ,  0
	BLKMOV

VAR UNIT_DEF_disp, q			; variable record : pointeur aux data record
VAR UNIT_DEF__u, q				; variable record : pointeur aux useinfo
VAR UNIT_DEF__dat, STANDARD.IDL.TREE.size
	LVA	1, UNIT_DEF__dat
	Sa	1, UNIT_DEF_disp			; record fin
	LVA	1, STANDARD.IDL.TREE.SIZ
	Sa	1, UNIT_DEF__u
; CODE_VC_NAME DN_CONSTANT_ID
	La  1, UNIT_DEF_disp
	LI	STANDARD.IDL.TREE.size
VAR	ANON_61_35_disp, q
VAR	ANON_61_35__u,    q
VAR	ANON_61_35__dat, STANDARD.IDL.TREE.size
	LVA 1, ANON_61_35__dat
	Sa  1, ANON_61_35_disp
	La  0, STANDARD.IDL.TREE.use__info
	Sa  1, ANON_61_35__u
	LVA 1, ANON_61_35_disp
					; doublet resultat record anonyme
	La  1,	-UNIT_ID_ofs
	CALL	STANDARD.IDL.SEM_PHASE_L7.DEF_UTIL. ,GET_DEF_FOR_ID_L55
	La  ,  0
	BLKMOV

VAR GENERIC_ID_disp, q			; variable record : pointeur aux data record
VAR GENERIC_ID__u, q			; variable record : pointeur aux useinfo
VAR GENERIC_ID__dat, STANDARD.IDL.TREE.size
	LVA	1, GENERIC_ID__dat
	Sa	1, GENERIC_ID_disp			; record fin
	LVA	1, STANDARD.IDL.TREE.SIZ
	Sa	1, GENERIC_ID__u
; CODE_VC_NAME DN_VARIABLE_ID

VAR NODE_HASH_disp, q			; variable record : pointeur aux data record
VAR NODE_HASH__u, q				; variable record : pointeur aux useinfo
VAR NODE_HASH__dat, STANDARD.IDL.SEM_PHASE_L7.GEN_SUBS.NODE_HASH_TYPE.size
	LVA	1, NODE_HASH__dat
	Sa	1, NODE_HASH_disp			; record fin
	LVA	1, STANDARD.IDL.SEM_PHASE_L7.GEN_SUBS.NODE_HASH_TYPE.SIZ
	Sa	1, NODE_HASH__u
; CODE_VC_NAME DN_VARIABLE_ID
	LIVa 1, NODE_HASH_disp, STANDARD.IDL.SEM_PHASE_L7.GEN_SUBS.NODE_HASH_TYPE.LIMIT
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	32000
	Sd
	LIVa 1, NODE_HASH_disp, STANDARD.IDL.SEM_PHASE_L7.GEN_SUBS.NODE_HASH_TYPE.A
!! L ATTRIBUT SM_VALUE DU NOEUD [DN_CONVERSION<1083.44]> N EST PAS UN ENTIER
