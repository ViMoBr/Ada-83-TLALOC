	LI	STANDARD.IDL.SEM_PHASE_L11.SET_UTIL.TYPESET_TYPE.size
	LVA 1,	STANDARD.IDL.SEM_PHASE_L11.SET_UTIL.EMPTY_TYPESET_disp
	La  ,  0
	BLKMOV

					;    end elab
begin:					;---------- BDY INSTRUCTIONS
	LI	0
	SIb  1,	-IS_SUBTYPE_OUT_ofs
					; debut if
	La  1,	-EXP_ofs
	LVA 0,	STANDARD.IDL.TREE_VOID_disp
	CEQ
	BF	L20
	La  1,	-TYPESET_ofs
	La
	LI	STANDARD.IDL.SEM_PHASE_L11.SET_UTIL.TYPESET_TYPE.size
	LVA 1,	STANDARD.IDL.SEM_PHASE_L11.SET_UTIL.EMPTY_TYPESET_disp
	La
	BLKMOV
	BRA ret_lbl
	BRA	L19
L20:
L19:					; post if
					; debut if
	La 1, -EXP_ofs
	La	-1, 0
	Ld
	LI	24
	LI	8
	UBFX
	LI	154
	CEQ
	BF	L22
namespace	BLOCK__3
ELB 2					;    BODY ELAB
VAR EXP1_disp, q				; variable record : pointeur aux data record
VAR EXP1__u, q				; variable record : pointeur aux useinfo
