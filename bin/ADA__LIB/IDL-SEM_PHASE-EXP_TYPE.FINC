; CODE record equality "/=" _TREE
	LVA 1,	TYPE_SPEC_disp
	La  ,  0
	Ld
	LVA 0,	STANDARD.IDL.TREE_VOID_disp
	La  ,  0
	Ld
	CEQ
	LI	1
	OUX
	BF	L6
VAR	ANON_37_49_disp, q
VAR	ANON_37_49__u,    q
VAR	ANON_37_49__dat, STANDARD.IDL.SEM_PHASE_L11.SET_UTIL._EXTRAINFO_TYPE.size
	LVA 1, ANON_37_49__dat
	Sa  1, ANON_37_49_disp
