	LI	1
	OUX
	BF	L4
	LVA  1,	STANDARD.IDL.SEM_PHASE_L11.EXP_TYPE.REDUCE_EXP_TYPES_L1.DEFINTERP_disp
	LVA  1,	STANDARD.IDL.SEM_PHASE_L11.EXP_TYPE.REDUCE_EXP_TYPES_L1.TEMP_DEFSET_disp
	CALL	STANDARD.IDL.SEM_PHASE_L11.SET_UTIL. ,POP_L75
	LVA 1,	TYPE_SPEC_disp
	La
	LI	STANDARD.IDL._TREE.size
VAR	ANON_34_20_disp, q
VAR	ANON_34_20__u,    q
VAR	ANON_34_20__dat, STANDARD.IDL._TREE.size
	LVA 1, ANON_34_20__dat
	Sa  1, ANON_34_20_disp
	La  0, STANDARD.IDL._TREE.use__info
	Sa  1, ANON_34_20__u
