if defined EVAL_EXP_TYPES_L1_
PRO	EVAL_EXP_TYPES_L1			;---------- PRO EVAL_EXP_TYPES
PRMS					;    debut parametrage
	PRM EXP_ofs				; in
	PRM TYPESET_ofs				; out
endPRMS					;    fin parametrage
ELB 1					;    BODY ELAB
VAR IS_SUBTYPE_disp, d			; variable bool char enum

					;    end elab
begin:					;---------- BDY INSTRUCTIONS
	LVA  1,	IS_SUBTYPE_disp
	La  1,	-TYPESET_ofs
	La  1,	-EXP_ofs
	CALL	STANDARD.IDL.SEM_PHASE_L11.EXP_TYPE. ,EVAL_EXP_SUBTYPE_TYPES_L2
					; debut if
	Lb 1,	IS_SUBTYPE_disp
	BF	L17
STR STR_L18, "EXPRESSION (NOT SUBTYPE) REQUIRED"	; constante string="EXPRESSION (NOT SUBTYPE) REQUIRED"
	LCA	STR_L18.data_ptr
VAR	ANON_86_14_disp, q
VAR	ANON_86_14__u,    q
VAR	ANON_86_14__dat, STANDARD.IDL.TREE.size
	LVA 1, ANON_86_14__dat
	Sa  1, ANON_86_14_disp
	La  0, STANDARD.IDL.TREE.use__info
	Sa  1, ANON_86_14__u
	LVA 1, ANON_86_14_disp
					; doublet resultat record anonyme
	La  1,	-EXP_ofs
	LI  154
	CALL	STANDARD.IDL. ,D_L17
	CALL	STANDARD.IDL.IDL_MAN. ,ERROR_L45
	La  1,	-TYPESET_ofs
	La
	LI	STANDARD.IDL.SEM_PHASE_L11.SET_UTIL.TYPESET_TYPE.size
	LVA 1,	STANDARD.IDL.SEM_PHASE_L11.SET_UTIL.EMPTY_TYPESET_disp
	La
	BLKMOV
	BRA	L16
L17:
L16:					; post if
ret_lbl:
	UNLINK 1
	RTD	prm_siz
excep:
endPRO					;---------- end PRO EVAL_EXP_TYPES
end if

if defined EVAL_EXP_SUBTYPE_TYPES_L2_
PRO	EVAL_EXP_SUBTYPE_TYPES_L2			;---------- PRO EVAL_EXP_SUBTYPE_TYPES
PRMS					;    debut parametrage
	PRM EXP_ofs				; in
	PRM TYPESET_ofs				; out
	PRM IS_SUBTYPE_OUT_ofs			; out
endPRMS					;    fin parametrage
ELB 1					;    BODY ELAB
VAR NEW_TYPESET_disp, q			; variable record : pointeur aux data record
VAR NEW_TYPESET__u, q			; variable record : pointeur aux useinfo
