	LVA	2, STANDARD.IDL.TREE.SIZ
	Sa	2, EXP1__u
; CODE_VC_NAME DN_CONSTANT_ID
	La  2, EXP1_disp
	LI	STANDARD.IDL.TREE.size
VAR	ANON_124_33_disp, q
VAR	ANON_124_33__u,    q
VAR	ANON_124_33__dat, STANDARD.IDL.TREE.size
	LVA 2, ANON_124_33__dat
