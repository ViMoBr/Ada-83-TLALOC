	LIb	1, EQA_L7, STANDARD.IDL._TREE.NOTY
	LIb	1, EQB_L7, STANDARD.IDL._TREE.NOTY
	CEQ
	ET
	LIw	1, EQA_L7, STANDARD.IDL._TREE.ABSS
	LIw	1, EQB_L7, STANDARD.IDL._TREE.ABSS
	CEQ
	ET
	LIw	1, EQA_L7, STANDARD.IDL._TREE.NSIZ
	LIw	1, EQB_L7, STANDARD.IDL._TREE.NSIZ
	CEQ
	ET
	BRA	L8
L11:
L8:
	LI	1
	OUX
	BF	L6
VAR	ANON_37_49_disp, q
VAR	ANON_37_49__u,    q
VAR	ANON_37_49__dat, STANDARD.IDL.SEM_PHASE_L11.SET_UTIL._EXTRAINFO_TYPE.size
