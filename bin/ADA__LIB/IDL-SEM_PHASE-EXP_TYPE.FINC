if defined REDUCE_EXP_TYPES_L1_
PRO	REDUCE_EXP_TYPES_L1			;---------- PRO REDUCE_EXP_TYPES
PRMS					;    debut parametrage
	PRM DEFSET_ofs				; in
	PRM TYPESET_ofs				; out
endPRMS					;    fin parametrage
ELB 1					;    BODY ELAB
VAR TEMP_DEFSET_disp, q			; variable record : pointeur aux data record
VAR TEMP_DEFSET__u, q			; variable record : pointeur aux useinfo
VAR TEMP_DEFSET__dat, STANDARD.IDL.SEM_PHASE_L11.SET_UTIL._DEFSET_TYPE.size
	LVA	1, TEMP_DEFSET__dat
	Sa	1, TEMP_DEFSET_disp			; record fin
	LVA	1, STANDARD.IDL.SEM_PHASE_L11.SET_UTIL._DEFSET_TYPE.SIZ
	Sa	1, TEMP_DEFSET__u
; CODE_VC_NAME DN_VARIABLE_ID
	La  1, TEMP_DEFSET_disp
	LI	STANDARD.IDL.SEM_PHASE_L11.SET_UTIL._DEFSET_TYPE.size
	La  1,	-DEFSET_ofs
	La  ,  0
	BLKMOV

VAR DEFINTERP_disp, q			; variable record : pointeur aux data record
VAR DEFINTERP__u, q				; variable record : pointeur aux useinfo
VAR DEFINTERP__dat, STANDARD.IDL.SEM_PHASE_L11.SET_UTIL._DEFINTERP_TYPE.size
	LVA	1, DEFINTERP__dat
	Sa	1, DEFINTERP_disp			; record fin
	LVA	1, STANDARD.IDL.SEM_PHASE_L11.SET_UTIL._DEFINTERP_TYPE.SIZ
	Sa	1, DEFINTERP__u
; CODE_VC_NAME DN_VARIABLE_ID

VAR NEW_TYPESET_disp, q			; variable record : pointeur aux data record
VAR NEW_TYPESET__u, q			; variable record : pointeur aux useinfo
VAR NEW_TYPESET__dat, STANDARD.IDL.SEM_PHASE_L11.SET_UTIL._TYPESET_TYPE.size
	LVA	1, NEW_TYPESET__dat
	Sa	1, NEW_TYPESET_disp			; record fin
	LVA	1, STANDARD.IDL.SEM_PHASE_L11.SET_UTIL._TYPESET_TYPE.SIZ
	Sa	1, NEW_TYPESET__u
; CODE_VC_NAME DN_VARIABLE_ID
	La  1, NEW_TYPESET_disp
	LI	STANDARD.IDL.SEM_PHASE_L11.SET_UTIL._TYPESET_TYPE.size
	LVA 1,	STANDARD.IDL.SEM_PHASE_L11.SET_UTIL.EMPTY_TYPESET_disp
	La  ,  0
	BLKMOV

VAR TYPE_SPEC_disp, q			; variable record : pointeur aux data record
VAR TYPE_SPEC__u, q				; variable record : pointeur aux useinfo
VAR TYPE_SPEC__dat, STANDARD.IDL._TREE.size
	LVA	1, TYPE_SPEC__dat
	Sa	1, TYPE_SPEC_disp			; record fin
	LVA	1, STANDARD.IDL._TREE.SIZ
	Sa	1, TYPE_SPEC__u
; CODE_VC_NAME DN_VARIABLE_ID

					;    end elab
begin:					;---------- BDY INSTRUCTIONS
LOOP__1:
	LI	0					; lieu resultat sur pile
	LVA 1,	TEMP_DEFSET_disp
	CALL	STANDARD.IDL.SEM_PHASE_L11.SET_UTIL. ,IS_EMPTY_L74
	BF	L2
	LVA  1,	DEFINTERP_disp
	LVA  1,	TEMP_DEFSET_disp
	CALL	STANDARD.IDL.SEM_PHASE_L11.SET_UTIL. ,POP_L75
	LVA 1,	TYPE_SPEC_disp
	La
	LI	STANDARD.IDL._TREE.size
VAR	ANON_34_20_disp, q
VAR	ANON_34_20__u,    q
VAR	ANON_34_20__dat, STANDARD.IDL._TREE.size
	LVA 1, ANON_34_20__dat
	Sa  1, ANON_34_20_disp
	La  0, STANDARD.IDL._TREE.use__info
	Sa  1, ANON_34_20__u
	LVA 1, ANON_34_20_disp
					; doublet resultat record anonyme
VAR	ANON_34_38_disp, q
VAR	ANON_34_38__u,    q
VAR	ANON_34_38__dat, STANDARD.IDL._TREE.size
	LVA 1, ANON_34_38__dat
	Sa  1, ANON_34_38_disp
	La  0, STANDARD.IDL._TREE.use__info
	Sa  1, ANON_34_38__u
	LVA 1, ANON_34_38_disp
					; doublet resultat record anonyme
	LVA 1,	DEFINTERP_disp
	CALL	STANDARD.IDL.SEM_PHASE_L11.SET_UTIL. ,GET_DEF_L82
	CALL	STANDARD.IDL.SEM_PHASE_L11.DEF_UTIL. ,GET_DEF_EXP_TYPE_L70
	La
	BLKMOV
					; debut if
	LVA 1,	TYPE_SPEC_disp
	LVA 0,	STANDARD.IDL.TREE_VOID_disp
	CNE
	BF	L4
VAR	ANON_37_49_disp, q
VAR	ANON_37_49__u,    q
VAR	ANON_37_49__dat, STANDARD.IDL.SEM_PHASE_L11.SET_UTIL._EXTRAINFO_TYPE.size
	LVA 1, ANON_37_49__dat
	Sa  1, ANON_37_49_disp
	La  1, STANDARD.IDL.SEM_PHASE_L11.SET_UTIL._EXTRAINFO_TYPE.use__info
	Sa  1, ANON_37_49__u
	LVA 1, ANON_37_49_disp
					; doublet resultat record anonyme
	LVA 1,	DEFINTERP_disp
	CALL	STANDARD.IDL.SEM_PHASE_L11.SET_UTIL. ,GET_EXTRAINFO_L84
	LVA 1,	TYPE_SPEC_disp
	LVA  1,	NEW_TYPESET_disp
	CALL	STANDARD.IDL.SEM_PHASE_L11.SET_UTIL. ,ADD_TO_TYPESET_L92
	BRA	L3
L4:
L3:					; post if
	BRA	LOOP__1
L2:					; post loop LOOP__1
	La  1,	-TYPESET_ofs
	La
	LI	STANDARD.IDL.SEM_PHASE_L11.SET_UTIL._TYPESET_TYPE.size
	LVA 1,	NEW_TYPESET_disp
	La
	BLKMOV
ret_lbl:
	UNLINK 1
	RTD	prm_siz
excep:
endPRO					;---------- end PRO REDUCE_EXP_TYPES
end if

