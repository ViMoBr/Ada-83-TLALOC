VAR TYPESET_1_disp, q			; variable record : pointeur aux data record
VAR TYPESET_1__u, q				; variable record : pointeur aux useinfo
VAR TYPESET_1__dat, STANDARD.IDL.SEM_PHASE_L11.SET_UTIL.TYPESET_TYPE.size
	LVA	2, TYPESET_1__dat
	Sa	2, TYPESET_1_disp			; record fin
	LVA	2, STANDARD.IDL.SEM_PHASE_L11.SET_UTIL.TYPESET_TYPE.SIZ
	Sa	2, TYPESET_1__u
; CODE_VC_NAME DN_VARIABLE_ID

VAR TYPESET_2_disp, q			; variable record : pointeur aux data record
VAR TYPESET_2__u, q				; variable record : pointeur aux useinfo
VAR TYPESET_2__dat, STANDARD.IDL.SEM_PHASE_L11.SET_UTIL.TYPESET_TYPE.size
	LVA	2, TYPESET_2__dat
	Sa	2, TYPESET_2_disp			; record fin
	LVA	2, STANDARD.IDL.SEM_PHASE_L11.SET_UTIL.TYPESET_TYPE.SIZ
	Sa	2, TYPESET_2__u
; CODE_VC_NAME DN_VARIABLE_ID

					;    end elab
begin:					;---------- BDY INSTRUCTIONS
	LVA  2,	TYPESET_1_disp
	CALL	STANDARD.IDL.SEM_PHASE_L11.EXP_TYPE. ,EVAL_EXP_TYPES_L1
	LVA  2,	TYPESET_2_disp
	CALL	STANDARD.IDL.SEM_PHASE_L11.EXP_TYPE. ,EVAL_EXP_TYPES_L1
	LVA  1,	NEW_TYPESET_disp
