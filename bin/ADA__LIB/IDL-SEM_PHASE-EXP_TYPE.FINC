EXP_TYPE = 'EXP_TYPE'
namespace EXP_TYPE				;---------- PACKAGE
elab_spec:				;    SPEC ELAB

					;    BODY ELAB
VAR DEBUG_disp, d				; variable bool char enum
	LI	0
	Sb  0,	DEBUG_disp


if defined REDUCE_EXP_TYPES_L8_
PRO	REDUCE_EXP_TYPES_L8			;---------- PRO REDUCE_EXP_TYPES
PRMS					;    debut parametrage
	PRM DEFSET_ofs				; in
	PRM TYPESET_ofs				; out
endPRMS					;    fin parametrage
ELB 1					;    BODY ELAB
VAR TEMP_DEFSET_disp, q			; variable record : pointeur aux data record
VAR TEMP_DEFSET__u, q			; variable record : pointeur aux useinfo
VAR TEMP_DEFSET__dat, STANDARD.IDL.SEM_PHASE_L7.SET_UTIL.DEFSET_TYPE.size
	LVA	1, TEMP_DEFSET__dat
	Sa	1, TEMP_DEFSET_disp			; record fin
	LVA	1, STANDARD.IDL.SEM_PHASE_L7.SET_UTIL.DEFSET_TYPE.SIZ
	Sa	1, TEMP_DEFSET__u
	La  1, TEMP_DEFSET_disp
	LI	STANDARD.IDL.SEM_PHASE_L7.SET_UTIL.DEFSET_TYPE.size
	La  1,	-DEFSET_ofs
	La  ,  0
	BLKMOV

VAR DEFINTERP_disp, q			; variable record : pointeur aux data record
VAR DEFINTERP__u, q				; variable record : pointeur aux useinfo
VAR DEFINTERP__dat, STANDARD.IDL.SEM_PHASE_L7.SET_UTIL.DEFINTERP_TYPE.size
	LVA	1, DEFINTERP__dat
	Sa	1, DEFINTERP_disp			; record fin
	LVA	1, STANDARD.IDL.SEM_PHASE_L7.SET_UTIL.DEFINTERP_TYPE.SIZ
	Sa	1, DEFINTERP__u

VAR NEW_TYPESET_disp, q			; variable record : pointeur aux data record
VAR NEW_TYPESET__u, q			; variable record : pointeur aux useinfo
VAR NEW_TYPESET__dat, STANDARD.IDL.SEM_PHASE_L7.SET_UTIL.TYPESET_TYPE.size
	LVA	1, NEW_TYPESET__dat
	Sa	1, NEW_TYPESET_disp			; record fin
	LVA	1, STANDARD.IDL.SEM_PHASE_L7.SET_UTIL.TYPESET_TYPE.SIZ
	Sa	1, NEW_TYPESET__u
	La  1, NEW_TYPESET_disp
	LI	STANDARD.IDL.SEM_PHASE_L7.SET_UTIL.TYPESET_TYPE.size
!! L ATTRIBUT CD_LEVEL DU NOEUD [DN_CONSTANT_ID<665.91]> N EST PAS UN ENTIER
