	LVA 1,	DEFINTERP_disp
	CALL	STANDARD.IDL.SEM_PHASE_L11.SET_UTIL. ,GET_EXTRAINFO_L84
	LVA 1,	TYPE_SPEC_disp
	LVA  1,	STANDARD.IDL.SEM_PHASE_L11.EXP_TYPE.REDUCE_EXP_TYPES_L1.NEW_TYPESET_disp
	CALL	STANDARD.IDL.SEM_PHASE_L11.SET_UTIL. ,ADD_TO_TYPESET_L92
	BRA	L5
L6:
L5:					; post if
	BRA	LOOP__1
L4:					; post loop LOOP__1
	La  1,	-TYPESET_ofs
	La
	LI	STANDARD.IDL.SEM_PHASE_L11.SET_UTIL._TYPESET_TYPE.size
	LVA 1,	NEW_TYPESET_disp
	La  ,  0
	BLKMOV
ret_lbl:
	UNLINK 1
	RTD	prm_siz
excep:
endPRO					;---------- end PRO REDUCE_EXP_TYPES
end if

