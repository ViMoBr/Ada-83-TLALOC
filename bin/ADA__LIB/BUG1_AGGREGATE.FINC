PRO	BUG1_AGGREGATE_L1			;---------- PRO BUG1_AGGREGATE
ELB 1					;    BODY ELAB

					; PAGE_IDX TYPE RANGE INFO
PAGE_IDX = 'PAGE_IDX'
namespace PAGE_IDX
VAR use__info, q
VAR SIZ, d
	LVA	1, SIZ
	Sa	1, use__info
VAR FST, w
VAR LST, w
	LI	16
	Sd	1, SIZ
; CODE_NUMERIC_LITERAL DN_UNIVERSAL_INTEGER
	LI	0
	Sw	1, FST
; CODE_NUMERIC_LITERAL DN_UNIVERSAL_INTEGER
	LI	255
	Sw	1, LST
end namespace
VAR MAX_VPG_disp, w				; variable entiere
	LI	 255
	Sw  1,	MAX_VPG_disp


					; VPG_IDX INTEGER SUBTYPE INFO
VPG_IDX = 'VPG_IDX'
namespace VPG_IDX
VAR use__info, q
VAR SIZ, d
	LVA	1, SIZ
	Sa	1, use__info
VAR FST, w
VAR LST, w
	LI	16
	Sd	1, SIZ
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	0
	Sw	1, FST
	Lw 1,	MAX_VPG_disp
	Sw	1, LST
VAR PARENT__u, q
	La	1, STANDARD.BUG1_AGGREGATE_L1.PAGE_IDX.use__info
	Sa	1, PARENT__u
end namespace

					; VPG_NUM INTEGER SUBTYPE INFO
VPG_NUM = 'VPG_NUM'
namespace VPG_NUM
VAR use__info, q
VAR SIZ, d
	LVA	1, SIZ
	Sa	1, use__info
VAR FST, w
VAR LST, w
	LI	16
	Sd	1, SIZ
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	1
	Sw	1, FST
	Lw 1,	MAX_VPG_disp
	Sw	1, LST
VAR PARENT__u, q
	La	1, STANDARD.BUG1_AGGREGATE_L1.PAGE_IDX.use__info
	Sa	1, PARENT__u
end namespace

					; RPG_IDX TYPE RANGE INFO
RPG_IDX = 'RPG_IDX'
namespace RPG_IDX
VAR use__info, q
VAR SIZ, d
	LVA	1, SIZ
	Sa	1, use__info
VAR FST, d
VAR LST, d
	LI	32
	Sd	1, SIZ
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	0
	Sd	1, FST
; CODE_NUMERIC_LITERAL DN_UNIVERSAL_INTEGER
	LI	50
	Sd	1, LST
end namespace
ASSOC_PAGE = 'ASSOC_PAGE'
namespace ASSOC_PAGE			; array var constrained array type info
VAR use__info, q
VAR SIZ, d
	LVA	1, SIZ
	Sa	1, use__info
VAR COMP_SIZ, d
VAR FST_1, d
VAR LST_1, d
	LI	32
	Sd	1, COMP_SIZ
	Ld	1, COMP_SIZ
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	1
	Sd	1, FST_1
	Lw 1,	MAX_VPG_disp
	Sd	1, LST_1
	Ld	1, LST_1
	INC
	Ld	1, FST_1
	SUB
	MUL
	Sd	1, SIZ
  virtual at 4
COMP_SIZ = $
	rd 1 
FST_1 = $
	rd 1 
LST_1 = $
	rd 1 
  end virtual
end namespace
VAR ASSOC_PAGE_disp, q			; variable array : pointeur aux data
VAR ASSOC_PAGE__u, q			; variable array : useinfo pointeur au rec info
	La 1, ASSOC_PAGE.use__info
	Sa	1, ASSOC_PAGE__u			; array info ptr at __u
	Ld	1, ASSOC_PAGE.SIZ
	LI	8
	DIV
	CO_VAR
	Sa	1, ASSOC_PAGE_disp			; array data ptr at _disp
					; array data aggregate
	La	1, ASSOC_PAGE_disp
VAR	CNT_ANON_13_57, d
	LI	255
	Sd 1,	CNT_ANON_13_57
ANON_13_57:
	DUP
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	0
	Sd
	LI	4
	ADD
	LI	0
	Ld 1,	CNT_ANON_13_57
	DEC
	CEQ
	BF	ANON_13_57
	DROP

					;    end elab
begin:					;---------- BDY INSTRUCTIONS
	La  1,	ASSOC_PAGE_disp
VAR	CNT_ANON_16_24, d
	LI	255
	Sd 1,	CNT_ANON_16_24
ANON_16_24:
	DUP
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	0
	Sd
	LI	4
	ADD
	LI	0
	Ld 1,	CNT_ANON_16_24
	DEC
	CEQ
	BF	ANON_16_24
	DROP
ret_lbl:
	UNLINK 1
	RTD
excep:
endPRO					;---------- end PRO BUG1_AGGREGATE
