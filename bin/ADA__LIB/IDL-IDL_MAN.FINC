if ~ definite UNCHECKED_CONVERSION
include 'UNCHECKED_CONVERSION.FINC'
end if
IDL_MAN = 'IDL_MAN'
namespace IDL_MAN				;---------- PACKAGE
elab_spec:				;    SPEC ELAB


					; ARITIES ENUMERATION TYPE INFO
ARITIES = 'ARITIES'
namespace ARITIES
VAR use__info, q
BEGIN_BLOC_DEF
db 0, 7, "NULLARY"
db 1, 5, "UNARY"
db 2, 6, "BINARY"
db 3, 7, "TERNARY"
db 4, 9, "ARBITRARY"
END_BLOC_DEF
IMAGES	BYTES_BLOC
CST LST, d, 4
CST FST, d, 0
CST SIZ, d, 8	; SIZ en bits !
postpone
  align_q
end postpone
	LCA	SIZ
	Sa	0, use__info
end namespace
VAR TREE_FALSE_disp, q			; variable record : pointeur aux data record
VAR TREE_FALSE__u, q			; variable record : pointeur aux useinfo
VAR TREE_FALSE__dat, STANDARD.IDL.TREE.size
	LVA	0, TREE_FALSE__dat
	Sa	0, TREE_FALSE_disp			; record fin
	LVA	0, STANDARD.IDL.TREE.SIZ
	Sa	0, TREE_FALSE__u
; CODE_VC_NAME DN_CONSTANT_ID
	La 0, TREE_FALSE_disp
					; Assign_represented_record_aggregate size 32 bits
	DUP
	LI	0
					; pack PT range 0 .. 1 width 2
	LI	3
	LI	0
	LI	2
	BFI
					; pack NOTY range 24 .. 31 width 8
	LI	3
	LI	24
	LI	8
	BFI
					; pack ABSS range 9 .. 23 width 15
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	0
	LI	9
	LI	15
	BFI
					; pack NSIZ range 2 .. 8 width 7
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	0
	LI	2
	LI	7
	BFI
	Sd
	DROP

VAR TREE_TRUE_disp, q			; variable record : pointeur aux data record
VAR TREE_TRUE__u, q				; variable record : pointeur aux useinfo
VAR TREE_TRUE__dat, STANDARD.IDL.TREE.size
	LVA	0, TREE_TRUE__dat
	Sa	0, TREE_TRUE_disp			; record fin
	LVA	0, STANDARD.IDL.TREE.SIZ
	Sa	0, TREE_TRUE__u
; CODE_VC_NAME DN_CONSTANT_ID
	La 0, TREE_TRUE_disp
					; Assign_represented_record_aggregate size 32 bits
	DUP
	LI	0
					; pack PT range 0 .. 1 width 2
	LI	3
	LI	0
	LI	2
	BFI
					; pack NOTY range 24 .. 31 width 8
	LI	4
	LI	24
	LI	8
	BFI
					; pack ABSS range 9 .. 23 width 15
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	1
	LI	9
	LI	15
	BFI
					; pack NSIZ range 2 .. 8 width 7
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	0
	LI	2
	LI	7
	BFI
	Sd
	DROP

VAR TREE_BINARY_ZERO_disp, q			; variable record : pointeur aux data record
VAR TREE_BINARY_ZERO__u, q			; variable record : pointeur aux useinfo
VAR TREE_BINARY_ZERO__dat, STANDARD.IDL.TREE.size
