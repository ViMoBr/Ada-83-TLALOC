	Sw  1,	FREE_IDX_disp

VAR NB_FREE_disp, w				; variable entiere
	LI	 127
; CODE CONVERSION SOURCE DN_INTEGER TARGET DN_INTEGER
	Lw 1,	FREE_IDX_disp
	SUB
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	1
	ADD
	Sw  1,	NB_FREE_disp

VAR NB_REQUIS_disp, w			; variable entiere
	Lw  1,	-NB_ATTR_ofs
; CODE CONVERSION SOURCE DN_INTEGER TARGET DN_INTEGER
; CODE_NUMERIC_LITERAL DN_INTEGER
