; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	1
	Sb  2,	IL110_disp
VAR	LMT_IL110_disp, b			; limite boucle LOOP__7
	ULb 1,	STANDARD.IDL.IDL_MAN.STORE_TEXT_L39.NB_TREES_disp
	Sb  2,	LMT_IL110_disp
	ULb  2,	IL110_disp				; test null range LOOP__7
	ULb  2,	LMT_IL110_disp
	CGT
	BT	L109
LOOP__7:					; corps boucle LOOP__7
	La	 0, STANDARD.IDL.PAGE_MAN.PAG_disp		; array data start address on stack
	ULd 0,	STANDARD.IDL.PAGE_MAN.CUR_RP_disp
	DUP
	LId	0, STANDARD.IDL.PAGE_MAN.PAG__u, STANDARD.IDL.PAGE_MAN._PAG__type.FST_1
	CLT
	BT	STANDARD.ce_raise_
	DUP
	LId	0, STANDARD.IDL.PAGE_MAN.PAG__u, STANDARD.IDL.PAGE_MAN._PAG__type.LST_1
	CGT
	BT	STANDARD.ce_raise_
	LId	0, STANDARD.IDL.PAGE_MAN.PAG__u, STANDARD.IDL.PAGE_MAN._PAG__type.FST_1	; (index - FST_1) * SIZ_1
	SUB
	LId	0, STANDARD.IDL.PAGE_MAN.PAG__u, STANDARD.IDL.PAGE_MAN._PAG__type.COMP_SIZ
	LI	8
	DIV
	MUL
	ADD					; add offset to start address
	Lq	, STANDARD.IDL.PAGE_MAN._RPG_DATA.DATA
	ULb 2,	START_disp
	ULb 2,	IL110_disp
	ADD
	DUP
	Ld	 0, STANDARD.IDL.PAGE_MAN._SECTOR._FST_1
	CLT
	BT	STANDARD.ce_raise_
	DUP
	Ld	 0, STANDARD.IDL.PAGE_MAN._SECTOR._LST_1
	CGT
	BT	STANDARD.ce_raise_
	Ld	 0, STANDARD.IDL.PAGE_MAN._SECTOR._FST_1
	SUB
	Ld	 0, STANDARD.IDL.PAGE_MAN._SECTOR._COMP_SIZ
	LI	8
	DIV
	MUL
	ADD
	LI	STANDARD.IDL._TREE.size
	La	 2, STANDARD.IDL.IDL_MAN.STORE_TEXT_L39.BLOCK__6.TTR_disp	; array data start address on stack
	ULb 2,	IL110_disp
	DUP
	LId	2, STANDARD.IDL.IDL_MAN.STORE_TEXT_L39.BLOCK__6.TTR__u, STANDARD.IDL.IDL_MAN.STORE_TEXT_L39.BLOCK__6._TTREES.FST_1
	CLT
	BT	STANDARD.ce_raise_
	DUP
	LId	2, STANDARD.IDL.IDL_MAN.STORE_TEXT_L39.BLOCK__6.TTR__u, STANDARD.IDL.IDL_MAN.STORE_TEXT_L39.BLOCK__6._TTREES.LST_1
	CGT
	BT	STANDARD.ce_raise_
	LId	2, STANDARD.IDL.IDL_MAN.STORE_TEXT_L39.BLOCK__6.TTR__u, STANDARD.IDL.IDL_MAN.STORE_TEXT_L39.BLOCK__6._TTREES.FST_1	; (index - FST_1) * SIZ_1
	SUB
	LId	2, STANDARD.IDL.IDL_MAN.STORE_TEXT_L39.BLOCK__6.TTR__u, STANDARD.IDL.IDL_MAN.STORE_TEXT_L39.BLOCK__6._TTREES.COMP_SIZ
	LI	8
	DIV
	MUL
	ADD					; add offset to start address
	BLKMOV
	ULb  2,	IL110_disp				; test de sortie LOOP__7
	ULb  2,	LMT_IL110_disp
	CEQ
	BT	L109
	ULb  2,	IL110_disp				; mise a jour compteur LOOP__7
	INC
	Sb  2,	IL110_disp
	BRA	LOOP__7				; iteration suivante LOOP__7
L109:					; post loop LOOP__7
	La	 0, STANDARD.IDL.PAGE_MAN.PAG_disp		; array data start address on stack
	ULd 0,	STANDARD.IDL.PAGE_MAN.CUR_RP_disp
	DUP
	LId	0, STANDARD.IDL.PAGE_MAN.PAG__u, STANDARD.IDL.PAGE_MAN._PAG__type.FST_1
	CLT
	BT	STANDARD.ce_raise_
	DUP
	LId	0, STANDARD.IDL.PAGE_MAN.PAG__u, STANDARD.IDL.PAGE_MAN._PAG__type.LST_1
	CGT
	BT	STANDARD.ce_raise_
	LId	0, STANDARD.IDL.PAGE_MAN.PAG__u, STANDARD.IDL.PAGE_MAN._PAG__type.FST_1	; (index - FST_1) * SIZ_1
	SUB
	LId	0, STANDARD.IDL.PAGE_MAN.PAG__u, STANDARD.IDL.PAGE_MAN._PAG__type.COMP_SIZ
	LI	8
	DIV
	MUL
	ADD					; add offset to start address
	LVA	, STANDARD.IDL.PAGE_MAN._RPG_DATA.CHANGED
	LI	1
	Sb
; CODE_RETURN : EXPR TYPE = DN_RECORD  VUE COMPLETE = DN_RECORD
	La   1,	-result__ofs
	La  ,  0
	LI	STANDARD.IDL._TREE.size
	LVA 2,	TT_disp
	La  ,  0
	BLKMOV
	UNLINK 2
	BRA ret_lbl
	UNLINK 2
endPRO
ret_lbl:
	UNLINK 1
	RTD	prm_siz-8
excep:
endPRO					;---------- end PRO STORE_TEXT
end if

