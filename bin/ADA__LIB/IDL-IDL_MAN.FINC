; CODE_VC_NAME DN_VARIABLE_ID
	La 0, TREE_HASH_disp
					; Assign_represented_record_aggregate size 32 bits
	DUP
	LI	0
					; pack PT range 0 .. 1 width 2
	LI	0
	LI	0
	LI	2
	BFI
					; pack TY range 24 .. 31 width 8
	LI	10
	LI	24
	LI	8
	BFI
					; pack PG range 9 .. 23 width 15
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	2
	LI	9
	LI	15
	BFI
					; pack LN range 2 .. 8 width 7
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	0
	LI	2
	LI	7
	BFI
	Sd
	DROP


if defined ARITY_L1_
PRO	ARITY_L1				;---------- PRO ARITY
PRMS					;    debut parametrage
	PRM T_ofs				; in
	PRM result__ofs				; resultat de fonction
endPRMS					;    fin parametrage
ELB 1					;    BODY ELAB
					;    end elab
begin:					;---------- BDY INSTRUCTIONS
; CODE_RETURN : EXPR TYPE = DN_ENUMERATION
	La	 0, N_SPEC_disp				; array data start address on stack
	La 1, -T_ofs
	La	-1, 0
	Ld
	LI	24
	LI	8
	UBFX
	LId	0, N_SPEC__u, STANDARD.IDL.IDL_TBL.NODE_SPECIF_TABLE.FST_1	; (index - FST_1) * SIZ_1
	SUB
	LId	0, N_SPEC__u, STANDARD.IDL.IDL_TBL.NODE_SPECIF_TABLE.COMP_SIZ
	LI	8
	DIV
	MUL
	ADD					; add offset to start address
	Lb	, STANDARD.IDL.IDL_TBL.NODE_SPECIF.NS_ARITY
	Sb  1,	-result__ofs
	BRA ret_lbl
ret_lbl:
	UNLINK 1
	RTD	prm_siz-8
excep:
endPRO					;---------- end PRO ARITY
end if

