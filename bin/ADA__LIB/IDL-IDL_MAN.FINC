	Ld 0,	STANDARD.IDL.PAGE_MAN.CUR_RP_disp
	LId	0, PAG__u, STANDARD.IDL.PAGE_MAN.PAG.FST_1	; (index - FST_1) * SIZ_1
	SUB
	LId	0, PAG__u, STANDARD.IDL.PAGE_MAN.PAG.COMP_SIZ
	LI	8
	DIV
	MUL
	ADD					; add offset to start address
	Lq	, STANDARD.IDL.PAGE_MAN.RPG_DATA.DATA
	Lw 1,	FREE_IDX_disp
; CODE CONVERSION SOURCE DN_INTEGER TARGET DN_INTEGER
	Ld	 0, STANDARD.IDL.PAGE_MAN.SECTOR._FST_1
	SUB
	Ld	 0, STANDARD.IDL.PAGE_MAN.SECTOR._COMP_SIZ
	LI	8
	DIV
	MUL
	ADD
					; Assign_represented_record_aggregate size 32 bits
	DUP
	LI	0
					; pack PT range 0 .. 1 width 2
	LI	3
	LI	0
	LI	2
	BFI
					; pack NOTY range 24 .. 31 width 8
	Lb  1,	-NN_ofs
	LI	24
	LI	8
	BFI
					; pack ABSS range 9 .. 23 width 15
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	0
	LI	9
	LI	15
	BFI
					; pack NSIZ range 2 .. 8 width 7
	Lw  1,	-NB_ATTR_ofs
	LI	2
	LI	7
	BFI
	Sd
	DROP
	La	 0, PAG_disp				; array data start address on stack
	Ld 0,	STANDARD.IDL.PAGE_MAN.CUR_RP_disp
	LId	0, PAG__u, STANDARD.IDL.PAGE_MAN.PAG.FST_1	; (index - FST_1) * SIZ_1
	SUB
