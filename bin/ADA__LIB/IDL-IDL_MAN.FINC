	ADD
	La  1, ANON_34_66_L31_D_len
	La  1, ANON_34_66_L31_D_data
	BLKMOV
	LVA 1, ANON_34_14_L31_R_disp
	CALL	STANDARD.TEXT_IO. ,PUT_LINE_L60
ret_lbl:
	UNLINK 1
	RTD	prm_siz-8
excep:
endPRO					;---------- end PRO SON_1
end if

