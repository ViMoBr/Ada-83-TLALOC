					; doublet resultat record anonyme
	La  1,	-T_ofs
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	1
	CALL	STANDARD.IDL.IDL_MAN. ,DABS_L15
	La  ,  0
	BLKMOV
	BRA ret_lbl
	BRA	L29
L30:
L29:					; post if
; CODE & concat STRING
VAR	ANON_34_14_data, q
