if ~ definite UNCHECKED_CONVERSION
include 'UNCHECKED_CONVERSION.FINC'
end if
IDL_MAN = 'IDL_MAN'
namespace IDL_MAN				;---------- PACKAGE
elab_spec:				;    SPEC ELAB


					; ARITIES ENUMERATION TYPE INFO
ARITIES = 'ARITIES'
namespace ARITIES
VAR use__info, q
BEGIN_BLOC_DEF
db 0, 7, "NULLARY"
db 1, 5, "UNARY"
db 2, 6, "BINARY"
db 3, 7, "TERNARY"
db 4, 9, "ARBITRARY"
END_BLOC_DEF
IMAGES	BYTES_BLOC
CST LST, d, 4
CST FST, d, 0
CST SIZ, d, 8	; SIZ en bits !
postpone
  align_q
end postpone
	LCA	SIZ
	Sa	0, use__info
end namespace
VAR TREE_FALSE_disp, q			; variable record : pointeur aux data record
VAR TREE_FALSE__u, q			; variable record : pointeur aux useinfo
VAR TREE_FALSE__dat, STANDARD.IDL.TREE.size
	LVA	0, TREE_FALSE__dat
	Sa	0, TREE_FALSE_disp			; record fin
	LVA	0, STANDARD.IDL.TREE.SIZ
	Sa	0, TREE_FALSE__u
; CODE_VC_NAME DN_CONSTANT_ID
	La 0, TREE_FALSE_disp
					; Assign_record_aggregate type DN_RECORD
	DROP

VAR TREE_TRUE_disp, q			; variable record : pointeur aux data record
VAR TREE_TRUE__u, q				; variable record : pointeur aux useinfo
VAR TREE_TRUE__dat, STANDARD.IDL.TREE.size
	LVA	0, TREE_TRUE__dat
	Sa	0, TREE_TRUE_disp			; record fin
	LVA	0, STANDARD.IDL.TREE.SIZ
	Sa	0, TREE_TRUE__u
; CODE_VC_NAME DN_CONSTANT_ID
	La 0, TREE_TRUE_disp
					; Assign_record_aggregate type DN_RECORD
	DROP

VAR TREE_BINARY_ZERO_disp, q			; variable record : pointeur aux data record
VAR TREE_BINARY_ZERO__u, q			; variable record : pointeur aux useinfo
VAR TREE_BINARY_ZERO__dat, STANDARD.IDL.TREE.size
	LVA	0, TREE_BINARY_ZERO__dat
	Sa	0, TREE_BINARY_ZERO_disp			; record fin
	LVA	0, STANDARD.IDL.TREE.SIZ
	Sa	0, TREE_BINARY_ZERO__u
; CODE_VC_NAME DN_CONSTANT_ID
	La 0, TREE_BINARY_ZERO_disp
					; Assign_record_aggregate type DN_RECORD
	DROP

VAR PRAGMA_CONTEXT_disp, q			; variable record : pointeur aux data record
VAR PRAGMA_CONTEXT__u, q			; variable record : pointeur aux useinfo
VAR PRAGMA_CONTEXT__dat, STANDARD.IDL.TREE.size
	LVA	0, PRAGMA_CONTEXT__dat
	Sa	0, PRAGMA_CONTEXT_disp			; record fin
	LVA	0, STANDARD.IDL.TREE.SIZ
	Sa	0, PRAGMA_CONTEXT__u
; CODE_VC_NAME DN_VARIABLE_ID
	La  0, PRAGMA_CONTEXT_disp
	LI	STANDARD.IDL.TREE.size
	LVA 0,	STANDARD.IDL.TREE_VOID_disp
	La  ,  0
	BLKMOV

					;    BODY ELAB
VAR TREE_HASH_disp, q			; variable record : pointeur aux data record
VAR TREE_HASH__u, q				; variable record : pointeur aux useinfo
VAR TREE_HASH__dat, STANDARD.IDL.TREE.size
	LVA	0, TREE_HASH__dat
	Sa	0, TREE_HASH_disp			; record fin
	LVA	0, STANDARD.IDL.TREE.SIZ
	Sa	0, TREE_HASH__u
; CODE_VC_NAME DN_VARIABLE_ID
	La 0, TREE_HASH_disp
					; Assign_record_aggregate type DN_RECORD
	DROP


if defined ARITY_L1_
PRO	ARITY_L1				;---------- PRO ARITY
PRMS					;    debut parametrage
	PRM T_ofs				; in
	PRM result__ofs				; resultat de fonction
endPRMS					;    fin parametrage
ELB 1					;    BODY ELAB
					;    end elab
begin:					;---------- BDY INSTRUCTIONS
; CODE_RETURN : EXPR TYPE = DN_ENUMERATION
	La	 0, N_SPEC_disp				; array data start address on stack
	La 1, -T_ofs
	LIb	, 0, STANDARD.IDL.TREE.TY
	LId	0, N_SPEC__u, STANDARD.IDL.IDL_TBL.NODE_SPECIF_TABLE.FST_1	; (index - FST_1) * SIZ_1
	SUB
	LId	0, N_SPEC__u, STANDARD.IDL.IDL_TBL.NODE_SPECIF_TABLE.COMP_SIZ
	LI	8
	DIV
	MUL
	ADD					; add offset to start address
	Lb	, STANDARD.IDL.IDL_TBL.NODE_SPECIF.NS_ARITY
	Sb  1,	-result__ofs
	BRA ret_lbl
ret_lbl:
	UNLINK 1
	RTD	prm_siz-8
excep:
endPRO					;---------- end PRO ARITY
end if

