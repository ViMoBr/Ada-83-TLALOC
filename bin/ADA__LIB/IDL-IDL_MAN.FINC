if defined MAKE_L47_
PRO	MAKE_L47				;---------- PRO MAKE
PRMS					;    debut parametrage
	PRM NN_ofs				; in
	PRM NB_ATTR_ofs				; in
	PRM AR_ofs				; in
	PRM result__ofs				; resultat de fonction
endPRMS					;    fin parametrage
ELB 1					;    BODY ELAB
VAR FREE_IDX_disp, w			; variable entiere
	La	 0, AREA_disp				; array data start address on stack
	Ld  1,	-AR_ofs
	LId	0, AREA__u, STANDARD.IDL.PAGE_MAN._AREA.FST_1	; (index - FST_1) * SIZ_1
	SUB
	LId	0, AREA__u, STANDARD.IDL.PAGE_MAN._AREA.COMP_SIZ
	LI	8
	DIV
	MUL
	ADD					; add offset to start address
	Lw	, STANDARD.IDL.PAGE_MAN._AREA_DATA.FREE_LINE
	Sw  1,	FREE_IDX_disp

VAR NB_FREE_disp, w				; variable entiere
	LI	 127
; CODE CONVERSION SOURCE DN_INTEGER TARGET DN_INTEGER
	Lw 1,	FREE_IDX_disp
	SUB
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	1
	ADD
	Sw  1,	NB_FREE_disp

VAR NB_REQUIS_disp, w			; variable entiere
	Lw  1,	-NB_ATTR_ofs
; CODE CONVERSION SOURCE DN_INTEGER TARGET DN_INTEGER
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	1
	ADD
	Sw  1,	NB_REQUIS_disp

					;    end elab
begin:					;---------- BDY INSTRUCTIONS
	Lw 1,	NB_REQUIS_disp
	Ld  1,	-AR_ofs
	CALL	STANDARD.IDL.PAGE_MAN. ,ALLOC_PAGE_L18
	La	 0, AREA_disp				; array data start address on stack
	Ld  1,	-AR_ofs
	LId	0, AREA__u, STANDARD.IDL.PAGE_MAN._AREA.FST_1	; (index - FST_1) * SIZ_1
	SUB
	LId	0, AREA__u, STANDARD.IDL.PAGE_MAN._AREA.COMP_SIZ
	LI	8
	DIV
	MUL
	ADD					; add offset to start address
	Lw	, STANDARD.IDL.PAGE_MAN._AREA_DATA.FREE_LINE
	Sw  1,	FREE_IDX_disp
	La	 0, AREA_disp				; array data start address on stack
	Ld  1,	-AR_ofs
	LId	0, AREA__u, STANDARD.IDL.PAGE_MAN._AREA.FST_1	; (index - FST_1) * SIZ_1
	SUB
	LId	0, AREA__u, STANDARD.IDL.PAGE_MAN._AREA.COMP_SIZ
	LI	8
	DIV
	MUL
	ADD					; add offset to start address
	Lw	, STANDARD.IDL.PAGE_MAN._AREA_DATA.VP
	Sw  0,	CUR_VP_disp
	La	 0, ASSOC_PAGE_disp			; array data start address on stack
	Lw 0,	STANDARD.IDL.PAGE_MAN.CUR_VP_disp
	LId	0, ASSOC_PAGE__u, STANDARD.IDL.PAGE_MAN._ASSOC_PAGE.FST_1	; (index - FST_1) * SIZ_1
	SUB
	LId	0, ASSOC_PAGE__u, STANDARD.IDL.PAGE_MAN._ASSOC_PAGE.COMP_SIZ
	LI	8
	DIV
	MUL
	ADD					; add offset to start address
	Ld
	Sd  0,	CUR_RP_disp
	La	 0, AREA_disp				; array data start address on stack
	Ld  1,	-AR_ofs
	LId	0, AREA__u, STANDARD.IDL.PAGE_MAN._AREA.FST_1	; (index - FST_1) * SIZ_1
	SUB
	LId	0, AREA__u, STANDARD.IDL.PAGE_MAN._AREA.COMP_SIZ
	LI	8
	DIV
	MUL
	ADD					; add offset to start address
	LVA	, STANDARD.IDL.PAGE_MAN._AREA_DATA.FREE_LINE
	Lw 1,	FREE_IDX_disp
	Lw 1,	NB_REQUIS_disp
	ADD
	Sw
	La	 0, PAG_disp				; array data start address on stack
	Ld 0,	STANDARD.IDL.PAGE_MAN.CUR_RP_disp
	LId	0, PAG__u, STANDARD.IDL.PAGE_MAN._PAG.FST_1	; (index - FST_1) * SIZ_1
	SUB
	LId	0, PAG__u, STANDARD.IDL.PAGE_MAN._PAG.COMP_SIZ
	LI	8
	DIV
	MUL
	ADD					; add offset to start address
	Lq	, STANDARD.IDL.PAGE_MAN._RPG_DATA.DATA
	Lw 1,	FREE_IDX_disp
; CODE CONVERSION SOURCE DN_INTEGER TARGET DN_INTEGER
	Ld	 0, STANDARD.IDL.PAGE_MAN._SECTOR._FST_1
	SUB
	Ld	 0, STANDARD.IDL.PAGE_MAN._SECTOR._COMP_SIZ
	LI	8
	DIV
	MUL
	ADD
					; Assign_represented_record_aggregate size 32 bits
	DUP
	LI	0
					; pack PT range 0 .. 1 width 2
	LI	3
	LI	0
	LI	2
	BFI
					; pack NOTY range 24 .. 31 width 8
	Lb  1,	-NN_ofs
	LI	24
	LI	8
	BFI
					; pack ABSS range 9 .. 23 width 15
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	0
	LI	9
	LI	15
	BFI
					; pack NSIZ range 2 .. 8 width 7
	Lw  1,	-NB_ATTR_ofs
	LI	2
	LI	7
	BFI
	Sd
	DROP
	La	 0, PAG_disp				; array data start address on stack
	Ld 0,	STANDARD.IDL.PAGE_MAN.CUR_RP_disp
	LId	0, PAG__u, STANDARD.IDL.PAGE_MAN._PAG.FST_1	; (index - FST_1) * SIZ_1
	SUB
	LId	0, PAG__u, STANDARD.IDL.PAGE_MAN._PAG.COMP_SIZ
	LI	8
	DIV
	MUL
	ADD					; add offset to start address
	LVA	, STANDARD.IDL.PAGE_MAN._RPG_DATA.CHANGED
	LI	1
	Sb
; CODE_RETURN : EXPR TYPE = DN_RECORD
	La   1,	-result__ofs
	La  ,  0
					; Assign_represented_record_aggregate size 32 bits
	DUP
	LI	0
					; pack PT range 0 .. 1 width 2
	LI	0
	LI	0
	LI	2
	BFI
					; pack TY range 24 .. 31 width 8
	Lb  1,	-NN_ofs
	LI	24
	LI	8
	BFI
					; pack PG range 9 .. 23 width 15
	La	 0, AREA_disp				; array data start address on stack
	Ld  1,	-AR_ofs
	LId	0, AREA__u, STANDARD.IDL.PAGE_MAN._AREA.FST_1	; (index - FST_1) * SIZ_1
	SUB
	LId	0, AREA__u, STANDARD.IDL.PAGE_MAN._AREA.COMP_SIZ
	LI	8
	DIV
	MUL
	ADD					; add offset to start address
	Lw	, STANDARD.IDL.PAGE_MAN._AREA_DATA.VP
	LI	9
	LI	15
	BFI
					; pack LN range 2 .. 8 width 7
	Lw 1,	FREE_IDX_disp
; CODE CONVERSION SOURCE DN_INTEGER TARGET DN_INTEGER
	LI	2
	LI	7
	BFI
	Sd
	DROP
	BRA ret_lbl
; CHOICE_EXP in EXCEPTIONS todo
	BRA	L153
