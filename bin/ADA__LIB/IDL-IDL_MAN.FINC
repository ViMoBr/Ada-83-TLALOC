	LI	0					; lieu resultat sur pile
	ULw 0,	STANDARD.IDL.PAGE_MAN.CUR_VP_disp
	DUP
	ULw	0, STANDARD.IDL.PAGE_MAN._VPG_NUM.FST
	CLT
	BT	STANDARD.ce_raise_
	DUP
	ULw	0, STANDARD.IDL.PAGE_MAN._VPG_NUM.LST
	CGT
