	LI	8
	DIV
	MUL
	ADD					; add offset to start address
	LVA	, STANDARD.IDL.PAGE_MAN.RPG_DATA.CHANGED
	LI	1
	Sb
; CODE_RETURN : EXPR TYPE = DN_RECORD
	La   1,	-result__ofs
	La  ,  0
					; Assign_represented_record_aggregate size 32 bits
	DUP
	LI	0
					; pack PT range 0 .. 1 width 2
	LI	0
	LI	0
	LI	2
	BFI
					; pack TY range 24 .. 31 width 8
	Lb  1,	-NN_ofs
	LI	24
	LI	8
	BFI
					; pack PG range 9 .. 23 width 15
	La	 0, AREA_disp				; array data start address on stack
	Ld  1,	-AR_ofs
	LId	0, AREA__u, STANDARD.IDL.PAGE_MAN.AREA.FST_1	; (index - FST_1) * SIZ_1
	SUB
	LId	0, AREA__u, STANDARD.IDL.PAGE_MAN.AREA.COMP_SIZ
	LI	8
	DIV
	MUL
	ADD					; add offset to start address
	Lw	, STANDARD.IDL.PAGE_MAN.AREA_DATA.VP
	LI	9
	LI	15
	BFI
					; pack LN range 2 .. 8 width 7
	Lw 1,	FREE_IDX_disp
; CODE CONVERSION SOURCE DN_INTEGER TARGET DN_INTEGER
	LI	2
	LI	7
	BFI
	Sd
	DROP
	BRA ret_lbl
; CHOICE_EXP in EXCEPTIONS todo
	BRA	L123
