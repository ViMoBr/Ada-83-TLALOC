	LCA	ANON_34_14.data_ptr
	DUP
	La  ,  0
	Sa  1, ANON_34_14_data
	La  ,  8
	Sa  1, ANON_34_14_info
	LId 1, ANON_34_14_info, STRING.LST_1
	LId 1, ANON_34_14_info, STRING.FST_1
	SUB
	INC
	Sa  1, ANON_34_14_len
VAR	ANON_34_66_disp, q
VAR	ANON_34_66__u,   q
namespace ANON_34_66_info
  VAR SIZ, d
  VAR _COMP_SIZ, d
  VAR _FST_1, d
  VAR _LST_1, d
end namespace
	LVA 1, ANON_34_66_info.SIZ
	Sa  1, ANON_34_66__u
	LVA 1, ANON_34_66_disp
	La  1,	-T_ofs
	CALL	STANDARD.IDL.IDL_MAN. ,NODE_REP_L28
	DUP
	La  ,  0
	Sa  1, ANON_34_66_data
	La  ,  8
	Sa  1, ANON_34_66_info
	LId 1, ANON_34_66_info, STRING.LST_1
	LId 1, ANON_34_66_info, STRING.FST_1
	SUB
	INC
	Sa  1, ANON_34_66_len
	La  1, ANON_34_14_len
	La  1, ANON_34_66_len
	ADD
	CO_VAR
	Sa  1, ANON_34_14_disp
	LI	1
	Sd  1, ANON_34_14_info._FST_1
	La  1, ANON_34_14_len
	La  1, ANON_34_66_len
	ADD
	Sd  1, ANON_34_14_info._LST_1
	LI	8
	Sd  1, ANON_34_14_info._COMP_SIZ
	La  1, ANON_34_14_len
	La  1, ANON_34_66_len
	ADD
	LI	8
	MUL
	Sd  1, ANON_34_14_info.SIZ
	LVA 1, ANON_34_14_info.SIZ
	Sa  1, ANON_34_14__u
	La  1, ANON_34_14_disp
	La  1, ANON_34_14_len
	La  1, ANON_34_14_data
	BLKMOV
	La  1, ANON_34_14_disp
	La  1, ANON_34_14_len
	ADD
	La  1, ANON_34_66_len
	La  1, ANON_34_66_data
	BLKMOV
	LVA 1, ANON_34_14_disp
	CALL	STANDARD.TEXT_IO. ,PUT_LINE_L60
ret_lbl:
	UNLINK 1
	RTD	prm_siz-8
excep:
endPRO					;---------- end PRO SON_1
end if

