	SUB
	LId	0, ASSOC_PAGE__u, STANDARD.IDL.PAGE_MAN.ASSOC_PAGE.COMP_SIZ
	LI	8
	DIV
	MUL
	ADD					; add offset to start address
	Ld
	Sd  0,	CUR_RP_disp
	La	 0, AREA_disp				; array data start address on stack
	Ld  1,	-AR_ofs
	LId	0, AREA__u, STANDARD.IDL.PAGE_MAN.AREA.FST_1	; (index - FST_1) * SIZ_1
	SUB
	LId	0, AREA__u, STANDARD.IDL.PAGE_MAN.AREA.COMP_SIZ
	LI	8
	DIV
	MUL
	ADD					; add offset to start address
	LVA	, STANDARD.IDL.PAGE_MAN.AREA_DATA.FREE_LINE
	Lw 1,	FREE_IDX_disp
	Lw 1,	NB_REQUIS_disp
	ADD
