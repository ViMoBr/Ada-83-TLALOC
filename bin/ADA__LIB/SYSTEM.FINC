SYSTEM = 'SYSTEM'
namespace SYSTEM				;---------- PACKAGE DECLARATION
					; CODE_PACKAGE_SPEC

					; _NAME ENUMERATION TYPE INFO
_NAME = '_NAME'
namespace _NAME
VAR use__info, q
BEGIN_BLOC_DEF
db 0, 6, "X86_64"
END_BLOC_DEF 8, 0, 0
	; SIZ en bits !
	LCA	SIZ
	Sa	0, use__info
end namespace
VAR SYSTEM_NAME_disp, b			; variable entiere
	LI	0
	Sb  0,	SYSTEM_NAME_disp


					; _PRIORITY INTEGER SUBTYPE INFO
_PRIORITY = '_PRIORITY'
namespace _PRIORITY
VAR use__info, q
VAR SIZ, d
	LVA	0, SIZ
	Sa	0, use__info
VAR FST, d
VAR LST, d
	LI	32
	Sd	0, SIZ
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	0
	Sd	0, FST
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	10
	Sd	0, LST
VAR PARENT__u, q
	La	0, STANDARD._INTEGER.use__info
	Sa	0, PARENT__u
end namespace

					; _ADDRESS INTEGER SUBTYPE INFO
_ADDRESS = '_ADDRESS'
namespace _ADDRESS
VAR use__info, q
VAR SIZ, d
	LVA	0, SIZ
	Sa	0, use__info
VAR FST, q
VAR LST, q
	LI	64
	Sd	0, SIZ
; CODE_NUMERIC_LITERAL DN_UNIVERSAL_INTEGER
	LI	2
; CODE_NUMERIC_LITERAL DN_UNIVERSAL_INTEGER
	LI	63
	DEC
	SHL
	NEG
	Sq	0, FST
; CODE_NUMERIC_LITERAL DN_UNIVERSAL_INTEGER
	LI	2
; CODE_NUMERIC_LITERAL DN_UNIVERSAL_INTEGER
	LI	63
	DEC
	SHL
; CODE_NUMERIC_LITERAL DN_UNIVERSAL_INTEGER
	LI	1
	SUB
	Sq	0, LST
VAR PARENT__u, q
	La	0, STANDARD.SYSTEM._ADDRESS.use__info
	Sa	0, PARENT__u
end namespace
VAR NULL_ADDRESS_disp, q			; variable entiere
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	0
	Sq  0,	NULL_ADDRESS_disp

_SYSTEM = '_SYSTEM'
namespace _SYSTEM				;---------- PACKAGE DECLARATION
; EXC_LBL	L1
end namespace

; EXC_LBL	L2
end namespace

