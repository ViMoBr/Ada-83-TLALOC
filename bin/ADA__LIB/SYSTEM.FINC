SYSTEM = 'SYSTEM'
namespace SYSTEM				;---------- PACKAGE DECLARATION
NAME = 'NAME'
namespace NAME				; NAME ENUMERATION TYPE INFO
BEGIN_BLOC_DEF
db 0, 6, "X86_64"
END_BLOC_DEF
IMAGES	BYTES_BLOC
CST LST, d, 0
CST FST, d, 0
CST SIZ, d, 8	; SIZ en bits !
postpone
  align_q
end postpone
end namespace

VAR SYSTEM_NAME_disp, b			; variable entiere
	LI	0
	Sb  0,	SYSTEM_NAME_disp

PRIORITY = 'PRIORITY'
namespace PRIORITY				; PRIORITY INTEGER SUBTYPE INFO
VAR SIZ, d
end namespace

ADDRESS = 'ADDRESS'
namespace ADDRESS				; ADDRESS INTEGER SUBTYPE INFO
VAR SIZ, d
end namespace

VAR NULL_ADDRESS_disp, q			; variable entiere
	LI	0
	Sq  0,	NULL_ADDRESS_disp

_SYSTEM = '_SYSTEM'
namespace _SYSTEM				;---------- PACKAGE DECLARATION
; EXC_LBL	L1
end namespace

; EXC_LBL	L2
end namespace

