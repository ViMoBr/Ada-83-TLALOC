					; doublet resultat record anonyme
	LVA 2,	DECL_PRIV_disp
	CALL	STANDARD.IDL. ,LIST_L22
	La  ,  0
	BLKMOV

VAR ID_disp, q				; variable record : pointeur aux data record
VAR ID__u, q				; variable record : pointeur aux useinfo
VAR ID__dat, STANDARD.IDL._TREE.size
	LVA	2, ID__dat
	Sa	2, ID_disp				; record fin
	LVA	2, STANDARD.IDL._TREE.SIZ
	Sa	2, ID__u
; CODE_VC_NAME DN_VARIABLE_ID
	LIVA 2, ID_disp, STANDARD.IDL._TREE.PT
	LI	0
	Sb

VAR DEF_disp, q				; variable record : pointeur aux data record
VAR DEF__u, q				; variable record : pointeur aux useinfo
VAR DEF__dat, STANDARD.IDL._TREE.size
	LVA	2, DEF__dat
	Sa	2, DEF_disp				; record fin
	LVA	2, STANDARD.IDL._TREE.SIZ
	Sa	2, DEF__u
; CODE_VC_NAME DN_VARIABLE_ID
	LIVA 2, DEF_disp, STANDARD.IDL._TREE.PT
	LI	0
	Sb

					;    end elab
begin:					;---------- BDY INSTRUCTIONS
LOOP__1:
	LI	0					; lieu resultat sur pile
	LVA 2,	ID_LIST_disp
	CALL	STANDARD.IDL. ,IS_EMPTY_L23
	LI	1
	OUX
	BF	L506
	LVA  2,	ID_disp
	LVA  2,	ID_LIST_disp
	CALL	STANDARD.IDL. ,POP_L24
					; debut if
	La	2, ID_disp
	Ld
	LI	24
	LI	8
	UBFX
	LI	37
	CGE
	LI	38
	La	2, ID_disp
	Ld
	LI	24
	LI	8
	UBFX
	CGE
	ET
	DUP
	BF	L509
	DROP
	LI	9
	CEQ
L509:
	BF	L508
	LVA 2,	DEF_disp
	La
	LI	STANDARD.IDL._TREE.size
	LI	0					; lieu resultat sur pile
	VAR SELARG_L510_disp, q
	VAR SELARG_L510__u, q
	La 1, STANDARD.IDL.SEM_PHASE_L11.SEM_GLOB.INITIAL_H_disp
	Sa	2, SELARG_L510_disp
	La 1, STANDARD.IDL.SEM_PHASE_L11.SEM_GLOB._H_TYPE.use__info
	Sa	2, SELARG_L510__u
	LVA 2, SELARG_L510_disp
	LVA 2,	ID_disp
	CALL	STANDARD.IDL.SEM_PHASE_L11.DEF_UTIL. ,MAKE_DEF_FOR_ID_L52
	La
	BLKMOV
	LVA  0,	STANDARD.IDL.TREE_VOID_disp		; array actual
	LVA 2,	DEF_disp
	LI  169
	CALL	STANDARD.IDL. ,D_L16
	LI  0
	LVA 2,	DEF_disp
	LI  170
	CALL	STANDARD.IDL. ,DB_L18
	BRA	L507
L508:
L507:					; post if
	BRA	LOOP__1
L506:					; post loop LOOP__1
ret_lbl:
	UNLINK 2
	RTD
excep:
endPRO					;---------- end PRO INITIALIZE_PRAGMA_ATTRIBUTE_DEFS
end if

