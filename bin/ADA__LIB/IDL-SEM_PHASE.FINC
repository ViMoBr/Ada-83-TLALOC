					; UDIGIT TYPE RANGE INFO
UDIGIT = 'UDIGIT'
namespace UDIGIT
VAR use__info, q
VAR SIZ, d
	LVA	1, SIZ
	Sa	1, use__info
VAR FST, w
VAR LST, w
	LI	16
	Sd	1, SIZ
; CODE_NUMERIC_LITERAL DN_UNIVERSAL_INTEGER
	LI	00032768
	NEG
	Sw	1, FST
; CODE_NUMERIC_LITERAL DN_UNIVERSAL_INTEGER
	LI	32767
	Sw	1, LST
end namespace

					; array decl constrained array type info
VECTOR_DIGITS = 'VECTOR_DIGITS'
namespace VECTOR_DIGITS
VAR use__info, q
VAR SIZ, d
	LVA	1, SIZ
	Sa	1, use__info
VAR _COMP_SIZ, d
VAR _FST_1, d
VAR _LST_1, d
	LI	16
	Sd	1, _COMP_SIZ
	Ld	1, _COMP_SIZ
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	1
	Sd	1, _FST_1
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	252
	Sd	1, _LST_1
	Ld	1, _LST_1
	Ld	1, _FST_1
	SUB
	INC
	MUL
	Sd	1, SIZ
  virtual at 4
COMP_SIZ = $
	rd 1 
FST_1 = $
	rd 1 
LST_1 = $
	rd 1 
  end virtual
end namespace

					; VECTOR RECORD TYPE INFO
VECTOR = 'VECTOR'
namespace VECTOR
VAR use__info, q
VAR SIZ, d
	LVA	1, SIZ
	Sa	1, use__info
USEINFO 1, L, 	La 0, STANDARD.NATURAL.use__info
USEINFO 1, S, 	La 1, STANDARD.IDL.SEM_PHASE_L11.UNIV_OPS.UDIGIT.use__info
USEINFO 1, D, 	La 1, STANDARD.IDL.SEM_PHASE_L11.UNIV_OPS.VECTOR_DIGITS.use__info
virtual at 0				; calcul des offsets statiques
STATOFS L, 4
STATOFS S, 2
STATOFS D, 504
size = $
end virtual
	LI	 size*8
	Sd	1, SIZ
end namespace
