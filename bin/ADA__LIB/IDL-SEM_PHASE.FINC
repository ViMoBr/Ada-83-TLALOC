if defined INITIALIZE_PRAGMA_ATTRIBUTE_DEFS_L502_
PRO	INITIALIZE_PRAGMA_ATTRIBUTE_DEFS_L502	;---------- PRO INITIALIZE_PRAGMA_ATTRIBUTE_DEFS
ELB 2					;    BODY ELAB
VAR STD_PACK_SYM_disp, q			; variable record : pointeur aux data record
