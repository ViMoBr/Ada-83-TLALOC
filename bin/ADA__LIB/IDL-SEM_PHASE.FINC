					; SU_TYPE RECORD TYPE INFO
SU_TYPE = 'SU_TYPE'
namespace SU_TYPE
VAR use__info, q
VAR SIZ, d
	LVA	1, SIZ
	Sa	1, use__info
USEINFO 1, USED_PACKAGE_LIST, 	La 0, STANDARD.IDL.SEQ_TYPE.use__info
USEINFO 1, INCOMPLETE_TYPE_LIST, 	La 0, STANDARD.IDL.SEQ_TYPE.use__info
USEINFO 1, PRIVATE_TYPE_LIST, 	La 0, STANDARD.IDL.SEQ_TYPE.use__info
virtual at 0				; calcul des offsets statiques
STATOFS USED_PACKAGE_LIST, 8
STATOFS INCOMPLETE_TYPE_LIST, 8
STATOFS PRIVATE_TYPE_LIST, 8
size = $
end virtual
	LI	 size*8
	Sd	1, SIZ
end namespace

					; H_TYPE RECORD TYPE INFO
H_TYPE = 'H_TYPE'
namespace H_TYPE
VAR use__info, q
VAR SIZ, d
	LVA	1, SIZ
	Sa	1, use__info
USEINFO 1, REGION_DEF, 	La 0, STANDARD.IDL.TREE.use__info
USEINFO 1, LEX_LEVEL, 	La 0, STANDARD.NATURAL.use__info
USEINFO 1, IS_IN_SPEC, 	La 0, STANDARD.BOOLEAN.use__info
USEINFO 1, IS_IN_BODY, 	La 0, STANDARD.BOOLEAN.use__info
USEINFO 1, SUBP_SYMREP, 	La 0, STANDARD.IDL.TREE.use__info
USEINFO 1, RETURN_TYPE, 	La 0, STANDARD.IDL.TREE.use__info
USEINFO 1, ENCLOSING_LOOP_ID, 	La 0, STANDARD.IDL.TREE.use__info
virtual at 0				; calcul des offsets statiques
STATOFS REGION_DEF, 4
STATOFS LEX_LEVEL, 4
STATOFS IS_IN_SPEC, 1
STATOFS IS_IN_BODY, 1
STATOFS SUBP_SYMREP, 4
STATOFS RETURN_TYPE, 4
STATOFS ENCLOSING_LOOP_ID, 4
size = $
end virtual
	LI	 size*8
	Sd	1, SIZ
end namespace
