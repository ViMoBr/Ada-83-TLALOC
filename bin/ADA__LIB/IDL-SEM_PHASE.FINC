					; doublet resultat record anonyme
STR STR_L503, "_STANDRD.DCL"			; constante string="_STANDRD.DCL"
	LCA	STR_L503.data_ptr
	CALL	STANDARD.IDL.IDL_MAN. ,STORE_SYM_L40
	La  ,  0
	BLKMOV

VAR STD_PACK_ID_disp, q			; variable record : pointeur aux data record
