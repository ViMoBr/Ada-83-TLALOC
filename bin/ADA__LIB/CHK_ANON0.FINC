PRO	CHK_ANON0_L1				;---------- PRO CHK_ANON0
ELB 1					;    BODY ELAB
VAR N_disp, d				; variable entiere
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	5
	Sd  1,	N_disp

VAR I_disp, d				; variable entiere


					; _DYN INTEGER SUBTYPE INFO
_DYN = '_DYN'
namespace _DYN
VAR use__info, q
VAR SIZ, d
	LVA	1, SIZ
	Sa	1, use__info
VAR FST, d
VAR LST, d
	LI	32
	Sd	1, SIZ
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	1
	Sd	1, FST
	Ld 1,	N_disp
	Sd	1, LST
VAR PARENT__u, q
	La	0, STANDARD._INTEGER.use__info
	Sa	1, PARENT__u
end namespace
VAR J_disp, d				; variable entiere

					;    end elab
begin:					;---------- BDY INSTRUCTIONS
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	2
	Sd  1,	I_disp
STR STR_L4, "CHK_ANON0 1 OK anonyme dans les bornes, pas de faux positif"	; constante string="CHK_ANON0 1 OK anonyme dans les bornes, pas de faux positif"
	LCA	STR_L4.data_ptr
	CALL	STANDARD.TEXT_IO. ,PUT_LINE_L60
	Ld 1,	N_disp
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	3
	SUB
	Sd  1,	I_disp
STR STR_L5, "CHK_ANON0 2 OK anonyme, valeur dynamique, pas de faux positif"	; constante string="CHK_ANON0 2 OK anonyme, valeur dynamique, pas de faux positif"
	LCA	STR_L5.data_ptr
	CALL	STANDARD.TEXT_IO. ,PUT_LINE_L60
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	2
	DUP
	Ld	1, _DYN.FST
	CLT
	BT	STANDARD.ce_raise_
	DUP
	Ld	1, _DYN.LST
	CGT
	BT	STANDARD.ce_raise_
	Sd  1,	J_disp
STR STR_L6, "CHK_ANON0 3 OK nomme dans les bornes"	; constante string="CHK_ANON0 3 OK nomme dans les bornes"
	LCA	STR_L6.data_ptr
	CALL	STANDARD.TEXT_IO. ,PUT_LINE_L60
namespace	BLOCK__1
ELB 2					;    BODY ELAB
					;    end elab
begin:					;---------- BDY INSTRUCTIONS
VAR	exc_ctx_L7, q, 10
	La	0, STANDARD.EXCEPTIONS_TOP_CTX_disp
	Sa  2,	exc_ctx_L7
	LCA	L7
	Sa  2,	exc_ctx_L7 + STANDARD._EXCEPTION_CONTEXT.DISPATCH
	EXC_MACH  2,	exc_ctx_L7
	LVA  2,	exc_ctx_L7
	Sa	0, STANDARD.EXCEPTIONS_TOP_CTX_disp
	Ld 1,	STANDARD.CHK_ANON0_L1.N_disp
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	4
	ADD
	DUP
	Ld	1, STANDARD.CHK_ANON0_L1._DYN.FST
	CLT
	BT	STANDARD.ce_raise_
	DUP
	Ld	1, STANDARD.CHK_ANON0_L1._DYN.LST
	CGT
	BT	STANDARD.ce_raise_
	Sd  1,	J_disp
STR STR_L9, "CHK_ANON0 4 KO pas de levee"	; constante string="CHK_ANON0 4 KO pas de levee"
	LCA	STR_L9.data_ptr
	CALL	STANDARD.TEXT_IO. ,PUT_LINE_L60
	La 0,	STANDARD.EXCEPTIONS_TOP_CTX_disp
	La , 0
	Sa 0,	STANDARD.EXCEPTIONS_TOP_CTX_disp
	BRA	L8
L7:
	La	0, STANDARD.EXCEPTIONS_CURRENT_disp
	Sa  2,	exc_ctx_L7
	La	0, STANDARD.EXCEPTIONS_CURRENT_disp
	LCA	STANDARD.CONSTRAINT_ERROR__exc.data_ptr
	CEQ
	BT	L11
	BRA	L12
L11:
STR STR_L13, "CHK_ANON0 4 OK nomme hors bornes leve"	; constante string="CHK_ANON0 4 OK nomme hors bornes leve"
	LCA	STR_L13.data_ptr
	CALL	STANDARD.TEXT_IO. ,PUT_LINE_L60
	BRA	L10
L12:
	BRA	STANDARD.exc_raise_
L10:
L8:
	UNLINK 2
endPRO
	Ld 1,	N_disp
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	4
	ADD
	Sd  1,	I_disp
STR STR_L14, "CHK_ANON0 5 OK dette consignee : anonyme hors bornes passe en silence"	; constante string="CHK_ANON0 5 OK dette consignee : anonyme hors bornes passe en silence"
	LCA	STR_L14.data_ptr
	CALL	STANDARD.TEXT_IO. ,PUT_LINE_L60
ret_lbl:
