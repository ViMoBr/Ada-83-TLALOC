 hexa_show ' disp ', ARRAY_TYPE_SPEC_disp
VAR ARRAY_TYPE_SPEC_disp, q			; variable record : pointeur aux data record
VAR ARRAY_TYPE_SPEC__u, q			; variable record : pointeur aux useinfo
