endPRMS					;    fin parametrage
ELB 1					;    BODY ELAB
VAR INDEX_LIST_disp, q			; variable record : pointeur aux data record
VAR INDEX_LIST__u, q			; variable record : pointeur aux useinfo
VAR INDEX_LIST__dat, STANDARD.IDL.SEQ_TYPE.size
	LVA	1, INDEX_LIST__dat
	Sa	1, INDEX_LIST_disp			; record fin
	LVA	1, STANDARD.IDL.SEQ_TYPE.SIZ
	Sa	1, INDEX_LIST__u
	La  1, INDEX_LIST_disp
	LI	STANDARD.IDL.SEQ_TYPE.size
