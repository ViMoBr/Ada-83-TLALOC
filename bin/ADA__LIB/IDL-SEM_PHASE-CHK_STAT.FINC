VAR INDEX_disp, q				; variable record : pointeur aux data record
VAR INDEX__u, q				; variable record : pointeur aux useinfo
VAR INDEX__dat, STANDARD.IDL.TREE.size
	LVA	1, INDEX__dat
	Sa	1, INDEX_disp				; record fin
	LVA	1, STANDARD.IDL.TREE.SIZ
	Sa	1, INDEX__u

VAR ARRAY_TYPE_SPEC_disp, q			; variable record : pointeur aux data record
VAR ARRAY_TYPE_SPEC__u, q			; variable record : pointeur aux useinfo
VAR ARRAY_TYPE_SPEC__dat, STANDARD.IDL.TREE.size
