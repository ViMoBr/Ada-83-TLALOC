	La  0, STANDARD.IDL.TREE.use__info
	Sa  1, ANON_20_55__u
	LVA 1, ANON_20_55_disp
					; doublet resultat record anonyme
	La  1,	-A_ofs
	LI  50
	CALL	STANDARD.IDL. ,D_L13
	CALL	STANDARD.IDL.SEM_PHASE_L7.EXPRESO. ,GET_STATIC_VALUE_L157
	LVA 0,	STANDARD.IDL.TREE_VOID_disp
	CNE
L6:
	DUP
	BF	L5
	DROP
VAR	ANON_20_93_disp, q
VAR	ANON_20_93__u,    q
VAR	ANON_20_93__dat, STANDARD.IDL.TREE.size
