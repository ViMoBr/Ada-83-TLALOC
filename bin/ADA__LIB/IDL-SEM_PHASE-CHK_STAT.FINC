	La  ,  0
	Ld
	LVA 0,	STANDARD.IDL.TREE_VOID_disp
	La  ,  0
	Ld
	CEQ
	LI	1
	OUX
L4:
	DUP
	BF	L3
	DROP
; CODE record equality "/=" _TREE
VAR	ANON_20_93_disp, q
VAR	ANON_20_93__u,    q
