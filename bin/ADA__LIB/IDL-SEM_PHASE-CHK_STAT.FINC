VAR INDEX__u, q				; variable record : pointeur aux useinfo
VAR INDEX__dat, STANDARD.IDL._TREE.size
	LVA	1, INDEX__dat
	Sa	1, INDEX_disp				; record fin
	LVA	1, STANDARD.IDL._TREE.SIZ
	Sa	1, INDEX__u
; CODE_VC_NAME DN_VARIABLE_ID
	La  1, INDEX_disp
					; store represented component PT range 0 .. 1 width 2
	DUP
	Ld
	LI	0
	LI	0
	LI	2
	BFI
	Sd

