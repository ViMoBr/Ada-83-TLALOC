ELB 2					;    BODY ELAB
_A__type = '_A__type'
namespace _A__type				; array var constrained array type info
VAR use__info, q
VAR SIZ, d
	LVA	2, SIZ
	Sa	2, use__info
VAR _COMP_SIZ, d
VAR _FST_1, d
VAR _LST_1, d
	LI	8
	Sd	2, _COMP_SIZ
	Ld	2, _COMP_SIZ
	LVA	2, -A_IN_ofs
	LIa	, , 8
	Ld	, _STRING.FST_1
	Sd	2, _FST_1
	LVA	2, -A_IN_ofs
	LIa	, , 8
	Ld	, _STRING.LST_1
	Sd	2, _LST_1
	Ld	2, _LST_1
	Ld	2, _FST_1
	SUB
	INC
	CLAMP0
	MUL
	Sd	2, SIZ
  virtual at 4
COMP_SIZ = $
	rd 1 
FST_1 = $
	rd 1 
LST_1 = $
	rd 1 
  end virtual
end namespace
VAR A_disp, q				; variable array : pointeur aux data
VAR A__u, q				; variable array : useinfo pointeur au rec info
	La 2, _A__type.use__info
	Sa	2, A__u				; array info ptr at __u
; COMPILE_ARRAY_VAR ASSOC.TY non gere DN_USED_OBJECT_ID

