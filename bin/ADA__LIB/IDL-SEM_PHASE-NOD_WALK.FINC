if defined MAKE_UPPER_CASE_L13_
PRO	MAKE_UPPER_CASE_L13			;---------- PRO MAKE_UPPER_CASE
PRMS					;    debut parametrage
	PRM A_IN_ofs				; in
	PRM result__ofs				; resultat de fonction
endPRMS					;    fin parametrage
ELB 2					;    BODY ELAB
STRING = 'STRING'
namespace STRING				; array var constrained array type info
VAR use__info, q
VAR SIZ, d
	LVA	2, SIZ
	Sa	2, use__info
VAR _COMP_SIZ, d
VAR _FST_1, d
VAR _LST_1, d
	LI	8
	Sd	2, _COMP_SIZ
	Ld	2, _COMP_SIZ
	LVA	2, -A_IN_ofs
	LIa	, , 8
	Ld	, STRING.FST_1
	Sd	2, _FST_1
	LVA	2, -A_IN_ofs
	LIa	, , 8
	Ld	, STRING.LST_1
	Sd	2, _LST_1
	Ld	2, _LST_1
	Ld	2, _FST_1
	SUB
	INC
	MUL
	Sd	2, SIZ
  virtual at 4
COMP_SIZ = $
	rd 1 
FST_1 = $
	rd 1 
LST_1 = $
	rd 1 
  end virtual
end namespace
VAR A_disp, q				; variable array : pointeur aux data
VAR A__u, q				; variable array : useinfo pointeur au rec info
	La 2, STRING.use__info
	Sa	2, A__u				; array info ptr at __u
; COMPILE_ARRAY_VAR ASSOC.TY non gere DN_USED_OBJECT_ID

					;    end elab
begin:					;---------- BDY INSTRUCTIONS
VAR	IIL15_disp, d				; compteur boucle LOOP__1
	LId	2, A__u, STRING.FST_1
	Sd  2,	IIL15_disp
VAR	LMT_IIL15_disp, d			; limite boucle LOOP__1
	LId	2, A__u, STRING.LST_1
	Sd  2,	LMT_IIL15_disp
	Ld  2,	IIL15_disp				; test null range LOOP__1
	Ld  2,	LMT_IIL15_disp
	CGT
	BT	L14
LOOP__1:					; corps boucle LOOP__1
					; debut if
	BF	L17
	La	 2, A_disp				; array data start address on stack
	Ld	2, IIL15_disp
	LId	2, A__u, STANDARD.STRING.FST_1		; (index - FST_1) * SIZ_1
	SUB
	LId	2, A__u, STANDARD.STRING.COMP_SIZ
	LI	8
	DIV
	MUL
	ADD					; add offset to start address
	La	 2, A_disp				; array data start address on stack
	Ld	2, IIL15_disp
	LId	2, A__u, STANDARD.STRING.FST_1		; (index - FST_1) * SIZ_1
	SUB
	LId	2, A__u, STANDARD.STRING.COMP_SIZ
	LI	8
	DIV
	MUL
	ADD					; add offset to start address
	Lb
	LI	65
	LI	65
	SUB
	SUB
	Sb
	BRA	L16
L17:
L16:					; post if
	Ld  2,	IIL15_disp				; test de sortie LOOP__1
	Ld  2,	LMT_IIL15_disp
	CEQ
	BT	L14
	Ld  2,	IIL15_disp				; mise a jour compteur LOOP__1
	INC
	Sd  2,	IIL15_disp
	BRA	LOOP__1				; iteration suivante LOOP__1
L14:					; post loop LOOP__1
; CODE_RETURN : EXPR TYPE = DN_CONSTRAINED_ARRAY
	LVA 2,	A_disp
VAR	RET_INFO_L18, q
	DUP
	La  ,  0
	SIq   2, -result__ofs,  0
	DUP
	La  ,  8
	Sa   2, RET_INFO_L18
	DROP
	La   2, -result__ofs
	La  ,  8
	LI	16
	La   2, RET_INFO_L18
	BLKMOV
	BRA ret_lbl
ret_lbl:
	UNLINK 2
	RTD	prm_siz-8
excep:
endPRO					;---------- end PRO MAKE_UPPER_CASE
end if
					;    end elab
begin:					;---------- BDY INSTRUCTIONS
