LOOP__1:					; corps boucle LOOP__1
					; debut if
	La	 2, STANDARD.IDL.SEM_PHASE_L11.NOD_WALK.FORCE_UPPER_CASE_L1.MAKE_UPPER_CASE_L2.A_disp	; array data start address on stack
