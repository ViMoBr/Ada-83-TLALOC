NOD_WALK = 'NOD_WALK'
namespace NOD_WALK				;---------- PACKAGE
elab_spec:				;    SPEC ELAB


					; S_TYPE RECORD TYPE INFO
S_TYPE = 'S_TYPE'
namespace S_TYPE
VAR use__info, q
VAR SIZ, d
	LVA	0, SIZ
	Sa	0, use__info
USEINFO 0, SU, 	La 1, STANDARD.IDL.SEM_PHASE_L11.SEM_GLOB.SU_TYPE.use__info
virtual at 0				; calcul des offsets statiques
STATOFS SU, 24
size = $
end virtual
	LI	 size*8
	Sd	0, SIZ
end namespace
					;    BODY ELAB
VAR EQUAL_SYM_disp, q			; variable record : pointeur aux data record
VAR EQUAL_SYM__u, q				; variable record : pointeur aux useinfo
VAR EQUAL_SYM__dat, STANDARD.IDL.TREE.size
