	CALL	STANDARD.IDL.IDL_MAN. ,STORE_SYM_L40
	La  1,	-OPERATOR_ID_ofs
	LI  13
	CALL	STANDARD.IDL. ,D_L16
ret_lbl:
	UNLINK 1
	RTD	prm_siz
excep:
endPRO					;---------- end PRO FORCE_UPPER_CASE
end if

