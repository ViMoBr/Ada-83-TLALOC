TERM_LIST = 'TERM_LIST'
namespace TERM_LIST				;---------- PACKAGE (BDY)
					;    BODY ELAB

if defined SAME_L174_
PRO	SAME_L174				;---------- PRO SAME
 hexa_show 'SAME_L174 ', $
PRMS					;    debut parametrage
	PRM L1_ofs				; in
	PRM L2_ofs				; in
	PRM result__ofs				; resultat de fonction
endPRMS					;    fin parametrage
ELB 1					;    BODY ELAB
					;    end elab
begin:					;---------- BDY INSTRUCTIONS
; CODE_RETURN : EXPR TYPE = DN_ENUMERATION  VUE COMPLETE = DN_ENUMERATION
; CODE record equality "=" _TREE
	La 1, -L1_ofs
	LIVA 	, 0, STANDARD.IDL._SEQ_TYPE.FIRST
	Ld
	La 1, -L2_ofs
	LIVA 	, 0, STANDARD.IDL._SEQ_TYPE.FIRST
	Ld
	CEQ
	Sb  1,	-result__ofs
	BRA ret_lbl
ret_lbl:
	UNLINK 1
	RTD	prm_siz-8
excep:
endPRO					;---------- end PRO SAME
end if

if defined UNION_L175_
PRO	UNION_L175				;---------- PRO UNION
 hexa_show 'UNION_L175 ', $
PRMS					;    debut parametrage
	PRM L1_ofs				; in
	PRM V_ofs				; in
	PRM result__ofs				; resultat de fonction
endPRMS					;    fin parametrage
ELB 1					;    BODY ELAB
					;    end elab
begin:					;---------- BDY INSTRUCTIONS
					; debut if
	LI	0					; lieu resultat sur pile
	La  1,	-L1_ofs
	CALL	STANDARD.IDL. ,IS_EMPTY_L20
	BF	L6
; CODE_RETURN : EXPR TYPE = DN_RECORD  VUE COMPLETE = DN_RECORD
	La   1,	-result__ofs
	La  ,  0
	LI	STANDARD.IDL._SEQ_TYPE.size
VAR	ANON_24_14_disp, q
VAR	ANON_24_14__u,    q
VAR	ANON_24_14__dat, STANDARD.IDL._SEQ_TYPE.size
	LVA 1, ANON_24_14__dat
	Sa  1, ANON_24_14_disp
	La  0, STANDARD.IDL._SEQ_TYPE.use__info
	Sa  1, ANON_24_14__u
	LVA 1, ANON_24_14_disp
					; doublet resultat record anonyme
	La  1,	-V_ofs
	La  1,	-L1_ofs
	CALL	STANDARD.IDL.IDL_MAN. ,INSERT_L28
	La  ,  0
	BLKMOV
	BRA ret_lbl
	BRA	L5
L6:
namespace	BLOCK__1
ELB 2					;    BODY ELAB
 hexa_show 'var elab H1 ', $
 hexa_show ' disp ', H1_disp
VAR H1_disp, q				; variable record : pointeur aux data record
VAR H1__u, q				; variable record : pointeur aux useinfo
VAR H1__dat, STANDARD.IDL._TREE.size
	LVA	2, H1__dat
	Sa	2, H1_disp				; record fin
	LVA	2, STANDARD.IDL._TREE.SIZ
	Sa	2, H1__u
; CODE_VC_NAME DN_VARIABLE_ID
	La  2, H1_disp
	LI	STANDARD.IDL._TREE.size
VAR	ANON_27_22_disp, q
VAR	ANON_27_22__u,    q
VAR	ANON_27_22__dat, STANDARD.IDL._TREE.size
	LVA 2, ANON_27_22__dat
	Sa  2, ANON_27_22_disp
	La  0, STANDARD.IDL._TREE.use__info
	Sa  2, ANON_27_22__u
	LVA 2, ANON_27_22_disp
					; doublet resultat record anonyme
	La  1,	-L1_ofs
	CALL	STANDARD.IDL.IDL_MAN. ,HEAD_L26
	La  ,  0
	BLKMOV

 hexa_show 'var elab N1 ', $
 hexa_show ' disp ', N1_disp
VAR N1_disp, d				; variable entiere
	LI	0					; lieu resultat sur pile
	LVA 2,	H1_disp
	LI  28
	CALL	STANDARD.IDL. ,DI_L18
	Sd  2,	N1_disp

 hexa_show 'var elab NV ', $
 hexa_show ' disp ', NV_disp
VAR NV_disp, d				; variable entiere
	LI	0					; lieu resultat sur pile
	La  1,	-V_ofs
	LI  28
	CALL	STANDARD.IDL. ,DI_L18
	Sd  2,	NV_disp

					;    end elab
begin:					;---------- BDY INSTRUCTIONS
					; debut if
	Ld 2,	N1_disp
	Ld 2,	NV_disp
	CEQ
	BF	L10
; CODE_RETURN : EXPR TYPE = DN_RECORD  VUE COMPLETE = DN_RECORD
	La   2,	-result__ofs
	La  ,  0
	LI	STANDARD.IDL._SEQ_TYPE.size
	La  1,	-L1_ofs
	La  ,  0
	BLKMOV
	UNLINK 2
	BRA ret_lbl
	BRA	L9
L10:
	Ld 2,	N1_disp
	Ld 2,	NV_disp
	CLT
	BF	L11
namespace	BLOCK__2
ELB 3					;    BODY ELAB
 hexa_show 'var elab T1 ', $
 hexa_show ' disp ', T1_disp
VAR T1_disp, q				; variable record : pointeur aux data record
VAR T1__u, q				; variable record : pointeur aux useinfo
VAR T1__dat, STANDARD.IDL._SEQ_TYPE.size
	LVA	3, T1__dat
	Sa	3, T1_disp				; record fin
	LVA	3, STANDARD.IDL._SEQ_TYPE.SIZ
	Sa	3, T1__u
; CODE_VC_NAME DN_VARIABLE_ID
	La  3, T1_disp
	LI	STANDARD.IDL._SEQ_TYPE.size
VAR	ANON_35_21_disp, q
VAR	ANON_35_21__u,    q
VAR	ANON_35_21__dat, STANDARD.IDL._SEQ_TYPE.size
	LVA 3, ANON_35_21__dat
	Sa  3, ANON_35_21_disp
	La  0, STANDARD.IDL._SEQ_TYPE.use__info
	Sa  3, ANON_35_21__u
	LVA 3, ANON_35_21_disp
					; doublet resultat record anonyme
	La  1,	-L1_ofs
	CALL	STANDARD.IDL.IDL_MAN. ,TAIL_L27
	La  ,  0
	BLKMOV

 hexa_show 'var elab L ', $
 hexa_show ' disp ', L_disp
VAR L_disp, q				; variable record : pointeur aux data record
VAR L__u, q				; variable record : pointeur aux useinfo
VAR L__dat, STANDARD.IDL._SEQ_TYPE.size
	LVA	3, L__dat
	Sa	3, L_disp				; record fin
	LVA	3, STANDARD.IDL._SEQ_TYPE.SIZ
	Sa	3, L__u
; CODE_VC_NAME DN_VARIABLE_ID
	La  3, L_disp
	LI	STANDARD.IDL._SEQ_TYPE.size
VAR	ANON_36_20_disp, q
VAR	ANON_36_20__u,    q
VAR	ANON_36_20__dat, STANDARD.IDL._SEQ_TYPE.size
	LVA 3, ANON_36_20__dat
	Sa  3, ANON_36_20_disp
	La  0, STANDARD.IDL._SEQ_TYPE.use__info
	Sa  3, ANON_36_20__u
	LVA 3, ANON_36_20_disp
					; doublet resultat record anonyme
	La  1,	-V_ofs
	LVA 3,	T1_disp
	CALL	STANDARD.IDL.TERM_LIST. ,UNION_L175
	La  ,  0
	BLKMOV

					;    end elab
begin:					;---------- BDY INSTRUCTIONS
					; debut if
	LI	0					; lieu resultat sur pile
	LVA 3,	L_disp
	LVA 3,	T1_disp
	CALL	STANDARD.IDL.TERM_LIST. ,SAME_L174
	BF	L15
; CODE_RETURN : EXPR TYPE = DN_RECORD  VUE COMPLETE = DN_RECORD
	La   3,	-result__ofs
	La  ,  0
	LI	STANDARD.IDL._SEQ_TYPE.size
	La  1,	-L1_ofs
	La  ,  0
	BLKMOV
	UNLINK 3
	UNLINK 2
	BRA ret_lbl
	BRA	L14
L15:
; CODE_RETURN : EXPR TYPE = DN_RECORD  VUE COMPLETE = DN_RECORD
	La   3,	-result__ofs
	La  ,  0
	LI	STANDARD.IDL._SEQ_TYPE.size
VAR	ANON_41_13_disp, q
VAR	ANON_41_13__u,    q
VAR	ANON_41_13__dat, STANDARD.IDL._SEQ_TYPE.size
	LVA 3, ANON_41_13__dat
	Sa  3, ANON_41_13_disp
	La  0, STANDARD.IDL._SEQ_TYPE.use__info
	Sa  3, ANON_41_13__u
	LVA 3, ANON_41_13_disp
					; doublet resultat record anonyme
	LVA 2,	STANDARD.IDL.TERM_LIST.UNION_L175.BLOCK__1.H1_disp
	LVA 3,	L_disp
	CALL	STANDARD.IDL.IDL_MAN. ,INSERT_L28
	La  ,  0
	BLKMOV
	UNLINK 3
	UNLINK 2
	BRA ret_lbl
L14:					; post if
	UNLINK 3
endPRO
	BRA	L9
L11:
; CODE_RETURN : EXPR TYPE = DN_RECORD  VUE COMPLETE = DN_RECORD
	La   2,	-result__ofs
	La  ,  0
	LI	STANDARD.IDL._SEQ_TYPE.size
VAR	ANON_45_9_disp, q
VAR	ANON_45_9__u,    q
VAR	ANON_45_9__dat, STANDARD.IDL._SEQ_TYPE.size
	LVA 2, ANON_45_9__dat
	Sa  2, ANON_45_9_disp
	La  0, STANDARD.IDL._SEQ_TYPE.use__info
	Sa  2, ANON_45_9__u
	LVA 2, ANON_45_9_disp
					; doublet resultat record anonyme
	La  1,	-V_ofs
	La  1,	-L1_ofs
	CALL	STANDARD.IDL.IDL_MAN. ,INSERT_L28
	La  ,  0
	BLKMOV
	UNLINK 2
	BRA ret_lbl
L9:					; post if
	UNLINK 2
endPRO
L5:					; post if
ret_lbl:
	UNLINK 1
	RTD	prm_siz-8
excep:
endPRO					;---------- end PRO UNION
end if

