if ~ definite MACHINE_CODE
include 'MACHINE_CODE.FINC'
end if
TEXT_IO = 'TEXT_IO'
namespace TEXT_IO				;---------- PACKAGE (BDY)
elab_spec:				;    SPEC ELAB

					; CODE_PACKAGE_SPEC
; EXPANDER.DECLARATIONS.CODE_TYPE_DECL : skip PRIVATE FILE_TYPE (deferred to full type)

					; _FILE_MODE ENUMERATION TYPE INFO
_FILE_MODE = '_FILE_MODE'
namespace _FILE_MODE
VAR use__info, q
BEGIN_BLOC_DEF
db 0, 7, "IN_FILE"
db 1, 8, "OUT_FILE"
END_BLOC_DEF
IMAGES	BYTES_BLOC
CST LST, d, 1
CST FST, d, 0
CST SIZ, d, 8	; SIZ en bits !
postpone
  align_q
end postpone
	LCA	SIZ
	Sa	0, use__info
end namespace

					; _COUNT TYPE RANGE INFO
_COUNT = '_COUNT'
namespace _COUNT
VAR use__info, q
VAR SIZ, d
	LVA	0, SIZ
	Sa	0, use__info
VAR FST, d
VAR LST, d
	LI	32
	Sd	0, SIZ
; CODE_NUMERIC_LITERAL DN_UNIVERSAL_INTEGER
	LI	0
	Sd	0, FST
	LI	002147483647
	Sd	0, LST
end namespace

					; _POSITIVE_COUNT INTEGER SUBTYPE INFO
_POSITIVE_COUNT = '_POSITIVE_COUNT'
namespace _POSITIVE_COUNT
VAR use__info, q
VAR SIZ, d
	LVA	0, SIZ
	Sa	0, use__info
VAR FST, d
VAR LST, d
	LI	32
	Sd	0, SIZ
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	1
	Sd	0, FST
	LI	002147483647
	Sd	0, LST
VAR PARENT__u, q
	La	0, STANDARD.TEXT_IO._COUNT.use__info
	Sa	0, PARENT__u
end namespace
VAR UNBOUNDED_disp, d			; variable entiere
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	0
	Sd  0,	UNBOUNDED_disp


					; _FIELD INTEGER SUBTYPE INFO
_FIELD = '_FIELD'
namespace _FIELD
VAR use__info, q
VAR SIZ, d
	LVA	0, SIZ
	Sa	0, use__info
VAR FST, d
VAR LST, d
	LI	32
	Sd	0, SIZ
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	0
	Sd	0, FST
	LI	002147483647
	Sd	0, LST
VAR PARENT__u, q
	La	0, STANDARD._INTEGER.use__info
	Sa	0, PARENT__u
end namespace

					; _NUMBER_BASE INTEGER SUBTYPE INFO
_NUMBER_BASE = '_NUMBER_BASE'
namespace _NUMBER_BASE
VAR use__info, q
VAR SIZ, d
	LVA	0, SIZ
	Sa	0, use__info
VAR FST, d
VAR LST, d
	LI	32
	Sd	0, SIZ
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	2
	Sd	0, FST
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	16
	Sd	0, LST
VAR PARENT__u, q
	La	0, STANDARD._INTEGER.use__info
	Sa	0, PARENT__u
end namespace

					; _TYPE_SET ENUMERATION TYPE INFO
_TYPE_SET = '_TYPE_SET'
namespace _TYPE_SET
VAR use__info, q
BEGIN_BLOC_DEF
db 0, 10, "LOWER_CASE"
db 1, 10, "UPPER_CASE"
END_BLOC_DEF
IMAGES	BYTES_BLOC
CST LST, d, 1
CST FST, d, 0
CST SIZ, d, 8	; SIZ en bits !
postpone
  align_q
end postpone
	LCA	SIZ
	Sa	0, use__info
end namespace
