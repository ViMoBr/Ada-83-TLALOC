	PRM NAME_ofs				; in
	PRM FORM_ofs				; in
endPRMS					;    fin parametrage
ELB 1					;    BODY ELAB
VAR ERR_OR_ID_disp, d			; variable entiere


if defined OPEN_SYSTEM_CALL_L10_
PRO	OPEN_SYSTEM_CALL_L10			;---------- PRO OPEN_SYSTEM_CALL
PRMS					;    debut parametrage
	PRM NAME_ofs				; in
	PRM result__ofs				; resultat de fonction
endPRMS					;    fin parametrage
ELB 2					;    BODY ELAB
