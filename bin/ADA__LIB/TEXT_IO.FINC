VAR LST, d
	LI	32
	Sd	0, SIZ
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	0
	Sd	0, FST
	LI	002147483647
	Sd	0, LST
VAR PARENT__u, q
	La	0, STANDARD._INTEGER.use__info
	Sa	0, PARENT__u
end namespace

					; _NUMBER_BASE INTEGER SUBTYPE INFO
