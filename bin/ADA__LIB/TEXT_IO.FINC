	LI	 13
	La  1,	-FILE_ofs
	CALL	STANDARD.TEXT_IO. ,PUT_RAW_L92
	La 1, -FILE_ofs
	LIVA 	, 0, STANDARD.TEXT_IO._FILE_TYPE.COL
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	1
	Sd
VAR	NL149_disp, d				; compteur boucle LOOP__1
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	1
	Sd  1,	NL149_disp
VAR	LMT_NL149_disp, d			; limite boucle LOOP__1
	ULd  1,	-SPACING_ofs
	Sd  1,	LMT_NL149_disp
	ULd  1,	NL149_disp				; test null range LOOP__1
	ULd  1,	LMT_NL149_disp
	CGT
	BT	L148
LOOP__1:					; corps boucle LOOP__1
	LI	 10
	La  1,	-FILE_ofs
