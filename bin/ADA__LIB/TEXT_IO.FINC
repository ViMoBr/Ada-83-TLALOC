_FILE_NAME_BUFFER = '_FILE_NAME_BUFFER'
namespace _FILE_NAME_BUFFER			; _FILE_NAME_BUFFER CONSTRAINED ARRAY SUBTYPE INFO
VAR use__info, q
VAR SIZ, d
	LVA	0, SIZ
	Sa	0, use__info
VAR _COMP_SIZ, d
VAR _FST_1, d
VAR _LST_1, d
	LI	8
	Sd	0, _COMP_SIZ
	Ld	0, _COMP_SIZ
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	1
	Sd	0, _FST_1
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	256
	Sd	0, _LST_1
	Ld	0, _LST_1
	Ld	0, _FST_1
	SUB
	INC
	CLAMP0
	MUL
	Sd	0, SIZ
  virtual at 4
COMP_SIZ = $
	rd 1 
FST_1 = $
	rd 1 
LST_1 = $
	rd 1 
  end virtual
end namespace

					; _FILE_TYPE RECORD TYPE INFO
_FILE_TYPE = '_FILE_TYPE'
namespace _FILE_TYPE
VAR use__info, q
VAR SIZ, d
	LVA	0, SIZ
	Sa	0, use__info
USEINFO 0, ID, 	La 0, STANDARD._INTEGER.use__info
USEINFO 0, NAME, 	La 0, STANDARD.TEXT_IO._FILE_NAME_BUFFER.use__info
; STSB
USEINFO 0, NAME_LEN, 	La 0, STANDARD._POSITIVE.use__info
USEINFO 0, IS_OPENED, 	La 0, STANDARD._BOOLEAN.use__info
USEINFO 0, MODE, 	La 0, STANDARD.TEXT_IO._FILE_MODE.use__info
USEINFO 0, PAGE_LENGTH, 	La 0, STANDARD.TEXT_IO._POSITIVE_COUNT.use__info
USEINFO 0, LINE_LENGTH, 	La 0, STANDARD.TEXT_IO._POSITIVE_COUNT.use__info
USEINFO 0, PAGE, 	La 0, STANDARD.TEXT_IO._POSITIVE_COUNT.use__info
USEINFO 0, LINE, 	La 0, STANDARD.TEXT_IO._POSITIVE_COUNT.use__info
USEINFO 0, COL, 	La 0, STANDARD.TEXT_IO._POSITIVE_COUNT.use__info
USEINFO 0, IS_DEFAULT_IO, 	La 0, STANDARD._BOOLEAN.use__info
USEINFO 0, LOOK_AHEAD, 	La 0, STANDARD._CHARACTER.use__info
USEINFO 0, HAS_LOOK_AHEAD, 	La 0, STANDARD._BOOLEAN.use__info
USEINFO 0, AT_END_OF_FILE, 	La 0, STANDARD._BOOLEAN.use__info
virtual at 0				; calcul des offsets statiques
STATOFS ID, 4
; STSB
STATOFS NAME, 256
STATOFS NAME_LEN, 4
STATOFS IS_OPENED, 1
STATOFS MODE, 1
STATOFS PAGE_LENGTH, 4
STATOFS LINE_LENGTH, 4
STATOFS PAGE, 4
STATOFS LINE, 4
STATOFS COL, 4
STATOFS IS_DEFAULT_IO, 1
STATOFS LOOK_AHEAD, 1
STATOFS HAS_LOOK_AHEAD, 1
STATOFS AT_END_OF_FILE, 1
size = $
end virtual
	LI	 size*8
	Sd	0, SIZ
end namespace
					;    BODY ELAB
VAR STDOUT_PAGE_LENGTH_disp, d		; variable entiere
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	72
	Sd  0,	STDOUT_PAGE_LENGTH_disp

