if ~ definite MACHINE_CODE
include 'MACHINE_CODE.FINC'
end if
TEXT_IO = 'TEXT_IO'
namespace TEXT_IO				;---------- PACKAGE
elab_spec:				;    SPEC ELAB

; CODE_TYPE_DECL : skip PRIVATE FILE_TYPE (deferred to full type)

					; FILE_MODE ENUMERATION TYPE INFO
FILE_MODE = 'FILE_MODE'
namespace FILE_MODE
VAR use__info, q
BEGIN_BLOC_DEF
db 0, 7, "IN_FILE"
db 1, 8, "OUT_FILE"
END_BLOC_DEF
IMAGES	BYTES_BLOC
CST LST, d, 1
CST FST, d, 0
CST SIZ, d, 8	; SIZ en bits !
postpone
  align_q
end postpone
	LCA	SIZ
	Sa	0, use__info
end namespace

					; COUNT TYPE RANGE INFO
COUNT = 'COUNT'
namespace COUNT
VAR use__info, q
VAR SIZ, d
	LVA	0, SIZ
	Sa	0, use__info
VAR FST, d
VAR LST, d
	LI	32
	Sd	0, SIZ
; CODE_NUMERIC_LITERAL DN_UNIVERSAL_INTEGER
	LI	0
	Sd	0, FST
	LI	002147483647
	Sd	0, LST
end namespace

					; POSITIVE_COUNT INTEGER SUBTYPE INFO
POSITIVE_COUNT = 'POSITIVE_COUNT'
namespace POSITIVE_COUNT
VAR use__info, q
VAR SIZ, d
	LVA	0, SIZ
	Sa	0, use__info
VAR FST, d
VAR LST, d
	LI	32
	Sd	0, SIZ
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	1
	Sd	0, FST
	LI	002147483647
	Sd	0, LST
VAR PARENT__u, q
	La	0, STANDARD.TEXT_IO.COUNT.use__info
	Sa	0, PARENT__u
end namespace
VAR UNBOUNDED_disp, d			; variable entiere
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	0
	Sd  0,	UNBOUNDED_disp


					; FIELD INTEGER SUBTYPE INFO
FIELD = 'FIELD'
namespace FIELD
VAR use__info, q
VAR SIZ, d
	LVA	0, SIZ
	Sa	0, use__info
VAR FST, d
VAR LST, d
	LI	32
	Sd	0, SIZ
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	0
	Sd	0, FST
	LI	002147483647
	Sd	0, LST
VAR PARENT__u, q
	La	0, STANDARD.INTEGER.use__info
	Sa	0, PARENT__u
end namespace

					; NUMBER_BASE INTEGER SUBTYPE INFO
NUMBER_BASE = 'NUMBER_BASE'
namespace NUMBER_BASE
VAR use__info, q
VAR SIZ, d
	LVA	0, SIZ
	Sa	0, use__info
VAR FST, d
VAR LST, d
	LI	32
	Sd	0, SIZ
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	2
	Sd	0, FST
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	16
	Sd	0, LST
VAR PARENT__u, q
	La	0, STANDARD.INTEGER.use__info
	Sa	0, PARENT__u
end namespace

					; TYPE_SET ENUMERATION TYPE INFO
TYPE_SET = 'TYPE_SET'
namespace TYPE_SET
VAR use__info, q
BEGIN_BLOC_DEF
db 0, 10, "LOWER_CASE"
db 1, 10, "UPPER_CASE"
END_BLOC_DEF
IMAGES	BYTES_BLOC
CST LST, d, 1
CST FST, d, 0
CST SIZ, d, 8	; SIZ en bits !
postpone
  align_q
end postpone
	LCA	SIZ
	Sa	0, use__info
end namespace
FILE_NAME_BUFFER = 'FILE_NAME_BUFFER'
namespace FILE_NAME_BUFFER			; FILE_NAME_BUFFER CONSTRAINED ARRAY SUBTYPE INFO
VAR use__info, q
VAR SIZ, d
	LVA	0, SIZ
	Sa	0, use__info
VAR COMP_SIZ, d
VAR FST_1, d
VAR LST_1, d
	LI	8
	Sd	0, COMP_SIZ
	Ld	0, COMP_SIZ
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	1
	Sd	0, FST_1
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	256
	Sd	0, LST_1
	Ld	0, LST_1
	INC
	Ld	0, FST_1
	SUB
	MUL
	Sd	0, SIZ
  virtual at 4
COMP_SIZ = $
	rd 1 
FST_1 = $
	rd 1 
LST_1 = $
	rd 1 
  end virtual
end namespace

					; FILE_TYPE RECORD TYPE INFO
FILE_TYPE = 'FILE_TYPE'
namespace FILE_TYPE
VAR use__info, q
VAR SIZ, d
	LVA	0, SIZ
	Sa	0, use__info
USEINFO 0, ID, 	La 0, STANDARD.INTEGER.use__info
USEINFO 0, NAME, 	La 0, STANDARD.TEXT_IO.FILE_NAME_BUFFER.use__info
USEINFO 0, NAME_LEN, 	La 0, STANDARD.POSITIVE.use__info
USEINFO 0, IS_OPENED, 	La 0, STANDARD.BOOLEAN.use__info
USEINFO 0, MODE, 	La 0, STANDARD.TEXT_IO.FILE_MODE.use__info
USEINFO 0, PAGE_LENGTH, 	La 0, STANDARD.TEXT_IO.POSITIVE_COUNT.use__info
USEINFO 0, LINE_LENGTH, 	La 0, STANDARD.TEXT_IO.POSITIVE_COUNT.use__info
USEINFO 0, PAGE, 	La 0, STANDARD.TEXT_IO.POSITIVE_COUNT.use__info
USEINFO 0, LINE, 	La 0, STANDARD.TEXT_IO.POSITIVE_COUNT.use__info
USEINFO 0, COL, 	La 0, STANDARD.TEXT_IO.POSITIVE_COUNT.use__info
USEINFO 0, IS_DEFAULT_IO, 	La 0, STANDARD.BOOLEAN.use__info
USEINFO 0, LOOK_AHEAD, 	La 0, STANDARD.CHARACTER.use__info
USEINFO 0, HAS_LOOK_AHEAD, 	La 0, STANDARD.BOOLEAN.use__info
USEINFO 0, AT_END_OF_FILE, 	La 0, STANDARD.BOOLEAN.use__info
virtual at 0				; calcul des offsets statiques
STATOFS ID, 4
STATOFS NAME, 256
STATOFS NAME_LEN, 4
STATOFS IS_OPENED, 1
STATOFS MODE, 1
STATOFS PAGE_LENGTH, 4
STATOFS LINE_LENGTH, 4
STATOFS PAGE, 4
STATOFS LINE, 4
STATOFS COL, 4
STATOFS IS_DEFAULT_IO, 1
STATOFS LOOK_AHEAD, 1
STATOFS HAS_LOOK_AHEAD, 1
STATOFS AT_END_OF_FILE, 1
size = $
end virtual
	LI	 size*8
	Sd	0, SIZ
end namespace
					;    BODY ELAB
VAR STDOUT_PAGE_LENGTH_disp, d		; variable entiere
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	72
	Sd  0,	STDOUT_PAGE_LENGTH_disp

VAR STDOUT_LINE_LENGTH_disp, d		; variable entiere
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	256
	Sd  0,	STDOUT_LINE_LENGTH_disp

VAR STDOUT_PAGE_disp, d			; variable entiere
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	1
	Sd  0,	STDOUT_PAGE_disp

VAR STDOUT_LINE_disp, d			; variable entiere
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	1
	Sd  0,	STDOUT_LINE_disp

VAR STDOUT_COL_disp, d			; variable entiere
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	1
	Sd  0,	STDOUT_COL_disp

VAR DEFAULT_INPUT_disp, q			; variable record : pointeur aux data record
VAR DEFAULT_INPUT__u, q			; variable record : pointeur aux useinfo
VAR DEFAULT_INPUT__dat, STANDARD.TEXT_IO.FILE_TYPE.size
	LVA	0, DEFAULT_INPUT__dat
	Sa	0, DEFAULT_INPUT_disp			; record fin
	LVA	0, STANDARD.TEXT_IO.FILE_TYPE.SIZ
	Sa	0, DEFAULT_INPUT__u
	LIVa 0, DEFAULT_INPUT_disp, STANDARD.TEXT_IO.FILE_TYPE.ID
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	1
	NEG
	Sd
	LIVa 0, DEFAULT_INPUT_disp, STANDARD.TEXT_IO.FILE_TYPE.IS_OPENED
	LI	0
	Sb
	LIVa 0, DEFAULT_INPUT_disp, STANDARD.TEXT_IO.FILE_TYPE.PAGE_LENGTH
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	72
	Sd
	LIVa 0, DEFAULT_INPUT_disp, STANDARD.TEXT_IO.FILE_TYPE.LINE_LENGTH
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	256
	Sd
	LIVa 0, DEFAULT_INPUT_disp, STANDARD.TEXT_IO.FILE_TYPE.PAGE
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	1
	Sd
	LIVa 0, DEFAULT_INPUT_disp, STANDARD.TEXT_IO.FILE_TYPE.LINE
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	1
	Sd
	LIVa 0, DEFAULT_INPUT_disp, STANDARD.TEXT_IO.FILE_TYPE.COL
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	1
	Sd
	LIVa 0, DEFAULT_INPUT_disp, STANDARD.TEXT_IO.FILE_TYPE.IS_DEFAULT_IO
	LI	0
	Sb
	LIVa 0, DEFAULT_INPUT_disp, STANDARD.TEXT_IO.FILE_TYPE.LOOK_AHEAD
	LI	 0
	Sb
	LIVa 0, DEFAULT_INPUT_disp, STANDARD.TEXT_IO.FILE_TYPE.HAS_LOOK_AHEAD
	LI	0
	Sb
	LIVa 0, DEFAULT_INPUT_disp, STANDARD.TEXT_IO.FILE_TYPE.AT_END_OF_FILE
	LI	0
	Sb

VAR DEFAULT_OUTPUT_disp, q			; variable record : pointeur aux data record
VAR DEFAULT_OUTPUT__u, q			; variable record : pointeur aux useinfo
VAR DEFAULT_OUTPUT__dat, STANDARD.TEXT_IO.FILE_TYPE.size
	LVA	0, DEFAULT_OUTPUT__dat
	Sa	0, DEFAULT_OUTPUT_disp			; record fin
	LVA	0, STANDARD.TEXT_IO.FILE_TYPE.SIZ
	Sa	0, DEFAULT_OUTPUT__u
	LIVa 0, DEFAULT_OUTPUT_disp, STANDARD.TEXT_IO.FILE_TYPE.ID
