if defined CREATE_L1_
PRO	CREATE_L1				;---------- PRO CREATE
 hexa_show 'CREATE_L1 ', $
PRMS					;    debut parametrage
	PRM FILE_ofs				; in out
	PRM MODE_ofs				; in
	PRM NAME_ofs				; in
	PRM FORM_ofs				; in
endPRMS					;    fin parametrage
ELB 1					;    BODY ELAB
 hexa_show 'var elab ERR_OR_ID ', $
 hexa_show ' disp ', ERR_OR_ID_disp
VAR ERR_OR_ID_disp, d			; variable entiere


if defined CREATE_SYSTEM_CALL_L1_
PRO	CREATE_SYSTEM_CALL_L1			;---------- PRO CREATE_SYSTEM_CALL
 hexa_show 'CREATE_SYSTEM_CALL_L1 ', $
PRMS					;    debut parametrage
	PRM NAME_ofs				; in
	PRM result__ofs				; resultat de fonction
endPRMS					;    fin parametrage
ELB 2					;    BODY ELAB
					;    end elab
begin:					;---------- BDY INSTRUCTIONS
	LA 2 ,	-8
	SYS_FILE_CREATE
	SD 2 ,	-16
ret_lbl:
	UNLINK 2
	RTD	prm_siz-8
excep:
endPRO					;---------- end PRO CREATE_SYSTEM_CALL
end if
					;    end elab
begin:					;---------- BDY INSTRUCTIONS
					; debut if
	La 1, -FILE_ofs
	LIb	, 0, STANDARD.TEXT_IO._FILE_TYPE.IS_OPENED
	BF	L7
	LCA	STANDARD.IO_EXCEPTIONS.STATUS_ERROR__exc.data_ptr
	Sa	0, STANDARD.EXCEPTIONS_CURRENT_disp
	BRA	STANDARD.exc_raise_
	BRA	L6
L7:
L6:					; post if
	LI	0					; lieu resultat sur pile
	La  1,	-NAME_ofs
	CALL	STANDARD.TEXT_IO.CREATE_L1. ,CREATE_SYSTEM_CALL_L1
	Sd  1,	ERR_OR_ID_disp
					; debut if
	Ld 1,	ERR_OR_ID_disp
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	0
	CGE
	BF	L9
	La 1, -FILE_ofs
	LIVA 	, 0, STANDARD.TEXT_IO._FILE_TYPE.ID
	Ld 1,	ERR_OR_ID_disp
	Sd
	La 1, -FILE_ofs
	LIVA 	, 0, STANDARD.TEXT_IO._FILE_TYPE.NAME
	LVA	1, -NAME_ofs
	LIa	, , 8
	Ld	, _STRING.LST_1
	LVA	1, -NAME_ofs
	LIa	, , 8
	Ld	, _STRING.FST_1
	SUB
	INC
	CLAMP0
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	1
	SUB
	INC
	CLAMP0
	LI	1
	MUL
	La  1,	-NAME_ofs
	La
	BLKMOV
	La 1, -FILE_ofs
