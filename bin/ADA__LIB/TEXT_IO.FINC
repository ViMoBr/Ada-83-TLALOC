; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	1
	NEG
	CEQ
	BF	L133
VAR	IL135_disp, d				; compteur boucle LOOP__4
	LVA	1, -ITEM_ofs
	LIa	, , 8
	Ld	, STRING.FST_1
	Sd  1,	IL135_disp
VAR	LMT_IL135_disp, d			; limite boucle LOOP__4
	LVA	1, -ITEM_ofs
	LIa	, , 8
	Ld	, STRING.LST_1
	Sd  1,	LMT_IL135_disp
	Ld  1,	IL135_disp				; test null range LOOP__4
	Ld  1,	LMT_IL135_disp
	CGT
	BT	L134
LOOP__4:					; corps boucle LOOP__4
	LVA	1, -ITEM_ofs
	LIa	, , 0				; array data start address on stack
	Ld	1, IL135_disp
	LVA	1, -ITEM_ofs
	LIa	, , 8
	Ld	, STANDARD.STRING.FST_1			; (index - FST_1) * SIZ_1
	SUB
	LVA	1, -ITEM_ofs
	LIa	, , 8
	Ld	, STANDARD.STRING.COMP_SIZ
	LI	8
	DIV
	MUL
	ADD					; add offset to start address
	Lb					; charge depuis adresse empilee 
	La  1,	-FILE_ofs
	CALL	STANDARD.TEXT_IO. ,GET_L49
	Ld  1,	IL135_disp				; test de sortie LOOP__4
	Ld  1,	LMT_IL135_disp
	CEQ
	BT	L134
	Ld  1,	IL135_disp				; mise a jour compteur LOOP__4
	INC
	Sd  1,	IL135_disp
	BRA	LOOP__4				; iteration suivante LOOP__4
L134:					; post loop LOOP__4
	BRA	L132
L133:
	LI	0					; lieu resultat sur pile
	LVA	1, -ITEM_ofs
	LIa	, , 8
	Ld	, STRING.LST_1
	INC
	LVA	1, -ITEM_ofs
	LIa	, , 8
	Ld	, STRING.FST_1
	SUB
	La 1, -FILE_ofs
	LId	, 0, STANDARD.TEXT_IO.FILE_TYPE.ID
	CALL	STANDARD.TEXT_IO.GET_L53. ,READ_SYSTEM_CALL_L131
	Sd  1,	BYTES_READ_disp
L132:					; post if
