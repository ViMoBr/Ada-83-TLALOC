	LI	32
	Sd	0, SIZ
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	2
	Sd	0, FST
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	16
	Sd	0, LST
VAR PARENT__u, q
	La	0, STANDARD._INTEGER.use__info
	Sa	0, PARENT__u
end namespace

					; _TYPE_SET ENUMERATION TYPE INFO
_TYPE_SET = '_TYPE_SET'
namespace _TYPE_SET
VAR use__info, q
BEGIN_BLOC_DEF
db 0, 10, "LOWER_CASE"
db 1, 10, "UPPER_CASE"
END_BLOC_DEF
IMAGES	BYTES_BLOC
CST LST, d, 1
CST FST, d, 0
CST SIZ, d, 8	; SIZ en bits !
postpone
  align_q
end postpone
	LCA	SIZ
	Sa	0, use__info
end namespace
