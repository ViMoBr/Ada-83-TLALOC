PRA_WALK = 'PRA_WALK'
namespace PRA_WALK				;---------- PACKAGE
elab_spec:				;    SPEC ELAB

					;    BODY ELAB

if defined WALK_PRAGMA_L1_
PRO	WALK_PRAGMA_L1				;---------- PRO WALK_PRAGMA
PRMS					;    debut parametrage
	PRM USED_NAME_ID_ofs			; in
	PRM GEN_ASSOC_S_ofs			; in
	PRM H_ofs				; in
endPRMS					;    fin parametrage
ELB 1					;    BODY ELAB
VAR DEFLIST_disp, q				; variable record : pointeur aux data record
VAR DEFLIST__u, q				; variable record : pointeur aux useinfo
VAR DEFLIST__dat, STANDARD.IDL.SEQ_TYPE.size
	LVA	1, DEFLIST__dat
	Sa	1, DEFLIST_disp				; record fin
	LVA	1, STANDARD.IDL.SEQ_TYPE.SIZ
	Sa	1, DEFLIST__u
; CODE_VC_NAME DN_VARIABLE_ID
	La  1, DEFLIST_disp
	LI	STANDARD.IDL.SEQ_TYPE.size
VAR	ANON_34_31_disp, q
VAR	ANON_34_31__u,    q
VAR	ANON_34_31__dat, STANDARD.IDL.SEQ_TYPE.size
	LVA 1, ANON_34_31__dat
	Sa  1, ANON_34_31_disp
	La  0, STANDARD.IDL.SEQ_TYPE.use__info
	Sa  1, ANON_34_31__u
	LVA 1, ANON_34_31_disp
					; doublet resultat record anonyme
VAR	ANON_34_37_disp, q
VAR	ANON_34_37__u,    q
VAR	ANON_34_37__dat, STANDARD.IDL.TREE.size
	LVA 1, ANON_34_37__dat
	Sa  1, ANON_34_37_disp
	La  0, STANDARD.IDL.TREE.use__info
	Sa  1, ANON_34_37__u
	LVA 1, ANON_34_37_disp
					; doublet resultat record anonyme
	La  1,	-USED_NAME_ID_ofs
	LI  13
	CALL	STANDARD.IDL. ,D_L17
	CALL	STANDARD.IDL. ,LIST_L22
	La  ,  0
	BLKMOV

VAR DEF_disp, q				; variable record : pointeur aux data record
VAR DEF__u, q				; variable record : pointeur aux useinfo
VAR DEF__dat, STANDARD.IDL.TREE.size
	LVA	1, DEF__dat
	Sa	1, DEF_disp				; record fin
	LVA	1, STANDARD.IDL.TREE.SIZ
	Sa	1, DEF__u
; CODE_VC_NAME DN_VARIABLE_ID

VAR PRAGMA_DEFN_disp, q			; variable record : pointeur aux data record
VAR PRAGMA_DEFN__u, q			; variable record : pointeur aux useinfo
VAR PRAGMA_DEFN__dat, STANDARD.IDL.TREE.size
	LVA	1, PRAGMA_DEFN__dat
	Sa	1, PRAGMA_DEFN_disp			; record fin
	LVA	1, STANDARD.IDL.TREE.SIZ
	Sa	1, PRAGMA_DEFN__u
; CODE_VC_NAME DN_VARIABLE_ID
	La  1, PRAGMA_DEFN_disp
	LI	STANDARD.IDL.TREE.size
	LVA 0,	STANDARD.IDL.TREE_VOID_disp
	La  ,  0
	BLKMOV

					;    end elab
begin:					;---------- BDY INSTRUCTIONS
LOOP__1:
	LI	0					; lieu resultat sur pile
	LVA 1,	DEFLIST_disp
	CALL	STANDARD.IDL. ,IS_EMPTY_L23
	LI	1
	OUX
	BF	L7
	LVA  1,	DEF_disp
	LVA  1,	DEFLIST_disp
	CALL	STANDARD.IDL. ,POP_L24
	LVA 1,	PRAGMA_DEFN_disp
	La
	LI	STANDARD.IDL.TREE.size
VAR	ANON_42_22_disp, q
VAR	ANON_42_22__u,    q
VAR	ANON_42_22__dat, STANDARD.IDL.TREE.size
	LVA 1, ANON_42_22__dat
	Sa  1, ANON_42_22_disp
	La  0, STANDARD.IDL.TREE.use__info
	Sa  1, ANON_42_22__u
	LVA 1, ANON_42_22_disp
					; doublet resultat record anonyme
	LVA 1,	DEF_disp
	LI  35
	CALL	STANDARD.IDL. ,D_L17
	La
	BLKMOV
					; debut if
	La	1, PRAGMA_DEFN_disp
	Ld
	LI	24
	LI	8
	UBFX
	LI	38
	CEQ
	BF	L9
	BRA	L7
	BRA	L8
L9:
	LVA 1,	PRAGMA_DEFN_disp
	La
	LI	STANDARD.IDL.TREE.size
	LVA 0,	STANDARD.IDL.TREE_VOID_disp
	La
	BLKMOV
L8:					; post if
	BRA	LOOP__1
L7:					; post loop LOOP__1
	LVA 1,	PRAGMA_DEFN_disp
	La  1,	-USED_NAME_ID_ofs
	LI  89
	CALL	STANDARD.IDL. ,D_L16
					; debut if
	LVA 1,	PRAGMA_DEFN_disp
	LVA 0,	STANDARD.IDL.TREE_VOID_disp
	CNE
	BF	L12
	LVA 0,	STANDARD.IDL.IDL_MAN.PRAGMA_CONTEXT_disp
	La
	LI	STANDARD.IDL.TREE.size
	La  1,	-USED_NAME_ID_ofs
	La
	BLKMOV
	La  1,	-H_ofs
	La  1,	-GEN_ASSOC_S_ofs
	La  1,	-USED_NAME_ID_ofs
	CALL	STANDARD.IDL.SEM_PHASE_L11.PRA_WALK. ,WALK_PRAGMA_ARGUMENTS_L2
	LVA 0,	STANDARD.IDL.IDL_MAN.PRAGMA_CONTEXT_disp
	La
	LI	STANDARD.IDL.TREE.size
	LVA 0,	STANDARD.IDL.TREE_VOID_disp
	La
	BLKMOV
					; debut if
VAR	ANON_66_10_disp, q
VAR	ANON_66_10__u,    q
VAR	ANON_66_10__dat, STANDARD.IDL.TREE.size
	LVA 1, ANON_66_10__dat
	Sa  1, ANON_66_10_disp
	La  0, STANDARD.IDL.TREE.use__info
	Sa  1, ANON_66_10__u
	LVA 1, ANON_66_10_disp
					; doublet resultat record anonyme
	La  1,	-USED_NAME_ID_ofs
	LI  89
	CALL	STANDARD.IDL. ,D_L17
	LVA 0,	STANDARD.IDL.TREE_VOID_disp
	CEQ
	BF	L14
	BRA	L13
L14:
L13:					; post if
	BRA	L11
L12:
; CODE & concat STRING
VAR	ANON_74_45_data, q
VAR	ANON_74_45_info, q
VAR	ANON_74_87_data, q
VAR	ANON_74_87_info, q
VAR	ANON_74_45_len,  q
VAR	ANON_74_87_len,  q
