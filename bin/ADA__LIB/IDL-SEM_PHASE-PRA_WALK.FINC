	CALL	STANDARD.IDL. ,PRINT_NAME_L25
	DUP
	La  ,  0
	Sa  1, ANON_74_87_data
	La  ,  8
	Sa  1, ANON_74_87_info
	LId 1, ANON_74_87_info, STRING.LST_1
	LId 1, ANON_74_87_info, STRING.FST_1
	SUB
	INC
	Sa  1, ANON_74_87_len
	La  1, ANON_74_45_len
	La  1, ANON_74_87_len
	ADD
	CO_VAR
	Sa  1, ANON_74_45_disp
	LI	1
	Sd  1, ANON_74_45_info._FST_1
	La  1, ANON_74_45_len
	La  1, ANON_74_87_len
	ADD
	Sd  1, ANON_74_45_info._LST_1
	LI	8
	Sd  1, ANON_74_45_info._COMP_SIZ
	La  1, ANON_74_45_len
	La  1, ANON_74_87_len
	ADD
	LI	8
	MUL
	Sd  1, ANON_74_45_info.SIZ
	LVA 1, ANON_74_45_info.SIZ
	Sa  1, ANON_74_45__u
	La  1, ANON_74_45_disp
	La  1, ANON_74_45_len
	La  1, ANON_74_45_data
	BLKMOV
	La  1, ANON_74_45_disp
	La  1, ANON_74_45_len
	ADD
	La  1, ANON_74_87_len
	La  1, ANON_74_87_data
	BLKMOV
	LVA 1, ANON_74_45_disp
VAR	ANON_74_16_disp, q
