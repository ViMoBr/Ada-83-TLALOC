STR ANON_74_45, "PRAGMA NOT KNOWN TO IMPLEMENTATION - "	; constante string="PRAGMA NOT KNOWN TO IMPLEMENTATION - "
	LCA	ANON_74_45.data_ptr
	DUP
	La  ,  0
	Sa  1, ANON_74_45_data
	La  ,  8
	Sa  1, ANON_74_45_info
	LId 1, ANON_74_45_info, STRING.LST_1
	LId 1, ANON_74_45_info, STRING.FST_1
