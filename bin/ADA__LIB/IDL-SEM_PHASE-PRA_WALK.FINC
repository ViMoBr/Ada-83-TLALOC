	La  1, ANON_74_87_L15_D_len
	ADD
	CO_VAR
	Sa  1, ANON_74_45_L15_R_disp
	LI	1
	Sd  1, ANON_74_45_L15_R_info._FST_1
	La  1, ANON_74_45_L15_G_len
	La  1, ANON_74_87_L15_D_len
