if defined PRINT_REAL_L6_
PRO	PRINT_REAL_L6				;---------- PRO PRINT_REAL
PRMS					;    debut parametrage
	PRM R_ofs				; in
endPRMS					;    fin parametrage
ELB 1					;    BODY ELAB
					;    end elab
begin:					;---------- BDY INSTRUCTIONS
					; debut if
	La 1, -R_ofs
	LIb	, 0, STANDARD.IDL.TREE.TY
	LI	219
	CEQ
	BF	L8
VAR	ANON_28_19_disp, q
VAR	ANON_28_19__u,    q
VAR	ANON_28_19__dat, STANDARD.IDL.TREE.size
	LVA 1, ANON_28_19__dat
	Sa  1, ANON_28_19_disp
	La  0, STANDARD.IDL.TREE.use__info
	Sa  1, ANON_28_19__u
	LVA 1, ANON_28_19_disp
					; doublet resultat record anonyme
	La  1,	-R_ofs
	LI  160
	CALL	STANDARD.IDL. ,D_L13
	CALL	STANDARD.IDL.PRINT_NOD. ,PRINT_TREE_L28
STR STR_L9, "/"				; constante string="/"
	LCA	STR_L9.data_ptr
	CALL	STANDARD.TEXT_IO. ,PUT_L56
VAR	ANON_30_19_disp, q
VAR	ANON_30_19__u,    q
VAR	ANON_30_19__dat, STANDARD.IDL.TREE.size
	LVA 1, ANON_30_19__dat
	Sa  1, ANON_30_19_disp
	La  0, STANDARD.IDL.TREE.use__info
	Sa  1, ANON_30_19__u
	LVA 1, ANON_30_19_disp
					; doublet resultat record anonyme
	La  1,	-R_ofs
	LI  161
	CALL	STANDARD.IDL. ,D_L13
	CALL	STANDARD.IDL.PRINT_NOD. ,PRINT_TREE_L28
	BRA	L7
L8:
	La  1,	-R_ofs
	CALL	STANDARD.IDL.PRINT_NOD. ,PRINT_TREE_L28
L7:					; post if
ret_lbl:
	UNLINK 1
	RTD	prm_siz
excep:
endPRO					;---------- end PRO PRINT_REAL
end if

