if defined MAKE_VARIABLE_ID_L1_
PRO	MAKE_VARIABLE_ID_L1			;---------- PRO MAKE_VARIABLE_ID
PRMS					;    debut parametrage
	PRM LX_SRCPOS_ofs				; in
	PRM LX_SYMREP_ofs				; in
	PRM SM_OBJ_TYPE_ofs			; in
	PRM SM_INIT_EXP_ofs			; in
	PRM SM_RENAMES_OBJ_ofs			; in
	PRM SM_ADDRESS_ofs				; in
	PRM SM_IS_SHARED_ofs			; in
	PRM XD_REGION_ofs				; in
	PRM result__ofs				; resultat de fonction
endPRMS					;    fin parametrage
ELB 1					;    BODY ELAB
VAR NODE_disp, q				; variable record : pointeur aux data record
VAR NODE__u, q				; variable record : pointeur aux useinfo
VAR NODE__dat, STANDARD.IDL.TREE.size
	LVA	1, NODE__dat
	Sa	1, NODE_disp				; record fin
	LVA	1, STANDARD.IDL.TREE.SIZ
	Sa	1, NODE__u
	La  1, NODE_disp
	LI	STANDARD.IDL.TREE.size
VAR	ANON_25_22_disp, q
VAR	ANON_25_22__u,    q
VAR	ANON_25_22__dat, STANDARD.IDL.TREE.size
	LVA 1, ANON_25_22__dat
	Sa  1, ANON_25_22_disp
	La  0, STANDARD.IDL.TREE.use__info
	Sa  1, ANON_25_22__u
	LVA 1, ANON_25_22_disp
					; doublet resultat record anonyme
	LI  12
	CALL	STANDARD.IDL. ,MAKE_L11
	La  ,  0
	BLKMOV

					;    end elab
begin:					;---------- BDY INSTRUCTIONS
	La  1,	-LX_SRCPOS_ofs
	LVA 1,	NODE_disp
	LI	 154
	CALL	STANDARD.IDL. ,D_L12
	La  1,	-LX_SYMREP_ofs
	LVA 1,	NODE_disp
	LI	 13
	CALL	STANDARD.IDL. ,D_L12
	La  1,	-SM_OBJ_TYPE_ofs
	LVA 1,	NODE_disp
	LI	 15
	CALL	STANDARD.IDL. ,D_L12
	La  1,	-SM_INIT_EXP_ofs
	LVA 1,	NODE_disp
	LI	 24
	CALL	STANDARD.IDL. ,D_L12
	Lb  1,	-SM_RENAMES_OBJ_ofs
	LVA 1,	NODE_disp
	LI	 25
	CALL	STANDARD.IDL. ,DB_L14
	La  1,	-SM_ADDRESS_ofs
	LVA 1,	NODE_disp
	LI	 26
	CALL	STANDARD.IDL. ,D_L12
	Lb  1,	-SM_IS_SHARED_ofs
	LVA 1,	NODE_disp
	LI	 31
	CALL	STANDARD.IDL. ,DB_L14
	La  1,	-XD_REGION_ofs
	LVA 1,	NODE_disp
	LI	 14
	CALL	STANDARD.IDL. ,D_L12
; CODE_RETURN : EXPR TYPE = DN_RECORD
	La   1,	-result__ofs
	La  ,  0
	LI	STANDARD.IDL.TREE.size
	LVA 1,	NODE_disp
	La  ,  0
	BLKMOV
	BRA ret_lbl
ret_lbl:
	UNLINK 1
	RTD	prm_siz-8
excep:
endPRO					;---------- end PRO MAKE_VARIABLE_ID
end if

