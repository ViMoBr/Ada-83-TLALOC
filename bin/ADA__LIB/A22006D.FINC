					;    end elab
begin:					;---------- BDY INSTRUCTIONS
; CODE & concat _STRING
VAR	ANON_16_23_L4_G_data, q
VAR	ANON_16_23_L4_G_info, q
VAR	ANON_17_23_L4_D_data, q
VAR	ANON_17_23_L4_D_info, q
VAR	ANON_16_23_L4_G_len,  q
VAR	ANON_17_23_L4_D_len,  q
VAR	ANON_16_23_L4_R_disp, q
VAR	ANON_16_23_L4_R__u,   q
namespace ANON_16_23_L4_R_info
  VAR SIZ,      d
  VAR _COMP_SIZ, d
  VAR _FST_1,    d
  VAR _LST_1,    d
end namespace
STR ANON_16_23_L4_G, "CHECK THAT A COMPILATION CAN BE PRECEDED "	; constante string="CHECK THAT A COMPILATION CAN BE PRECEDED "
	LCA	ANON_16_23_L4_G.data_ptr
	DUP
	La  ,  0
	Sa  1, ANON_16_23_L4_G_data
	La  ,  8
	Sa  1, ANON_16_23_L4_G_info
	LId 1, ANON_16_23_L4_G_info, _STRING.LST_1
	LId 1, ANON_16_23_L4_G_info, _STRING.FST_1
	SUB
	INC
	CLAMP0
	Sa  1, ANON_16_23_L4_G_len
STR ANON_17_23_L4_D, "BY SPACE AND HORIZONTAL TABULATION CHARACTERS"	; constante string="BY SPACE AND HORIZONTAL TABULATION CHARACTERS"
	LCA	ANON_17_23_L4_D.data_ptr
	DUP
	La  ,  0
	Sa  1, ANON_17_23_L4_D_data
	La  ,  8
	Sa  1, ANON_17_23_L4_D_info
	LId 1, ANON_17_23_L4_D_info, _STRING.LST_1
	LId 1, ANON_17_23_L4_D_info, _STRING.FST_1
	SUB
	INC
	CLAMP0
	Sa  1, ANON_17_23_L4_D_len
	La  1, ANON_16_23_L4_G_len
	La  1, ANON_17_23_L4_D_len
	ADD
	CO_VAR
	Sa  1, ANON_16_23_L4_R_disp
	LI	1
	Sd  1, ANON_16_23_L4_R_info._FST_1
	La  1, ANON_16_23_L4_G_len
	La  1, ANON_17_23_L4_D_len
	ADD
	Sd  1, ANON_16_23_L4_R_info._LST_1
	LI	8
	Sd  1, ANON_16_23_L4_R_info._COMP_SIZ
	La  1, ANON_16_23_L4_G_len
	La  1, ANON_17_23_L4_D_len
	ADD
	LI	8
	MUL
	Sd  1, ANON_16_23_L4_R_info.SIZ
	LVA 1, ANON_16_23_L4_R_info.SIZ
	Sa  1, ANON_16_23_L4_R__u
	La  1, ANON_16_23_L4_R_disp
	La  1, ANON_16_23_L4_G_len
	La  1, ANON_16_23_L4_G_data
	BLKMOV
	La  1, ANON_16_23_L4_R_disp
	La  1, ANON_16_23_L4_G_len
	ADD
	La  1, ANON_17_23_L4_D_len
	La  1, ANON_17_23_L4_D_data
	BLKMOV
	LVA 1, ANON_16_23_L4_R_disp
STR STR_L5, "A22006D"			; constante string="A22006D"
	LCA	STR_L5.data_ptr
	CALL	STANDARD.REPORT. ,TEST_L1
