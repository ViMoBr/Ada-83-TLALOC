TROU_SEL1 = 'TROU_SEL1'
PRO	TROU_SEL1_L1				;---------- PRO TROU_SEL1
 hexa_show 'TROU_SEL1_L1 ', $
ELB 1					;    BODY ELAB

					; _REC RECORD TYPE INFO
_REC = '_REC'
namespace _REC
VAR use__info, q
VAR SIZ, d
	LVA	1, SIZ
	Sa	1, use__info
USEINFO 1, A, 	La 0, STANDARD._INTEGER.use__info
USEINFO 1, B, 	La 0, STANDARD._CHARACTER.use__info
virtual at 0				; calcul des offsets statiques
STATOFS A, 4, 4
STATOFS B, 1, 1
size = $
end virtual
	LI	 size*8
	Sd	1, SIZ
end namespace
 hexa_show 'var elab I ', $
VAR I_disp, d				; variable entiere

 hexa_show ' disp ', I_disp
 hexa_show 'var elab C ', $
VAR C_disp, b				; variable bool char enum

 hexa_show ' disp ', C_disp

if defined MK_L2_
PRO	MK_L2					;---------- PRO MK
 hexa_show 'MK_L2 ', $
PRMS					;    debut parametrage
	PRM N_ofs				; in
	PRM result__ofs				; resultat de fonction
endPRMS					;    fin parametrage
ELB 2					;    BODY ELAB
					;    end elab
begin:					;---------- BDY INSTRUCTIONS
; CODE_RETURN : EXPR TYPE = DN_RECORD  VUE COMPLETE = DN_RECORD
	La   2,	-result__ofs
	La  ,  0
					; Assign_record_aggregate type DN_RECORD
	DUP
	LVA	, STANDARD.TROU_SEL1_L1._REC.A
	Ld  2,	-N_ofs
	Sd
	DUP
	LVA	, STANDARD.TROU_SEL1_L1._REC.B
	LI	120
	Sb
	DROP
	BRA ret_lbl
ret_lbl:
	UNLINK 2
	RTD	prm_siz-8
excep:
endPRO					;---------- end PRO MK
end if
					;    end elab
begin:					;---------- BDY INSTRUCTIONS
VAR	ANON_24_12_disp, q
VAR	ANON_24_12__u,    q
VAR	ANON_24_12__dat, STANDARD.TROU_SEL1_L1._REC.size
	LVA 1, ANON_24_12__dat
	Sa  1, ANON_24_12_disp
	La  1, STANDARD.TROU_SEL1_L1._REC.use__info
	Sa  1, ANON_24_12__u
	LVA 1, ANON_24_12_disp
					; doublet resultat record anonyme
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	41
	CALL	STANDARD.TROU_SEL1_L1. ,MK_L2
	La
	Ld	, STANDARD.TROU_SEL1_L1._REC.A
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	1
	ADD
	Sd  1,	I_disp
					; debut if
	Ld 1,	I_disp
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	42
	CNE
	BF	L8
	LCA	STANDARD.PROGRAM_ERROR__exc.data_ptr
	Sa	0, STANDARD.EXCEPTIONS_CURRENT_disp
	BRA	STANDARD.exc_raise_
	BRA	L7
L8:
L7:					; post if
VAR	ANON_28_12_disp, q
VAR	ANON_28_12__u,    q
VAR	ANON_28_12__dat, STANDARD.TROU_SEL1_L1._REC.size
	LVA 1, ANON_28_12__dat
	Sa  1, ANON_28_12_disp
	La  1, STANDARD.TROU_SEL1_L1._REC.use__info
	Sa  1, ANON_28_12__u
	LVA 1, ANON_28_12_disp
					; doublet resultat record anonyme
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	7
	CALL	STANDARD.TROU_SEL1_L1. ,MK_L2
	La
	ULb	, STANDARD.TROU_SEL1_L1._REC.B
	Sb  1,	C_disp
					; debut if
	ULb 1,	C_disp
	LI	120
	CNE
	BF	L10
	LCA	STANDARD.PROGRAM_ERROR__exc.data_ptr
	Sa	0, STANDARD.EXCEPTIONS_CURRENT_disp
	BRA	STANDARD.exc_raise_
	BRA	L9
L10:
L9:					; post if
ret_lbl:
	UNLINK 1
	RTD
excep:
endPRO					;---------- end PRO TROU_SEL1
