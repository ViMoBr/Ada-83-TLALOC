	Sa	2, OBJ_TYPE_disp			; record fin
	LVA	2, STANDARD.IDL._TREE.SIZ
	Sa	2, OBJ_TYPE__u
; CODE_VC_NAME DN_VARIABLE_ID
	La  2, OBJ_TYPE_disp
	LI	STANDARD.IDL._TREE.size
VAR	ANON_523_30_disp, q
VAR	ANON_523_30__u,    q
VAR	ANON_523_30__dat, STANDARD.IDL._TREE.size
