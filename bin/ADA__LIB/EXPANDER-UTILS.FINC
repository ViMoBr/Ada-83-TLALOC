	LI  35
	CALL	STANDARD.IDL. ,D_L17
	CALL	STANDARD.EXPANDER_L1.EXPRESSIONS. ,IS_GENERIC_FORMAL_TYPE_L50
	Sb  2,	HAS_GENERIC_TYPE_disp

