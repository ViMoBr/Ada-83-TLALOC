if defined OPEN_OUTPUT_FILE_L6_
PRO	OPEN_OUTPUT_FILE_L6			;---------- PRO OPEN_OUTPUT_FILE
PRMS					;    debut parametrage
	PRM FILE_NAME_ofs				; in
endPRMS					;    fin parametrage
ELB 1					;    BODY ELAB
					;    end elab
begin:					;---------- BDY INSTRUCTIONS
STR STR_L3, ""				; constante string=""
	LCA	STR_L3.data_ptr
; CODE & concat _STRING
VAR	ANON_32_28_L4_G_data, q
VAR	ANON_32_28_L4_G_info, q
VAR	ANON_32_79_L4_D_data, q
VAR	ANON_32_79_L4_D_info, q
VAR	ANON_32_28_L4_G_len,  q
VAR	ANON_32_79_L4_D_len,  q
VAR	ANON_32_28_L4_R_disp, q
VAR	ANON_32_28_L4_R__u,   q
namespace ANON_32_28_L4_R_info
  VAR SIZ,      d
  VAR _COMP_SIZ, d
  VAR _FST_1,    d
  VAR _LST_1,    d
end namespace
VAR	ANON_32_28_L4_G_slice_data, q
VAR	ANON_32_28_L4_G_slice_len,  q
VAR	ANON_32_28_L4_G_disp, q
VAR	ANON_32_28_L4_G__u,   q
namespace ANON_32_28_L4_G_info
  VAR SIZ,      d
  VAR _COMP_SIZ, d
  VAR _FST_1,    d
  VAR _LST_1,    d
end namespace
	LVA	1, -FILE_NAME_ofs
	LIa	, , 0
	LVA	1, -FILE_NAME_ofs
	LIa	, , 8
	Ld	, _STRING.FST_1
	LVA	1, -FILE_NAME_ofs
	LIa	, , 8
	Ld	, STANDARD._STRING.FST_1
	SUB
	LI	1
	MUL
	ADD
	LVA	1, -FILE_NAME_ofs
	LIa	, , 8
	Ld	, _STRING.LST_1
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	4
	SUB
	LVA	1, -FILE_NAME_ofs
	LIa	, , 8
	Ld	, _STRING.FST_1
	SUB
	INC
	CLAMP0
	LI	1
	MUL
	Sa  1, ANON_32_28_L4_G_slice_len
	Sa  1, ANON_32_28_L4_G_slice_data
	La  1, ANON_32_28_L4_G_slice_data
	Sa  1, ANON_32_28_L4_G_disp
	LVA 1, ANON_32_28_L4_G_info.SIZ
	Sa  1, ANON_32_28_L4_G__u
	LI	1
	Sd  1, ANON_32_28_L4_G_info._FST_1
	La  1, ANON_32_28_L4_G_slice_len
	Sd  1, ANON_32_28_L4_G_info._LST_1
	LI	8
	Sd  1, ANON_32_28_L4_G_info._COMP_SIZ
	La  1, ANON_32_28_L4_G_slice_len
	LI	8
	MUL
	Sd  1, ANON_32_28_L4_G_info.SIZ
	LVA 1, ANON_32_28_L4_G_disp
	DUP
	La  ,  0
	Sa  1, ANON_32_28_L4_G_data
	La  ,  8
	Sa  1, ANON_32_28_L4_G_info
	LId 1, ANON_32_28_L4_G_info, _STRING.LST_1
	LId 1, ANON_32_28_L4_G_info, _STRING.FST_1
	SUB
	INC
	CLAMP0
	Sa  1, ANON_32_28_L4_G_len
STR ANON_32_79_L4_D, ".FINC"			; constante string=".FINC"
	LCA	ANON_32_79_L4_D.data_ptr
	DUP
	La  ,  0
	Sa  1, ANON_32_79_L4_D_data
	La  ,  8
	Sa  1, ANON_32_79_L4_D_info
	LId 1, ANON_32_79_L4_D_info, _STRING.LST_1
	LId 1, ANON_32_79_L4_D_info, _STRING.FST_1
	SUB
	INC
	CLAMP0
	Sa  1, ANON_32_79_L4_D_len
	La  1, ANON_32_28_L4_G_len
	La  1, ANON_32_79_L4_D_len
	ADD
	CO_VAR
	Sa  1, ANON_32_28_L4_R_disp
	LI	1
	Sd  1, ANON_32_28_L4_R_info._FST_1
	La  1, ANON_32_28_L4_G_len
	La  1, ANON_32_79_L4_D_len
	ADD
	Sd  1, ANON_32_28_L4_R_info._LST_1
	LI	8
	Sd  1, ANON_32_28_L4_R_info._COMP_SIZ
	La  1, ANON_32_28_L4_G_len
	La  1, ANON_32_79_L4_D_len
	ADD
	LI	8
	MUL
	Sd  1, ANON_32_28_L4_R_info.SIZ
	LVA 1, ANON_32_28_L4_R_info.SIZ
	Sa  1, ANON_32_28_L4_R__u
	La  1, ANON_32_28_L4_R_disp
	La  1, ANON_32_28_L4_G_len
	La  1, ANON_32_28_L4_G_data
	BLKMOV
	La  1, ANON_32_28_L4_R_disp
	La  1, ANON_32_28_L4_G_len
	ADD
	La  1, ANON_32_79_L4_D_len
	La  1, ANON_32_79_L4_D_data
	BLKMOV
	LVA 1, ANON_32_28_L4_R_disp
	LI  1
	LVA  0,	STANDARD.EXPANDER_L1.UTILS.FS_disp
	CALL	STANDARD.TEXT_IO. ,CREATE_L1
	LVA 0,	STANDARD.EXPANDER_L1.UTILS.FS_disp
	CALL	STANDARD.TEXT_IO. ,SET_OUTPUT_L12
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	1
	Sd  0,	STANDARD.EXPANDER_L1.UTILS.INT_LABEL_disp
ret_lbl:
	UNLINK 1
	RTD	prm_siz
excep:
endPRO					;---------- end PRO OPEN_OUTPUT_FILE
end if

if defined CLOSE_OUTPUT_FILE_L7_
PRO	CLOSE_OUTPUT_FILE_L7			;---------- PRO CLOSE_OUTPUT_FILE
ELB 1					;    BODY ELAB
					;    end elab
begin:					;---------- BDY INSTRUCTIONS
VAR	ANON_45_18_disp, q
VAR	ANON_45_18__u,    q
