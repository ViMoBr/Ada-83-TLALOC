	LI	STANDARD.IDL._TREE.size
	La  1,	-NAME_ID_ofs
	La  ,  0
	BLKMOV

					;    end elab
begin:					;---------- BDY INSTRUCTIONS
LOOP__30:
	La	1, STANDARD.EXPANDER_L1.UTILS.LAST_OF_SELECTED_L34.TEMP_NAME_disp
	Ld
	LI	24
	LI	8
	UBFX
	LI	137
	CEQ
	BF	L564
	LVA 1,	TEMP_NAME_disp
	La
	LI	STANDARD.IDL._TREE.size
