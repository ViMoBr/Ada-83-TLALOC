PRO	LAST_OF_SELECTED_L32			;---------- PRO LAST_OF_SELECTED
 hexa_show 'LAST_OF_SELECTED_L32 ', $
PRMS					;    debut parametrage
	PRM NAME_ID_ofs				; in
	PRM result__ofs				; resultat de fonction
endPRMS					;    fin parametrage
ELB 1					;    BODY ELAB
 hexa_show 'var elab TEMP_NAME ', $
 hexa_show ' disp ', TEMP_NAME_disp
VAR TEMP_NAME_disp, q			; variable record : pointeur aux data record
VAR TEMP_NAME__u, q				; variable record : pointeur aux useinfo
VAR TEMP_NAME__dat, STANDARD.IDL._TREE.size
	LVA	1, TEMP_NAME__dat
	Sa	1, TEMP_NAME_disp			; record fin
	LVA	1, STANDARD.IDL._TREE.SIZ
	Sa	1, TEMP_NAME__u
; CODE_VC_NAME DN_VARIABLE_ID
	La  1, TEMP_NAME_disp
	LI	STANDARD.IDL._TREE.size
	La  1,	-NAME_ID_ofs
	La  ,  0
	BLKMOV

					;    end elab
