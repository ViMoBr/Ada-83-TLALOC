if defined LAST_OF_SELECTED_L35_
PRO	LAST_OF_SELECTED_L35			;---------- PRO LAST_OF_SELECTED
 hexa_show 'LAST_OF_SELECTED_L35 ', $
PRMS					;    debut parametrage
	PRM NAME_ID_ofs				; in
	PRM result__ofs				; resultat de fonction
endPRMS					;    fin parametrage
ELB 1					;    BODY ELAB
 hexa_show 'var elab TEMP_NAME ', $
VAR TEMP_NAME_disp, q			; variable record : pointeur aux data record
VAR TEMP_NAME__u, q				; variable record : pointeur aux useinfo
VAR TEMP_NAME__dat, STANDARD.IDL._TREE.size
	LVA	1, TEMP_NAME__dat
	Sa	1, TEMP_NAME_disp			; record fin
	LVA	1, STANDARD.IDL._TREE.SIZ
	Sa	1, TEMP_NAME__u
	La  1, TEMP_NAME_disp
	LI	STANDARD.IDL._TREE.size
	La  1,	-NAME_ID_ofs
	La  ,  0
	BLKMOV

 hexa_show ' disp ', TEMP_NAME_disp
					;    end elab
begin:					;---------- BDY INSTRUCTIONS
LOOP__30:
	La	1, STANDARD.EXPANDER_L1.UTILS.LAST_OF_SELECTED_L35.TEMP_NAME_disp
	Ld
	LI	24
	LI	8
	UBFX
	LI	137
	CEQ
	BF	L589
	LVA 1,	TEMP_NAME_disp
	La
	LI	STANDARD.IDL._TREE.size
VAR	ANON_1055_20_disp, q
VAR	ANON_1055_20__u,    q
VAR	ANON_1055_20__dat, STANDARD.IDL._TREE.size
	LVA 1, ANON_1055_20__dat
	Sa  1, ANON_1055_20_disp
	La  0, STANDARD.IDL._TREE.use__info
	Sa  1, ANON_1055_20__u
	LVA 1, ANON_1055_20_disp
					; doublet resultat record anonyme
	LVA 1,	TEMP_NAME_disp
	LI  91
	CALL	STANDARD.IDL. ,D_L17
	La
	BLKMOV
	BRA	LOOP__30
L589:					; post loop LOOP__30
; CODE_RETURN : EXPR TYPE = DN_RECORD  VUE COMPLETE = DN_RECORD
	La   1,	-result__ofs
	La  ,  0
	LI	STANDARD.IDL._TREE.size
	LVA 1,	TEMP_NAME_disp
	La
	BLKMOV
	BRA ret_lbl
ret_lbl:
	UNLINK 1
	RTD	prm_siz-8
excep:
endPRO					;---------- end PRO LAST_OF_SELECTED
end if
begin:					;---------- package BDY INSTRUCTIONS
end namespace 				;---------- end package BDY UTILS

