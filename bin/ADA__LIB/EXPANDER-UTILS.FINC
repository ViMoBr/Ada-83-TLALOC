	DROP
L208:
	DUP
	BF	L207
	DROP
	LI	0					; lieu resultat sur pile
	La  1,	-DEFN_ofs
	CALL	STANDARD.EXPANDER_L1.EXPRESSIONS. ,IS_GENERIC_FORMAL_OBJECT_L51
L207:
	BF	L206
namespace	BLOCK__12
ELB 2					;    BODY ELAB
VAR DEFN_STR_disp, q			; variable array : pointeur aux data
VAR DEFN_STR__u, q				; variable array : useinfo pointeur au rec info
