VAR	ANON_992_20__dat, STANDARD.IDL._TREE.size
	LVA 1, ANON_992_20__dat
	Sa  1, ANON_992_20_disp
	La  0, STANDARD.IDL._TREE.use__info
	Sa  1, ANON_992_20__u
	LVA 1, ANON_992_20_disp
