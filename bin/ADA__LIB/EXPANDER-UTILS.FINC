if defined OPEN_OUTPUT_FILE_L1_
PRO	OPEN_OUTPUT_FILE_L1			;---------- PRO OPEN_OUTPUT_FILE
PRMS					;    debut parametrage
	PRM FILE_NAME_ofs				; in
endPRMS					;    fin parametrage
ELB 1					;    BODY ELAB
					;    end elab
begin:					;---------- BDY INSTRUCTIONS
STR STR_L18, ""				; constante string=""
	LCA	STR_L18.data_ptr
; CODE & concat STRING
VAR	ANON_25_28_data, q
VAR	ANON_25_28_info, q
VAR	ANON_25_79_data, q
VAR	ANON_25_79_info, q
VAR	ANON_25_28_len,  q
VAR	ANON_25_79_len,  q
VAR	ANON_25_28_disp, q
VAR	ANON_25_28__u,   q
namespace ANON_25_28_info
  VAR SIZ,      d
  VAR _COMP_SIZ, d
  VAR _FST_1,    d
  VAR _LST_1,    d
end namespace
VAR	ANON_25_28_slice_data, q
VAR	ANON_25_28_slice_len,  q
VAR	ANON_25_28_disp, q
VAR	ANON_25_28__u,   q
namespace ANON_25_28_info
  VAR SIZ,      d
  VAR _COMP_SIZ, d
  VAR _FST_1,    d
  VAR _LST_1,    d
end namespace
	La 1, FILE_NAME_disp
	LVA	1, -FILE_NAME_ofs
	LIa	, , 8
	Ld	, STRING.FST_1
	LId 1, FILE_NAME__u, STRING.FST_1
	SUB
	LI	1
	MUL
	ADD
	LVA	1, -FILE_NAME_ofs
	LIa	, , 8
	Ld	, STRING.LST_1
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	4
	SUB
	INC
	LVA	1, -FILE_NAME_ofs
	LIa	, , 8
	Ld	, STRING.FST_1
	SUB
	LI	1
	MUL
	Sa  1, ANON_25_28_slice_len
	Sa  1, ANON_25_28_slice_data
	La  1, ANON_25_28_slice_data
	Sa  1, ANON_25_28_disp
	LVA 1, ANON_25_28_info.SIZ
	Sa  1, ANON_25_28__u
	LI	1
	Sd  1, ANON_25_28_info._FST_1
	La  1, ANON_25_28_slice_len
	Sd  1, ANON_25_28_info._LST_1
	LI	8
	Sd  1, ANON_25_28_info._COMP_SIZ
	La  1, ANON_25_28_slice_len
	LI	8
	MUL
	Sd  1, ANON_25_28_info.SIZ
	LVA 1, ANON_25_28_disp
	DUP
	La  ,  0
	Sa  1, ANON_25_28_data
	La  ,  8
	Sa  1, ANON_25_28_info
	LId 1, ANON_25_28_info, STRING.LST_1
	LId 1, ANON_25_28_info, STRING.FST_1
	SUB
	INC
	Sa  1, ANON_25_28_len
STR ANON_25_79, ".FINC"			; constante string=".FINC"
	LCA	ANON_25_79.data_ptr
	DUP
	La  ,  0
	Sa  1, ANON_25_79_data
	La  ,  8
	Sa  1, ANON_25_79_info
	LId 1, ANON_25_79_info, STRING.LST_1
	LId 1, ANON_25_79_info, STRING.FST_1
	SUB
	INC
	Sa  1, ANON_25_79_len
	La  1, ANON_25_28_len
	La  1, ANON_25_79_len
	ADD
	CO_VAR
	Sa  1, ANON_25_28_disp
	LI	1
	Sd  1, ANON_25_28_info._FST_1
	La  1, ANON_25_28_len
	La  1, ANON_25_79_len
	ADD
	Sd  1, ANON_25_28_info._LST_1
	LI	8
	Sd  1, ANON_25_28_info._COMP_SIZ
	La  1, ANON_25_28_len
	La  1, ANON_25_79_len
	ADD
	LI	8
	MUL
	Sd  1, ANON_25_28_info.SIZ
	LVA 1, ANON_25_28_info.SIZ
	Sa  1, ANON_25_28__u
	La  1, ANON_25_28_disp
	La  1, ANON_25_28_len
	La  1, ANON_25_28_data
	BLKMOV
	La  1, ANON_25_28_disp
	La  1, ANON_25_28_len
	ADD
	La  1, ANON_25_79_len
	La  1, ANON_25_79_data
	BLKMOV
	LVA 1, ANON_25_28_disp
	LI  1
	LVA  0,	FS_disp
	CALL	STANDARD.TEXT_IO. ,CREATE_L1
	LVA 0,	STANDARD.EXPANDER_L1.UTILS.FS_disp
	CALL	STANDARD.TEXT_IO. ,SET_OUTPUT_L12
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	1
	Sd  0,	INT_LABEL_disp
ret_lbl:
	UNLINK 1
	RTD	prm_siz
excep:
endPRO					;---------- end PRO OPEN_OUTPUT_FILE
end if

if defined CLOSE_OUTPUT_FILE_L2_
PRO	CLOSE_OUTPUT_FILE_L2			;---------- PRO CLOSE_OUTPUT_FILE
ELB 1					;    BODY ELAB
					;    end elab
begin:					;---------- BDY INSTRUCTIONS
VAR	ANON_38_18_disp, q
VAR	ANON_38_18__u,    q
VAR	ANON_38_18__dat, STANDARD.TEXT_IO.FILE_TYPE.size
	LVA 1, ANON_38_18__dat
	Sa  1, ANON_38_18_disp
	La  0, STANDARD.TEXT_IO.FILE_TYPE.use__info
	Sa  1, ANON_38_18__u
	LVA 1, ANON_38_18_disp
					; doublet resultat record anonyme
	CALL	STANDARD.TEXT_IO. ,STANDARD_OUTPUT_L14
	CALL	STANDARD.TEXT_IO. ,SET_OUTPUT_L12
	LVA  0,	FS_disp
	CALL	STANDARD.TEXT_IO. ,CLOSE_L3
ret_lbl:
	UNLINK 1
	RTD
excep:
endPRO					;---------- end PRO CLOSE_OUTPUT_FILE
end if
