	La  0, STANDARD.IDL._TREE.use__info
	Sa  1, ANON_956_20__u
	LVA 1, ANON_956_20_disp
					; doublet resultat record anonyme
	LVA 1,	TEMP_NAME_disp
	LI  91
	CALL	STANDARD.IDL. ,D_L17
	La  ,  0
	BLKMOV
	BRA	LOOP__28
