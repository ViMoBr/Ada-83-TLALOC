	La  0, STANDARD.IDL._TREE.use__info
	Sa  2, ANON_522_51__u
	LVA 2, ANON_522_51_disp
					; doublet resultat record anonyme
	La  1,	-DEFN_ofs
	LI  13
	CALL	STANDARD.IDL. ,D_L17
	CALL	STANDARD.IDL. ,PRINT_NAME_L25
	DUP
	La
	Sa	2, DEFN_STR_disp			; array data ptr from function result
	La , 8
	Sa	2, DEFN_STR__u				; array info ptr from function result

VAR OBJ_TYPE_disp, q			; variable record : pointeur aux data record
VAR OBJ_TYPE__u, q				; variable record : pointeur aux useinfo
VAR OBJ_TYPE__dat, STANDARD.IDL._TREE.size
