UTILS = 'UTILS'
namespace UTILS				;---------- PACKAGE (BDY)
					;    BODY ELAB
 hexa_show 'var elab INT_LABEL ', $
 hexa_show ' disp ', INT_LABEL_disp
VAR INT_LABEL_disp, d			; variable entiere
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	1
	Sd  0,	STANDARD.EXPANDER_L1.UTILS.INT_LABEL_disp

 hexa_show 'var elab FS ', $
 hexa_show ' disp ', FS_disp
VAR FS_disp, q				; variable record : pointeur aux data record
VAR FS__u, q				; variable record : pointeur aux useinfo
VAR FS__dat, STANDARD.TEXT_IO._FILE_TYPE.size
	LVA	0, FS__dat
	Sa	0, FS_disp				; record fin
	LVA	0, STANDARD.TEXT_IO._FILE_TYPE.SIZ
	Sa	0, FS__u
; CODE_VC_NAME DN_VARIABLE_ID
	LIVa 0, STANDARD.EXPANDER_L1.UTILS.FS_disp, STANDARD.TEXT_IO._FILE_TYPE.ID
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	1
	NEG
	Sd
	LIVa 0, STANDARD.EXPANDER_L1.UTILS.FS_disp, STANDARD.TEXT_IO._FILE_TYPE.IS_OPENED
	LI	0
	Sb
	LIVa 0, STANDARD.EXPANDER_L1.UTILS.FS_disp, STANDARD.TEXT_IO._FILE_TYPE.PAGE_LENGTH
	ULd 0,	STANDARD.TEXT_IO.UNBOUNDED_disp
	Sd
	LIVa 0, STANDARD.EXPANDER_L1.UTILS.FS_disp, STANDARD.TEXT_IO._FILE_TYPE.LINE_LENGTH
	ULd 0,	STANDARD.TEXT_IO.UNBOUNDED_disp
	Sd
	LIVa 0, STANDARD.EXPANDER_L1.UTILS.FS_disp, STANDARD.TEXT_IO._FILE_TYPE.PAGE
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	1
	Sd
	LIVa 0, STANDARD.EXPANDER_L1.UTILS.FS_disp, STANDARD.TEXT_IO._FILE_TYPE.LINE
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	1
	Sd
	LIVa 0, STANDARD.EXPANDER_L1.UTILS.FS_disp, STANDARD.TEXT_IO._FILE_TYPE.COL
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	1
	Sd
	LIVa 0, STANDARD.EXPANDER_L1.UTILS.FS_disp, STANDARD.TEXT_IO._FILE_TYPE.IS_DEFAULT_IO
	LI	0
	Sb
	LIVa 0, STANDARD.EXPANDER_L1.UTILS.FS_disp, STANDARD.TEXT_IO._FILE_TYPE.LOOK_AHEAD
	LI	 0
	Sb
	LIVa 0, STANDARD.EXPANDER_L1.UTILS.FS_disp, STANDARD.TEXT_IO._FILE_TYPE.HAS_LOOK_AHEAD
	LI	0
	Sb
	LIVa 0, STANDARD.EXPANDER_L1.UTILS.FS_disp, STANDARD.TEXT_IO._FILE_TYPE.AT_END_OF_FILE
	LI	0
	Sb

 hexa_show 'var elab GA_NAME ', $
 hexa_show ' disp ', GA_NAME_disp
_GA_NAME__type = '_GA_NAME__type'
namespace _GA_NAME__type			; array var constrained array type info
VAR use__info, q
VAR SIZ, d
	LVA	0, SIZ
	Sa	0, use__info
VAR _COMP_SIZ, d
VAR _FST_1, d
VAR _LST_1, d
	LI	0
	Sd	0, _COMP_SIZ
	Ld	0, _COMP_SIZ
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	1
	Sd	0, _FST_1
; CODE_NUMERIC_LITERAL DN_UNIVERSAL_INTEGER
	LI	8
	Sd	0, _LST_1
	Ld	0, _LST_1
	Ld	0, _FST_1
	SUB
	INC
	CLAMP0
	MUL
	Sd	0, SIZ
  virtual at 4
COMP_SIZ = $
	rd 1 
FST_1 = $
	rd 1 
LST_1 = $
	rd 1 
  end virtual
end namespace
VAR GA_NAME_disp, q				; variable array : pointeur aux data
VAR GA_NAME__u, q				; variable array : useinfo pointeur au rec info
	La 0, _GA_NAME__type.use__info
	Sa	0, GA_NAME__u				; array info ptr at __u
	Ld	0, _GA_NAME__type.SIZ
	LI	8
	DIV
	CO_VAR
	Sa	0, GA_NAME_disp				; array data ptr at _disp

 hexa_show 'var elab GA_LEN ', $
 hexa_show ' disp ', GA_LEN_disp
_GA_LEN__type = '_GA_LEN__type'
