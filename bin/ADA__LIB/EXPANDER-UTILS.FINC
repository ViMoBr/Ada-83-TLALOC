	CLT
	BT	STANDARD.ce_raise_
	DUP
	Ld	0, STANDARD.TEXT_IO._FIELD.LST
	CGT
	BT	STANDARD.ce_raise_
	Sd  0,	STANDARD.EXPANDER_L1.UTILS.LBL_IO.DEFAULT_WIDTH_disp

