if defined OPEN_OUTPUT_FILE_L4_
PRO	OPEN_OUTPUT_FILE_L4			;---------- PRO OPEN_OUTPUT_FILE
PRMS					;    debut parametrage
	PRM FILE_NAME_ofs				; in
endPRMS					;    fin parametrage
ELB 1					;    BODY ELAB
					;    end elab
begin:					;---------- BDY INSTRUCTIONS
STR STR_L3, ""				; constante string=""
	LCA	STR_L3.data_ptr
; CODE & concat _STRING
VAR	ANON_37_28_L4_G_data, q
VAR	ANON_37_28_L4_G_info, q
VAR	ANON_37_79_L4_D_data, q
VAR	ANON_37_79_L4_D_info, q
VAR	ANON_37_28_L4_G_len,  q
VAR	ANON_37_79_L4_D_len,  q
VAR	ANON_37_28_L4_R_disp, q
VAR	ANON_37_28_L4_R__u,   q
namespace ANON_37_28_L4_R_info
  VAR SIZ,      d
  VAR _COMP_SIZ, d
  VAR _FST_1,    d
  VAR _LST_1,    d
end namespace
VAR	ANON_37_28_L4_G_slice_data, q
VAR	ANON_37_28_L4_G_slice_len,  q
VAR	ANON_37_28_L4_G_disp, q
VAR	ANON_37_28_L4_G__u,   q
namespace ANON_37_28_L4_G_info
  VAR SIZ,      d
  VAR _COMP_SIZ, d
  VAR _FST_1,    d
  VAR _LST_1,    d
end namespace
	LVA	1, -FILE_NAME_ofs
	LIa	, , 0
	LVA	1, -FILE_NAME_ofs
	LIa	, , 8
	Ld	, _STRING.FST_1
	LVA	1, -FILE_NAME_ofs
	LIa	, , 8
	Ld	, STANDARD._STRING.FST_1
	SUB
	LI	1
	MUL
	ADD
	LVA	1, -FILE_NAME_ofs
	LIa	, , 8
	Ld	, _STRING.LST_1
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	4
	SUB
	LVA	1, -FILE_NAME_ofs
	LIa	, , 8
	Ld	, _STRING.FST_1
	SUB
	INC
	CLAMP0
	LI	1
	MUL
	Sa  1, ANON_37_28_L4_G_slice_len
	Sa  1, ANON_37_28_L4_G_slice_data
	La  1, ANON_37_28_L4_G_slice_data
	Sa  1, ANON_37_28_L4_G_disp
	LVA 1, ANON_37_28_L4_G_info.SIZ
	Sa  1, ANON_37_28_L4_G__u
	LI	1
	Sd  1, ANON_37_28_L4_G_info._FST_1
	La  1, ANON_37_28_L4_G_slice_len
	Sd  1, ANON_37_28_L4_G_info._LST_1
	LI	8
	Sd  1, ANON_37_28_L4_G_info._COMP_SIZ
	La  1, ANON_37_28_L4_G_slice_len
	LI	8
	MUL
	Sd  1, ANON_37_28_L4_G_info.SIZ
	LVA 1, ANON_37_28_L4_G_disp
	DUP
	La  ,  0
	Sa  1, ANON_37_28_L4_G_data
	La  ,  8
	Sa  1, ANON_37_28_L4_G_info
	LId 1, ANON_37_28_L4_G_info, _STRING.LST_1
	LId 1, ANON_37_28_L4_G_info, _STRING.FST_1
	SUB
	INC
	CLAMP0
	Sa  1, ANON_37_28_L4_G_len
STR ANON_37_79_L4_D, ".FINC"			; constante string=".FINC"
	LCA	ANON_37_79_L4_D.data_ptr
	DUP
	La  ,  0
	Sa  1, ANON_37_79_L4_D_data
	La  ,  8
	Sa  1, ANON_37_79_L4_D_info
	LId 1, ANON_37_79_L4_D_info, _STRING.LST_1
	LId 1, ANON_37_79_L4_D_info, _STRING.FST_1
	SUB
	INC
	CLAMP0
	Sa  1, ANON_37_79_L4_D_len
	La  1, ANON_37_28_L4_G_len
	La  1, ANON_37_79_L4_D_len
	ADD
	CO_VAR
	Sa  1, ANON_37_28_L4_R_disp
	LI	1
	Sd  1, ANON_37_28_L4_R_info._FST_1
	La  1, ANON_37_28_L4_G_len
	La  1, ANON_37_79_L4_D_len
	ADD
	Sd  1, ANON_37_28_L4_R_info._LST_1
	LI	8
	Sd  1, ANON_37_28_L4_R_info._COMP_SIZ
	La  1, ANON_37_28_L4_G_len
	La  1, ANON_37_79_L4_D_len
	ADD
	LI	8
	MUL
	Sd  1, ANON_37_28_L4_R_info.SIZ
	LVA 1, ANON_37_28_L4_R_info.SIZ
	Sa  1, ANON_37_28_L4_R__u
	La  1, ANON_37_28_L4_R_disp
	La  1, ANON_37_28_L4_G_len
	La  1, ANON_37_28_L4_G_data
	BLKMOV
	La  1, ANON_37_28_L4_R_disp
	La  1, ANON_37_28_L4_G_len
	ADD
	La  1, ANON_37_79_L4_D_len
	La  1, ANON_37_79_L4_D_data
	BLKMOV
	LVA 1, ANON_37_28_L4_R_disp
	LI  1
	LVA  0,	STANDARD.EXPANDER_L1.UTILS.FS_disp
	CALL	STANDARD.TEXT_IO. ,CREATE_L1
	LVA 0,	STANDARD.EXPANDER_L1.UTILS.FS_disp
	CALL	STANDARD.TEXT_IO. ,SET_OUTPUT_L12
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	1
	Sd  0,	STANDARD.EXPANDER_L1.UTILS.INT_LABEL_disp
ret_lbl:
	UNLINK 1
	RTD	prm_siz
excep:
endPRO					;---------- end PRO OPEN_OUTPUT_FILE
end if

if defined CLOSE_OUTPUT_FILE_L5_
PRO	CLOSE_OUTPUT_FILE_L5			;---------- PRO CLOSE_OUTPUT_FILE
ELB 1					;    BODY ELAB
					;    end elab
begin:					;---------- BDY INSTRUCTIONS
VAR	ANON_50_18_disp, q
VAR	ANON_50_18__u,    q
VAR	ANON_50_18__dat, STANDARD.TEXT_IO._FILE_TYPE.size
	LVA 1, ANON_50_18__dat
	Sa  1, ANON_50_18_disp
	La  0, STANDARD.TEXT_IO._FILE_TYPE.use__info
	Sa  1, ANON_50_18__u
	LVA 1, ANON_50_18_disp
					; doublet resultat record anonyme
	CALL	STANDARD.TEXT_IO. ,STANDARD_OUTPUT_L14
	CALL	STANDARD.TEXT_IO. ,SET_OUTPUT_L12
	LVA  0,	STANDARD.EXPANDER_L1.UTILS.FS_disp
	CALL	STANDARD.TEXT_IO. ,CLOSE_L3
ret_lbl:
	UNLINK 1
	RTD
excep:
endPRO					;---------- end PRO CLOSE_OUTPUT_FILE
end if
INT_IO = 'INT_IO'
namespace INT_IO				;---------- GENERIC PACKAGE INSTANTIATION
elab_spec:				;    SPEC ELAB

; F4A SET  cle=NUM  actuel=DN_INTEGER
BRA post_LD_NUM
LD_NUM.elab:
	Ld -1, 0
	RTD 0
post_LD_NUM:
BRA post_ST_NUM
ST_NUM.elab:
	Sd -1, 0
	RTD 0
post_ST_NUM:
BRA post_INADR_NUM
INADR_NUM.elab:
	RTD 0
post_INADR_NUM:
BRA post_OUTADR_NUM
OUTADR_NUM.elab:
	La
	RTD 0
post_OUTADR_NUM:
VAR NUM__outadr_ofs, q
	LCA OUTADR_NUM.elab
	Sa	 0, NUM__outadr_ofs
VAR NUM__inadr_ofs, q
	LCA INADR_NUM.elab
	Sa	 0, NUM__inadr_ofs
VAR NUM__st_ofs, q
	LCA ST_NUM.elab
	Sa	 0, NUM__st_ofs
VAR NUM__ld_ofs, q
	LCA LD_NUM.elab
	Sa	 0, NUM__ld_ofs
VAR NUM__u_ofs, q
	La	 0, STANDARD._INTEGER.use__info
	Sa	 0, NUM__u_ofs
VAR GFP_disp, q				; Lieu du Generic Frame Pointer 
					; CODE_PACKAGE_SPEC
VAR DEFAULT_WIDTH_disp, d			; variable entiere
	LI	 11
	DUP
	Ld	0, STANDARD.TEXT_IO._FIELD.FST
	CLT
	BT	STANDARD.ce_raise_
	DUP
	Ld	0, STANDARD.TEXT_IO._FIELD.LST
	CGT
	BT	STANDARD.ce_raise_
	Sd  0,	STANDARD.EXPANDER_L1.UTILS.INT_IO.DEFAULT_WIDTH_disp

VAR DEFAULT_BASE_disp, d			; variable entiere
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	10
	DUP
	Ld	0, STANDARD.TEXT_IO._NUMBER_BASE.FST
	CLT
	BT	STANDARD.ce_raise_
	DUP
	Ld	0, STANDARD.TEXT_IO._NUMBER_BASE.LST
	CGT
	BT	STANDARD.ce_raise_
	Sd  0,	STANDARD.EXPANDER_L1.UTILS.INT_IO.DEFAULT_BASE_disp

					; sub program entry decl (in instantiation TRUE )
if defined GET_L7_
PRO	GET_L7				;---------- PRO GET
PRMS					;    debut parametrage
	PRM FILE_ofs				; in
	PRM ITEM_ofs				; out
	PRM WIDTH_ofs				; in
endPRMS					;    fin parametrage
ELB 1
begin:
	LVA	 0, GFP_disp
	Ld	 1, -WIDTH_ofs
	La 	 1, -ITEM_ofs
	La 	 1, -FILE_ofs
