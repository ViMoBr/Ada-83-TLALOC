if ~ definite TEXT_IO
include 'TEXT_IO.FINC'
end if
PRO	TEST_RENAMES_1_L1			;---------- PRO TEST_RENAMES_1
ELB 1					;    BODY ELAB
INT_IO = 'INT_IO'
namespace INT_IO				;---------- GENERIC PACKAGE INSTANTIATION
elab_spec:				;    SPEC ELAB

BRA post_LD_INTEGER
LD_INTEGER.elab:
	Ld -1, 0
	RTD 0
post_LD_INTEGER:
BRA post_ST_INTEGER
ST_INTEGER.elab:
	Sd -1, 0
	RTD 0
post_ST_INTEGER:
BRA post_INADR_INTEGER
INADR_INTEGER.elab:
	RTD 0
post_INADR_INTEGER:
BRA post_OUTADR_INTEGER
OUTADR_INTEGER.elab:
	La
	RTD 0
post_OUTADR_INTEGER:
VAR INTEGER__outadr_ofs, q
	LCA OUTADR_INTEGER.elab
	Sa	 1, INTEGER__outadr_ofs
VAR INTEGER__inadr_ofs, q
	LCA INADR_INTEGER.elab
	Sa	 1, INTEGER__inadr_ofs
VAR INTEGER__st_ofs, q
	LCA ST_INTEGER.elab
	Sa	 1, INTEGER__st_ofs
VAR INTEGER__ld_ofs, q
	LCA LD_INTEGER.elab
	Sa	 1, INTEGER__ld_ofs
VAR INTEGER__u_ofs, q
	La	 0, STANDARD.INTEGER.use__info
	Sa	 1, INTEGER__u_ofs
VAR GFP_disp, q				; Lieu du Generic Frame Pointer 
VAR DEFAULT_WIDTH_disp, d			; variable entiere
	LI	 11
	Sd  1,	DEFAULT_WIDTH_disp

VAR DEFAULT_BASE_disp, d			; variable entiere
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	10
	Sd  1,	DEFAULT_BASE_disp

if defined GET_L2_
PRO	GET_L2				;---------- PRO GET
PRMS					;    debut parametrage
	PRM FILE_ofs				; in
	PRM ITEM_ofs				; out
	PRM WIDTH_ofs				; in
endPRMS					;    fin parametrage
ELB 2
begin:
	LVA	 1, GFP_disp
	Ld	 2, -WIDTH_ofs
	La 	 2, -ITEM_ofs
	La 	 2, -FILE_ofs
	CALL	STANDARD.TEXT_IO.INTEGER_IO. ,GET_L61
	UNLINK	 2
	RTD	prm_siz
endPRO					;---------- end PRO GET
end if
if defined GET_L3_
PRO	GET_L3				;---------- PRO GET
PRMS					;    debut parametrage
	PRM ITEM_ofs				; out
	PRM WIDTH_ofs				; in
endPRMS					;    fin parametrage
ELB 2
begin:
	LVA	 1, GFP_disp
	Ld	 2, -WIDTH_ofs
	La 	 2, -ITEM_ofs
	CALL	STANDARD.TEXT_IO.INTEGER_IO. ,GET_L62
	UNLINK	 2
	RTD	prm_siz
endPRO					;---------- end PRO GET
end if
if defined PUT_L4_
PRO	PUT_L4				;---------- PRO PUT
PRMS					;    debut parametrage
	PRM FILE_ofs				; in
	PRM ITEM_ofs				; in
	PRM WIDTH_ofs				; in
	PRM BASE_ofs				; in
endPRMS					;    fin parametrage
ELB 2
begin:
	LVA	 1, GFP_disp
	Ld	 2, -BASE_ofs
	Ld	 2, -WIDTH_ofs
	Ld	 2, -ITEM_ofs
	La 	 2, -FILE_ofs
	CALL	STANDARD.TEXT_IO.INTEGER_IO. ,PUT_L63
	UNLINK	 2
	RTD	prm_siz
endPRO					;---------- end PRO PUT
end if
if defined PUT_L5_
PRO	PUT_L5				;---------- PRO PUT
PRMS					;    debut parametrage
	PRM ITEM_ofs				; in
	PRM WIDTH_ofs				; in
	PRM BASE_ofs				; in
endPRMS					;    fin parametrage
ELB 2
begin:
	LVA	 1, GFP_disp
	Ld	 2, -BASE_ofs
	Ld	 2, -WIDTH_ofs
	Ld	 2, -ITEM_ofs
	CALL	STANDARD.TEXT_IO.INTEGER_IO. ,PUT_L64
	UNLINK	 2
	RTD	prm_siz
endPRO					;---------- end PRO PUT
end if
if defined GET_L6_
PRO	GET_L6				;---------- PRO GET
PRMS					;    debut parametrage
	PRM FROM_ofs				; in
	PRM ITEM_ofs				; out
	PRM LAST_ofs				; out
endPRMS					;    fin parametrage
ELB 2
begin:
	LVA	 1, GFP_disp
	La 	 2, -LAST_ofs
	La 	 2, -ITEM_ofs
	La 	 2, -FROM_ofs
	CALL	STANDARD.TEXT_IO.INTEGER_IO. ,GET_L65
	UNLINK	 2
	RTD	prm_siz
endPRO					;---------- end PRO GET
end if
if defined PUT_L7_
PRO	PUT_L7				;---------- PRO PUT
PRMS					;    debut parametrage
	PRM TO_ofs				; out
	PRM ITEM_ofs				; in
	PRM BASE_ofs				; in
endPRMS					;    fin parametrage
ELB 2
begin:
	LVA	 1, GFP_disp
	Ld	 2, -BASE_ofs
	Ld	 2, -ITEM_ofs
	La 	 2, -TO_ofs
	CALL	STANDARD.TEXT_IO.INTEGER_IO. ,PUT_L66
	UNLINK	 2
	RTD	prm_siz
endPRO					;---------- end PRO PUT
end if
					;---------- end generic package instantiation INT_IO
end namespace


					; REC RECORD TYPE INFO
REC = 'REC'
namespace REC
VAR use__info, q
VAR SIZ, d
	LVA	1, SIZ
	Sa	1, use__info
USEINFO 1, A, 	La 0, STANDARD.INTEGER.use__info
USEINFO 1, B, 	La 0, STANDARD.INTEGER.use__info
virtual at 0				; calcul des offsets statiques
STATOFS A, 4
STATOFS B, 4
size = $
end virtual
	LI	 size*8
	Sd	1, SIZ
end namespace

					; array decl constrained array type info
TAB = 'TAB'
namespace TAB
VAR use__info, q
VAR SIZ, d
	LVA	1, SIZ
	Sa	1, use__info
VAR COMP_SIZ, d
VAR FST_1, d
VAR LST_1, d
	LI	64
	Sd	1, COMP_SIZ
	Ld	1, COMP_SIZ
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	1
	Sd	1, FST_1
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	3
	Sd	1, LST_1
	Ld	1, LST_1
	INC
	Ld	1, FST_1
	SUB
	MUL
	Sd	1, SIZ
  virtual at 4
COMP_SIZ = $
	rd 1 
FST_1 = $
	rd 1 
LST_1 = $
	rd 1 
  end virtual
end namespace
VAR R_disp, q				; variable record : pointeur aux data record
VAR R__u, q				; variable record : pointeur aux useinfo
VAR R__dat, STANDARD.TEST_RENAMES_1_L1.REC.size
	LVA	1, R__dat
	Sa	1, R_disp				; record fin
	LVA	1, STANDARD.TEST_RENAMES_1_L1.REC.SIZ
	Sa	1, R__u
	La 1, R_disp
	DUP
	LVA	, STANDARD.TEST_RENAMES_1_L1.REC.A
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	10
	Sd
	DUP
	LVA	, STANDARD.TEST_RENAMES_1_L1.REC.B
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	20
	Sd
	DROP

VAR T_disp, q				; variable array : pointeur aux data
VAR T__u, q				; variable array : useinfo pointeur au rec info
	La 1, TAB.use__info
	Sa	1, T__u				; array info ptr at __u
	Ld	1, TAB.SIZ
	LI	8
	DIV
	CO_VAR
	Sa	1, T_disp				; array data ptr at _disp
					; array data aggregate
	La	1, T_disp
	DUP
	DUP
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	1
	Sd
	LI	8
	ADD
	DUP
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	2
	Sd
	LI	8
	ADD
	DROP
	LI	8
	ADD
	DUP
	DUP
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	3
	Sd
	LI	8
	ADD
	DUP
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	4
	Sd
	LI	8
	ADD
	DROP
	LI	8
	ADD
	DUP
	DUP
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	5
	Sd
	LI	8
	ADD
	DUP
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	6
	Sd
	LI	8
	ADD
	DROP
	LI	8
	ADD
	DROP

VAR X_disp, q
	LIVA 	1, R_disp, STANDARD.TEST_RENAMES_1_L1.REC.B
	Sa	1, X_disp
VAR Y_disp, q
	La	 1, T_disp				; array data start address on stack
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	2
	LId	1, T__u, STANDARD.TEST_RENAMES_1_L1.TAB.FST_1	; (index - FST_1) * SIZ_1
	SUB
	LId	1, T__u, STANDARD.TEST_RENAMES_1_L1.TAB.COMP_SIZ
	LI	8
	DIV
	MUL
	ADD					; add offset to start address
	Sa	1, Y_disp
VAR Y__u, q
	LVA	1, STANDARD.TEST_RENAMES_1_L1.REC.SIZ
	Sa	1, Y__u
VAR R2_disp, q
	La	1, Y_disp
	Sa	1, R2_disp
VAR R2__u, q
	LVA	1, STANDARD.TEST_RENAMES_1_L1.REC.SIZ
	Sa	1, R2__u
					;    end elab
begin:					;---------- BDY INSTRUCTIONS
STR STR_L8, "X avant = "			; constante string="X avant = "
	LCA	STR_L8.data_ptr
	CALL	STANDARD.TEXT_IO. ,PUT_L56
	Ld 1,	STANDARD.TEST_RENAMES_1_L1.INT_IO.DEFAULT_BASE_disp
	Ld 1,	STANDARD.TEST_RENAMES_1_L1.INT_IO.DEFAULT_WIDTH_disp
	LId	1, X_disp, 0
	CALL	STANDARD.TEST_RENAMES_1_L1.INT_IO. ,PUT_L5
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	1
	CALL	STANDARD.TEXT_IO. ,NEW_LINE_L26
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	99
	SId	1, X_disp, 0
STR STR_L9, "R.B apres X := 99 = "		; constante string="R.B apres X := 99 = "
	LCA	STR_L9.data_ptr
	CALL	STANDARD.TEXT_IO. ,PUT_L56
	Ld 1,	STANDARD.TEST_RENAMES_1_L1.INT_IO.DEFAULT_BASE_disp
	Ld 1,	STANDARD.TEST_RENAMES_1_L1.INT_IO.DEFAULT_WIDTH_disp
	LId	1, R_disp, STANDARD.TEST_RENAMES_1_L1.REC.B
	CALL	STANDARD.TEST_RENAMES_1_L1.INT_IO. ,PUT_L5
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	1
	CALL	STANDARD.TEXT_IO. ,NEW_LINE_L26
	LIVA 	1, Y_disp, STANDARD.TEST_RENAMES_1_L1.REC.A
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	300
	Sd
	LIVA 	1, Y_disp, STANDARD.TEST_RENAMES_1_L1.REC.B
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	400
	Sd
STR STR_L10, "T(2).A = "			; constante string="T(2).A = "
	LCA	STR_L10.data_ptr
	CALL	STANDARD.TEXT_IO. ,PUT_L56
	Ld 1,	STANDARD.TEST_RENAMES_1_L1.INT_IO.DEFAULT_BASE_disp
	Ld 1,	STANDARD.TEST_RENAMES_1_L1.INT_IO.DEFAULT_WIDTH_disp
	La	 1, T_disp				; array data start address on stack
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	2
	LId	1, T__u, STANDARD.TEST_RENAMES_1_L1.TAB.FST_1	; (index - FST_1) * SIZ_1
	SUB
	LId	1, T__u, STANDARD.TEST_RENAMES_1_L1.TAB.COMP_SIZ
	LI	8
	DIV
	MUL
	ADD					; add offset to start address
	Ld	, STANDARD.TEST_RENAMES_1_L1.REC.A
	CALL	STANDARD.TEST_RENAMES_1_L1.INT_IO. ,PUT_L5
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	1
	CALL	STANDARD.TEXT_IO. ,NEW_LINE_L26
STR STR_L11, "T(2).B = "			; constante string="T(2).B = "
	LCA	STR_L11.data_ptr
	CALL	STANDARD.TEXT_IO. ,PUT_L56
	Ld 1,	STANDARD.TEST_RENAMES_1_L1.INT_IO.DEFAULT_BASE_disp
	Ld 1,	STANDARD.TEST_RENAMES_1_L1.INT_IO.DEFAULT_WIDTH_disp
	La	 1, T_disp				; array data start address on stack
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	2
	LId	1, T__u, STANDARD.TEST_RENAMES_1_L1.TAB.FST_1	; (index - FST_1) * SIZ_1
	SUB
	LId	1, T__u, STANDARD.TEST_RENAMES_1_L1.TAB.COMP_SIZ
	LI	8
	DIV
	MUL
	ADD					; add offset to start address
	Ld	, STANDARD.TEST_RENAMES_1_L1.REC.B
	CALL	STANDARD.TEST_RENAMES_1_L1.INT_IO. ,PUT_L5
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	1
	CALL	STANDARD.TEXT_IO. ,NEW_LINE_L26
	LVA	1, Y_disp
	La
	LI	STANDARD.TEST_RENAMES_1_L1.REC.size
	LVA 1,	R_disp
	La
	BLKMOV
	LIVA 	1, R_disp, STANDARD.TEST_RENAMES_1_L1.REC.A
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	111
	Sd
	LIVA 	1, R_disp, STANDARD.TEST_RENAMES_1_L1.REC.B
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	222
	Sd
STR STR_L12, "R.A = "			; constante string="R.A = "
	LCA	STR_L12.data_ptr
	CALL	STANDARD.TEXT_IO. ,PUT_L56
	Ld 1,	STANDARD.TEST_RENAMES_1_L1.INT_IO.DEFAULT_BASE_disp
	Ld 1,	STANDARD.TEST_RENAMES_1_L1.INT_IO.DEFAULT_WIDTH_disp
	LId	1, R_disp, STANDARD.TEST_RENAMES_1_L1.REC.A
	CALL	STANDARD.TEST_RENAMES_1_L1.INT_IO. ,PUT_L5
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	1
	CALL	STANDARD.TEXT_IO. ,NEW_LINE_L26
STR STR_L13, "R.B = "			; constante string="R.B = "
	LCA	STR_L13.data_ptr
	CALL	STANDARD.TEXT_IO. ,PUT_L56
	Ld 1,	STANDARD.TEST_RENAMES_1_L1.INT_IO.DEFAULT_BASE_disp
	Ld 1,	STANDARD.TEST_RENAMES_1_L1.INT_IO.DEFAULT_WIDTH_disp
	LId	1, R_disp, STANDARD.TEST_RENAMES_1_L1.REC.B
	CALL	STANDARD.TEST_RENAMES_1_L1.INT_IO. ,PUT_L5
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	1
	CALL	STANDARD.TEXT_IO. ,NEW_LINE_L26
	LIVA 	1, Y_disp, STANDARD.TEST_RENAMES_1_L1.REC.A
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	333
	Sd
	LIVA 	1, Y_disp, STANDARD.TEST_RENAMES_1_L1.REC.B
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	444
	Sd
STR STR_L14, "Y.A = "			; constante string="Y.A = "
	LCA	STR_L14.data_ptr
	CALL	STANDARD.TEXT_IO. ,PUT_L56
	Ld 1,	STANDARD.TEST_RENAMES_1_L1.INT_IO.DEFAULT_BASE_disp
	Ld 1,	STANDARD.TEST_RENAMES_1_L1.INT_IO.DEFAULT_WIDTH_disp
	LId	1, Y_disp, STANDARD.TEST_RENAMES_1_L1.REC.A
	CALL	STANDARD.TEST_RENAMES_1_L1.INT_IO. ,PUT_L5
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	1
	CALL	STANDARD.TEXT_IO. ,NEW_LINE_L26
STR STR_L15, "Y.B = "			; constante string="Y.B = "
	LCA	STR_L15.data_ptr
	CALL	STANDARD.TEXT_IO. ,PUT_L56
	Ld 1,	STANDARD.TEST_RENAMES_1_L1.INT_IO.DEFAULT_BASE_disp
	Ld 1,	STANDARD.TEST_RENAMES_1_L1.INT_IO.DEFAULT_WIDTH_disp
	LId	1, Y_disp, STANDARD.TEST_RENAMES_1_L1.REC.B
	CALL	STANDARD.TEST_RENAMES_1_L1.INT_IO. ,PUT_L5
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	1
	CALL	STANDARD.TEXT_IO. ,NEW_LINE_L26
ret_lbl:
	UNLINK 1
	RTD
excep:
endPRO					;---------- end PRO TEST_RENAMES_1
