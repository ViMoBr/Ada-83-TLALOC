begin:					;---------- BDY INSTRUCTIONS
STR STR_L10, ""				; constante string=""
	LCA	STR_L10.data_ptr
; CODE & concat STRING
VAR	ANON_33_25_data, q
VAR	ANON_33_25_info, q
