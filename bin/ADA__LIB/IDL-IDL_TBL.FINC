NODE_SPECIF = 'NODE_SPECIF'
namespace NODE_SPECIF
VAR use__info, q
VAR SIZ, d
	LVA	0, SIZ
	Sa	0, use__info
USEINFO 0, NS_SIZE, 	La 0, STANDARD.IDL.ATTR_NBR.use__info
USEINFO 0, NS_FIRST_A, 	La 0, STANDARD.INTEGER.use__info
USEINFO 0, NS_ARITY, 	La 0, STANDARD.IDL.IDL_MAN.ARITIES.use__info
virtual at 0				; calcul des offsets statiques
STATOFS NS_SIZE, 2
STATOFS NS_FIRST_A, 4
STATOFS NS_ARITY, 1
size = $
end virtual
	LI	 size*8
	Sd	0, SIZ
end namespace

					; array decl constrained array type info
NODE_SPECIF_TABLE = 'NODE_SPECIF_TABLE'
namespace NODE_SPECIF_TABLE
VAR use__info, q
VAR SIZ, d
	LVA	0, SIZ
	Sa	0, use__info
VAR _COMP_SIZ, d
VAR _FST_1, d
VAR _LST_1, d
	LI	56
	Sd	0, _COMP_SIZ
	Ld	0, _COMP_SIZ
; PROCESS_CONSTRAINED_ARRAY_TYPE_SPEC : index type non integer non traite DN_ENUMERATION
	Ld	0, _LST_1
	Ld	0, _FST_1
	SUB
	INC
	MUL
	Sd	0, SIZ
  virtual at 4
COMP_SIZ = $
	rd 1 
FST_1 = $
	rd 1 
LST_1 = $
	rd 1 
  end virtual
end namespace

					; ATTR_SPECIF RECORD TYPE INFO
ATTR_SPECIF = 'ATTR_SPECIF'
