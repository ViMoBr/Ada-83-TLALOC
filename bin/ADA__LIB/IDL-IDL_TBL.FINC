end namespace
	La  1,	-SPEC_FILE_ofs
	DUP
	La  ,  0
	Sa  1, ANON_33_25_data
	La  ,  8
	Sa  1, ANON_33_25_info
	LId 1, ANON_33_25_info, STRING.LST_1
	LId 1, ANON_33_25_info, STRING.FST_1
	SUB
	INC
	Sa  1, ANON_33_25_len
STR ANON_33_37, ".tbl"			; constante string=".tbl"
	LCA	ANON_33_37.data_ptr
	DUP
	La  ,  0
	Sa  1, ANON_33_37_data
	La  ,  8
	Sa  1, ANON_33_37_info
	LId 1, ANON_33_37_info, STRING.LST_1
	LId 1, ANON_33_37_info, STRING.FST_1
	SUB
	INC
	Sa  1, ANON_33_37_len
	La  1, ANON_33_25_len
	La  1, ANON_33_37_len
	ADD
	CO_VAR
	Sa  1, ANON_33_25_disp
	LI	1
	Sd  1, ANON_33_25_info._FST_1
	La  1, ANON_33_25_len
	La  1, ANON_33_37_len
	ADD
	Sd  1, ANON_33_25_info._LST_1
	LI	8
	Sd  1, ANON_33_25_info._COMP_SIZ
	La  1, ANON_33_25_len
	La  1, ANON_33_37_len
	ADD
	LI	8
	MUL
	Sd  1, ANON_33_25_info.SIZ
	LVA 1, ANON_33_25_info.SIZ
	Sa  1, ANON_33_25__u
	La  1, ANON_33_25_disp
	La  1, ANON_33_25_len
	La  1, ANON_33_25_data
	BLKMOV
	La  1, ANON_33_25_disp
	La  1, ANON_33_25_len
	ADD
	La  1, ANON_33_37_len
	La  1, ANON_33_37_data
	BLKMOV
	LVA 1, ANON_33_25_disp
	LI  0
	LVA  1,	SFILE_disp
	CALL	STANDARD.TEXT_IO. ,OPEN_L2
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	1
	NEG
	SId	0, LAST_NODE_disp, 0
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	1
	NEG
	SId	0, LAST_ATTR_disp, 0
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	0
	SId	0, LAST_NODE_ATTR_disp, 0
LOOP__1:
	LI	0					; lieu resultat sur pile
	LVA 1,	SFILE_disp
	CALL	STANDARD.TEXT_IO. ,END_OF_FILE_L37
	LI	1
	OUX
	BF	L11
	LVA  1,	T_CHR_disp
	LVA 1,	SFILE_disp
	CALL	STANDARD.TEXT_IO. ,GET_L49
					; debut if
	Lb 1,	T_CHR_disp
	LI	67
	CNE
	Lb 1,	T_CHR_disp
	LI	69
	CNE
	BF	L13
; CODE_NUMERIC_LITERAL DN_INTEGER
