	Sa	1, SFILE__u
; CODE_VC_NAME DN_VARIABLE_ID
	LIVa 1, SFILE_disp, STANDARD.IDL.IDL_TBL.DTT_IO.FILE_TYPE.ID
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	1
	NEG
	Sd
	LIVa 1, SFILE_disp, STANDARD.IDL.IDL_TBL.DTT_IO.FILE_TYPE.IS_OPENED
	LI	0
	Sb
	LIVa 1, SFILE_disp, STANDARD.IDL.IDL_TBL.DTT_IO.FILE_TYPE.AT_END_OF_FILE
	LI	0
	Sb

					;    end elab
begin:					;---------- BDY INSTRUCTIONS
STR STR_L50, ""				; constante string=""
	LCA	STR_L50.data_ptr
; CODE & concat STRING
VAR	ANON_133_35_data, q
VAR	ANON_133_35_info, q
VAR	ANON_133_47_data, q
VAR	ANON_133_47_info, q
VAR	ANON_133_35_len,  q
VAR	ANON_133_47_len,  q
VAR	ANON_133_35_disp, q
VAR	ANON_133_35__u,   q
namespace ANON_133_35_info
  VAR SIZ,      d
  VAR _COMP_SIZ, d
  VAR _FST_1,    d
  VAR _LST_1,    d
end namespace
	La  1,	-SPEC_FILE_ofs
	DUP
	La  ,  0
	Sa  1, ANON_133_35_data
	La  ,  8
	Sa  1, ANON_133_35_info
	LId 1, ANON_133_35_info, STRING.LST_1
	LId 1, ANON_133_35_info, STRING.FST_1
	SUB
	INC
	Sa  1, ANON_133_35_len
STR ANON_133_47, ".bin"			; constante string=".bin"
	LCA	ANON_133_47.data_ptr
	DUP
	La  ,  0
	Sa  1, ANON_133_47_data
	La  ,  8
	Sa  1, ANON_133_47_info
	LId 1, ANON_133_47_info, STRING.LST_1
	LId 1, ANON_133_47_info, STRING.FST_1
	SUB
	INC
	Sa  1, ANON_133_47_len
	La  1, ANON_133_35_len
	La  1, ANON_133_47_len
	ADD
	CO_VAR
	Sa  1, ANON_133_35_disp
	LI	1
	Sd  1, ANON_133_35_info._FST_1
	La  1, ANON_133_35_len
	La  1, ANON_133_47_len
	ADD
	Sd  1, ANON_133_35_info._LST_1
	LI	8
	Sd  1, ANON_133_35_info._COMP_SIZ
	La  1, ANON_133_35_len
	La  1, ANON_133_47_len
	ADD
	LI	8
	MUL
	Sd  1, ANON_133_35_info.SIZ
	LVA 1, ANON_133_35_info.SIZ
	Sa  1, ANON_133_35__u
	La  1, ANON_133_35_disp
	La  1, ANON_133_35_len
	La  1, ANON_133_35_data
	BLKMOV
	La  1, ANON_133_35_disp
	La  1, ANON_133_35_len
	ADD
	La  1, ANON_133_47_len
	La  1, ANON_133_47_data
	BLKMOV
	LVA 1, ANON_133_35_disp
	LI  1
	LVA  1,	SFILE_disp
	CALL	STANDARD.IDL.IDL_TBL.DTT_IO. ,CREATE_L37
	LVA 0,	STANDARD.IDL.IDL_TBL.DIANA_TABLE_AREA_disp
	LVA 1,	SFILE_disp
	CALL	STANDARD.IDL.IDL_TBL.DTT_IO. ,WRITE_L48
	LVA  1,	SFILE_disp
	CALL	STANDARD.IDL.IDL_TBL.DTT_IO. ,CLOSE_L39
ret_lbl:
	UNLINK 1
	RTD	prm_siz
excep:
endPRO					;---------- end PRO WRITE_SPEC
end if

