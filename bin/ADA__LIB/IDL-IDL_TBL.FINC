	Ld	 2, -ITEM_ofs
	CALL	STANDARD.TEXT_IO.INTEGER_IO. ,PUT_L64
	UNLINK	 2
	RTD	prm_siz
endPRO					;---------- end PRO PUT
end if
if defined GET_L8_
PRO	GET_L8				;---------- PRO GET
PRMS					;    debut parametrage
	PRM FROM_ofs				; in
	PRM ITEM_ofs				; out
	PRM LAST_ofs				; out
endPRMS					;    fin parametrage
ELB 2
begin:
	LVA	 1, GFP_disp
	La 	 2, -LAST_ofs
	La 	 2, -ITEM_ofs
