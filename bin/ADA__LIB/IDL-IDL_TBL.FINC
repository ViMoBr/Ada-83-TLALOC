begin:					;---------- BDY INSTRUCTIONS
VAR	SL15_disp, d				; compteur boucle LOOP__3
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	1
	Sd  2,	SL15_disp
VAR	LMT_SL15_disp, d			; limite boucle LOOP__3
	Ld 1,	STANDARD.IDL.IDL_TBL.INIT_SPEC_L1.T_LAST_disp
	Sd  2,	LMT_SL15_disp
	Ld  2,	SL15_disp				; test null range LOOP__3
	Ld  2,	LMT_SL15_disp
	CGT
	BT	L14
LOOP__3:					; corps boucle LOOP__3
					; debut if
	La	 1, T_TXT_disp				; array data start address on stack
	Ld	2, SL15_disp
	LId	1, T_TXT__u, STANDARD.STRING.FST_1		; (index - FST_1) * SIZ_1
	SUB
	LId	1, T_TXT__u, STANDARD.STRING.COMP_SIZ
	LI	8
	DIV
	MUL
	ADD					; add offset to start address
	Lb
	LI	32
	CNE
	La	 1, T_TXT_disp				; array data start address on stack
	Ld	2, SL15_disp
	LId	1, T_TXT__u, STANDARD.STRING.FST_1		; (index - FST_1) * SIZ_1
	SUB
	LId	1, T_TXT__u, STANDARD.STRING.COMP_SIZ
	LI	8
	DIV
	MUL
	ADD					; add offset to start address
	Lb
	LI	 9
	CNE
	BF	L17
	Ld 2,	D_disp
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	1
	ADD
	Sd  2,	D_disp
	La	 1, T_TXT_disp				; array data start address on stack
	Ld 2,	D_disp
	LId	1, T_TXT__u, STANDARD.STRING.FST_1		; (index - FST_1) * SIZ_1
	SUB
	LId	1, T_TXT__u, STANDARD.STRING.COMP_SIZ
	LI	8
	DIV
	MUL
	ADD					; add offset to start address
	La	 1, T_TXT_disp				; array data start address on stack
	Ld	2, SL15_disp
	LId	1, T_TXT__u, STANDARD.STRING.FST_1		; (index - FST_1) * SIZ_1
	SUB
	LId	1, T_TXT__u, STANDARD.STRING.COMP_SIZ
	LI	8
	DIV
	MUL
	ADD					; add offset to start address
	Lb
	Sb
	BRA	L16
L17:
L16:					; post if
	Ld  2,	SL15_disp				; test de sortie LOOP__3
	Ld  2,	LMT_SL15_disp
	CEQ
	BT	L14
	Ld  2,	SL15_disp				; mise a jour compteur LOOP__3
	INC
	Sd  2,	SL15_disp
	BRA	LOOP__3				; iteration suivante LOOP__3
L14:					; post loop LOOP__3
	Ld 2,	D_disp
	Sd  1,	T_LAST_disp
	UNLINK 2
endPRO
					; debut if
	Lb 1,	T_CHR_disp
	LI	78
	CEQ
	BF	L19
	LId	0, LAST_NODE_disp, 0
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	1
	ADD
	SId	0, LAST_NODE_disp, 0
