DERIVED = 'DERIVED'
namespace DERIVED				;---------- PACKAGE
elab_spec:				;    SPEC ELAB

					;    BODY ELAB
VAR DERIVED_DECL_LIST_disp, q			; variable record : pointeur aux data record
