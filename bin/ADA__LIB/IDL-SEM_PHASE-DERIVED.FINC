	Sa  1, ANON_35_28__u
	LVA 1, ANON_35_28_disp
					; doublet resultat record anonyme
	La  1,	-DERIVED_SUBTYPE_ofs
	LI  35
	CALL	STANDARD.IDL. ,D_L13
	La  ,  0
	BLKMOV

