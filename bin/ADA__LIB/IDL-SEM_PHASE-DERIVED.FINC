	LVA	0, STANDARD.IDL.SEQ_TYPE.SIZ
	Sa	0, DERIVED_DECL_LIST__u


if defined MAKE_DERIVED_SUBPROGRAM_LIST_L1_
PRO	MAKE_DERIVED_SUBPROGRAM_LIST_L1		;---------- PRO MAKE_DERIVED_SUBPROGRAM_LIST
PRMS					;    debut parametrage
	PRM DERIVED_SUBTYPE_ofs			; in
	PRM PARENT_SUBTYPE_ofs			; in
	PRM H_ofs				; in
	PRM result__ofs				; resultat de fonction
endPRMS					;    fin parametrage
ELB 1					;    BODY ELAB
VAR DERIVED_ID_disp, q			; variable record : pointeur aux data record
VAR DERIVED_ID__u, q			; variable record : pointeur aux useinfo
VAR DERIVED_ID__dat, STANDARD.IDL.TREE.size
