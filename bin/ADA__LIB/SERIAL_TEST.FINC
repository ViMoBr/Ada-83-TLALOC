end if
if defined RESET_L6_
PRO	RESET_L6				;---------- PRO RESET
PRMS					;    debut parametrage
	PRM FILE_ofs				; in out
	PRM MODE_ofs				; in
endPRMS					;    fin parametrage
ELB 2
begin:
	LVA	 1, GFP_disp
	Lb	 2, -MODE_ofs
	La 	 2, -FILE_ofs
	CALL	STANDARD.SEQUENTIAL_IO. ,RESET_L5
	UNLINK	 2
