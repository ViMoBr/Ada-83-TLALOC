end if
if defined MODE_L8_
PRO	MODE_L8				;---------- PRO MODE
PRMS					;    debut parametrage
	PRM FILE_ofs				; in
	PRM result__ofs				; resultat de fonction
endPRMS					;    fin parametrage
ELB 2
begin:
	LI	0					; lieu result
	LVA	 1, GFP_disp
	La 	 2, -FILE_ofs
	CALL	STANDARD.SEQUENTIAL_IO. ,MODE_L7
	Sb	 2, -result__ofs			; retour resultat
	UNLINK	 2
	RTD	prm_siz-8
endPRO					;---------- end PRO MODE
end if
if defined NAME_L9_
PRO	NAME_L9				;---------- PRO NAME
PRMS					;    debut parametrage
	PRM FILE_ofs				; in
	PRM result__ofs				; resultat de fonction
endPRMS					;    fin parametrage
ELB 2
begin:
	LI	0					; lieu result
	LVA	 1, GFP_disp
	La 	 2, -FILE_ofs
	CALL	STANDARD.SEQUENTIAL_IO. ,NAME_L8
; RESULTAT UNCONSTRAINED A FAIRE
	UNLINK	 2
	RTD	prm_siz-8
endPRO					;---------- end PRO NAME
end if
if defined FORM_L10_
PRO	FORM_L10				;---------- PRO FORM
