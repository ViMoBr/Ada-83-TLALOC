if defined RESET_L7_
PRO	RESET_L7				;---------- PRO RESET
PRMS					;    debut parametrage
	PRM FILE_ofs				; in out
endPRMS					;    fin parametrage
ELB 2
begin:
	LVA	 1, GFP_disp
