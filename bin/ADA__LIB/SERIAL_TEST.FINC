if ~ definite SEQUENTIAL_IO
include 'SEQUENTIAL_IO.FINC'
end if
if ~ definite TEXT_IO
include 'TEXT_IO.FINC'
end if
PRO	SERIAL_TEST_L1				;---------- PRO SERIAL_TEST
ELB 1					;    BODY ELAB
CHAR_IO = 'CHAR_IO'
namespace CHAR_IO				;---------- GENERIC PACKAGE INSTANTIATION
elab_spec:				;    SPEC ELAB

BRA post_LD_CHARACTER
LD_CHARACTER.elab:
	Lb -1, 0
	RTD 0
post_LD_CHARACTER:
BRA post_ST_CHARACTER
ST_CHARACTER.elab:
	Sb -1, 0
	RTD 0
post_ST_CHARACTER:
BRA post_INADR_CHARACTER
INADR_CHARACTER.elab:
	RTD 0
post_INADR_CHARACTER:
BRA post_OUTADR_CHARACTER
OUTADR_CHARACTER.elab:
	La
	RTD 0
post_OUTADR_CHARACTER:
VAR CHARACTER__outadr_ofs, q
	LCA OUTADR_CHARACTER.elab
	Sa	 1, CHARACTER__outadr_ofs
VAR CHARACTER__inadr_ofs, q
	LCA INADR_CHARACTER.elab
	Sa	 1, CHARACTER__inadr_ofs
VAR CHARACTER__st_ofs, q
	LCA ST_CHARACTER.elab
	Sa	 1, CHARACTER__st_ofs
VAR CHARACTER__ld_ofs, q
	LCA LD_CHARACTER.elab
	Sa	 1, CHARACTER__ld_ofs
VAR CHARACTER__u_ofs, q
	La	 0, STANDARD.CHARACTER.use__info
	Sa	 1, CHARACTER__u_ofs
VAR GFP_disp, q				; Lieu du Generic Frame Pointer 
; CODE_TYPE_DECL : skip PRIVATE FILE_TYPE (deferred to full type)

					; FILE_MODE ENUMERATION TYPE INFO
FILE_MODE = 'FILE_MODE'
namespace FILE_MODE
VAR use__info, q
BEGIN_BLOC_DEF
db 0, 7, "IN_FILE"
db 1, 8, "OUT_FILE"
END_BLOC_DEF
IMAGES	BYTES_BLOC
CST LST, d, 1
CST FST, d, 0
CST SIZ, d, 8	; SIZ en bits !
postpone
  align_q
end postpone
	LCA	SIZ
	Sa	1, use__info
end namespace
if defined CREATE_L2_
PRO	CREATE_L2				;---------- PRO CREATE
PRMS					;    debut parametrage
	PRM FILE_ofs				; in out
	PRM MODE_ofs				; in
	PRM NAME_ofs				; in
	PRM FORM_ofs				; in
endPRMS					;    fin parametrage
ELB 2
begin:
	LVA	 1, GFP_disp
	La 	 2, -FORM_ofs
	La 	 2, -NAME_ofs
	Lb	 2, -MODE_ofs
	La 	 2, -FILE_ofs
	CALL	STANDARD.SEQUENTIAL_IO. ,CREATE_L1
	UNLINK	 2
	RTD	prm_siz
endPRO					;---------- end PRO CREATE
end if
if defined OPEN_L3_
PRO	OPEN_L3				;---------- PRO OPEN
PRMS					;    debut parametrage
	PRM FILE_ofs				; in out
	PRM MODE_ofs				; in
	PRM NAME_ofs				; in
	PRM FORM_ofs				; in
endPRMS					;    fin parametrage
ELB 2
begin:
	LVA	 1, GFP_disp
	La 	 2, -FORM_ofs
	La 	 2, -NAME_ofs
	Lb	 2, -MODE_ofs
	La 	 2, -FILE_ofs
	CALL	STANDARD.SEQUENTIAL_IO. ,OPEN_L2
	UNLINK	 2
	RTD	prm_siz
endPRO					;---------- end PRO OPEN
end if
