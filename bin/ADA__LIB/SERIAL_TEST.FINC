endPRMS					;    fin parametrage
ELB 2
begin:
	LI	0					; lieu result
	LVA	 1, GFP_disp
	La 	 2, -FILE_ofs
	CALL	STANDARD.SEQUENTIAL_IO. ,END_OF_FILE_L13
	Sb	 2, -result__ofs			; retour resultat
	UNLINK	 2
	RTD	prm_siz-8
endPRO					;---------- end PRO END_OF_FILE
end if
FILE_NAME_BUFFER = 'FILE_NAME_BUFFER'
namespace FILE_NAME_BUFFER			; FILE_NAME_BUFFER CONSTRAINED ARRAY SUBTYPE INFO
VAR use__info, q
VAR SIZ, d
	LVA	1, SIZ
	Sa	1, use__info
VAR COMP_SIZ, d
VAR FST_1, d
VAR LST_1, d
	LI	8
	Sd	1, COMP_SIZ
	Ld	1, COMP_SIZ
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	1
	Sd	1, FST_1
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	256
	Sd	1, LST_1
	Ld	1, LST_1
	INC
	Ld	1, FST_1
	SUB
	MUL
	Sd	1, SIZ
  virtual at 4
COMP_SIZ = $
	rd 1 
FST_1 = $
	rd 1 
LST_1 = $
	rd 1 
  end virtual
end namespace

					; FILE_TYPE RECORD TYPE INFO
FILE_TYPE = 'FILE_TYPE'
namespace FILE_TYPE
VAR use__info, q
VAR SIZ, d
	LVA	1, SIZ
	Sa	1, use__info
USEINFO 1, ID, 	La 0, STANDARD.INTEGER.use__info
USEINFO 1, NAME, 	La 1, STANDARD.SERIAL_TEST_L1.CHAR_IO.FILE_NAME_BUFFER.use__info
USEINFO 1, NAME_LEN, 	La 0, STANDARD.POSITIVE.use__info
USEINFO 1, IS_OPENED, 	La 0, STANDARD.BOOLEAN.use__info
USEINFO 1, MODE, 	La 1, STANDARD.SERIAL_TEST_L1.CHAR_IO.FILE_MODE.use__info
USEINFO 1, AT_END_OF_FILE, 	La 0, STANDARD.BOOLEAN.use__info
virtual at 0				; calcul des offsets statiques
STATOFS ID, 4
STATOFS NAME, 256
STATOFS NAME_LEN, 4
STATOFS IS_OPENED, 1
STATOFS MODE, 1
STATOFS AT_END_OF_FILE, 1
size = $
end virtual
	LI	 size*8
	Sd	1, SIZ
end namespace
					;---------- end generic package instantiation CHAR_IO
end namespace

VAR CMD_FG_COLOR_disp, d			; variable bool char enum
; CODE_NUMERIC_LITERAL DN_UNIVERSAL_INTEGER
	LI	1
	Sb  1,	CMD_FG_COLOR_disp

VAR CMD_BG_COLOR_disp, d			; variable bool char enum
; CODE_NUMERIC_LITERAL DN_UNIVERSAL_INTEGER
	LI	2
	Sb  1,	CMD_BG_COLOR_disp

VAR CMD_CLS_disp, d				; variable bool char enum
; CODE_NUMERIC_LITERAL DN_UNIVERSAL_INTEGER
	LI	3
	Sb  1,	CMD_CLS_disp

VAR CMD_NEWLINE_disp, d			; variable bool char enum
; CODE_NUMERIC_LITERAL DN_UNIVERSAL_INTEGER
	LI	10
	Sb  1,	CMD_NEWLINE_disp

VAR COL_NOIR_disp, d			; variable bool char enum
; CODE_NUMERIC_LITERAL DN_UNIVERSAL_INTEGER
	LI	0
	Sb  1,	COL_NOIR_disp

VAR COL_ROUGE_disp, d			; variable bool char enum
; CODE_NUMERIC_LITERAL DN_UNIVERSAL_INTEGER
	LI	1
	Sb  1,	COL_ROUGE_disp

VAR COL_VERT_disp, d			; variable bool char enum
; CODE_NUMERIC_LITERAL DN_UNIVERSAL_INTEGER
	LI	2
	Sb  1,	COL_VERT_disp

VAR COL_JAUNE_disp, d			; variable bool char enum
; CODE_NUMERIC_LITERAL DN_UNIVERSAL_INTEGER
	LI	3
	Sb  1,	COL_JAUNE_disp

VAR COL_BLEU_disp, d			; variable bool char enum
; CODE_NUMERIC_LITERAL DN_UNIVERSAL_INTEGER
	LI	4
	Sb  1,	COL_BLEU_disp

VAR COL_MAGENTA_disp, d			; variable bool char enum
; CODE_NUMERIC_LITERAL DN_UNIVERSAL_INTEGER
	LI	5
	Sb  1,	COL_MAGENTA_disp

VAR COL_CYAN_disp, d			; variable bool char enum
; CODE_NUMERIC_LITERAL DN_UNIVERSAL_INTEGER
	LI	6
	Sb  1,	COL_CYAN_disp

VAR COL_BLANC_disp, d			; variable bool char enum
; CODE_NUMERIC_LITERAL DN_UNIVERSAL_INTEGER
	LI	7
	Sb  1,	COL_BLANC_disp

VAR PORT_disp, q				; variable record : pointeur aux data record
VAR PORT__u, q				; variable record : pointeur aux useinfo
VAR PORT__dat, STANDARD.SERIAL_TEST_L1.CHAR_IO.FILE_TYPE.size
	LVA	1, PORT__dat
	Sa	1, PORT_disp				; record fin
	LVA	1, STANDARD.SERIAL_TEST_L1.CHAR_IO.FILE_TYPE.SIZ
	Sa	1, PORT__u
	LIVa 1, PORT_disp, STANDARD.SERIAL_TEST_L1.CHAR_IO.FILE_TYPE.ID
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	1
	NEG
	Sd
	LIVa 1, PORT_disp, STANDARD.SERIAL_TEST_L1.CHAR_IO.FILE_TYPE.IS_OPENED
	LI	0
	Sb
	LIVa 1, PORT_disp, STANDARD.SERIAL_TEST_L1.CHAR_IO.FILE_TYPE.AT_END_OF_FILE
	LI	0
	Sb


if defined SEND_STR_L15_
PRO	SEND_STR_L15				;---------- PRO SEND_STR
PRMS					;    debut parametrage
	PRM F_ofs				; in
	PRM S_ofs				; in
endPRMS					;    fin parametrage
ELB 2					;    BODY ELAB
VAR I_disp, d				; variable entiere

					;    end elab
begin:					;---------- BDY INSTRUCTIONS
	LVA	2, -S_ofs
	LIa	, , 8
	Ld	, STRING.FST_1
	Sd  2,	I_disp
LOOP__1:
	Ld 2,	I_disp
	LVA	2, -S_ofs
	LIa	, , 8
	Ld	, STRING.LST_1
	CLE
	BF	L16
	LVA	2, -S_ofs
	LIa	, , 0				; array data start address on stack
	Ld 2,	I_disp
	LVA	2, -S_ofs
	LIa	, , 8
	Ld	, STANDARD.STRING.FST_1			; (index - FST_1) * SIZ_1
	SUB
	LVA	2, -S_ofs
	LIa	, , 8
	Ld	, STANDARD.STRING.COMP_SIZ
	LI	8
	DIV
	MUL
	ADD					; add offset to start address
	Lb					; charge depuis adresse empilee 
	La  2,	-F_ofs
	CALL	STANDARD.SERIAL_TEST_L1.CHAR_IO. ,WRITE_L13
	Ld 2,	I_disp
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	1
	ADD
	Sd  2,	I_disp
	BRA	LOOP__1
L16:					; post loop LOOP__1
ret_lbl:
	UNLINK 2
	RTD	prm_siz
excep:
endPRO					;---------- end PRO SEND_STR
end if
					;    end elab
begin:					;---------- BDY INSTRUCTIONS
STR STR_L17, ""				; constante string=""
	LCA	STR_L17.data_ptr
STR STR_L18, "/dev/ttyACM0"			; constante string="/dev/ttyACM0"
	LCA	STR_L18.data_ptr
	LI	 1
	LVA  1,	PORT_disp
	CALL	STANDARD.SERIAL_TEST_L1.CHAR_IO. ,OPEN_L3
STR STR_L19, "Port serie ouvert."		; constante string="Port serie ouvert."
	LCA	STR_L19.data_ptr
	CALL	STANDARD.TEXT_IO. ,PUT_LINE_L60
	LI	 3
	LVA 1,	PORT_disp
	CALL	STANDARD.SERIAL_TEST_L1.CHAR_IO. ,WRITE_L13
	LI	 1
	LVA 1,	PORT_disp
	CALL	STANDARD.SERIAL_TEST_L1.CHAR_IO. ,WRITE_L13
	LI	 3
	LVA 1,	PORT_disp
	CALL	STANDARD.SERIAL_TEST_L1.CHAR_IO. ,WRITE_L13
STR STR_L20, "=== TLALOC Ada 83 -> ILI9481 ==="	; constante string="=== TLALOC Ada 83 -> ILI9481 ==="
	LCA	STR_L20.data_ptr
	LVA 1,	PORT_disp
	CALL	STANDARD.SERIAL_TEST_L1. ,SEND_STR_L15
	LI	 10
	LVA 1,	PORT_disp
	CALL	STANDARD.SERIAL_TEST_L1.CHAR_IO. ,WRITE_L13
	LI	 1
	LVA 1,	PORT_disp
	CALL	STANDARD.SERIAL_TEST_L1.CHAR_IO. ,WRITE_L13
	LI	 7
	LVA 1,	PORT_disp
	CALL	STANDARD.SERIAL_TEST_L1.CHAR_IO. ,WRITE_L13
STR STR_L21, "Alphabet : "			; constante string="Alphabet : "
	LCA	STR_L21.data_ptr
	LVA 1,	PORT_disp
	CALL	STANDARD.SERIAL_TEST_L1. ,SEND_STR_L15
namespace	BLOCK__2
ELB 2					;    BODY ELAB
VAR C_disp, d				; variable bool char enum

VAR V_disp, d				; variable entiere

					;    end elab
begin:					;---------- BDY INSTRUCTIONS
	LI	65
	Sd  2,	V_disp
LOOP__3:
	Ld 2,	V_disp
	LI	90
	CLE
	BF	L22
	Ld 2,	V_disp
	Sb  2,	C_disp
	Lb 2,	C_disp
	LVA 1,	STANDARD.SERIAL_TEST_L1.PORT_disp
	CALL	STANDARD.SERIAL_TEST_L1.CHAR_IO. ,WRITE_L13
	Ld 2,	V_disp
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	1
	ADD
	Sd  2,	V_disp
	BRA	LOOP__3
L22:					; post loop LOOP__3
	UNLINK 2
endPRO
	LI	90
	LVA 1,	PORT_disp
	CALL	STANDARD.SERIAL_TEST_L1.CHAR_IO. ,WRITE_L13
	LI	 10
	LVA 1,	PORT_disp
	CALL	STANDARD.SERIAL_TEST_L1.CHAR_IO. ,WRITE_L13
	LI	 1
	LVA 1,	PORT_disp
	CALL	STANDARD.SERIAL_TEST_L1.CHAR_IO. ,WRITE_L13
	LI	 6
	LVA 1,	PORT_disp
	CALL	STANDARD.SERIAL_TEST_L1.CHAR_IO. ,WRITE_L13
STR STR_L23, "Chiffres : 0123456789"		; constante string="Chiffres : 0123456789"
	LCA	STR_L23.data_ptr
	LVA 1,	PORT_disp
	CALL	STANDARD.SERIAL_TEST_L1. ,SEND_STR_L15
	LI	 10
	LVA 1,	PORT_disp
	CALL	STANDARD.SERIAL_TEST_L1.CHAR_IO. ,WRITE_L13
	LI	 1
	LVA 1,	PORT_disp
	CALL	STANDARD.SERIAL_TEST_L1.CHAR_IO. ,WRITE_L13
	LI	 2
	LVA 1,	PORT_disp
	CALL	STANDARD.SERIAL_TEST_L1.CHAR_IO. ,WRITE_L13
STR STR_L24, "Test termine avec succes."	; constante string="Test termine avec succes."
	LCA	STR_L24.data_ptr
	LVA 1,	PORT_disp
	CALL	STANDARD.SERIAL_TEST_L1. ,SEND_STR_L15
	LI	 10
	LVA 1,	PORT_disp
	CALL	STANDARD.SERIAL_TEST_L1.CHAR_IO. ,WRITE_L13
	LI	 1
	LVA 1,	PORT_disp
	CALL	STANDARD.SERIAL_TEST_L1.CHAR_IO. ,WRITE_L13
	LI	 7
	LVA 1,	PORT_disp
	CALL	STANDARD.SERIAL_TEST_L1.CHAR_IO. ,WRITE_L13
	LVA  1,	PORT_disp
	CALL	STANDARD.SERIAL_TEST_L1.CHAR_IO. ,CLOSE_L4
STR STR_L25, "Envoi termine, port ferme."	; constante string="Envoi termine, port ferme."
	LCA	STR_L25.data_ptr
	CALL	STANDARD.TEXT_IO. ,PUT_LINE_L60
ret_lbl:
	UNLINK 1
	RTD
excep:
endPRO					;---------- end PRO SERIAL_TEST
