STR ANON_27_23_L2_D, "BY EXTRA LINES"		; constante string="BY EXTRA LINES"
	LCA	ANON_27_23_L2_D.data_ptr
	DUP
	La  ,  0
	Sa  1, ANON_27_23_L2_D_data
	La  ,  8
	Sa  1, ANON_27_23_L2_D_info
