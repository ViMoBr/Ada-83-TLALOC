STR ANON_26_23_L2_G, "CHECK THAT A COMPILATION CAN BE PRECEDED "	; constante string="CHECK THAT A COMPILATION CAN BE PRECEDED "
	LCA	ANON_26_23_L2_G.data_ptr
	DUP
	La  ,  0
	Sa  1, ANON_26_23_L2_G_data
	La  ,  8
	Sa  1, ANON_26_23_L2_G_info
	LId 1, ANON_26_23_L2_G_info, _STRING.LST_1
	LId 1, ANON_26_23_L2_G_info, _STRING.FST_1
	SUB
	INC
	CLAMP0
