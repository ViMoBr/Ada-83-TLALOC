					; _REAL FLOAT TYPE INFO
_REAL = '_REAL'
namespace _REAL
VAR use__info, q
VAR SIZ, d
VAR FST, q
VAR LST, q
	LVA	1, SIZ
	Sa	1, use__info
	LI	 32
	Sd	1, SIZ
; CODE_NUMERIC_LITERAL DN_UNIVERSAL_REAL
	LIF	100.0
	FNEG
	Sq	1, FST
; CODE_NUMERIC_LITERAL DN_UNIVERSAL_REAL
	LIF	100.0
	Sq	1, LST
end namespace

