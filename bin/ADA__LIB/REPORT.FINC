	LI	0
	Sb  0,	TEST_STATUS_disp
					; debut if
	LVA	1, -NAME_ofs
	LIa	, , 8
	Ld	, STRING.LST_1
	LVA	1, -NAME_ofs
	LIa	, , 8
	Ld	, STRING.FST_1
	SUB
	INC
; CODE_NUMERIC_LITERAL DN_UNIVERSAL_INTEGER
	LI	15
	CLE
	BF	L15
	LVA	1, -NAME_ofs
	LIa	, , 8
	Ld	, STRING.LST_1
	LVA	1, -NAME_ofs
	LIa	, , 8
	Ld	, STRING.FST_1
	SUB
	INC
	Sd  0,	TEST_NAME_LEN_disp
	BRA	L14
L15:
; CODE_NUMERIC_LITERAL DN_UNIVERSAL_INTEGER
	LI	15
	Sd  0,	TEST_NAME_LEN_disp
L14:					; post if
	La 0, TEST_NAME_disp
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	1
	LId 0, TEST_NAME__u, STANDARD.STRING.FST_1
	SUB
	LI	1
	MUL
	ADD
	Ld 0,	STANDARD.REPORT.TEST_NAME_LEN_disp
	INC
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	1
	SUB
	LI	1
	MUL
	LVA	1, -NAME_ofs
	LIa	, , 0
	LVA	1, -NAME_ofs
	LIa	, , 8
	Ld	, STRING.FST_1
	LVA	1, -NAME_ofs
	LIa	, , 8
	Ld	, STANDARD.STRING.FST_1
	SUB
	LI	1
	MUL
	ADD
	LVA	1, -NAME_ofs
	LIa	, , 8
	Ld	, STRING.FST_1
	Ld 0,	STANDARD.REPORT.TEST_NAME_LEN_disp
	ADD
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	1
	SUB
	INC
	LVA	1, -NAME_ofs
	LIa	, , 8
	Ld	, STRING.FST_1
	SUB
	LI	1
	MUL
	DROP
	BLKMOV
