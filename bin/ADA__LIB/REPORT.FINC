if ~ definite TEXT_IO
include 'TEXT_IO.FINC'
end if
REPORT = 'REPORT'
namespace REPORT				;---------- PACKAGE
elab_spec:				;    SPEC ELAB


					; FILE_NUM INTEGER SUBTYPE INFO
FILE_NUM = 'FILE_NUM'
namespace FILE_NUM
VAR use__info, q
VAR SIZ, d
	LVA	0, SIZ
	Sa	0, use__info
VAR FST, d
VAR LST, d
	LI	32
	Sd	0, SIZ
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	1
	Sd	0, FST
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	3
	Sd	0, LST
VAR PARENT__u, q
	La	0, STANDARD.INTEGER.use__info
	Sa	0, PARENT__u
end namespace
					;    BODY ELAB

					; STATUS ENUMERATION TYPE INFO
STATUS = 'STATUS'
namespace STATUS
VAR use__info, q
BEGIN_BLOC_DEF
db 0, 4, "PASS"
db 1, 4, "FAIL"
db 2, 14, "DOES_NOT_APPLY"
db 3, 15, "ACTION_REQUIRED"
END_BLOC_DEF
IMAGES	BYTES_BLOC
CST LST, d, 3
CST FST, d, 0
CST SIZ, d, 8	; SIZ en bits !
postpone
  align_q
end postpone
	LCA	SIZ
	Sa	0, use__info
end namespace
VAR TEST_STATUS_disp, b			; variable entiere
	LI	1
	Sb  0,	TEST_STATUS_disp

STRING = 'STRING'
namespace STRING				; array var constrained array type info
VAR use__info, q
VAR SIZ, d
	LVA	0, SIZ
	Sa	0, use__info
VAR _COMP_SIZ, d
VAR _FST_1, d
VAR _LST_1, d
	LI	8
	Sd	0, _COMP_SIZ
	Ld	0, _COMP_SIZ
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	1
	Sd	0, _FST_1
; CODE_NUMERIC_LITERAL DN_UNIVERSAL_INTEGER
	LI	15
	Sd	0, _LST_1
	Ld	0, _LST_1
	Ld	0, _FST_1
	SUB
	INC
	MUL
	Sd	0, SIZ
  virtual at 4
COMP_SIZ = $
	rd 1 
FST_1 = $
	rd 1 
LST_1 = $
	rd 1 
  end virtual
end namespace
VAR TEST_NAME_disp, q			; variable array : pointeur aux data
VAR TEST_NAME__u, q				; variable array : useinfo pointeur au rec info
	La 0, STRING.use__info
	Sa	0, TEST_NAME__u				; array info ptr at __u
	Ld	0, STRING.SIZ
	LI	8
	DIV
	CO_VAR
	Sa	0, TEST_NAME_disp			; array data ptr at _disp

STRING = 'STRING'
namespace STRING				; array var constrained array type info
VAR use__info, q
VAR SIZ, d
	LVA	0, SIZ
	Sa	0, use__info
VAR _COMP_SIZ, d
VAR _FST_1, d
VAR _LST_1, d
	LI	8
	Sd	0, _COMP_SIZ
	Ld	0, _COMP_SIZ
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	1
	Sd	0, _FST_1
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	7
	Sd	0, _LST_1
	Ld	0, _LST_1
	Ld	0, _FST_1
	SUB
	INC
	MUL
	Sd	0, SIZ
  virtual at 4
COMP_SIZ = $
	rd 1 
FST_1 = $
	rd 1 
LST_1 = $
	rd 1 
  end virtual
end namespace
VAR NO_NAME_disp, q				; variable array : pointeur aux data
VAR NO_NAME__u, q				; variable array : useinfo pointeur au rec info
	La 0, STRING.use__info
	Sa	0, NO_NAME__u				; array info ptr at __u
STR NO_NAME, "NO_NAME"			; constante string="NO_NAME"
	LCA	NO_NAME.data_ptr
	La
	Sa	0, NO_NAME_disp				; array data ptr at _disp
	LCA	NO_NAME.info_ptr
	La
	Sa	0, NO_NAME__u				; array info ptr at __u

VAR TEST_NAME_LEN_disp, d			; variable entiere
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	0
	Sd  0,	TEST_NAME_LEN_disp


if defined PUT_MSG_L1_
PRO	PUT_MSG_L1				;---------- PRO PUT_MSG
PRMS					;    debut parametrage
	PRM MSG_ofs				; in
endPRMS					;    fin parametrage
ELB 1					;    BODY ELAB
VAR MAX_LEN_disp, d				; variable entiere
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	72
	Sd  1,	MAX_LEN_disp

VAR INDENT_disp, d				; variable entiere
	Ld 0,	STANDARD.REPORT.TEST_NAME_LEN_disp
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	9
	ADD
	Sd  1,	INDENT_disp

VAR I_disp, d				; variable entiere
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	0
	Sd  1,	I_disp

VAR M_disp, d				; variable entiere
	LVA	1, -MSG_ofs
	LIa	, , 8
	Ld	, STRING.FST_1
	Sd  1,	M_disp

VAR N_disp, d				; variable entiere

					;    end elab
begin:					;---------- BDY INSTRUCTIONS
LOOP__1:
					; debut if
	Ld 1,	I_disp
	LVA	1, -MSG_ofs
	LIa	, , 8
	Ld	, STRING.LST_1
	Ld 1,	M_disp
	SUB
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	1
	ADD
	ADD
	Ld 1,	MAX_LEN_disp
	CGT
	BF	L4
	Ld 1,	M_disp
	Ld 1,	MAX_LEN_disp
	Ld 1,	I_disp
	SUB
	ADD
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	1
	SUB
	Sd  1,	N_disp
					; debut if
	LVA	1, -MSG_ofs
	LIa	, , 0				; array data start address on stack
	Ld 1,	N_disp
	LVA	1, -MSG_ofs
	LIa	, 0,  8
	Ld	, STANDARD.STRING.FST_1			; (index - FST_1) * SIZ_1
	SUB
	LVA	1, -MSG_ofs
	LIa	, , 8
	Ld	, STANDARD.STRING.COMP_SIZ
	LI	8
	DIV
	MUL
	ADD					; add offset to start address
	Lb
	LI	32
	CNE
	BF	L6
LOOP__2:
	Ld 1,	N_disp
	Ld 1,	M_disp
	CGE
	DUP
	BF	L8
	DROP
	LVA	1, -MSG_ofs
	LIa	, , 0				; array data start address on stack
	Ld 1,	N_disp
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	1
	ADD
	LVA	1, -MSG_ofs
	LIa	, 0,  8
	Ld	, STANDARD.STRING.FST_1			; (index - FST_1) * SIZ_1
	SUB
	LVA	1, -MSG_ofs
	LIa	, , 8
	Ld	, STANDARD.STRING.COMP_SIZ
	LI	8
	DIV
	MUL
	ADD					; add offset to start address
	Lb
	LI	32
	CNE
L8:
	BF	L7
	Ld 1,	N_disp
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	1
	SUB
	Sd  1,	N_disp
	BRA	LOOP__2
L7:					; post loop LOOP__2
					; debut if
	Ld 1,	N_disp
	Ld 1,	M_disp
	CLT
	BF	L10
	Ld 1,	M_disp
	Ld 1,	MAX_LEN_disp
	Ld 1,	I_disp
	SUB
	ADD
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	1
	SUB
	Sd  1,	N_disp
	BRA	L9
L10:
L9:					; post if
	BRA	L5
L6:
L5:					; post if
	BRA	L3
L4:
	LVA	1, -MSG_ofs
	LIa	, , 8
	Ld	, STRING.LST_1
	Sd  1,	N_disp
L3:					; post if
	Ld 1,	I_disp
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	1
	ADD
; CODE CONVERSION SOURCE DN_INTEGER TARGET DN_INTEGER
VAR	ANON_53_25_disp, q
VAR	ANON_53_25__u,    q
VAR	ANON_53_25__dat, STANDARD.TEXT_IO.FILE_TYPE.size
	LVA 1, ANON_53_25__dat
	Sa  1, ANON_53_25_disp
	La  0, STANDARD.TEXT_IO.FILE_TYPE.use__info
	Sa  1, ANON_53_25__u
	LVA 1, ANON_53_25_disp
					; doublet resultat record anonyme
	CALL	STANDARD.TEXT_IO. ,STANDARD_OUTPUT_L14
	CALL	STANDARD.TEXT_IO. ,SET_COL_L39
	LVA	1, -MSG_ofs
	LIa	, , 0
	Ld 1,	M_disp
	LVA	1, -MSG_ofs
	LIa	, , 8
	Ld	, STANDARD.STRING.FST_1
	SUB
	LI	1
	MUL
	ADD
namespace ANON_54_43			; ensemble doublet @data/@info pour slice anonyme source
VAR ANON_54_43_disp, q
VAR ANON_54_43__u, q
VAR SIZ, d
VAR COMP_SIZ, d
VAR _FST_1, d
VAR _LST_1, d
	Sa	1, ANON_54_43_disp
	LVA	1, SIZ
	Sa	1, ANON_54_43__u
	LI	8
	Sd	1, COMP_SIZ
	Ld 1,	M_disp
	Sd	1, _FST_1
	Ld 1,	N_disp
	Sd	1, _LST_1
	Ld	1, _LST_1
	Ld	1, _FST_1
	SUB
	INC
	LI	8
	MUL
	Sd	1, SIZ
	LVA	1, ANON_54_43_disp
end namespace
VAR	ANON_54_26_disp, q
VAR	ANON_54_26__u,    q
VAR	ANON_54_26__dat, STANDARD.TEXT_IO.FILE_TYPE.size
	LVA 1, ANON_54_26__dat
	Sa  1, ANON_54_26_disp
	La  0, STANDARD.TEXT_IO.FILE_TYPE.use__info
	Sa  1, ANON_54_26__u
	LVA 1, ANON_54_26_disp
					; doublet resultat record anonyme
	CALL	STANDARD.TEXT_IO. ,STANDARD_OUTPUT_L14
	CALL	STANDARD.TEXT_IO. ,PUT_LINE_L59
	Ld 1,	INDENT_disp
	Sd  1,	I_disp
	Ld 1,	N_disp
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	1
	ADD
	Sd  1,	M_disp
LOOP__3:
	Ld 1,	M_disp
	LVA	1, -MSG_ofs
	LIa	, , 8
	Ld	, STRING.LST_1
	CLE
	DUP
	BF	L12
	DROP
	LVA	1, -MSG_ofs
	LIa	, , 0				; array data start address on stack
	Ld 1,	M_disp
	LVA	1, -MSG_ofs
	LIa	, 0,  8
	Ld	, STANDARD.STRING.FST_1			; (index - FST_1) * SIZ_1
	SUB
	LVA	1, -MSG_ofs
	LIa	, , 8
	Ld	, STANDARD.STRING.COMP_SIZ
	LI	8
	DIV
	MUL
	ADD					; add offset to start address
	Lb
	LI	32
	CEQ
L12:
	BF	L11
	Ld 1,	M_disp
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	1
	ADD
	Sd  1,	M_disp
	BRA	LOOP__3
L11:					; post loop LOOP__3
	Ld 1,	M_disp
	LVA	1, -MSG_ofs
	LIa	, , 8
	Ld	, STRING.LST_1
	CGT
	BT	L2
	BRA	LOOP__1
L2:					; post loop LOOP__1
ret_lbl:
	UNLINK 1
	RTD	prm_siz
excep:
endPRO					;---------- end PRO PUT_MSG
end if

if defined TEST_L1_
