if defined PUT_MSG_L1_
PRO	PUT_MSG_L1				;---------- PRO PUT_MSG
PRMS					;    debut parametrage
	PRM MSG_ofs				; in
endPRMS					;    fin parametrage
ELB 1					;    BODY ELAB
VAR MAX_LEN_disp, d				; variable entiere
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	72
	Sd  1,	MAX_LEN_disp

VAR INDENT_disp, d				; variable entiere
	Ld 0,	STANDARD.REPORT.TEST_NAME_LEN_disp
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	9
	ADD
	Sd  1,	INDENT_disp

VAR I_disp, d				; variable entiere
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	0
	Sd  1,	I_disp

VAR M_disp, d				; variable entiere
	LVA	1, -MSG_ofs
	LIa	, , 8
	Ld	, _STRING.FST_1
	Sd  1,	M_disp

VAR N_disp, d				; variable entiere

					;    end elab
begin:					;---------- BDY INSTRUCTIONS
LOOP__1:
					; debut if
	Ld 1,	I_disp
	LVA	1, -MSG_ofs
	LIa	, , 8
	Ld	, _STRING.LST_1
	Ld 1,	M_disp
	SUB
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	1
	ADD
	ADD
	Ld 1,	MAX_LEN_disp
	CGT
	BF	L6
	Ld 1,	M_disp
	Ld 1,	MAX_LEN_disp
	Ld 1,	I_disp
	SUB
	ADD
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	1
	SUB
	Sd  1,	N_disp
					; debut if
	LVA	1, -MSG_ofs
	LIa	, , 0				; array data start address on stack
	Ld 1,	N_disp
	LVA	1, -MSG_ofs
	LIa	, 0,  8
	Ld	, STANDARD._STRING.FST_1			; (index - FST_1) * SIZ_1
	SUB
	LVA	1, -MSG_ofs
	LIa	, , 8
	Ld	, STANDARD._STRING.COMP_SIZ
	LI	8
	DIV
	MUL
	ADD					; add offset to start address
	Lb
	LI	32
	CNE
	BF	L8
LOOP__2:
	Ld 1,	N_disp
	Ld 1,	M_disp
	CGE
	DUP
	BF	L10
	DROP
	LVA	1, -MSG_ofs
	LIa	, , 0				; array data start address on stack
	Ld 1,	N_disp
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	1
	ADD
	LVA	1, -MSG_ofs
	LIa	, 0,  8
	Ld	, STANDARD._STRING.FST_1			; (index - FST_1) * SIZ_1
	SUB
	LVA	1, -MSG_ofs
	LIa	, , 8
	Ld	, STANDARD._STRING.COMP_SIZ
	LI	8
	DIV
	MUL
	ADD					; add offset to start address
	Lb
	LI	32
	CNE
L10:
	BF	L9
	Ld 1,	N_disp
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	1
	SUB
	Sd  1,	N_disp
	BRA	LOOP__2
L9:					; post loop LOOP__2
					; debut if
	Ld 1,	N_disp
	Ld 1,	M_disp
	CLT
	BF	L12
	Ld 1,	M_disp
	Ld 1,	MAX_LEN_disp
	Ld 1,	I_disp
	SUB
	ADD
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	1
	SUB
	Sd  1,	N_disp
	BRA	L11
L12:
L11:					; post if
	BRA	L7
L8:
L7:					; post if
	BRA	L5
L6:
	LVA	1, -MSG_ofs
	LIa	, , 8
	Ld	, _STRING.LST_1
	Sd  1,	N_disp
L5:					; post if
	Ld 1,	I_disp
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	1
	ADD
; CODE CONVERSION SOURCE DN_INTEGER TARGET DN_INTEGER
VAR	ANON_53_25_disp, q
VAR	ANON_53_25__u,    q
VAR	ANON_53_25__dat, STANDARD.TEXT_IO._FILE_TYPE.size
	LVA 1, ANON_53_25__dat
	Sa  1, ANON_53_25_disp
	La  0, STANDARD.TEXT_IO._FILE_TYPE.use__info
	Sa  1, ANON_53_25__u
	LVA 1, ANON_53_25_disp
					; doublet resultat record anonyme
	CALL	STANDARD.TEXT_IO. ,STANDARD_OUTPUT_L14
	CALL	STANDARD.TEXT_IO. ,SET_COL_L39
	LVA	1, -MSG_ofs
	LIa	, , 0
	Ld 1,	M_disp
	LVA	1, -MSG_ofs
	LIa	, , 8
	Ld	, STANDARD._STRING.FST_1
	SUB
	LI	1
	MUL
	ADD
namespace ANON_54_43			; ensemble doublet @data/@info pour slice anonyme source
VAR ANON_54_43_disp, q
VAR ANON_54_43__u, q
VAR SIZ, d
VAR COMP_SIZ, d
VAR _FST_1, d
VAR _LST_1, d
	Sa	1, ANON_54_43_disp
	LVA	1, SIZ
	Sa	1, ANON_54_43__u
	LI	8
	Sd	1, COMP_SIZ
	Ld 1,	M_disp
	Sd	1, _FST_1
	Ld 1,	N_disp
	Sd	1, _LST_1
	Ld	1, _LST_1
	Ld	1, _FST_1
	SUB
	INC
	CLAMP0
	LI	8
	MUL
	Sd	1, SIZ
	LVA	1, ANON_54_43_disp
