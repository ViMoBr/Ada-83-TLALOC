	LIa	, , 8
	Ld	, _STRING.FST_1
	Ld 0,	STANDARD.REPORT.TEST_NAME_LEN_disp
	ADD
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	1
	SUB
	INC
	LVA	1, -NAME_ofs
	LIa	, , 8
	Ld	, _STRING.FST_1
	SUB
	LI	1
	MUL
	DROP
	BLKMOV
