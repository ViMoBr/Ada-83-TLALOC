_TEST_NAME__type = '_TEST_NAME__type'
namespace _TEST_NAME__type			; array var constrained array type info
VAR use__info, q
VAR SIZ, d
	LVA	0, SIZ
	Sa	0, use__info
VAR _COMP_SIZ, d
VAR _FST_1, d
VAR _LST_1, d
	LI	8
	Sd	0, _COMP_SIZ
	Ld	0, _COMP_SIZ
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	1
	Sd	0, _FST_1
; CODE_NUMERIC_LITERAL DN_UNIVERSAL_INTEGER
	LI	15
	Sd	0, _LST_1
	Ld	0, _LST_1
	Ld	0, _FST_1
	SUB
	INC
	CLAMP0
	MUL
	Sd	0, SIZ
  virtual at 4
COMP_SIZ = $
	rd 1 
FST_1 = $
	rd 1 
LST_1 = $
	rd 1 
  end virtual
end namespace
VAR TEST_NAME_disp, q			; variable array : pointeur aux data
VAR TEST_NAME__u, q				; variable array : useinfo pointeur au rec info
	La 0, _TEST_NAME__type.use__info
	Sa	0, TEST_NAME__u				; array info ptr at __u
	Ld	0, _TEST_NAME__type.SIZ
	LI	8
	DIV
	CO_VAR
	Sa	0, TEST_NAME_disp			; array data ptr at _disp

