VAR	ANON_54_26_disp, q
VAR	ANON_54_26__u,    q
VAR	ANON_54_26__dat, STANDARD.TEXT_IO._FILE_TYPE.size
	LVA 1, ANON_54_26__dat
	Sa  1, ANON_54_26_disp
	La  0, STANDARD.TEXT_IO._FILE_TYPE.use__info
	Sa  1, ANON_54_26__u
	LVA 1, ANON_54_26_disp
					; doublet resultat record anonyme
	CALL	STANDARD.TEXT_IO. ,STANDARD_OUTPUT_L14
	CALL	STANDARD.TEXT_IO. ,PUT_LINE_L59
	Ld 1,	INDENT_disp
	Sd  1,	I_disp
	Ld 1,	N_disp
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	1
	ADD
	Sd  1,	M_disp
LOOP__3:
	Ld 1,	M_disp
	LVA	1, -MSG_ofs
	LIa	, , 8
	Ld	, _STRING.LST_1
	CLE
	DUP
	BF	L14
	DROP
	LVA	1, -MSG_ofs
	LIa	, , 0				; array data start address on stack
	Ld 1,	M_disp
	LVA	1, -MSG_ofs
	LIa	, 0,  8
	Ld	, STANDARD._STRING.FST_1			; (index - FST_1) * SIZ_1
	SUB
	LVA	1, -MSG_ofs
	LIa	, , 8
	Ld	, STANDARD._STRING.COMP_SIZ
	LI	8
	DIV
	MUL
	ADD					; add offset to start address
	Lb
	LI	32
	CEQ
L14:
	BF	L13
	Ld 1,	M_disp
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	1
	ADD
	Sd  1,	M_disp
	BRA	LOOP__3
L13:					; post loop LOOP__3
	Ld 1,	M_disp
	LVA	1, -MSG_ofs
	LIa	, , 8
	Ld	, _STRING.LST_1
	CGT
	BT	L4
	BRA	LOOP__1
L4:					; post loop LOOP__1
ret_lbl:
	UNLINK 1
	RTD	prm_siz
excep:
endPRO					;---------- end PRO PUT_MSG
end if

