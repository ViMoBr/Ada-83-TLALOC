					; CODE_PACKAGE_SPEC

					; _FILE_NUM INTEGER SUBTYPE INFO
_FILE_NUM = '_FILE_NUM'
namespace _FILE_NUM
VAR use__info, q
VAR SIZ, d
	LVA	0, SIZ
	Sa	0, use__info
VAR FST, d
VAR LST, d
	LI	32
	Sd	0, SIZ
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	1
	Sd	0, FST
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	3
	Sd	0, LST
