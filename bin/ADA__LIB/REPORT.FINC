_STATUS = '_STATUS'
namespace _STATUS
VAR use__info, q
BEGIN_BLOC_DEF
db 0, 4, "PASS"
db 1, 4, "FAIL"
db 2, 14, "DOES_NOT_APPLY"
db 3, 15, "ACTION_REQUIRED"
END_BLOC_DEF 8, 0, 3
	; SIZ en bits !
	LCA	SIZ
	Sa	0, use__info
end namespace
