	La  1, ANON_23_24_L3_R_disp
	La  1, ANON_23_24_L3_G_len
	ADD
	La  1, ANON_24_24_L3_D_len
	La  1, ANON_24_24_L3_D_data
	BLKMOV
	LVA 1, ANON_23_24_L3_R_disp
	DUP
	La  ,  0
	Sa  1, ANON_23_24_L2_G_data
	La  ,  8
	Sa  1, ANON_23_24_L2_G_info
	LId 1, ANON_23_24_L2_G_info, _STRING.LST_1
	LId 1, ANON_23_24_L2_G_info, _STRING.FST_1
	SUB
	INC
	Sa  1, ANON_23_24_L2_G_len
STR ANON_25_24_L2_D, "VARIOUS OTHER TYPES"	; constante string="VARIOUS OTHER TYPES"
	LCA	ANON_25_24_L2_D.data_ptr
