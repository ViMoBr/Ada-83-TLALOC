STR ANON_23_24_L3_G, "CHECK THAT PRIVATE TYPES AND LIMITED PRIVATE "	; constante string="CHECK THAT PRIVATE TYPES AND LIMITED PRIVATE "
	LCA	ANON_23_24_L3_G.data_ptr
	DUP
	La  ,  0
	Sa  1, ANON_23_24_L3_G_data
	La  ,  8
	Sa  1, ANON_23_24_L3_G_info
	LId 1, ANON_23_24_L3_G_info, _STRING.LST_1
	LId 1, ANON_23_24_L3_G_info, _STRING.FST_1
	SUB
	INC
	Sa  1, ANON_23_24_L3_G_len
STR ANON_24_24_L3_D, "TYPES CAN BE DEFINED IN TERMS OF "	; constante string="TYPES CAN BE DEFINED IN TERMS OF "
	LCA	ANON_24_24_L3_D.data_ptr
	DUP
	La  ,  0
	Sa  1, ANON_24_24_L3_D_data
	La  ,  8
	Sa  1, ANON_24_24_L3_D_info
	LId 1, ANON_24_24_L3_D_info, _STRING.LST_1
	LId 1, ANON_24_24_L3_D_info, _STRING.FST_1
	SUB
	INC
	Sa  1, ANON_24_24_L3_D_len
	La  1, ANON_23_24_L3_G_len
	La  1, ANON_24_24_L3_D_len
	ADD
	CO_VAR
	Sa  1, ANON_23_24_L3_R_disp
	LI	1
	Sd  1, ANON_23_24_L3_R_info._FST_1
	La  1, ANON_23_24_L3_G_len
	La  1, ANON_24_24_L3_D_len
	ADD
	Sd  1, ANON_23_24_L3_R_info._LST_1
	LI	8
	Sd  1, ANON_23_24_L3_R_info._COMP_SIZ
	La  1, ANON_23_24_L3_G_len
	La  1, ANON_24_24_L3_D_len
	ADD
	LI	8
	MUL
	Sd  1, ANON_23_24_L3_R_info.SIZ
	LVA 1, ANON_23_24_L3_R_info.SIZ
	Sa  1, ANON_23_24_L3_R__u
	La  1, ANON_23_24_L3_R_disp
	La  1, ANON_23_24_L3_G_len
	La  1, ANON_23_24_L3_G_data
