PRO	UNCHECKED_CONVERSION_L1			;---------- PRO UNCHECKED_CONVERSION
virtual at 8
	SOURCE__u_ofs = $
	rq 1
	SOURCE__ld_ofs = $
	rq 1
	SOURCE__st_ofs = $
	rq 1
	SOURCE__inadr_ofs = $
	rq 1
	SOURCE__outadr_ofs = $
	rq 1
	TARGET__u_ofs = $
	rq 1
	TARGET__ld_ofs = $
	rq 1
	TARGET__st_ofs = $
	rq 1
	TARGET__inadr_ofs = $
	rq 1
	TARGET__outadr_ofs = $
	rq 1
end virtual
PRMS					;    debut parametrage
	PRM S_ofs				; in
	PRM GFP_ofs
	PRM result__ofs				; resultat de fonction
endPRMS					;    fin parametrage
ELB 1					;    BODY ELAB
					;    end elab
begin:					;---------- BDY INSTRUCTIONS
ret_lbl:
