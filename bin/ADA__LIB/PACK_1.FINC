elab_spec:				;    SPEC ELAB

					;    BODY ELAB

if defined WRITE_SOMETHING_L1_
PRO	WRITE_SOMETHING_L1			;---------- PRO WRITE_SOMETHING
ELB 1					;    BODY ELAB
					;    end elab
begin:					;---------- BDY INSTRUCTIONS
STR STR_L1, ' Something '			; constante string=' Something '
	LCA	STR_L1.data_ptr
