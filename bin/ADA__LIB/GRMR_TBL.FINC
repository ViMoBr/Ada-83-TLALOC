FILE_NAME_BUFFER = 'FILE_NAME_BUFFER'
namespace FILE_NAME_BUFFER			; FILE_NAME_BUFFER CONSTRAINED ARRAY SUBTYPE INFO
VAR use__info, q
VAR SIZ, d
	LVA	0, SIZ
	Sa	0, use__info
VAR COMP_SIZ, d
VAR FST_1, d
VAR LST_1, d
	LI	8
	Sd	0, COMP_SIZ
	Ld	0, COMP_SIZ
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	1
	Sd	0, FST_1
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	256
	Sd	0, LST_1
	Ld	0, LST_1
	INC
	Ld	0, FST_1
	SUB
	MUL
	Sd	0, SIZ
  virtual at 4
COMP_SIZ = $
	rd 1 
FST_1 = $
	rd 1 
LST_1 = $
	rd 1 
  end virtual
end namespace

					; FILE_TYPE RECORD TYPE INFO
FILE_TYPE = 'FILE_TYPE'
namespace FILE_TYPE
VAR use__info, q
VAR SIZ, d
	LVA	0, SIZ
	Sa	0, use__info
USEINFO 0, ID, 	La 0, STANDARD.INTEGER.use__info
USEINFO 0, NAME, 	La 0, STANDARD.GRMR_TBL.GRMR_TBL_IO.FILE_NAME_BUFFER.use__info
USEINFO 0, NAME_LEN, 	La 0, STANDARD.POSITIVE.use__info
USEINFO 0, IS_OPENED, 	La 0, STANDARD.BOOLEAN.use__info
USEINFO 0, MODE, 	La 0, STANDARD.GRMR_TBL.GRMR_TBL_IO.FILE_MODE.use__info
USEINFO 0, AT_END_OF_FILE, 	La 0, STANDARD.BOOLEAN.use__info
virtual at 0				; calcul des offsets statiques
STATOFS ID, 4
STATOFS NAME, 256
STATOFS NAME_LEN, 4
STATOFS IS_OPENED, 1
STATOFS MODE, 1
STATOFS AT_END_OF_FILE, 1
size = $
end virtual
	LI	 size*8
	Sd	0, SIZ
end namespace
					;---------- end generic package instantiation GRMR_TBL_IO
end namespace

