GRMR_TBL_RECORD = 'GRMR_TBL_RECORD'
namespace GRMR_TBL_RECORD
VAR use__info, q
VAR SIZ, d
	LVA	0, SIZ
	Sa	0, use__info
USEINFO 0, ST_TBL, 	La 0, STANDARD.GRMR_TBL.ST_TBL_TYPE.use__info
USEINFO 0, ST_TBL_LAST, 	La 0, STANDARD.INTEGER.use__info
USEINFO 0, AC_SYM, 	La 0, STANDARD.GRMR_TBL.AC_SYM_TYPE.use__info
USEINFO 0, AC_TBL, 	La 0, STANDARD.GRMR_TBL.AC_TBL_TYPE.use__info
USEINFO 0, AC_SYM_LAST, 	La 0, STANDARD.INTEGER.use__info
USEINFO 0, AC_TBL_LAST, 	La 0, STANDARD.INTEGER.use__info
USEINFO 0, NTER_PG, 	La 0, STANDARD.GRMR_TBL.NTER_PG_TYPE.use__info
USEINFO 0, NTER_LN, 	La 0, STANDARD.GRMR_TBL.NTER_LN_TYPE.use__info
USEINFO 0, NTER_LAST, 	La 0, STANDARD.INTEGER.use__info
virtual at 0				; calcul des offsets statiques
STATOFS ST_TBL, 4000
STATOFS ST_TBL_LAST, 4
STATOFS AC_SYM, 9600
STATOFS AC_TBL, 12000
STATOFS AC_SYM_LAST, 4
STATOFS AC_TBL_LAST, 4
STATOFS NTER_PG, 510
STATOFS NTER_LN, 510
STATOFS NTER_LAST, 4
size = $
end virtual
	LI	 size*8
	Sd	0, SIZ
end namespace
VAR GRMR_disp, q				; variable record : pointeur aux data record
VAR GRMR__u, q				; variable record : pointeur aux useinfo
VAR GRMR__dat, STANDARD.GRMR_TBL.GRMR_TBL_RECORD.size
	LVA	0, GRMR__dat
	Sa	0, GRMR_disp				; record fin
	LVA	0, STANDARD.GRMR_TBL.GRMR_TBL_RECORD.SIZ
	Sa	0, GRMR__u
; CODE_VC_NAME DN_VARIABLE_ID

GRMR_TBL_IO = 'GRMR_TBL_IO'
namespace GRMR_TBL_IO			;---------- GENERIC PACKAGE INSTANTIATION
elab_spec:				;    SPEC ELAB

BRA post_LD_GRMR_TBL_RECORD
LD_GRMR_TBL_RECORD.elab:
	LI 0
	RTD 0
post_LD_GRMR_TBL_RECORD:
BRA post_ST_GRMR_TBL_RECORD
ST_GRMR_TBL_RECORD.elab:
	DROP
	RTD 0
post_ST_GRMR_TBL_RECORD:
BRA post_INADR_GRMR_TBL_RECORD
INADR_GRMR_TBL_RECORD.elab:
	LIa
	RTD 0
post_INADR_GRMR_TBL_RECORD:
BRA post_OUTADR_GRMR_TBL_RECORD
OUTADR_GRMR_TBL_RECORD.elab:
	LIa
	RTD 0
post_OUTADR_GRMR_TBL_RECORD:
VAR GRMR_TBL_RECORD__outadr_ofs, q
	LCA OUTADR_GRMR_TBL_RECORD.elab
	Sa	 0, GRMR_TBL_RECORD__outadr_ofs
VAR GRMR_TBL_RECORD__inadr_ofs, q
	LCA INADR_GRMR_TBL_RECORD.elab
	Sa	 0, GRMR_TBL_RECORD__inadr_ofs
VAR GRMR_TBL_RECORD__st_ofs, q
	LCA ST_GRMR_TBL_RECORD.elab
	Sa	 0, GRMR_TBL_RECORD__st_ofs
VAR GRMR_TBL_RECORD__ld_ofs, q
	LCA LD_GRMR_TBL_RECORD.elab
	Sa	 0, GRMR_TBL_RECORD__ld_ofs
VAR GRMR_TBL_RECORD__u_ofs, q
	La	 0, STANDARD.GRMR_TBL.GRMR_TBL_RECORD.use__info
	Sa	 0, GRMR_TBL_RECORD__u_ofs
VAR GFP_disp, q				; Lieu du Generic Frame Pointer 
; CODE_TYPE_DECL : skip PRIVATE FILE_TYPE (deferred to full type)

					; FILE_MODE ENUMERATION TYPE INFO
FILE_MODE = 'FILE_MODE'
namespace FILE_MODE
VAR use__info, q
BEGIN_BLOC_DEF
db 0, 7, "IN_FILE"
db 1, 8, "OUT_FILE"
END_BLOC_DEF
IMAGES	BYTES_BLOC
CST LST, d, 1
CST FST, d, 0
CST SIZ, d, 8	; SIZ en bits !
postpone
  align_q
end postpone
	LCA	SIZ
	Sa	0, use__info
end namespace
if defined CREATE_L1_
PRO	CREATE_L1				;---------- PRO CREATE
PRMS					;    debut parametrage
	PRM FILE_ofs				; in out
	PRM MODE_ofs				; in
	PRM NAME_ofs				; in
	PRM FORM_ofs				; in
endPRMS					;    fin parametrage
ELB 1
begin:
	LVA	 0, GFP_disp
	La 	 1, -FORM_ofs
	La 	 1, -NAME_ofs
	Lb	 1, -MODE_ofs
	La 	 1, -FILE_ofs
	CALL	STANDARD.SEQUENTIAL_IO. ,CREATE_L1
	UNLINK	 1
	RTD	prm_siz
endPRO					;---------- end PRO CREATE
end if
if defined OPEN_L2_
PRO	OPEN_L2				;---------- PRO OPEN
PRMS					;    debut parametrage
	PRM FILE_ofs				; in out
