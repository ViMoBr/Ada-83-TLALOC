end if
					; sub program entry decl (in instantiation TRUE )
if defined MODE_L7_
PRO	MODE_L7				;---------- PRO MODE
PRMS					;    debut parametrage
	PRM FILE_ofs				; in
	PRM result__ofs				; resultat de fonction
endPRMS					;    fin parametrage
ELB 1
begin:
	LI	0					; lieu result
	LVA	 0, GFP_disp
	La 	 1, -FILE_ofs
	CALL	STANDARD.SEQUENTIAL_IO. ,MODE_L7
	Sb	 1, -result__ofs			; retour resultat
	UNLINK	 1
	RTD	prm_siz-8
endPRO					;---------- end PRO MODE
end if
					; sub program entry decl (in instantiation TRUE )
if defined NAME_L8_
PRO	NAME_L8				;---------- PRO NAME
