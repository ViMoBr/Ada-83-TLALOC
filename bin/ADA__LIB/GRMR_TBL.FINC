					; _AC_BYTE TYPE RANGE INFO
_AC_BYTE = '_AC_BYTE'
namespace _AC_BYTE
VAR use__info, q
VAR SIZ, d
	LVA	0, SIZ
	Sa	0, use__info
VAR FST, w
VAR LST, w
	LI	16
	Sd	0, SIZ
; CODE_NUMERIC_LITERAL DN_UNIVERSAL_INTEGER
	LI	0
	Sw	0, FST
; CODE_NUMERIC_LITERAL DN_UNIVERSAL_INTEGER
	LI	255
	Sw	0, LST
end namespace

					; _AC_SHORT TYPE RANGE INFO
_AC_SHORT = '_AC_SHORT'
namespace _AC_SHORT
VAR use__info, q
VAR SIZ, d
	LVA	0, SIZ
	Sa	0, use__info
VAR FST, w
VAR LST, w
	LI	16
	Sd	0, SIZ
; CODE_NUMERIC_LITERAL DN_UNIVERSAL_INTEGER
	LI	00032768
	NEG
	Sw	0, FST
; CODE_NUMERIC_LITERAL DN_UNIVERSAL_INTEGER
	LI	32767
	Sw	0, LST
end namespace

					; array decl constrained array type info
_ST_TBL_TYPE = '_ST_TBL_TYPE'
namespace _ST_TBL_TYPE
VAR use__info, q
VAR SIZ, d
	LVA	0, SIZ
	Sa	0, use__info
VAR _COMP_SIZ, d
VAR _FST_1, d
VAR _LST_1, d
	LI	32
	Sd	0, _COMP_SIZ
	Ld	0, _COMP_SIZ
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	1
	Sd	0, _FST_1
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	1000
	Sd	0, _LST_1
	Ld	0, _LST_1
	Ld	0, _FST_1
	SUB
	INC
	CLAMP0
	MUL
	Sd	0, SIZ
  virtual at 4
COMP_SIZ = $
	rd 1 
FST_1 = $
	rd 1 
LST_1 = $
	rd 1 
  end virtual
end namespace

