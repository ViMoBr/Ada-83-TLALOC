	La 	 1, -FORM_ofs
	La 	 1, -NAME_ofs
	Lb	 1, -MODE_ofs
	La 	 1, -FILE_ofs
	CALL	STANDARD.SEQUENTIAL_IO. ,OPEN_L2
	UNLINK	 1
	RTD	prm_siz
endPRO					;---------- end PRO OPEN
end if
