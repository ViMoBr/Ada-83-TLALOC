					; doublet resultat record anonyme
	LVA 2,	REGION_disp
	CALL	STANDARD.IDL.SEM_PHASE_L11.DEF_UTIL. ,GET_DEF_FOR_ID_L55
	La  ,  0
	BLKMOV

					;    end elab
