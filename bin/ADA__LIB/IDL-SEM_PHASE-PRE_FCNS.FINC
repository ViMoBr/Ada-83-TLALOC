	La  0, STANDARD.IDL._TREE.use__info
	Sa  2, ANON_89_36__u
	LVA 2, ANON_89_36_disp
					; doublet resultat record anonyme
	LVA 2,	BASE_TYPE_disp
	LI  35
	CALL	STANDARD.IDL. ,D_L17
	LI  14
	CALL	STANDARD.IDL. ,D_L17
	La  ,  0
	BLKMOV

VAR REGION_DEF_disp, q			; variable record : pointeur aux data record
VAR REGION_DEF__u, q			; variable record : pointeur aux useinfo
VAR REGION_DEF__dat, STANDARD.IDL._TREE.size
	LVA	2, REGION_DEF__dat
	Sa	2, REGION_DEF_disp			; record fin
	LVA	2, STANDARD.IDL._TREE.SIZ
	Sa	2, REGION_DEF__u
; CODE_VC_NAME DN_VARIABLE_ID
	La  2, REGION_DEF_disp
	LI	STANDARD.IDL._TREE.size
VAR	ANON_90_25_disp, q
VAR	ANON_90_25__u,    q
VAR	ANON_90_25__dat, STANDARD.IDL._TREE.size
	LVA 2, ANON_90_25__dat
