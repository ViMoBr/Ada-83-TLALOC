if defined GEN_IN_L1_
PRO	GEN_IN_L1				;---------- PRO GEN_IN
PRMS					;    debut parametrage
	PRM SYMREP_ofs				; in
	PRM TYPE_SPEC_ofs				; in
	PRM result__ofs				; resultat de fonction
endPRMS					;    fin parametrage
ELB 1					;    BODY ELAB
					;    end elab
begin:					;---------- BDY INSTRUCTIONS
; CODE_RETURN : EXPR TYPE = DN_RECORD
	La   1,	-result__ofs
	La  ,  0
	LI	STANDARD.IDL._TREE.size
VAR	ANON_48_12_disp, q
VAR	ANON_48_12__u,    q
VAR	ANON_48_12__dat, STANDARD.IDL._TREE.size
	LVA 1, ANON_48_12__dat
	Sa  1, ANON_48_12_disp
	La  0, STANDARD.IDL._TREE.use__info
	Sa  1, ANON_48_12__u
	LVA 1, ANON_48_12_disp
					; doublet resultat record anonyme
	LI  0
	LVA  0,	STANDARD.IDL.TREE_VOID_disp		; array actual
	LVA  0,	STANDARD.IDL.TREE_VOID_disp		; array actual
	LVA  0,	STANDARD.IDL.TREE_VOID_disp		; array actual
VAR	ANON_48_41_disp, q
VAR	ANON_48_41__u,    q
VAR	ANON_48_41__dat, STANDARD.IDL._TREE.size
	LVA 1, ANON_48_41__dat
	Sa  1, ANON_48_41_disp
	La  0, STANDARD.IDL._TREE.use__info
	Sa  1, ANON_48_41__u
	LVA 1, ANON_48_41_disp
					; doublet resultat record anonyme
	LVA  0,	STANDARD.IDL.TREE_VOID_disp		; array actual
VAR	ANON_48_69_disp, q
VAR	ANON_48_69__u,    q
VAR	ANON_48_69__dat, STANDARD.IDL._SEQ_TYPE.size
	LVA 1, ANON_48_69__dat
	Sa  1, ANON_48_69_disp
	La  0, STANDARD.IDL._SEQ_TYPE.use__info
	Sa  1, ANON_48_69__u
	LVA 1, ANON_48_69_disp
					; doublet resultat record anonyme
VAR	ANON_48_80_disp, q
VAR	ANON_48_80__u,    q
VAR	ANON_48_80__dat, STANDARD.IDL._TREE.size
	LVA 1, ANON_48_80__dat
	Sa  1, ANON_48_80_disp
	La  0, STANDARD.IDL._TREE.use__info
	Sa  1, ANON_48_80__u
	LVA 1, ANON_48_80_disp
					; doublet resultat record anonyme
	LVA  0,	STANDARD.IDL.TREE_VOID_disp		; array actual
	LVA  0,	STANDARD.IDL.TREE_VOID_disp		; array actual
	LVA  0,	STANDARD.IDL.TREE_VOID_disp		; array actual
	La  1,	-TYPE_SPEC_ofs
	La  1,	-SYMREP_ofs
	LVA  0,	STANDARD.IDL.TREE_VOID_disp		; array actual
	CALL	STANDARD.IDL.SEM_PHASE_L11.MAKE_NOD. ,MAKE_IN_ID_L232
	CALL	STANDARD.IDL.IDL_MAN. ,SINGLETON_L35
	CALL	STANDARD.IDL.SEM_PHASE_L11.MAKE_NOD. ,MAKE_SOURCE_NAME_S_L318
	CALL	STANDARD.IDL.SEM_PHASE_L11.MAKE_NOD. ,MAKE_IN_L258
	La  ,  0
	BLKMOV
	BRA ret_lbl
ret_lbl:
	UNLINK 1
	RTD	prm_siz-8
excep:
endPRO					;---------- end PRO GEN_IN
end if

