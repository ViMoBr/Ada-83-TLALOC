VAR	ANON_88_25__u,    q
VAR	ANON_88_25__dat, STANDARD.IDL._TREE.size
	LVA 2, ANON_88_25__dat
	Sa  2, ANON_88_25_disp
	La  0, STANDARD.IDL._TREE.use__info
	Sa  2, ANON_88_25__u
	LVA 2, ANON_88_25_disp
					; doublet resultat record anonyme
	La  1,	-TYPE_SPEC_ofs
	CALL	STANDARD.IDL.SEM_PHASE_L11.DEF_UTIL. ,GET_BASE_TYPE_L71
	La  ,  0
	BLKMOV

VAR REGION_disp, q				; variable record : pointeur aux data record
VAR REGION__u, q				; variable record : pointeur aux useinfo
VAR REGION__dat, STANDARD.IDL._TREE.size
	LVA	2, REGION__dat
	Sa	2, REGION_disp				; record fin
	LVA	2, STANDARD.IDL._TREE.SIZ
	Sa	2, REGION__u
; CODE_VC_NAME DN_VARIABLE_ID
	La  2, REGION_disp
	LI	STANDARD.IDL._TREE.size
VAR	ANON_89_22_disp, q
VAR	ANON_89_22__u,    q
VAR	ANON_89_22__dat, STANDARD.IDL._TREE.size
	LVA 2, ANON_89_22__dat
