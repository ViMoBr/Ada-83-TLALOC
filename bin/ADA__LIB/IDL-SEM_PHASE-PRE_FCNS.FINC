VAR	ANON_48_80__u,    q
VAR	ANON_48_80__dat, STANDARD.IDL._TREE.size
	LVA 1, ANON_48_80__dat
	Sa  1, ANON_48_80_disp
	La  0, STANDARD.IDL._TREE.use__info
	Sa  1, ANON_48_80__u
	LVA 1, ANON_48_80_disp
					; doublet resultat record anonyme
	LVA  0,	STANDARD.IDL.TREE_VOID_disp		; array actual
	LVA  0,	STANDARD.IDL.TREE_VOID_disp		; array actual
	LVA  0,	STANDARD.IDL.TREE_VOID_disp		; array actual
	La  1,	-TYPE_SPEC_ofs
	La  1,	-SYMREP_ofs
	LVA  0,	STANDARD.IDL.TREE_VOID_disp		; array actual
	CALL	STANDARD.IDL.SEM_PHASE_L11.MAKE_NOD. ,MAKE_IN_ID_L232
	CALL	STANDARD.IDL.IDL_MAN. ,SINGLETON_L35
	CALL	STANDARD.IDL.SEM_PHASE_L11.MAKE_NOD. ,MAKE_SOURCE_NAME_S_L318
	CALL	STANDARD.IDL.SEM_PHASE_L11.MAKE_NOD. ,MAKE_IN_L258
	La  ,  0
	BLKMOV
	BRA ret_lbl
ret_lbl:
	UNLINK 1
	RTD	prm_siz-8
excep:
endPRO					;---------- end PRO GEN_IN
end if

