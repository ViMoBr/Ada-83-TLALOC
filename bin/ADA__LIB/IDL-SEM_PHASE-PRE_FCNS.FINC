if defined GEN_OP_DEF_L13_
PRO	GEN_OP_DEF_L13				;---------- PRO GEN_OP_DEF
PRMS					;    debut parametrage
	PRM OP_ofs				; in
	PRM HEADER_ofs				; in
	PRM H_ofs				; in
endPRMS					;    fin parametrage
ELB 1					;    BODY ELAB
VAR DEF_disp, q				; variable record : pointeur aux data record
VAR DEF__u, q				; variable record : pointeur aux useinfo
VAR DEF__dat, STANDARD.IDL._TREE.size
	LVA	1, DEF__dat
	Sa	1, DEF_disp				; record fin
	LVA	1, STANDARD.IDL._TREE.SIZ
	Sa	1, DEF__u
; CODE_VC_NAME DN_VARIABLE_ID
	LIVA 1, DEF_disp, STANDARD.IDL._TREE.PT
	LI	0
	Sb

					;    end elab
begin:					;---------- BDY INSTRUCTIONS
	LVA 1,	DEF_disp
	La
	LI	STANDARD.IDL._TREE.size
VAR	ANON_73_12_disp, q
VAR	ANON_73_12__u,    q
VAR	ANON_73_12__dat, STANDARD.IDL._TREE.size
	LVA 1, ANON_73_12__dat
	Sa  1, ANON_73_12_disp
	La  0, STANDARD.IDL._TREE.use__info
	Sa  1, ANON_73_12__u
	LVA 1, ANON_73_12_disp
					; doublet resultat record anonyme
	La  1,	-H_ofs
	La	 1, BLTN_ID_ARRAY_disp			; array data start address on stack
	Lb  1,	-OP_ofs
	LId	1, BLTN_ID_ARRAY__u, STANDARD.IDL.SEM_PHASE_L11.PRENAME._BLTN_ID_ARRAY.FST_1	; (index - FST_1) * SIZ_1
	SUB
	LId	1, BLTN_ID_ARRAY__u, STANDARD.IDL.SEM_PHASE_L11.PRENAME._BLTN_ID_ARRAY.COMP_SIZ
	LI	8
	DIV
	MUL
	ADD					; add offset to start address
	CALL	STANDARD.IDL.SEM_PHASE_L11.DEF_UTIL. ,MAKE_DEF_FOR_ID_L52
	La
	BLKMOV
	La  1,	-HEADER_ofs
	LVA 1,	DEF_disp
	CALL	STANDARD.IDL.SEM_PHASE_L11.DEF_UTIL. ,MAKE_DEF_VISIBLE_L67
ret_lbl:
	UNLINK 1
	RTD	prm_siz
excep:
endPRO					;---------- end PRO GEN_OP_DEF
end if

if defined OPS_ARE_NOT_YET_DEFINED_L16_
PRO	OPS_ARE_NOT_YET_DEFINED_L16		;---------- PRO OPS_ARE_NOT_YET_DEFINED
PRMS					;    debut parametrage
	PRM TYPE_SPEC_ofs				; in
	PRM OP_FIRST_ofs				; in
	PRM OP_LAST_ofs				; in
	PRM result__ofs				; resultat de fonction
endPRMS					;    fin parametrage
ELB 1					;    BODY ELAB
					;    end elab
begin:					;---------- BDY INSTRUCTIONS
VAR	OPL20_disp, b				; compteur boucle LOOP__1
	Lb  1,	-OP_FIRST_ofs
	Sb  1,	OPL20_disp
VAR	LMT_OPL20_disp, b			; limite boucle LOOP__1
	Lb  1,	-OP_LAST_ofs
	Sb  1,	LMT_OPL20_disp
	Lb  1,	OPL20_disp				; test null range LOOP__1
	Lb  1,	LMT_OPL20_disp
	CGT
	BT	L19
LOOP__1:					; corps boucle LOOP__1
					; debut if
; CODE record equality "/=" _TREE
VAR	EQA_L23, q
VAR	EQB_L23, q
	La	 1, BLTN_ID_ARRAY_disp			; array data start address on stack
	Lb	1, OPL20_disp
	LId	1, BLTN_ID_ARRAY__u, STANDARD.IDL.SEM_PHASE_L11.PRENAME._BLTN_ID_ARRAY.FST_1	; (index - FST_1) * SIZ_1
	SUB
	LId	1, BLTN_ID_ARRAY__u, STANDARD.IDL.SEM_PHASE_L11.PRENAME._BLTN_ID_ARRAY.COMP_SIZ
	LI	8
	DIV
	MUL
	ADD					; add offset to start address
	Sa  1, EQA_L23
	LVA 0,	STANDARD.IDL.TREE_VOID_disp
	La  ,  0
	Sa  1, EQB_L23
	LI	1
	LIb	1, EQA_L23, STANDARD.IDL._TREE.PT
	LIb	1, EQB_L23, STANDARD.IDL._TREE.PT
	CEQ
	ET
	LIb	1, EQA_L23, STANDARD.IDL._TREE.PT
	LI	0
	CEQ
	LIb	1, EQA_L23, STANDARD.IDL._TREE.PT
	LI	2
	CEQ
	OU
	BF	L25
	LIb	1, EQA_L23, STANDARD.IDL._TREE.TY
	LIb	1, EQB_L23, STANDARD.IDL._TREE.TY
	CEQ
	ET
	LIw	1, EQA_L23, STANDARD.IDL._TREE.PG
	LIw	1, EQB_L23, STANDARD.IDL._TREE.PG
	CEQ
	ET
	LIw	1, EQA_L23, STANDARD.IDL._TREE.LN
	LIw	1, EQB_L23, STANDARD.IDL._TREE.LN
	CEQ
	ET
	BRA	L24
L25:
	LIb	1, EQA_L23, STANDARD.IDL._TREE.PT
	LI	1
	CEQ
	BF	L26
	LIw	1, EQA_L23, STANDARD.IDL._TREE.COL
	LIw	1, EQB_L23, STANDARD.IDL._TREE.COL
	CEQ
	ET
	LIw	1, EQA_L23, STANDARD.IDL._TREE.SPG
	LIw	1, EQB_L23, STANDARD.IDL._TREE.SPG
	CEQ
	ET
	LIw	1, EQA_L23, STANDARD.IDL._TREE.SLN
	LIw	1, EQB_L23, STANDARD.IDL._TREE.SLN
	CEQ
	ET
	BRA	L24
L26:
	LIb	1, EQA_L23, STANDARD.IDL._TREE.PT
	LI	3
	CEQ
	BF	L27
	LIb	1, EQA_L23, STANDARD.IDL._TREE.NOTY
	LIb	1, EQB_L23, STANDARD.IDL._TREE.NOTY
	CEQ
	ET
	LIw	1, EQA_L23, STANDARD.IDL._TREE.ABSS
	LIw	1, EQB_L23, STANDARD.IDL._TREE.ABSS
	CEQ
	ET
	LIw	1, EQA_L23, STANDARD.IDL._TREE.NSIZ
	LIw	1, EQB_L23, STANDARD.IDL._TREE.NSIZ
	CEQ
	ET
	BRA	L24
L27:
L24:
	LI	1
	OUX
	BF	L22
namespace	BLOCK__2
ELB 2					;    BODY ELAB
VAR DEFLIST_disp, q				; variable record : pointeur aux data record
VAR DEFLIST__u, q				; variable record : pointeur aux useinfo
VAR DEFLIST__dat, STANDARD.IDL._SEQ_TYPE.size
	LVA	2, DEFLIST__dat
	Sa	2, DEFLIST_disp				; record fin
	LVA	2, STANDARD.IDL._SEQ_TYPE.SIZ
	Sa	2, DEFLIST__u
; CODE_VC_NAME DN_VARIABLE_ID
	La  2, DEFLIST_disp
	LI	STANDARD.IDL._SEQ_TYPE.size
VAR	ANON_86_25_disp, q
VAR	ANON_86_25__u,    q
VAR	ANON_86_25__dat, STANDARD.IDL._SEQ_TYPE.size
	LVA 2, ANON_86_25__dat
