if defined GEN_OP_DEF_L5_
PRO	GEN_OP_DEF_L5				;---------- PRO GEN_OP_DEF
PRMS					;    debut parametrage
	PRM OP_ofs				; in
	PRM HEADER_ofs				; in
	PRM H_ofs				; in
endPRMS					;    fin parametrage
ELB 1					;    BODY ELAB
VAR DEF_disp, q				; variable record : pointeur aux data record
VAR DEF__u, q				; variable record : pointeur aux useinfo
VAR DEF__dat, STANDARD.IDL._TREE.size
	LVA	1, DEF__dat
	Sa	1, DEF_disp				; record fin
	LVA	1, STANDARD.IDL._TREE.SIZ
	Sa	1, DEF__u
; CODE_VC_NAME DN_VARIABLE_ID

					;    end elab
begin:					;---------- BDY INSTRUCTIONS
	LVA 1,	DEF_disp
	La
	LI	STANDARD.IDL._TREE.size
VAR	ANON_73_12_disp, q
VAR	ANON_73_12__u,    q
VAR	ANON_73_12__dat, STANDARD.IDL._TREE.size
	LVA 1, ANON_73_12__dat
	Sa  1, ANON_73_12_disp
	La  0, STANDARD.IDL._TREE.use__info
	Sa  1, ANON_73_12__u
	LVA 1, ANON_73_12_disp
					; doublet resultat record anonyme
	La  1,	-H_ofs
	La	 1, BLTN_ID_ARRAY_disp			; array data start address on stack
	Lb  1,	-OP_ofs
	LId	1, BLTN_ID_ARRAY__u, STANDARD.IDL.SEM_PHASE_L11.PRENAME._BLTN_ID_ARRAY.FST_1	; (index - FST_1) * SIZ_1
	SUB
	LId	1, BLTN_ID_ARRAY__u, STANDARD.IDL.SEM_PHASE_L11.PRENAME._BLTN_ID_ARRAY.COMP_SIZ
	LI	8
	DIV
	MUL
	ADD					; add offset to start address
	CALL	STANDARD.IDL.SEM_PHASE_L11.DEF_UTIL. ,MAKE_DEF_FOR_ID_L52
	La
	BLKMOV
	La  1,	-HEADER_ofs
	LVA 1,	DEF_disp
	CALL	STANDARD.IDL.SEM_PHASE_L11.DEF_UTIL. ,MAKE_DEF_VISIBLE_L67
ret_lbl:
	UNLINK 1
	RTD	prm_siz
excep:
endPRO					;---------- end PRO GEN_OP_DEF
end if

if defined OPS_ARE_NOT_YET_DEFINED_L6_
PRO	OPS_ARE_NOT_YET_DEFINED_L6		;---------- PRO OPS_ARE_NOT_YET_DEFINED
PRMS					;    debut parametrage
	PRM TYPE_SPEC_ofs				; in
	PRM OP_FIRST_ofs				; in
	PRM OP_LAST_ofs				; in
	PRM result__ofs				; resultat de fonction
endPRMS					;    fin parametrage
ELB 1					;    BODY ELAB
					;    end elab
begin:					;---------- BDY INSTRUCTIONS
VAR	OPL8_disp, b				; compteur boucle LOOP__1
	Lb  1,	-OP_FIRST_ofs
	Sb  1,	OPL8_disp
VAR	LMT_OPL8_disp, b			; limite boucle LOOP__1
	Lb  1,	-OP_LAST_ofs
	Sb  1,	LMT_OPL8_disp
	Lb  1,	OPL8_disp				; test null range LOOP__1
	Lb  1,	LMT_OPL8_disp
	CGT
	BT	L7
LOOP__1:					; corps boucle LOOP__1
					; debut if
	La	 1, BLTN_ID_ARRAY_disp			; array data start address on stack
	Lb	1, OPL8_disp
	LId	1, BLTN_ID_ARRAY__u, STANDARD.IDL.SEM_PHASE_L11.PRENAME._BLTN_ID_ARRAY.FST_1	; (index - FST_1) * SIZ_1
	SUB
	LId	1, BLTN_ID_ARRAY__u, STANDARD.IDL.SEM_PHASE_L11.PRENAME._BLTN_ID_ARRAY.COMP_SIZ
	LI	8
	DIV
	MUL
	ADD					; add offset to start address
	LVA 0,	STANDARD.IDL.TREE_VOID_disp
	CNE
	BF	L10
namespace	BLOCK__2
ELB 2					;    BODY ELAB
VAR DEFLIST_disp, q				; variable record : pointeur aux data record
VAR DEFLIST__u, q				; variable record : pointeur aux useinfo
VAR DEFLIST__dat, STANDARD.IDL._SEQ_TYPE.size
	LVA	2, DEFLIST__dat
	Sa	2, DEFLIST_disp				; record fin
	LVA	2, STANDARD.IDL._SEQ_TYPE.SIZ
	Sa	2, DEFLIST__u
; CODE_VC_NAME DN_VARIABLE_ID
	La  2, DEFLIST_disp
	LI	STANDARD.IDL._SEQ_TYPE.size
VAR	ANON_86_25_disp, q
VAR	ANON_86_25__u,    q
VAR	ANON_86_25__dat, STANDARD.IDL._SEQ_TYPE.size
	LVA 2, ANON_86_25__dat
	Sa  2, ANON_86_25_disp
	La  0, STANDARD.IDL._SEQ_TYPE.use__info
	Sa  2, ANON_86_25__u
	LVA 2, ANON_86_25_disp
					; doublet resultat record anonyme
VAR	ANON_86_31_disp, q
VAR	ANON_86_31__u,    q
VAR	ANON_86_31__dat, STANDARD.IDL._TREE.size
	LVA 2, ANON_86_31__dat
	Sa  2, ANON_86_31_disp
	La  0, STANDARD.IDL._TREE.use__info
	Sa  2, ANON_86_31__u
	LVA 2, ANON_86_31_disp
					; doublet resultat record anonyme
	La	 1, BLTN_ID_ARRAY_disp			; array data start address on stack
	Lb	1, OPL8_disp
	LId	1, BLTN_ID_ARRAY__u, STANDARD.IDL.SEM_PHASE_L11.PRENAME._BLTN_ID_ARRAY.FST_1	; (index - FST_1) * SIZ_1
	SUB
	LId	1, BLTN_ID_ARRAY__u, STANDARD.IDL.SEM_PHASE_L11.PRENAME._BLTN_ID_ARRAY.COMP_SIZ
	LI	8
	DIV
	MUL
	ADD					; add offset to start address
	LI  13
	CALL	STANDARD.IDL. ,D_L17
	CALL	STANDARD.IDL. ,LIST_L22
	La  ,  0
	BLKMOV

VAR DEF_disp, q				; variable record : pointeur aux data record
VAR DEF__u, q				; variable record : pointeur aux useinfo
VAR DEF__dat, STANDARD.IDL._TREE.size
	LVA	2, DEF__dat
	Sa	2, DEF_disp				; record fin
	LVA	2, STANDARD.IDL._TREE.SIZ
	Sa	2, DEF__u
; CODE_VC_NAME DN_VARIABLE_ID

VAR BASE_TYPE_disp, q			; variable record : pointeur aux data record
VAR BASE_TYPE__u, q				; variable record : pointeur aux useinfo
VAR BASE_TYPE__dat, STANDARD.IDL._TREE.size
