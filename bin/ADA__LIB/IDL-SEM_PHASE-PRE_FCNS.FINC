PRE_FCNS = 'PRE_FCNS'
namespace PRE_FCNS				;---------- PACKAGE
elab_spec:				;    SPEC ELAB

					;    BODY ELAB
VAR BOOLEAN_IS_INITIALIZED_disp, d		; variable bool char enum
	LI	0
	Sb  0,	BOOLEAN_IS_INITIALIZED_disp

VAR INTEGER_IS_INITIALIZED_disp, d		; variable bool char enum
	LI	0
	Sb  0,	INTEGER_IS_INITIALIZED_disp

VAR LEFT_SYMREP_disp, q			; variable record : pointeur aux data record
VAR LEFT_SYMREP__u, q			; variable record : pointeur aux useinfo
VAR LEFT_SYMREP__dat, STANDARD.IDL.TREE.size
	LVA	0, LEFT_SYMREP__dat
	Sa	0, LEFT_SYMREP_disp			; record fin
	LVA	0, STANDARD.IDL.TREE.SIZ
	Sa	0, LEFT_SYMREP__u

VAR RIGHT_SYMREP_disp, q			; variable record : pointeur aux data record
VAR RIGHT_SYMREP__u, q			; variable record : pointeur aux useinfo
VAR RIGHT_SYMREP__dat, STANDARD.IDL.TREE.size
	LVA	0, RIGHT_SYMREP__dat
	Sa	0, RIGHT_SYMREP_disp			; record fin
	LVA	0, STANDARD.IDL.TREE.SIZ
	Sa	0, RIGHT_SYMREP__u

VAR LEFT_INTEGER_IN_disp, q			; variable record : pointeur aux data record
VAR LEFT_INTEGER_IN__u, q			; variable record : pointeur aux useinfo
VAR LEFT_INTEGER_IN__dat, STANDARD.IDL.TREE.size
	LVA	0, LEFT_INTEGER_IN__dat
	Sa	0, LEFT_INTEGER_IN_disp			; record fin
	LVA	0, STANDARD.IDL.TREE.SIZ
	Sa	0, LEFT_INTEGER_IN__u

VAR RIGHT_INTEGER_IN_disp, q			; variable record : pointeur aux data record
VAR RIGHT_INTEGER_IN__u, q			; variable record : pointeur aux useinfo
VAR RIGHT_INTEGER_IN__dat, STANDARD.IDL.TREE.size
	LVA	0, RIGHT_INTEGER_IN__dat
	Sa	0, RIGHT_INTEGER_IN_disp			; record fin
	LVA	0, STANDARD.IDL.TREE.SIZ
	Sa	0, RIGHT_INTEGER_IN__u


if defined GEN_IN_L2_
PRO	GEN_IN_L2				;---------- PRO GEN_IN
PRMS					;    debut parametrage
	PRM SYMREP_ofs				; in
	PRM TYPE_SPEC_ofs				; in
	PRM result__ofs				; resultat de fonction
endPRMS					;    fin parametrage
ELB 1					;    BODY ELAB
					;    end elab
begin:					;---------- BDY INSTRUCTIONS
; CODE_RETURN : EXPR TYPE = DN_RECORD
	La   1,	-result__ofs
	La  ,  0
	LI	STANDARD.IDL.TREE.size
VAR	ANON_48_12_disp, q
VAR	ANON_48_12__u,    q
VAR	ANON_48_12__dat, STANDARD.IDL.TREE.size
	LVA 1, ANON_48_12__dat
	Sa  1, ANON_48_12_disp
	La  0, STANDARD.IDL.TREE.use__info
	Sa  1, ANON_48_12__u
	LVA 1, ANON_48_12_disp
					; doublet resultat record anonyme
	LI  0
VAR	ANON_48_41_disp, q
VAR	ANON_48_41__u,    q
VAR	ANON_48_41__dat, STANDARD.IDL.TREE.size
	LVA 1, ANON_48_41__dat
	Sa  1, ANON_48_41_disp
	La  0, STANDARD.IDL.TREE.use__info
	Sa  1, ANON_48_41__u
	LVA 1, ANON_48_41_disp
					; doublet resultat record anonyme
VAR	ANON_48_69_disp, q
VAR	ANON_48_69__u,    q
VAR	ANON_48_69__dat, STANDARD.IDL.SEQ_TYPE.size
	LVA 1, ANON_48_69__dat
	Sa  1, ANON_48_69_disp
	La  0, STANDARD.IDL.SEQ_TYPE.use__info
	Sa  1, ANON_48_69__u
	LVA 1, ANON_48_69_disp
					; doublet resultat record anonyme
VAR	ANON_48_80_disp, q
VAR	ANON_48_80__u,    q
VAR	ANON_48_80__dat, STANDARD.IDL.TREE.size
	LVA 1, ANON_48_80__dat
	Sa  1, ANON_48_80_disp
	La  0, STANDARD.IDL.TREE.use__info
	Sa  1, ANON_48_80__u
	LVA 1, ANON_48_80_disp
					; doublet resultat record anonyme
	La  1,	-TYPE_SPEC_ofs
	La  1,	-SYMREP_ofs
	CALL	STANDARD.IDL.SEM_PHASE_L7.MAKE_NOD. ,MAKE_IN_ID_L232
	CALL	STANDARD.IDL.IDL_MAN. ,SINGLETON_L27
	CALL	STANDARD.IDL.SEM_PHASE_L7.MAKE_NOD. ,MAKE_SOURCE_NAME_S_L318
	CALL	STANDARD.IDL.SEM_PHASE_L7.MAKE_NOD. ,MAKE_IN_L258
	La  ,  0
	BLKMOV
	BRA ret_lbl
ret_lbl:
	UNLINK 1
	RTD	prm_siz-8
excep:
endPRO					;---------- end PRO GEN_IN
end if

