					;    end elab
begin:					;---------- BDY INSTRUCTIONS
STR STR_L29, "=== INSTF1 : instanciation, resultat non contraint ==="	; constante string="=== INSTF1 : instanciation, resultat non contraint ==="
	LCA	STR_L29.data_ptr
	CALL	STANDARD.TEXT_IO. ,PUT_LINE_L60
	LVA 1,	S3_disp
	La
	LId	1, S3__u, 0
	LI	8
	DIV
VAR	ANON_66_9_disp, q
VAR	ANON_66_9__u,   q
namespace ANON_66_9_info
  VAR SIZ, d
  VAR _COMP_SIZ, d
  VAR _FST_1, d
  VAR _LST_1, d
end namespace
	LVA 1, ANON_66_9_info.SIZ
	Sa  1, ANON_66_9__u
	LVA 1, ANON_66_9_disp
	CALL	STANDARD.INSTF1_L1. ,B3_L21
	La
	BLKMOV
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	1
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	1
; CODE composite "=" _STRING
VAR	ANON_67_10_L30_G_data, q
VAR	ANON_67_10_L30_G_info, q
VAR	ANON_67_10_L30_G_len,  q
	LVA 1,	S3_disp
	DUP
	La  ,  0
	Sa  1, ANON_67_10_L30_G_data
	La  ,  8
	Sa  1, ANON_67_10_L30_G_info
	LId 1, ANON_67_10_L30_G_info, STANDARD._STRING.LST_1
	LId 1, ANON_67_10_L30_G_info, STANDARD._STRING.FST_1
	SUB
	INC
	CLAMP0
	Sa  1, ANON_67_10_L30_G_len
VAR	ANON_67_15_L30_D_data, q
VAR	ANON_67_15_L30_D_info, q
VAR	ANON_67_15_L30_D_len,  q
STR ANON_67_15_L30_D, "***"			; constante string="***"
	LCA	ANON_67_15_L30_D.data_ptr
	DUP
	La  ,  0
	Sa  1, ANON_67_15_L30_D_data
	La  ,  8
	Sa  1, ANON_67_15_L30_D_info
	LId 1, ANON_67_15_L30_D_info, STANDARD._STRING.LST_1
	LId 1, ANON_67_15_L30_D_info, STANDARD._STRING.FST_1
	SUB
	INC
	CLAMP0
	Sa  1, ANON_67_15_L30_D_len
	La  1, ANON_67_10_L30_G_len
	La  1, ANON_67_15_L30_D_len
	CEQ
	DUP
	BF	L31
	DROP
	La  1, ANON_67_10_L30_G_data
	La  1, ANON_67_10_L30_G_len
	La  1, ANON_67_15_L30_D_data
	BLKCMP
L31:
	CALL	STANDARD.INSTF1_L1. ,CHECK_L8
	LVA 1,	S5_disp
	La
	LId	1, S5__u, 0
	LI	8
	DIV
VAR	ANON_68_9_disp, q
VAR	ANON_68_9__u,   q
namespace ANON_68_9_info
  VAR SIZ, d
  VAR _COMP_SIZ, d
  VAR _FST_1, d
  VAR _LST_1, d
end namespace
	LVA 1, ANON_68_9_info.SIZ
	Sa  1, ANON_68_9__u
	LVA 1, ANON_68_9_disp
	CALL	STANDARD.INSTF1_L1. ,B5_L24
	La
	BLKMOV
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	2
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	1
; CODE composite "=" _STRING
VAR	ANON_69_10_L32_G_data, q
VAR	ANON_69_10_L32_G_info, q
VAR	ANON_69_10_L32_G_len,  q
	LVA 1,	S5_disp
	DUP
	La  ,  0
	Sa  1, ANON_69_10_L32_G_data
	La  ,  8
	Sa  1, ANON_69_10_L32_G_info
	LId 1, ANON_69_10_L32_G_info, STANDARD._STRING.LST_1
	LId 1, ANON_69_10_L32_G_info, STANDARD._STRING.FST_1
	SUB
	INC
	CLAMP0
	Sa  1, ANON_69_10_L32_G_len
VAR	ANON_69_15_L32_D_data, q
