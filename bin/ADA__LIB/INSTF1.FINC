if defined CHECK_L8_
PRO	CHECK_L8				;---------- PRO CHECK
 hexa_show 'CHECK_L8 ', $
PRMS					;    debut parametrage
	PRM COND_ofs				; in
	PRM SECTION_ofs				; in
	PRM NUM_ofs				; in
endPRMS					;    fin parametrage
ELB 2					;    BODY ELAB
					;    end elab
begin:					;---------- BDY INSTRUCTIONS
					; debut if
	ULb  2,	-COND_ofs
	BF	L12
	Ld 1,	STANDARD.INSTF1_L1.OK_COUNT_disp
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	1
	ADD
	Sd  1,	STANDARD.INSTF1_L1.OK_COUNT_disp
	BRA	L11
L12:
	Ld 1,	STANDARD.INSTF1_L1.FAIL_COUNT_disp
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	1
	ADD
	Sd  1,	STANDARD.INSTF1_L1.FAIL_COUNT_disp
STR STR_L13, "* ECHEC section"		; constante string="* ECHEC section"
	LCA	STR_L13.data_ptr
	CALL	STANDARD.TEXT_IO. ,PUT_L56
	Ld 1,	STANDARD.INSTF1_L1.INT_IO.DEFAULT_BASE_disp
	DUP
	Ld	0, STANDARD.TEXT_IO._NUMBER_BASE.FST
	CLT
	BT	STANDARD.ce_raise_
	DUP
	Ld	0, STANDARD.TEXT_IO._NUMBER_BASE.LST
	CGT
	BT	STANDARD.ce_raise_
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	2
	DUP
	Ld	0, STANDARD.TEXT_IO._FIELD.FST
	CLT
	BT	STANDARD.ce_raise_
	DUP
	Ld	0, STANDARD.TEXT_IO._FIELD.LST
	CGT
	BT	STANDARD.ce_raise_
	Ld  2,	-SECTION_ofs
	CALL	STANDARD.INSTF1_L1.INT_IO. ,PUT_L5
STR STR_L14, " test"			; constante string=" test"
	LCA	STR_L14.data_ptr
	CALL	STANDARD.TEXT_IO. ,PUT_L56
	Ld 1,	STANDARD.INSTF1_L1.INT_IO.DEFAULT_BASE_disp
	DUP
	Ld	0, STANDARD.TEXT_IO._NUMBER_BASE.FST
	CLT
	BT	STANDARD.ce_raise_
	DUP
	Ld	0, STANDARD.TEXT_IO._NUMBER_BASE.LST
	CGT
	BT	STANDARD.ce_raise_
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	3
	DUP
	Ld	0, STANDARD.TEXT_IO._FIELD.FST
	CLT
	BT	STANDARD.ce_raise_
	DUP
	Ld	0, STANDARD.TEXT_IO._FIELD.LST
	CGT
	BT	STANDARD.ce_raise_
	Ld  2,	-NUM_ofs
	CALL	STANDARD.INSTF1_L1.INT_IO. ,PUT_L5
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	1
	DUP
	ULd	0, STANDARD.TEXT_IO._POSITIVE_COUNT.FST
	CLT
	BT	STANDARD.ce_raise_
	DUP
	ULd	0, STANDARD.TEXT_IO._POSITIVE_COUNT.LST
	CGT
	BT	STANDARD.ce_raise_
	CALL	STANDARD.TEXT_IO. ,NEW_LINE_L26
L11:					; post if
ret_lbl:
	UNLINK 2
	RTD	prm_siz
excep:
endPRO					;---------- end PRO CHECK
end if
BAND = 'BAND'
; GENERIC_SUBPROGRAM_SPEC

if defined BAND_L15_
PRO	BAND_L15				;---------- PRO BAND
 hexa_show 'BAND_L15 ', $
virtual at 8
	FILL_ofs = $
	rq 1
	WIDTH_ofs = $
	rq 1
end virtual
PRMS					;    debut parametrage
	PRM GFP_ofs
	PRM result__ofs				; resultat de fonction
endPRMS					;    fin parametrage
ELB 2					;    BODY ELAB
 hexa_show 'var elab S ', $
_S__type = '_S__type'
namespace _S__type				; array var constrained array type info
VAR use__info, q
VAR SIZ, d
	LVA	2, SIZ
	Sa	2, use__info
VAR _COMP_SIZ, d
VAR _FST_1, d
VAR _LST_1, d
	LI	8
	Sd	2, _COMP_SIZ
	Ld	2, _COMP_SIZ
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	1
	Sd	2, _FST_1
	La 2,	-GFP_ofs
	Ld ,	-WIDTH_ofs
	Sd	2, _LST_1
	Ld	2, _LST_1
	Ld	2, _FST_1
	SUB
	INC
	CLAMP0
	MUL
	Sd	2, SIZ
  virtual at 4
COMP_SIZ = $
	rd 1 
FST_1 = $
	rd 1 
LST_1 = $
	rd 1 
  end virtual
end namespace
VAR S_disp, q				; variable array : pointeur aux data
VAR S__u, q				; variable array : useinfo pointeur au rec info
	La 2, _S__type.use__info
	Sa	2, S__u				; array info ptr at __u
	Ld	2, _S__type.SIZ
	LI	8
	DIV
	CO_VAR
	Sa	2, S_disp				; array data ptr at _disp

 hexa_show ' disp ', S_disp
					;    end elab
begin:					;---------- BDY INSTRUCTIONS
VAR	IL19_disp, d				; compteur boucle LOOP__1
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	1
	Sd  2,	IL19_disp
VAR	LMT_IL19_disp, d			; limite boucle LOOP__1
	La 2,	-GFP_ofs
	Ld ,	-WIDTH_ofs
	Sd  2,	LMT_IL19_disp
	Ld  2,	IL19_disp				; test null range LOOP__1
	Ld  2,	LMT_IL19_disp
	CGT
	BT	L18
LOOP__1:					; corps boucle LOOP__1
	La	 2, STANDARD.INSTF1_L1.BAND_L15.S_disp	; array data start address on stack
	Ld 2,	IL19_disp
	DUP
	LId	2, STANDARD.INSTF1_L1.BAND_L15.S__u, STANDARD._STRING.FST_1
	CLT
	BT	STANDARD.ce_raise_
	DUP
	LId	2, STANDARD.INSTF1_L1.BAND_L15.S__u, STANDARD._STRING.LST_1
	CGT
	BT	STANDARD.ce_raise_
	LId	2, STANDARD.INSTF1_L1.BAND_L15.S__u, STANDARD._STRING.FST_1	; (index - FST_1) * SIZ_1
	SUB
	LId	2, STANDARD.INSTF1_L1.BAND_L15.S__u, STANDARD._STRING.COMP_SIZ
	LI	8
	DIV
	MUL
	ADD					; add offset to start address
	La 2,	-GFP_ofs
	ULb ,	-FILL_ofs
	Sb
	Ld  2,	IL19_disp				; test de sortie LOOP__1
	Ld  2,	LMT_IL19_disp
	CEQ
	BT	L18
	Ld  2,	IL19_disp				; mise a jour compteur LOOP__1
	INC
	Sd  2,	IL19_disp
	BRA	LOOP__1				; iteration suivante LOOP__1
L18:					; post loop LOOP__1
; CODE_RETURN : EXPR TYPE = DN_CONSTRAINED_ARRAY  VUE COMPLETE = DN_CONSTRAINED_ARRAY
	LVA 2,	S_disp
VAR	RET_INFO_L20, q
	DUP
	La  ,  0
	SIq   2, -result__ofs,  0
	DUP
	La  ,  8
	Sa   2, RET_INFO_L20
	DROP
	La   2, -result__ofs
	La  ,  8
	LI	16
	La   2, RET_INFO_L20
	BLKMOV
	BRA ret_lbl
ret_lbl:
	UNLINK 2
	RTD
excep:
endPRO					;---------- end PRO BAND
end if
					; sub program entry decl (in instantiation FALSE )
if defined B3_L21_
VAR B3_L21WIDTH_disp, q
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	3
	Sd  1, B3_L21WIDTH_disp
