VAR W_disp, q				; variable record : pointeur aux data record
VAR W__u, q				; variable record : pointeur aux useinfo
VAR W__dat, STANDARD.RECORD_TEST1_L1._WRAP.size
	LVA	1, W__dat
	Sa	1, W_disp				; record fin
	LVA	1, STANDARD.RECORD_TEST1_L1._WRAP.SIZ
	Sa	1, W__u
; CODE_VC_NAME DN_VARIABLE_ID

VAR A_disp, q				; variable array : pointeur aux data
VAR A__u, q				; variable array : useinfo pointeur au rec info
	La 1, STANDARD.RECORD_TEST1_L1._ARR.use__info
	Sa	1, A__u				; array info ptr at __u
	Ld	1, STANDARD.RECORD_TEST1_L1._ARR.SIZ
	LI	8
	DIV
	CO_VAR
	Sa	1, A_disp				; array data ptr at _disp

VAR S_disp, d				; variable entiere


if defined BUMP_L2_
PRO	BUMP_L2				;---------- PRO BUMP
PRMS					;    debut parametrage
	PRM R_ofs				; in out
endPRMS					;    fin parametrage
ELB 2					;    BODY ELAB
					;    end elab
begin:					;---------- BDY INSTRUCTIONS
	La 2, -R_ofs
	LIVA 	, 0, STANDARD.RECORD_TEST1_L1._BUF.X
	La 2, -R_ofs
	LId	, 0, STANDARD.RECORD_TEST1_L1._BUF.X
	La 2, -R_ofs
	LId	, 0, STANDARD.RECORD_TEST1_L1._BUF.LEN
	ADD
	Sd
ret_lbl:
	UNLINK 2
	RTD	prm_siz
excep:
endPRO					;---------- end PRO BUMP
end if

if defined MAKE_L3_
PRO	MAKE_L3				;---------- PRO MAKE
PRMS					;    debut parametrage
	PRM V_ofs				; in
	PRM result__ofs				; resultat de fonction
endPRMS					;    fin parametrage
ELB 2					;    BODY ELAB
VAR R_disp, q				; variable record : pointeur aux data record
VAR R__u, q				; variable record : pointeur aux useinfo
VAR R__dat, STANDARD.RECORD_TEST1_L1._BUF5.size
	LVA	2, R__dat
	Sa	2, R_disp				; record fin
	LVA	2, STANDARD.RECORD_TEST1_L1._BUF5.SIZ
	Sa	2, R__u
; CODE_VC_NAME DN_VARIABLE_ID
	LIVA 2, R_disp, STANDARD.RECORD_TEST1_L1._BUF.LEN
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	5
	Sd

					;    end elab
begin:					;---------- BDY INSTRUCTIONS
	LVA 2,	R_disp
	La
					; Assign_record_aggregate type DN_RECORD
	DUP
	LVA	, STANDARD.RECORD_TEST1_L1._BUF.LEN
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	5
	Sd
	DUP
	LVA	, STANDARD.RECORD_TEST1_L1._BUF.X
	Ld  2,	-V_ofs
	Sd
	DUP
	LVA	, STANDARD.RECORD_TEST1_L1._BUF.Y
	Ld  2,	-V_ofs
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	1
	ADD
	Sd
	DROP
; CODE_RETURN : EXPR TYPE = DN_CONSTRAINED_RECORD
	La   2,	-result__ofs
	La  ,  0
	LI	STANDARD.RECORD_TEST1_L1._BUF.size
	LVA 2,	R_disp
	La  ,  0
	BLKMOV
	BRA ret_lbl
ret_lbl:
	UNLINK 2
	RTD	prm_siz-8
excep:
endPRO					;---------- end PRO MAKE
end if
					;    end elab
