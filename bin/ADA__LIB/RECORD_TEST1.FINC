if ~ definite TEXT_IO
include 'TEXT_IO.FINC'
end if
PRO	RECORD_TEST1_L1				;---------- PRO RECORD_TEST1
ELB 1					;    BODY ELAB

					; _BUF RECORD TYPE INFO
_BUF = '_BUF'
namespace _BUF
VAR use__info, q
VAR SIZ, d
	LVA	1, SIZ
	Sa	1, use__info
USEINFO 1, LEN, 	La 0, STANDARD._INTEGER.use__info
USEINFO 1, X, 	La 0, STANDARD._INTEGER.use__info
USEINFO 1, Y, 	La 0, STANDARD._INTEGER.use__info
virtual at 0				; calcul des offsets statiques
STATOFS LEN, 4
STATOFS X, 4
STATOFS Y, 4
size = $
end virtual
	LI	 size*8
	Sd	1, SIZ
end namespace

					; _BUF5 CONSTRAINED RECORD VIEW
_BUF5 = '_BUF5'
namespace _BUF5
use__info = STANDARD.RECORD_TEST1_L1._BUF.use__info
SIZ = STANDARD.RECORD_TEST1_L1._BUF.SIZ
size = STANDARD.RECORD_TEST1_L1._BUF.size
LEN = STANDARD.RECORD_TEST1_L1._BUF.LEN
X = STANDARD.RECORD_TEST1_L1._BUF.X
Y = STANDARD.RECORD_TEST1_L1._BUF.Y
end namespace

					; _KIND ENUMERATION TYPE INFO
_KIND = '_KIND'
namespace _KIND
VAR use__info, q
BEGIN_BLOC_DEF
db 0, 4, "LEAF"
db 1, 5, "UNARY"
db 2, 6, "BINARY"
END_BLOC_DEF
IMAGES	BYTES_BLOC
CST LST, d, 2
CST FST, d, 0
CST SIZ, d, 8	; SIZ en bits !
postpone
  align_q
end postpone
	LCA	SIZ
	Sa	1, use__info
end namespace

					; _NODE RECORD TYPE INFO
_NODE = '_NODE'
namespace _NODE
VAR use__info, q
VAR SIZ, d
	LVA	1, SIZ
	Sa	1, use__info
USEINFO 1, PT, 	La 1, STANDARD.RECORD_TEST1_L1._KIND.use__info
USEINFO 1, COL, 	La 0, STANDARD._INTEGER.use__info
USEINFO 1, VAL, 	La 0, STANDARD._INTEGER.use__info
USEINFO 1, OPU, 	La 0, STANDARD._INTEGER.use__info
USEINFO 1, GAU, 	La 0, STANDARD._INTEGER.use__info
USEINFO 1, DTE, 	La 0, STANDARD._INTEGER.use__info
virtual at 0				; calcul des offsets statiques
STATOFS PT, 1
STATOFS COL, 4
STATOFS VAL, 4
STATOFS OPU, 4
STATOFS GAU, 4
STATOFS DTE, 4
size = $
end virtual
	LI	 size*8
	Sd	1, SIZ
end namespace

					; _WRAP RECORD TYPE INFO
_WRAP = '_WRAP'
namespace _WRAP
VAR use__info, q
VAR SIZ, d
	LVA	1, SIZ
	Sa	1, use__info
USEINFO 1, H, 	La 0, STANDARD._INTEGER.use__info
USEINFO 1, P, 	La 0, STANDARD.RECORD_TEST1_L1._BUF.use__info
virtual at 0				; calcul des offsets statiques
STATOFS H, 4
STATOFS P, 12
size = $
end virtual
	LI	 size*8
	Sd	1, SIZ
end namespace

					; array decl constrained array type info
_ARR = '_ARR'
namespace _ARR
VAR use__info, q
VAR SIZ, d
	LVA	1, SIZ
	Sa	1, use__info
VAR _COMP_SIZ, d
VAR _FST_1, d
VAR _LST_1, d
	LI	96
	Sd	1, _COMP_SIZ
	Ld	1, _COMP_SIZ
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	1
	Sd	1, _FST_1
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	3
	Sd	1, _LST_1
	Ld	1, _LST_1
	Ld	1, _FST_1
	SUB
	INC
	CLAMP0
	MUL
	Sd	1, SIZ
  virtual at 4
COMP_SIZ = $
	rd 1 
FST_1 = $
	rd 1 
LST_1 = $
	rd 1 
  end virtual
end namespace
VAR B_disp, q				; variable record : pointeur aux data record
VAR B__u, q				; variable record : pointeur aux useinfo
VAR B__dat, STANDARD.RECORD_TEST1_L1._BUF5.size
	LVA	1, B__dat
	Sa	1, B_disp				; record fin
	LVA	1, STANDARD.RECORD_TEST1_L1._BUF5.SIZ
	Sa	1, B__u
; CODE_VC_NAME DN_VARIABLE_ID
	LIVA 1, B_disp, STANDARD.RECORD_TEST1_L1._BUF.LEN
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	5
	Sd

VAR C_disp, q				; variable record : pointeur aux data record
VAR C__u, q				; variable record : pointeur aux useinfo
