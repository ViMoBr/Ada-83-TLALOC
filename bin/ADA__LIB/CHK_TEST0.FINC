	Sa  2,	exc_ctx_L19
	La	0, STANDARD.EXCEPTIONS_CURRENT_disp
	LCA	STANDARD.CONSTRAINT_ERROR__exc.data_ptr
	CEQ
	BT	L23
	BRA	L24
L23:
STR STR_L25, "CHK_TEST0 4 OK CONSTRAINT_ERROR rattrapee (enumere)"	; constante string="CHK_TEST0 4 OK CONSTRAINT_ERROR rattrapee (enumere)"
	LCA	STR_L25.data_ptr
	CALL	STANDARD.TEXT_IO. ,PUT_LINE_L60
	BRA	L22
L24:
	BRA	STANDARD.exc_raise_
L22:
L20:
