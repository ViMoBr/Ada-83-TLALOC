endPRO
					; debut if
	Ld 1,	S_disp
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	7
	CEQ
	BF	L27
STR STR_L28, "CHK_TEST0 5 OK valeur preservee"	; constante string="CHK_TEST0 5 OK valeur preservee"
	LCA	STR_L28.data_ptr
	CALL	STANDARD.TEXT_IO. ,PUT_LINE_L60
	BRA	L26
