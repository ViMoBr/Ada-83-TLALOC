STR STR_L29, "CHK_TEST0 5 KO valeur alteree"	; constante string="CHK_TEST0 5 KO valeur alteree"
	LCA	STR_L29.data_ptr
	CALL	STANDARD.TEXT_IO. ,PUT_LINE_L60
L26:					; post if
STR STR_L30, "CHK_TEST0 6 attendu : EXCEPTION NON RATTRAPEE : CONSTRAINT_ERROR, $? = 1"	; constante string="CHK_TEST0 6 attendu : EXCEPTION NON RATTRAPEE : CONSTRAINT_ERROR, $? = 1"
	LCA	STR_L30.data_ptr
	CALL	STANDARD.TEXT_IO. ,PUT_LINE_L60
	Ld 1,	NEGV_disp
	DUP
	Ld	1, _SMALL.FST
	CLT
	BT	STANDARD.ce_raise_
	DUP
	Ld	1, _SMALL.LST
