PRO	CHK_TEST0_L1				;---------- PRO CHK_TEST0
ELB 1					;    BODY ELAB

					; _SMALL INTEGER SUBTYPE INFO
_SMALL = '_SMALL'
namespace _SMALL
VAR use__info, q
VAR SIZ, d
	LVA	1, SIZ
	Sa	1, use__info
VAR FST, d
VAR LST, d
	LI	32
	Sd	1, SIZ
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	1
	Sd	1, FST
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	10
	Sd	1, LST
VAR PARENT__u, q
	La	0, STANDARD._INTEGER.use__info
	Sa	1, PARENT__u
end namespace

					; _UPPER ENUMERATION SUBTYPE INFO
_UPPER = '_UPPER'
namespace _UPPER
VAR use__info, q
VAR SIZ, d
	LVA	1, SIZ
	Sa	1, use__info
VAR FST, b
VAR LST, b
	LI	8
	Sd	1, SIZ
	LI	65
	Sb	1, FST
	LI	90
	Sb	1, LST
VAR PARENT__u, q
	La 0	, STANDARD._CHARACTER.use__info
	Sa	1, PARENT__u
end namespace
VAR S_disp, d				; variable entiere
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	5
	Sd  1,	S_disp

VAR C_disp, b				; variable entiere
	LI	65
	Sb  1,	C_disp

VAR I_disp, d				; variable entiere
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	7
	Sd  1,	I_disp

VAR NEGV_disp, d				; variable entiere
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	3
	NEG
	Sd  1,	NEGV_disp

VAR CH_disp, d				; variable bool char enum
	LI	113
	Sb  1,	CH_disp

					;    end elab
begin:					;---------- BDY INSTRUCTIONS
	Ld 1,	I_disp
	DUP
	Ld	1, _SMALL.FST
	CLT
	BT	STANDARD.ce_raise_
	DUP
	Ld	1, _SMALL.LST
	CGT
	BT	STANDARD.ce_raise_
	Sd  1,	S_disp
STR STR_L4, "CHK_TEST0 1 OK affectation dans les bornes"	; constante string="CHK_TEST0 1 OK affectation dans les bornes"
	LCA	STR_L4.data_ptr
	CALL	STANDARD.TEXT_IO. ,PUT_LINE_L60
namespace	BLOCK__1
ELB 2					;    BODY ELAB
					;    end elab
begin:					;---------- BDY INSTRUCTIONS
VAR	exc_ctx_L5, q, 10
	La	0, STANDARD.EXCEPTIONS_TOP_CTX_disp
	Sa  2,	exc_ctx_L5
	LCA	L5
	Sa  2,	exc_ctx_L5 + STANDARD._EXCEPTION_CONTEXT.DISPATCH
	EXC_MACH  2,	exc_ctx_L5
	LVA  2,	exc_ctx_L5
	Sa	0, STANDARD.EXCEPTIONS_TOP_CTX_disp
	Ld 1,	STANDARD.CHK_TEST0_L1.NEGV_disp
	DUP
	Ld	1, STANDARD.CHK_TEST0_L1._SMALL.FST
	CLT
	BT	STANDARD.ce_raise_
	DUP
	Ld	1, STANDARD.CHK_TEST0_L1._SMALL.LST
	CGT
	BT	STANDARD.ce_raise_
	Sd  1,	S_disp
STR STR_L7, "CHK_TEST0 2 KO pas de levee"	; constante string="CHK_TEST0 2 KO pas de levee"
	LCA	STR_L7.data_ptr
	CALL	STANDARD.TEXT_IO. ,PUT_LINE_L60
	La 0,	STANDARD.EXCEPTIONS_TOP_CTX_disp
	La , 0
	Sa 0,	STANDARD.EXCEPTIONS_TOP_CTX_disp
	BRA	L6
L5:
	La	0, STANDARD.EXCEPTIONS_CURRENT_disp
	Sa  2,	exc_ctx_L5
	La	0, STANDARD.EXCEPTIONS_CURRENT_disp
	LCA	STANDARD.CONSTRAINT_ERROR__exc.data_ptr
	CEQ
	BT	L9
	BRA	L10
L9:
STR STR_L11, "CHK_TEST0 2 OK CONSTRAINT_ERROR rattrapee (borne basse, negatif)"	; constante string="CHK_TEST0 2 OK CONSTRAINT_ERROR rattrapee (borne basse, negatif)"
	LCA	STR_L11.data_ptr
	CALL	STANDARD.TEXT_IO. ,PUT_LINE_L60
	BRA	L8
L10:
	BRA	STANDARD.exc_raise_
L8:
L6:
	UNLINK 2
endPRO
namespace	BLOCK__2
ELB 2					;    BODY ELAB
					;    end elab
begin:					;---------- BDY INSTRUCTIONS
VAR	exc_ctx_L12, q, 10
	La	0, STANDARD.EXCEPTIONS_TOP_CTX_disp
	Sa  2,	exc_ctx_L12
	LCA	L12
	Sa  2,	exc_ctx_L12 + STANDARD._EXCEPTION_CONTEXT.DISPATCH
	EXC_MACH  2,	exc_ctx_L12
	LVA  2,	exc_ctx_L12
	Sa	0, STANDARD.EXCEPTIONS_TOP_CTX_disp
	Ld 1,	STANDARD.CHK_TEST0_L1.I_disp
	Ld 1,	STANDARD.CHK_TEST0_L1.I_disp
	ADD
	DUP
	Ld	1, STANDARD.CHK_TEST0_L1._SMALL.FST
	CLT
	BT	STANDARD.ce_raise_
	DUP
	Ld	1, STANDARD.CHK_TEST0_L1._SMALL.LST
