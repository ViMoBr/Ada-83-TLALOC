STR STR_L21, "CHK_TEST0 4 KO pas de levee"	; constante string="CHK_TEST0 4 KO pas de levee"
	LCA	STR_L21.data_ptr
	CALL	STANDARD.TEXT_IO. ,PUT_LINE_L60
	La 0,	STANDARD.EXCEPTIONS_TOP_CTX_disp
