	Sd  1,	S_disp
STR STR_L14, "CHK_TEST0 3 KO pas de levee"	; constante string="CHK_TEST0 3 KO pas de levee"
	LCA	STR_L14.data_ptr
	CALL	STANDARD.TEXT_IO. ,PUT_LINE_L60
	La 0,	STANDARD.EXCEPTIONS_TOP_CTX_disp
	La , 0
	Sa 0,	STANDARD.EXCEPTIONS_TOP_CTX_disp
	BRA	L13
L12:
	La	0, STANDARD.EXCEPTIONS_CURRENT_disp
	Sa  2,	exc_ctx_L12
	La	0, STANDARD.EXCEPTIONS_CURRENT_disp
	LCA	STANDARD.CONSTRAINT_ERROR__exc.data_ptr
	CEQ
	BT	L16
	BRA	L17
L16:
STR STR_L18, "CHK_TEST0 3 OK CONSTRAINT_ERROR rattrapee (borne haute)"	; constante string="CHK_TEST0 3 OK CONSTRAINT_ERROR rattrapee (borne haute)"
	LCA	STR_L18.data_ptr
	CALL	STANDARD.TEXT_IO. ,PUT_LINE_L60
	BRA	L15
L17:
	BRA	STANDARD.exc_raise_
L15:
L13:
	UNLINK 2
endPRO
namespace	BLOCK__3
ELB 2					;    BODY ELAB
					;    end elab
begin:					;---------- BDY INSTRUCTIONS
VAR	exc_ctx_L19, q, 10
	La	0, STANDARD.EXCEPTIONS_TOP_CTX_disp
	Sa  2,	exc_ctx_L19
	LCA	L19
	Sa  2,	exc_ctx_L19 + STANDARD._EXCEPTION_CONTEXT.DISPATCH
	EXC_MACH  2,	exc_ctx_L19
	LVA  2,	exc_ctx_L19
	Sa	0, STANDARD.EXCEPTIONS_TOP_CTX_disp
	Lb 1,	STANDARD.CHK_TEST0_L1.CH_disp
	DUP
	Lb	1, STANDARD.CHK_TEST0_L1._UPPER.FST
	CLT
	BT	STANDARD.ce_raise_
	DUP
