	LIa	, , 8
	Ld	, STRING.FST_1
	SUB
	Sd  2,	-result__ofs
	BRA ret_lbl
L43:					; post if
ret_lbl:
	UNLINK 2
	RTD	prm_siz-8
excep:
endPRO					;---------- end PRO SLENGTH
end if
