VAR	ANON_42_20__dat, STANDARD.IDL.TREE.size
	LVA 1, ANON_42_20__dat
	Sa  1, ANON_42_20_disp
	La  0, STANDARD.IDL.TREE.use__info
	Sa  1, ANON_42_20__u
	LVA 1, ANON_42_20_disp
					; doublet resultat record anonyme
	LI  219
	CALL	STANDARD.IDL. ,MAKE_L11
	La  ,  0
	BLKMOV

					;    end elab
begin:					;---------- BDY INSTRUCTIONS
VAR	ANON_44_24_disp, q
VAR	ANON_44_24__u,    q
VAR	ANON_44_24__dat, STANDARD.IDL.TREE.size
	LVA 1, ANON_44_24__dat
	Sa  1, ANON_44_24_disp
	La  0, STANDARD.IDL.TREE.use__info
	Sa  1, ANON_44_24__u
	LVA 1, ANON_44_24_disp
					; doublet resultat record anonyme
	Ld  1,	-NUMER_ofs
	CALL	STANDARD.IDL.SEM_PHASE_L7.UARITH. ,U_VAL_L21
	LVA 1,	REAL_disp
	LI  160
	CALL	STANDARD.IDL. ,D_L12
VAR	ANON_45_24_disp, q
VAR	ANON_45_24__u,    q
VAR	ANON_45_24__dat, STANDARD.IDL.TREE.size
	LVA 1, ANON_45_24__dat
	Sa  1, ANON_45_24_disp
	La  0, STANDARD.IDL.TREE.use__info
	Sa  1, ANON_45_24__u
	LVA 1, ANON_45_24_disp
					; doublet resultat record anonyme
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	1
	CALL	STANDARD.IDL.SEM_PHASE_L7.UARITH. ,U_VAL_L21
	LVA 1,	REAL_disp
	LI  161
	CALL	STANDARD.IDL. ,D_L12
	LVA 1,	REAL_disp
	La
	LI	STANDARD.IDL.TREE.size
	LVA 1,	REAL_disp
VAR	ANON_46_20_disp, q
VAR	ANON_46_20__u,    q
VAR	ANON_46_20__dat, STANDARD.IDL.TREE.size
	LVA 1, ANON_46_20__dat
	Sa  1, ANON_46_20_disp
	La  0, STANDARD.IDL.TREE.use__info
	Sa  1, ANON_46_20__u
	LVA 1, ANON_46_20_disp
					; doublet resultat record anonyme
	Ld  1,	-DENOM_ofs
	CALL	STANDARD.IDL.SEM_PHASE_L7.UARITH. ,U_VAL_L21
	DIV
	La
	BLKMOV
; CODE_RETURN : EXPR TYPE = DN_RECORD
	La   1,	-result__ofs
	La  ,  0
	LI	STANDARD.IDL.TREE.size
	LVA 1,	REAL_disp
	La  ,  0
	BLKMOV
	BRA ret_lbl
ret_lbl:
	UNLINK 1
	RTD	prm_siz-8
excep:
endPRO					;---------- end PRO U_REAL
