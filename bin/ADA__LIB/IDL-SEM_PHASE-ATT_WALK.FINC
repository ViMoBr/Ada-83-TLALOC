if defined PRINT_TREE_L6_
PRO	PRINT_TREE_L6				;---------- PRO PRINT_TREE
PRMS					;    debut parametrage
	PRM T_ofs				; in
endPRMS					;    fin parametrage
ELB 1					;    BODY ELAB
					;    end elab
begin:					;---------- BDY INSTRUCTIONS
					; debut if
	La 1, -T_ofs
	LIb	, 0, STANDARD.IDL.TREE.TY
	LI	219
	CEQ
	BF	L8
VAR	ANON_32_29_disp, q
VAR	ANON_32_29__u,    q
VAR	ANON_32_29__dat, STANDARD.IDL.TREE.size
	LVA 1, ANON_32_29__dat
	Sa  1, ANON_32_29_disp
	La  0, STANDARD.IDL.TREE.use__info
	Sa  1, ANON_32_29__u
	LVA 1, ANON_32_29_disp
					; doublet resultat record anonyme
	La  1,	-T_ofs
	LI  160
	CALL	STANDARD.IDL. ,D_L13
	CALL	STANDARD.IDL.PRINT_NOD. ,PRINT_TREE_L28
	LI	47
	CALL	STANDARD.TEXT_IO. ,PUT_L52
VAR	ANON_34_29_disp, q
VAR	ANON_34_29__u,    q
VAR	ANON_34_29__dat, STANDARD.IDL.TREE.size
	LVA 1, ANON_34_29__dat
	Sa  1, ANON_34_29_disp
	La  0, STANDARD.IDL.TREE.use__info
	Sa  1, ANON_34_29__u
	LVA 1, ANON_34_29_disp
					; doublet resultat record anonyme
	La  1,	-T_ofs
	LI  161
	CALL	STANDARD.IDL. ,D_L13
	CALL	STANDARD.IDL.PRINT_NOD. ,PRINT_TREE_L28
	BRA	L7
L8:
	La  1,	-T_ofs
	CALL	STANDARD.IDL.PRINT_NOD. ,PRINT_TREE_L28
L7:					; post if
ret_lbl:
	UNLINK 1
	RTD	prm_siz
excep:
endPRO					;---------- end PRO PRINT_TREE
end if

if defined U_REAL_L9_
PRO	U_REAL_L9				;---------- PRO U_REAL
PRMS					;    debut parametrage
	PRM NUMER_ofs				; in
	PRM DENOM_ofs				; in
	PRM result__ofs				; resultat de fonction
endPRMS					;    fin parametrage
ELB 1					;    BODY ELAB
VAR REAL_disp, q				; variable record : pointeur aux data record
VAR REAL__u, q				; variable record : pointeur aux useinfo
VAR REAL__dat, STANDARD.IDL.TREE.size
	LVA	1, REAL__dat
	Sa	1, REAL_disp				; record fin
	LVA	1, STANDARD.IDL.TREE.SIZ
	Sa	1, REAL__u
	La  1, REAL_disp
	LI	STANDARD.IDL.TREE.size
VAR	ANON_42_20_disp, q
VAR	ANON_42_20__u,    q
VAR	ANON_42_20__dat, STANDARD.IDL.TREE.size
	LVA 1, ANON_42_20__dat
	Sa  1, ANON_42_20_disp
	La  0, STANDARD.IDL.TREE.use__info
	Sa  1, ANON_42_20__u
	LVA 1, ANON_42_20_disp
					; doublet resultat record anonyme
	LI  219
	CALL	STANDARD.IDL. ,MAKE_L11
	La  ,  0
	BLKMOV

					;    end elab
begin:					;---------- BDY INSTRUCTIONS
VAR	ANON_44_24_disp, q
VAR	ANON_44_24__u,    q
VAR	ANON_44_24__dat, STANDARD.IDL.TREE.size
	LVA 1, ANON_44_24__dat
	Sa  1, ANON_44_24_disp
	La  0, STANDARD.IDL.TREE.use__info
	Sa  1, ANON_44_24__u
	LVA 1, ANON_44_24_disp
					; doublet resultat record anonyme
	Ld  1,	-NUMER_ofs
	CALL	STANDARD.IDL.SEM_PHASE_L7.UARITH. ,U_VAL_L21
	LVA 1,	REAL_disp
	LI  160
	CALL	STANDARD.IDL. ,D_L12
VAR	ANON_45_24_disp, q
VAR	ANON_45_24__u,    q
VAR	ANON_45_24__dat, STANDARD.IDL.TREE.size
	LVA 1, ANON_45_24__dat
	Sa  1, ANON_45_24_disp
	La  0, STANDARD.IDL.TREE.use__info
	Sa  1, ANON_45_24__u
	LVA 1, ANON_45_24_disp
					; doublet resultat record anonyme
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	1
	CALL	STANDARD.IDL.SEM_PHASE_L7.UARITH. ,U_VAL_L21
	LVA 1,	REAL_disp
	LI  161
	CALL	STANDARD.IDL. ,D_L12
	LVA 1,	REAL_disp
	La
	LI	STANDARD.IDL.TREE.size
	LVA 1,	REAL_disp
VAR	ANON_46_20_disp, q
VAR	ANON_46_20__u,    q
VAR	ANON_46_20__dat, STANDARD.IDL.TREE.size
	LVA 1, ANON_46_20__dat
	Sa  1, ANON_46_20_disp
	La  0, STANDARD.IDL.TREE.use__info
	Sa  1, ANON_46_20__u
	LVA 1, ANON_46_20_disp
					; doublet resultat record anonyme
	Ld  1,	-DENOM_ofs
	CALL	STANDARD.IDL.SEM_PHASE_L7.UARITH. ,U_VAL_L21
	DIV
	La
	BLKMOV
; CODE_RETURN : EXPR TYPE = DN_RECORD
	La   1,	-result__ofs
	La  ,  0
	LI	STANDARD.IDL.TREE.size
	LVA 1,	REAL_disp
	La  ,  0
	BLKMOV
	BRA ret_lbl
ret_lbl:
	UNLINK 1
	RTD	prm_siz-8
excep:
endPRO					;---------- end PRO U_REAL
end if

