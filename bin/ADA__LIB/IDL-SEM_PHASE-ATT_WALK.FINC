PRO	SLENGTH_L63				;---------- PRO SLENGTH
PRMS					;    debut parametrage
	PRM A_ofs				; in
	PRM result__ofs				; resultat de fonction
endPRMS					;    fin parametrage
ELB 2					;    BODY ELAB
					;    end elab
begin:					;---------- BDY INSTRUCTIONS
					; debut if
	LVA	2, -A_ofs
	LIa	, , 0				; array data start address on stack
	LVA	2, -A_ofs
	LIa	, , 8
	Ld	, _STRING.FST_1
	DUP
	LVA	2, -A_ofs
	LIa	, 0,  8
	Ld	, STANDARD._STRING.FST_1
	CLT
	BT	STANDARD.ce_raise_
	DUP
	LVA	2, -A_ofs
	LIa	, 0,  8
	Ld	, STANDARD._STRING.LST_1
	CGT
	BT	STANDARD.ce_raise_
	LVA	2, -A_ofs
	LIa	, 0,  8
	Ld	, STANDARD._STRING.FST_1			; (index - FST_1) * SIZ_1
	SUB
	LVA	2, -A_ofs
	LIa	, , 8
	Ld	, STANDARD._STRING.COMP_SIZ
	LI	8
	DIV
	MUL
	ADD					; add offset to start address
	Lb
	LI	95
	CEQ
	BF	L67
; CODE_RETURN : EXPR TYPE = DN_INTEGER  VUE COMPLETE = DN_INTEGER
	LVA	2, -A_ofs
	LIa	, , 8
	Ld	, _STRING.LST_1
	LVA	2, -A_ofs
	LIa	, , 8
	Ld	, _STRING.FST_1
	SUB
	INC
	CLAMP0
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	1
	SUB
	Sd  2,	-result__ofs
	BRA ret_lbl
	BRA	L66
L67:
; CODE_RETURN : EXPR TYPE = DN_INTEGER  VUE COMPLETE = DN_INTEGER
	LVA	2, -A_ofs
	LIa	, , 8
	Ld	, _STRING.LST_1
	LVA	2, -A_ofs
	LIa	, , 8
	Ld	, _STRING.FST_1
	SUB
	INC
	CLAMP0
	Sd  2,	-result__ofs
	BRA ret_lbl
L66:					; post if
ret_lbl:
	UNLINK 2
	RTD	prm_siz-8
excep:
endPRO					;---------- end PRO SLENGTH
end if
