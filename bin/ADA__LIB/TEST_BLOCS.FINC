	LI	222
	LIVa 1, PT_disp, STANDARD.TEST_BLOCS_L1.POINT.Y
	OVER
	Sd
	DROP
	LI	333
	LIVa 1, PT_disp, STANDARD.TEST_BLOCS_L1.POINT.Z
