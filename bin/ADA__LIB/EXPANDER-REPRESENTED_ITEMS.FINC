REPRESENTED_ITEMS = 'REPRESENTED_ITEMS'
namespace REPRESENTED_ITEMS			;---------- PACKAGE (BDY)
					;    BODY ELAB
					; sub program entry decl (in instantiation FALSE )

if defined STATIC_INTEGER_VALUE_L2_
PRO	STATIC_INTEGER_VALUE_L2			;---------- PRO STATIC_INTEGER_VALUE
 hexa_show 'STATIC_INTEGER_VALUE_L2 ', $
PRMS					;    debut parametrage
	PRM EXP_ofs				; in
	PRM result__ofs				; resultat de fonction
endPRMS					;    fin parametrage
ELB 1					;    BODY ELAB
					;    end elab
begin:					;---------- BDY INSTRUCTIONS
					; debut if
	La 1, -EXP_ofs
	La	-1, 0
	Ld
	LI	24
	LI	8
	UBFX
	LI	143
	CEQ
	DUP
	BT	L7
	DROP
L7:
	BF	L6
; CODE_RETURN : EXPR TYPE = DN_INTEGER  VUE COMPLETE = DN_INTEGER
	LI	0					; lieu resultat sur pile
	La  1,	-EXP_ofs
	LI  88
	CALL	STANDARD.IDL. ,DI_L21
	Sd  1,	-result__ofs
	BRA ret_lbl
	BRA	L5
L6:
; CODE & concat _STRING
VAR	ANON_31_17_L8_G_data, q
VAR	ANON_31_17_L8_G_info, q
VAR	ANON_31_82_L8_D_data, q
VAR	ANON_31_82_L8_D_info, q
VAR	ANON_31_17_L8_G_len,  q
VAR	ANON_31_82_L8_D_len,  q
VAR	ANON_31_17_L8_R_disp, q
VAR	ANON_31_17_L8_R__u,   q
namespace ANON_31_17_L8_R_info
  VAR SIZ,      d
  VAR _COMP_SIZ, d
  VAR _FST_1,    d
  VAR _LST_1,    d
end namespace
STR ANON_31_17_L8_G, "; REPRESENTED_ITEMS.STATIC_INTEGER_VALUE : EXP.TY inattendu "	; constante string="; REPRESENTED_ITEMS.STATIC_INTEGER_VALUE : EXP.TY inattendu "
	LCA	ANON_31_17_L8_G.data_ptr
	DUP
	La  ,  0
	Sa  1, ANON_31_17_L8_G_data
	La  ,  8
	Sa  1, ANON_31_17_L8_G_info
	LId 1, ANON_31_17_L8_G_info, _STRING.LST_1
	LId 1, ANON_31_17_L8_G_info, _STRING.FST_1
	SUB
	INC
	CLAMP0
	Sa  1, ANON_31_17_L8_G_len
VAR	ANON_31_82_disp, q
VAR	ANON_31_82__u,   q
namespace ANON_31_82_info
  VAR SIZ, d
  VAR _COMP_SIZ, d
  VAR _FST_1, d
  VAR _LST_1, d
end namespace
	LVA 1, ANON_31_82_info.SIZ
	Sa  1, ANON_31_82__u
	LVA 1, ANON_31_82_disp
	La 1, -EXP_ofs
	La	-1, 0
	Ld
	LI	24
	LI	8
	UBFX
	La 0, STANDARD.DIANA_NODE_ATTR_CLASS_NAMES._NODE_NAME.use__info
	LI	16
	ADD
	CALL	STANDARD. ,ENUM_IMAGE_L31
	DUP
	La  ,  0
	Sa  1, ANON_31_82_L8_D_data
	La  ,  8
	Sa  1, ANON_31_82_L8_D_info
	LId 1, ANON_31_82_L8_D_info, _STRING.LST_1
	LId 1, ANON_31_82_L8_D_info, _STRING.FST_1
	SUB
	INC
	CLAMP0
	Sa  1, ANON_31_82_L8_D_len
	La  1, ANON_31_17_L8_G_len
	La  1, ANON_31_82_L8_D_len
	ADD
	CO_VAR
	Sa  1, ANON_31_17_L8_R_disp
	LI	1
	Sd  1, ANON_31_17_L8_R_info._FST_1
	La  1, ANON_31_17_L8_G_len
	La  1, ANON_31_82_L8_D_len
	ADD
	Sd  1, ANON_31_17_L8_R_info._LST_1
	LI	8
	Sd  1, ANON_31_17_L8_R_info._COMP_SIZ
	La  1, ANON_31_17_L8_G_len
	La  1, ANON_31_82_L8_D_len
	ADD
	LI	8
	MUL
	Sd  1, ANON_31_17_L8_R_info.SIZ
	LVA 1, ANON_31_17_L8_R_info.SIZ
	Sa  1, ANON_31_17_L8_R__u
	La  1, ANON_31_17_L8_R_disp
	La  1, ANON_31_17_L8_G_len
	La  1, ANON_31_17_L8_G_data
	BLKMOV
	La  1, ANON_31_17_L8_R_disp
	La  1, ANON_31_17_L8_G_len
	ADD
	La  1, ANON_31_82_L8_D_len
	La  1, ANON_31_82_L8_D_data
	BLKMOV
	LVA 1, ANON_31_17_L8_R_disp
	CALL	STANDARD.TEXT_IO. ,PUT_LINE_L60
	LCA	STANDARD.PROGRAM_ERROR__exc.data_ptr
	Sa	0, STANDARD.EXCEPTIONS_CURRENT_disp
	BRA	STANDARD.exc_raise_
L5:					; post if
ret_lbl:
	UNLINK 1
	RTD	prm_siz-8
excep:
endPRO					;---------- end PRO STATIC_INTEGER_VALUE
end if

