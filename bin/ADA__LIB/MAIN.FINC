PRO	MAIN_L1				;---------- PRO MAIN
ELB 1					;    BODY ELAB
STRING = 'STRING'
namespace STRING				; array var constrained array type info
VAR use__info, q
VAR SIZ, d
	LVA	1, SIZ
	Sa	1, use__info
VAR COMP_SIZ, d
VAR FST_1, d
VAR LST_1, d
	LI	8
	Sd	1, COMP_SIZ
	Ld	1, COMP_SIZ
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	1
	Sd	1, FST_1
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	128
	Sd	1, LST_1
	Ld	1, LST_1
	INC
	Ld	1, FST_1
	SUB
	MUL
	Sd	1, SIZ
  virtual at 4
COMP_SIZ = $
	rd 1 
FST_1 = $
	rd 1 
LST_1 = $
	rd 1 
  end virtual
end namespace
VAR S_disp, q				; variable array : pointeur aux data
VAR S__u, q				; variable array : useinfo pointeur au rec info
	La 1, STRING.use__info
	Sa	1, S__u				; array info ptr at __u
	Ld	1, STRING.SIZ
	LI	8
	DIV
	CO_VAR
	Sa	1, S_disp				; array data ptr at _disp
					; array data aggregate
	La	1, S_disp
