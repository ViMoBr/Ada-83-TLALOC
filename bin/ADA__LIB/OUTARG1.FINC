					; _REC RECORD TYPE INFO
_REC = '_REC'
namespace _REC
VAR use__info, q
VAR SIZ, d
	LVA	1, SIZ
	Sa	1, use__info
USEINFO 1, C, 	La 0, STANDARD._CHARACTER.use__info
USEINFO 1, N, 	La 0, STANDARD._INTEGER.use__info
virtual at 0				; calcul des offsets statiques
STATOFS C, 1
STATOFS N, 4
size = $
end virtual
	LI	 size*8
	Sd	1, SIZ
end namespace

