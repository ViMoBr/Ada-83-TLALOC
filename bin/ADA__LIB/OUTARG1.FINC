					;    end elab
begin:					;---------- BDY INSTRUCTIONS
VAR	IL27_disp, d				; compteur boucle LOOP__1
	LVA	2, -S_ofs
	LIa	, , 8
	Ld	, _STRING.FST_1
	Sd  2,	IL27_disp
VAR	LMT_IL27_disp, d			; limite boucle LOOP__1
	LVA	2, -S_ofs
	LIa	, , 8
	Ld	, _STRING.LST_1
	Sd  2,	LMT_IL27_disp
	Ld  2,	IL27_disp				; test null range LOOP__1
	Ld  2,	LMT_IL27_disp
	CGT
	BT	L26
LOOP__1:					; corps boucle LOOP__1
	LVA	2, -S_ofs
	LIa	, , 0				; array data start address on stack
	Ld	2, IL27_disp
	LVA	2, -S_ofs
	LIa	, 0,  8
	Ld	, STANDARD._STRING.FST_1			; (index - FST_1) * SIZ_1
	SUB
	LVA	2, -S_ofs
	LIa	, , 8
	Ld	, STANDARD._STRING.COMP_SIZ
	LI	8
	DIV
	MUL
	ADD					; add offset to start address
	CALL	STANDARD.OUTARG1_L1. ,DONNE_CAR_L14
	Ld  2,	IL27_disp				; test de sortie LOOP__1
	Ld  2,	LMT_IL27_disp
	CEQ
	BT	L26
	Ld  2,	IL27_disp				; mise a jour compteur LOOP__1
	INC
	Sd  2,	IL27_disp
	BRA	LOOP__1				; iteration suivante LOOP__1
L26:					; post loop LOOP__1
ret_lbl:
	UNLINK 2
	RTD	prm_siz
excep:
endPRO					;---------- end PRO REMPLIT_TOUT
end if
