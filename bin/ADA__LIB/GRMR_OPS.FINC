	LId	0, ITABLE__u, STANDARD.GRMR_OPS.ITABLE.COMP_SIZ
	LI	8
	DIV
	MUL
	ADD					; add offset to start address
	Ld 0,	STANDARD.GRMR_OPS.HCODE_disp
; CODE CONVERSION SOURCE DN_INTEGER TARGET DN_INTEGER
	Sw
ret_lbl:
	UNLINK 2
	RTD	prm_siz
excep:
endPRO					;---------- end PRO STASH
end if
