VAR LL_disp, d				; variable entiere
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	17
	Sd  1,	LL_disp

STRING = 'STRING'
namespace STRING				; array var constrained array type info
VAR use__info, q
VAR SIZ, d
	LVA	1, SIZ
	Sa	1, use__info
VAR COMP_SIZ, d
VAR FST_1, d
VAR LST_1, d
	LI	8
	Sd	1, COMP_SIZ
	Ld	1, COMP_SIZ
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	1
	Sd	1, FST_1
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	17
	Sd	1, LST_1
	Ld	1, LST_1
	INC
	Ld	1, FST_1
	SUB
	MUL
	Sd	1, SIZ
  virtual at 4
COMP_SIZ = $
	rd 1 
FST_1 = $
	rd 1 
LST_1 = $
	rd 1 
  end virtual
end namespace
VAR TXT_disp, q				; variable array : pointeur aux data
VAR TXT__u, q				; variable array : useinfo pointeur au rec info
	La 1, STRING.use__info
	Sa	1, TXT__u				; array info ptr at __u
; COMPILE_ARRAY_VAR ASSOC.TY non gere DN_SELECTED

					;    end elab
begin:					;---------- BDY INSTRUCTIONS
LOOP__2:
	La	 1, TXT_disp				; array data start address on stack
	Ld 1,	LL_disp
	LId	1, TXT__u, STANDARD.STRING.FST_1		; (index - FST_1) * SIZ_1
	SUB
	LId	1, TXT__u, STANDARD.STRING.COMP_SIZ
	LI	8
	DIV
	MUL
	ADD					; add offset to start address
	Lb					; charge depuis adresse empilee 
	LI	32
	CNE
	BT	L6
	Ld 1,	LL_disp
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	1
	SUB
	Sd  1,	LL_disp
	BRA	LOOP__2
L6:					; post loop LOOP__2
; CODE_RETURN : EXPR TYPE = DN_ARRAY
	La 1, TXT_disp
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	1
	LId 1, TXT__u, STRING.FST_1
	SUB
	LI	1
	MUL
	ADD
	Ld 1,	LL_disp
	INC
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	1
	SUB
	LI	1
	MUL
VAR	RET_INFO_L8, q
	DUP
	La  ,  0
	SIq   1, -result__ofs,  0
	DUP
	La  ,  8
	Sa   1, RET_INFO_L8
	DROP
	La   1, -result__ofs
	La  ,  8
	LI	16
	La   1, RET_INFO_L8
	BLKMOV
	BRA ret_lbl
ret_lbl:
	UNLINK 1
	RTD	prm_siz-8
excep:
endPRO					;---------- end PRO GRMR_OP_IMAGE
end if
begin:					;---------- package BDY INSTRUCTIONS
namespace	BLOCK__3
ELB 1					;    BODY ELAB

if defined STASH_L9_
PRO	STASH_L9				;---------- PRO STASH
PRMS					;    debut parametrage
	PRM P_ofs				; in
	PRM S_ofs				; in
endPRMS					;    fin parametrage
ELB 2					;    BODY ELAB
STRING = 'STRING'
namespace STRING				; array var constrained array type info
VAR use__info, q
VAR SIZ, d
	LVA	2, SIZ
	Sa	2, use__info
VAR COMP_SIZ, d
VAR FST_1, d
VAR LST_1, d
	LI	8
	Sd	2, COMP_SIZ
	Ld	2, COMP_SIZ
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	1
	Sd	2, FST_1
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	17
	Sd	2, LST_1
	Ld	2, LST_1
	INC
	Ld	2, FST_1
	SUB
	MUL
	Sd	2, SIZ
  virtual at 4
COMP_SIZ = $
	rd 1 
FST_1 = $
	rd 1 
LST_1 = $
	rd 1 
  end virtual
end namespace
VAR A_17_disp, q				; variable array : pointeur aux data
VAR A_17__u, q				; variable array : useinfo pointeur au rec info
	La 2, STRING.use__info
	Sa	2, A_17__u				; array info ptr at __u
	Ld	2, STRING.SIZ
	LI	8
	DIV
	CO_VAR
	Sa	2, A_17_disp				; array data ptr at _disp
					; array data aggregate
	La	2, A_17_disp
VAR	CNT_ANON_81_44, d
	LI	17
	Sd 2,	CNT_ANON_81_44
ANON_81_44:
	DUP
	LI	32
	Sb
	LI	1
	ADD
	LI	0
	Ld 2,	CNT_ANON_81_44
	DEC
	CEQ
	BF	ANON_81_44
	DROP

					;    end elab
begin:					;---------- BDY INSTRUCTIONS
	La  2,	-S_ofs
	CALL	STANDARD.GRMR_OPS. ,HASH_SEARCH_L1
	La 2, A_17_disp
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	1
	LId 2, A_17__u, STRING.FST_1
	SUB
	LI	1
	MUL
	ADD
	LVA	2, -S_ofs
	LIa	, , 8
	Ld	, STRING.LST_1
	INC
	LVA	2, -S_ofs
	LIa	, , 8
	Ld	, STRING.FST_1
	SUB
	INC
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	1
	SUB
	LI	1
	MUL
	La  2,	-S_ofs
	La
	BLKMOV
	La	 0, HTABLE_disp				; array data start address on stack
	Ld 0,	STANDARD.GRMR_OPS.HCODE_disp
	LId	0, HTABLE__u, STANDARD.GRMR_OPS.HTABLE.FST_1	; (index - FST_1) * SIZ_1
	SUB
	LId	0, HTABLE__u, STANDARD.GRMR_OPS.HTABLE.COMP_SIZ
	LI	8
	DIV
	MUL
	ADD					; add offset to start address
	DUP
	LVA	, STANDARD.GRMR_OPS.HTABLE_TYPE.HN
	LVA 2,	A_17_disp
	Sv
	DUP
	LVA	, STANDARD.GRMR_OPS.HTABLE_TYPE.HP
	Lb  2,	-P_ofs
	Sb
	DROP
	La	 0, ITABLE_disp				; array data start address on stack
	Lb  2,	-P_ofs
	LId	0, ITABLE__u, STANDARD.GRMR_OPS.ITABLE.FST_1	; (index - FST_1) * SIZ_1
