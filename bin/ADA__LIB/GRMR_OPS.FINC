namespace ANON_32_34_aga
  VAR _FST_1, d
  VAR _LST_1, d
  VAR _LEN_1, d
  VAR _STR_1, d
  VAR _PTR_1, q
  VAR _CNT_1, d
  VAR _EMIS_1, d
end namespace
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	1
	Sd  1, ANON_32_34_aga._FST_1
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	17
	Sd  1, ANON_32_34_aga._LST_1
	Ld  1, ANON_32_34_aga._LST_1
	Ld  1, ANON_32_34_aga._FST_1
	SUB
	INC
	CLAMP0
	Sd  1, ANON_32_34_aga._LEN_1
	LI	1
	Sd  1, ANON_32_34_aga._STR_1
	Sa  1, ANON_32_34_aga._PTR_1
	LI	0
	Sd  1, ANON_32_34_aga._EMIS_1
	Ld  1, ANON_32_34_aga._LEN_1
	Ld  1, ANON_32_34_aga._EMIS_1
	SUB
	Sd  1, ANON_32_34_aga._CNT_1
	Ld  1, ANON_32_34_aga._CNT_1
	LI	0
	CLE
	BT  L3
L2:
	LI	32
	SIb  1, ANON_32_34_aga._PTR_1, 0
	La  1, ANON_32_34_aga._PTR_1
	Ld  1, ANON_32_34_aga._STR_1
	ADD
	Sa  1, ANON_32_34_aga._PTR_1
	Ld  1, ANON_32_34_aga._EMIS_1
	INC
	Sd  1, ANON_32_34_aga._EMIS_1
	Ld  1, ANON_32_34_aga._CNT_1
	DEC
	DUP
	Sd  1, ANON_32_34_aga._CNT_1
	LI	0
	CGT
	BT  L2
L3:

					;    end elab
begin:					;---------- BDY INSTRUCTIONS
					; debut if
	LVA	1, -S_ofs
	LIa	, , 8
	Ld	, _STRING.LST_1
	LVA	1, -S_ofs
	LIa	, , 8
	Ld	, _STRING.FST_1
	SUB
	INC
	CLAMP0
; CODE_NUMERIC_LITERAL DN_UNIVERSAL_INTEGER
	LI	17
	CLE
	BF	L7
	La 1, STANDARD.GRMR_OPS.HASH_SEARCH_L1.A_17_disp
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	1
	LId 1, STANDARD.GRMR_OPS.HASH_SEARCH_L1.A_17__u, STANDARD._STRING.FST_1
	SUB
	LI	1
	MUL
	ADD
	LVA	1, -S_ofs
	LIa	, , 8
	Ld	, _STRING.LST_1
	LVA	1, -S_ofs
	LIa	, , 8
	Ld	, _STRING.FST_1
	SUB
	INC
	CLAMP0
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	1
	SUB
	INC
	CLAMP0
	LI	1
	MUL
	La  1,	-S_ofs
	La  ,  0
	BLKMOV
	BRA	L6
L7:
L6:					; post if
	LVA	1, -S_ofs
	LIa	, , 8
	Ld	, _STRING.LST_1
	LVA	1, -S_ofs
	LIa	, , 8
	Ld	, _STRING.FST_1
	SUB
	INC
	CLAMP0
	LVA	1, -S_ofs
	LIa	, , 0				; array data start address on stack
	LVA	1, -S_ofs
	LIa	, , 8
	Ld	, _STRING.LST_1
	DUP
	LVA	1, -S_ofs
	LIa	, 0,  8
	Ld	, STANDARD._STRING.FST_1
	CLT
	BT	STANDARD.ce_raise_
	DUP
	LVA	1, -S_ofs
	LIa	, 0,  8
	Ld	, STANDARD._STRING.LST_1
	CGT
	BT	STANDARD.ce_raise_
	LVA	1, -S_ofs
	LIa	, 0,  8
	Ld	, STANDARD._STRING.FST_1			; (index - FST_1) * SIZ_1
	SUB
	LVA	1, -S_ofs
	LIa	, , 8
	Ld	, STANDARD._STRING.COMP_SIZ
	LI	8
	DIV
	MUL
	ADD					; add offset to start address
	ULb
	ADD
; CODE_NUMERIC_LITERAL DN_UNIVERSAL_INTEGER
	LI	37
	DUP
	LI	0
	CEQ
	BT	STANDARD.ne_raise_
	MODI
	Sd  0,	STANDARD.GRMR_OPS.HCODE_disp
LOOP__1:
; CODE composite "/=" _STRING
VAR	ANON_39_12_L10_G_data, q
VAR	ANON_39_12_L10_G_info, q
VAR	ANON_39_12_L10_G_len,  q
	LVA 1,	A_17_disp
	DUP
	La  ,  0
	Sa  1, ANON_39_12_L10_G_data
	La  ,  8
	Sa  1, ANON_39_12_L10_G_info
	LId 1, ANON_39_12_L10_G_info, STANDARD._STRING.LST_1
	LId 1, ANON_39_12_L10_G_info, STANDARD._STRING.FST_1
	SUB
	INC
	CLAMP0
	Sa  1, ANON_39_12_L10_G_len
VAR	ANON_39_20_L10_D_data, q
VAR	ANON_39_20_L10_D_info, q
VAR	ANON_39_20_L10_D_len,  q
VAR	ANON_39_20_L10_D_disp, q
VAR	ANON_39_20_L10_D__u,   q
namespace ANON_39_20_L10_D_info
  VAR SIZ,      d
  VAR _COMP_SIZ, d
  VAR _FST_1,    d
  VAR _LST_1,    d
end namespace
	La	 0, STANDARD.GRMR_OPS.HTABLE_disp		; array data start address on stack
	Ld 0,	STANDARD.GRMR_OPS.HCODE_disp
	DUP
	LId	0, STANDARD.GRMR_OPS.HTABLE__u, STANDARD.GRMR_OPS._HTABLE__type.FST_1
	CLT
	BT	STANDARD.ce_raise_
	DUP
	LId	0, STANDARD.GRMR_OPS.HTABLE__u, STANDARD.GRMR_OPS._HTABLE__type.LST_1
	CGT
	BT	STANDARD.ce_raise_
	LId	0, STANDARD.GRMR_OPS.HTABLE__u, STANDARD.GRMR_OPS._HTABLE__type.FST_1	; (index - FST_1) * SIZ_1
	SUB
	LId	0, STANDARD.GRMR_OPS.HTABLE__u, STANDARD.GRMR_OPS._HTABLE__type.COMP_SIZ
	LI	8
	DIV
	MUL
	ADD					; add offset to start address
	LVA	, STANDARD.GRMR_OPS._HTABLE_TYPE.HN
	Sa  1, ANON_39_20_L10_D_disp
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	1
	Sd  1, ANON_39_20_L10_D_info._FST_1
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	17
	Sd  1, ANON_39_20_L10_D_info._LST_1
	LI	8
	Sd  1, ANON_39_20_L10_D_info._COMP_SIZ
	Ld  1, ANON_39_20_L10_D_info._LST_1
	Ld  1, ANON_39_20_L10_D_info._FST_1
	SUB
	INC
	CLAMP0
	LI	8
	MUL
	Sd  1, ANON_39_20_L10_D_info.SIZ
	LVA 1, ANON_39_20_L10_D_info.SIZ
	Sa  1, ANON_39_20_L10_D__u
	LVA 1, ANON_39_20_L10_D_disp
	DUP
	La  ,  0
	Sa  1, ANON_39_20_L10_D_data
	La  ,  8
	Sa  1, ANON_39_20_L10_D_info
	LId 1, ANON_39_20_L10_D_info, STANDARD._STRING.LST_1
	LId 1, ANON_39_20_L10_D_info, STANDARD._STRING.FST_1
	SUB
	INC
	CLAMP0
	Sa  1, ANON_39_20_L10_D_len
	La  1, ANON_39_12_L10_G_len
	La  1, ANON_39_20_L10_D_len
	CEQ
	DUP
	BF	L11
	DROP
	La  1, ANON_39_12_L10_G_data
	La  1, ANON_39_12_L10_G_len
	La  1, ANON_39_20_L10_D_data
	BLKCMP
L11:
	LI	1
	OUX
	DUP
	BF	L9
	DROP
	La	 0, STANDARD.GRMR_OPS.HTABLE_disp		; array data start address on stack
	Ld 0,	STANDARD.GRMR_OPS.HCODE_disp
	DUP
	LId	0, STANDARD.GRMR_OPS.HTABLE__u, STANDARD.GRMR_OPS._HTABLE__type.FST_1
	CLT
	BT	STANDARD.ce_raise_
	DUP
	LId	0, STANDARD.GRMR_OPS.HTABLE__u, STANDARD.GRMR_OPS._HTABLE__type.LST_1
	CGT
	BT	STANDARD.ce_raise_
	LId	0, STANDARD.GRMR_OPS.HTABLE__u, STANDARD.GRMR_OPS._HTABLE__type.FST_1	; (index - FST_1) * SIZ_1
	SUB
	LId	0, STANDARD.GRMR_OPS.HTABLE__u, STANDARD.GRMR_OPS._HTABLE__type.COMP_SIZ
	LI	8
	DIV
	MUL
	ADD					; add offset to start address
	ULb	, STANDARD.GRMR_OPS._HTABLE_TYPE.HP
	LI	0
	CNE
L9:
	BF	L8
	Ld 0,	STANDARD.GRMR_OPS.HCODE_disp
