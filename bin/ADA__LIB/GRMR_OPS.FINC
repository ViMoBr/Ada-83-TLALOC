if defined HASH_SEARCH_L1_
PRO	HASH_SEARCH_L1				;---------- PRO HASH_SEARCH
PRMS					;    debut parametrage
	PRM S_ofs				; in
endPRMS					;    fin parametrage
ELB 1					;    BODY ELAB
STRING = 'STRING'
namespace STRING				; array var constrained array type info
VAR use__info, q
VAR SIZ, d
	LVA	1, SIZ
	Sa	1, use__info
VAR COMP_SIZ, d
VAR FST_1, d
VAR LST_1, d
	LI	8
	Sd	1, COMP_SIZ
	Ld	1, COMP_SIZ
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	1
	Sd	1, FST_1
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	17
	Sd	1, LST_1
	Ld	1, LST_1
	INC
	Ld	1, FST_1
	SUB
	MUL
	Sd	1, SIZ
  virtual at 4
COMP_SIZ = $
	rd 1 
FST_1 = $
	rd 1 
LST_1 = $
	rd 1 
  end virtual
end namespace
VAR A_17_disp, q				; variable array : pointeur aux data
VAR A_17__u, q				; variable array : useinfo pointeur au rec info
	La 1, STRING.use__info
	Sa	1, A_17__u				; array info ptr at __u
	Ld	1, STRING.SIZ
	LI	8
	DIV
	CO_VAR
	Sa	1, A_17_disp				; array data ptr at _disp
					; array data aggregate
	La	1, A_17_disp
VAR	CNT_ANON_32_42, d
	LI	17
	Sd 1,	CNT_ANON_32_42
ANON_32_42:
	DUP
	LI	32
	Sb
	LI	1
	ADD
	LI	0
	Ld 1,	CNT_ANON_32_42
	DEC
	CEQ
	BF	ANON_32_42
	DROP

					;    end elab
begin:					;---------- BDY INSTRUCTIONS
					; debut if
	LVA	1, -S_ofs
	LIa	, , 8
	Ld	, STRING.LST_1
	INC
	LVA	1, -S_ofs
	LIa	, , 8
	Ld	, STRING.FST_1
	SUB
; CODE_NUMERIC_LITERAL DN_UNIVERSAL_INTEGER
	LI	17
	CLE
	BF	L3
	La 1, A_17_disp
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	1
	LId 1, A_17__u, STRING.FST_1
	SUB
	LI	1
	MUL
	ADD
	LVA	1, -S_ofs
	LIa	, , 8
	Ld	, STRING.LST_1
	INC
	LVA	1, -S_ofs
	LIa	, , 8
	Ld	, STRING.FST_1
	SUB
	INC
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	1
	SUB
	LI	1
	MUL
	La  1,	-S_ofs
	La
	BLKMOV
	BRA	L2
L3:
L2:					; post if
	LVA	1, -S_ofs
	LIa	, , 8
	Ld	, STRING.LST_1
	INC
	LVA	1, -S_ofs
	LIa	, , 8
	Ld	, STRING.FST_1
	SUB
	LVA	1, -S_ofs
	LIa	, , 0				; array data start address on stack
	LVA	1, -S_ofs
	LIa	, , 8
	Ld	, STRING.LST_1
	LVA	1, -S_ofs
	LIa	, , 8
	Ld	, STANDARD.STRING.FST_1			; (index - FST_1) * SIZ_1
	SUB
	LVA	1, -S_ofs
	LIa	, , 8
	Ld	, STANDARD.STRING.COMP_SIZ
	LI	8
	DIV
	MUL
	ADD					; add offset to start address
	Lb					; charge depuis adresse empilee 
	ADD
; CODE_NUMERIC_LITERAL DN_UNIVERSAL_INTEGER
	LI	37
	MODI
	Sd  0,	HCODE_disp
LOOP__1:
	LVA 1,	A_17_disp
	La	 0, HTABLE_disp				; array data start address on stack
	Ld 0,	STANDARD.GRMR_OPS.HCODE_disp
	LId	0, HTABLE__u, STANDARD.GRMR_OPS.HTABLE.FST_1	; (index - FST_1) * SIZ_1
	SUB
	LId	0, HTABLE__u, STANDARD.GRMR_OPS.HTABLE.COMP_SIZ
	LI	8
	DIV
	MUL
	ADD					; add offset to start address
	LVA	, STANDARD.GRMR_OPS.HTABLE_TYPE.HN
	CNE
	DUP
	BF	L5
	DROP
	La	 0, HTABLE_disp				; array data start address on stack
	Ld 0,	STANDARD.GRMR_OPS.HCODE_disp
	LId	0, HTABLE__u, STANDARD.GRMR_OPS.HTABLE.FST_1	; (index - FST_1) * SIZ_1
	SUB
	LId	0, HTABLE__u, STANDARD.GRMR_OPS.HTABLE.COMP_SIZ
	LI	8
	DIV
	MUL
	ADD					; add offset to start address
	Lb	, STANDARD.GRMR_OPS.HTABLE_TYPE.HP
	LI	0
	CNE
L5:
	BF	L4
	Ld 0,	STANDARD.GRMR_OPS.HCODE_disp
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	1
	ADD
; CODE_NUMERIC_LITERAL DN_UNIVERSAL_INTEGER
	LI	37
	MODI
	Sd  0,	HCODE_disp
	BRA	LOOP__1
L4:					; post loop LOOP__1
ret_lbl:
	UNLINK 1
	RTD	prm_siz
excep:
endPRO					;---------- end PRO HASH_SEARCH
end if

if defined GRMR_OP_VALUE_L1_
PRO	GRMR_OP_VALUE_L1			;---------- PRO GRMR_OP_VALUE
PRMS					;    debut parametrage
	PRM S_ofs				; in
	PRM result__ofs				; resultat de fonction
endPRMS					;    fin parametrage
ELB 1					;    BODY ELAB
					;    end elab
begin:					;---------- BDY INSTRUCTIONS
	La  1,	-S_ofs
	CALL	STANDARD.GRMR_OPS. ,HASH_SEARCH_L1
; CODE_RETURN : EXPR TYPE = DN_ENUMERATION
	La	 0, HTABLE_disp				; array data start address on stack
	Ld 0,	STANDARD.GRMR_OPS.HCODE_disp
	LId	0, HTABLE__u, STANDARD.GRMR_OPS.HTABLE.FST_1	; (index - FST_1) * SIZ_1
	SUB
	LId	0, HTABLE__u, STANDARD.GRMR_OPS.HTABLE.COMP_SIZ
	LI	8
	DIV
	MUL
	ADD					; add offset to start address
	Lb	, STANDARD.GRMR_OPS.HTABLE_TYPE.HP
	Sb  1,	-result__ofs
	BRA ret_lbl
ret_lbl:
	UNLINK 1
	RTD	prm_siz-8
excep:
endPRO					;---------- end PRO GRMR_OP_VALUE
end if

