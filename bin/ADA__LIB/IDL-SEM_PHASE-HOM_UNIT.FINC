HOM_UNIT = 'HOM_UNIT'
namespace HOM_UNIT				;---------- PACKAGE
elab_spec:				;    SPEC ELAB

					;    BODY ELAB

if defined WALK_HOMOGRAPH_UNIT_L1_
PRO	WALK_HOMOGRAPH_UNIT_L1			;---------- PRO WALK_HOMOGRAPH_UNIT
PRMS					;    debut parametrage
	PRM UNIT_NAME_ofs				; in
	PRM HEADER_ofs				; in
	PRM result__ofs				; resultat de fonction
endPRMS					;    fin parametrage
ELB 1					;    BODY ELAB
VAR NEW_NAME_disp, q			; variable record : pointeur aux data record
VAR NEW_NAME__u, q				; variable record : pointeur aux useinfo
VAR NEW_NAME__dat, STANDARD.IDL.TREE.size
	LVA	1, NEW_NAME__dat
	Sa	1, NEW_NAME_disp			; record fin
	LVA	1, STANDARD.IDL.TREE.SIZ
	Sa	1, NEW_NAME__u
	La  1, NEW_NAME_disp
	LI	STANDARD.IDL.TREE.size
	La  1,	-UNIT_NAME_ofs
	La  ,  0
	BLKMOV

VAR INDEX_disp, q				; variable record : pointeur aux data record
VAR INDEX__u, q				; variable record : pointeur aux useinfo
VAR INDEX__dat, STANDARD.IDL.TREE.size
	LVA	1, INDEX__dat
	Sa	1, INDEX_disp				; record fin
	LVA	1, STANDARD.IDL.TREE.SIZ
	Sa	1, INDEX__u
	La  1, INDEX_disp
	LI	STANDARD.IDL.TREE.size
	LVA 0,	STANDARD.IDL.TREE_VOID_disp
	La  ,  0
	BLKMOV

VAR TYPESET_disp, q				; variable record : pointeur aux data record
VAR TYPESET__u, q				; variable record : pointeur aux useinfo
VAR TYPESET__dat, STANDARD.IDL.SEM_PHASE_L7.SET_UTIL.TYPESET_TYPE.size
	LVA	1, TYPESET__dat
	Sa	1, TYPESET_disp				; record fin
	LVA	1, STANDARD.IDL.SEM_PHASE_L7.SET_UTIL.TYPESET_TYPE.SIZ
	Sa	1, TYPESET__u
	La  1, TYPESET_disp
	LI	STANDARD.IDL.SEM_PHASE_L7.SET_UTIL.TYPESET_TYPE.size
!! L ATTRIBUT CD_LEVEL DU NOEUD [DN_CONSTANT_ID<583.91]> N EST PAS UN ENTIER
