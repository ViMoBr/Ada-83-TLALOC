L482:					; post if
					; debut if
	Ld 1,	STANDARD.EXPANDER_L1.EXPRESSIONS.CODE_ARRAY_AGGREGATE_L457.NB_DIMS_disp
	Ld 1,	STANDARD.EXPANDER_L1.EXPRESSIONS.CODE_ARRAY_AGGREGATE_L457.MAX_DIMS_disp
