	LVA	, STANDARD.EXPANDER_L1.EXPRESSIONS.CODE_ARRAY_AGGREGATE_L457.DIM_INFO.LST_EXP
	LI	STANDARD.IDL.TREE.size
	LVA 2,	LST_disp
	BLKMOV
