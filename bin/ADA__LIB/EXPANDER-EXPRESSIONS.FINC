	LCA	STR_L487.data_ptr
	CALL	STANDARD.TEXT_IO. ,PUT_LINE_L60
	BRA	L485
L486:
L485:					; post if
	Ld 1,	STANDARD.EXPANDER_L1.EXPRESSIONS.CODE_ARRAY_AGGREGATE_L457.NB_DIMS_disp
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	1
	ADD
	Sd  1,	NB_DIMS_disp
	LVA 2,	FST_disp
	La
	LI	STANDARD.IDL.TREE.size
