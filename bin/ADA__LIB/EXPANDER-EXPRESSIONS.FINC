	Ld 1,	STANDARD.EXPANDER_L1.EXPRESSIONS.CODE_ARRAY_AGGREGATE_L457.NB_DIMS_disp
	LId	1, DIM_TBL__u, STANDARD.EXPANDER_L1.EXPRESSIONS.CODE_ARRAY_AGGREGATE_L457.DIM_TBL.FST_1	; (index - FST_1) * SIZ_1
	SUB
