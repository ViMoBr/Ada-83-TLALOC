	LI  50
	CALL	STANDARD.IDL. ,D_L17
	La
	BLKMOV
	LVA 2,	LST_disp
	La
	LI	STANDARD.IDL.TREE.size
VAR	ANON_2568_14_disp, q
VAR	ANON_2568_14__u,    q
VAR	ANON_2568_14__dat, STANDARD.IDL.TREE.size
