	LI  51
	CALL	STANDARD.IDL. ,D_L17
	La
	BLKMOV
	La	 1, DIM_TBL_disp			; array data start address on stack
	Ld 1,	STANDARD.EXPANDER_L1.EXPRESSIONS.CODE_ARRAY_AGGREGATE_L457.NB_DIMS_disp
	LId	1, DIM_TBL__u, STANDARD.EXPANDER_L1.EXPRESSIONS.CODE_ARRAY_AGGREGATE_L457.DIM_TBL.FST_1	; (index - FST_1) * SIZ_1
	SUB
	LId	1, DIM_TBL__u, STANDARD.EXPANDER_L1.EXPRESSIONS.CODE_ARRAY_AGGREGATE_L457.DIM_TBL.COMP_SIZ
	LI	8
	DIV
	MUL
	ADD					; add offset to start address
	LVA	, STANDARD.EXPANDER_L1.EXPRESSIONS.CODE_ARRAY_AGGREGATE_L457.DIM_INFO.FST_EXP
	LI	STANDARD.IDL.TREE.size
	LVA 2,	FST_disp
