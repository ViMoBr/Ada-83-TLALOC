	La 1, -ASSOC_CURSOR_ofs
	LIVA 	, 0, STANDARD.IDL.SEM_PHASE_L11.AGGRESO.ASSOC_CURSOR_TYPE.ASSOC_LIST
	LI	STANDARD.IDL.SEQ_TYPE.size
	La  1,	-ASSOC_LIST_ofs
	BLKMOV
	La 1, -ASSOC_CURSOR_ofs
	LIVA 	, 0, STANDARD.IDL.SEM_PHASE_L11.AGGRESO.ASSOC_CURSOR_TYPE.CHOICE_LIST
