if defined COUNT_AGGREGATE_CHOICES_L1_
PRO	COUNT_AGGREGATE_CHOICES_L1		;---------- PRO COUNT_AGGREGATE_CHOICES
PRMS					;    debut parametrage
	PRM ASSOC_S_ofs				; in
	PRM result__ofs				; resultat de fonction
endPRMS					;    fin parametrage
ELB 1					;    BODY ELAB
VAR ASSOC_CURSOR_disp, q			; variable record : pointeur aux data record
VAR ASSOC_CURSOR__u, q			; variable record : pointeur aux useinfo
VAR ASSOC_CURSOR__dat, STANDARD.IDL.SEM_PHASE_L7.AGGRESO.ASSOC_CURSOR_TYPE.size
	LVA	1, ASSOC_CURSOR__dat
	Sa	1, ASSOC_CURSOR_disp			; record fin
	LVA	1, STANDARD.IDL.SEM_PHASE_L7.AGGRESO.ASSOC_CURSOR_TYPE.SIZ
	Sa	1, ASSOC_CURSOR__u

					;    end elab
begin:					;---------- BDY INSTRUCTIONS
VAR	ANON_116_38_disp, q
VAR	ANON_116_38__u,    q
VAR	ANON_116_38__dat, STANDARD.IDL.SEQ_TYPE.size
	LVA 1, ANON_116_38__dat
	Sa  1, ANON_116_38_disp
	La  0, STANDARD.IDL.SEQ_TYPE.use__info
	Sa  1, ANON_116_38__u
	LVA 1, ANON_116_38_disp
					; doublet resultat record anonyme
	La  1,	-ASSOC_S_ofs
	CALL	STANDARD.IDL. ,LIST_L18
	LVA  1,	ASSOC_CURSOR_disp
	CALL	STANDARD.IDL.SEM_PHASE_L7.AGGRESO. ,INIT_ASSOC_CURSOR_L8
LOOP__1:
	LVA  1,	ASSOC_CURSOR_disp
	CALL	STANDARD.IDL.SEM_PHASE_L7.AGGRESO. ,ADVANCE_ASSOC_CURSOR_L9
	LIVA 	1, ASSOC_CURSOR_disp, STANDARD.IDL.SEM_PHASE_L7.AGGRESO.ASSOC_CURSOR_TYPE.ASSOC
	LVA 0,	STANDARD.IDL.TREE_VOID_disp
	CEQ
	BT	L26
	BRA	LOOP__1
L26:					; post loop LOOP__1
; CODE_RETURN : EXPR TYPE = DN_INTEGER
	LId	1, ASSOC_CURSOR_disp, STANDARD.IDL.SEM_PHASE_L7.AGGRESO.ASSOC_CURSOR_TYPE.COUNT
	Sd  1,	-result__ofs
	BRA ret_lbl
ret_lbl:
	UNLINK 1
	RTD	prm_siz-8
excep:
endPRO					;---------- end PRO COUNT_AGGREGATE_CHOICES
end if

if defined SPREAD_ASSOC_S_L2_
PRO	SPREAD_ASSOC_S_L2			;---------- PRO SPREAD_ASSOC_S
PRMS					;    debut parametrage
	PRM ASSOC_S_ofs				; in
	PRM AGGREGATE_ARRAY_ofs			; in out
endPRMS					;    fin parametrage
ELB 1					;    BODY ELAB
VAR ASSOC_CURSOR_disp, q			; variable record : pointeur aux data record
VAR ASSOC_CURSOR__u, q			; variable record : pointeur aux useinfo
VAR ASSOC_CURSOR__dat, STANDARD.IDL.SEM_PHASE_L7.AGGRESO.ASSOC_CURSOR_TYPE.size
	LVA	1, ASSOC_CURSOR__dat
	Sa	1, ASSOC_CURSOR_disp			; record fin
	LVA	1, STANDARD.IDL.SEM_PHASE_L7.AGGRESO.ASSOC_CURSOR_TYPE.SIZ
	Sa	1, ASSOC_CURSOR__u

					;    end elab
begin:					;---------- BDY INSTRUCTIONS
VAR	ANON_135_38_disp, q
VAR	ANON_135_38__u,    q
VAR	ANON_135_38__dat, STANDARD.IDL.SEQ_TYPE.size
	LVA 1, ANON_135_38__dat
	Sa  1, ANON_135_38_disp
	La  0, STANDARD.IDL.SEQ_TYPE.use__info
	Sa  1, ANON_135_38__u
	LVA 1, ANON_135_38_disp
					; doublet resultat record anonyme
	La  1,	-ASSOC_S_ofs
	CALL	STANDARD.IDL. ,LIST_L18
	LVA  1,	ASSOC_CURSOR_disp
	CALL	STANDARD.IDL.SEM_PHASE_L7.AGGRESO. ,INIT_ASSOC_CURSOR_L8
VAR	IL29_disp, d				; compteur boucle LOOP__2
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	1
	Sd  1,	IL29_disp
VAR	LMT_IL29_disp, d			; limite boucle LOOP__2
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	002147483647
	Sd  1,	LMT_IL29_disp
	Ld  1,	IL29_disp				; test null range LOOP__2
	Ld  1,	LMT_IL29_disp
	CGT
	BT	L28
LOOP__2:					; corps boucle LOOP__2
	LVA  1,	ASSOC_CURSOR_disp
	CALL	STANDARD.IDL.SEM_PHASE_L7.AGGRESO. ,ADVANCE_ASSOC_CURSOR_L9
	LVA	1, -AGGREGATE_ARRAY_ofs
	LIa	, , 0				; array data start address on stack
	Ld	1, IL29_disp
	LVA	1, -AGGREGATE_ARRAY_ofs
	LIa	, , 8
	Ld	, STANDARD.IDL.SEM_PHASE_L7.AGGRESO.AGGREGATE_ARRAY_TYPE.FST_1	; (index - FST_1) * SIZ_1
	SUB
	LVA	1, -AGGREGATE_ARRAY_ofs
	LIa	, , 8
	Ld	, STANDARD.IDL.SEM_PHASE_L7.AGGRESO.AGGREGATE_ARRAY_TYPE.COMP_SIZ
	LI	8
	DIV
	MUL
	ADD					; add offset to start address
	LVA	, STANDARD.IDL.SEM_PHASE_L7.AGGRESO.AGGREGATE_ITEM_TYPE.FIRST
	LId	1, ASSOC_CURSOR_disp, STANDARD.IDL.SEM_PHASE_L7.AGGRESO.ASSOC_CURSOR_TYPE.FIRST_COUNT
	Sd
	LVA	1, -AGGREGATE_ARRAY_ofs
	LIa	, , 0				; array data start address on stack
	Ld	1, IL29_disp
	LVA	1, -AGGREGATE_ARRAY_ofs
	LIa	, , 8
	Ld	, STANDARD.IDL.SEM_PHASE_L7.AGGRESO.AGGREGATE_ARRAY_TYPE.FST_1	; (index - FST_1) * SIZ_1
	SUB
	LVA	1, -AGGREGATE_ARRAY_ofs
	LIa	, , 8
	Ld	, STANDARD.IDL.SEM_PHASE_L7.AGGRESO.AGGREGATE_ARRAY_TYPE.COMP_SIZ
	LI	8
	DIV
	MUL
	ADD					; add offset to start address
	LVA	, STANDARD.IDL.SEM_PHASE_L7.AGGRESO.AGGREGATE_ITEM_TYPE.CHOICE
	LI	STANDARD.IDL.TREE.size
	LIVA 	1, ASSOC_CURSOR_disp, STANDARD.IDL.SEM_PHASE_L7.AGGRESO.ASSOC_CURSOR_TYPE.CHOICE
	BLKMOV
	LVA	1, -AGGREGATE_ARRAY_ofs
	LIa	, , 0				; array data start address on stack
	Ld	1, IL29_disp
	LVA	1, -AGGREGATE_ARRAY_ofs
	LIa	, , 8
	Ld	, STANDARD.IDL.SEM_PHASE_L7.AGGRESO.AGGREGATE_ARRAY_TYPE.FST_1	; (index - FST_1) * SIZ_1
	SUB
	LVA	1, -AGGREGATE_ARRAY_ofs
	LIa	, , 8
	Ld	, STANDARD.IDL.SEM_PHASE_L7.AGGRESO.AGGREGATE_ARRAY_TYPE.COMP_SIZ
	LI	8
	DIV
	MUL
	ADD					; add offset to start address
	LVA	, STANDARD.IDL.SEM_PHASE_L7.AGGRESO.AGGREGATE_ITEM_TYPE.SEEN
	LI	0
	Sb
	LVA	1, -AGGREGATE_ARRAY_ofs
	LIa	, , 0				; array data start address on stack
	Ld	1, IL29_disp
	LVA	1, -AGGREGATE_ARRAY_ofs
