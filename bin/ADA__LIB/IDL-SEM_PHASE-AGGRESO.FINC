PRMS					;    debut parametrage
	PRM EXP_ofs				; in
endPRMS					;    fin parametrage
ELB 1					;    BODY ELAB
VAR GENERAL_ASSOC_S_disp, q			; variable record : pointeur aux data record
VAR GENERAL_ASSOC_S__u, q			; variable record : pointeur aux useinfo
VAR GENERAL_ASSOC_S__dat, STANDARD.IDL.TREE.size
	LVA	1, GENERAL_ASSOC_S__dat
	Sa	1, GENERAL_ASSOC_S_disp			; record fin
	LVA	1, STANDARD.IDL.TREE.SIZ
	Sa	1, GENERAL_ASSOC_S__u
	La  1, GENERAL_ASSOC_S_disp
	LI	STANDARD.IDL.TREE.size
VAR	ANON_347_40_disp, q
VAR	ANON_347_40__u,    q
VAR	ANON_347_40__dat, STANDARD.IDL.TREE.size
	LVA 1, ANON_347_40__dat
	Sa  1, ANON_347_40_disp
	La  0, STANDARD.IDL.TREE.use__info
	Sa  1, ANON_347_40__u
	LVA 1, ANON_347_40_disp
					; doublet resultat record anonyme
	La  1,	-EXP_ofs
	LI  18
	CALL	STANDARD.IDL. ,D_L13
	La  ,  0
	BLKMOV

VAR ASSOC_COUNT_disp, d			; variable entiere
	LI	0					; lieu resultat sur pile
	CALL	STANDARD.IDL.SEM_PHASE_L7.AGGRESO. ,COUNT_AGGREGATE_CHOICES_L1
	Sd  1,	ASSOC_COUNT_disp

AGGREGATE_ARRAY_TYPE = 'AGGREGATE_ARRAY_TYPE'
namespace AGGREGATE_ARRAY_TYPE		; array var constrained array type info
VAR use__info, q
VAR SIZ, d
	LVA	1, SIZ
	Sa	1, use__info
VAR COMP_SIZ, d
VAR FST_1, d
VAR LST_1, d
	LI	240
	Sd	1, COMP_SIZ
	Ld	1, COMP_SIZ
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	1
	Sd	1, FST_1
	Ld 1,	ASSOC_COUNT_disp
	Sd	1, LST_1
	Ld	1, LST_1
	INC
	Ld	1, FST_1
	SUB
	MUL
	Sd	1, SIZ
  virtual at 4
COMP_SIZ = $
	rd 1 
FST_1 = $
	rd 1 
LST_1 = $
	rd 1 
  end virtual
end namespace
VAR AGGREGATE_ARRAY_disp, q			; variable array : pointeur aux data
VAR AGGREGATE_ARRAY__u, q			; variable array : useinfo pointeur au rec info
	La 1, AGGREGATE_ARRAY_TYPE.use__info
	Sa	1, AGGREGATE_ARRAY__u			; array info ptr at __u
	Ld	1, AGGREGATE_ARRAY_TYPE.SIZ
	LI	8
	DIV
	CO_VAR
	Sa	1, AGGREGATE_ARRAY_disp			; array data ptr at _disp

VAR TEMP_EXP_disp, q			; variable record : pointeur aux data record
VAR TEMP_EXP__u, q				; variable record : pointeur aux useinfo
VAR TEMP_EXP__dat, STANDARD.IDL.TREE.size
	LVA	1, TEMP_EXP__dat
	Sa	1, TEMP_EXP_disp			; record fin
	LVA	1, STANDARD.IDL.TREE.SIZ
	Sa	1, TEMP_EXP__u

					;    end elab
begin:					;---------- BDY INSTRUCTIONS
	La  1,	-EXP_ofs
	LI  87
	CALL	STANDARD.IDL. ,D_L12
	LVA  1,	AGGREGATE_ARRAY_disp
	CALL	STANDARD.IDL.SEM_PHASE_L7.AGGRESO. ,SPREAD_ASSOC_S_L2
VAR	IL81_disp, d				; compteur boucle LOOP__6
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	1
	Sd  1,	IL81_disp
VAR	LMT_IL81_disp, d			; limite boucle LOOP__6
	Ld 1,	ASSOC_COUNT_disp
	Sd  1,	LMT_IL81_disp
	Ld  1,	IL81_disp				; test null range LOOP__6
	Ld  1,	LMT_IL81_disp
	CGT
	BT	L80
LOOP__6:					; corps boucle LOOP__6
					; debut if
	La	 1, AGGREGATE_ARRAY_disp			; array data start address on stack
	Ld	1, IL81_disp
	LId	1, AGGREGATE_ARRAY__u, STANDARD.IDL.SEM_PHASE_L7.AGGRESO.AGGREGATE_ARRAY_TYPE.FST_1	; (index - FST_1) * SIZ_1
	SUB
	LId	1, AGGREGATE_ARRAY__u, STANDARD.IDL.SEM_PHASE_L7.AGGRESO.AGGREGATE_ARRAY_TYPE.COMP_SIZ
	LI	8
	DIV
	MUL
	ADD					; add offset to start address
	Ld	, STANDARD.IDL.SEM_PHASE_L7.AGGRESO.AGGREGATE_ITEM_TYPE.FIRST
	Ld	1, IL81_disp
	CEQ
	BF	L83
	LVA 1,	TEMP_EXP_disp
	La
	LI	STANDARD.IDL.TREE.size
VAR	ANON_356_21_disp, q
VAR	ANON_356_21__u,    q
VAR	ANON_356_21__dat, STANDARD.IDL.TREE.size
	LVA 1, ANON_356_21__dat
	Sa  1, ANON_356_21_disp
	La  0, STANDARD.IDL.TREE.use__info
	Sa  1, ANON_356_21__u
	LVA 1, ANON_356_21_disp
					; doublet resultat record anonyme
	La	 1, AGGREGATE_ARRAY_disp			; array data start address on stack
	Ld	1, IL81_disp
	LId	1, AGGREGATE_ARRAY__u, STANDARD.IDL.SEM_PHASE_L7.AGGRESO.AGGREGATE_ARRAY_TYPE.FST_1	; (index - FST_1) * SIZ_1
	SUB
	LId	1, AGGREGATE_ARRAY__u, STANDARD.IDL.SEM_PHASE_L7.AGGRESO.AGGREGATE_ARRAY_TYPE.COMP_SIZ
	LI	8
	DIV
	MUL
	ADD					; add offset to start address
	LVA	, STANDARD.IDL.SEM_PHASE_L7.AGGRESO.AGGREGATE_ITEM_TYPE.EXP
	CALL	STANDARD.IDL.SEM_PHASE_L7.EXPRESO. ,RESOLVE_EXP_L158
	La
	BLKMOV
	BRA	L82
L83:
L82:					; post if
	Ld  1,	IL81_disp				; test de sortie LOOP__6
	Ld  1,	LMT_IL81_disp
	CEQ
	BT	L80
	Ld  1,	IL81_disp				; mise a jour compteur LOOP__6
	INC
	Sd  1,	IL81_disp
	BRA	LOOP__6				; iteration suivante LOOP__6
L80:					; post loop LOOP__6
ret_lbl:
	UNLINK 1
	RTD	prm_siz
excep:
endPRO					;---------- end PRO RESOLVE_ERRONEOUS_AGGREGATE
end if

