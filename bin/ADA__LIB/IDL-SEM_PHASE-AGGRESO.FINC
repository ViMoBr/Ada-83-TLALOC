	LIa	, 0,  8
	Ld	, STANDARD.IDL.SEM_PHASE_L11.AGGRESO._AGGREGATE_ARRAY_TYPE.FST_1	; (index - FST_1) * SIZ_1
	SUB
	LVA	1, -AGGREGATE_ARRAY_ofs
	LIa	, , 8
	Ld	, STANDARD.IDL.SEM_PHASE_L11.AGGRESO._AGGREGATE_ARRAY_TYPE.COMP_SIZ
	LI	8
	DIV
	MUL
	ADD					; add offset to start address
	LVA	, STANDARD.IDL.SEM_PHASE_L11.AGGRESO._AGGREGATE_ITEM_TYPE.ASSOC
	Sa	1, SELARG_L421_disp
	La 0, STANDARD.IDL._TREE.use__info
	Sa	1, SELARG_L421__u
	LVA 1, SELARG_L421_disp
	LVA 1,	NEW_NORMALIZED_LIST_disp
	CALL	STANDARD.IDL.IDL_MAN. ,APPEND_L34
	La
	BLKMOV
	Ld  1,	IIL420_disp				; test de sortie LOOP__24
	Ld  1,	LMT_IIL420_disp
	CEQ
	BT	L419
	Ld  1,	IIL420_disp				; mise a jour compteur LOOP__24
	INC
	Sd  1,	IIL420_disp
	BRA	LOOP__24				; iteration suivante LOOP__24
L419:					; post loop LOOP__24
	La  1,	-NORMALIZED_LIST_ofs
	La
	LI	STANDARD.IDL._SEQ_TYPE.size
	LVA 1,	NEW_NORMALIZED_LIST_disp
	La
	BLKMOV
ret_lbl:
	UNLINK 1
	RTD	prm_siz
excep:
endPRO					;---------- end PRO MAKE_NORMALIZED_LIST
end if
begin:					;---------- package BDY INSTRUCTIONS
end namespace 				;---------- end package BDY AGGRESO

