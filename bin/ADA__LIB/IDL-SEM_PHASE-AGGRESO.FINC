AGGRESO = 'AGGRESO'
namespace AGGRESO				;---------- PACKAGE
elab_spec:				;    SPEC ELAB

; CODE_TYPE_DECL : skip PRIVATE AGGREGATE_ITEM_TYPE (deferred to full type)

					; AGGREGATE_ARRAY_TYPE UNCONSTRAINED ARRAY SUBTYPE INFO
AGGREGATE_ARRAY_TYPE = 'AGGREGATE_ARRAY_TYPE'
namespace AGGREGATE_ARRAY_TYPE
VAR use__info, q
VAR SIZ, d
	LVA	0, SIZ
	Sa	0, use__info
	LI	1
	NEG
	Sd	0, SIZ
  virtual at 4				; use info offsets pour acces sur array contraint

COMP_SIZ = $
	rd 1 
FST_1 = $
	rd 1 
LST_1 = $
	rd 1 
  end virtual
end namespace

					; AGGREGATE_ITEM_TYPE RECORD TYPE INFO
AGGREGATE_ITEM_TYPE = 'AGGREGATE_ITEM_TYPE'
namespace AGGREGATE_ITEM_TYPE
VAR use__info, q
VAR SIZ, d
	LVA	0, SIZ
	Sa	0, use__info
USEINFO 0, FIRST, 	La 0, STANDARD.POSITIVE.use__info
USEINFO 0, CHOICE, 	La 0, STANDARD.IDL.TREE.use__info
USEINFO 0, ID, 	La 0, STANDARD.IDL.TREE.use__info
USEINFO 0, ASSOC, 	La 0, STANDARD.IDL.TREE.use__info
USEINFO 0, EXP, 	La 0, STANDARD.IDL.TREE.use__info
USEINFO 0, TYPESET, 	La 1, STANDARD.IDL.SEM_PHASE_L11.SET_UTIL.TYPESET_TYPE.use__info
USEINFO 0, SEEN, 	La 0, STANDARD.BOOLEAN.use__info
USEINFO 0, RESOLVED, 	La 0, STANDARD.BOOLEAN.use__info
virtual at 0				; calcul des offsets statiques
STATOFS FIRST, 4
STATOFS CHOICE, 4
STATOFS ID, 4
STATOFS ASSOC, 4
STATOFS EXP, 4
STATOFS TYPESET, 8
STATOFS SEEN, 1
STATOFS RESOLVED, 1
size = $
end virtual
	LI	 size*8
	Sd	0, SIZ
end namespace
					;    BODY ELAB

					; ASSOC_CURSOR_TYPE RECORD TYPE INFO
ASSOC_CURSOR_TYPE = 'ASSOC_CURSOR_TYPE'
namespace ASSOC_CURSOR_TYPE
VAR use__info, q
VAR SIZ, d
	LVA	0, SIZ
	Sa	0, use__info
USEINFO 0, ASSOC_LIST, 	La 0, STANDARD.IDL.SEQ_TYPE.use__info
USEINFO 0, ASSOC, 	La 0, STANDARD.IDL.TREE.use__info
USEINFO 0, EXP, 	La 0, STANDARD.IDL.TREE.use__info
USEINFO 0, CHOICE_LIST, 	La 0, STANDARD.IDL.SEQ_TYPE.use__info
USEINFO 0, CHOICE, 	La 0, STANDARD.IDL.TREE.use__info
USEINFO 0, COUNT, 	La 0, STANDARD.NATURAL.use__info
USEINFO 0, FIRST_COUNT, 	La 0, STANDARD.POSITIVE.use__info
virtual at 0				; calcul des offsets statiques
STATOFS ASSOC_LIST, 8
STATOFS ASSOC, 4
STATOFS EXP, 4
STATOFS CHOICE_LIST, 8
STATOFS CHOICE, 4
STATOFS COUNT, 4
STATOFS FIRST_COUNT, 4
size = $
end virtual
	LI	 size*8
	Sd	0, SIZ
end namespace

if defined GET_SUBTYPE_OF_ID_L16_
PRO	GET_SUBTYPE_OF_ID_L16			;---------- PRO GET_SUBTYPE_OF_ID
PRMS					;    debut parametrage
	PRM ID_ofs				; in
	PRM result__ofs				; resultat de fonction
endPRMS					;    fin parametrage
ELB 1					;    BODY ELAB
VAR RESULT_disp, q				; variable record : pointeur aux data record
VAR RESULT__u, q				; variable record : pointeur aux useinfo
VAR RESULT__dat, STANDARD.IDL.TREE.size
	LVA	1, RESULT__dat
	Sa	1, RESULT_disp				; record fin
	LVA	1, STANDARD.IDL.TREE.SIZ
	Sa	1, RESULT__u
; CODE_VC_NAME DN_VARIABLE_ID
	La  1, RESULT_disp
	LI	STANDARD.IDL.TREE.size
VAR	ANON_39_22_disp, q
VAR	ANON_39_22__u,    q
VAR	ANON_39_22__dat, STANDARD.IDL.TREE.size
	LVA 1, ANON_39_22__dat
	Sa  1, ANON_39_22_disp
	La  0, STANDARD.IDL.TREE.use__info
	Sa  1, ANON_39_22__u
	LVA 1, ANON_39_22_disp
					; doublet resultat record anonyme
	La  1,	-ID_ofs
	LI  15
	CALL	STANDARD.IDL. ,D_L17
	La  ,  0
	BLKMOV

					;    end elab
begin:					;---------- BDY INSTRUCTIONS
					; debut if
	BF	L18
	LVA 1,	RESULT_disp
	La
	LI	STANDARD.IDL.TREE.size
VAR	ANON_42_17_disp, q
VAR	ANON_42_17__u,    q
VAR	ANON_42_17__dat, STANDARD.IDL.TREE.size
	LVA 1, ANON_42_17__dat
	Sa  1, ANON_42_17_disp
	La  0, STANDARD.IDL.TREE.use__info
	Sa  1, ANON_42_17__u
	LVA 1, ANON_42_17_disp
					; doublet resultat record anonyme
	LVA 1,	RESULT_disp
	LI  33
	CALL	STANDARD.IDL. ,D_L17
	La
	BLKMOV
	BRA	L17
L18:
	La	1, RESULT_disp
	Ld
	LI	24
	LI	8
	UBFX
	LI	214
	CEQ
	DUP
	BF	L20
	DROP
VAR	ANON_43_46_disp, q
VAR	ANON_43_46__u,    q
VAR	ANON_43_46__dat, STANDARD.IDL.TREE.size
	LVA 1, ANON_43_46__dat
	Sa  1, ANON_43_46_disp
	La  0, STANDARD.IDL.TREE.use__info
	Sa  1, ANON_43_46__u
	LVA 1, ANON_43_46_disp
					; doublet resultat record anonyme
	LVA 1,	RESULT_disp
	LI  84
	CALL	STANDARD.IDL. ,D_L17
	LVA 0,	STANDARD.IDL.TREE_VOID_disp
	CNE
L20:
	BF	L19
	LVA 1,	RESULT_disp
	La
	LI	STANDARD.IDL.TREE.size
VAR	ANON_44_17_disp, q
VAR	ANON_44_17__u,    q
VAR	ANON_44_17__dat, STANDARD.IDL.TREE.size
	LVA 1, ANON_44_17__dat
	Sa  1, ANON_44_17_disp
	La  0, STANDARD.IDL.TREE.use__info
	Sa  1, ANON_44_17__u
	LVA 1, ANON_44_17_disp
					; doublet resultat record anonyme
	LVA 1,	RESULT_disp
	LI  84
	CALL	STANDARD.IDL. ,D_L17
	La
	BLKMOV
	BRA	L17
L19:
L17:					; post if
; CODE_RETURN : EXPR TYPE = DN_RECORD
	La   1,	-result__ofs
	La  ,  0
	LI	STANDARD.IDL.TREE.size
	LVA 1,	RESULT_disp
	La  ,  0
	BLKMOV
	BRA ret_lbl
ret_lbl:
	UNLINK 1
	RTD	prm_siz-8
excep:
endPRO					;---------- end PRO GET_SUBTYPE_OF_ID
end if

if defined INIT_ASSOC_CURSOR_L8_
PRO	INIT_ASSOC_CURSOR_L8			;---------- PRO INIT_ASSOC_CURSOR
