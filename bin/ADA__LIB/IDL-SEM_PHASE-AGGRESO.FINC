	CALL	STANDARD.IDL.SEM_PHASE_L7.AGGRESO. ,WALK_RECORD_DECL_S_L3
LOOP__7:
	LVA 1,	COMP_LIST_disp
	LVA 0,	STANDARD.IDL.TREE_VOID_disp
	CNE
	BF	L84
	LVA  1,	LAST_POSITIONAL_disp
	LVA  1,	NORMALIZED_LIST_disp
