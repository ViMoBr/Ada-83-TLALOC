virtual at 0				; calcul des offsets statiques
STATOFS ASSOC_LIST, 8
STATOFS ASSOC, 4
STATOFS EXP, 4
STATOFS CHOICE_LIST, 8
STATOFS CHOICE, 4
STATOFS COUNT, 4
STATOFS FIRST_COUNT, 4
size = $
end virtual
	LI	 size*8
	Sd	0, SIZ
end namespace
