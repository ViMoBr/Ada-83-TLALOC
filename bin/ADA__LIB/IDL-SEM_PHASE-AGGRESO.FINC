AGGRESO = 'AGGRESO'
namespace AGGRESO				;---------- PACKAGE (BDY)
					;    BODY ELAB

					; _ASSOC_CURSOR_TYPE RECORD TYPE INFO
_ASSOC_CURSOR_TYPE = '_ASSOC_CURSOR_TYPE'
namespace _ASSOC_CURSOR_TYPE
VAR use__info, q
VAR SIZ, d
	LVA	0, SIZ
	Sa	0, use__info
USEINFO 0, ASSOC_LIST, 	La 0, STANDARD.IDL._SEQ_TYPE.use__info
USEINFO 0, ASSOC, 	La 0, STANDARD.IDL._TREE.use__info
USEINFO 0, EXP, 	La 0, STANDARD.IDL._TREE.use__info
USEINFO 0, CHOICE_LIST, 	La 0, STANDARD.IDL._SEQ_TYPE.use__info
USEINFO 0, CHOICE, 	La 0, STANDARD.IDL._TREE.use__info
USEINFO 0, COUNT, 	La 0, STANDARD._NATURAL.use__info
USEINFO 0, FIRST_COUNT, 	La 0, STANDARD._POSITIVE.use__info
virtual at 0				; calcul des offsets statiques
STATOFS ASSOC_LIST, 8
STATOFS ASSOC, 4
STATOFS EXP, 4
STATOFS CHOICE_LIST, 8
STATOFS CHOICE, 4
STATOFS COUNT, 4
STATOFS FIRST_COUNT, 4
size = $
end virtual
	LI	 size*8
	Sd	0, SIZ
end namespace

if defined GET_SUBTYPE_OF_ID_L9_
PRO	GET_SUBTYPE_OF_ID_L9			;---------- PRO GET_SUBTYPE_OF_ID
