if defined COUNT_AGGREGATE_CHOICES_L148_
PRO	COUNT_AGGREGATE_CHOICES_L148		;---------- PRO COUNT_AGGREGATE_CHOICES
 hexa_show 'COUNT_AGGREGATE_CHOICES_L148 ', $
PRMS					;    debut parametrage
	PRM ASSOC_S_ofs				; in
	PRM result__ofs				; resultat de fonction
endPRMS					;    fin parametrage
ELB 1					;    BODY ELAB
 hexa_show 'var elab ASSOC_CURSOR ', $
VAR ASSOC_CURSOR_disp, q			; variable record : pointeur aux data record
VAR ASSOC_CURSOR__u, q			; variable record : pointeur aux useinfo
VAR ASSOC_CURSOR__dat, STANDARD.IDL.SEM_PHASE_L11.AGGRESO._ASSOC_CURSOR_TYPE.size
	LVA	1, ASSOC_CURSOR__dat
	Sa	1, ASSOC_CURSOR_disp			; record fin
	LVA	1, STANDARD.IDL.SEM_PHASE_L11.AGGRESO._ASSOC_CURSOR_TYPE.SIZ
	Sa	1, ASSOC_CURSOR__u

 hexa_show ' disp ', ASSOC_CURSOR_disp
					;    end elab
begin:					;---------- BDY INSTRUCTIONS
VAR	ANON_116_38_disp, q
VAR	ANON_116_38__u,    q
VAR	ANON_116_38__dat, STANDARD.IDL._SEQ_TYPE.size
	LVA 1, ANON_116_38__dat
	Sa  1, ANON_116_38_disp
	La  0, STANDARD.IDL._SEQ_TYPE.use__info
	Sa  1, ANON_116_38__u
	LVA 1, ANON_116_38_disp
					; doublet resultat record anonyme
	La  1,	-ASSOC_S_ofs
	CALL	STANDARD.IDL. ,LIST_L22
	LVA  1,	STANDARD.IDL.SEM_PHASE_L11.AGGRESO.COUNT_AGGREGATE_CHOICES_L148.ASSOC_CURSOR_disp
	CALL	STANDARD.IDL.SEM_PHASE_L11.AGGRESO. ,INIT_ASSOC_CURSOR_L1
LOOP__1:
	LVA  1,	STANDARD.IDL.SEM_PHASE_L11.AGGRESO.COUNT_AGGREGATE_CHOICES_L148.ASSOC_CURSOR_disp
	CALL	STANDARD.IDL.SEM_PHASE_L11.AGGRESO. ,ADVANCE_ASSOC_CURSOR_L2
; CODE record equality "=" _TREE
	LIVA 	1, STANDARD.IDL.SEM_PHASE_L11.AGGRESO.COUNT_AGGREGATE_CHOICES_L148.ASSOC_CURSOR_disp, STANDARD.IDL.SEM_PHASE_L11.AGGRESO._ASSOC_CURSOR_TYPE.ASSOC
	Ld
	LVA 0,	STANDARD.IDL.TREE_VOID_disp
	La  ,  0
	Ld
	CEQ
	BT	L37
	BRA	LOOP__1
L37:					; post loop LOOP__1
; CODE_RETURN : EXPR TYPE = DN_INTEGER  VUE COMPLETE = DN_INTEGER
	LId	1, STANDARD.IDL.SEM_PHASE_L11.AGGRESO.COUNT_AGGREGATE_CHOICES_L148.ASSOC_CURSOR_disp, STANDARD.IDL.SEM_PHASE_L11.AGGRESO._ASSOC_CURSOR_TYPE.COUNT
	DUP
	Ld	0, STANDARD._NATURAL.FST
	CLT
	BT	STANDARD.ce_raise_
	DUP
	Ld	0, STANDARD._NATURAL.LST
	CGT
	BT	STANDARD.ce_raise_
	Sq  1,	-result__ofs
	BRA ret_lbl
ret_lbl:
	UNLINK 1
	RTD	prm_siz-8
excep:
endPRO					;---------- end PRO COUNT_AGGREGATE_CHOICES
end if

