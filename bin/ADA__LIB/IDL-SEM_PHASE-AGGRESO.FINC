	LIa	, , 8
	Ld	, STANDARD.IDL.SEM_PHASE_L11.AGGRESO._AGGREGATE_ARRAY_TYPE.COMP_SIZ
	LI	8
	DIV
	MUL
	ADD					; add offset to start address
	LVA	, STANDARD.IDL.SEM_PHASE_L11.AGGRESO._AGGREGATE_ITEM_TYPE.FIRST
	LId	1, ASSOC_CURSOR_disp, STANDARD.IDL.SEM_PHASE_L11.AGGRESO._ASSOC_CURSOR_TYPE.FIRST_COUNT
