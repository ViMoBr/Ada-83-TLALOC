if defined GET_SUBTYPE_OF_ID_L9_
PRO	GET_SUBTYPE_OF_ID_L9			;---------- PRO GET_SUBTYPE_OF_ID
 hexa_show 'GET_SUBTYPE_OF_ID_L9 ', $
PRMS					;    debut parametrage
	PRM ID_ofs				; in
	PRM result__ofs				; resultat de fonction
endPRMS					;    fin parametrage
ELB 1					;    BODY ELAB
 hexa_show 'var elab RESULT ', $
VAR RESULT_disp, q				; variable record : pointeur aux data record
VAR RESULT__u, q				; variable record : pointeur aux useinfo
VAR RESULT__dat, STANDARD.IDL._TREE.size
	LVA	1, RESULT__dat
	Sa	1, RESULT_disp				; record fin
	LVA	1, STANDARD.IDL._TREE.SIZ
	Sa	1, RESULT__u
	La  1, RESULT_disp
	LI	STANDARD.IDL._TREE.size
VAR	ANON_39_22_disp, q
VAR	ANON_39_22__u,    q
VAR	ANON_39_22__dat, STANDARD.IDL._TREE.size
	LVA 1, ANON_39_22__dat
	Sa  1, ANON_39_22_disp
	La  0, STANDARD.IDL._TREE.use__info
	Sa  1, ANON_39_22__u
	LVA 1, ANON_39_22_disp
					; doublet resultat record anonyme
	La  1,	-ID_ofs
	LI  15
	CALL	STANDARD.IDL. ,D_L17
	La  ,  0
	BLKMOV

 hexa_show ' disp ', RESULT_disp
					;    end elab
begin:					;---------- BDY INSTRUCTIONS
					; debut if
	La	1, STANDARD.IDL.SEM_PHASE_L11.AGGRESO.GET_SUBTYPE_OF_ID_L9.RESULT_disp
	Ld
	LI	24
	LI	8
	UBFX
	LI	212
	CGE
	LI	213
	La	1, STANDARD.IDL.SEM_PHASE_L11.AGGRESO.GET_SUBTYPE_OF_ID_L9.RESULT_disp
	Ld
	LI	24
	LI	8
	UBFX
	CGE
	ET
	BF	L13
	LVA 1,	RESULT_disp
	La
	LI	STANDARD.IDL._TREE.size
VAR	ANON_42_17_disp, q
VAR	ANON_42_17__u,    q
VAR	ANON_42_17__dat, STANDARD.IDL._TREE.size
	LVA 1, ANON_42_17__dat
	Sa  1, ANON_42_17_disp
	La  0, STANDARD.IDL._TREE.use__info
	Sa  1, ANON_42_17__u
	LVA 1, ANON_42_17_disp
					; doublet resultat record anonyme
	LVA 1,	RESULT_disp
	LI  33
	CALL	STANDARD.IDL. ,D_L17
	La
	BLKMOV
	BRA	L12
L13:
	La	1, STANDARD.IDL.SEM_PHASE_L11.AGGRESO.GET_SUBTYPE_OF_ID_L9.RESULT_disp
	Ld
	LI	24
	LI	8
	UBFX
	LI	214
	CEQ
	DUP
	BF	L15
	DROP
; CODE record equality "/=" _TREE
VAR	ANON_43_46_disp, q
VAR	ANON_43_46__u,    q
VAR	ANON_43_46__dat, STANDARD.IDL._TREE.size
	LVA 1, ANON_43_46__dat
	Sa  1, ANON_43_46_disp
	La  0, STANDARD.IDL._TREE.use__info
	Sa  1, ANON_43_46__u
	LVA 1, ANON_43_46_disp
					; doublet resultat record anonyme
	LVA 1,	RESULT_disp
	LI  84
	CALL	STANDARD.IDL. ,D_L17
	La  ,  0
	Ld
	LVA 0,	STANDARD.IDL.TREE_VOID_disp
	La  ,  0
	Ld
	CEQ
	LI	1
	OUX
L15:
	BF	L14
	LVA 1,	RESULT_disp
	La
	LI	STANDARD.IDL._TREE.size
VAR	ANON_44_17_disp, q
VAR	ANON_44_17__u,    q
VAR	ANON_44_17__dat, STANDARD.IDL._TREE.size
	LVA 1, ANON_44_17__dat
	Sa  1, ANON_44_17_disp
	La  0, STANDARD.IDL._TREE.use__info
	Sa  1, ANON_44_17__u
	LVA 1, ANON_44_17_disp
					; doublet resultat record anonyme
	LVA 1,	RESULT_disp
	LI  84
	CALL	STANDARD.IDL. ,D_L17
	La
	BLKMOV
	BRA	L12
L14:
L12:					; post if
; CODE_RETURN : EXPR TYPE = DN_RECORD  VUE COMPLETE = DN_RECORD
	La   1,	-result__ofs
	La  ,  0
	LI	STANDARD.IDL._TREE.size
	LVA 1,	RESULT_disp
	La
	BLKMOV
	BRA ret_lbl
ret_lbl:
	UNLINK 1
	RTD	prm_siz-8
excep:
endPRO					;---------- end PRO GET_SUBTYPE_OF_ID
end if

if defined INIT_ASSOC_CURSOR_L1_
PRO	INIT_ASSOC_CURSOR_L1			;---------- PRO INIT_ASSOC_CURSOR
 hexa_show 'INIT_ASSOC_CURSOR_L1 ', $
PRMS					;    debut parametrage
	PRM ASSOC_CURSOR_ofs			; out
	PRM ASSOC_LIST_ofs				; in
endPRMS					;    fin parametrage
ELB 1					;    BODY ELAB
					;    end elab
begin:					;---------- BDY INSTRUCTIONS
	La 1, -ASSOC_CURSOR_ofs
	LIVA 	, 0, STANDARD.IDL.SEM_PHASE_L11.AGGRESO._ASSOC_CURSOR_TYPE.ASSOC_LIST
	LI	STANDARD.IDL._SEQ_TYPE.size
	La  1,	-ASSOC_LIST_ofs
	La
	BLKMOV
	La 1, -ASSOC_CURSOR_ofs
	LIVA 	, 0, STANDARD.IDL.SEM_PHASE_L11.AGGRESO._ASSOC_CURSOR_TYPE.CHOICE_LIST
					; Assign_record_aggregate type DN_RECORD
	DUP
	LVA	, STANDARD.IDL._SEQ_TYPE.FIRST
	LI	STANDARD.IDL._TREE.size
	LVA 0,	STANDARD.IDL.TREE_NIL_disp
	La
	BLKMOV
	DUP
	LVA	, STANDARD.IDL._SEQ_TYPE.NEXT
	LI	STANDARD.IDL._TREE.size
	LVA 0,	STANDARD.IDL.TREE_NIL_disp
	La
	BLKMOV
	DROP
	La 1, -ASSOC_CURSOR_ofs
	LIVA 	, 0, STANDARD.IDL.SEM_PHASE_L11.AGGRESO._ASSOC_CURSOR_TYPE.COUNT
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	0
	Sd
ret_lbl:
	UNLINK 1
	RTD	prm_siz
excep:
endPRO					;---------- end PRO INIT_ASSOC_CURSOR
end if

