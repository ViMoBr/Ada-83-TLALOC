if defined COUNT_AGGREGATE_CHOICES_L1_
PRO	COUNT_AGGREGATE_CHOICES_L1		;---------- PRO COUNT_AGGREGATE_CHOICES
PRMS					;    debut parametrage
	PRM ASSOC_S_ofs				; in
	PRM result__ofs				; resultat de fonction
endPRMS					;    fin parametrage
ELB 1					;    BODY ELAB
VAR ASSOC_CURSOR_disp, q			; variable record : pointeur aux data record
VAR ASSOC_CURSOR__u, q			; variable record : pointeur aux useinfo
VAR ASSOC_CURSOR__dat, STANDARD.IDL.SEM_PHASE_L11.AGGRESO.ASSOC_CURSOR_TYPE.size
	LVA	1, ASSOC_CURSOR__dat
	Sa	1, ASSOC_CURSOR_disp			; record fin
	LVA	1, STANDARD.IDL.SEM_PHASE_L11.AGGRESO.ASSOC_CURSOR_TYPE.SIZ
	Sa	1, ASSOC_CURSOR__u
; CODE_VC_NAME DN_VARIABLE_ID

					;    end elab
begin:					;---------- BDY INSTRUCTIONS
VAR	ANON_116_38_disp, q
VAR	ANON_116_38__u,    q
VAR	ANON_116_38__dat, STANDARD.IDL.SEQ_TYPE.size
	LVA 1, ANON_116_38__dat
	Sa  1, ANON_116_38_disp
	La  0, STANDARD.IDL.SEQ_TYPE.use__info
	Sa  1, ANON_116_38__u
	LVA 1, ANON_116_38_disp
					; doublet resultat record anonyme
	La  1,	-ASSOC_S_ofs
	CALL	STANDARD.IDL. ,LIST_L22
	LVA  1,	ASSOC_CURSOR_disp
	CALL	STANDARD.IDL.SEM_PHASE_L11.AGGRESO. ,INIT_ASSOC_CURSOR_L8
LOOP__1:
	LVA  1,	ASSOC_CURSOR_disp
	CALL	STANDARD.IDL.SEM_PHASE_L11.AGGRESO. ,ADVANCE_ASSOC_CURSOR_L9
	LIVA 	1, ASSOC_CURSOR_disp, STANDARD.IDL.SEM_PHASE_L11.AGGRESO.ASSOC_CURSOR_TYPE.ASSOC
	LVA 0,	STANDARD.IDL.TREE_VOID_disp
	CEQ
	BT	L36
	BRA	LOOP__1
L36:					; post loop LOOP__1
; CODE_RETURN : EXPR TYPE = DN_INTEGER
	LId	1, ASSOC_CURSOR_disp, STANDARD.IDL.SEM_PHASE_L11.AGGRESO.ASSOC_CURSOR_TYPE.COUNT
	Sd  1,	-result__ofs
	BRA ret_lbl
ret_lbl:
	UNLINK 1
	RTD	prm_siz-8
excep:
endPRO					;---------- end PRO COUNT_AGGREGATE_CHOICES
end if

