	LVA 1,	COMP_LIST_disp
	La
	LI	STANDARD.IDL.TREE.size
	LVA 0,	STANDARD.IDL.TREE_VOID_disp
	La
	BLKMOV
					; debut if
	LVA 1,	VARIANT_PART_disp
	LVA 0,	STANDARD.IDL.TREE_VOID_disp
	CNE
	BF	L86
namespace	BLOCK__8
ELB 2					;    BODY ELAB
