	LI	STANDARD.IDL.TREE.size
	LVA 0,	STANDARD.IDL.TREE_NIL_disp
	La  ,  0
	BLKMOV
	DUP
	LVA	, STANDARD.IDL.SEQ_TYPE.NEXT
	LI	STANDARD.IDL.TREE.size
	LVA 0,	STANDARD.IDL.TREE_NIL_disp
	La  ,  0
	BLKMOV
	DROP
	La 1, -ASSOC_CURSOR_ofs
	LIVA 	, 0, STANDARD.IDL.SEM_PHASE_L11.AGGRESO.ASSOC_CURSOR_TYPE.COUNT
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	0
	Sd
ret_lbl:
	UNLINK 1
	RTD	prm_siz
excep:
endPRO					;---------- end PRO INIT_ASSOC_CURSOR
end if

