AGGREGATE_ARRAY_TYPE = 'AGGREGATE_ARRAY_TYPE'
namespace AGGREGATE_ARRAY_TYPE		; array var constrained array type info
VAR use__info, q
VAR SIZ, d
	LVA	1, SIZ
	Sa	1, use__info
VAR _COMP_SIZ, d
VAR _FST_1, d
VAR _LST_1, d
	LI	240
	Sd	1, _COMP_SIZ
	Ld	1, _COMP_SIZ
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	1
	Sd	1, _FST_1
	Ld 1,	ASSOC_COUNT_disp
	Sd	1, _LST_1
	Ld	1, _LST_1
	INC
	Ld	1, _FST_1
	SUB
	MUL
	Sd	1, SIZ
  virtual at 4
COMP_SIZ = $
	rd 1 
FST_1 = $
	rd 1 
LST_1 = $
	rd 1 
  end virtual
end namespace
VAR AGGREGATE_ARRAY_disp, q			; variable array : pointeur aux data
VAR AGGREGATE_ARRAY__u, q			; variable array : useinfo pointeur au rec info
	La 1, AGGREGATE_ARRAY_TYPE.use__info
	Sa	1, AGGREGATE_ARRAY__u			; array info ptr at __u
	Ld	1, AGGREGATE_ARRAY_TYPE.SIZ
	LI	8
	DIV
	CO_VAR
	Sa	1, AGGREGATE_ARRAY_disp			; array data ptr at _disp

VAR TEMP_EXP_disp, q			; variable record : pointeur aux data record
VAR TEMP_EXP__u, q				; variable record : pointeur aux useinfo
VAR TEMP_EXP__dat, STANDARD.IDL.TREE.size
	LVA	1, TEMP_EXP__dat
	Sa	1, TEMP_EXP_disp			; record fin
	LVA	1, STANDARD.IDL.TREE.SIZ
	Sa	1, TEMP_EXP__u
; CODE_VC_NAME DN_VARIABLE_ID

					;    end elab
begin:					;---------- BDY INSTRUCTIONS
	La  1,	-EXP_ofs
	LI  87
	CALL	STANDARD.IDL. ,D_L16
	LVA  1,	AGGREGATE_ARRAY_disp
	CALL	STANDARD.IDL.SEM_PHASE_L11.AGGRESO. ,SPREAD_ASSOC_S_L2
VAR	IL118_disp, d				; compteur boucle LOOP__6
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	1
	Sd  1,	IL118_disp
VAR	LMT_IL118_disp, d			; limite boucle LOOP__6
	Ld 1,	ASSOC_COUNT_disp
	Sd  1,	LMT_IL118_disp
	Ld  1,	IL118_disp				; test null range LOOP__6
	Ld  1,	LMT_IL118_disp
	CGT
	BT	L117
LOOP__6:					; corps boucle LOOP__6
					; debut if
	La	 1, AGGREGATE_ARRAY_disp			; array data start address on stack
	Ld	1, IL118_disp
	LId	1, AGGREGATE_ARRAY__u, STANDARD.IDL.SEM_PHASE_L11.AGGRESO.AGGREGATE_ARRAY_TYPE.FST_1	; (index - FST_1) * SIZ_1
	SUB
	LId	1, AGGREGATE_ARRAY__u, STANDARD.IDL.SEM_PHASE_L11.AGGRESO.AGGREGATE_ARRAY_TYPE.COMP_SIZ
	LI	8
	DIV
	MUL
	ADD					; add offset to start address
	Ld	, STANDARD.IDL.SEM_PHASE_L11.AGGRESO.AGGREGATE_ITEM_TYPE.FIRST
	Ld	1, IL118_disp
	CEQ
	BF	L120
	LVA 1,	TEMP_EXP_disp
	La
	LI	STANDARD.IDL.TREE.size
VAR	ANON_356_21_disp, q
VAR	ANON_356_21__u,    q
VAR	ANON_356_21__dat, STANDARD.IDL.TREE.size
	LVA 1, ANON_356_21__dat
	Sa  1, ANON_356_21_disp
	La  0, STANDARD.IDL.TREE.use__info
	Sa  1, ANON_356_21__u
	LVA 1, ANON_356_21_disp
					; doublet resultat record anonyme
	VAR SELARG_L121_disp, q
	VAR SELARG_L121__u, q
	La	 1, AGGREGATE_ARRAY_disp			; array data start address on stack
	Ld	1, IL118_disp
	LId	1, AGGREGATE_ARRAY__u, STANDARD.IDL.SEM_PHASE_L11.AGGRESO.AGGREGATE_ARRAY_TYPE.FST_1	; (index - FST_1) * SIZ_1
	SUB
	LId	1, AGGREGATE_ARRAY__u, STANDARD.IDL.SEM_PHASE_L11.AGGRESO.AGGREGATE_ARRAY_TYPE.COMP_SIZ
	LI	8
	DIV
	MUL
	ADD					; add offset to start address
	LVA	, STANDARD.IDL.SEM_PHASE_L11.AGGRESO.AGGREGATE_ITEM_TYPE.EXP
	Sa	1, SELARG_L121_disp
	La 0, STANDARD.IDL.TREE.use__info
	Sa	1, SELARG_L121__u
	LVA 1, SELARG_L121_disp
	CALL	STANDARD.IDL.SEM_PHASE_L11.EXPRESO. ,RESOLVE_EXP_L158
	La
	BLKMOV
	BRA	L119
L120:
L119:					; post if
	Ld  1,	IL118_disp				; test de sortie LOOP__6
	Ld  1,	LMT_IL118_disp
	CEQ
	BT	L117
	Ld  1,	IL118_disp				; mise a jour compteur LOOP__6
	INC
	Sd  1,	IL118_disp
	BRA	LOOP__6				; iteration suivante LOOP__6
L117:					; post loop LOOP__6
ret_lbl:
	UNLINK 1
	RTD	prm_siz
excep:
endPRO					;---------- end PRO RESOLVE_ERRONEOUS_AGGREGATE
end if

