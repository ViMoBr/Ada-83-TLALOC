					;    end elab
begin:					;---------- BDY INSTRUCTIONS
VAR	IL88_disp, d				; compteur boucle LOOP__10
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	1
	Sd  2,	IL88_disp
VAR	LMT_IL88_disp, d			; limite boucle LOOP__10
	Ld 1,	STANDARD.IDL.SEM_PHASE_L7.AGGRESO.RESOLVE_RECORD_AGGREGATE_L11.ASSOC_COUNT_disp
	Sd  2,	LMT_IL88_disp
	Ld  2,	IL88_disp				; test null range LOOP__10
	Ld  2,	LMT_IL88_disp
	CGT
	BT	L87
LOOP__10:					; corps boucle LOOP__10
					; debut if
	LVA 2,	DSCRMT_ID_disp
	La	 1, AGGREGATE_ARRAY_disp			; array data start address on stack
	Ld	2, IL88_disp
	LId	1, AGGREGATE_ARRAY__u, STANDARD.IDL.SEM_PHASE_L7.AGGRESO.AGGREGATE_ARRAY_TYPE.FST_1	; (index - FST_1) * SIZ_1
	SUB
	LId	1, AGGREGATE_ARRAY__u, STANDARD.IDL.SEM_PHASE_L7.AGGRESO.AGGREGATE_ARRAY_TYPE.COMP_SIZ
	LI	8
	DIV
	MUL
	ADD					; add offset to start address
	LVA	, STANDARD.IDL.SEM_PHASE_L7.AGGRESO.AGGREGATE_ITEM_TYPE.ID
	CEQ
	DUP
	BF	L92
	DROP
	LVA 2,	DSCRMT_ID_disp
	LVA 0,	STANDARD.IDL.TREE_VOID_disp
	CNE
L92:
	DUP
	BT	L91
	DROP
	La	 1, AGGREGATE_ARRAY_disp			; array data start address on stack
	Ld	2, IL88_disp
	LId	1, AGGREGATE_ARRAY__u, STANDARD.IDL.SEM_PHASE_L7.AGGRESO.AGGREGATE_ARRAY_TYPE.FST_1	; (index - FST_1) * SIZ_1
	SUB
	LId	1, AGGREGATE_ARRAY__u, STANDARD.IDL.SEM_PHASE_L7.AGGRESO.AGGREGATE_ARRAY_TYPE.COMP_SIZ
	LI	8
	DIV
	MUL
	ADD					; add offset to start address
	LVA	, STANDARD.IDL.SEM_PHASE_L7.AGGRESO.AGGREGATE_ITEM_TYPE.CHOICE
	Lb	, STANDARD.IDL.TREE.TY
	LI	163
	CEQ
L91:
	BF	L90
	LVA 2,	DSCRMT_EXP_disp
	La
	LI	STANDARD.IDL.TREE.size
	La	 1, AGGREGATE_ARRAY_disp			; array data start address on stack
	La	 1, AGGREGATE_ARRAY_disp			; array data start address on stack
	Ld	2, IL88_disp
	LId	1, AGGREGATE_ARRAY__u, STANDARD.IDL.SEM_PHASE_L7.AGGRESO.AGGREGATE_ARRAY_TYPE.FST_1	; (index - FST_1) * SIZ_1
	SUB
	LId	1, AGGREGATE_ARRAY__u, STANDARD.IDL.SEM_PHASE_L7.AGGRESO.AGGREGATE_ARRAY_TYPE.COMP_SIZ
	LI	8
	DIV
	MUL
	ADD					; add offset to start address
	Ld	, STANDARD.IDL.SEM_PHASE_L7.AGGRESO.AGGREGATE_ITEM_TYPE.FIRST
	LId	1, AGGREGATE_ARRAY__u, STANDARD.IDL.SEM_PHASE_L7.AGGRESO.AGGREGATE_ARRAY_TYPE.FST_1	; (index - FST_1) * SIZ_1
	SUB
	LId	1, AGGREGATE_ARRAY__u, STANDARD.IDL.SEM_PHASE_L7.AGGRESO.AGGREGATE_ARRAY_TYPE.COMP_SIZ
	LI	8
	DIV
	MUL
	ADD					; add offset to start address
	LVA	, STANDARD.IDL.SEM_PHASE_L7.AGGRESO.AGGREGATE_ITEM_TYPE.EXP
