					; doublet resultat record anonyme
	La  1,	-ASSOC_S_ofs
	CALL	STANDARD.IDL. ,LIST_L22
	LVA  1,	ASSOC_CURSOR_disp
	CALL	STANDARD.IDL.SEM_PHASE_L11.AGGRESO. ,INIT_ASSOC_CURSOR_L1
VAR	IL32_disp, d				; compteur boucle LOOP__2
	LVA	1, -AGGREGATE_ARRAY_ofs
	LIa	, , 8
	Ld	, _AGGREGATE_ARRAY_TYPE.FST_1
	Sd  1,	IL32_disp
