	DROP

					;    end elab
begin:					;---------- BDY INSTRUCTIONS
	La  1,	-EXP_ofs
	LI  95
	CALL	STANDARD.IDL. ,D_L12
	LVA  1,	AGGREGATE_ARRAY_disp
