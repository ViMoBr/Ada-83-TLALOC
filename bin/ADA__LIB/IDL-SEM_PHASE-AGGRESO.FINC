	LVA 0,	STANDARD.IDL.TREE_VOID_disp
	CEQ
	BT	L29
	BRA	LOOP__1
L29:					; post loop LOOP__1
; CODE_RETURN : EXPR TYPE = DN_INTEGER
	LId	1, ASSOC_CURSOR_disp, STANDARD.IDL.SEM_PHASE_L11.AGGRESO._ASSOC_CURSOR_TYPE.COUNT
	Sd  1,	-result__ofs
	BRA ret_lbl
ret_lbl:
	UNLINK 1
	RTD	prm_siz-8
excep:
endPRO					;---------- end PRO COUNT_AGGREGATE_CHOICES
