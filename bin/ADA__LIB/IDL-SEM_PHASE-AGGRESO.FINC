	LVA	1, -AGGREGATE_ARRAY_ofs
	LIa	, , 8
	Ld	, _AGGREGATE_ARRAY_TYPE.LST_1
	Sd  1,	LMT_IL32_disp
	Ld  1,	IL32_disp				; test null range LOOP__2
	Ld  1,	LMT_IL32_disp
	CGT
