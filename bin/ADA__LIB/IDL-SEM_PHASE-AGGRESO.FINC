	CEQ
	BT	L152
	Ld  1,	IL153_disp				; mise a jour compteur LOOP__6
	INC
	Sd  1,	IL153_disp
	BRA	LOOP__6				; iteration suivante LOOP__6
L152:					; post loop LOOP__6
ret_lbl:
	UNLINK 1
	RTD	prm_siz
excep:
endPRO					;---------- end PRO RESOLVE_ERRONEOUS_AGGREGATE
end if

