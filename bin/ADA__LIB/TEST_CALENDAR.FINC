					;---------- end generic package instantiation DUR_IO
end namespace

VAR T_disp, q				; variable fixed

VAR T2_disp, q				; variable fixed

VAR Y_disp, d				; variable entiere

VAR M_disp, d				; variable entiere

VAR D_disp, d				; variable entiere

VAR S_disp, q				; variable fixed

VAR DELTA_T_disp, q				; variable fixed


if defined AFFICHE_DATE_L14_
PRO	AFFICHE_DATE_L14			;---------- PRO AFFICHE_DATE
ELB 2					;    BODY ELAB
					;    end elab
begin:					;---------- BDY INSTRUCTIONS
STR STR_L15, " Y M D S = "			; constante string=" Y M D S = "
	LCA	STR_L15.data_ptr
	CALL	STANDARD.TEXT_IO. ,PUT_L56
	Ld 1,	STANDARD.TEST_CALENDAR_L1.INT_IO.DEFAULT_BASE_disp
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	5
	Ld 1,	STANDARD.TEST_CALENDAR_L1.Y_disp
; CODE CONVERSION SOURCE DN_INTEGER TARGET DN_INTEGER
	CALL	STANDARD.TEST_CALENDAR_L1.INT_IO. ,PUT_L5
	Ld 1,	STANDARD.TEST_CALENDAR_L1.INT_IO.DEFAULT_BASE_disp
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	3
	Ld 1,	STANDARD.TEST_CALENDAR_L1.M_disp
; CODE CONVERSION SOURCE DN_INTEGER TARGET DN_INTEGER
	CALL	STANDARD.TEST_CALENDAR_L1.INT_IO. ,PUT_L5
	Ld 1,	STANDARD.TEST_CALENDAR_L1.INT_IO.DEFAULT_BASE_disp
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	3
	Ld 1,	STANDARD.TEST_CALENDAR_L1.D_disp
; CODE CONVERSION SOURCE DN_INTEGER TARGET DN_INTEGER
	CALL	STANDARD.TEST_CALENDAR_L1.INT_IO. ,PUT_L5
	LI	32
	CALL	STANDARD.TEXT_IO. ,PUT_L52
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	2
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	6
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	1
	Lq 1,	STANDARD.TEST_CALENDAR_L1.S_disp
; CODE CONVERSION SOURCE DN_FIXED TARGET DN_FLOAT
	CVTIF
	LI	000536870912
	CVTIF
	FDIV
	CALL	STANDARD.TEST_CALENDAR_L1.DUR_IO. ,PUT_L11
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	1
	CALL	STANDARD.TEXT_IO. ,NEW_LINE_L26
ret_lbl:
	UNLINK 2
	RTD
excep:
endPRO					;---------- end PRO AFFICHE_DATE
end if
					;    end elab
begin:					;---------- BDY INSTRUCTIONS
STR STR_L16, "----- TIME_OF / SPLIT -----"	; constante string="----- TIME_OF / SPLIT -----"
	LCA	STR_L16.data_ptr
	CALL	STANDARD.TEXT_IO. ,PUT_LINE_L60
	LI	0					; lieu resultat sur pile
; CODE_NUMERIC_LITERAL DN_FIXED
	LI	00345599
	LI	000536870912
	LI	 4
	CVTIX
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	29
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	2
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	2000
	CALL	STANDARD.CALENDAR. ,TIME_OF_L7
	Sq  1,	T_disp
	LVA  1,	S_disp
	LVA  1,	D_disp
	LVA  1,	M_disp
	LVA  1,	Y_disp
	Lq 1,	T_disp
	CALL	STANDARD.CALENDAR. ,SPLIT_L6
	CALL	STANDARD.TEST_CALENDAR_L1. ,AFFICHE_DATE_L14
STR STR_L17, "----- SELECTORS -----"		; constante string="----- SELECTORS -----"
	LCA	STR_L17.data_ptr
	CALL	STANDARD.TEXT_IO. ,PUT_LINE_L60
	Ld 1,	STANDARD.TEST_CALENDAR_L1.INT_IO.DEFAULT_BASE_disp
	Ld 1,	STANDARD.TEST_CALENDAR_L1.INT_IO.DEFAULT_WIDTH_disp
	LI	0					; lieu resultat sur pile
	Lq 1,	T_disp
	CALL	STANDARD.CALENDAR. ,YEAR_L2
; CODE CONVERSION SOURCE DN_INTEGER TARGET DN_INTEGER
	CALL	STANDARD.TEST_CALENDAR_L1.INT_IO. ,PUT_L5
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	1
	CALL	STANDARD.TEXT_IO. ,NEW_LINE_L26
	Ld 1,	STANDARD.TEST_CALENDAR_L1.INT_IO.DEFAULT_BASE_disp
	Ld 1,	STANDARD.TEST_CALENDAR_L1.INT_IO.DEFAULT_WIDTH_disp
	LI	0					; lieu resultat sur pile
	Lq 1,	T_disp
	CALL	STANDARD.CALENDAR. ,MONTH_L3
; CODE CONVERSION SOURCE DN_INTEGER TARGET DN_INTEGER
	CALL	STANDARD.TEST_CALENDAR_L1.INT_IO. ,PUT_L5
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	1
	CALL	STANDARD.TEXT_IO. ,NEW_LINE_L26
	Ld 1,	STANDARD.TEST_CALENDAR_L1.INT_IO.DEFAULT_BASE_disp
	Ld 1,	STANDARD.TEST_CALENDAR_L1.INT_IO.DEFAULT_WIDTH_disp
	LI	0					; lieu resultat sur pile
	Lq 1,	T_disp
	CALL	STANDARD.CALENDAR. ,DAY_L4
; CODE CONVERSION SOURCE DN_INTEGER TARGET DN_INTEGER
	CALL	STANDARD.TEST_CALENDAR_L1.INT_IO. ,PUT_L5
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	1
	CALL	STANDARD.TEXT_IO. ,NEW_LINE_L26
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	2
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	6
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	1
	LI	0					; lieu resultat sur pile
	Lq 1,	T_disp
	CALL	STANDARD.CALENDAR. ,SECONDS_L5
; CODE CONVERSION SOURCE DN_FIXED TARGET DN_FLOAT
	CVTIF
	LI	000536870912
	CVTIF
	FDIV
	CALL	STANDARD.TEST_CALENDAR_L1.DUR_IO. ,PUT_L11
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	1
	CALL	STANDARD.TEXT_IO. ,NEW_LINE_L26
	Lq 1,	T_disp
; CODE_NUMERIC_LITERAL DN_FIXED
	LI	 1
	LI	000536870912
	LI	 4
	CVTIX
	ADD
	Sq  1,	T2_disp
STR STR_L18, "----- MIDNIGHT ROLLOVER -----"	; constante string="----- MIDNIGHT ROLLOVER -----"
	LCA	STR_L18.data_ptr
	CALL	STANDARD.TEXT_IO. ,PUT_LINE_L60
	LVA  1,	S_disp
	LVA  1,	D_disp
	LVA  1,	M_disp
	LVA  1,	Y_disp
	Lq 1,	T2_disp
	CALL	STANDARD.CALENDAR. ,SPLIT_L6
	CALL	STANDARD.TEST_CALENDAR_L1. ,AFFICHE_DATE_L14
STR STR_L19, "----- OPERATORS -----"		; constante string="----- OPERATORS -----"
	LCA	STR_L19.data_ptr
	CALL	STANDARD.TEXT_IO. ,PUT_LINE_L60
	Lq 1,	T2_disp
	Lq 1,	T_disp
	SUB
	Sq  1,	DELTA_T_disp
STR STR_L20, "T2 = "			; constante string="T2 = "
	LCA	STR_L20.data_ptr
	CALL	STANDARD.TEXT_IO. ,PUT_L56
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	2
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	6
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	1
	LI	0					; lieu resultat sur pile
	Lq 1,	T2_disp
	CALL	STANDARD.CALENDAR. ,SECONDS_L5
; CODE CONVERSION SOURCE DN_FIXED TARGET DN_FLOAT
	CVTIF
	LI	000536870912
	CVTIF
	FDIV
	CALL	STANDARD.TEST_CALENDAR_L1.DUR_IO. ,PUT_L11
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	1
	CALL	STANDARD.TEXT_IO. ,NEW_LINE_L26
STR STR_L21, "DELTA_T = "			; constante string="DELTA_T = "
	LCA	STR_L21.data_ptr
	CALL	STANDARD.TEXT_IO. ,PUT_L56
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	2
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	6
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	1
	Lq 1,	DELTA_T_disp
; CODE CONVERSION SOURCE DN_FIXED TARGET DN_FLOAT
	CVTIF
	LI	000536870912
	CVTIF
	FDIV
	CALL	STANDARD.TEST_CALENDAR_L1.DUR_IO. ,PUT_L11
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	1
	CALL	STANDARD.TEXT_IO. ,NEW_LINE_L26
					; debut if
	Lq 1,	T2_disp
	Lq 1,	T_disp
	CGT
	BF	L23
STR STR_L24, "GT OK"			; constante string="GT OK"
	LCA	STR_L24.data_ptr
	CALL	STANDARD.TEXT_IO. ,PUT_LINE_L60
	BRA	L22
L23:
STR STR_L25, "GT ERROR"			; constante string="GT ERROR"
	LCA	STR_L25.data_ptr
	CALL	STANDARD.TEXT_IO. ,PUT_LINE_L60
L22:					; post if
STR STR_L26, "----- JOURNEE ORDINAIRE (30/4/2001 86399.75sec + 0.25 -----"	; constante string="----- JOURNEE ORDINAIRE (30/4/2001 86399.75sec + 0.25 -----"
	LCA	STR_L26.data_ptr
	CALL	STANDARD.TEXT_IO. ,PUT_LINE_L60
	LI	0					; lieu resultat sur pile
; CODE_NUMERIC_LITERAL DN_FIXED
	LI	00345599
	LI	000536870912
	LI	 4
	CVTIX
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	30
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	4
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	2001
	CALL	STANDARD.CALENDAR. ,TIME_OF_L7
	Sq  1,	T_disp
	Lq 1,	T_disp
; CODE_NUMERIC_LITERAL DN_FIXED
	LI	 1
	LI	000536870912
	LI	 4
	CVTIX
	ADD
	Sq  1,	T2_disp
	LVA  1,	S_disp
	LVA  1,	D_disp
	LVA  1,	M_disp
	LVA  1,	Y_disp
	Lq 1,	T2_disp
	CALL	STANDARD.CALENDAR. ,SPLIT_L6
	CALL	STANDARD.TEST_CALENDAR_L1. ,AFFICHE_DATE_L14
STR STR_L27, "----- PASSAGE ANNEE (31/12/1999 86399.75sec + 0.25 -----"	; constante string="----- PASSAGE ANNEE (31/12/1999 86399.75sec + 0.25 -----"
	LCA	STR_L27.data_ptr
	CALL	STANDARD.TEXT_IO. ,PUT_LINE_L60
	LI	0					; lieu resultat sur pile
; CODE_NUMERIC_LITERAL DN_FIXED
	LI	00345599
	LI	000536870912
	LI	 4
	CVTIX
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	31
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	12
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	1999
	CALL	STANDARD.CALENDAR. ,TIME_OF_L7
	Sq  1,	T_disp
	Lq 1,	T_disp
; CODE_NUMERIC_LITERAL DN_FIXED
	LI	 1
	LI	000536870912
	LI	 4
	CVTIX
	ADD
	Sq  1,	T2_disp
	LVA  1,	S_disp
	LVA  1,	D_disp
	LVA  1,	M_disp
	LVA  1,	Y_disp
	Lq 1,	T2_disp
	CALL	STANDARD.CALENDAR. ,SPLIT_L6
	CALL	STANDARD.TEST_CALENDAR_L1. ,AFFICHE_DATE_L14
STR STR_L28, "----- ANNEE NON BISEXTILE (28/2/1900 86399.75sec + 0.25 -----"	; constante string="----- ANNEE NON BISEXTILE (28/2/1900 86399.75sec + 0.25 -----"
	LCA	STR_L28.data_ptr
	CALL	STANDARD.TEXT_IO. ,PUT_LINE_L60
	LI	0					; lieu resultat sur pile
; CODE_NUMERIC_LITERAL DN_FIXED
	LI	00345599
	LI	000536870912
	LI	 4
	CVTIX
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	28
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	2
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	1900
	CALL	STANDARD.CALENDAR. ,TIME_OF_L7
	Sq  1,	T_disp
	Lq 1,	T_disp
; CODE_NUMERIC_LITERAL DN_FIXED
	LI	 1
	LI	000536870912
	LI	 4
	CVTIX
	ADD
	Sq  1,	T2_disp
	LVA  1,	S_disp
	LVA  1,	D_disp
	LVA  1,	M_disp
