 hexa_show 'var elab T ', $
VAR T_disp, Q

 hexa_show ' disp ', T_disp
 hexa_show 'var elab T2 ', $
VAR T2_disp, Q

 hexa_show ' disp ', T2_disp
 hexa_show 'var elab Y ', $
VAR Y_disp, D

 hexa_show ' disp ', Y_disp
 hexa_show 'var elab M ', $
VAR M_disp, D

 hexa_show ' disp ', M_disp
 hexa_show 'var elab D ', $
VAR D_disp, D

 hexa_show ' disp ', D_disp
 hexa_show 'var elab S ', $
VAR S_disp, Q

 hexa_show ' disp ', S_disp
 hexa_show 'var elab DELTA_T ', $
VAR DELTA_T_disp, Q

 hexa_show ' disp ', DELTA_T_disp

if defined AFFICHE_DATE_L14_
PRO	AFFICHE_DATE_L14
 hexa_show 'AFFICHE_DATE_L14 ', $
ELB 2

begin:
STR STR_L17, " Y M D S = "
	LCA	STR_L17.data_ptr
	CALL	STANDARD.TEXT_IO. ,PUT_L56
	LD 1,	STANDARD.TEST_CALENDAR_L1.INT_IO.DEFAULT_BASE_disp
	DUP
	LD	0, STANDARD.TEXT_IO._NUMBER_BASE.FST
	CLT
	BT	STANDARD.ce_raise_
	DUP
	LD	0, STANDARD.TEXT_IO._NUMBER_BASE.LST
	CGT
	BT	STANDARD.ce_raise_
	LI	5
	DUP
	LD	0, STANDARD.TEXT_IO._FIELD.FST
	CLT
	BT	STANDARD.ce_raise_
	DUP
	LD	0, STANDARD.TEXT_IO._FIELD.LST
	CGT
	BT	STANDARD.ce_raise_
	LD 1,	STANDARD.TEST_CALENDAR_L1.Y_disp
	CALL	STANDARD.TEST_CALENDAR_L1.INT_IO. ,PUT_L5
	LD 1,	STANDARD.TEST_CALENDAR_L1.INT_IO.DEFAULT_BASE_disp
	DUP
	LD	0, STANDARD.TEXT_IO._NUMBER_BASE.FST
	CLT
	BT	STANDARD.ce_raise_
	DUP
	LD	0, STANDARD.TEXT_IO._NUMBER_BASE.LST
	CGT
	BT	STANDARD.ce_raise_
	LI	3
	DUP
	LD	0, STANDARD.TEXT_IO._FIELD.FST
	CLT
	BT	STANDARD.ce_raise_
	DUP
	LD	0, STANDARD.TEXT_IO._FIELD.LST
	CGT
	BT	STANDARD.ce_raise_
	LD 1,	STANDARD.TEST_CALENDAR_L1.M_disp
	CALL	STANDARD.TEST_CALENDAR_L1.INT_IO. ,PUT_L5
	LD 1,	STANDARD.TEST_CALENDAR_L1.INT_IO.DEFAULT_BASE_disp
	DUP
	LD	0, STANDARD.TEXT_IO._NUMBER_BASE.FST
	CLT
	BT	STANDARD.ce_raise_
	DUP
	LD	0, STANDARD.TEXT_IO._NUMBER_BASE.LST
	CGT
	BT	STANDARD.ce_raise_
	LI	3
	DUP
	LD	0, STANDARD.TEXT_IO._FIELD.FST
	CLT
	BT	STANDARD.ce_raise_
	DUP
	LD	0, STANDARD.TEXT_IO._FIELD.LST
	CGT
	BT	STANDARD.ce_raise_
	LD 1,	STANDARD.TEST_CALENDAR_L1.D_disp
	CALL	STANDARD.TEST_CALENDAR_L1.INT_IO. ,PUT_L5
	LI	32
	CALL	STANDARD.TEXT_IO. ,PUT_L52
	LI	2
	DUP
	LD	0, STANDARD.TEXT_IO._FIELD.FST
	CLT
	BT	STANDARD.ce_raise_
	DUP
	LD	0, STANDARD.TEXT_IO._FIELD.LST
	CGT
	BT	STANDARD.ce_raise_
	LI	6
	DUP
	LD	0, STANDARD.TEXT_IO._FIELD.FST
	CLT
	BT	STANDARD.ce_raise_
	DUP
	LD	0, STANDARD.TEXT_IO._FIELD.LST
	CGT
	BT	STANDARD.ce_raise_
	LI	1
	DUP
	LD	0, STANDARD.TEXT_IO._FIELD.FST
	CLT
	BT	STANDARD.ce_raise_
	DUP
	LD	0, STANDARD.TEXT_IO._FIELD.LST
	CGT
	BT	STANDARD.ce_raise_
	LQ 1,	STANDARD.TEST_CALENDAR_L1.S_disp
	CVTIF
	LI	000536870912
	CVTIF
	FDIV
	CALL	STANDARD.TEST_CALENDAR_L1.DUR_IO. ,PUT_L11
	LI	1
	DUP
	ULD	0, STANDARD.TEXT_IO._POSITIVE_COUNT.FST
	CLT
	BT	STANDARD.ce_raise_
	DUP
	ULD	0, STANDARD.TEXT_IO._POSITIVE_COUNT.LST
	CGT
	BT	STANDARD.ce_raise_
	CALL	STANDARD.TEXT_IO. ,NEW_LINE_L26
ret_lbl:
	UNLINKR 2
	RTD
excep:
endPRO
end if

begin:
STR STR_L20, "----- TIME_OF / SPLIT -----"
	LCA	STR_L20.data_ptr
	CALL	STANDARD.TEXT_IO. ,PUT_LINE_L60
	LI	0
	LI	00345599
	LI	000536870912
	LI	 4
	CVTIX
	LI	29
	DUP
	LD	0, STANDARD.CALENDAR._DAY_NUMBER.FST
	CLT
	BT	STANDARD.ce_raise_
	DUP
	LD	0, STANDARD.CALENDAR._DAY_NUMBER.LST
	CGT
	BT	STANDARD.ce_raise_
	LI	2
	DUP
	LD	0, STANDARD.CALENDAR._MONTH_NUMBER.FST
	CLT
	BT	STANDARD.ce_raise_
	DUP
	LD	0, STANDARD.CALENDAR._MONTH_NUMBER.LST
	CGT
	BT	STANDARD.ce_raise_
	LI	2000
	DUP
	LD	0, STANDARD.CALENDAR._YEAR_NUMBER.FST
	CLT
	BT	STANDARD.ce_raise_
	DUP
	LD	0, STANDARD.CALENDAR._YEAR_NUMBER.LST
	CGT
	BT	STANDARD.ce_raise_
	CALL	STANDARD.CALENDAR. ,TIME_OF_L7
	SQ  1,	T_disp
	LVA  1,	STANDARD.TEST_CALENDAR_L1.S_disp
	LVA  1,	STANDARD.TEST_CALENDAR_L1.D_disp
	LVA  1,	STANDARD.TEST_CALENDAR_L1.M_disp
	LVA  1,	STANDARD.TEST_CALENDAR_L1.Y_disp
	LQ 1,	T_disp
	CALL	STANDARD.CALENDAR. ,SPLIT_L6
	CALL	STANDARD.TEST_CALENDAR_L1. ,AFFICHE_DATE_L14
STR STR_L21, "----- SELECTORS -----"
	LCA	STR_L21.data_ptr
	CALL	STANDARD.TEXT_IO. ,PUT_LINE_L60
	LD 1,	STANDARD.TEST_CALENDAR_L1.INT_IO.DEFAULT_BASE_disp
	DUP
	LD	0, STANDARD.TEXT_IO._NUMBER_BASE.FST
	CLT
	BT	STANDARD.ce_raise_
	DUP
	LD	0, STANDARD.TEXT_IO._NUMBER_BASE.LST
	CGT
	BT	STANDARD.ce_raise_
	LD 1,	STANDARD.TEST_CALENDAR_L1.INT_IO.DEFAULT_WIDTH_disp
	DUP
	LD	0, STANDARD.TEXT_IO._FIELD.FST
	CLT
	BT	STANDARD.ce_raise_
	DUP
	LD	0, STANDARD.TEXT_IO._FIELD.LST
	CGT
	BT	STANDARD.ce_raise_
	LI	0
	LQ 1,	T_disp
	CALL	STANDARD.CALENDAR. ,YEAR_L2
	CALL	STANDARD.TEST_CALENDAR_L1.INT_IO. ,PUT_L5
	LI	1
	DUP
	ULD	0, STANDARD.TEXT_IO._POSITIVE_COUNT.FST
	CLT
	BT	STANDARD.ce_raise_
	DUP
	ULD	0, STANDARD.TEXT_IO._POSITIVE_COUNT.LST
	CGT
	BT	STANDARD.ce_raise_
	CALL	STANDARD.TEXT_IO. ,NEW_LINE_L26
	LD 1,	STANDARD.TEST_CALENDAR_L1.INT_IO.DEFAULT_BASE_disp
	DUP
	LD	0, STANDARD.TEXT_IO._NUMBER_BASE.FST
	CLT
	BT	STANDARD.ce_raise_
	DUP
	LD	0, STANDARD.TEXT_IO._NUMBER_BASE.LST
	CGT
	BT	STANDARD.ce_raise_
	LD 1,	STANDARD.TEST_CALENDAR_L1.INT_IO.DEFAULT_WIDTH_disp
	DUP
	LD	0, STANDARD.TEXT_IO._FIELD.FST
	CLT
	BT	STANDARD.ce_raise_
	DUP
	LD	0, STANDARD.TEXT_IO._FIELD.LST
	CGT
	BT	STANDARD.ce_raise_
	LI	0
	LQ 1,	T_disp
	CALL	STANDARD.CALENDAR. ,MONTH_L3
	CALL	STANDARD.TEST_CALENDAR_L1.INT_IO. ,PUT_L5
	LI	1
	DUP
	ULD	0, STANDARD.TEXT_IO._POSITIVE_COUNT.FST
	CLT
	BT	STANDARD.ce_raise_
	DUP
	ULD	0, STANDARD.TEXT_IO._POSITIVE_COUNT.LST
	CGT
	BT	STANDARD.ce_raise_
	CALL	STANDARD.TEXT_IO. ,NEW_LINE_L26
	LD 1,	STANDARD.TEST_CALENDAR_L1.INT_IO.DEFAULT_BASE_disp
	DUP
	LD	0, STANDARD.TEXT_IO._NUMBER_BASE.FST
	CLT
	BT	STANDARD.ce_raise_
	DUP
	LD	0, STANDARD.TEXT_IO._NUMBER_BASE.LST
	CGT
	BT	STANDARD.ce_raise_
	LD 1,	STANDARD.TEST_CALENDAR_L1.INT_IO.DEFAULT_WIDTH_disp
	DUP
	LD	0, STANDARD.TEXT_IO._FIELD.FST
	CLT
	BT	STANDARD.ce_raise_
	DUP
	LD	0, STANDARD.TEXT_IO._FIELD.LST
	CGT
	BT	STANDARD.ce_raise_
	LI	0
	LQ 1,	T_disp
	CALL	STANDARD.CALENDAR. ,DAY_L4
	CALL	STANDARD.TEST_CALENDAR_L1.INT_IO. ,PUT_L5
	LI	1
	DUP
	ULD	0, STANDARD.TEXT_IO._POSITIVE_COUNT.FST
	CLT
	BT	STANDARD.ce_raise_
	DUP
	ULD	0, STANDARD.TEXT_IO._POSITIVE_COUNT.LST
	CGT
	BT	STANDARD.ce_raise_
	CALL	STANDARD.TEXT_IO. ,NEW_LINE_L26
	LI	2
	DUP
	LD	0, STANDARD.TEXT_IO._FIELD.FST
	CLT
	BT	STANDARD.ce_raise_
	DUP
	LD	0, STANDARD.TEXT_IO._FIELD.LST
	CGT
	BT	STANDARD.ce_raise_
	LI	6
	DUP
	LD	0, STANDARD.TEXT_IO._FIELD.FST
	CLT
	BT	STANDARD.ce_raise_
	DUP
	LD	0, STANDARD.TEXT_IO._FIELD.LST
	CGT
	BT	STANDARD.ce_raise_
	LI	1
	DUP
	LD	0, STANDARD.TEXT_IO._FIELD.FST
	CLT
	BT	STANDARD.ce_raise_
	DUP
	LD	0, STANDARD.TEXT_IO._FIELD.LST
	CGT
	BT	STANDARD.ce_raise_
	LI	0
	LQ 1,	T_disp
	CALL	STANDARD.CALENDAR. ,SECONDS_L5
	CVTIF
	LI	000536870912
	CVTIF
	FDIV
	CALL	STANDARD.TEST_CALENDAR_L1.DUR_IO. ,PUT_L11
	LI	1
	DUP
	ULD	0, STANDARD.TEXT_IO._POSITIVE_COUNT.FST
	CLT
	BT	STANDARD.ce_raise_
	DUP
	ULD	0, STANDARD.TEXT_IO._POSITIVE_COUNT.LST
	CGT
	BT	STANDARD.ce_raise_
	CALL	STANDARD.TEXT_IO. ,NEW_LINE_L26
	LI	0
	LI	 1
	LI	000536870912
	LI	 4
	CVTIX
	LQ 1,	T_disp
	CALL	STANDARD.CALENDAR. ,_PLUS__L8
	SQ  1,	T2_disp
STR STR_L22, "----- MIDNIGHT ROLLOVER -----"
	LCA	STR_L22.data_ptr
	CALL	STANDARD.TEXT_IO. ,PUT_LINE_L60
	LVA  1,	STANDARD.TEST_CALENDAR_L1.S_disp
	LVA  1,	STANDARD.TEST_CALENDAR_L1.D_disp
	LVA  1,	STANDARD.TEST_CALENDAR_L1.M_disp
	LVA  1,	STANDARD.TEST_CALENDAR_L1.Y_disp
	LQ 1,	T2_disp
	CALL	STANDARD.CALENDAR. ,SPLIT_L6
	CALL	STANDARD.TEST_CALENDAR_L1. ,AFFICHE_DATE_L14
STR STR_L23, "----- OPERATORS -----"
	LCA	STR_L23.data_ptr
	CALL	STANDARD.TEXT_IO. ,PUT_LINE_L60
	LI	0
	LQ 1,	T_disp
	LQ 1,	T2_disp
	CALL	STANDARD.CALENDAR. ,_MINUS__L11
	SQ  1,	DELTA_T_disp
STR STR_L24, "T2 = "
	LCA	STR_L24.data_ptr
