if ~ definite TEXT_IO
include 'TEXT_IO.FINC'
end if
if ~ definite CALENDAR
include 'CALENDAR.FINC'
end if
PRO	TEST_CALENDAR_L1			;---------- PRO TEST_CALENDAR
ELB 1					;    BODY ELAB
INT_IO = 'INT_IO'
namespace INT_IO				;---------- GENERIC PACKAGE INSTANTIATION
elab_spec:				;    SPEC ELAB

BRA post_LD_INTEGER
LD_INTEGER.elab:
	Ld -1, 0
	RTD 0
post_LD_INTEGER:
BRA post_ST_INTEGER
ST_INTEGER.elab:
	SId -1, 0
	RTD 0
post_ST_INTEGER:
BRA post_INADR_INTEGER
INADR_INTEGER.elab:
	RTD 0
post_INADR_INTEGER:
BRA post_OUTADR_INTEGER
OUTADR_INTEGER.elab:
	La
	RTD 0
post_OUTADR_INTEGER:
VAR INTEGER__outadr_ofs, q
	LCA OUTADR_INTEGER.elab
	Sa	 1, INTEGER__outadr_ofs
VAR INTEGER__inadr_ofs, q
	LCA INADR_INTEGER.elab
	Sa	 1, INTEGER__inadr_ofs
VAR INTEGER__st_ofs, q
	LCA ST_INTEGER.elab
	Sa	 1, INTEGER__st_ofs
VAR INTEGER__ld_ofs, q
	LCA LD_INTEGER.elab
	Sa	 1, INTEGER__ld_ofs
VAR INTEGER__u_ofs, q
	La	 0, STANDARD.INTEGER.use__info
	Sa	 1, INTEGER__u_ofs
VAR GFP_disp, q				; Lieu du Generic Frame Pointer 
VAR DEFAULT_WIDTH_disp, d			; variable entiere
	LI	 11
	Sd  1,	DEFAULT_WIDTH_disp

VAR DEFAULT_BASE_disp, d			; variable entiere
	LI	10
	Sd  1,	DEFAULT_BASE_disp

if defined GET_L2_
PRO	GET_L2				;---------- PRO GET
PRMS					;    debut parametrage
	PRM FILE_ofs				; in
	PRM ITEM_ofs				; out
	PRM WIDTH_ofs				; in
endPRMS					;    fin parametrage
ELB 2
begin:
	LVA	 1, GFP_disp
; scalaire in attention generique ou pas
	Ld	 2, -WIDTH_ofs
	La 	 2, -ITEM_ofs
	La 	 2, -FILE_ofs
	CALL	STANDARD.TEXT_IO.INTEGER_IO. ,GET_L61
	UNLINK	 2
	RTD	prm_siz
endPRO					;---------- end PRO GET
end if
if defined GET_L3_
PRO	GET_L3				;---------- PRO GET
PRMS					;    debut parametrage
	PRM ITEM_ofs				; out
	PRM WIDTH_ofs				; in
endPRMS					;    fin parametrage
ELB 2
begin:
	LVA	 1, GFP_disp
; scalaire in attention generique ou pas
	Ld	 2, -WIDTH_ofs
	La 	 2, -ITEM_ofs
	CALL	STANDARD.TEXT_IO.INTEGER_IO. ,GET_L62
	UNLINK	 2
	RTD	prm_siz
endPRO					;---------- end PRO GET
end if
if defined PUT_L4_
PRO	PUT_L4				;---------- PRO PUT
PRMS					;    debut parametrage
	PRM FILE_ofs				; in
	PRM ITEM_ofs				; in
	PRM WIDTH_ofs				; in
	PRM BASE_ofs				; in
endPRMS					;    fin parametrage
ELB 2
begin:
	LVA	 1, GFP_disp
; scalaire in attention generique ou pas
	Ld	 2, -BASE_ofs
; scalaire in attention generique ou pas
	Ld	 2, -WIDTH_ofs
; scalaire in attention generique ou pas
	Ld	 2, -ITEM_ofs
	La 	 2, -FILE_ofs
	CALL	STANDARD.TEXT_IO.INTEGER_IO. ,PUT_L63
	UNLINK	 2
	RTD	prm_siz
endPRO					;---------- end PRO PUT
end if
if defined PUT_L5_
PRO	PUT_L5				;---------- PRO PUT
PRMS					;    debut parametrage
	PRM ITEM_ofs				; in
	PRM WIDTH_ofs				; in
	PRM BASE_ofs				; in
endPRMS					;    fin parametrage
ELB 2
begin:
	LVA	 1, GFP_disp
; scalaire in attention generique ou pas
	Ld	 2, -BASE_ofs
; scalaire in attention generique ou pas
	Ld	 2, -WIDTH_ofs
; scalaire in attention generique ou pas
	Ld	 2, -ITEM_ofs
	CALL	STANDARD.TEXT_IO.INTEGER_IO. ,PUT_L64
	UNLINK	 2
	RTD	prm_siz
endPRO					;---------- end PRO PUT
end if
if defined GET_L6_
PRO	GET_L6				;---------- PRO GET
PRMS					;    debut parametrage
	PRM FROM_ofs				; in
	PRM ITEM_ofs				; out
	PRM LAST_ofs				; out
endPRMS					;    fin parametrage
ELB 2
begin:
	LVA	 1, GFP_disp
	La 	 2, -LAST_ofs
	La 	 2, -ITEM_ofs
	La 	 2, -FROM_ofs
	CALL	STANDARD.TEXT_IO.INTEGER_IO. ,GET_L65
	UNLINK	 2
	RTD	prm_siz
endPRO					;---------- end PRO GET
end if
if defined PUT_L7_
PRO	PUT_L7				;---------- PRO PUT
PRMS					;    debut parametrage
	PRM TO_ofs				; out
	PRM ITEM_ofs				; in
	PRM BASE_ofs				; in
endPRMS					;    fin parametrage
ELB 2
begin:
	LVA	 1, GFP_disp
; scalaire in attention generique ou pas
	Ld	 2, -BASE_ofs
; scalaire in attention generique ou pas
	Ld	 2, -ITEM_ofs
	La 	 2, -TO_ofs
	CALL	STANDARD.TEXT_IO.INTEGER_IO. ,PUT_L66
	UNLINK	 2
	RTD	prm_siz
endPRO					;---------- end PRO PUT
end if
					;---------- end generic package instantiation INT_IO
end namespace

VAR T_disp, q				; variable entiere

VAR Y_disp, d				; variable entiere

VAR M_disp, d				; variable entiere

VAR D_disp, d				; variable entiere

VAR S_disp, q				; variable entiere

					;    end elab
begin:					;---------- BDY INSTRUCTIONS
	LI	0					; lieu resultat sur pile
	CALL	STANDARD.CALENDAR. ,CLOCK_L1
	Sq  1,	T_disp
	LI	0					; lieu resultat sur pile
	Lq 1,	T_disp
	CALL	STANDARD.CALENDAR. ,YEAR_L2
	Sd  1,	Y_disp
STR STR_L8, " ANNEE : "			; constante string=" ANNEE : "
	LCA	STR_L8.data_ptr
	CALL	STANDARD.TEXT_IO. ,PUT_L56
	Ld 1,	STANDARD.TEST_CALENDAR_L1.INT_IO.DEFAULT_BASE_disp
	Ld 1,	STANDARD.TEST_CALENDAR_L1.INT_IO.DEFAULT_WIDTH_disp
	Ld 1,	Y_disp
	CALL	STANDARD.TEST_CALENDAR_L1.INT_IO. ,PUT_L5
	LI	1
	CALL	STANDARD.TEXT_IO. ,NEW_LINE_L26
	LI	0					; lieu resultat sur pile
	Lq 1,	T_disp
	CALL	STANDARD.CALENDAR. ,MONTH_L3
	Sd  1,	M_disp
STR STR_L9, " MOIS : "			; constante string=" MOIS : "
	LCA	STR_L9.data_ptr
	CALL	STANDARD.TEXT_IO. ,PUT_L56
	Ld 1,	STANDARD.TEST_CALENDAR_L1.INT_IO.DEFAULT_BASE_disp
	Ld 1,	STANDARD.TEST_CALENDAR_L1.INT_IO.DEFAULT_WIDTH_disp
	Ld 1,	M_disp
	CALL	STANDARD.TEST_CALENDAR_L1.INT_IO. ,PUT_L5
	LI	1
	CALL	STANDARD.TEXT_IO. ,NEW_LINE_L26
	LI	0					; lieu resultat sur pile
	Lq 1,	T_disp
	CALL	STANDARD.CALENDAR. ,DAY_L4
	Sd  1,	D_disp
STR STR_L10, " JOUR "			; constante string=" JOUR "
	LCA	STR_L10.data_ptr
	CALL	STANDARD.TEXT_IO. ,PUT_L56
	Ld 1,	STANDARD.TEST_CALENDAR_L1.INT_IO.DEFAULT_BASE_disp
	Ld 1,	STANDARD.TEST_CALENDAR_L1.INT_IO.DEFAULT_WIDTH_disp
	Ld 1,	D_disp
	CALL	STANDARD.TEST_CALENDAR_L1.INT_IO. ,PUT_L5
	LI	1
	CALL	STANDARD.TEXT_IO. ,NEW_LINE_L26
ret_lbl:
	UNLINK 1
	RTD
excep:
endPRO					;---------- end PRO TEST_CALENDAR
