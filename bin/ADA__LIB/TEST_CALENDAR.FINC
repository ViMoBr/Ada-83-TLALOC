	Ld 1,	STANDARD.TEST_CALENDAR_L1.M_disp
; CODE CONVERSION SOURCE DN_INTEGER TARGET DN_INTEGER
	CALL	STANDARD.TEST_CALENDAR_L1.INT_IO. ,PUT_L5
	Ld 1,	STANDARD.TEST_CALENDAR_L1.INT_IO.DEFAULT_BASE_disp
	DUP
	Ld	0, STANDARD.TEXT_IO._NUMBER_BASE.FST
	CLT
	BT	STANDARD.ce_raise_
	DUP
	Ld	0, STANDARD.TEXT_IO._NUMBER_BASE.LST
	CGT
	BT	STANDARD.ce_raise_
; CODE_NUMERIC_LITERAL DN_INTEGER
