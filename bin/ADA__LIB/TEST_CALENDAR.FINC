TEST_CALENDAR = 'TEST_CALENDAR'
PRO	TEST_CALENDAR_L1
 hexa_show 'TEST_CALENDAR_L1 ', $
ELB 1
INT_IO = 'INT_IO'
namespace INT_IO
elab_spec:
BRA post_LD_NUM
LD_NUM.elab:
	LD -1, 0
	RTD 0
post_LD_NUM:
BRA post_ST_NUM
ST_NUM.elab:
	SD -1, 0
	RTD 0
post_ST_NUM:
BRA post_INADR_NUM
INADR_NUM.elab:
	RTD 0
post_INADR_NUM:
BRA post_OUTADR_NUM
OUTADR_NUM.elab:
	LA
	RTD 0
post_OUTADR_NUM:
VAR NUM__outadr_ofs, Q
	LCA OUTADR_NUM.elab
	SA	 1, NUM__outadr_ofs
VAR NUM__inadr_ofs, Q
	LCA INADR_NUM.elab
	SA	 1, NUM__inadr_ofs
VAR NUM__st_ofs, Q
	LCA ST_NUM.elab
	SA	 1, NUM__st_ofs
VAR NUM__ld_ofs, Q
	LCA LD_NUM.elab
	SA	 1, NUM__ld_ofs
VAR NUM__u_ofs, Q
	LA	 0, STANDARD._INTEGER.use__info
	SA	 1, NUM__u_ofs
VAR GFP_disp, Q

 hexa_show ' spec ', $
 hexa_show 'var elab DEFAULT_WIDTH ', $
VAR DEFAULT_WIDTH_disp, D
	LI	 11
	DUP
	LD	0, STANDARD.TEXT_IO._FIELD.FST
	CLT
	BT	STANDARD.ce_raise_
	DUP
	LD	0, STANDARD.TEXT_IO._FIELD.LST
	CGT
	BT	STANDARD.ce_raise_
	SD  1,	STANDARD.TEST_CALENDAR_L1.INT_IO.DEFAULT_WIDTH_disp

 hexa_show ' disp ', DEFAULT_WIDTH_disp
 hexa_show 'var elab DEFAULT_BASE ', $
VAR DEFAULT_BASE_disp, D
	LI	10
	DUP
	LD	0, STANDARD.TEXT_IO._NUMBER_BASE.FST
	CLT
	BT	STANDARD.ce_raise_
	DUP
	LD	0, STANDARD.TEXT_IO._NUMBER_BASE.LST
	CGT
	BT	STANDARD.ce_raise_
	SD  1,	STANDARD.TEST_CALENDAR_L1.INT_IO.DEFAULT_BASE_disp

 hexa_show ' disp ', DEFAULT_BASE_disp

if defined GET_L2_
PRO	GET_L2
 hexa_show 'GET_L2 ', $
PRMS
	PRM FILE_ofs
	PRM ITEM_ofs
	PRM WIDTH_ofs
endPRMS
ELB 2
begin:
	LVA	 1, GFP_disp
	LD	 2, -WIDTH_ofs
	LA 	 2, -ITEM_ofs
	LA 	 2, -FILE_ofs
	CALL	STANDARD.TEXT_IO.INTEGER_IO. ,GET_L61
	UNLINKR	 2
	RTD	prm_siz
endPRO
end if

