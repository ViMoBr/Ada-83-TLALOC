if defined PUT_L10_
PRO	PUT_L10				;---------- PRO PUT
PRMS					;    debut parametrage
	PRM FILE_ofs				; in
	PRM ITEM_ofs				; in
	PRM FORE_ofs				; in
	PRM AFT_ofs				; in
	PRM EXP_ofs				; in
endPRMS					;    fin parametrage
ELB 2
begin:
	LVA	 1, GFP_disp
	Ld	 2, -EXP_ofs
	Ld	 2, -AFT_ofs
	Ld	 2, -FORE_ofs
	Lq	 2, -ITEM_ofs
