	Sd  2,	IL36_disp
VAR	LMT_IL36_disp, d			; limite boucle LOOP__2
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	01000000
	Sd  2,	LMT_IL36_disp
	Ld  2,	IL36_disp				; test null range LOOP__2
	Ld  2,	LMT_IL36_disp
	CGT
	BT	L35
LOOP__2:					; corps boucle LOOP__2
