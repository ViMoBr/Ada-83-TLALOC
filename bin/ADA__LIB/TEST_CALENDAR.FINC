DUR_IO = 'DUR_IO'
namespace DUR_IO
elab_spec:
BRA post_LD_NUM
LD_NUM.elab:
	LQ -1, 0
	RTD 0
post_LD_NUM:
BRA post_ST_NUM
ST_NUM.elab:
	SQ -1, 0
	RTD 0
post_ST_NUM:
BRA post_INADR_NUM
INADR_NUM.elab:
	RTD 0
post_INADR_NUM:
BRA post_OUTADR_NUM
OUTADR_NUM.elab:
	LA
	RTD 0
post_OUTADR_NUM:
VAR NUM__outadr_ofs, Q
	LCA OUTADR_NUM.elab
	SA	 1, NUM__outadr_ofs
VAR NUM__inadr_ofs, Q
	LCA INADR_NUM.elab
	SA	 1, NUM__inadr_ofs
VAR NUM__st_ofs, Q
	LCA ST_NUM.elab
	SA	 1, NUM__st_ofs
VAR NUM__ld_ofs, Q
	LCA LD_NUM.elab
	SA	 1, NUM__ld_ofs
VAR NUM__u_ofs, Q
	LA	 0, STANDARD._LONG_FLOAT.use__info
	SA	 1, NUM__u_ofs
VAR GFP_disp, Q

 hexa_show ' spec ', $
 hexa_show 'var elab DEFAULT_FORE ', $
VAR DEFAULT_FORE_disp, D
	LI	2
	DUP
	LD	0, STANDARD.TEXT_IO._FIELD.FST
	CLT
	BT	STANDARD.ce_raise_
	DUP
	LD	0, STANDARD.TEXT_IO._FIELD.LST
	CGT
	BT	STANDARD.ce_raise_
	SD  1,	STANDARD.TEST_CALENDAR_L1.DUR_IO.DEFAULT_FORE_disp

 hexa_show ' disp ', DEFAULT_FORE_disp
 hexa_show 'var elab DEFAULT_AFT ', $
VAR DEFAULT_AFT_disp, D
	LI	15
	LI	1
	SUB
	DUP
	LD	0, STANDARD.TEXT_IO._FIELD.FST
	CLT
	BT	STANDARD.ce_raise_
	DUP
	LD	0, STANDARD.TEXT_IO._FIELD.LST
	CGT
	BT	STANDARD.ce_raise_
	SD  1,	STANDARD.TEST_CALENDAR_L1.DUR_IO.DEFAULT_AFT_disp

 hexa_show ' disp ', DEFAULT_AFT_disp
 hexa_show 'var elab DEFAULT_EXP ', $
VAR DEFAULT_EXP_disp, D
	LI	3
	DUP
	LD	0, STANDARD.TEXT_IO._FIELD.FST
	CLT
	BT	STANDARD.ce_raise_
	DUP
	LD	0, STANDARD.TEXT_IO._FIELD.LST
	CGT
	BT	STANDARD.ce_raise_
	SD  1,	STANDARD.TEST_CALENDAR_L1.DUR_IO.DEFAULT_EXP_disp

 hexa_show ' disp ', DEFAULT_EXP_disp

if defined GET_L8_
