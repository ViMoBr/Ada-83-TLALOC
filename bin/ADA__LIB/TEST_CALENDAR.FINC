begin:					;---------- BDY INSTRUCTIONS
	LI	0					; lieu resultat sur pile
	CALL	STANDARD.CALENDAR. ,CLOCK_L1
	Sq  2,	T1_disp
VAR	IL36_disp, d				; compteur boucle LOOP__2
