; CODE CONVERSION SOURCE DN_FIXED TARGET DN_FLOAT
	CVTIF
	LI	000536870912
	CVTIF
	FDIV
	CALL	STANDARD.TEST_CALENDAR_L1.DUR_IO. ,PUT_L11
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	1
	DUP
	Ld	0, STANDARD.TEXT_IO._POSITIVE_COUNT.FST
