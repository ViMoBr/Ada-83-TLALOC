	CALL	STANDARD.CALENDAR. ,TIME_OF_L7
	Sq  1,	T_disp
	LVA  1,	S_disp
	LVA  1,	D_disp
	LVA  1,	M_disp
	LVA  1,	Y_disp
	Lq 1,	T_disp
	CALL	STANDARD.CALENDAR. ,SPLIT_L6
	CALL	STANDARD.TEST_CALENDAR_L1. ,AFFICHE_DATE_L14
STR STR_L21, "----- SELECTORS -----"		; constante string="----- SELECTORS -----"
