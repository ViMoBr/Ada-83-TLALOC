if ~ definite TEXT_IO
include 'TEXT_IO.FINC'
end if
PRO	MINI_SC_L1				;---------- PRO MINI_SC
ELB 1					;    BODY ELAB
INT_IO = 'INT_IO'
namespace INT_IO				;---------- GENERIC PACKAGE INSTANTIATION
elab_spec:				;    SPEC ELAB

BRA post_LD_NUM
LD_NUM.elab:
	Ld -1, 0
	RTD 0
post_LD_NUM:
BRA post_ST_NUM
ST_NUM.elab:
	Sd -1, 0
	RTD 0
post_ST_NUM:
BRA post_INADR_NUM
INADR_NUM.elab:
	RTD 0
post_INADR_NUM:
BRA post_OUTADR_NUM
OUTADR_NUM.elab:
	La
	RTD 0
post_OUTADR_NUM:
VAR NUM__outadr_ofs, q
	LCA OUTADR_NUM.elab
	Sa	 1, NUM__outadr_ofs
VAR NUM__inadr_ofs, q
	LCA INADR_NUM.elab
	Sa	 1, NUM__inadr_ofs
VAR NUM__st_ofs, q
	LCA ST_NUM.elab
	Sa	 1, NUM__st_ofs
VAR NUM__ld_ofs, q
	LCA LD_NUM.elab
	Sa	 1, NUM__ld_ofs
VAR NUM__u_ofs, q
	La	 0, STANDARD._INTEGER.use__info
	Sa	 1, NUM__u_ofs
VAR GFP_disp, q				; Lieu du Generic Frame Pointer 
					; CODE_PACKAGE_SPEC
VAR DEFAULT_WIDTH_disp, d			; variable entiere
	LI	 11
	Sd  1,	DEFAULT_WIDTH_disp

VAR DEFAULT_BASE_disp, d			; variable entiere
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	10
	Sd  1,	DEFAULT_BASE_disp

					; sub program entry decl (in instantiation TRUE )
if defined GET_L2_
PRO	GET_L2				;---------- PRO GET
PRMS					;    debut parametrage
	PRM FILE_ofs				; in
	PRM ITEM_ofs				; out
	PRM WIDTH_ofs				; in
endPRMS					;    fin parametrage
ELB 2
begin:
	LVA	 1, GFP_disp
	Ld	 2, -WIDTH_ofs
	La 	 2, -ITEM_ofs
	La 	 2, -FILE_ofs
	CALL	STANDARD.TEXT_IO.INTEGER_IO. ,GET_L61
	UNLINK	 2
	RTD	prm_siz
endPRO					;---------- end PRO GET
end if
					; sub program entry decl (in instantiation TRUE )
if defined GET_L3_
PRO	GET_L3				;---------- PRO GET
PRMS					;    debut parametrage
	PRM ITEM_ofs				; out
	PRM WIDTH_ofs				; in
endPRMS					;    fin parametrage
ELB 2
begin:
	LVA	 1, GFP_disp
	Ld	 2, -WIDTH_ofs
	La 	 2, -ITEM_ofs
	CALL	STANDARD.TEXT_IO.INTEGER_IO. ,GET_L62
	UNLINK	 2
	RTD	prm_siz
endPRO					;---------- end PRO GET
end if
					; sub program entry decl (in instantiation TRUE )
if defined PUT_L4_
PRO	PUT_L4				;---------- PRO PUT
PRMS					;    debut parametrage
	PRM FILE_ofs				; in
	PRM ITEM_ofs				; in
	PRM WIDTH_ofs				; in
	PRM BASE_ofs				; in
endPRMS					;    fin parametrage
ELB 2
begin:
	LVA	 1, GFP_disp
	Ld	 2, -BASE_ofs
	Ld	 2, -WIDTH_ofs
	Ld	 2, -ITEM_ofs
	La 	 2, -FILE_ofs
	CALL	STANDARD.TEXT_IO.INTEGER_IO. ,PUT_L63
	UNLINK	 2
	RTD	prm_siz
endPRO					;---------- end PRO PUT
end if
					; sub program entry decl (in instantiation TRUE )
if defined PUT_L5_
PRO	PUT_L5				;---------- PRO PUT
PRMS					;    debut parametrage
	PRM ITEM_ofs				; in
	PRM WIDTH_ofs				; in
	PRM BASE_ofs				; in
endPRMS					;    fin parametrage
ELB 2
begin:
	LVA	 1, GFP_disp
	Ld	 2, -BASE_ofs
	Ld	 2, -WIDTH_ofs
	Ld	 2, -ITEM_ofs
	CALL	STANDARD.TEXT_IO.INTEGER_IO. ,PUT_L64
	UNLINK	 2
	RTD	prm_siz
endPRO					;---------- end PRO PUT
end if
					; sub program entry decl (in instantiation TRUE )
if defined GET_L6_
PRO	GET_L6				;---------- PRO GET
PRMS					;    debut parametrage
	PRM FROM_ofs				; in
	PRM ITEM_ofs				; out
	PRM LAST_ofs				; out
endPRMS					;    fin parametrage
ELB 2
begin:
	LVA	 1, GFP_disp
	La 	 2, -LAST_ofs
	La 	 2, -ITEM_ofs
	La 	 2, -FROM_ofs
	CALL	STANDARD.TEXT_IO.INTEGER_IO. ,GET_L65
	UNLINK	 2
	RTD	prm_siz
endPRO					;---------- end PRO GET
end if
					; sub program entry decl (in instantiation TRUE )
if defined PUT_L7_
PRO	PUT_L7				;---------- PRO PUT
PRMS					;    debut parametrage
	PRM TO_ofs				; out
	PRM ITEM_ofs				; in
	PRM BASE_ofs				; in
endPRMS					;    fin parametrage
ELB 2
begin:
	LVA	 1, GFP_disp
	Ld	 2, -BASE_ofs
	Ld	 2, -ITEM_ofs
	La 	 2, -TO_ofs
	CALL	STANDARD.TEXT_IO.INTEGER_IO. ,PUT_L66
	UNLINK	 2
	RTD	prm_siz
endPRO					;---------- end PRO PUT
end if
					;---------- end generic package instantiation INT_IO
end namespace

VAR NB_OK_disp, d				; variable entiere
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	0
	Sd  1,	NB_OK_disp

VAR NB_ECHECS_disp, d			; variable entiere
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	0
	Sd  1,	NB_ECHECS_disp

VAR SC_disp, q				; variable array : pointeur aux data
VAR SC__u, q				; variable array : useinfo pointeur au rec info
	La 0, STANDARD._STRING.use__info
	Sa	1, SC__u				; array info ptr at __u
STR SC, "abcdef"				; constante string="abcdef"
	LCA	SC.data_ptr
	La
	Sa	1, SC_disp				; array data ptr at _disp
	LCA	SC.info_ptr
	La
	Sa	1, SC__u				; array info ptr at __u


if defined CHECK_L8_
PRO	CHECK_L8				;---------- PRO CHECK
PRMS					;    debut parametrage
	PRM OK_ofs				; in
	PRM SECTION_ofs				; in
	PRM NUMERO_ofs				; in
endPRMS					;    fin parametrage
ELB 2					;    BODY ELAB
					;    end elab
begin:					;---------- BDY INSTRUCTIONS
					; debut if
	Lb  2,	-OK_ofs
	BF	L10
	Ld 1,	STANDARD.MINI_SC_L1.NB_OK_disp
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	1
	ADD
	Sd  1,	NB_OK_disp
	BRA	L9
L10:
	Ld 1,	STANDARD.MINI_SC_L1.NB_ECHECS_disp
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	1
	ADD
	Sd  1,	NB_ECHECS_disp
STR STR_L11, "* ECHEC section "		; constante string="* ECHEC section "
	LCA	STR_L11.data_ptr
	CALL	STANDARD.TEXT_IO. ,PUT_L56
	Ld 1,	STANDARD.MINI_SC_L1.INT_IO.DEFAULT_BASE_disp
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	1
	Ld  2,	-SECTION_ofs
	CALL	STANDARD.MINI_SC_L1.INT_IO. ,PUT_L5
STR STR_L12, " test "			; constante string=" test "
	LCA	STR_L12.data_ptr
	CALL	STANDARD.TEXT_IO. ,PUT_L56
	Ld 1,	STANDARD.MINI_SC_L1.INT_IO.DEFAULT_BASE_disp
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	1
	Ld  2,	-NUMERO_ofs
	CALL	STANDARD.MINI_SC_L1.INT_IO. ,PUT_L5
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	1
	CALL	STANDARD.TEXT_IO. ,NEW_LINE_L26
L9:					; post if
ret_lbl:
	UNLINK 2
	RTD	prm_siz
excep:
endPRO					;---------- end PRO CHECK
end if
					;    end elab
begin:					;---------- BDY INSTRUCTIONS
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	1
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	4
	LId	1, STANDARD.MINI_SC_L1.SC__u, STANDARD._STRING.FST_1
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	1
	CEQ
	CALL	STANDARD.MINI_SC_L1. ,CHECK_L8
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	2
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	4
	LId	1, STANDARD.MINI_SC_L1.SC__u, STANDARD._STRING.LST_1
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	6
	CEQ
	CALL	STANDARD.MINI_SC_L1. ,CHECK_L8
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	3
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	4
	La	 1, SC_disp				; array data start address on stack
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	1
	LId	1, SC__u, STANDARD._STRING.FST_1		; (index - FST_1) * SIZ_1
	SUB
	LId	1, SC__u, STANDARD._STRING.COMP_SIZ
	LI	8
	DIV
	MUL
	ADD					; add offset to start address
	Lb
	LI	97
	CEQ
	CALL	STANDARD.MINI_SC_L1. ,CHECK_L8
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	4
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	4
	La	 1, SC_disp				; array data start address on stack
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	6
	LId	1, SC__u, STANDARD._STRING.FST_1		; (index - FST_1) * SIZ_1
	SUB
	LId	1, SC__u, STANDARD._STRING.COMP_SIZ
	LI	8
	DIV
	MUL
	ADD					; add offset to start address
	Lb
	LI	102
	CEQ
	CALL	STANDARD.MINI_SC_L1. ,CHECK_L8
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	5
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	4
; CODE composite "=" _STRING
VAR	ANON_35_10_L13_G_data, q
VAR	ANON_35_10_L13_G_info, q
VAR	ANON_35_10_L13_G_len,  q
	LVA 1,	SC_disp
	DUP
	La  ,  0
	Sa  1, ANON_35_10_L13_G_data
	La  ,  8
	Sa  1, ANON_35_10_L13_G_info
	LId 1, ANON_35_10_L13_G_info, _STRING.LST_1
	LId 1, ANON_35_10_L13_G_info, _STRING.FST_1
	SUB
	INC
	CLAMP0
	Sa  1, ANON_35_10_L13_G_len
VAR	ANON_35_15_L13_D_data, q
VAR	ANON_35_15_L13_D_info, q
VAR	ANON_35_15_L13_D_len,  q
STR ANON_35_15_L13_D, "abcdef"		; constante string="abcdef"
	LCA	ANON_35_15_L13_D.data_ptr
	DUP
	La  ,  0
	Sa  1, ANON_35_15_L13_D_data
	La  ,  8
	Sa  1, ANON_35_15_L13_D_info
	LId 1, ANON_35_15_L13_D_info, _STRING.LST_1
	LId 1, ANON_35_15_L13_D_info, _STRING.FST_1
	SUB
	INC
	CLAMP0
	Sa  1, ANON_35_15_L13_D_len
	La  1, ANON_35_10_L13_G_len
	La  1, ANON_35_15_L13_D_len
	CEQ
	DUP
	BF	L14
	DROP
	La  1, ANON_35_10_L13_G_data
	La  1, ANON_35_10_L13_G_len
	La  1, ANON_35_15_L13_D_data
	BLKCMP
L14:
	CALL	STANDARD.MINI_SC_L1. ,CHECK_L8
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	1
	CALL	STANDARD.TEXT_IO. ,NEW_LINE_L26
STR STR_L15, "RESULTAT :  "			; constante string="RESULTAT :  "
	LCA	STR_L15.data_ptr
	CALL	STANDARD.TEXT_IO. ,PUT_L56
	Ld 1,	STANDARD.MINI_SC_L1.INT_IO.DEFAULT_BASE_disp
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	1
	Ld 1,	NB_OK_disp
	CALL	STANDARD.MINI_SC_L1.INT_IO. ,PUT_L5
STR STR_L16, " OK,   "			; constante string=" OK,   "
	LCA	STR_L16.data_ptr
	CALL	STANDARD.TEXT_IO. ,PUT_L56
	Ld 1,	STANDARD.MINI_SC_L1.INT_IO.DEFAULT_BASE_disp
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	1
	Ld 1,	NB_ECHECS_disp
	CALL	STANDARD.MINI_SC_L1.INT_IO. ,PUT_L5
STR STR_L17, " ECHECS"			; constante string=" ECHECS"
	LCA	STR_L17.data_ptr
	CALL	STANDARD.TEXT_IO. ,PUT_LINE_L60
					; debut if
	Ld 1,	NB_ECHECS_disp
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	0
	CEQ
	BF	L19
STR STR_L20, "SC PASSE"			; constante string="SC PASSE"
	LCA	STR_L20.data_ptr
	CALL	STANDARD.TEXT_IO. ,PUT_LINE_L60
	BRA	L18
L19:
STR STR_L21, "SC ECHOUE"			; constante string="SC ECHOUE"
	LCA	STR_L21.data_ptr
	CALL	STANDARD.TEXT_IO. ,PUT_LINE_L60
L18:					; post if
ret_lbl:
	UNLINK 1
	RTD
excep:
endPRO					;---------- end PRO MINI_SC
