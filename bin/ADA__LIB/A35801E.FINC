USEINFO 2, B, 	La 0, STANDARD._INTEGER.use__info
USEINFO 2, X, 	La 0, STANDARD._INTEGER.use__info
USEINFO 2, Y, 	La 0, STANDARD._BOOLEAN.use__info
virtual at 0				; calcul des offsets statiques
STATOFS B, 4
STATOFS X, 4
STATOFS Y, 1
size = $
end virtual
	LI	 size*8
	Sd	2, SIZ
end namespace

