INADR_LONG_FLOAT.elab:
	RTD 0
post_INADR_LONG_FLOAT:
BRA post_OUTADR_LONG_FLOAT
OUTADR_LONG_FLOAT.elab:
	La
	RTD 0
post_OUTADR_LONG_FLOAT:
VAR LONG_FLOAT__outadr_ofs, q
	LCA OUTADR_LONG_FLOAT.elab
	Sa	 1, LONG_FLOAT__outadr_ofs
VAR LONG_FLOAT__inadr_ofs, q
	LCA INADR_LONG_FLOAT.elab
	Sa	 1, LONG_FLOAT__inadr_ofs
VAR LONG_FLOAT__st_ofs, q
	LCA ST_LONG_FLOAT.elab
	Sa	 1, LONG_FLOAT__st_ofs
VAR LONG_FLOAT__ld_ofs, q
	LCA LD_LONG_FLOAT.elab
	Sa	 1, LONG_FLOAT__ld_ofs
VAR LONG_FLOAT__u_ofs, q
	La	 0, STANDARD.LONG_FLOAT.use__info
	Sa	 1, LONG_FLOAT__u_ofs
VAR GFP_disp, q				; Lieu du Generic Frame Pointer 
VAR DEFAULT_FORE_disp, d			; variable entiere
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	2
	Sd  1,	DEFAULT_FORE_disp

VAR DEFAULT_AFT_disp, d			; variable entiere
	LI	15
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	1
	SUB
	Sd  1,	DEFAULT_AFT_disp

VAR DEFAULT_EXP_disp, d			; variable entiere
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	3
	Sd  1,	DEFAULT_EXP_disp

if defined GET_L8_
PRO	GET_L8				;---------- PRO GET
PRMS					;    debut parametrage
	PRM FILE_ofs				; in
	PRM ITEM_ofs				; out
	PRM WIDTH_ofs				; in
endPRMS					;    fin parametrage
ELB 2
