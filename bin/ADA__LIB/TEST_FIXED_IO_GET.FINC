	RTD	prm_siz
endPRO					;---------- end PRO GET
end if
if defined PUT_L7_
PRO	PUT_L7				;---------- PRO PUT
PRMS					;    debut parametrage
	PRM TO_ofs				; out
	PRM ITEM_ofs				; in
	PRM AFT_ofs				; in
	PRM EXP_ofs				; in
endPRMS					;    fin parametrage
ELB 2
begin:
	LVA	 1, GFP_disp
	Ld	 2, -EXP_ofs
	Ld	 2, -AFT_ofs
	Lq	 2, -ITEM_ofs
	La 	 2, -TO_ofs
	CALL	STANDARD.TEXT_IO.FIXED_IO. ,PUT_L78
	UNLINK	 2
	RTD	prm_siz
endPRO					;---------- end PRO PUT
end if
					;---------- end generic package instantiation DUR_IO
end namespace

FLT_IO = 'FLT_IO'
namespace FLT_IO				;---------- GENERIC PACKAGE INSTANTIATION
elab_spec:				;    SPEC ELAB

BRA post_LD_LONG_FLOAT
LD_LONG_FLOAT.elab:
	Lq -1, 0
	RTD 0
post_LD_LONG_FLOAT:
BRA post_ST_LONG_FLOAT
ST_LONG_FLOAT.elab:
	Sq -1, 0
	RTD 0
