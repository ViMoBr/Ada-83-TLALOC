VAR D_disp, q				; variable fixed

					;    end elab
begin:					;---------- BDY INSTRUCTIONS
STR STR_L14, "Entrer 12.75 :"			; constante string="Entrer 12.75 :"
	LCA	STR_L14.data_ptr
	CALL	STANDARD.TEXT_IO. ,PUT_LINE_L60
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	0
	LVA  1,	D_disp
	CALL	STANDARD.TEST_FIXED_IO_GET_L1.DUR_IO. ,GET_L3
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	2
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	6
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	1
	Lq 1,	D_disp
; CODE CONVERSION SOURCE DN_FIXED TARGET DN_FLOAT
	CVTIF
	LI	000536870912
	CVTIF
	FDIV
	CALL	STANDARD.TEST_FIXED_IO_GET_L1.FLT_IO. ,PUT_L11
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	1
	CALL	STANDARD.TEXT_IO. ,NEW_LINE_L26
ret_lbl:
	UNLINK 1
	RTD
excep:
endPRO					;---------- end PRO TEST_FIXED_IO_GET
