if ~ definite TEXT_IO
include 'TEXT_IO.FINC'
end if
PRO	BUG2_AGGREGATE_L1			;---------- PRO BUG2_AGGREGATE
ELB 1					;    BODY ELAB
INT_IO = 'INT_IO'
namespace INT_IO				;---------- GENERIC PACKAGE INSTANTIATION
elab_spec:				;    SPEC ELAB

BRA post_LD_INTEGER
LD_INTEGER.elab:
	Ld -1, 0
	RTD 0
post_LD_INTEGER:
BRA post_ST_INTEGER
ST_INTEGER.elab:
	Sd -1, 0
	RTD 0
post_ST_INTEGER:
BRA post_INADR_INTEGER
INADR_INTEGER.elab:
	RTD 0
post_INADR_INTEGER:
BRA post_OUTADR_INTEGER
OUTADR_INTEGER.elab:
	La
	RTD 0
post_OUTADR_INTEGER:
VAR INTEGER__outadr_ofs, q
	LCA OUTADR_INTEGER.elab
	Sa	 1, INTEGER__outadr_ofs
VAR INTEGER__inadr_ofs, q
	LCA INADR_INTEGER.elab
	Sa	 1, INTEGER__inadr_ofs
VAR INTEGER__st_ofs, q
	LCA ST_INTEGER.elab
	Sa	 1, INTEGER__st_ofs
VAR INTEGER__ld_ofs, q
	LCA LD_INTEGER.elab
	Sa	 1, INTEGER__ld_ofs
VAR INTEGER__u_ofs, q
	La	 0, STANDARD.INTEGER.use__info
	Sa	 1, INTEGER__u_ofs
VAR GFP_disp, q				; Lieu du Generic Frame Pointer 
VAR DEFAULT_WIDTH_disp, d			; variable entiere
	LI	 11
	Sd  1,	DEFAULT_WIDTH_disp

VAR DEFAULT_BASE_disp, d			; variable entiere
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	10
	Sd  1,	DEFAULT_BASE_disp

if defined GET_L2_
PRO	GET_L2				;---------- PRO GET
PRMS					;    debut parametrage
	PRM FILE_ofs				; in
	PRM ITEM_ofs				; out
	PRM WIDTH_ofs				; in
endPRMS					;    fin parametrage
ELB 2
begin:
	LVA	 1, GFP_disp
	Ld	 2, -WIDTH_ofs
	La 	 2, -ITEM_ofs
	La 	 2, -FILE_ofs
	CALL	STANDARD.TEXT_IO.INTEGER_IO. ,GET_L61
	UNLINK	 2
	RTD	prm_siz
endPRO					;---------- end PRO GET
end if
if defined GET_L3_
PRO	GET_L3				;---------- PRO GET
PRMS					;    debut parametrage
	PRM ITEM_ofs				; out
	PRM WIDTH_ofs				; in
endPRMS					;    fin parametrage
ELB 2
begin:
	LVA	 1, GFP_disp
	Ld	 2, -WIDTH_ofs
	La 	 2, -ITEM_ofs
	CALL	STANDARD.TEXT_IO.INTEGER_IO. ,GET_L62
	UNLINK	 2
	RTD	prm_siz
endPRO					;---------- end PRO GET
end if
if defined PUT_L4_
PRO	PUT_L4				;---------- PRO PUT
PRMS					;    debut parametrage
	PRM FILE_ofs				; in
	PRM ITEM_ofs				; in
	PRM WIDTH_ofs				; in
	PRM BASE_ofs				; in
endPRMS					;    fin parametrage
ELB 2
begin:
	LVA	 1, GFP_disp
	Ld	 2, -BASE_ofs
	Ld	 2, -WIDTH_ofs
	Ld	 2, -ITEM_ofs
	La 	 2, -FILE_ofs
	CALL	STANDARD.TEXT_IO.INTEGER_IO. ,PUT_L63
	UNLINK	 2
	RTD	prm_siz
endPRO					;---------- end PRO PUT
end if
if defined PUT_L5_
PRO	PUT_L5				;---------- PRO PUT
PRMS					;    debut parametrage
	PRM ITEM_ofs				; in
	PRM WIDTH_ofs				; in
	PRM BASE_ofs				; in
endPRMS					;    fin parametrage
ELB 2
begin:
	LVA	 1, GFP_disp
	Ld	 2, -BASE_ofs
	Ld	 2, -WIDTH_ofs
	Ld	 2, -ITEM_ofs
	CALL	STANDARD.TEXT_IO.INTEGER_IO. ,PUT_L64
	UNLINK	 2
	RTD	prm_siz
endPRO					;---------- end PRO PUT
end if
if defined GET_L6_
PRO	GET_L6				;---------- PRO GET
PRMS					;    debut parametrage
	PRM FROM_ofs				; in
	PRM ITEM_ofs				; out
	PRM LAST_ofs				; out
endPRMS					;    fin parametrage
ELB 2
begin:
	LVA	 1, GFP_disp
	La 	 2, -LAST_ofs
	La 	 2, -ITEM_ofs
	La 	 2, -FROM_ofs
	CALL	STANDARD.TEXT_IO.INTEGER_IO. ,GET_L65
	UNLINK	 2
	RTD	prm_siz
endPRO					;---------- end PRO GET
end if
if defined PUT_L7_
PRO	PUT_L7				;---------- PRO PUT
PRMS					;    debut parametrage
	PRM TO_ofs				; out
	PRM ITEM_ofs				; in
	PRM BASE_ofs				; in
endPRMS					;    fin parametrage
ELB 2
begin:
	LVA	 1, GFP_disp
	Ld	 2, -BASE_ofs
	Ld	 2, -ITEM_ofs
	La 	 2, -TO_ofs
	CALL	STANDARD.TEXT_IO.INTEGER_IO. ,PUT_L66
	UNLINK	 2
	RTD	prm_siz
endPRO					;---------- end PRO PUT
end if
					;---------- end generic package instantiation INT_IO
end namespace


					; array decl constrained array type info
VECTEUR = 'VECTEUR'
namespace VECTEUR
VAR use__info, q
VAR SIZ, d
	LVA	1, SIZ
	Sa	1, use__info
VAR _COMP_SIZ, d
VAR _FST_1, d
VAR _LST_1, d
	LI	32
	Sd	1, _COMP_SIZ
	Ld	1, _COMP_SIZ
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	1
	Sd	1, _FST_1
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	4
	Sd	1, _LST_1
	Ld	1, _LST_1
	INC
	Ld	1, _FST_1
	SUB
	MUL
	Sd	1, SIZ
  virtual at 4
COMP_SIZ = $
	rd 1 
FST_1 = $
	rd 1 
LST_1 = $
	rd 1 
  end virtual
end namespace

					; REC_V RECORD TYPE INFO
REC_V = 'REC_V'
namespace REC_V
VAR use__info, q
VAR SIZ, d
	LVA	1, SIZ
	Sa	1, use__info
USEINFO 1, V, 	La 1, STANDARD.BUG2_AGGREGATE_L1.VECTEUR.use__info
virtual at 0				; calcul des offsets statiques
STATOFS V, 16
size = $
end virtual
	LI	 size*8
	Sd	1, SIZ
end namespace
VAR RV_disp, q				; variable record : pointeur aux data record
VAR RV__u, q				; variable record : pointeur aux useinfo
VAR RV__dat, STANDARD.BUG2_AGGREGATE_L1.REC_V.size
	LVA	1, RV__dat
	Sa	1, RV_disp				; record fin
	LVA	1, STANDARD.BUG2_AGGREGATE_L1.REC_V.SIZ
	Sa	1, RV__u
; CODE_VC_NAME DN_VARIABLE_ID
	La 1, RV_disp
					; Assign_record_aggregate type DN_RECORD
	DUP
	LVA	, STANDARD.BUG2_AGGREGATE_L1.REC_V.V
					; Assign_array_aggregate dynamic type DN_CONSTRAINED_ARRAY
namespace ANON_16_26_aga
  VAR FST_1,  d
  VAR LST_1,  d
  VAR LEN_1,  d
  VAR STR_1,  d
  VAR PTR_1,  q
  VAR CNT_1,  d
  VAR EMIS_1, d
end namespace
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	1
	Sd  1, ANON_16_26_aga.FST_1
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	4
	Sd  1, ANON_16_26_aga.LST_1
	Ld  1, ANON_16_26_aga.LST_1
	Ld  1, ANON_16_26_aga.FST_1
	SUB
	INC
	Sd  1, ANON_16_26_aga.LEN_1
	LI	4
	Sd  1, ANON_16_26_aga.STR_1
	Sa  1, ANON_16_26_aga.PTR_1
	LI	0
	Sd  1, ANON_16_26_aga.EMIS_1
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	11
	SId  1, ANON_16_26_aga.PTR_1, 0
	La  1, ANON_16_26_aga.PTR_1
	Ld  1, ANON_16_26_aga.STR_1
	ADD
	Sa  1, ANON_16_26_aga.PTR_1
	Ld  1, ANON_16_26_aga.EMIS_1
	INC
	Sd  1, ANON_16_26_aga.EMIS_1
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	22
	SId  1, ANON_16_26_aga.PTR_1, 0
