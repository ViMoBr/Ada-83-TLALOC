	La  1, ANON_16_26_aga.PTR_1
	Ld  1, ANON_16_26_aga.STR_1
	ADD
	Sa  1, ANON_16_26_aga.PTR_1
	Ld  1, ANON_16_26_aga.EMIS_1
	INC
	Sd  1, ANON_16_26_aga.EMIS_1
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	44
	SId  1, ANON_16_26_aga.PTR_1, 0
	La  1, ANON_16_26_aga.PTR_1
	Ld  1, ANON_16_26_aga.STR_1
	ADD
	Sa  1, ANON_16_26_aga.PTR_1
	Ld  1, ANON_16_26_aga.EMIS_1
	INC
	Sd  1, ANON_16_26_aga.EMIS_1
	DROP

					;    end elab
begin:					;---------- BDY INSTRUCTIONS
STR STR_L8, "RV.V(1)"			; constante string="RV.V(1)"
	LCA	STR_L8.data_ptr
	CALL	STANDARD.TEXT_IO. ,PUT_L56
	Ld 1,	STANDARD.BUG2_AGGREGATE_L1.INT_IO.DEFAULT_BASE_disp
	Ld 1,	STANDARD.BUG2_AGGREGATE_L1.INT_IO.DEFAULT_WIDTH_disp
	LIVA 	1, RV_disp, STANDARD.BUG2_AGGREGATE_L1.REC_V.V
; EXPRESSIONS.CODE_INDEXED adresse component id
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	1
	Ld	 1, STANDARD.BUG2_AGGREGATE_L1.VECTEUR._FST_1	; (index - FST_1) * SIZ_1
	SUB
	Ld	 1, STANDARD.BUG2_AGGREGATE_L1.VECTEUR._COMP_SIZ
	LI	8
	DIV
	MUL
