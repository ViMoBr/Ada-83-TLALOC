	Ld  1, ANON_16_26_aga.STR_1
	ADD
	Sa  1, ANON_16_26_aga.PTR_1
	Ld  1, ANON_16_26_aga.EMIS_1
	INC
	Sd  1, ANON_16_26_aga.EMIS_1
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	33
