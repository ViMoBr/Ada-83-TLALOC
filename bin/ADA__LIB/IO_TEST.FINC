if ~ definite TEXT_IO
include 'TEXT_IO.FINC'
end if
PRO	IO_TEST_L1				;---------- PRO IO_TEST
ELB 1					;    BODY ELAB
VAR E_disp, q				; variable record : pointeur aux data record
VAR E__u, q				; variable record : pointeur aux useinfo
VAR E__dat, STANDARD.TEXT_IO.FILE_TYPE.size
	LVA	1, E__dat
	Sa	1, E_disp				; record fin
	LVA	1, STANDARD.TEXT_IO.FILE_TYPE.SIZ
	Sa	1, E__u
	LIVa 1, E_disp, STANDARD.TEXT_IO.FILE_TYPE.ID
	LI	1
	NEG
	Sd
	LIVa 1, E_disp, STANDARD.TEXT_IO.FILE_TYPE.IS_OPENED
	LI	0
	Sb
	LIVa 1, E_disp, STANDARD.TEXT_IO.FILE_TYPE.IS_DEFAULT_IO
	LI	0
	Sb
	LIVa 1, E_disp, STANDARD.TEXT_IO.FILE_TYPE.LOOK_AHEAD
	LI	 0
	Sb
	LIVa 1, E_disp, STANDARD.TEXT_IO.FILE_TYPE.HAS_LOOK_AHEAD
	LI	0
	Sb
	LIVa 1, E_disp, STANDARD.TEXT_IO.FILE_TYPE.AT_END_OF_FILE
	LI	0
	Sb

VAR F_disp, q				; variable record : pointeur aux data record
VAR F__u, q				; variable record : pointeur aux useinfo
VAR F__dat, STANDARD.TEXT_IO.FILE_TYPE.size
	LVA	1, F__dat
	Sa	1, F_disp				; record fin
	LVA	1, STANDARD.TEXT_IO.FILE_TYPE.SIZ
	Sa	1, F__u
	LIVa 1, F_disp, STANDARD.TEXT_IO.FILE_TYPE.ID
	LI	1
	NEG
	Sd
	LIVa 1, F_disp, STANDARD.TEXT_IO.FILE_TYPE.IS_OPENED
	LI	0
	Sb
	LIVa 1, F_disp, STANDARD.TEXT_IO.FILE_TYPE.IS_DEFAULT_IO
	LI	0
	Sb
	LIVa 1, F_disp, STANDARD.TEXT_IO.FILE_TYPE.LOOK_AHEAD
	LI	 0
	Sb
	LIVa 1, F_disp, STANDARD.TEXT_IO.FILE_TYPE.HAS_LOOK_AHEAD
	LI	0
	Sb
	LIVa 1, F_disp, STANDARD.TEXT_IO.FILE_TYPE.AT_END_OF_FILE
	LI	0
	Sb

VAR G_disp, q				; variable record : pointeur aux data record
VAR G__u, q				; variable record : pointeur aux useinfo
VAR G__dat, STANDARD.TEXT_IO.FILE_TYPE.size
	LVA	1, G__dat
	Sa	1, G_disp				; record fin
	LVA	1, STANDARD.TEXT_IO.FILE_TYPE.SIZ
	Sa	1, G__u
	LIVa 1, G_disp, STANDARD.TEXT_IO.FILE_TYPE.ID
