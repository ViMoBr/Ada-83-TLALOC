VAR GFP_disp, q				; Lieu du Generic Frame Pointer 
PRO	SSET_L13				;---------- PRO SSET
PRMS					;    debut parametrage
	PRM X_ofs				; in out
	PRM SRC_ofs				; in out
endPRMS					;    fin parametrage
ELB 2
begin:
	LVA	 1, GFP_disp
	La 	 2, -SRC_ofs
	La 	 2, -X_ofs
	CALL	STANDARD.CHK_TEST1_L1. ,GSET_L10
	UNLINK	 2
	RTD	prm_siz
endPRO					;---------- end PRO SSET
end if
