PRO	CHK_TEST1_L1				;---------- PRO CHK_TEST1
ELB 1					;    BODY ELAB

					; _SMALL INTEGER SUBTYPE INFO
_SMALL = '_SMALL'
namespace _SMALL
VAR use__info, q
VAR SIZ, d
	LVA	1, SIZ
	Sa	1, use__info
VAR FST, d
VAR LST, d
	LI	32
	Sd	1, SIZ
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	1
	Sd	1, FST
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	10
	Sd	1, LST
VAR PARENT__u, q
	La	0, STANDARD._INTEGER.use__info
	Sa	1, PARENT__u
end namespace
VAR S_disp, d				; variable entiere
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	5
	DUP
	Ld	1, _SMALL.FST
	CLT
	BT	STANDARD.ce_raise_
	DUP
	Ld	1, _SMALL.LST
	CGT
	BT	STANDARD.ce_raise_
	Sd  1,	S_disp

VAR B_disp, d				; variable entiere
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	7
	Sd  1,	B_disp

VAR R_disp, d				; variable entiere
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	0
	Sd  1,	R_disp

VAR N_disp, d				; variable entiere
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	20
	Sd  1,	N_disp


if defined CLIP_L2_
PRO	CLIP_L2				;---------- PRO CLIP
PRMS					;    debut parametrage
	PRM P_ofs				; in
	PRM result__ofs				; resultat de fonction
endPRMS					;    fin parametrage
ELB 2					;    BODY ELAB
					;    end elab
begin:					;---------- BDY INSTRUCTIONS
; CODE_RETURN : EXPR TYPE = DN_INTEGER
	Ld  2,	-P_ofs
	DUP
	Ld	1, STANDARD.CHK_TEST1_L1._SMALL.FST
	CLT
	BT	STANDARD.ce_raise_
	DUP
	Ld	1, STANDARD.CHK_TEST1_L1._SMALL.LST
	CGT
	BT	STANDARD.ce_raise_
	Sd  2,	-result__ofs
	BRA ret_lbl
ret_lbl:
	UNLINK 2
	RTD	prm_siz-8
excep:
endPRO					;---------- end PRO CLIP
end if

if defined GROW_L5_
