excep:
endPRO					;---------- end PRO GROW
end if
; GENERIC_SUBPROGRAM_SPEC

if defined GSET_L10_
PRO	GSET_L10				;---------- PRO GSET
virtual at 8
	ELEM__u_ofs = $
	rq 1
	ELEM__ld_ofs = $
	rq 1
	ELEM__st_ofs = $
	rq 1
	ELEM__inadr_ofs = $
	rq 1
	ELEM__outadr_ofs = $
	rq 1
end virtual
PRMS					;    debut parametrage
	PRM X_ofs				; in out
	PRM SRC_ofs				; in out
	PRM GFP_ofs
endPRMS					;    fin parametrage
ELB 2					;    BODY ELAB
					;    end elab
begin:					;---------- BDY INSTRUCTIONS
	LVA  2,	-X_ofs
	La
	LVA  2,	-SRC_ofs
	La 2,	-GFP_ofs
	La ,	-ELEM__outadr_ofs
	CALLI
	La  2,	-GFP_ofs
	La ,	-ELEM__ld_ofs
	CALLI
	La  2,	-GFP_ofs
	La ,	-ELEM__st_ofs
	CALLI
ret_lbl:
	UNLINK 2
	RTD	prm_siz
excep:
endPRO					;---------- end PRO GSET
end if
