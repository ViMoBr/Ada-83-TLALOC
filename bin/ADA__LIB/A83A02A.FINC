VAR	IL10_disp, d				; compteur boucle LOOP__3
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	1
	Sd  2,	IL10_disp
VAR	LMT_IL10_disp, d			; limite boucle LOOP__3
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	2
	Sd  2,	LMT_IL10_disp
	Ld  2,	IL10_disp				; test null range LOOP__3
	Ld  2,	LMT_IL10_disp
	CGT
	BT	L9
LOOP__3:					; corps boucle LOOP__3
	Ld  2,	IL10_disp				; test de sortie LOOP__3
	Ld  2,	LMT_IL10_disp
	CEQ
	BT	L9
	Ld  2,	IL10_disp				; mise a jour compteur LOOP__3
	INC
	Sd  2,	IL10_disp
	BRA	LOOP__3				; iteration suivante LOOP__3
L9:					; post loop LOOP__3
	UNLINK 2
endPRO
