TSIZ = 'TSIZ'
PRO	TSIZ_L1				;---------- PRO TSIZ
ELB 1					;    BODY ELAB

					; _U8 TYPE RANGE INFO
_U8 = '_U8'
namespace _U8
VAR use__info, q
VAR SIZ, d
	LVA	1, SIZ
	Sa	1, use__info
VAR FST, w
VAR LST, w
	LI	16
	Sd	1, SIZ
; CODE_NUMERIC_LITERAL DN_UNIVERSAL_INTEGER
	LI	0
	Sw	1, FST
; CODE_NUMERIC_LITERAL DN_UNIVERSAL_INTEGER
	LI	255
	Sw	1, LST
end namespace

					; _S8 TYPE RANGE INFO
_S8 = '_S8'
namespace _S8
VAR use__info, q
VAR SIZ, d
	LVA	1, SIZ
	Sa	1, use__info
VAR FST, w
VAR LST, w
	LI	16
	Sd	1, SIZ
; CODE_NUMERIC_LITERAL DN_UNIVERSAL_INTEGER
	LI	128
	NEG
	Sw	1, FST
; CODE_NUMERIC_LITERAL DN_UNIVERSAL_INTEGER
	LI	127
	Sw	1, LST
end namespace

					; _S16 TYPE RANGE INFO
_S16 = '_S16'
namespace _S16
VAR use__info, q
VAR SIZ, d
	LVA	1, SIZ
	Sa	1, use__info
VAR FST, w
VAR LST, w
	LI	16
	Sd	1, SIZ
; CODE_NUMERIC_LITERAL DN_UNIVERSAL_INTEGER
	LI	1000
	NEG
	Sw	1, FST
; CODE_NUMERIC_LITERAL DN_UNIVERSAL_INTEGER
	LI	1000
	Sw	1, LST
end namespace

					; _U16C TYPE RANGE INFO
_U16C = '_U16C'
namespace _U16C
VAR use__info, q
VAR SIZ, d
	LVA	1, SIZ
	Sa	1, use__info
VAR FST, w
VAR LST, w
	LI	16
	Sd	1, SIZ
; CODE_NUMERIC_LITERAL DN_UNIVERSAL_INTEGER
	LI	0
	Sw	1, FST
; CODE_NUMERIC_LITERAL DN_UNIVERSAL_INTEGER
	LI	255
	Sw	1, LST
end namespace

					; _S16C TYPE RANGE INFO
_S16C = '_S16C'
namespace _S16C
VAR use__info, q
VAR SIZ, d
	LVA	1, SIZ
	Sa	1, use__info
VAR FST, w
VAR LST, w
	LI	16
	Sd	1, SIZ
; CODE_NUMERIC_LITERAL DN_UNIVERSAL_INTEGER
	LI	100
	NEG
	Sw	1, FST
; CODE_NUMERIC_LITERAL DN_UNIVERSAL_INTEGER
	LI	100
	Sw	1, LST
end namespace

					; _U8C TYPE RANGE INFO
_U8C = '_U8C'
namespace _U8C
VAR use__info, q
VAR SIZ, d
	LVA	1, SIZ
	Sa	1, use__info
VAR FST, b
VAR LST, b
	LI	8
	Sd	1, SIZ
; CODE_NUMERIC_LITERAL DN_UNIVERSAL_INTEGER
	LI	0
	Sb	1, FST
; CODE_NUMERIC_LITERAL DN_UNIVERSAL_INTEGER
	LI	255
	Sb	1, LST
end namespace

					; _H INTEGER SUBTYPE INFO
_H = '_H'
namespace _H
VAR use__info, q
VAR SIZ, d
	LVA	1, SIZ
	Sa	1, use__info
VAR FST, w
VAR LST, w
	LI	16
	Sd	1, SIZ
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	0
	Sw	1, FST
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	15
	Sw	1, LST
VAR PARENT__u, q
	La	1, STANDARD.TSIZ_L1._U8.use__info
	Sa	1, PARENT__u
end namespace

					; _FEU ENUMERATION TYPE INFO
_FEU = '_FEU'
namespace _FEU
VAR use__info, q
BEGIN_BLOC_DEF
db 0, 4, "VERT"
db 1, 6, "ORANGE"
db 2, 5, "ROUGE"
END_BLOC_DEF 8, 0, 2
	; SIZ en bits !
	LCA	SIZ
	Sa	1, use__info
end namespace

					; array decl constrained array type info
_VEC = '_VEC'
namespace _VEC
VAR use__info, q
VAR SIZ, d
	LVA	1, SIZ
	Sa	1, use__info
VAR _COMP_SIZ, d
VAR _FST_1, d
VAR _LST_1, d
	LI	16
	Sd	1, _COMP_SIZ
	Ld	1, _COMP_SIZ
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	1
	Sd	1, _FST_1
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	5
	Sd	1, _LST_1
	Ld	1, _LST_1
	Ld	1, _FST_1
	SUB
	INC
	CLAMP0
	MUL
	Sd	1, SIZ
  virtual at 4
COMP_SIZ = $
	rd 1 
FST_1 = $
	rd 1 
LST_1 = $
	rd 1 
  end virtual
end namespace
VAR A_disp, w				; variable entiere
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	255
	Sw  1,	A_disp

VAR B_disp, w				; variable entiere
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	1
	NEG
	Sw  1,	B_disp

VAR C_disp, w				; variable entiere
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	0
	Sw  1,	C_disp

VAR D_disp, w				; variable entiere
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	255
	Sw  1,	D_disp

VAR E_disp, w				; variable entiere
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	100
	NEG
	Sw  1,	E_disp

VAR F_disp, b				; variable entiere

VAR G_disp, w				; variable entiere
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	12
	DUP
	ULw	1, _H.FST
	CLT
	BT	STANDARD.ce_raise_
	DUP
	ULw	1, _H.LST
	CGT
	BT	STANDARD.ce_raise_
	Sw  1,	G_disp

VAR FU_disp, b				; variable entiere
	LI	2
	Sb  1,	FU_disp

VAR V_disp, q				; variable array : pointeur aux data
VAR V__u, q				; variable array : useinfo pointeur au rec info
	La 1, STANDARD.TSIZ_L1._VEC.use__info
	Sa	1, V__u				; array info ptr at __u
	Ld	1, STANDARD.TSIZ_L1._VEC.SIZ
	LI	8
	DIV
	CO_VAR
	Sa	1, V_disp				; array data ptr at _disp

					;    end elab
begin:					;---------- BDY INSTRUCTIONS
	Lw 1,	B_disp
; CODE CONVERSION SOURCE DN_INTEGER TARGET DN_INTEGER
	Sw  1,	C_disp
	Lw 1,	C_disp
	ULw 1,	G_disp
; CODE CONVERSION SOURCE DN_INTEGER TARGET DN_INTEGER
	ADD
	Sw  1,	C_disp
	ULw 1,	A_disp
; CODE CONVERSION SOURCE DN_INTEGER TARGET DN_INTEGER
	Sb  1,	F_disp
	ULw 1,	D_disp
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	1
	SUB
	Sw  1,	D_disp
	Lw 1,	E_disp
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	1
	ADD
	Sw  1,	E_disp
	La	 1, STANDARD.TSIZ_L1.V_disp		; array data start address on stack
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	3
	DUP
	LId	1, STANDARD.TSIZ_L1.V__u, STANDARD.TSIZ_L1._VEC.FST_1
	CLT
	BT	STANDARD.ce_raise_
	DUP
	LId	1, STANDARD.TSIZ_L1.V__u, STANDARD.TSIZ_L1._VEC.LST_1
	CGT
	BT	STANDARD.ce_raise_
	LId	1, STANDARD.TSIZ_L1.V__u, STANDARD.TSIZ_L1._VEC.FST_1	; (index - FST_1) * SIZ_1
	SUB
	LId	1, STANDARD.TSIZ_L1.V__u, STANDARD.TSIZ_L1._VEC.COMP_SIZ
	LI	8
	DIV
	MUL
	ADD					; add offset to start address
	ULw 1,	D_disp
	Sw
	LI	1
	Sb  1,	FU_disp
ret_lbl:
	UNLINK 1
	RTD
excep:
endPRO					;---------- end PRO TSIZ
