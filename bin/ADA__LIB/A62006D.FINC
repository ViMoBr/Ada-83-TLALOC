A62006D = 'A62006D'
PRO	A62006D_L1				;---------- PRO A62006D
ELB 1					;    BODY ELAB
					;    end elab
begin:					;---------- BDY INSTRUCTIONS
; CODE & concat _STRING
VAR	ANON_20_23_L4_G_data, q
VAR	ANON_20_23_L4_G_info, q
VAR	ANON_21_12_L4_D_data, q
VAR	ANON_21_12_L4_D_info, q
VAR	ANON_20_23_L4_G_len,  q
VAR	ANON_21_12_L4_D_len,  q
VAR	ANON_20_23_L4_R_disp, q
VAR	ANON_20_23_L4_R__u,   q
namespace ANON_20_23_L4_R_info
  VAR SIZ,      d
  VAR _COMP_SIZ, d
  VAR _FST_1,    d
  VAR _LST_1,    d
end namespace
STR ANON_20_23_L4_G, "CHECK THAT ATTRIBUTES MAY BE APPLIED TO "	; constante string="CHECK THAT ATTRIBUTES MAY BE APPLIED TO "
	LCA	ANON_20_23_L4_G.data_ptr
	DUP
	La  ,  0
	Sa  1, ANON_20_23_L4_G_data
	La  ,  8
	Sa  1, ANON_20_23_L4_G_info
	LId 1, ANON_20_23_L4_G_info, _STRING.LST_1
	LId 1, ANON_20_23_L4_G_info, _STRING.FST_1
	SUB
	INC
	CLAMP0
	Sa  1, ANON_20_23_L4_G_len
STR ANON_21_12_L4_D, "NON-ACCESS FORMAL OUT PARAMETERS"	; constante string="NON-ACCESS FORMAL OUT PARAMETERS"
	LCA	ANON_21_12_L4_D.data_ptr
	DUP
	La  ,  0
	Sa  1, ANON_21_12_L4_D_data
	La  ,  8
	Sa  1, ANON_21_12_L4_D_info
	LId 1, ANON_21_12_L4_D_info, _STRING.LST_1
	LId 1, ANON_21_12_L4_D_info, _STRING.FST_1
	SUB
	INC
	CLAMP0
	Sa  1, ANON_21_12_L4_D_len
	La  1, ANON_20_23_L4_G_len
	La  1, ANON_21_12_L4_D_len
	ADD
	CO_VAR
	Sa  1, ANON_20_23_L4_R_disp
	LI	1
	Sd  1, ANON_20_23_L4_R_info._FST_1
	La  1, ANON_20_23_L4_G_len
	La  1, ANON_21_12_L4_D_len
	ADD
	Sd  1, ANON_20_23_L4_R_info._LST_1
	LI	8
	Sd  1, ANON_20_23_L4_R_info._COMP_SIZ
	La  1, ANON_20_23_L4_G_len
	La  1, ANON_21_12_L4_D_len
	ADD
	LI	8
	MUL
	Sd  1, ANON_20_23_L4_R_info.SIZ
	LVA 1, ANON_20_23_L4_R_info.SIZ
	Sa  1, ANON_20_23_L4_R__u
	La  1, ANON_20_23_L4_R_disp
	La  1, ANON_20_23_L4_G_len
	La  1, ANON_20_23_L4_G_data
	BLKMOV
	La  1, ANON_20_23_L4_R_disp
	La  1, ANON_20_23_L4_G_len
	ADD
	La  1, ANON_21_12_L4_D_len
	La  1, ANON_21_12_L4_D_data
	BLKMOV
	LVA 1, ANON_20_23_L4_R_disp
STR STR_L5, "A62006D"			; constante string="A62006D"
	LCA	STR_L5.data_ptr
	CALL	STANDARD.REPORT. ,TEST_L1
namespace	BLOCK__1
ELB 2					;    BODY ELAB

					; array decl constrained array type info
_ARR = '_ARR'
namespace _ARR
VAR use__info, q
VAR SIZ, d
	LVA	2, SIZ
	Sa	2, use__info
VAR _COMP_SIZ, d
VAR _FST_1, d
VAR _LST_1, d
	LI	8
	Sd	2, _COMP_SIZ
	Ld	2, _COMP_SIZ
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	1
	Sd	2, _FST_1
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	2
	Sd	2, _LST_1
	Ld	2, _LST_1
	Ld	2, _FST_1
	SUB
	INC
	CLAMP0
	MUL
	Sd	2, SIZ
  virtual at 4
COMP_SIZ = $
	rd 1 
FST_1 = $
	rd 1 
LST_1 = $
	rd 1 
  end virtual
end namespace

					; _REC RECORD TYPE INFO
_REC = '_REC'
namespace _REC
VAR use__info, q
VAR SIZ, d
	LVA	2, SIZ
	Sa	2, use__info
USEINFO 2, D, 	La 0, STANDARD._INTEGER.use__info
USEINFO 2, Y, 	La 0, STANDARD._BOOLEAN.use__info
USEINFO 2, X, 	La 2, STANDARD.A62006D_L1.BLOCK__1._ARR.use__info
virtual at 0				; calcul des offsets statiques
STATOFS D, 4, 4
STATOFS Y, 1, 1
STATOFS X, 2, 8
size = $
end virtual
	LI	 size*8
	Sd	2, SIZ
end namespace

if defined P_L6_
PRO	P_L6					;---------- PRO P
PRMS					;    debut parametrage
	PRM C1_ofs				; in
	PRM C2_ofs				; out
	PRM C3_ofs				; out
endPRMS					;    fin parametrage
ELB 3					;    BODY ELAB
VAR X_disp, q				; variable entiere

VAR I_disp, d				; variable entiere

					;    end elab
begin:					;---------- BDY INSTRUCTIONS
VAR	IL10_disp, d				; compteur boucle LOOP__2
	LId	3, STANDARD.A62006D_L1.BLOCK__1.P_L6.C2__u, STANDARD.A62006D_L1.BLOCK__1._ARR.FST_1
	Sd  3,	IL10_disp
VAR	LMT_IL10_disp, d			; limite boucle LOOP__2
	LId	3, STANDARD.A62006D_L1.BLOCK__1.P_L6.C2__u, STANDARD.A62006D_L1.BLOCK__1._ARR.LST_1
	Sd  3,	LMT_IL10_disp
	Ld  3,	IL10_disp				; test null range LOOP__2
	Ld  3,	LMT_IL10_disp
	CGT
	BT	L9
LOOP__2:					; corps boucle LOOP__2
	Ld  3,	IL10_disp				; test de sortie LOOP__2
	Ld  3,	LMT_IL10_disp
	CEQ
	BT	L9
	Ld  3,	IL10_disp				; mise a jour compteur LOOP__2
	INC
	Sd  3,	IL10_disp
	BRA	LOOP__2				; iteration suivante LOOP__2
L9:					; post loop LOOP__2
	LVA	3, -C2_ofs
	LIa	, , 8
	Ld	, _ARR.LST_1
	LVA	3, -C2_ofs
	LIa	, , 8
	Ld	, _ARR.FST_1
	SUB
	INC
	CLAMP0
	Sd  3,	I_disp
					; debut if
	LI	0
	BF	L12
	La  3,	-C3_ofs
	La  3,	-C2_ofs
	La 3, -C3_ofs
	LIVA 	, 0, STANDARD.A62006D_L1.BLOCK__1._REC.Y
	CALL	STANDARD.A62006D_L1.BLOCK__1. ,P_L6
	BRA	L11
L12:
L11:					; post if
	La 3, -C3_ofs
	LIVA 	, 0, STANDARD.A62006D_L1.BLOCK__1._REC.Y
; ATTRIBUTE CONSTRAINED formel mutable : approximation statique FALSE (valeur exacte = celle de l'actuel)
	LI	0
	Sb
	LId	 2, STANDARD.A62006D_L1.BLOCK__1._ARR.use__info
	Sd  3,	I_disp
VAR	IL14_disp, d				; compteur boucle LOOP__3
	LVA	3, -C2_ofs
	LIa	, , 8
	Ld	, _ARR.FST_1
	Sd  3,	IL14_disp
VAR	LMT_IL14_disp, d			; limite boucle LOOP__3
	LVA	3, -C2_ofs
	LIa	, , 8
	Ld	, _ARR.LST_1
	Sd  3,	LMT_IL14_disp
	Ld  3,	IL14_disp				; test null range LOOP__3
	Ld  3,	LMT_IL14_disp
	CGT
	BT	L13
LOOP__3:					; corps boucle LOOP__3
	Ld  3,	IL14_disp				; test de sortie LOOP__3
	Ld  3,	LMT_IL14_disp
	CEQ
	BT	L13
	Ld  3,	IL14_disp				; mise a jour compteur LOOP__3
	INC
	Sd  3,	IL14_disp
	BRA	LOOP__3				; iteration suivante LOOP__3
L13:					; post loop LOOP__3
	LId	2, STANDARD.A62006D_L1.BLOCK__1._REC.X__u, STANDARD.A62006D_L1.BLOCK__1._ARR.LST_1
	LId	2, STANDARD.A62006D_L1.BLOCK__1._REC.X__u, STANDARD.A62006D_L1.BLOCK__1._ARR.FST_1
	SUB
	INC
	CLAMP0
	Sd  3,	I_disp
	La 3, -C3_ofs
	LIVA 	, 0, STANDARD.A62006D_L1.BLOCK__1._REC.Y
	Sq  3,	X_disp
	LId	 0, STANDARD._BOOLEAN.use__info
	Sd  3,	I_disp
	Sd  3,	I_disp
	Sd  3,	I_disp
	Sd  3,	I_disp
VAR	JL16_disp, d				; compteur boucle LOOP__4
	Ld	2, STANDARD.A62006D_L1.BLOCK__1._ARR._FST_1
	Sd  3,	JL16_disp
VAR	LMT_JL16_disp, d			; limite boucle LOOP__4
	Ld	2, STANDARD.A62006D_L1.BLOCK__1._ARR._LST_1
	Sd  3,	LMT_JL16_disp
	Ld  3,	JL16_disp				; test null range LOOP__4
	Ld  3,	LMT_JL16_disp
	CGT
	BT	L15
LOOP__4:					; corps boucle LOOP__4
	Ld  3,	JL16_disp				; test de sortie LOOP__4
	Ld  3,	LMT_JL16_disp
	CEQ
	BT	L15
	Ld  3,	JL16_disp				; mise a jour compteur LOOP__4
	INC
	Sd  3,	JL16_disp
	BRA	LOOP__4				; iteration suivante LOOP__4
L15:					; post loop LOOP__4
ret_lbl:
	UNLINK 3
	RTD	prm_siz
excep:
endPRO					;---------- end PRO P
end if
					;    end elab
begin:					;---------- BDY INSTRUCTIONS
	UNLINK 2
endPRO
	CALL	STANDARD.REPORT. ,RESULT_L6
ret_lbl:
	UNLINK 1
	RTD
excep:
endPRO					;---------- end PRO A62006D
