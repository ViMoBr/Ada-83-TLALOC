VAR C_disp, b				; variable entiere

VAR J_disp, b				; variable entiere

VAR G_disp, q				; variable record : pointeur aux data record
VAR G__u, q				; variable record : pointeur aux useinfo
VAR G__dat, STANDARD.TEXT_IO.FILE_TYPE.size
	LVA	1, G__dat
	Sa	1, G_disp				; record fin
	LVA	1, STANDARD.TEXT_IO.FILE_TYPE.SIZ
	Sa	1, G__u
	LIVa 1, G_disp, STANDARD.TEXT_IO.FILE_TYPE.ID
	LI	1
	NEG
	Sd
	LIVa 1, G_disp, STANDARD.TEXT_IO.FILE_TYPE.IS_OPENED
	LI	0
	Sb
	LIVa 1, G_disp, STANDARD.TEXT_IO.FILE_TYPE.PAGE_LENGTH
	LI	72
	Sd
	LIVa 1, G_disp, STANDARD.TEXT_IO.FILE_TYPE.LINE_LENGTH
	LI	256
	Sd
	LIVa 1, G_disp, STANDARD.TEXT_IO.FILE_TYPE.PAGE
	LI	1
	Sd
	LIVa 1, G_disp, STANDARD.TEXT_IO.FILE_TYPE.LINE
	LI	1
	Sd
	LIVa 1, G_disp, STANDARD.TEXT_IO.FILE_TYPE.COL
	LI	1
	Sd
	LIVa 1, G_disp, STANDARD.TEXT_IO.FILE_TYPE.IS_DEFAULT_IO
	LI	0
	Sb
	LIVa 1, G_disp, STANDARD.TEXT_IO.FILE_TYPE.LOOK_AHEAD
	LI	 0
	Sb
	LIVa 1, G_disp, STANDARD.TEXT_IO.FILE_TYPE.HAS_LOOK_AHEAD
	LI	0
	Sb
	LIVa 1, G_disp, STANDARD.TEXT_IO.FILE_TYPE.AT_END_OF_FILE
	LI	0
	Sb

					;    end elab
begin:					;---------- BDY INSTRUCTIONS
STR STR_L19, "=== 1. PUT basique ==="		; constante string="=== 1. PUT basique ==="
	LCA	STR_L19.data_ptr
	CALL	STANDARD.TEXT_IO. ,PUT_LINE_L60
	Lb 1,	STANDARD.ENUM_TEST_L1.IO_COULEUR.DEFAULT_SETTING_disp
	Ld 1,	STANDARD.ENUM_TEST_L1.IO_COULEUR.DEFAULT_WIDTH_disp
	LI  0
	CALL	STANDARD.ENUM_TEST_L1.IO_COULEUR. ,PUT_L4
	LI	1
	CALL	STANDARD.TEXT_IO. ,NEW_LINE_L26
	Lb 1,	STANDARD.ENUM_TEST_L1.IO_COULEUR.DEFAULT_SETTING_disp
	Ld 1,	STANDARD.ENUM_TEST_L1.IO_COULEUR.DEFAULT_WIDTH_disp
	LI  1
	CALL	STANDARD.ENUM_TEST_L1.IO_COULEUR. ,PUT_L4
	LI	1
	CALL	STANDARD.TEXT_IO. ,NEW_LINE_L26
	Lb 1,	STANDARD.ENUM_TEST_L1.IO_COULEUR.DEFAULT_SETTING_disp
	Ld 1,	STANDARD.ENUM_TEST_L1.IO_COULEUR.DEFAULT_WIDTH_disp
	LI  2
	CALL	STANDARD.ENUM_TEST_L1.IO_COULEUR. ,PUT_L4
	LI	1
	CALL	STANDARD.TEXT_IO. ,NEW_LINE_L26
STR STR_L20, "=== 2. PUT avec WIDTH ==="	; constante string="=== 2. PUT avec WIDTH ==="
	LCA	STR_L20.data_ptr
	CALL	STANDARD.TEXT_IO. ,PUT_LINE_L60
STR STR_L21, "["				; constante string="["
	LCA	STR_L21.data_ptr
	CALL	STANDARD.TEXT_IO. ,PUT_L56
	Lb 1,	STANDARD.ENUM_TEST_L1.IO_COULEUR.DEFAULT_SETTING_disp
	LI	10
	LI  0
	CALL	STANDARD.ENUM_TEST_L1.IO_COULEUR. ,PUT_L4
STR STR_L22, "]"				; constante string="]"
	LCA	STR_L22.data_ptr
	CALL	STANDARD.TEXT_IO. ,PUT_LINE_L60
STR STR_L23, "["				; constante string="["
	LCA	STR_L23.data_ptr
	CALL	STANDARD.TEXT_IO. ,PUT_L56
	Lb 1,	STANDARD.ENUM_TEST_L1.IO_COULEUR.DEFAULT_SETTING_disp
	LI	10
	LI  2
	CALL	STANDARD.ENUM_TEST_L1.IO_COULEUR. ,PUT_L4
STR STR_L24, "]"				; constante string="]"
	LCA	STR_L24.data_ptr
	CALL	STANDARD.TEXT_IO. ,PUT_LINE_L60
STR STR_L25, "=== 3. PUT LOWER_CASE ==="	; constante string="=== 3. PUT LOWER_CASE ==="
	LCA	STR_L25.data_ptr
	CALL	STANDARD.TEXT_IO. ,PUT_LINE_L60
	LI  0
	Ld 1,	STANDARD.ENUM_TEST_L1.IO_COULEUR.DEFAULT_WIDTH_disp
	LI  0
	CALL	STANDARD.ENUM_TEST_L1.IO_COULEUR. ,PUT_L4
	LI	1
	CALL	STANDARD.TEXT_IO. ,NEW_LINE_L26
	LI  0
	Ld 1,	STANDARD.ENUM_TEST_L1.IO_COULEUR.DEFAULT_WIDTH_disp
	LI  1
	CALL	STANDARD.ENUM_TEST_L1.IO_COULEUR. ,PUT_L4
	LI	1
	CALL	STANDARD.TEXT_IO. ,NEW_LINE_L26
	LI  0
	Ld 1,	STANDARD.ENUM_TEST_L1.IO_COULEUR.DEFAULT_WIDTH_disp
	LI  2
	CALL	STANDARD.ENUM_TEST_L1.IO_COULEUR. ,PUT_L4
	LI	1
	CALL	STANDARD.TEXT_IO. ,NEW_LINE_L26
STR STR_L26, "=== 4. PUT via variable ==="	; constante string="=== 4. PUT via variable ==="
	LCA	STR_L26.data_ptr
	CALL	STANDARD.TEXT_IO. ,PUT_LINE_L60
	LI	1
	Sb  1,	C_disp
	Lb 1,	STANDARD.ENUM_TEST_L1.IO_COULEUR.DEFAULT_SETTING_disp
	Ld 1,	STANDARD.ENUM_TEST_L1.IO_COULEUR.DEFAULT_WIDTH_disp
	Lb 1,	C_disp
	CALL	STANDARD.ENUM_TEST_L1.IO_COULEUR. ,PUT_L4
	LI	1
	CALL	STANDARD.TEXT_IO. ,NEW_LINE_L26
	LI	2
	Sb  1,	C_disp
	Lb 1,	STANDARD.ENUM_TEST_L1.IO_COULEUR.DEFAULT_SETTING_disp
	Ld 1,	STANDARD.ENUM_TEST_L1.IO_COULEUR.DEFAULT_WIDTH_disp
	Lb 1,	C_disp
	CALL	STANDARD.ENUM_TEST_L1.IO_COULEUR. ,PUT_L4
	LI	1
	CALL	STANDARD.TEXT_IO. ,NEW_LINE_L26
STR STR_L27, "=== 5. PUT sans FILE ==="		; constante string="=== 5. PUT sans FILE ==="
	LCA	STR_L27.data_ptr
	CALL	STANDARD.TEXT_IO. ,PUT_LINE_L60
	Lb 1,	STANDARD.ENUM_TEST_L1.IO_COULEUR.DEFAULT_SETTING_disp
	Ld 1,	STANDARD.ENUM_TEST_L1.IO_COULEUR.DEFAULT_WIDTH_disp
	LI  0
	CALL	STANDARD.ENUM_TEST_L1.IO_COULEUR. ,PUT_L4
	LI	1
	CALL	STANDARD.TEXT_IO. ,NEW_LINE_L26
STR STR_L28, "=== 6. Type JOUR ==="		; constante string="=== 6. Type JOUR ==="
	LCA	STR_L28.data_ptr
	CALL	STANDARD.TEXT_IO. ,PUT_LINE_L60
	Lb 1,	STANDARD.ENUM_TEST_L1.IO_JOUR.DEFAULT_SETTING_disp
	Ld 1,	STANDARD.ENUM_TEST_L1.IO_JOUR.DEFAULT_WIDTH_disp
	LI  0
	CALL	STANDARD.ENUM_TEST_L1.IO_JOUR. ,PUT_L10
	LI	1
	CALL	STANDARD.TEXT_IO. ,NEW_LINE_L26
	Lb 1,	STANDARD.ENUM_TEST_L1.IO_JOUR.DEFAULT_SETTING_disp
	Ld 1,	STANDARD.ENUM_TEST_L1.IO_JOUR.DEFAULT_WIDTH_disp
	LI  2
	CALL	STANDARD.ENUM_TEST_L1.IO_JOUR. ,PUT_L10
	LI	1
	CALL	STANDARD.TEXT_IO. ,NEW_LINE_L26
	Lb 1,	STANDARD.ENUM_TEST_L1.IO_JOUR.DEFAULT_SETTING_disp
	Ld 1,	STANDARD.ENUM_TEST_L1.IO_JOUR.DEFAULT_WIDTH_disp
	LI  6
	CALL	STANDARD.ENUM_TEST_L1.IO_JOUR. ,PUT_L10
	LI	1
	CALL	STANDARD.TEXT_IO. ,NEW_LINE_L26
STR STR_L29, "=== 7. JOUR WIDTH+LOWER_CASE ==="	; constante string="=== 7. JOUR WIDTH+LOWER_CASE ==="
	LCA	STR_L29.data_ptr
	CALL	STANDARD.TEXT_IO. ,PUT_LINE_L60
STR STR_L30, "["				; constante string="["
	LCA	STR_L30.data_ptr
	CALL	STANDARD.TEXT_IO. ,PUT_L56
	LI  0
