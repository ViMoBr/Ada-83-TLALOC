if ~ definite TEXT_IO
include 'TEXT_IO.FINC'
end if
PRO	ENUM_TEST_L1				;---------- PRO ENUM_TEST
ELB 1					;    BODY ELAB

					; COULEUR ENUMERATION TYPE INFO
COULEUR = 'COULEUR'
namespace COULEUR
VAR use__info, q
BEGIN_BLOC_DEF
db 0, 4, "BLEU"
db 1, 5, "BLANC"
db 2, 5, "ROUGE"
END_BLOC_DEF
IMAGES	BYTES_BLOC
CST LST, d, 2
CST FST, d, 0
CST SIZ, d, 8	; SIZ en bits !
postpone
  align_q
end postpone
	LCA	SIZ
	Sa	1, use__info
end namespace

					; JOUR ENUMERATION TYPE INFO
JOUR = 'JOUR'
namespace JOUR
VAR use__info, q
BEGIN_BLOC_DEF
db 0, 5, "LUNDI"
db 1, 5, "MARDI"
db 2, 8, "MERCREDI"
db 3, 5, "JEUDI"
db 4, 8, "VENDREDI"
db 5, 6, "SAMEDI"
db 6, 8, "DIMANCHE"
END_BLOC_DEF
IMAGES	BYTES_BLOC
CST LST, d, 6
CST FST, d, 0
CST SIZ, d, 8	; SIZ en bits !
postpone
  align_q
end postpone
	LCA	SIZ
	Sa	1, use__info
end namespace
