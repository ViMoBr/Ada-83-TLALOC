					; POINT RECORD TYPE INFO
POINT = 'POINT'
namespace POINT
VAR use__info, q
VAR SIZ, d
	LVA	1, SIZ
	Sa	1, use__info
USEINFO 1, X, 	La 0, STANDARD.INTEGER.use__info
USEINFO 1, Y, 	La 0, STANDARD.INTEGER.use__info
USEINFO 1, Z, 	La 0, STANDARD.INTEGER.use__info
virtual at 0				; calcul des offsets statiques
STATOFS X, 4
STATOFS Y, 4
STATOFS Z, 4
size = $
end virtual
	LI	 size*8
	Sd	1, SIZ
end namespace
VAR P1_disp, q				; variable record : pointeur aux data record
VAR P1__u, q				; variable record : pointeur aux useinfo
VAR P1__dat, STANDARD.TEST_AGREGATS_L1.POINT.size
	LVA	1, P1__dat
	Sa	1, P1_disp				; record fin
	LVA	1, STANDARD.TEST_AGREGATS_L1.POINT.SIZ
	Sa	1, P1__u
	La 1, P1_disp
	DUP
	LVA	, STANDARD.TEST_AGREGATS_L1.POINT.X
	LI	16
	Sd
	DUP
	LVA	, STANDARD.TEST_AGREGATS_L1.POINT.Y
	LI	32
	Sd
	DUP
	LVA	, STANDARD.TEST_AGREGATS_L1.POINT.Z
	LI	64
	Sd
	DROP

