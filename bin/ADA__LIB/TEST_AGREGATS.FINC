	LVA	2, -VEC_ofs
	LIa	, , 8
	Ld	, STANDARD.TEST_AGREGATS_L1.VECTEUR.COMP_SIZ
	LI	8
	DIV
	MUL
	ADD					; add offset to start address
	Ld					; charge depuis adresse empilee 
	CALL	STANDARD.TEST_AGREGATS_L1.INT_IO. ,PUT_L5
STR STR_L10, ", "				; constante string=", "
	LCA	STR_L10.data_ptr
	CALL	STANDARD.TEXT_IO. ,PUT_L56
	Ld 1,	STANDARD.TEST_AGREGATS_L1.INT_IO.DEFAULT_BASE_disp
	Ld 1,	STANDARD.TEST_AGREGATS_L1.INT_IO.DEFAULT_WIDTH_disp
