INT_IO = 'INT_IO'
namespace INT_IO				;---------- GENERIC PACKAGE INSTANTIATION
elab_spec:				;    SPEC ELAB

BRA post_LD_INTEGER
LD_INTEGER.elab:
	Ld -1, 0
	RTD 0
post_LD_INTEGER:
BRA post_ST_INTEGER
ST_INTEGER.elab:
	Sd -1, 0
	RTD 0
post_ST_INTEGER:
BRA post_INADR_INTEGER
INADR_INTEGER.elab:
	RTD 0
post_INADR_INTEGER:
BRA post_OUTADR_INTEGER
OUTADR_INTEGER.elab:
	La
	RTD 0
post_OUTADR_INTEGER:
VAR INTEGER__outadr_ofs, q
	LCA OUTADR_INTEGER.elab
	Sa	 1, INTEGER__outadr_ofs
VAR INTEGER__inadr_ofs, q
	LCA INADR_INTEGER.elab
	Sa	 1, INTEGER__inadr_ofs
VAR INTEGER__st_ofs, q
	LCA ST_INTEGER.elab
	Sa	 1, INTEGER__st_ofs
VAR INTEGER__ld_ofs, q
	LCA LD_INTEGER.elab
	Sa	 1, INTEGER__ld_ofs
VAR INTEGER__u_ofs, q
	La	 0, STANDARD.INTEGER.use__info
	Sa	 1, INTEGER__u_ofs
VAR GFP_disp, q				; Lieu du Generic Frame Pointer 
VAR DEFAULT_WIDTH_disp, d			; variable entiere
	LI	 11
	Sd  1,	DEFAULT_WIDTH_disp

VAR DEFAULT_BASE_disp, d			; variable entiere
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	10
	Sd  1,	DEFAULT_BASE_disp

if defined GET_L2_
PRO	GET_L2				;---------- PRO GET
PRMS					;    debut parametrage
	PRM FILE_ofs				; in
	PRM ITEM_ofs				; out
	PRM WIDTH_ofs				; in
endPRMS					;    fin parametrage
ELB 2
begin:
	LVA	 1, GFP_disp
	Ld	 2, -WIDTH_ofs
	La 	 2, -ITEM_ofs
	La 	 2, -FILE_ofs
	CALL	STANDARD.TEXT_IO.INTEGER_IO. ,GET_L61
	UNLINK	 2
	RTD	prm_siz
endPRO					;---------- end PRO GET
end if
if defined GET_L3_
PRO	GET_L3				;---------- PRO GET
PRMS					;    debut parametrage
	PRM ITEM_ofs				; out
	PRM WIDTH_ofs				; in
endPRMS					;    fin parametrage
ELB 2
begin:
	LVA	 1, GFP_disp
	Ld	 2, -WIDTH_ofs
	La 	 2, -ITEM_ofs
	CALL	STANDARD.TEXT_IO.INTEGER_IO. ,GET_L62
	UNLINK	 2
	RTD	prm_siz
endPRO					;---------- end PRO GET
end if
if defined PUT_L4_
PRO	PUT_L4				;---------- PRO PUT
PRMS					;    debut parametrage
	PRM FILE_ofs				; in
	PRM ITEM_ofs				; in
	PRM WIDTH_ofs				; in
	PRM BASE_ofs				; in
endPRMS					;    fin parametrage
ELB 2
begin:
	LVA	 1, GFP_disp
	Ld	 2, -BASE_ofs
	Ld	 2, -WIDTH_ofs
	Ld	 2, -ITEM_ofs
	La 	 2, -FILE_ofs
	CALL	STANDARD.TEXT_IO.INTEGER_IO. ,PUT_L63
	UNLINK	 2
	RTD	prm_siz
endPRO					;---------- end PRO PUT
end if
if defined PUT_L5_
PRO	PUT_L5				;---------- PRO PUT
PRMS					;    debut parametrage
	PRM ITEM_ofs				; in
	PRM WIDTH_ofs				; in
	PRM BASE_ofs				; in
endPRMS					;    fin parametrage
ELB 2
begin:
	LVA	 1, GFP_disp
	Ld	 2, -BASE_ofs
	Ld	 2, -WIDTH_ofs
	Ld	 2, -ITEM_ofs
	CALL	STANDARD.TEXT_IO.INTEGER_IO. ,PUT_L64
	UNLINK	 2
	RTD	prm_siz
endPRO					;---------- end PRO PUT
end if
if defined GET_L6_
PRO	GET_L6				;---------- PRO GET
PRMS					;    debut parametrage
	PRM FROM_ofs				; in
	PRM ITEM_ofs				; out
	PRM LAST_ofs				; out
endPRMS					;    fin parametrage
ELB 2
begin:
	LVA	 1, GFP_disp
	La 	 2, -LAST_ofs
	La 	 2, -ITEM_ofs
	La 	 2, -FROM_ofs
	CALL	STANDARD.TEXT_IO.INTEGER_IO. ,GET_L65
	UNLINK	 2
	RTD	prm_siz
endPRO					;---------- end PRO GET
end if
if defined PUT_L7_
PRO	PUT_L7				;---------- PRO PUT
PRMS					;    debut parametrage
	PRM TO_ofs				; out
	PRM ITEM_ofs				; in
	PRM BASE_ofs				; in
endPRMS					;    fin parametrage
ELB 2
begin:
	LVA	 1, GFP_disp
	Ld	 2, -BASE_ofs
	Ld	 2, -ITEM_ofs
	La 	 2, -TO_ofs
	CALL	STANDARD.TEXT_IO.INTEGER_IO. ,PUT_L66
	UNLINK	 2
	RTD	prm_siz
endPRO					;---------- end PRO PUT
end if
					;---------- end generic package instantiation INT_IO
end namespace


					; POINT RECORD TYPE INFO
POINT = 'POINT'
namespace POINT
VAR use__info, q
VAR SIZ, d
	LVA	1, SIZ
	Sa	1, use__info
USEINFO 1, X, 	La 0, STANDARD.INTEGER.use__info
USEINFO 1, Y, 	La 0, STANDARD.INTEGER.use__info
USEINFO 1, Z, 	La 0, STANDARD.INTEGER.use__info
virtual at 0				; calcul des offsets statiques
STATOFS X, 4
STATOFS Y, 4
STATOFS Z, 4
size = $
end virtual
	LI	 size*8
	Sd	1, SIZ
end namespace
VAR P1_disp, q				; variable record : pointeur aux data record
VAR P1__u, q				; variable record : pointeur aux useinfo
VAR P1__dat, STANDARD.TEST_AGREGATS_L1.POINT.size
	LVA	1, P1__dat
	Sa	1, P1_disp				; record fin
	LVA	1, STANDARD.TEST_AGREGATS_L1.POINT.SIZ
	Sa	1, P1__u
	La 1, P1_disp
	DUP
	LVA	, STANDARD.TEST_AGREGATS_L1.POINT.X
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	16
	Sd
	DUP
	LVA	, STANDARD.TEST_AGREGATS_L1.POINT.Y
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	32
	Sd
	DUP
	LVA	, STANDARD.TEST_AGREGATS_L1.POINT.Z
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	64
	Sd
	DROP

VAR P2_disp, q				; variable record : pointeur aux data record
VAR P2__u, q				; variable record : pointeur aux useinfo
VAR P2__dat, STANDARD.TEST_AGREGATS_L1.POINT.size
	LVA	1, P2__dat
	Sa	1, P2_disp				; record fin
	LVA	1, STANDARD.TEST_AGREGATS_L1.POINT.SIZ
	Sa	1, P2__u
	La 1, P2_disp
	DUP
	LVA	, STANDARD.TEST_AGREGATS_L1.POINT.X
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	128
	Sd
	DUP
	LVA	, STANDARD.TEST_AGREGATS_L1.POINT.Y
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	256
	Sd
	DUP
	LVA	, STANDARD.TEST_AGREGATS_L1.POINT.Z
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	512
	Sd
	DROP


					; SEGMENT RECORD TYPE INFO
SEGMENT = 'SEGMENT'
namespace SEGMENT
VAR use__info, q
VAR SIZ, d
	LVA	1, SIZ
	Sa	1, use__info
USEINFO 1, A, 	La 1, STANDARD.TEST_AGREGATS_L1.POINT.use__info
USEINFO 1, B, 	La 1, STANDARD.TEST_AGREGATS_L1.POINT.use__info
virtual at 0				; calcul des offsets statiques
STATOFS A, 12
STATOFS B, 12
size = $
end virtual
	LI	 size*8
	Sd	1, SIZ
end namespace
VAR S1_disp, q				; variable record : pointeur aux data record
VAR S1__u, q				; variable record : pointeur aux useinfo
VAR S1__dat, STANDARD.TEST_AGREGATS_L1.SEGMENT.size
	LVA	1, S1__dat
	Sa	1, S1_disp				; record fin
	LVA	1, STANDARD.TEST_AGREGATS_L1.SEGMENT.SIZ
	Sa	1, S1__u
	La 1, S1_disp
	DUP
	LVA	, STANDARD.TEST_AGREGATS_L1.SEGMENT.A
	DUP
	LVA	, STANDARD.TEST_AGREGATS_L1.POINT.X
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	1
	Sd
	DUP
	LVA	, STANDARD.TEST_AGREGATS_L1.POINT.Y
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	2
	Sd
	DUP
	LVA	, STANDARD.TEST_AGREGATS_L1.POINT.Z
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	3
	Sd
	DROP
	DUP
	LVA	, STANDARD.TEST_AGREGATS_L1.SEGMENT.B
	DUP
	LVA	, STANDARD.TEST_AGREGATS_L1.POINT.X
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	4
	Sd
	DUP
	LVA	, STANDARD.TEST_AGREGATS_L1.POINT.Y
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	5
	Sd
	DUP
	LVA	, STANDARD.TEST_AGREGATS_L1.POINT.Z
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	6
	Sd
	DROP
	DROP


					; array decl constrained array type info
VECTEUR = 'VECTEUR'
namespace VECTEUR
VAR use__info, q
VAR SIZ, d
	LVA	1, SIZ
	Sa	1, use__info
VAR COMP_SIZ, d
VAR FST_1, d
VAR LST_1, d
	LI	32
	Sd	1, COMP_SIZ
	Ld	1, COMP_SIZ
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	1
	Sd	1, FST_1
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	4
	Sd	1, LST_1
	Ld	1, LST_1
	INC
	Ld	1, FST_1
	SUB
	MUL
	Sd	1, SIZ
  virtual at 4
COMP_SIZ = $
	rd 1 
FST_1 = $
	rd 1 
LST_1 = $
	rd 1 
  end virtual
end namespace
VAR V1_disp, q				; variable array : pointeur aux data
VAR V1__u, q				; variable array : useinfo pointeur au rec info
	La 1, VECTEUR.use__info
	Sa	1, V1__u				; array info ptr at __u
	Ld	1, VECTEUR.SIZ
	LI	8
	DIV
	CO_VAR
	Sa	1, V1_disp				; array data ptr at _disp
					; array data aggregate
	La	1, V1_disp
;CODE_AGGREGATE fst 1
;CODE_AGGREGATE lst 4
	DUP
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	0
	Sd
	LI	4
	ADD
	DUP
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	1
	Sd
	LI	4
	ADD
	DUP
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	2
	Sd
	LI	4
	ADD
	DUP
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	3
	Sd
	LI	4
	ADD
	DROP

VAR V2_disp, q				; variable array : pointeur aux data
VAR V2__u, q				; variable array : useinfo pointeur au rec info
	La 1, VECTEUR.use__info
	Sa	1, V2__u				; array info ptr at __u
	Ld	1, VECTEUR.SIZ
	LI	8
	DIV
	CO_VAR
	Sa	1, V2_disp				; array data ptr at _disp
					; array data aggregate
	La	1, V2_disp
;CODE_AGGREGATE fst 1
;CODE_AGGREGATE lst 4
	DUP
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	0
	Sd
	LI	4
	ADD
	DUP
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	1
	Sd
	LI	4
	ADD
	DUP
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	1
	Sd
	LI	4
	ADD
	DUP
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	1
	NEG
	Sd
	LI	4
	ADD
	DROP

VAR V3_disp, q				; variable array : pointeur aux data
VAR V3__u, q				; variable array : useinfo pointeur au rec info
	La 1, VECTEUR.use__info
	Sa	1, V3__u				; array info ptr at __u
	Ld	1, VECTEUR.SIZ
	LI	8
	DIV
	CO_VAR
	Sa	1, V3_disp				; array data ptr at _disp
					; array data aggregate
	La	1, V3_disp
;CODE_AGGREGATE fst 1
;CODE_AGGREGATE lst 4
	DUP
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	0
	Sd
	LI	4
