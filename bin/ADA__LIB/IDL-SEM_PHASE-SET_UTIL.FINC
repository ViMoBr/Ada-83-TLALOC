if defined GET_DEF_L9_
PRO	GET_DEF_L9				;---------- PRO GET_DEF
PRMS					;    debut parametrage
	PRM DEFINTERP_ofs				; in
	PRM result__ofs				; resultat de fonction
endPRMS					;    fin parametrage
ELB 1					;    BODY ELAB
VAR DEF_disp, q				; variable record : pointeur aux data record
VAR DEF__u, q				; variable record : pointeur aux useinfo
VAR DEF__dat, STANDARD.IDL.TREE.size
	LVA	1, DEF__dat
	Sa	1, DEF_disp				; record fin
	LVA	1, STANDARD.IDL.TREE.SIZ
	Sa	1, DEF__u
	La  1, DEF_disp
	LI	STANDARD.IDL.TREE.size
	La  1,	-DEFINTERP_ofs
; CODE CONVERSION SOURCE DN_RECORD TARGET DN_RECORD
; EXPRESSIONS.CODE_CONVERSION cible non faite DN_RECORD
	La  ,  0
	BLKMOV

					;    end elab
begin:					;---------- BDY INSTRUCTIONS
					; debut if
	LIb	1, DEF_disp, STANDARD.IDL.TREE.TY
	LI	229
	CEQ
	DUP
	BT	L38
	DROP
	LIb	1, DEF_disp, STANDARD.IDL.TREE.TY
	LI	230
	CEQ
L38:
	BF	L37
	LVA 1,	DEF_disp
	La
	LI	STANDARD.IDL.TREE.size
VAR	ANON_26_14_disp, q
VAR	ANON_26_14__u,    q
VAR	ANON_26_14__dat, STANDARD.IDL.TREE.size
	LVA 1, ANON_26_14__dat
	Sa  1, ANON_26_14_disp
	La  0, STANDARD.IDL.TREE.use__info
	Sa  1, ANON_26_14__u
	LVA 1, ANON_26_14_disp
					; doublet resultat record anonyme
	LVA 1,	DEF_disp
	LI  167
	CALL	STANDARD.IDL. ,D_L13
	La
	BLKMOV
	BRA	L36
L37:
L36:					; post if
; CODE_RETURN : EXPR TYPE = DN_RECORD
	La   1,	-result__ofs
	La  ,  0
	LI	STANDARD.IDL.TREE.size
	LVA 1,	DEF_disp
	La  ,  0
	BLKMOV
	BRA ret_lbl
ret_lbl:
	UNLINK 1
	RTD	prm_siz-8
excep:
endPRO					;---------- end PRO GET_DEF
end if

