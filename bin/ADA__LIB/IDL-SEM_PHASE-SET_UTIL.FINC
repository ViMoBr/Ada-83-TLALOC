	LI	24
	LI	8
	UBFX
	LI	229
	CEQ
	DUP
	BT	L6
	DROP
	La	1, DEF_disp
	Ld
	LI	24
	LI	8
	UBFX
	LI	230
	CEQ
L6:
	BF	L5
	LVA 1,	DEF_disp
