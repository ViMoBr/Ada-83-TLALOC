					; DEFSET_TYPE RECORD TYPE INFO
DEFSET_TYPE = 'DEFSET_TYPE'
namespace DEFSET_TYPE
VAR use__info, q
VAR SIZ, d
	LVA	0, SIZ
	Sa	0, use__info
USEINFO 0, FIRST, 	La 0, STANDARD.IDL.TREE.use__info
USEINFO 0, NEXT, 	La 0, STANDARD.IDL.TREE.use__info
virtual at 0				; calcul des offsets statiques
STATOFS FIRST, 4
STATOFS NEXT, 4
size = $
end virtual
	LI	 size*8
	Sd	0, SIZ
end namespace

					; TYPESET_TYPE RECORD TYPE INFO
