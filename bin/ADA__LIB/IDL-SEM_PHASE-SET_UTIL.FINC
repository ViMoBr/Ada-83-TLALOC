	LI	24
	LI	8
	UBFX
	LI	229
	CEQ
	DUP
	BT	L8
	DROP
	La	1, DEF_disp
	Ld
	LI	24
	LI	8
	UBFX
	LI	230
	CEQ
L8:
	BF	L7
	LVA 1,	DEF_disp
	La
	LI	STANDARD.IDL._TREE.size
