	La  ,  0
	LI	STANDARD.IDL._TREE.size
	LVA 1,	DEF_disp
	La  ,  0
	BLKMOV
	BRA ret_lbl
ret_lbl:
	UNLINK 1
	RTD	prm_siz-8
excep:
endPRO					;---------- end PRO GET_DEF
