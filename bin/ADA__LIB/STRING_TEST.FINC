include 'TEXT_IO.FINC'
PRO	STRING_TEST_L1				;---------- PRO STRING_TEST
ELB 1					;    BODY ELAB
VAR L_disp, d				; variable entiere

VAR C_disp, b				; variable bool char

STRING = 'STRING'
namespace STRING				; array var constrained array type info
VAR SIZ, d
  namespace info
VAR COMP_SIZ, d
VAR FST_1, d
VAR LST_1, d
	LI	1
	Sd	1, COMP_SIZ
	Ld	1, COMP_SIZ
	LI	1
	Sd	1, FST_1
	LI	128
	Sd	1, LST_1
	Ld	1, LST_1
	INC
	Ld	1, FST_1
	SUB
	MUL
	Sd	1, SIZ
  end namespace
  virtual at 4
COMP_SIZ = $
	rd 1 
FST_1 = $
	rd 1 
LST_1 = $
	rd 1 
  end virtual
end namespace

VAR BUF_disp, q				; variable array : pointeur aux data
VAR BUF__u, q				; variable array : useinfo pointeur au rec info
	Ld	1, STRING.SIZ
	CO_VAR
	Sa	1, BUF_disp				; array data ptr at _disp
	LVA 1, STRING.SIZ
	Sa	1, BUF__u				; array info ptr at __u

NAT_IO = 'NAT_IO'
namespace NAT_IO				;---------- GENERIC PACKAGE INSTANTIATION
elab_spec:				;    SPEC ELAB

VAR NATURAL_last_ofs, q
LI	2147483647
Sd	 1, NATURAL_last_ofs
VAR NATURAL_first_ofs, q
LI	0
Sd	 1, NATURAL_first_ofs
VAR GFP_disp, q
VAR DEFAULT_WIDTH_disp, d			; variable entiere
	Sd  1,	DEFAULT_WIDTH_disp

VAR DEFAULT_BASE_disp, d			; variable entiere
	LI	10
	Sd  1,	DEFAULT_BASE_disp

if defined GET_L61_
PRO	GET_L61				;---------- PRO GET
PRMS					;    debut parametrage
	PRM FILE_ofs				; in
	PRM ITEM_ofs				; out
	PRM WIDTH_ofs				; in
endPRMS					;    fin parametrage
ELB 2
begin:
	LVA	 2, GFP_disp
	Lq	 2, -WIDTH_ofs
	Lq	 2, -ITEM_ofs
	Lq	 2, -FILE_ofs
	CALL	STANDARD.TEXT_IO.INTEGER_IO. ,GET_L61
	UNLINK	 2
	RTD	prm_siz
endPRO					;---------- end PRO GET
end if
if defined GET_L62_
PRO	GET_L62				;---------- PRO GET
PRMS					;    debut parametrage
	PRM ITEM_ofs				; out
	PRM WIDTH_ofs				; in
endPRMS					;    fin parametrage
ELB 2
begin:
	LVA	 2, GFP_disp
	Lq	 2, -WIDTH_ofs
	Lq	 2, -ITEM_ofs
	CALL	STANDARD.TEXT_IO.INTEGER_IO. ,GET_L62
	UNLINK	 2
	RTD	prm_siz
endPRO					;---------- end PRO GET
end if
if defined PUT_L63_
PRO	PUT_L63				;---------- PRO PUT
PRMS					;    debut parametrage
	PRM FILE_ofs				; in
	PRM ITEM_ofs				; in
	PRM WIDTH_ofs				; in
	PRM BASE_ofs				; in
endPRMS					;    fin parametrage
ELB 2
begin:
	LVA	 2, GFP_disp
	Lq	 2, -BASE_ofs
	Lq	 2, -WIDTH_ofs
	Lq	 2, -ITEM_ofs
	Lq	 2, -FILE_ofs
	CALL	STANDARD.TEXT_IO.INTEGER_IO. ,PUT_L63
	UNLINK	 2
	RTD	prm_siz
endPRO					;---------- end PRO PUT
end if
if defined PUT_L64_
PRO	PUT_L64				;---------- PRO PUT
PRMS					;    debut parametrage
	PRM ITEM_ofs				; in
	PRM WIDTH_ofs				; in
	PRM BASE_ofs				; in
endPRMS					;    fin parametrage
ELB 2
begin:
	LVA	 2, GFP_disp
	Lq	 2, -BASE_ofs
	Lq	 2, -WIDTH_ofs
	Lq	 2, -ITEM_ofs
	CALL	STANDARD.TEXT_IO.INTEGER_IO. ,PUT_L64
	UNLINK	 2
	RTD	prm_siz
endPRO					;---------- end PRO PUT
end if
if defined GET_L65_
PRO	GET_L65				;---------- PRO GET
PRMS					;    debut parametrage
	PRM FROM_ofs				; in
	PRM ITEM_ofs				; out
	PRM LAST_ofs				; out
endPRMS					;    fin parametrage
ELB 2
begin:
	LVA	 2, GFP_disp
	Lq	 2, -LAST_ofs
	Lq	 2, -ITEM_ofs
	Lq	 2, -FROM_ofs
	CALL	STANDARD.TEXT_IO.INTEGER_IO. ,GET_L65
	UNLINK	 2
	RTD	prm_siz
endPRO					;---------- end PRO GET
end if
if defined PUT_L66_
PRO	PUT_L66				;---------- PRO PUT
PRMS					;    debut parametrage
	PRM TO_ofs				; out
	PRM ITEM_ofs				; in
	PRM BASE_ofs				; in
endPRMS					;    fin parametrage
ELB 2
begin:
	LVA	 2, GFP_disp
	Lq	 2, -BASE_ofs
	Lq	 2, -ITEM_ofs
	Lq	 2, -TO_ofs
	CALL	STANDARD.TEXT_IO.INTEGER_IO. ,PUT_L66
	UNLINK	 2
	RTD	prm_siz
endPRO					;---------- end PRO PUT
end if
					;---------- end generic package instantiation NAT_IO
end namespace

VAR F_disp, q				; variable record : pointeur aux data record
VAR F__u, q				; variable record : pointeur aux useinfo
VAR F__dat, STANDARD.TEXT_IO.FILE_TYPE.size
	LVA	1, F__dat
	Sa	1, F_disp				; record fin
	LVA	1, STANDARD.TEXT_IO.FILE_TYPE.SIZ
	Sa	1, F__u
	LIVa 1, F_disp, STANDARD.TEXT_IO.FILE_TYPE.ID
	LI	1
	NEG
	Sd
	LIVa 1, F_disp, STANDARD.TEXT_IO.FILE_TYPE.IS_OPENED
	LI	0
	Sb
	LIVa 1, F_disp, STANDARD.TEXT_IO.FILE_TYPE.IS_DEFAULT_IO
	LI	0
	Sb
	LIVa 1, F_disp, STANDARD.TEXT_IO.FILE_TYPE.LOOK_AHEAD
	LI	 0
	Sb
	LIVa 1, F_disp, STANDARD.TEXT_IO.FILE_TYPE.HAS_LOOK_AHEAD
	LI	0
	Sb
	LIVa 1, F_disp, STANDARD.TEXT_IO.FILE_TYPE.AT_END_OF_FILE
	LI	0
	Sb

					;    end elab
begin:					;---------- BDY INSTRUCTIONS
STR STR_L8, 'CREATE'			; constante string='CREATE'
	LCA	STR_L8.data_ptr
	CALL	STANDARD.TEXT_IO. ,PUT_L56
	LI	1
	CALL	STANDARD.TEXT_IO. ,NEW_LINE_L26
STR STR_L9, ''				; constante string=''
	LCA	STR_L9.data_ptr
STR STR_L10, 'test.txt'			; constante string='test.txt'
	LCA	STR_L10.data_ptr
	LI  1
	LVA  1,	F_disp
	CALL	STANDARD.TEXT_IO. ,CREATE_L1
STR STR_L11, 'ligne_1'			; constante string='ligne_1'
	LCA	STR_L11.data_ptr
	LVa 1,	F_disp
	CALL	STANDARD.TEXT_IO. ,PUT_LINE_L59
STR STR_L12, 'ligne_2'			; constante string='ligne_2'
	LCA	STR_L12.data_ptr
	LVa 1,	F_disp
	CALL	STANDARD.TEXT_IO. ,PUT_LINE_L59
	LVA  1,	F_disp
	CALL	STANDARD.TEXT_IO. ,CLOSE_L3
STR STR_L13, 'OPEN'				; constante string='OPEN'
	LCA	STR_L13.data_ptr
	CALL	STANDARD.TEXT_IO. ,PUT_L56
	LI	1
	CALL	STANDARD.TEXT_IO. ,NEW_LINE_L26
STR STR_L14, ''				; constante string=''
	LCA	STR_L14.data_ptr
STR STR_L15, 'test.txt'			; constante string='test.txt'
	LCA	STR_L15.data_ptr
	LI  0
	LVA  1,	F_disp
	CALL	STANDARD.TEXT_IO. ,OPEN_L2
STR STR_L16, 'GET'				; constante string='GET'
	LCA	STR_L16.data_ptr
	LI	0					; lieu resultat sur pile
	CALL	STANDARD.TEXT_IO. ,STANDARD_OUTPUT_L14
	CALL	STANDARD.TEXT_IO. ,PUT_L55
	LI	1
	CALL	STANDARD.TEXT_IO. ,NEW_LINE_L26
	LVA  1,	C_disp
	LVa 1,	F_disp
	CALL	STANDARD.TEXT_IO. ,GET_L49
	LI	60
	CALL	STANDARD.TEXT_IO. ,PUT_L52
	Ld 1,	STANDARD.STRING_TEST_L1.NAT_IO.DEFAULT_BASE_disp
	Ld 1,	STANDARD.STRING_TEST_L1.NAT_IO.DEFAULT_WIDTH_disp
	Lb 1,	C_disp
	CALL	STANDARD.STRING_TEST_L1.NAT_IO. ,PUT_L64
	Lb 1,	C_disp
	CALL	STANDARD.TEXT_IO. ,PUT_L52
	LI	62
	CALL	STANDARD.TEXT_IO. ,PUT_L52
STR STR_L17, 'GET_LINE'			; constante string='GET_LINE'
	LCA	STR_L17.data_ptr
	LI	0					; lieu resultat sur pile
	CALL	STANDARD.TEXT_IO. ,STANDARD_OUTPUT_L14
	CALL	STANDARD.TEXT_IO. ,PUT_L55
	LI	1
	CALL	STANDARD.TEXT_IO. ,NEW_LINE_L26
STR STR_L18, 'CLOSE'			; constante string='CLOSE'
	LCA	STR_L18.data_ptr
	CALL	STANDARD.TEXT_IO. ,PUT_L56
	LI	1
	CALL	STANDARD.TEXT_IO. ,NEW_LINE_L26
	LVA  1,	F_disp
	CALL	STANDARD.TEXT_IO. ,CLOSE_L3
ret_lbl:
	UNLINK 1
	RTD
excep:
endPRO					;---------- end PRO STRING_TEST
