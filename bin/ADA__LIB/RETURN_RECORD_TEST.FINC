endPRO					;---------- end PRO PUT
end if
					;---------- end generic package instantiation INT_IO
end namespace


if defined MAKE_POINT_L2_
PRO	MAKE_POINT_L2				;---------- PRO MAKE_POINT
PRMS					;    debut parametrage
	PRM X_ofs				; in
	PRM Y_ofs				; in
	PRM result__ofs				; resultat de fonction
endPRMS					;    fin parametrage
ELB 2					;    BODY ELAB
					;    end elab
begin:					;---------- BDY INSTRUCTIONS
; CODE_RETURN : EXPR TYPE = DN_RECORD
	La   2,	-result__ofs
	La  ,  0
	DUP
	LVA	, STANDARD.RETURN_RECORD_TEST_L1.POINT.X
	Ld  2,	-X_ofs
	Sd
	DUP
	LVA	, STANDARD.RETURN_RECORD_TEST_L1.POINT.Y
	Ld  2,	-Y_ofs
	Sd
	DROP
	BRA ret_lbl
ret_lbl:
	UNLINK 2
	RTD	prm_siz-8
excep:
endPRO					;---------- end PRO MAKE_POINT
end if

if defined ADD_POINTS_L3_
PRO	ADD_POINTS_L3				;---------- PRO ADD_POINTS
PRMS					;    debut parametrage
	PRM A_ofs				; in
	PRM B_ofs				; in
	PRM result__ofs				; resultat de fonction
endPRMS					;    fin parametrage
ELB 2					;    BODY ELAB
					;    end elab
begin:					;---------- BDY INSTRUCTIONS
; CODE_RETURN : EXPR TYPE = DN_RECORD
	La   2,	-result__ofs
	La  ,  0
	DUP
	LVA	, STANDARD.RETURN_RECORD_TEST_L1.POINT.X
	La 2, -A_ofs
	LId	, 0, STANDARD.RETURN_RECORD_TEST_L1.POINT.X
	La 2, -B_ofs
	LId	, 0, STANDARD.RETURN_RECORD_TEST_L1.POINT.X
	ADD
	Sd
	DUP
	LVA	, STANDARD.RETURN_RECORD_TEST_L1.POINT.Y
	La 2, -A_ofs
	LId	, 0, STANDARD.RETURN_RECORD_TEST_L1.POINT.Y
	La 2, -B_ofs
	LId	, 0, STANDARD.RETURN_RECORD_TEST_L1.POINT.Y
	ADD
	Sd
	DROP
	BRA ret_lbl
ret_lbl:
	UNLINK 2
	RTD	prm_siz-8
excep:
endPRO					;---------- end PRO ADD_POINTS
end if
					;    end elab
