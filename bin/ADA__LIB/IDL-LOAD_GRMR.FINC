	LVA	2, USER_ROOT__dat
	Sa	2, USER_ROOT_disp			; record fin
	LVA	2, STANDARD.IDL._TREE.SIZ
	Sa	2, USER_ROOT__u
; CODE_VC_NAME DN_VARIABLE_ID
	La  2, USER_ROOT_disp
	LI	STANDARD.IDL._TREE.size
VAR	ANON_116_25_disp, q
VAR	ANON_116_25__u,    q
VAR	ANON_116_25__dat, STANDARD.IDL._TREE.size
	LVA 2, ANON_116_25__dat
	Sa  2, ANON_116_25_disp
	La  0, STANDARD.IDL._TREE.use__info
	Sa  2, ANON_116_25__u
	LVA 2, ANON_116_25_disp
					; doublet resultat record anonyme
	LI  11
	CALL	STANDARD.IDL. ,MAKE_L12
	La  ,  0
	BLKMOV

					;    end elab
begin:					;---------- BDY INSTRUCTIONS
	LVA 2,	USER_ROOT_disp
	LVA  0,	STANDARD.IDL.IDL_MAN.TREE_ROOT_disp	; array actual
	LI  1
	CALL	STANDARD.IDL. ,D_L13
	CALL	STANDARD.IDL.LOAD_GRMR_L11. ,READ_PARSE_TABLES_L1
	CALL	STANDARD.IDL. ,CLOSE_IDL_TREE_FILE_L3
	CALL	STANDARD.IDL.LOAD_GRMR_L11. ,WRITE_BINARY_L26
	UNLINK 2
endPRO
ret_lbl:
	UNLINK 1
	RTD	prm_siz
excep:
endPRO					;---------- end PRO LOAD_GRMR
