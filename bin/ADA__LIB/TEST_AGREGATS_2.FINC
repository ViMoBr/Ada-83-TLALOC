	LCA LD_INTEGER.elab
	Sa	 1, INTEGER__ld_ofs
VAR INTEGER__u_ofs, q
	La	 0, STANDARD.INTEGER.use__info
	Sa	 1, INTEGER__u_ofs
VAR GFP_disp, q				; Lieu du Generic Frame Pointer 
VAR DEFAULT_WIDTH_disp, d			; variable entiere
	LI	 11
	Sd  1,	DEFAULT_WIDTH_disp

VAR DEFAULT_BASE_disp, d			; variable entiere
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	10
	Sd  1,	DEFAULT_BASE_disp

if defined GET_L2_
PRO	GET_L2				;---------- PRO GET
PRMS					;    debut parametrage
	PRM FILE_ofs				; in
	PRM ITEM_ofs				; out
	PRM WIDTH_ofs				; in
endPRMS					;    fin parametrage
ELB 2
begin:
	LVA	 1, GFP_disp
	Ld	 2, -WIDTH_ofs
	La 	 2, -ITEM_ofs
	La 	 2, -FILE_ofs
	CALL	STANDARD.TEXT_IO.INTEGER_IO. ,GET_L61
	UNLINK	 2
	RTD	prm_siz
endPRO					;---------- end PRO GET
end if
if defined GET_L3_
PRO	GET_L3				;---------- PRO GET
PRMS					;    debut parametrage
	PRM ITEM_ofs				; out
	PRM WIDTH_ofs				; in
endPRMS					;    fin parametrage
ELB 2
begin:
	LVA	 1, GFP_disp
	Ld	 2, -WIDTH_ofs
	La 	 2, -ITEM_ofs
	CALL	STANDARD.TEXT_IO.INTEGER_IO. ,GET_L62
	UNLINK	 2
	RTD	prm_siz
endPRO					;---------- end PRO GET
end if
if defined PUT_L4_
PRO	PUT_L4				;---------- PRO PUT
PRMS					;    debut parametrage
	PRM FILE_ofs				; in
	PRM ITEM_ofs				; in
	PRM WIDTH_ofs				; in
	PRM BASE_ofs				; in
endPRMS					;    fin parametrage
ELB 2
begin:
	LVA	 1, GFP_disp
	Ld	 2, -BASE_ofs
	Ld	 2, -WIDTH_ofs
	Ld	 2, -ITEM_ofs
	La 	 2, -FILE_ofs
	CALL	STANDARD.TEXT_IO.INTEGER_IO. ,PUT_L63
	UNLINK	 2
	RTD	prm_siz
endPRO					;---------- end PRO PUT
end if
if defined PUT_L5_
