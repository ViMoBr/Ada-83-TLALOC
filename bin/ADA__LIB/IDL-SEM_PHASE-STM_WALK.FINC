	La  ,  0
	Sa  1, ANON_197_36_data
	La  ,  8
	Sa  1, ANON_197_36_info
	LId 1, ANON_197_36_info, STRING.LST_1
	INC
	LId 1, ANON_197_36_info, STRING.FST_1
	SUB
	Sa  1, ANON_197_36_len
VAR	ANON_197_50_disp, q
VAR	ANON_197_50__u,   q
namespace ANON_197_50_info
  VAR SIZ,      d
  VAR COMP_SIZ, d
  VAR FST_1,    d
  VAR LST_1,    d
end namespace
	LVA 1, ANON_197_50_info.SIZ
	Sa  1, ANON_197_50__u
	LVA 1, ANON_197_50_disp
VAR	ANON_197_56_disp, q
VAR	ANON_197_56__u,   q
namespace ANON_197_56_info
  VAR SIZ,      d
  VAR COMP_SIZ, d
  VAR FST_1,    d
  VAR LST_1,    d
