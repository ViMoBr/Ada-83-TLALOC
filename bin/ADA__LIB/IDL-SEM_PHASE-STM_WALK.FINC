; CODE_VC_NAME DN_VARIABLE_ID
	La 1, NEW_STM_LIST_disp
					; Assign_record_aggregate type DN_RECORD
	DUP
	LVA	, STANDARD.IDL.SEQ_TYPE.FIRST
	LI	STANDARD.IDL.TREE.size
	LVA 0,	STANDARD.IDL.TREE_NIL_disp
	La  ,  0
	BLKMOV
	DUP
