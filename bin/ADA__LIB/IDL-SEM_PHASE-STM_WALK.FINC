	CALL	STANDARD. ,INTEGER_IMAGE_L9
	CALL	STANDARD.IDL.SEM_PHASE_L11.STM_WALK. ,TRIM_L7
	DUP
	La  ,  0
	Sa  1, ANON_197_50_data
	La  ,  8
	Sa  1, ANON_197_50_info
	LId 1, ANON_197_50_info, STRING.LST_1
	INC
	LId 1, ANON_197_50_info, STRING.FST_1
	SUB
	Sa  1, ANON_197_50_len
	La  1, ANON_197_36_len
	La  1, ANON_197_50_len
	ADD
	CO_VAR
	Sa  1, ANON_197_36_disp
	LI	1
	Sd  1, ANON_197_36_info.FST_1
	La  1, ANON_197_36_len
	La  1, ANON_197_50_len
	ADD
	Sd  1, ANON_197_36_info.LST_1
	LI	8
	Sd  1, ANON_197_36_info.COMP_SIZ
	La  1, ANON_197_36_len
	La  1, ANON_197_50_len
	ADD
	LI	8
	MUL
	Sd  1, ANON_197_36_info.SIZ
	LVA 1, ANON_197_36_info.SIZ
	Sa  1, ANON_197_36__u
	La  1, ANON_197_36_disp
	La  1, ANON_197_36_len
	La  1, ANON_197_36_data
	BLKMOV
	La  1, ANON_197_36_disp
	La  1, ANON_197_36_len
	ADD
	La  1, ANON_197_50_len
	La  1, ANON_197_50_data
	BLKMOV
	LVA 1, ANON_197_36_disp
	CALL	STANDARD.IDL.IDL_MAN. ,STORE_SYM_L40
	La  1,	-ID_ofs
	LI  13
	CALL	STANDARD.IDL. ,D_L16
	BRA	L12
L13:
L12:					; post if
ret_lbl:
	UNLINK 1
	RTD	prm_siz
excep:
endPRO					;---------- end PRO CHECK_DUMMY_BLOCK_LOOP_NAME
end if

if defined TRIM_L7_
PRO	TRIM_L7				;---------- PRO TRIM
PRMS					;    debut parametrage
	PRM A_ofs				; in
	PRM result__ofs				; resultat de fonction
endPRMS					;    fin parametrage
ELB 1					;    BODY ELAB
VAR FIRST_disp, d				; variable entiere
	LVA	1, -A_ofs
	LIa	, , 8
	Ld	, STRING.FST_1
	Sd  1,	FIRST_disp

VAR LAST_disp, d				; variable entiere
	LVA	1, -A_ofs
	LIa	, , 8
	Ld	, STRING.LST_1
	Sd  1,	LAST_disp

					;    end elab
begin:					;---------- BDY INSTRUCTIONS
LOOP__12:
	Ld 1,	LAST_disp
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	0
	CGT
	DUP
	BF	L15
	DROP
	LVA	1, -A_ofs
	LIa	, , 0				; array data start address on stack
	Ld 1,	LAST_disp
	LVA	1, -A_ofs
	LIa	, 0,  8
	Ld	, STANDARD.STRING.FST_1			; (index - FST_1) * SIZ_1
	SUB
	LVA	1, -A_ofs
	LIa	, , 8
	Ld	, STANDARD.STRING.COMP_SIZ
	LI	8
	DIV
	MUL
	ADD					; add offset to start address
	Lb
	LI	32
	CEQ
	LVA	1, -A_ofs
	LIa	, , 0				; array data start address on stack
	Ld 1,	LAST_disp
	LVA	1, -A_ofs
	LIa	, 0,  8
	Ld	, STANDARD.STRING.FST_1			; (index - FST_1) * SIZ_1
	SUB
	LVA	1, -A_ofs
	LIa	, , 8
	Ld	, STANDARD.STRING.COMP_SIZ
	LI	8
	DIV
	MUL
	ADD					; add offset to start address
	Lb
	LI	 9
	CEQ
L15:
	BF	L14
	Ld 1,	LAST_disp
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	1
	SUB
	Sd  1,	LAST_disp
	BRA	LOOP__12
L14:					; post loop LOOP__12
					; debut if
	Ld 1,	LAST_disp
	Ld 1,	FIRST_disp
	CGE
	BF	L17
LOOP__13:
	LVA	1, -A_ofs
	LIa	, , 0				; array data start address on stack
	Ld 1,	FIRST_disp
	LVA	1, -A_ofs
	LIa	, 0,  8
	Ld	, STANDARD.STRING.FST_1			; (index - FST_1) * SIZ_1
	SUB
	LVA	1, -A_ofs
	LIa	, , 8
	Ld	, STANDARD.STRING.COMP_SIZ
	LI	8
	DIV
	MUL
	ADD					; add offset to start address
	Lb
	LI	32
	CEQ
	LVA	1, -A_ofs
	LIa	, , 0				; array data start address on stack
	Ld 1,	FIRST_disp
	LVA	1, -A_ofs
	LIa	, 0,  8
	Ld	, STANDARD.STRING.FST_1			; (index - FST_1) * SIZ_1
	SUB
	LVA	1, -A_ofs
	LIa	, , 8
	Ld	, STANDARD.STRING.COMP_SIZ
	LI	8
	DIV
	MUL
	ADD					; add offset to start address
	Lb
	LI	 9
	CEQ
	BF	L18
	Ld 1,	FIRST_disp
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	1
	ADD
	Sd  1,	FIRST_disp
	BRA	LOOP__13
L18:					; post loop LOOP__13
	BRA	L16
L17:
L16:					; post if
namespace	BLOCK__14
ELB 2					;    BODY ELAB
STRING = 'STRING'
namespace STRING				; array var constrained array type info
VAR use__info, q
VAR SIZ, d
	LVA	2, SIZ
	Sa	2, use__info
VAR COMP_SIZ, d
VAR FST_1, d
VAR LST_1, d
	LI	8
	Sd	2, COMP_SIZ
	Ld	2, COMP_SIZ
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	1
	Sd	2, FST_1
	Ld 1,	STANDARD.IDL.SEM_PHASE_L11.STM_WALK.TRIM_L7.LAST_disp
	Ld 1,	STANDARD.IDL.SEM_PHASE_L11.STM_WALK.TRIM_L7.FIRST_disp
	SUB
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	1
	ADD
	Sd	2, LST_1
	Ld	2, LST_1
	INC
	Ld	2, FST_1
	SUB
	MUL
	Sd	2, SIZ
  virtual at 4
COMP_SIZ = $
	rd 1 
FST_1 = $
	rd 1 
LST_1 = $
	rd 1 
  end virtual
end namespace
VAR RESULT_disp, q				; variable array : pointeur aux data
VAR RESULT__u, q				; variable array : useinfo pointeur au rec info
	La 2, STRING.use__info
	Sa	2, RESULT__u				; array info ptr at __u
; COMPILE_ARRAY_VAR ASSOC.TY non gere DN_SLICE

					;    end elab
begin:					;---------- BDY INSTRUCTIONS
; CODE_RETURN : EXPR TYPE = DN_CONSTRAINED_ARRAY
	LVA 2,	RESULT_disp
VAR	RET_INFO_L19, q
	DUP
	La  ,  0
	SIq   1, -result__ofs,  0
	DUP
	La  ,  8
	Sa   2, RET_INFO_L19
	DROP
	La   1, -result__ofs
	La  ,  8
	LI	16
	La   2, RET_INFO_L19
	BLKMOV
	UNLINK 2
	BRA ret_lbl
	UNLINK 2
endPRO
ret_lbl:
	UNLINK 1
	RTD	prm_siz-8
excep:
endPRO					;---------- end PRO TRIM
end if

if defined WALK_STM_S_L2_
