if defined DECLARE_LABEL_BLOCK_LOOP_IDS_L1_
PRO	DECLARE_LABEL_BLOCK_LOOP_IDS_L1		;---------- PRO DECLARE_LABEL_BLOCK_LOOP_IDS
PRMS					;    debut parametrage
	PRM STM_S_ofs				; in
	PRM H_ofs				; in
endPRMS					;    fin parametrage
ELB 1					;    BODY ELAB
VAR STM_LIST_disp, q			; variable record : pointeur aux data record
VAR STM_LIST__u, q				; variable record : pointeur aux useinfo
VAR STM_LIST__dat, STANDARD.IDL.SEQ_TYPE.size
	LVA	1, STM_LIST__dat
	Sa	1, STM_LIST_disp			; record fin
	LVA	1, STANDARD.IDL.SEQ_TYPE.SIZ
	Sa	1, STM_LIST__u
; CODE_VC_NAME DN_VARIABLE_ID
	La  1, STM_LIST_disp
	LI	STANDARD.IDL.SEQ_TYPE.size
VAR	ANON_41_28_disp, q
VAR	ANON_41_28__u,    q
VAR	ANON_41_28__dat, STANDARD.IDL.SEQ_TYPE.size
	LVA 1, ANON_41_28__dat
	Sa  1, ANON_41_28_disp
	La  0, STANDARD.IDL.SEQ_TYPE.use__info
	Sa  1, ANON_41_28__u
	LVA 1, ANON_41_28_disp
					; doublet resultat record anonyme
	La  1,	-STM_S_ofs
	CALL	STANDARD.IDL. ,LIST_L22
	La  ,  0
	BLKMOV

VAR STM_disp, q				; variable record : pointeur aux data record
VAR STM__u, q				; variable record : pointeur aux useinfo
VAR STM__dat, STANDARD.IDL.TREE.size
	LVA	1, STM__dat
	Sa	1, STM_disp				; record fin
	LVA	1, STANDARD.IDL.TREE.SIZ
	Sa	1, STM__u
; CODE_VC_NAME DN_VARIABLE_ID

					;    end elab
begin:					;---------- BDY INSTRUCTIONS
LOOP__1:
	LI	0					; lieu resultat sur pile
	LVA 1,	STM_LIST_disp
	CALL	STANDARD.IDL. ,IS_EMPTY_L23
	LI	1
	OUX
	BF	L8
	LVA  1,	STM_disp
	LVA  1,	STM_LIST_disp
	CALL	STANDARD.IDL. ,POP_L24
					; debut if
	LIb	1, STM_disp, STANDARD.IDL.TREE.TY
	LI	108
	CEQ
	BF	L10
namespace	BLOCK__2
ELB 2					;    BODY ELAB
VAR SOURCE_NAME_S_disp, q			; variable record : pointeur aux data record
VAR SOURCE_NAME_S__u, q			; variable record : pointeur aux useinfo
VAR SOURCE_NAME_S__dat, STANDARD.IDL.TREE.size
	LVA	2, SOURCE_NAME_S__dat
	Sa	2, SOURCE_NAME_S_disp			; record fin
	LVA	2, STANDARD.IDL.TREE.SIZ
	Sa	2, SOURCE_NAME_S__u
; CODE_VC_NAME DN_CONSTANT_ID
	La  2, SOURCE_NAME_S_disp
	LI	STANDARD.IDL.TREE.size
VAR	ANON_52_35_disp, q
VAR	ANON_52_35__u,    q
VAR	ANON_52_35__dat, STANDARD.IDL.TREE.size
	LVA 2, ANON_52_35__dat
	Sa  2, ANON_52_35_disp
	La  0, STANDARD.IDL.TREE.use__info
	Sa  2, ANON_52_35__u
	LVA 2, ANON_52_35_disp
					; doublet resultat record anonyme
	LVA 1,	STANDARD.IDL.SEM_PHASE_L11.STM_WALK.DECLARE_LABEL_BLOCK_LOOP_IDS_L1.STM_disp
	LI  21
	CALL	STANDARD.IDL. ,D_L17
	La  ,  0
	BLKMOV

VAR STM_NODE_disp, q			; variable record : pointeur aux data record
VAR STM_NODE__u, q				; variable record : pointeur aux useinfo
VAR STM_NODE__dat, STANDARD.IDL.TREE.size
	LVA	2, STM_NODE__dat
	Sa	2, STM_NODE_disp			; record fin
	LVA	2, STANDARD.IDL.TREE.SIZ
	Sa	2, STM_NODE__u
; CODE_VC_NAME DN_CONSTANT_ID
	La  2, STM_NODE_disp
	LI	STANDARD.IDL.TREE.size
VAR	ANON_53_34_disp, q
VAR	ANON_53_34__u,    q
VAR	ANON_53_34__dat, STANDARD.IDL.TREE.size
	LVA 2, ANON_53_34__dat
	Sa  2, ANON_53_34_disp
	La  0, STANDARD.IDL.TREE.use__info
	Sa  2, ANON_53_34__u
	LVA 2, ANON_53_34_disp
					; doublet resultat record anonyme
	LVA 1,	STANDARD.IDL.SEM_PHASE_L11.STM_WALK.DECLARE_LABEL_BLOCK_LOOP_IDS_L1.STM_disp
	LI  98
	CALL	STANDARD.IDL. ,D_L17
	La  ,  0
	BLKMOV

VAR SOURCE_NAME_LIST_disp, q			; variable record : pointeur aux data record
VAR SOURCE_NAME_LIST__u, q			; variable record : pointeur aux useinfo
VAR SOURCE_NAME_LIST__dat, STANDARD.IDL.SEQ_TYPE.size
	LVA	2, SOURCE_NAME_LIST__dat
	Sa	2, SOURCE_NAME_LIST_disp			; record fin
	LVA	2, STANDARD.IDL.SEQ_TYPE.SIZ
	Sa	2, SOURCE_NAME_LIST__u
; CODE_VC_NAME DN_VARIABLE_ID
	La  2, SOURCE_NAME_LIST_disp
	LI	STANDARD.IDL.SEQ_TYPE.size
VAR	ANON_55_33_disp, q
VAR	ANON_55_33__u,    q
VAR	ANON_55_33__dat, STANDARD.IDL.SEQ_TYPE.size
	LVA 2, ANON_55_33__dat
	Sa  2, ANON_55_33_disp
	La  0, STANDARD.IDL.SEQ_TYPE.use__info
	Sa  2, ANON_55_33__u
	LVA 2, ANON_55_33_disp
					; doublet resultat record anonyme
	CALL	STANDARD.IDL. ,LIST_L22
	La  ,  0
	BLKMOV

VAR SOURCE_NAME_disp, q			; variable record : pointeur aux data record
VAR SOURCE_NAME__u, q			; variable record : pointeur aux useinfo
VAR SOURCE_NAME__dat, STANDARD.IDL.TREE.size
	LVA	2, SOURCE_NAME__dat
	Sa	2, SOURCE_NAME_disp			; record fin
	LVA	2, STANDARD.IDL.TREE.SIZ
	Sa	2, SOURCE_NAME__u
; CODE_VC_NAME DN_VARIABLE_ID

					;    end elab
begin:					;---------- BDY INSTRUCTIONS
LOOP__9:
	LI	0					; lieu resultat sur pile
	LVA 2,	SOURCE_NAME_LIST_disp
	CALL	STANDARD.IDL. ,IS_EMPTY_L23
	LI	1
	OUX
	BF	L11
	LVA  2,	SOURCE_NAME_disp
	LVA  2,	SOURCE_NAME_LIST_disp
	CALL	STANDARD.IDL. ,POP_L24
	La  1,	-H_ofs
	LVA 2,	SOURCE_NAME_disp
	CALL	STANDARD.IDL.SEM_PHASE_L11.STM_WALK. ,DECLARE_ONE_LABEL_BLOCK_LOOP_ID_L5
	BRA	LOOP__9
L11:					; post loop LOOP__9
	LVA 1,	STANDARD.IDL.SEM_PHASE_L11.STM_WALK.DECLARE_LABEL_BLOCK_LOOP_IDS_L1.STM_disp
	La
	LI	STANDARD.IDL.TREE.size
	LVA 2,	STM_NODE_disp
	La
	BLKMOV
	UNLINK 2
endPRO
	BRA	L9
L10:
L9:					; post if
	BRA	LOOP__1
L8:					; post loop LOOP__1
ret_lbl:
	UNLINK 1
	RTD	prm_siz
excep:
endPRO					;---------- end PRO DECLARE_LABEL_BLOCK_LOOP_IDS
end if

if defined DECLARE_ONE_LABEL_BLOCK_LOOP_ID_L5_
PRO	DECLARE_ONE_LABEL_BLOCK_LOOP_ID_L5		;---------- PRO DECLARE_ONE_LABEL_BLOCK_LOOP_ID
