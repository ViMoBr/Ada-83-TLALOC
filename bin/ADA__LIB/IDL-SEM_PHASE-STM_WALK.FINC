	LVA 0,	STANDARD.IDL.TREE_VOID_disp
	CEQ
	BF	L13
	Ld 0,	STANDARD.IDL.SEM_PHASE_L11.STM_WALK.GEN_BLOCK_LOOP_COUNT_disp
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	1
	ADD
	Sd  0,	GEN_BLOCK_LOOP_COUNT_disp
VAR	ANON_197_25_disp, q
VAR	ANON_197_25__u,    q
VAR	ANON_197_25__dat, STANDARD.IDL.TREE.size
	LVA 1, ANON_197_25__dat
	Sa  1, ANON_197_25_disp
	La  0, STANDARD.IDL.TREE.use__info
	Sa  1, ANON_197_25__u
	LVA 1, ANON_197_25_disp
					; doublet resultat record anonyme
; CODE & concat STRING
VAR	ANON_197_36_data, q
VAR	ANON_197_36_info, q
VAR	ANON_197_50_data, q
VAR	ANON_197_50_info, q
VAR	ANON_197_36_len,  q
VAR	ANON_197_50_len,  q
VAR	ANON_197_36_disp, q
VAR	ANON_197_36__u,   q
namespace ANON_197_36_info
  VAR SIZ,      d
  VAR COMP_SIZ, d
  VAR FST_1,    d
  VAR LST_1,    d
end namespace
	La  1,	-PREFIX_TEXT_ofs
