if defined CHECK_DUMMY_BLOCK_LOOP_NAME_L6_
PRO	CHECK_DUMMY_BLOCK_LOOP_NAME_L6		;---------- PRO CHECK_DUMMY_BLOCK_LOOP_NAME
PRMS					;    debut parametrage
	PRM ID_ofs				; in
	PRM PREFIX_TEXT_ofs			; in
endPRMS					;    fin parametrage
ELB 1					;    BODY ELAB
					;    end elab
begin:					;---------- BDY INSTRUCTIONS
					; debut if
VAR	ANON_195_8_disp, q
VAR	ANON_195_8__u,    q
