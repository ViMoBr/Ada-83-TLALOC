	CALL	STANDARD.IDL.IDL_MAN. ,ERROR_L45
	BRA	L16
L17:
L16:					; post if
ret_lbl:
	UNLINK 1
	RTD	prm_siz
excep:
endPRO					;---------- end PRO REQUIRE_CURRENT_REGION
end if

