					; doublet resultat record anonyme
	LVA 1,	TEMP_DEF_disp
	LI  169
	CALL	STANDARD.IDL. ,D_L17
	La  ,  0
	Ld
	La 1, -H_ofs
	LIVA 	, 0, STANDARD.IDL.SEM_PHASE_L11.SEM_GLOB._H_TYPE.REGION_DEF
	Ld
	CEQ
	DUP
	BF	L9
	DROP
	La 1, -H_ofs
	ULIb	, 0, STANDARD.IDL.SEM_PHASE_L11.SEM_GLOB._H_TYPE.IS_IN_BODY
	LI	0					; lieu resultat sur pile
	LVA 1,	TEMP_DEF_disp
	LI  170
	CALL	STANDARD.IDL. ,DB_L19
	ET
	LI	1
	OUX
L9:
	BF	L8
	LVA 1,	SOURCE_NAME_disp
	La
	LI	STANDARD.IDL._TREE.size
VAR	ANON_42_24_disp, q
VAR	ANON_42_24__u,    q
VAR	ANON_42_24__dat, STANDARD.IDL._TREE.size
	LVA 1, ANON_42_24__dat
	Sa  1, ANON_42_24_disp
	La  0, STANDARD.IDL._TREE.use__info
	Sa  1, ANON_42_24__u
	LVA 1, ANON_42_24_disp
					; doublet resultat record anonyme
	LVA 1,	TEMP_DEF_disp
	LI  35
	CALL	STANDARD.IDL. ,D_L17
	La
	BLKMOV
					; debut if
	La	1, STANDARD.IDL.SEM_PHASE_L11.REP_CLAU.REQUIRE_CURRENT_REGION_L1.SOURCE_NAME_disp
	Ld
	LI	24
	LI	8
	UBFX
	LI	40
	CEQ
	BF	L11
	BRA	L10
L11:
	La	1, STANDARD.IDL.SEM_PHASE_L11.REP_CLAU.REQUIRE_CURRENT_REGION_L1.SOURCE_NAME_disp
	Ld
	LI	24
	LI	8
	UBFX
	ULb	0, STANDARD.DIANA_NODE_ATTR_CLASS_NAMES._CLASS_SUBPROG_NAME.FST
	CGE
	ULb	0, STANDARD.DIANA_NODE_ATTR_CLASS_NAMES._CLASS_SUBPROG_NAME.LST
	La	1, STANDARD.IDL.SEM_PHASE_L11.REP_CLAU.REQUIRE_CURRENT_REGION_L1.SOURCE_NAME_disp
	Ld
	LI	24
	LI	8
	UBFX
	CGE
	ET
	BF	L12
	LVA 1,	UNIT_DESC_disp
	La
	LI	STANDARD.IDL._TREE.size
VAR	ANON_46_15_disp, q
VAR	ANON_46_15__u,    q
VAR	ANON_46_15__dat, STANDARD.IDL._TREE.size
	LVA 1, ANON_46_15__dat
	Sa  1, ANON_46_15_disp
	La  0, STANDARD.IDL._TREE.use__info
	Sa  1, ANON_46_15__u
	LVA 1, ANON_46_15_disp
					; doublet resultat record anonyme
	LVA 1,	SOURCE_NAME_disp
	LI  112
	CALL	STANDARD.IDL. ,D_L17
	La
	BLKMOV
					; debut if
	La	1, STANDARD.IDL.SEM_PHASE_L11.REP_CLAU.REQUIRE_CURRENT_REGION_L1.UNIT_DESC_disp
	Ld
	LI	24
	LI	8
	UBFX
	LI	168
	CNE
	DUP
	BF	L15
	DROP
	La	1, STANDARD.IDL.SEM_PHASE_L11.REP_CLAU.REQUIRE_CURRENT_REGION_L1.UNIT_DESC_disp
	Ld
	LI	24
	LI	8
