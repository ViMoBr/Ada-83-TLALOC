REP_CLAU = 'REP_CLAU'
namespace REP_CLAU				;---------- PACKAGE (BDY)
					;    BODY ELAB

if defined REQUIRE_CURRENT_REGION_L1_
PRO	REQUIRE_CURRENT_REGION_L1			;---------- PRO REQUIRE_CURRENT_REGION
PRMS					;    debut parametrage
	PRM NAME_ofs				; in
	PRM DEFSET_ofs				; in out
	PRM H_ofs				; in
endPRMS					;    fin parametrage
ELB 1					;    BODY ELAB
VAR TEMP_DEFSET_disp, q			; variable record : pointeur aux data record
VAR TEMP_DEFSET__u, q			; variable record : pointeur aux useinfo
VAR TEMP_DEFSET__dat, STANDARD.IDL.SEM_PHASE_L11.SET_UTIL._DEFSET_TYPE.size
	LVA	1, TEMP_DEFSET__dat
	Sa	1, TEMP_DEFSET_disp			; record fin
	LVA	1, STANDARD.IDL.SEM_PHASE_L11.SET_UTIL._DEFSET_TYPE.SIZ
	Sa	1, TEMP_DEFSET__u
; CODE_VC_NAME DN_VARIABLE_ID
	La  1, TEMP_DEFSET_disp
	LI	STANDARD.IDL.SEM_PHASE_L11.SET_UTIL._DEFSET_TYPE.size
	La  1,	-DEFSET_ofs
	La  ,  0
	BLKMOV

VAR TEMP_DEFINTERP_disp, q			; variable record : pointeur aux data record
VAR TEMP_DEFINTERP__u, q			; variable record : pointeur aux useinfo
VAR TEMP_DEFINTERP__dat, STANDARD.IDL.SEM_PHASE_L11.SET_UTIL._DEFINTERP_TYPE.size
	LVA	1, TEMP_DEFINTERP__dat
	Sa	1, TEMP_DEFINTERP_disp			; record fin
	LVA	1, STANDARD.IDL.SEM_PHASE_L11.SET_UTIL._DEFINTERP_TYPE.SIZ
	Sa	1, TEMP_DEFINTERP__u
; CODE_VC_NAME DN_VARIABLE_ID

VAR TEMP_DEF_disp, q			; variable record : pointeur aux data record
VAR TEMP_DEF__u, q				; variable record : pointeur aux useinfo
VAR TEMP_DEF__dat, STANDARD.IDL._TREE.size
	LVA	1, TEMP_DEF__dat
	Sa	1, TEMP_DEF_disp			; record fin
	LVA	1, STANDARD.IDL._TREE.SIZ
	Sa	1, TEMP_DEF__u
; CODE_VC_NAME DN_VARIABLE_ID

VAR SOURCE_NAME_disp, q			; variable record : pointeur aux data record
VAR SOURCE_NAME__u, q			; variable record : pointeur aux useinfo
VAR SOURCE_NAME__dat, STANDARD.IDL._TREE.size
	LVA	1, SOURCE_NAME__dat
	Sa	1, SOURCE_NAME_disp			; record fin
	LVA	1, STANDARD.IDL._TREE.SIZ
	Sa	1, SOURCE_NAME__u
; CODE_VC_NAME DN_VARIABLE_ID

VAR UNIT_DESC_disp, q			; variable record : pointeur aux data record
VAR UNIT_DESC__u, q				; variable record : pointeur aux useinfo
VAR UNIT_DESC__dat, STANDARD.IDL._TREE.size
	LVA	1, UNIT_DESC__dat
	Sa	1, UNIT_DESC_disp			; record fin
	LVA	1, STANDARD.IDL._TREE.SIZ
	Sa	1, UNIT_DESC__u
; CODE_VC_NAME DN_VARIABLE_ID

					;    end elab
begin:					;---------- BDY INSTRUCTIONS
					; debut if
	LI	0					; lieu resultat sur pile
	LVA 1,	TEMP_DEFSET_disp
	CALL	STANDARD.IDL.SEM_PHASE_L11.SET_UTIL. ,IS_EMPTY_L74
	BF	L3
	BRA ret_lbl
	BRA	L2
L3:
L2:					; post if
	La  1,	-DEFSET_ofs
	La
	LI	STANDARD.IDL.SEM_PHASE_L11.SET_UTIL._DEFSET_TYPE.size
	LVA 1,	STANDARD.IDL.SEM_PHASE_L11.SET_UTIL.EMPTY_DEFSET_disp
	La
	BLKMOV
LOOP__1:
	LI	0					; lieu resultat sur pile
	LVA 1,	TEMP_DEFSET_disp
	CALL	STANDARD.IDL.SEM_PHASE_L11.SET_UTIL. ,IS_EMPTY_L74
	LI	1
	OUX
	BF	L4
	LVA  1,	TEMP_DEFINTERP_disp
	LVA  1,	TEMP_DEFSET_disp
	CALL	STANDARD.IDL.SEM_PHASE_L11.SET_UTIL. ,POP_L75
	LVA 1,	TEMP_DEF_disp
	La
	LI	STANDARD.IDL._TREE.size
VAR	ANON_38_19_disp, q
VAR	ANON_38_19__u,    q
VAR	ANON_38_19__dat, STANDARD.IDL._TREE.size
	LVA 1, ANON_38_19__dat
	Sa  1, ANON_38_19_disp
	La  0, STANDARD.IDL._TREE.use__info
	Sa  1, ANON_38_19__u
	LVA 1, ANON_38_19_disp
					; doublet resultat record anonyme
	LVA 1,	TEMP_DEFINTERP_disp
	CALL	STANDARD.IDL.SEM_PHASE_L11.SET_UTIL. ,GET_DEF_L82
	La
	BLKMOV
					; debut if
VAR	ANON_40_10_disp, q
VAR	ANON_40_10__u,    q
VAR	ANON_40_10__dat, STANDARD.IDL._TREE.size
	LVA 1, ANON_40_10__dat
	Sa  1, ANON_40_10_disp
	La  0, STANDARD.IDL._TREE.use__info
	Sa  1, ANON_40_10__u
	LVA 1, ANON_40_10_disp
					; doublet resultat record anonyme
	LVA 1,	TEMP_DEF_disp
	LI  169
	CALL	STANDARD.IDL. ,D_L17
	La 1, -H_ofs
	LIVA 	, 0, STANDARD.IDL.SEM_PHASE_L11.SEM_GLOB._H_TYPE.REGION_DEF
	CEQ
	DUP
	BF	L7
	DROP
	La 1, -H_ofs
	LIb	, 0, STANDARD.IDL.SEM_PHASE_L11.SEM_GLOB._H_TYPE.IS_IN_BODY
	LI	0					; lieu resultat sur pile
	LVA 1,	TEMP_DEF_disp
	LI  170
	CALL	STANDARD.IDL. ,DB_L19
	LI	1
	OUX
L7:
	BF	L6
	LVA 1,	SOURCE_NAME_disp
	La
	LI	STANDARD.IDL._TREE.size
VAR	ANON_42_24_disp, q
VAR	ANON_42_24__u,    q
VAR	ANON_42_24__dat, STANDARD.IDL._TREE.size
	LVA 1, ANON_42_24__dat
	Sa  1, ANON_42_24_disp
	La  0, STANDARD.IDL._TREE.use__info
	Sa  1, ANON_42_24__u
	LVA 1, ANON_42_24_disp
					; doublet resultat record anonyme
	LVA 1,	TEMP_DEF_disp
	LI  35
	CALL	STANDARD.IDL. ,D_L17
	La
	BLKMOV
					; debut if
	La	1, SOURCE_NAME_disp
	Ld
	LI	24
	LI	8
	UBFX
	LI	40
	CEQ
	BF	L9
	BRA	L8
L9:
	BF	L10
	LVA 1,	UNIT_DESC_disp
	La
	LI	STANDARD.IDL._TREE.size
VAR	ANON_46_15_disp, q
VAR	ANON_46_15__u,    q
VAR	ANON_46_15__dat, STANDARD.IDL._TREE.size
	LVA 1, ANON_46_15__dat
	Sa  1, ANON_46_15_disp
	La  0, STANDARD.IDL._TREE.use__info
	Sa  1, ANON_46_15__u
	LVA 1, ANON_46_15_disp
					; doublet resultat record anonyme
	LVA 1,	SOURCE_NAME_disp
	LI  112
	CALL	STANDARD.IDL. ,D_L17
	La
	BLKMOV
					; debut if
	La	1, UNIT_DESC_disp
	Ld
	LI	24
	LI	8
	UBFX
	LI	168
	CNE
	DUP
	BF	L13
	DROP
L13:
	BF	L12
	LVA 1,	TEMP_DEFINTERP_disp
	La  1,	-DEFSET_ofs
	CALL	STANDARD.IDL.SEM_PHASE_L11.SET_UTIL. ,ADD_TO_DEFSET_L80
	BRA	L11
L12:
L11:					; post if
	BRA	L8
L10:
	LVA 1,	TEMP_DEFINTERP_disp
	La  1,	-DEFSET_ofs
	CALL	STANDARD.IDL.SEM_PHASE_L11.SET_UTIL. ,ADD_TO_DEFSET_L80
L8:					; post if
	BRA	L5
L6:
L5:					; post if
	BRA	LOOP__1
L4:					; post loop LOOP__1
					; debut if
	LI	0					; lieu resultat sur pile
	LIq  1,	-DEFSET_ofs
	CALL	STANDARD.IDL.SEM_PHASE_L11.SET_UTIL. ,IS_EMPTY_L74
	BF	L15
STR STR_L16, "MUST BE IN CURRENT REGION"	; constante string="MUST BE IN CURRENT REGION"
	LCA	STR_L16.data_ptr
VAR	ANON_57_14_disp, q
VAR	ANON_57_14__u,    q
VAR	ANON_57_14__dat, STANDARD.IDL._TREE.size
	LVA 1, ANON_57_14__dat
	Sa  1, ANON_57_14_disp
	La  0, STANDARD.IDL._TREE.use__info
	Sa  1, ANON_57_14__u
	LVA 1, ANON_57_14_disp
					; doublet resultat record anonyme
	La  1,	-NAME_ofs
	LI  154
	CALL	STANDARD.IDL. ,D_L17
	CALL	STANDARD.IDL.IDL_MAN. ,ERROR_L45
	BRA	L14
L15:
L14:					; post if
ret_lbl:
	UNLINK 1
	RTD	prm_siz
excep:
endPRO					;---------- end PRO REQUIRE_CURRENT_REGION
end if

