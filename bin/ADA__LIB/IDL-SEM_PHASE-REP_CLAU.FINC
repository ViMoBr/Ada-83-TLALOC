REP_CLAU = 'REP_CLAU'
namespace REP_CLAU				;---------- PACKAGE
elab_spec:				;    SPEC ELAB

					;    BODY ELAB

if defined REQUIRE_CURRENT_REGION_L5_
PRO	REQUIRE_CURRENT_REGION_L5			;---------- PRO REQUIRE_CURRENT_REGION
PRMS					;    debut parametrage
	PRM NAME_ofs				; in
	PRM DEFSET_ofs				; in out
	PRM H_ofs				; in
endPRMS					;    fin parametrage
ELB 1					;    BODY ELAB
VAR TEMP_DEFSET_disp, q			; variable record : pointeur aux data record
VAR TEMP_DEFSET__u, q			; variable record : pointeur aux useinfo
VAR TEMP_DEFSET__dat, STANDARD.IDL.SEM_PHASE_L11.SET_UTIL.DEFSET_TYPE.size
	LVA	1, TEMP_DEFSET__dat
	Sa	1, TEMP_DEFSET_disp			; record fin
	LVA	1, STANDARD.IDL.SEM_PHASE_L11.SET_UTIL.DEFSET_TYPE.SIZ
	Sa	1, TEMP_DEFSET__u
; CODE_VC_NAME DN_VARIABLE_ID
	La  1, TEMP_DEFSET_disp
	LI	STANDARD.IDL.SEM_PHASE_L11.SET_UTIL.DEFSET_TYPE.size
	La  1,	-DEFSET_ofs
	La  ,  0
	BLKMOV

VAR TEMP_DEFINTERP_disp, q			; variable record : pointeur aux data record
VAR TEMP_DEFINTERP__u, q			; variable record : pointeur aux useinfo
VAR TEMP_DEFINTERP__dat, STANDARD.IDL.SEM_PHASE_L11.SET_UTIL.DEFINTERP_TYPE.size
	LVA	1, TEMP_DEFINTERP__dat
	Sa	1, TEMP_DEFINTERP_disp			; record fin
	LVA	1, STANDARD.IDL.SEM_PHASE_L11.SET_UTIL.DEFINTERP_TYPE.SIZ
	Sa	1, TEMP_DEFINTERP__u
; CODE_VC_NAME DN_VARIABLE_ID

VAR TEMP_DEF_disp, q			; variable record : pointeur aux data record
VAR TEMP_DEF__u, q				; variable record : pointeur aux useinfo
VAR TEMP_DEF__dat, STANDARD.IDL.TREE.size
	LVA	1, TEMP_DEF__dat
	Sa	1, TEMP_DEF_disp			; record fin
	LVA	1, STANDARD.IDL.TREE.SIZ
	Sa	1, TEMP_DEF__u
; CODE_VC_NAME DN_VARIABLE_ID

VAR SOURCE_NAME_disp, q			; variable record : pointeur aux data record
VAR SOURCE_NAME__u, q			; variable record : pointeur aux useinfo
VAR SOURCE_NAME__dat, STANDARD.IDL.TREE.size
	LVA	1, SOURCE_NAME__dat
	Sa	1, SOURCE_NAME_disp			; record fin
	LVA	1, STANDARD.IDL.TREE.SIZ
	Sa	1, SOURCE_NAME__u
; CODE_VC_NAME DN_VARIABLE_ID

VAR UNIT_DESC_disp, q			; variable record : pointeur aux data record
VAR UNIT_DESC__u, q				; variable record : pointeur aux useinfo
VAR UNIT_DESC__dat, STANDARD.IDL.TREE.size
	LVA	1, UNIT_DESC__dat
	Sa	1, UNIT_DESC_disp			; record fin
	LVA	1, STANDARD.IDL.TREE.SIZ
	Sa	1, UNIT_DESC__u
; CODE_VC_NAME DN_VARIABLE_ID

					;    end elab
begin:					;---------- BDY INSTRUCTIONS
					; debut if
	LI	0					; lieu resultat sur pile
	LVA 1,	TEMP_DEFSET_disp
	CALL	STANDARD.IDL.SEM_PHASE_L11.SET_UTIL. ,IS_EMPTY_L74
	BF	L7
	BRA ret_lbl
	BRA	L6
L7:
L6:					; post if
	La  1,	-DEFSET_ofs
	La
	LI	STANDARD.IDL.SEM_PHASE_L11.SET_UTIL.DEFSET_TYPE.size
	LVA 1,	STANDARD.IDL.SEM_PHASE_L11.SET_UTIL.EMPTY_DEFSET_disp
	La
	BLKMOV
LOOP__1:
	LI	0					; lieu resultat sur pile
	LVA 1,	TEMP_DEFSET_disp
	CALL	STANDARD.IDL.SEM_PHASE_L11.SET_UTIL. ,IS_EMPTY_L74
	LI	1
	OUX
	BF	L8
	LVA  1,	TEMP_DEFINTERP_disp
	LVA  1,	TEMP_DEFSET_disp
	CALL	STANDARD.IDL.SEM_PHASE_L11.SET_UTIL. ,POP_L75
	LVA 1,	TEMP_DEF_disp
	La
	LI	STANDARD.IDL.TREE.size
VAR	ANON_38_19_disp, q
VAR	ANON_38_19__u,    q
VAR	ANON_38_19__dat, STANDARD.IDL.TREE.size
	LVA 1, ANON_38_19__dat
	Sa  1, ANON_38_19_disp
	La  0, STANDARD.IDL.TREE.use__info
	Sa  1, ANON_38_19__u
	LVA 1, ANON_38_19_disp
					; doublet resultat record anonyme
	LVA 1,	TEMP_DEFINTERP_disp
	CALL	STANDARD.IDL.SEM_PHASE_L11.SET_UTIL. ,GET_DEF_L82
	La
	BLKMOV
					; debut if
VAR	ANON_40_10_disp, q
VAR	ANON_40_10__u,    q
VAR	ANON_40_10__dat, STANDARD.IDL.TREE.size
	LVA 1, ANON_40_10__dat
	Sa  1, ANON_40_10_disp
	La  0, STANDARD.IDL.TREE.use__info
	Sa  1, ANON_40_10__u
	LVA 1, ANON_40_10_disp
					; doublet resultat record anonyme
	LVA 1,	TEMP_DEF_disp
	LI  169
	CALL	STANDARD.IDL. ,D_L17
	La 1, -H_ofs
	LIVA 	, 0, STANDARD.IDL.SEM_PHASE_L11.SEM_GLOB.H_TYPE.REGION_DEF
	CEQ
	DUP
	BF	L11
	DROP
	La 1, -H_ofs
	LIb	, 0, STANDARD.IDL.SEM_PHASE_L11.SEM_GLOB.H_TYPE.IS_IN_BODY
	LI	0					; lieu resultat sur pile
	LVA 1,	TEMP_DEF_disp
	LI  170
	CALL	STANDARD.IDL. ,DB_L19
	LI	1
	OUX
L11:
	BF	L10
	LVA 1,	SOURCE_NAME_disp
	La
	LI	STANDARD.IDL.TREE.size
VAR	ANON_42_24_disp, q
VAR	ANON_42_24__u,    q
VAR	ANON_42_24__dat, STANDARD.IDL.TREE.size
	LVA 1, ANON_42_24__dat
	Sa  1, ANON_42_24_disp
	La  0, STANDARD.IDL.TREE.use__info
	Sa  1, ANON_42_24__u
	LVA 1, ANON_42_24_disp
					; doublet resultat record anonyme
	LVA 1,	TEMP_DEF_disp
	LI  35
	CALL	STANDARD.IDL. ,D_L17
	La
	BLKMOV
					; debut if
	LIb	1, SOURCE_NAME_disp, STANDARD.IDL.TREE.TY
	LI	40
	CEQ
	BF	L13
	BRA	L12
L13:
	BF	L14
	LVA 1,	UNIT_DESC_disp
	La
	LI	STANDARD.IDL.TREE.size
VAR	ANON_46_15_disp, q
VAR	ANON_46_15__u,    q
VAR	ANON_46_15__dat, STANDARD.IDL.TREE.size
	LVA 1, ANON_46_15__dat
	Sa  1, ANON_46_15_disp
	La  0, STANDARD.IDL.TREE.use__info
	Sa  1, ANON_46_15__u
	LVA 1, ANON_46_15_disp
					; doublet resultat record anonyme
	LVA 1,	SOURCE_NAME_disp
	LI  112
	CALL	STANDARD.IDL. ,D_L17
	La
	BLKMOV
					; debut if
	LIb	1, UNIT_DESC_disp, STANDARD.IDL.TREE.TY
	LI	168
	CNE
	DUP
	BF	L17
	DROP
L17:
	BF	L16
	LVA 1,	TEMP_DEFINTERP_disp
	La  1,	-DEFSET_ofs
	CALL	STANDARD.IDL.SEM_PHASE_L11.SET_UTIL. ,ADD_TO_DEFSET_L80
	BRA	L15
L16:
L15:					; post if
	BRA	L12
L14:
	LVA 1,	TEMP_DEFINTERP_disp
	La  1,	-DEFSET_ofs
	CALL	STANDARD.IDL.SEM_PHASE_L11.SET_UTIL. ,ADD_TO_DEFSET_L80
L12:					; post if
	BRA	L9
L10:
L9:					; post if
	BRA	LOOP__1
L8:					; post loop LOOP__1
					; debut if
	LI	0					; lieu resultat sur pile
	LIq  1,	-DEFSET_ofs
	CALL	STANDARD.IDL.SEM_PHASE_L11.SET_UTIL. ,IS_EMPTY_L74
	BF	L19
STR STR_L20, "MUST BE IN CURRENT REGION"	; constante string="MUST BE IN CURRENT REGION"
	LCA	STR_L20.data_ptr
VAR	ANON_57_14_disp, q
VAR	ANON_57_14__u,    q
VAR	ANON_57_14__dat, STANDARD.IDL.TREE.size
	LVA 1, ANON_57_14__dat
	Sa  1, ANON_57_14_disp
	La  0, STANDARD.IDL.TREE.use__info
	Sa  1, ANON_57_14__u
	LVA 1, ANON_57_14_disp
					; doublet resultat record anonyme
	La  1,	-NAME_ofs
	LI  154
	CALL	STANDARD.IDL. ,D_L17
	CALL	STANDARD.IDL.IDL_MAN. ,ERROR_L45
	BRA	L18
L19:
L18:					; post if
ret_lbl:
	UNLINK 1
	RTD	prm_siz
excep:
endPRO					;---------- end PRO REQUIRE_CURRENT_REGION
end if

if defined RESOLVE_LENGTH_REP_L1_
PRO	RESOLVE_LENGTH_REP_L1			;---------- PRO RESOLVE_LENGTH_REP
PRMS					;    debut parametrage
	PRM ATTRIBUTE_ofs				; in
	PRM EXP_ofs				; in out
	PRM H_ofs				; in
endPRMS					;    fin parametrage
ELB 1					;    BODY ELAB
VAR ATTRIBUTE_ID_disp, q			; variable record : pointeur aux data record
VAR ATTRIBUTE_ID__u, q			; variable record : pointeur aux useinfo
VAR ATTRIBUTE_ID__dat, STANDARD.IDL.TREE.size
	LVA	1, ATTRIBUTE_ID__dat
	Sa	1, ATTRIBUTE_ID_disp			; record fin
	LVA	1, STANDARD.IDL.TREE.SIZ
	Sa	1, ATTRIBUTE_ID__u
; CODE_VC_NAME DN_VARIABLE_ID

VAR PREFIX_disp, q				; variable record : pointeur aux data record
VAR PREFIX__u, q				; variable record : pointeur aux useinfo
VAR PREFIX__dat, STANDARD.IDL.TREE.size
	LVA	1, PREFIX__dat
	Sa	1, PREFIX_disp				; record fin
	LVA	1, STANDARD.IDL.TREE.SIZ
	Sa	1, PREFIX__u
; CODE_VC_NAME DN_VARIABLE_ID
	La  1, PREFIX_disp
	LI	STANDARD.IDL.TREE.size
VAR	ANON_65_28_disp, q
VAR	ANON_65_28__u,    q
VAR	ANON_65_28__dat, STANDARD.IDL.TREE.size
	LVA 1, ANON_65_28__dat
	Sa  1, ANON_65_28_disp
	La  0, STANDARD.IDL.TREE.use__info
	Sa  1, ANON_65_28__u
	LVA 1, ANON_65_28_disp
					; doublet resultat record anonyme
	La  1,	-ATTRIBUTE_ofs
	LI  48
	CALL	STANDARD.IDL. ,D_L17
	La  ,  0
	BLKMOV

VAR PREFIX_TYPE_disp, q			; variable record : pointeur aux data record
VAR PREFIX_TYPE__u, q			; variable record : pointeur aux useinfo
VAR PREFIX_TYPE__dat, STANDARD.IDL.TREE.size
	LVA	1, PREFIX_TYPE__dat
	Sa	1, PREFIX_TYPE_disp			; record fin
	LVA	1, STANDARD.IDL.TREE.SIZ
	Sa	1, PREFIX_TYPE__u
; CODE_VC_NAME DN_VARIABLE_ID
	La  1, PREFIX_TYPE_disp
	LI	STANDARD.IDL.TREE.size
VAR	ANON_66_28_disp, q
VAR	ANON_66_28__u,    q
VAR	ANON_66_28__dat, STANDARD.IDL.TREE.size
	LVA 1, ANON_66_28__dat
	Sa  1, ANON_66_28_disp
	La  0, STANDARD.IDL.TREE.use__info
	Sa  1, ANON_66_28__u
	LVA 1, ANON_66_28_disp
					; doublet resultat record anonyme
	LVA 1,	PREFIX_disp
	CALL	STANDARD.IDL.SEM_PHASE_L11.EXP_TYPE. ,EVAL_TYPE_MARK_L217
	La  ,  0
	BLKMOV

VAR TYPESET_disp, q				; variable record : pointeur aux data record
VAR TYPESET__u, q				; variable record : pointeur aux useinfo
VAR TYPESET__dat, STANDARD.IDL.SEM_PHASE_L11.SET_UTIL.TYPESET_TYPE.size
	LVA	1, TYPESET__dat
	Sa	1, TYPESET_disp				; record fin
	LVA	1, STANDARD.IDL.SEM_PHASE_L11.SET_UTIL.TYPESET_TYPE.SIZ
	Sa	1, TYPESET__u
; CODE_VC_NAME DN_VARIABLE_ID

VAR STATIC_VALUE_disp, q			; variable record : pointeur aux data record
VAR STATIC_VALUE__u, q			; variable record : pointeur aux useinfo
VAR STATIC_VALUE__dat, STANDARD.IDL.TREE.size
	LVA	1, STATIC_VALUE__dat
	Sa	1, STATIC_VALUE_disp			; record fin
	LVA	1, STANDARD.IDL.TREE.SIZ
	Sa	1, STATIC_VALUE__u
; CODE_VC_NAME DN_VARIABLE_ID
	La  1, STATIC_VALUE_disp
	LI	STANDARD.IDL.TREE.size
	LVA 0,	STANDARD.IDL.TREE_VOID_disp
	La  ,  0
	BLKMOV

					;    end elab
begin:					;---------- BDY INSTRUCTIONS
	LVA 1,	ATTRIBUTE_ID_disp
	La
	LI	STANDARD.IDL.TREE.size
VAR	ANON_70_21_disp, q
VAR	ANON_70_21__u,    q
VAR	ANON_70_21__dat, STANDARD.IDL.TREE.size
	LVA 1, ANON_70_21__dat
	Sa  1, ANON_70_21_disp
	La  0, STANDARD.IDL.TREE.use__info
	Sa  1, ANON_70_21__u
	LVA 1, ANON_70_21_disp
					; doublet resultat record anonyme
	La  1,	-ATTRIBUTE_ofs
	CALL	STANDARD.IDL.SEM_PHASE_L11.ATT_WALK. ,EVAL_ATTRIBUTE_IDENTIFIER_L198
	La
	BLKMOV
	LVA 1,	PREFIX_disp
	La
	LI	STANDARD.IDL.TREE.size
VAR	ANON_71_21_disp, q
VAR	ANON_71_21__u,    q
VAR	ANON_71_21__dat, STANDARD.IDL.TREE.size
	LVA 1, ANON_71_21__dat
	Sa  1, ANON_71_21_disp
	La  0, STANDARD.IDL.TREE.use__info
	Sa  1, ANON_71_21__u
	LVA 1, ANON_71_21_disp
					; doublet resultat record anonyme
	LVA 1,	PREFIX_disp
	CALL	STANDARD.IDL.SEM_PHASE_L11.EXPRESO. ,RESOLVE_TYPE_MARK_L160
	La
	BLKMOV
	LVA 1,	PREFIX_disp
	La  1,	-ATTRIBUTE_ofs
	LI  48
	CALL	STANDARD.IDL. ,D_L16
	La  1,	-ATTRIBUTE_ofs
	LI  87
	CALL	STANDARD.IDL. ,D_L16
	LVA  1,	TYPESET_disp
	LId  1,	-EXP_ofs
	CALL	STANDARD.IDL.SEM_PHASE_L11.EXP_TYPE. ,EVAL_EXP_TYPES_L215
					; debut if
	LVA 1,	ATTRIBUTE_ID_disp
	LVA 0,	STANDARD.IDL.TREE_VOID_disp
	CNE
	BF	L22
	BRA	L21
L22:
L21:					; post if
ret_lbl:
	UNLINK 1
	RTD	prm_siz
excep:
endPRO					;---------- end PRO RESOLVE_LENGTH_REP
end if

if defined RESOLVE_ENUM_REP_L2_
PRO	RESOLVE_ENUM_REP_L2			;---------- PRO RESOLVE_ENUM_REP
PRMS					;    debut parametrage
	PRM SIMPLE_NAME_ofs			; in out
	PRM EXP_ofs				; in
	PRM H_ofs				; in
endPRMS					;    fin parametrage
ELB 1					;    BODY ELAB
VAR ENUM_TYPE_disp, q			; variable record : pointeur aux data record
VAR ENUM_TYPE__u, q				; variable record : pointeur aux useinfo
VAR ENUM_TYPE__dat, STANDARD.IDL.TREE.size
	LVA	1, ENUM_TYPE__dat
	Sa	1, ENUM_TYPE_disp			; record fin
	LVA	1, STANDARD.IDL.TREE.SIZ
	Sa	1, ENUM_TYPE__u
; CODE_VC_NAME DN_VARIABLE_ID
	La  1, ENUM_TYPE_disp
	LI	STANDARD.IDL.TREE.size
VAR	ANON_141_26_disp, q
VAR	ANON_141_26__u,    q
VAR	ANON_141_26__dat, STANDARD.IDL.TREE.size
	LVA 1, ANON_141_26__dat
	Sa  1, ANON_141_26_disp
	La  0, STANDARD.IDL.TREE.use__info
	Sa  1, ANON_141_26__u
	LVA 1, ANON_141_26_disp
					; doublet resultat record anonyme
	LId  1,	-SIMPLE_NAME_ofs
	CALL	STANDARD.IDL.SEM_PHASE_L11.EXP_TYPE. ,EVAL_TYPE_MARK_L217
	La  ,  0
	BLKMOV

VAR DUMMY_disp, q				; variable record : pointeur aux data record
VAR DUMMY__u, q				; variable record : pointeur aux useinfo
VAR DUMMY__dat, STANDARD.IDL.TREE.size
	LVA	1, DUMMY__dat
	Sa	1, DUMMY_disp				; record fin
	LVA	1, STANDARD.IDL.TREE.SIZ
	Sa	1, DUMMY__u
; CODE_VC_NAME DN_VARIABLE_ID

VAR ENUM_LIST_disp, q			; variable record : pointeur aux data record
VAR ENUM_LIST__u, q				; variable record : pointeur aux useinfo
VAR ENUM_LIST__dat, STANDARD.IDL.SEQ_TYPE.size
	LVA	1, ENUM_LIST__dat
	Sa	1, ENUM_LIST_disp			; record fin
	LVA	1, STANDARD.IDL.SEQ_TYPE.SIZ
	Sa	1, ENUM_LIST__u
; CODE_VC_NAME DN_VARIABLE_ID

VAR ENUM_disp, q				; variable record : pointeur aux data record
VAR ENUM__u, q				; variable record : pointeur aux useinfo
VAR ENUM__dat, STANDARD.IDL.TREE.size
	LVA	1, ENUM__dat
	Sa	1, ENUM_disp				; record fin
	LVA	1, STANDARD.IDL.TREE.SIZ
	Sa	1, ENUM__u
; CODE_VC_NAME DN_VARIABLE_ID

VAR ITEM_LIST_disp, q			; variable record : pointeur aux data record
VAR ITEM_LIST__u, q				; variable record : pointeur aux useinfo
VAR ITEM_LIST__dat, STANDARD.IDL.SEQ_TYPE.size
	LVA	1, ITEM_LIST__dat
	Sa	1, ITEM_LIST_disp			; record fin
	LVA	1, STANDARD.IDL.SEQ_TYPE.SIZ
	Sa	1, ITEM_LIST__u
; CODE_VC_NAME DN_VARIABLE_ID

VAR ITEM_disp, q				; variable record : pointeur aux data record
VAR ITEM__u, q				; variable record : pointeur aux useinfo
VAR ITEM__dat, STANDARD.IDL.TREE.size
	LVA	1, ITEM__dat
	Sa	1, ITEM_disp				; record fin
	LVA	1, STANDARD.IDL.TREE.SIZ
	Sa	1, ITEM__u
; CODE_VC_NAME DN_VARIABLE_ID

VAR CHOICE_disp, q				; variable record : pointeur aux data record
VAR CHOICE__u, q				; variable record : pointeur aux useinfo
VAR CHOICE__dat, STANDARD.IDL.TREE.size
	LVA	1, CHOICE__dat
	Sa	1, CHOICE_disp				; record fin
	LVA	1, STANDARD.IDL.TREE.SIZ
	Sa	1, CHOICE__u
; CODE_VC_NAME DN_VARIABLE_ID

VAR CHOICE_VALUE_disp, q			; variable record : pointeur aux data record
VAR CHOICE_VALUE__u, q			; variable record : pointeur aux useinfo
VAR CHOICE_VALUE__dat, STANDARD.IDL.TREE.size
	LVA	1, CHOICE_VALUE__dat
	Sa	1, CHOICE_VALUE_disp			; record fin
	LVA	1, STANDARD.IDL.TREE.SIZ
	Sa	1, CHOICE_VALUE__u
; CODE_VC_NAME DN_VARIABLE_ID

VAR CURRENT_VALUE_disp, q			; variable record : pointeur aux data record
VAR CURRENT_VALUE__u, q			; variable record : pointeur aux useinfo
VAR CURRENT_VALUE__dat, STANDARD.IDL.TREE.size
	LVA	1, CURRENT_VALUE__dat
	Sa	1, CURRENT_VALUE_disp			; record fin
	LVA	1, STANDARD.IDL.TREE.SIZ
	Sa	1, CURRENT_VALUE__u
; CODE_VC_NAME DN_VARIABLE_ID

VAR PRIOR_VALUE_disp, q			; variable record : pointeur aux data record
VAR PRIOR_VALUE__u, q			; variable record : pointeur aux useinfo
VAR PRIOR_VALUE__dat, STANDARD.IDL.TREE.size
	LVA	1, PRIOR_VALUE__dat
	Sa	1, PRIOR_VALUE_disp			; record fin
	LVA	1, STANDARD.IDL.TREE.SIZ
	Sa	1, PRIOR_VALUE__u
; CODE_VC_NAME DN_VARIABLE_ID
	La  1, PRIOR_VALUE_disp
	LI	STANDARD.IDL.TREE.size
	LVA 0,	STANDARD.IDL.TREE_VOID_disp
	La  ,  0
	BLKMOV

VAR DUMMY_ARRAY_TYPE_disp, q			; variable record : pointeur aux data record
VAR DUMMY_ARRAY_TYPE__u, q			; variable record : pointeur aux useinfo
VAR DUMMY_ARRAY_TYPE__dat, STANDARD.IDL.TREE.size
	LVA	1, DUMMY_ARRAY_TYPE__dat
	Sa	1, DUMMY_ARRAY_TYPE_disp			; record fin
	LVA	1, STANDARD.IDL.TREE.SIZ
	Sa	1, DUMMY_ARRAY_TYPE__u
; CODE_VC_NAME DN_VARIABLE_ID

					;    end elab
begin:					;---------- BDY INSTRUCTIONS
	La  1,	-SIMPLE_NAME_ofs
	La
	LI	STANDARD.IDL.TREE.size
VAR	ANON_153_20_disp, q
VAR	ANON_153_20__u,    q
VAR	ANON_153_20__dat, STANDARD.IDL.TREE.size
	LVA 1, ANON_153_20__dat
	Sa  1, ANON_153_20_disp
	La  0, STANDARD.IDL.TREE.use__info
	Sa  1, ANON_153_20__u
	LVA 1, ANON_153_20_disp
					; doublet resultat record anonyme
	LId  1,	-SIMPLE_NAME_ofs
	CALL	STANDARD.IDL.SEM_PHASE_L11.EXPRESO. ,RESOLVE_TYPE_MARK_L160
	La
	BLKMOV
					; debut if
	LIb	1, ENUM_TYPE_disp, STANDARD.IDL.TREE.TY
	LI	202
	CNE
	BF	L24
	LVA 1,	DUMMY_disp
	La
	LI	STANDARD.IDL.TREE.size
VAR	ANON_155_16_disp, q
VAR	ANON_155_16__u,    q
VAR	ANON_155_16__dat, STANDARD.IDL.TREE.size
	LVA 1, ANON_155_16__dat
	Sa  1, ANON_155_16_disp
	La  0, STANDARD.IDL.TREE.use__info
	Sa  1, ANON_155_16__u
	LVA 1, ANON_155_16_disp
					; doublet resultat record anonyme
	La  1,	-EXP_ofs
	CALL	STANDARD.IDL.SEM_PHASE_L11.EXPRESO. ,RESOLVE_EXP_L158
	La
	BLKMOV
	BRA ret_lbl
	BRA	L23
L24:
L23:					; post if
VAR	ANON_159_35_disp, q
VAR	ANON_159_35__u,    q
VAR	ANON_159_35__dat, STANDARD.IDL.TREE.size
	LVA 1, ANON_159_35__dat
	Sa  1, ANON_159_35_disp
	La  0, STANDARD.IDL.TREE.use__info
	Sa  1, ANON_159_35__u
