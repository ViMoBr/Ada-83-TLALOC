	LVA 1,	TEMP_DEFINTERP_disp
	CALL	STANDARD.IDL.SEM_PHASE_L11.SET_UTIL. ,GET_DEF_L82
	La
	BLKMOV
					; debut if
; CODE record equality "=" _TREE
