	Sa	 2, NODE_NAME__u_ofs
VAR GFP_disp, q				; Lieu du Generic Frame Pointer 
VAR DEFAULT_WIDTH_disp, d			; variable entiere
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	0
	Sd  2,	DEFAULT_WIDTH_disp

VAR DEFAULT_SETTING_disp, b			; variable entiere
	LI	1
	Sb  2,	DEFAULT_SETTING_disp

if defined GET_L2_
PRO	GET_L2				;---------- PRO GET
PRMS					;    debut parametrage
	PRM FILE_ofs				; in
	PRM ITEM_ofs				; out
