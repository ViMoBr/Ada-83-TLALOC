ELB 3
begin:
	LVA	 2, GFP_disp
	La 	 3, -ITEM_ofs
	La 	 3, -FILE_ofs
	CALL	STANDARD.TEXT_IO.ENUMERATION_IO. ,GET_L79
	UNLINK	 3
	RTD	prm_siz
endPRO					;---------- end PRO GET
