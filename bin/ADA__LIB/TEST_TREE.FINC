	LI	16
	Sd	1, SIZ
; CODE_NUMERIC_LITERAL DN_UNIVERSAL_INTEGER
	LI	0
	Sw	1, FST
; CODE_NUMERIC_LITERAL DN_UNIVERSAL_INTEGER
	LI	127
	Sw	1, LST
end namespace

					; ATTR_NBR INTEGER SUBTYPE INFO
ATTR_NBR = 'ATTR_NBR'
namespace ATTR_NBR
VAR use__info, q
VAR SIZ, d
	LVA	1, SIZ
	Sa	1, use__info
VAR FST, w
VAR LST, w
	LI	16
	Sd	1, SIZ
; CODE_NUMERIC_LITERAL DN_UNIVERSAL_INTEGER
	LI	0
	Sw	1, FST
; CODE_NUMERIC_LITERAL DN_UNIVERSAL_INTEGER
	LI	127
	Sw	1, LST
VAR PARENT__u, q
	La	1, STANDARD.TEST_TREE_L1.LINE_IDX.use__info
	Sa	1, PARENT__u
end namespace

					; LINE_NBR TYPE RANGE INFO
LINE_NBR = 'LINE_NBR'
namespace LINE_NBR
VAR use__info, q
VAR SIZ, d
	LVA	1, SIZ
	Sa	1, use__info
VAR FST, w
VAR LST, w
	LI	16
	Sd	1, SIZ
; CODE_NUMERIC_LITERAL DN_UNIVERSAL_INTEGER
	LI	0
	Sw	1, FST
; CODE_NUMERIC_LITERAL DN_UNIVERSAL_INTEGER
	LI	128
	Sw	1, LST
end namespace

					; SRCCOL_IDX TYPE RANGE INFO
SRCCOL_IDX = 'SRCCOL_IDX'
namespace SRCCOL_IDX
VAR use__info, q
VAR SIZ, d
	LVA	1, SIZ
	Sa	1, use__info
VAR FST, w
VAR LST, w
	LI	16
	Sd	1, SIZ
; CODE_NUMERIC_LITERAL DN_UNIVERSAL_INTEGER
	LI	0
	Sw	1, FST
; CODE_NUMERIC_LITERAL DN_UNIVERSAL_INTEGER
	LI	255
	Sw	1, LST
