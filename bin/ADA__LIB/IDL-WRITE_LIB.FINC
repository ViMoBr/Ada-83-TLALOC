; STSB
STATOFS NAME, 256
STATOFS NAME_LEN, 4
STATOFS IS_OPENED, 1
STATOFS MODE, 1
STATOFS AT_END_OF_FILE, 1
size = $
end virtual
	LI	 size*8
	Sd	2, SIZ
end namespace
