	LI  163
	CALL	STANDARD.IDL. ,D_L17
	La  ,  0
	BLKMOV

VAR FIRST_PAGE_disp, w			; variable entiere
	La	4, WITHED_UNIT_disp
	Ld
	LI	9
	LI	15
	UBFX
	Sw  4,	FIRST_PAGE_disp

VAR NBR_PAGES_WITHED_disp, w			; variable entiere

					;    end elab
begin:					;---------- BDY INSTRUCTIONS
	LI	0					; lieu resultat sur pile
	LVA 4,	WITHED_UNIT_disp
	LI  141
	CALL	STANDARD.IDL. ,DI_L21
; CODE CONVERSION SOURCE DN_INTEGER TARGET DN_INTEGER
	Sw  4,	NBR_PAGES_WITHED_disp
VAR	IL8_disp, w				; compteur boucle LOOP__2
	Lw 4,	FIRST_PAGE_disp
	Sw  4,	IL8_disp
VAR	LMT_IL8_disp, w				; limite boucle LOOP__2
	Lw 4,	FIRST_PAGE_disp
	Lw 4,	NBR_PAGES_WITHED_disp
	ADD
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	1
	SUB
	Sw  4,	LMT_IL8_disp
	Lw  4,	IL8_disp				; test null range LOOP__2
	Lw  4,	LMT_IL8_disp
	CGT
	BT	L7
LOOP__2:					; corps boucle LOOP__2
	La	 1, DONT_MOVE_disp			; array data start address on stack
	Lw	4, IL8_disp
	LId	1, DONT_MOVE__u, STANDARD.IDL.WRITE_LIB_L13._DONT_MOVE.FST_1	; (index - FST_1) * SIZ_1
	SUB
	LId	1, DONT_MOVE__u, STANDARD.IDL.WRITE_LIB_L13._DONT_MOVE.COMP_SIZ
	LI	8
	DIV
	MUL
	ADD					; add offset to start address
	LI	1
	Sb
	Lw  4,	IL8_disp				; test de sortie LOOP__2
	Lw  4,	LMT_IL8_disp
	CEQ
	BT	L7
	Lw  4,	IL8_disp				; mise a jour compteur LOOP__2
	INC
	Sw  4,	IL8_disp
	BRA	LOOP__2				; iteration suivante LOOP__2
L7:					; post loop LOOP__2
	UNLINK 4
endPRO
	BRA	LOOP__1
L6:					; post loop LOOP__1
	UNLINK 3
endPRO
ret_lbl:
	UNLINK 2
	RTD	prm_siz
excep:
endPRO					;---------- end PRO MARK_DONT_MOVE_PAGES
