if ~ definite TEXT_IO
include 'TEXT_IO.FINC'
end if
PRO	TEST_INT_IO_L1				;---------- PRO TEST_INT_IO
ELB 1					;    BODY ELAB
INT_IO = 'INT_IO'
namespace INT_IO				;---------- GENERIC PACKAGE INSTANTIATION
elab_spec:				;    SPEC ELAB

BRA post_LD_INTEGER
LD_INTEGER.elab:
	Ld -1, 0
	RTD 0
post_LD_INTEGER:
BRA post_ST_INTEGER
ST_INTEGER.elab:
	Sd -1, 0
	RTD 0
post_ST_INTEGER:
BRA post_INADR_INTEGER
INADR_INTEGER.elab:
	RTD 0
post_INADR_INTEGER:
BRA post_OUTADR_INTEGER
OUTADR_INTEGER.elab:
	La
	RTD 0
post_OUTADR_INTEGER:
VAR INTEGER__outadr_ofs, q
	LCA OUTADR_INTEGER.elab
	Sa	 1, INTEGER__outadr_ofs
VAR INTEGER__inadr_ofs, q
	LCA INADR_INTEGER.elab
	Sa	 1, INTEGER__inadr_ofs
VAR INTEGER__st_ofs, q
	LCA ST_INTEGER.elab
	Sa	 1, INTEGER__st_ofs
VAR INTEGER__ld_ofs, q
	LCA LD_INTEGER.elab
	Sa	 1, INTEGER__ld_ofs
VAR INTEGER__u_ofs, q
	La	 0, STANDARD.INTEGER.use__info
	Sa	 1, INTEGER__u_ofs
VAR GFP_disp, q				; Lieu du Generic Frame Pointer 
VAR DEFAULT_WIDTH_disp, d			; variable entiere
	LI	 11
	Sd  1,	DEFAULT_WIDTH_disp

VAR DEFAULT_BASE_disp, d			; variable entiere
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	10
	Sd  1,	DEFAULT_BASE_disp

if defined GET_L2_
PRO	GET_L2				;---------- PRO GET
PRMS					;    debut parametrage
	PRM FILE_ofs				; in
	PRM ITEM_ofs				; out
	PRM WIDTH_ofs				; in
endPRMS					;    fin parametrage
ELB 2
begin:
	LVA	 1, GFP_disp
	Ld	 2, -WIDTH_ofs
	La 	 2, -ITEM_ofs
	La 	 2, -FILE_ofs
	CALL	STANDARD.TEXT_IO.INTEGER_IO. ,GET_L61
	UNLINK	 2
	RTD	prm_siz
endPRO					;---------- end PRO GET
end if
if defined GET_L3_
PRO	GET_L3				;---------- PRO GET
PRMS					;    debut parametrage
	PRM ITEM_ofs				; out
	PRM WIDTH_ofs				; in
endPRMS					;    fin parametrage
ELB 2
begin:
	LVA	 1, GFP_disp
	Ld	 2, -WIDTH_ofs
	La 	 2, -ITEM_ofs
	CALL	STANDARD.TEXT_IO.INTEGER_IO. ,GET_L62
	UNLINK	 2
	RTD	prm_siz
endPRO					;---------- end PRO GET
end if
if defined PUT_L4_
PRO	PUT_L4				;---------- PRO PUT
PRMS					;    debut parametrage
	PRM FILE_ofs				; in
	PRM ITEM_ofs				; in
	PRM WIDTH_ofs				; in
	PRM BASE_ofs				; in
endPRMS					;    fin parametrage
ELB 2
begin:
	LVA	 1, GFP_disp
	Ld	 2, -BASE_ofs
	Ld	 2, -WIDTH_ofs
	Ld	 2, -ITEM_ofs
	La 	 2, -FILE_ofs
	CALL	STANDARD.TEXT_IO.INTEGER_IO. ,PUT_L63
	UNLINK	 2
	RTD	prm_siz
endPRO					;---------- end PRO PUT
end if
if defined PUT_L5_
PRO	PUT_L5				;---------- PRO PUT
PRMS					;    debut parametrage
	PRM ITEM_ofs				; in
	PRM WIDTH_ofs				; in
	PRM BASE_ofs				; in
endPRMS					;    fin parametrage
ELB 2
begin:
	LVA	 1, GFP_disp
	Ld	 2, -BASE_ofs
	Ld	 2, -WIDTH_ofs
	Ld	 2, -ITEM_ofs
	CALL	STANDARD.TEXT_IO.INTEGER_IO. ,PUT_L64
	UNLINK	 2
	RTD	prm_siz
endPRO					;---------- end PRO PUT
end if
if defined GET_L6_
PRO	GET_L6				;---------- PRO GET
PRMS					;    debut parametrage
	PRM FROM_ofs				; in
	PRM ITEM_ofs				; out
	PRM LAST_ofs				; out
endPRMS					;    fin parametrage
ELB 2
begin:
	LVA	 1, GFP_disp
	La 	 2, -LAST_ofs
	La 	 2, -ITEM_ofs
	La 	 2, -FROM_ofs
	CALL	STANDARD.TEXT_IO.INTEGER_IO. ,GET_L65
	UNLINK	 2
	RTD	prm_siz
endPRO					;---------- end PRO GET
end if
if defined PUT_L7_
PRO	PUT_L7				;---------- PRO PUT
PRMS					;    debut parametrage
	PRM TO_ofs				; out
	PRM ITEM_ofs				; in
	PRM BASE_ofs				; in
endPRMS					;    fin parametrage
ELB 2
begin:
	LVA	 1, GFP_disp
	Ld	 2, -BASE_ofs
	Ld	 2, -ITEM_ofs
	La 	 2, -TO_ofs
	CALL	STANDARD.TEXT_IO.INTEGER_IO. ,PUT_L66
	UNLINK	 2
	RTD	prm_siz
endPRO					;---------- end PRO PUT
end if
					;---------- end generic package instantiation INT_IO
end namespace

VAR I_disp, d				; variable entiere
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	12
	Sd  1,	I_disp

STRING = 'STRING'
namespace STRING				; array var constrained array type info
VAR use__info, q
VAR SIZ, d
	LVA	1, SIZ
	Sa	1, use__info
VAR COMP_SIZ, d
VAR FST_1, d
VAR LST_1, d
	LI	8
	Sd	1, COMP_SIZ
	Ld	1, COMP_SIZ
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	1
	Sd	1, FST_1
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	10
	Sd	1, LST_1
	Ld	1, LST_1
	INC
	Ld	1, FST_1
	SUB
	MUL
	Sd	1, SIZ
  virtual at 4
COMP_SIZ = $
	rd 1 
FST_1 = $
	rd 1 
LST_1 = $
	rd 1 
  end virtual
end namespace
VAR S1_disp, q				; variable array : pointeur aux data
VAR S1__u, q				; variable array : useinfo pointeur au rec info
	La 1, STRING.use__info
	Sa	1, S1__u				; array info ptr at __u
	Ld	1, STRING.SIZ
	LI	8
	DIV
	CO_VAR
	Sa	1, S1_disp				; array data ptr at _disp

STRING = 'STRING'
namespace STRING				; array var constrained array type info
VAR use__info, q
VAR SIZ, d
	LVA	1, SIZ
	Sa	1, use__info
VAR COMP_SIZ, d
VAR FST_1, d
VAR LST_1, d
	LI	8
	Sd	1, COMP_SIZ
	Ld	1, COMP_SIZ
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	1
	Sd	1, FST_1
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	10
	Sd	1, LST_1
	Ld	1, LST_1
	INC
	Ld	1, FST_1
	SUB
	MUL
	Sd	1, SIZ
  virtual at 4
COMP_SIZ = $
	rd 1 
FST_1 = $
	rd 1 
LST_1 = $
	rd 1 
  end virtual
end namespace
VAR S2_disp, q				; variable array : pointeur aux data
VAR S2__u, q				; variable array : useinfo pointeur au rec info
	La 1, STRING.use__info
	Sa	1, S2__u				; array info ptr at __u
	Ld	1, STRING.SIZ
	LI	8
	DIV
	CO_VAR
	Sa	1, S2_disp				; array data ptr at _disp

VAR L_disp, d				; variable entiere

					;    end elab
begin:					;---------- BDY INSTRUCTIONS
	LI	60
	CALL	STANDARD.TEXT_IO. ,PUT_L52
	Ld 1,	STANDARD.TEST_INT_IO_L1.INT_IO.DEFAULT_BASE_disp
	Ld 1,	STANDARD.TEST_INT_IO_L1.INT_IO.DEFAULT_WIDTH_disp
	Ld 1,	I_disp
	CALL	STANDARD.TEST_INT_IO_L1.INT_IO. ,PUT_L5
	LI	62
	CALL	STANDARD.TEXT_IO. ,PUT_L52
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	1
	CALL	STANDARD.TEXT_IO. ,NEW_LINE_L26
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	10
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	255
	LVA  1,	S1_disp
	CALL	STANDARD.TEST_INT_IO_L1.INT_IO. ,PUT_L7
	LVA 1,	S1_disp
	CALL	STANDARD.TEXT_IO. ,PUT_LINE_L60
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	16
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	255
	LVA  1,	S2_disp
	CALL	STANDARD.TEST_INT_IO_L1.INT_IO. ,PUT_L7
	LVA 1,	S2_disp
	CALL	STANDARD.TEXT_IO. ,PUT_LINE_L60
	LVA  1,	L_disp
	LVA  1,	I_disp
STR STR_L8, "  -123 xxx"			; constante string="  -123 xxx"
	LCA	STR_L8.data_ptr
	CALL	STANDARD.TEST_INT_IO_L1.INT_IO. ,GET_L6
	Ld 1,	STANDARD.TEST_INT_IO_L1.INT_IO.DEFAULT_BASE_disp
	Ld 1,	STANDARD.TEST_INT_IO_L1.INT_IO.DEFAULT_WIDTH_disp
	Ld 1,	I_disp
	CALL	STANDARD.TEST_INT_IO_L1.INT_IO. ,PUT_L5
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	1
	CALL	STANDARD.TEXT_IO. ,NEW_LINE_L26
	LVA  1,	L_disp
	LVA  1,	I_disp
STR STR_L9, "16#FF# reste"			; constante string="16#FF# reste"
	LCA	STR_L9.data_ptr
	CALL	STANDARD.TEST_INT_IO_L1.INT_IO. ,GET_L6
	Ld 1,	STANDARD.TEST_INT_IO_L1.INT_IO.DEFAULT_BASE_disp
	Ld 1,	STANDARD.TEST_INT_IO_L1.INT_IO.DEFAULT_WIDTH_disp
	Ld 1,	I_disp
	CALL	STANDARD.TEST_INT_IO_L1.INT_IO. ,PUT_L5
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	1
	CALL	STANDARD.TEXT_IO. ,NEW_LINE_L26
namespace	BLOCK__1
ELB 2					;    BODY ELAB
STRING = 'STRING'
namespace STRING				; array var constrained array type info
VAR use__info, q
VAR SIZ, d
	LVA	2, SIZ
	Sa	2, use__info
VAR COMP_SIZ, d
VAR FST_1, d
VAR LST_1, d
	LI	8
	Sd	2, COMP_SIZ
	Ld	2, COMP_SIZ
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	1
	Sd	2, FST_1
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	3
	Sd	2, LST_1
	Ld	2, LST_1
	INC
	Ld	2, FST_1
	SUB
	MUL
	Sd	2, SIZ
  virtual at 4
COMP_SIZ = $
	rd 1 
FST_1 = $
	rd 1 
LST_1 = $
	rd 1 
  end virtual
end namespace
VAR S_disp, q				; variable array : pointeur aux data
VAR S__u, q				; variable array : useinfo pointeur au rec info
	La 2, STRING.use__info
	Sa	2, S__u				; array info ptr at __u
	Ld	2, STRING.SIZ
	LI	8
	DIV
	CO_VAR
	Sa	2, S_disp				; array data ptr at _disp

					;    end elab
begin:					;---------- BDY INSTRUCTIONS
	Ld 1,	STANDARD.TEST_INT_IO_L1.INT_IO.DEFAULT_BASE_disp
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	12345
	LVA  2,	S_disp
	CALL	STANDARD.TEST_INT_IO_L1.INT_IO. ,PUT_L7
	LVA 2,	S_disp
	CALL	STANDARD.TEXT_IO. ,PUT_LINE_L60
	UNLINK 2
endPRO
ret_lbl:
	UNLINK 1
	RTD
excep:
endPRO					;---------- end PRO TEST_INT_IO
