PRO	FIX_DUMP0_L1				;---------- PRO FIX_DUMP0
ELB 1					;    BODY ELAB

					; _T8 FIXED SUBTYPE INFO
_T8 = '_T8'
namespace _T8
VAR use__info, q
VAR SIZ, d
	LVA	1, SIZ
	Sa	1, use__info
	LI	64
	Sd	1, SIZ
VAR FST, q
VAR LST, q
	LI	-100
	LI	 16
	LI	 1
	CVTIX
	Sq	1, FST
	LI	 100
	LI	 16
	LI	 1
	CVTIX
	Sq	1, LST
VAR NUMER, q
VAR DENOM, q
	LI	 1
	Sq	1, NUMER
	LI	 16
	Sq	1, DENOM
end namespace

