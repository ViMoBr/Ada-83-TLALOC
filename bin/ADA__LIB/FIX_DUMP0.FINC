					; _S8 FIXED SUBTYPE INFO
_S8 = '_S8'
namespace _S8
VAR use__info, q
VAR SIZ, d
	LVA	1, SIZ
	Sa	1, use__info
	LI	64
	Sd	1, SIZ
VAR FST, q
VAR LST, q
	LI	-1
	LI	 16
	LI	 1
	CVTIX
	Sq	1, FST
	LI	 1
	LI	 16
	LI	 1
	CVTIX
	Sq	1, LST
VAR NUMER, q
VAR DENOM, q
	LI	 1
	Sq	1, NUMER
	LI	 16
	Sq	1, DENOM
end namespace
VAR S_disp, q				; variable fixed
; CODE_NUMERIC_LITERAL DN_FIXED
	LI	 1
	LI	 16
	LI	 2
	CVTIX
	Sq  1,	S_disp

VAR A_disp, q				; variable fixed
; CODE_NUMERIC_LITERAL DN_FIXED
	LI	 5
	LI	 16
	LI	 2
	CVTIX
	Sq  1,	A_disp

VAR B_disp, q				; variable fixed
; CODE_NUMERIC_LITERAL DN_FIXED
	LI	 4
	LI	 16
	LI	 1
	CVTIX
	Sq  1,	B_disp

VAR C_disp, q				; variable fixed
; CODE_NUMERIC_LITERAL DN_FIXED
	LI	 0
	LI	 32
	LI	 1
	CVTIX
	Sq  1,	C_disp

VAR D_disp, q				; variable fixed
; CODE_NUMERIC_LITERAL DN_FIXED
	LI	 6
	LI	 4
	LI	 3
	CVTIX
	Sq  1,	D_disp

VAR E_disp, q				; variable fixed
; CODE_NUMERIC_LITERAL DN_FIXED
	LI	 0
	LI	 16
	LI	 1
	CVTIX
	Sq  1,	E_disp

VAR N_disp, d				; variable entiere
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	3
	Sd  1,	N_disp

					;    end elab
begin:					;---------- BDY INSTRUCTIONS
	Lq 1,	A_disp
	Lq 1,	B_disp
	MUL
	LI	 1
	LI	 8
	CVTIX
	Sq  1,	C_disp
	Lq 1,	A_disp
	LI	 32
	LI	 1
	CVTIX
	Lq 1,	B_disp
	DUP
	LI	0
	CEQ
	BT	STANDARD.ne_raise_
	DIV
	Sq  1,	C_disp
	LI	 1
	LI	 16
	LI	 8
	CVTIX
	Sq  1,	A_disp
	LI	 3
	LI	 16
	LI	 4
	CVTIX
	Sq  1,	A_disp
	LI	3
	Sd  1,	N_disp
	LI	3
	Sd  1,	N_disp
	Lq 1,	A_disp
	Ld 1,	N_disp
	MUL
	Sq  1,	A_disp
	Lq 1,	A_disp
	Ld 1,	N_disp
	DUP
	LI	0
	CEQ
	BT	STANDARD.ne_raise_
	DIV
	Sq  1,	A_disp
	Lq 1,	D_disp
	Lq 1,	D_disp
	MUL
	LI	 3
	LI	 4
	CVTIX
	Sq  1,	D_disp
	Lq 1,	C_disp
; CODE CONVERSION SOURCE DN_FIXED TARGET DN_FIXED
	LI	 1
	LI	 2
	CVTIX
	Sq  1,	E_disp
; CODE_NUMERIC_LITERAL DN_UNIVERSAL_REAL
	LIF	0.1875
; CODE CONVERSION SOURCE DN_UNIVERSAL_REAL TARGET DN_FIXED
	LI	 32
	CVTIF
	FMUL
	CVTFIR
; CODE CONVERSION SOURCE DN_FIXED TARGET DN_FIXED
	LI	 1
	LI	 2
	CVTIX
	Sq  1,	A_disp
ret_lbl:
	UNLINK 1
	RTD
excep:
endPRO					;---------- end PRO FIX_DUMP0
