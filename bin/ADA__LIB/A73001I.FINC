if defined P_L8_
PRO	P_L8					;---------- PRO P
virtual at 8
	ITEM__u_ofs = $
	rq 1
	ITEM__ld_ofs = $
	rq 1
	ITEM__st_ofs = $
	rq 1
	ITEM__inadr_ofs = $
	rq 1
	ITEM__outadr_ofs = $
	rq 1
end virtual
PRMS					;    debut parametrage
