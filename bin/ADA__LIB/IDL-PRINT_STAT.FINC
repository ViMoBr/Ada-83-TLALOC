	INC
	CLAMP0
	Sa  1, ANON_26_23_L3_G_len
STR ANON_26_35_L3_D, ".lar"			; constante string=".lar"
	LCA	ANON_26_35_L3_D.data_ptr
	DUP
	La  ,  0
	Sa  1, ANON_26_35_L3_D_data
	La  ,  8
	Sa  1, ANON_26_35_L3_D_info
	LId 1, ANON_26_35_L3_D_info, _STRING.LST_1
	LId 1, ANON_26_35_L3_D_info, _STRING.FST_1
