	LI	8
	Sd  1, ANON_26_23_L3_R_info._COMP_SIZ
	La  1, ANON_26_23_L3_G_len
	La  1, ANON_26_35_L3_D_len
	ADD
	LI	8
	MUL
	Sd  1, ANON_26_23_L3_R_info.SIZ
	LVA 1, ANON_26_23_L3_R_info.SIZ
	Sa  1, ANON_26_23_L3_R__u
	La  1, ANON_26_23_L3_R_disp
	La  1, ANON_26_23_L3_G_len
	La  1, ANON_26_23_L3_G_data
	BLKMOV
	La  1, ANON_26_23_L3_R_disp
	La  1, ANON_26_23_L3_G_len
	ADD
	La  1, ANON_26_35_L3_D_len
	La  1, ANON_26_35_L3_D_data
	BLKMOV
	LVA 1, ANON_26_23_L3_R_disp
	CALL	STANDARD.IDL. ,OPEN_IDL_TREE_FILE_L2
STR STR_L4, ""				; constante string=""
	LCA	STR_L4.data_ptr
; CODE & concat _STRING
VAR	ANON_27_28_L5_G_data, q
VAR	ANON_27_28_L5_G_info, q
VAR	ANON_27_40_L5_D_data, q
VAR	ANON_27_40_L5_D_info, q
VAR	ANON_27_28_L5_G_len,  q
VAR	ANON_27_40_L5_D_len,  q
