	LI  1
	LVA  1,	STANDARD.IDL.PRINT_STAT_L10.OFILE_disp
	CALL	STANDARD.TEXT_IO. ,CREATE_L1
	LVA 1,	OFILE_disp
	CALL	STANDARD.TEXT_IO. ,SET_OUTPUT_L12
	LVA 1,	USER_ROOT_disp
	La
	LI	STANDARD.IDL._TREE.size
VAR	ANON_29_16_disp, q
VAR	ANON_29_16__u,    q
VAR	ANON_29_16__dat, STANDARD.IDL._TREE.size
