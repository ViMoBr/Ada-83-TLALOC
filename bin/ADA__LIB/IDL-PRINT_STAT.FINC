					; doublet resultat record anonyme
	LVA 1,	USER_ROOT_disp
	LI  15
	CALL	STANDARD.IDL. ,D_L14
	CALL	STANDARD.IDL. ,LIST_L19
	La
	BLKMOV
LOOP__1:
	LI	0					; lieu resultat sur pile
	LVA 1,	STATE_SEQ_disp
	CALL	STANDARD.IDL. ,IS_EMPTY_L20
	LI	1
	OUX
	BF	L6
	LVA  1,	STANDARD.IDL.PRINT_STAT_L10.STATE_disp
	LVA  1,	STANDARD.IDL.PRINT_STAT_L10.STATE_SEQ_disp
	CALL	STANDARD.IDL. ,POP_L21
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	1
	DUP
	Ld	0, STANDARD.TEXT_IO._POSITIVE_COUNT.FST
	CLT
	BT	STANDARD.ce_raise_
	DUP
	Ld	0, STANDARD.TEXT_IO._POSITIVE_COUNT.LST
	CGT
