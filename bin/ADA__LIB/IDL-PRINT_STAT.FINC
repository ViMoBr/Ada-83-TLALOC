	CALL	STANDARD.TEXT_IO. ,NEW_LINE_L26
STR STR_L7, "STATE NO."			; constante string="STATE NO."
	LCA	STR_L7.data_ptr
	CALL	STANDARD.TEXT_IO. ,PUT_L56
	Ld 0,	STANDARD.IDL.INT_IO.DEFAULT_BASE_disp
