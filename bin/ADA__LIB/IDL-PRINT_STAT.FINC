namespace ANON_26_23_L3_R_info
  VAR SIZ,      d
  VAR _COMP_SIZ, d
  VAR _FST_1,    d
  VAR _LST_1,    d
end namespace
	La  1,	-NOM_TEXTE_ofs
	DUP
	La  ,  0
	Sa  1, ANON_26_23_L3_G_data
	La  ,  8
	Sa  1, ANON_26_23_L3_G_info
	LId 1, ANON_26_23_L3_G_info, _STRING.LST_1
	LId 1, ANON_26_23_L3_G_info, _STRING.FST_1
