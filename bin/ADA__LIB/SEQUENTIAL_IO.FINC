namespace ANON_126_37			; ensemble doublet @data/@info pour slice anonyme source
VAR ANON_126_37_disp, q
VAR ANON_126_37__u, q
VAR SIZ, d
VAR COMP_SIZ, d
VAR FST_1, d
VAR LST_1, d
	Sa	1, ANON_126_37_disp
	LVA	1, SIZ
	Sa	1, ANON_126_37__u
