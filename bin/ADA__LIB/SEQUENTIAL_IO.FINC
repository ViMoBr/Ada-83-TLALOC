	PRM FILE_ID_ofs				; in
	PRM LENGTH_ofs				; in
	PRM ADR_ofs				; in
	PRM GFP_ofs
	PRM result__ofs				; resultat de fonction
endPRMS					;    fin parametrage
ELB 2					;    BODY ELAB
					;    end elab
begin:					;---------- BDY INSTRUCTIONS
	LD 2 ,	-16
	LA 2 ,	-24
	LD 2 ,	-8
	SYS_FILE_WRITE
	SD 2 ,	-32
ret_lbl:
	UNLINK 2
	RTD	prm_siz-8
excep:
endPRO					;---------- end PRO WRITE_SYSTEM_CALL
end if
					;    end elab
begin:					;---------- BDY INSTRUCTIONS
					; debut if
	La 1, -FILE_ofs
	LIb	, 0, STANDARD.SEQUENTIAL_IO._FILE_TYPE.IS_OPENED
	LI	0
	CEQ
	BF	L32
	BRA	L31
L32:
L31:					; post if
					; debut if
	La 1, -FILE_ofs
	LIb	, 0, STANDARD.SEQUENTIAL_IO._FILE_TYPE.MODE
	LI	0
	CEQ
	BF	L34
	BRA	L33
L34:
L33:					; post if
	LI	0					; lieu resultat sur pile
	La  1,	-GFP_ofs				; propagation GFP generique
	LVA	1, -ITEM_ofs
	La  1,	-GFP_ofs
	La	, -ELEMENT_TYPE__inadr_ofs
	CALLI
	Ld 1,	SIZE_BYTES_disp
	La 1, -FILE_ofs
	LId	, 0, STANDARD.SEQUENTIAL_IO._FILE_TYPE.ID
	CALL	STANDARD.SEQUENTIAL_IO.WRITE_L12. ,WRITE_SYSTEM_CALL_L30
	Sd  1,	ERR_CODE_disp
ret_lbl:
	UNLINK 1
	RTD	prm_siz
excep:
endPRO					;---------- end PRO WRITE
end if

