	Ld	1, FST_1
	SUB
	LI	8
	MUL
	Sd	1, SIZ
	LVA	1, ANON_126_37_disp
end namespace
	CALL	STANDARD.SEQUENTIAL_IO.DELETE_L4. ,DELETE_SYSTEM_CALL_L8
