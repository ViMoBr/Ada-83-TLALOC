if ~ definite TEXT_IO
include 'TEXT_IO.FINC'
end if
if ~ definite SYSTEM
include 'SYSTEM.FINC'
end if
if ~ definite MACHINE_CODE
include 'MACHINE_CODE.FINC'
end if
SEQUENTIAL_IO = 'SEQUENTIAL_IO'
namespace SEQUENTIAL_IO
					;---------- GENERIC PACKAGE BODY ----------

PRMS
	PRM ELEMENT_TYPE__u_ofs
	PRM ELEMENT_TYPE__ld_ofs
	PRM ELEMENT_TYPE__st_ofs
	PRM ELEMENT_TYPE__inadr_ofs
	PRM ELEMENT_TYPE__outadr_ofs
endPRMS
; EXPANDER.DECLARATIONS.CODE_TYPE_DECL : skip PRIVATE FILE_TYPE (deferred to full type)

					; _FILE_MODE ENUMERATION TYPE INFO
_FILE_MODE = '_FILE_MODE'
namespace _FILE_MODE
VAR use__info, q
BEGIN_BLOC_DEF
db 0, 7, "IN_FILE"
db 1, 8, "OUT_FILE"
END_BLOC_DEF
IMAGES	BYTES_BLOC
CST LST, d, 1
CST FST, d, 0
CST SIZ, d, 8	; SIZ en bits !
postpone
  align_q
end postpone
	LCA	SIZ
	Sa	0, use__info
end namespace
_FILE_NAME_BUFFER = '_FILE_NAME_BUFFER'
namespace _FILE_NAME_BUFFER			; _FILE_NAME_BUFFER CONSTRAINED ARRAY SUBTYPE INFO
VAR use__info, q
VAR SIZ, d
	LVA	0, SIZ
	Sa	0, use__info
VAR _COMP_SIZ, d
VAR _FST_1, d
VAR _LST_1, d
	LI	8
	Sd	0, _COMP_SIZ
	Ld	0, _COMP_SIZ
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	1
	Sd	0, _FST_1
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	256
	Sd	0, _LST_1
	Ld	0, _LST_1
	Ld	0, _FST_1
	SUB
	INC
	MUL
	Sd	0, SIZ
  virtual at 4
COMP_SIZ = $
	rd 1 
FST_1 = $
	rd 1 
LST_1 = $
	rd 1 
  end virtual
end namespace

					; _FILE_TYPE RECORD TYPE INFO
_FILE_TYPE = '_FILE_TYPE'
namespace _FILE_TYPE
VAR use__info, q
VAR SIZ, d
	LVA	0, SIZ
	Sa	0, use__info
USEINFO 0, ID, 	La 0, STANDARD._INTEGER.use__info
USEINFO 0, NAME, 	La 0, STANDARD.SEQUENTIAL_IO._FILE_NAME_BUFFER.use__info
USEINFO 0, NAME_LEN, 	La 0, STANDARD._POSITIVE.use__info
USEINFO 0, IS_OPENED, 	La 0, STANDARD._BOOLEAN.use__info
USEINFO 0, MODE, 	La 0, STANDARD.SEQUENTIAL_IO._FILE_MODE.use__info
USEINFO 0, AT_END_OF_FILE, 	La 0, STANDARD._BOOLEAN.use__info
virtual at 0				; calcul des offsets statiques
STATOFS ID, 4
STATOFS NAME, 1
STATOFS NAME_LEN, 4
STATOFS IS_OPENED, 1
STATOFS MODE, 1
STATOFS AT_END_OF_FILE, 1
size = $
end virtual
	LI	 size*8
	Sd	0, SIZ
end namespace
					;    BODY ELAB

if defined CREATE_L1_
PRO	CREATE_L1				;---------- PRO CREATE
PRMS					;    debut parametrage
	PRM FILE_ofs				; in out
	PRM MODE_ofs				; in
	PRM NAME_ofs				; in
	PRM FORM_ofs				; in
	PRM GFP_ofs
endPRMS					;    fin parametrage
ELB 1					;    BODY ELAB
VAR ERR_OR_ID_disp, d			; variable entiere


if defined CREATE_SYSTEM_CALL_L1_
PRO	CREATE_SYSTEM_CALL_L1			;---------- PRO CREATE_SYSTEM_CALL
PRMS					;    debut parametrage
	PRM NAME_ofs				; in
	PRM GFP_ofs
	PRM result__ofs				; resultat de fonction
endPRMS					;    fin parametrage
ELB 2					;    BODY ELAB
					;    end elab
begin:					;---------- BDY INSTRUCTIONS
	LA 2 ,	-8
	SYS_FILE_CREATE
	SD 2 ,	-24
ret_lbl:
	UNLINK 2
	RTD	prm_siz-8
excep:
endPRO					;---------- end PRO CREATE_SYSTEM_CALL
end if
					;    end elab
begin:					;---------- BDY INSTRUCTIONS
	LI	0					; lieu resultat sur pile
	La  1,	-GFP_ofs				; propagation GFP generique
	La  1,	-NAME_ofs
	CALL	STANDARD.SEQUENTIAL_IO.CREATE_L1. ,CREATE_SYSTEM_CALL_L1
	Sd  1,	ERR_OR_ID_disp
					; debut if
	Ld 1,	ERR_OR_ID_disp
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	0
	CGE
	BF	L3
	La 1, -FILE_ofs
	LIVA 	, 0, STANDARD.SEQUENTIAL_IO._FILE_TYPE.ID
	Ld 1,	ERR_OR_ID_disp
	Sd
	La 1, -FILE_ofs
	LIVA 	, 0, STANDARD.SEQUENTIAL_IO._FILE_TYPE.NAME
	LVA	1, -NAME_ofs
	LIa	, , 8
	Ld	, _STRING.LST_1
	LVA	1, -NAME_ofs
	LIa	, , 8
	Ld	, _STRING.FST_1
	SUB
	INC
	INC
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	1
	SUB
	LI	1
	MUL
	La  1,	-NAME_ofs
	La
	BLKMOV
	La 1, -FILE_ofs
	LIVA 	, 0, STANDARD.SEQUENTIAL_IO._FILE_TYPE.NAME_LEN
	LVA	1, -NAME_ofs
	LIa	, , 8
	Ld	, _STRING.LST_1
	LVA	1, -NAME_ofs
	LIa	, , 8
	Ld	, _STRING.FST_1
	SUB
	INC
	Sd
	La 1, -FILE_ofs
	LIVA 	, 0, STANDARD.SEQUENTIAL_IO._FILE_TYPE.IS_OPENED
	LI	1
	Sb
	La 1, -FILE_ofs
	LIVA 	, 0, STANDARD.SEQUENTIAL_IO._FILE_TYPE.MODE
	Lb  1,	-MODE_ofs
	Sb
	La 1, -FILE_ofs
	LIVA 	, 0, STANDARD.SEQUENTIAL_IO._FILE_TYPE.AT_END_OF_FILE
	LI	0
	Sb
	BRA	L2
L3:
L2:					; post if
ret_lbl:
	UNLINK 1
	RTD	prm_siz
excep:
endPRO					;---------- end PRO CREATE
end if

