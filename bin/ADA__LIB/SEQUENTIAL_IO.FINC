	MUL
	La  1,	-NAME_ofs
	La
	BLKMOV
	La 1, -FILE_ofs
	LIVA 	, 0, STANDARD.SEQUENTIAL_IO._FILE_TYPE.NAME_LEN
	LVA	1, -NAME_ofs
	LIa	, , 8
	Ld	, _STRING.LST_1
	LVA	1, -NAME_ofs
	LIa	, , 8
	Ld	, _STRING.FST_1
	SUB
	INC
	Sd
	La 1, -FILE_ofs
	LIVA 	, 0, STANDARD.SEQUENTIAL_IO._FILE_TYPE.IS_OPENED
