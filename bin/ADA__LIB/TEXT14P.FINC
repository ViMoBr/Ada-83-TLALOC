VAR F_disp, q				; variable record : pointeur aux data record
VAR F__u, q				; variable record : pointeur aux useinfo
VAR F__dat, STANDARD.TEXT_IO._FILE_TYPE.size
	LVA	1, F__dat
	Sa	1, F_disp				; record fin
	LVA	1, STANDARD.TEXT_IO._FILE_TYPE.SIZ
	Sa	1, F__u
; CODE_VC_NAME DN_VARIABLE_ID
	LIVa 1, F_disp, STANDARD.TEXT_IO._FILE_TYPE.ID
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	1
	NEG
	Sd
	LIVa 1, F_disp, STANDARD.TEXT_IO._FILE_TYPE.IS_OPENED
	LI	0
	Sb
	LIVa 1, F_disp, STANDARD.TEXT_IO._FILE_TYPE.PAGE_LENGTH
	Ld 0,	STANDARD.TEXT_IO.UNBOUNDED_disp
	Sd
	LIVa 1, F_disp, STANDARD.TEXT_IO._FILE_TYPE.LINE_LENGTH
	Ld 0,	STANDARD.TEXT_IO.UNBOUNDED_disp
	Sd
	LIVa 1, F_disp, STANDARD.TEXT_IO._FILE_TYPE.PAGE
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	1
	Sd
	LIVa 1, F_disp, STANDARD.TEXT_IO._FILE_TYPE.LINE
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	1
	Sd
	LIVa 1, F_disp, STANDARD.TEXT_IO._FILE_TYPE.COL
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	1
	Sd
	LIVa 1, F_disp, STANDARD.TEXT_IO._FILE_TYPE.IS_DEFAULT_IO
	LI	0
	Sb
	LIVa 1, F_disp, STANDARD.TEXT_IO._FILE_TYPE.LOOK_AHEAD
	LI	 0
	Sb
	LIVa 1, F_disp, STANDARD.TEXT_IO._FILE_TYPE.HAS_LOOK_AHEAD
	LI	0
	Sb
	LIVa 1, F_disp, STANDARD.TEXT_IO._FILE_TYPE.AT_END_OF_FILE
	LI	0
	Sb

VAR C_disp, d				; variable bool char enum

_S2__type = '_S2__type'
namespace _S2__type				; array var constrained array type info
VAR use__info, q
VAR SIZ, d
	LVA	1, SIZ
	Sa	1, use__info
VAR _COMP_SIZ, d
VAR _FST_1, d
VAR _LST_1, d
	LI	8
	Sd	1, _COMP_SIZ
	Ld	1, _COMP_SIZ
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	1
	Sd	1, _FST_1
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	2
	Sd	1, _LST_1
	Ld	1, _LST_1
	Ld	1, _FST_1
	SUB
	INC
	CLAMP0
	MUL
	Sd	1, SIZ
  virtual at 4
COMP_SIZ = $
	rd 1 
FST_1 = $
	rd 1 
LST_1 = $
	rd 1 
  end virtual
end namespace
VAR S2_disp, q				; variable array : pointeur aux data
VAR S2__u, q				; variable array : useinfo pointeur au rec info
	La 1, _S2__type.use__info
	Sa	1, S2__u				; array info ptr at __u
	Ld	1, _S2__type.SIZ
	LI	8
	DIV
	CO_VAR
	Sa	1, S2_disp				; array data ptr at _disp

