	CALL	STANDARD.TEXT_IO. ,CREATE_L1
STR STR_L19, "P01 CREATE"			; constante string="P01 CREATE"
	LCA	STR_L19.data_ptr
	CALL	STANDARD.TEXT_IO. ,PUT_LINE_L60
STR STR_L20, "ABC"				; constante string="ABC"
	LCA	STR_L20.data_ptr
	LVA 1,	F_disp
	CALL	STANDARD.TEXT_IO. ,PUT_LINE_L59
STR STR_L21, "P02 PUT_LINE ABC"		; constante string="P02 PUT_LINE ABC"
	LCA	STR_L21.data_ptr
	CALL	STANDARD.TEXT_IO. ,PUT_LINE_L60
STR STR_L22, "DE"				; constante string="DE"
	LCA	STR_L22.data_ptr
	LVA 1,	F_disp
	CALL	STANDARD.TEXT_IO. ,PUT_LINE_L59
STR STR_L23, "P03 PUT_LINE DE"		; constante string="P03 PUT_LINE DE"
	LCA	STR_L23.data_ptr
	CALL	STANDARD.TEXT_IO. ,PUT_LINE_L60
	Ld 1,	STANDARD.TEXT14P_L1.I_IO.DEFAULT_BASE_disp
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	1
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	42
	LVA 1,	F_disp
