ELB 2					;    BODY ELAB
 hexa_show 'var elab H ', $
 hexa_show ' disp ', H_disp
VAR H_disp, q				; variable record : pointeur aux data record
VAR H__u, q				; variable record : pointeur aux useinfo
VAR H__dat, STANDARD.IDL.SEM_PHASE_L11.SEM_GLOB._H_TYPE.size
	LVA	2, H__dat
	Sa	2, H_disp				; record fin
	LVA	2, STANDARD.IDL.SEM_PHASE_L11.SEM_GLOB._H_TYPE.SIZ
	Sa	2, H__u
; CODE_VC_NAME DN_VARIABLE_ID
	La 2, H_disp
					; Assign_record_aggregate type DN_RECORD
	DUP
	LVA	, STANDARD.IDL.SEM_PHASE_L11.SEM_GLOB._H_TYPE.REGION_DEF
	LI	STANDARD.IDL._TREE.size
	La  2,	-REGION_DEF_IN_ofs
	La  ,  0
	BLKMOV
	DUP
	LVA	, STANDARD.IDL.SEM_PHASE_L11.SEM_GLOB._H_TYPE.LEX_LEVEL
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	0
	Sd
	DUP
	LVA	, STANDARD.IDL.SEM_PHASE_L11.SEM_GLOB._H_TYPE.IS_IN_SPEC
	Lb  2,	-IN_SPEC_IN_ofs
