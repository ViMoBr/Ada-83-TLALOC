if defined FIX_WITH_DECL_LIST_L20_
PRO	FIX_WITH_DECL_LIST_L20			;---------- PRO FIX_WITH_DECL_LIST
PRMS					;    debut parametrage
	PRM DECL_LIST_IN_ofs			; in
	PRM REGION_DEF_ofs				; in
	PRM IN_SPEC_ofs				; in
	PRM SUBUNIT_IN_ofs				; in
endPRMS					;    fin parametrage
ELB 3					;    BODY ELAB
VAR DECL_LIST_disp, q			; variable record : pointeur aux data record
VAR DECL_LIST__u, q				; variable record : pointeur aux useinfo
VAR DECL_LIST__dat, STANDARD.IDL.SEQ_TYPE.size
	LVA	3, DECL_LIST__dat
	Sa	3, DECL_LIST_disp			; record fin
	LVA	3, STANDARD.IDL.SEQ_TYPE.SIZ
	Sa	3, DECL_LIST__u
; CODE_VC_NAME DN_VARIABLE_ID
	La  3, DECL_LIST_disp
	LI	STANDARD.IDL.SEQ_TYPE.size
	La  3,	-DECL_LIST_IN_ofs
	La  ,  0
	BLKMOV

VAR DECL_disp, q				; variable record : pointeur aux data record
VAR DECL__u, q				; variable record : pointeur aux useinfo
VAR DECL__dat, STANDARD.IDL.TREE.size
	LVA	3, DECL__dat
	Sa	3, DECL_disp				; record fin
	LVA	3, STANDARD.IDL.TREE.SIZ
	Sa	3, DECL__u
; CODE_VC_NAME DN_VARIABLE_ID

					;    end elab
begin:					;---------- BDY INSTRUCTIONS
LOOP__2:
	LI	0					; lieu resultat sur pile
	LVA 3,	DECL_LIST_disp
	CALL	STANDARD.IDL. ,IS_EMPTY_L23
	LI	1
	OUX
	BF	L21
	LVA  3,	DECL_disp
	LVA  3,	DECL_LIST_disp
	CALL	STANDARD.IDL. ,POP_L24
					; debut if
	BF	L23
					; debut if
	La	3, DECL_disp
	Ld
	LI	24
	LI	8
	UBFX
	LI	63
	CEQ
	La  3,	-SUBUNIT_IN_ofs
	LVA 0,	STANDARD.IDL.TREE_VOID_disp
	CEQ
	LI	1
	OUX
	BF	L25
	Lb  3,	-IN_SPEC_ofs
	La  3,	-REGION_DEF_ofs
	LVA 3,	DECL_disp
	CALL	STANDARD.IDL.SEM_PHASE_L11.FIX_WITH.FIX_WITH_CLAUSES_L1. ,FIX_WITH_ONE_DECL_L19
	BRA	L24
L25:
L24:					; post if
	BRA	L22
L23:
L22:					; post if
	DUP
	BF	L29
	DROP
	LI	174
	CEQ
L29:
	DUP
	BF	L28
	DROP
	La 3, -SUBUNIT_IN_ofs
	La	-1, 0
	Ld
	LI	24
	LI	8
	UBFX
	LI	68
	CEQ
L28:
	DUP
	BF	L27
	DROP
	LI	0					; lieu resultat sur pile
	La  3,	-SUBUNIT_IN_ofs
VAR	ANON_150_26_disp, q
VAR	ANON_150_26__u,    q
VAR	ANON_150_26__dat, STANDARD.IDL.TREE.size
	LVA 3, ANON_150_26__dat
	Sa  3, ANON_150_26_disp
	La  0, STANDARD.IDL.TREE.use__info
	Sa  3, ANON_150_26__u
	LVA 3, ANON_150_26_disp
					; doublet resultat record anonyme
VAR	ANON_150_39_disp, q
VAR	ANON_150_39__u,    q
VAR	ANON_150_39__dat, STANDARD.IDL.TREE.size
	LVA 3, ANON_150_39__dat
	Sa  3, ANON_150_39_disp
	La  0, STANDARD.IDL.TREE.use__info
	Sa  3, ANON_150_39__u
	LVA 3, ANON_150_39_disp
					; doublet resultat record anonyme
	LVA 3,	DECL_disp
	LI  20
	CALL	STANDARD.IDL. ,D_L17
	LI  16
	CALL	STANDARD.IDL. ,D_L17
	CALL	STANDARD.IDL.SEM_PHASE_L11.FIX_WITH. ,IS_ANCESTOR_L2
L27:
	BT	L21
	BRA	LOOP__2
L21:					; post loop LOOP__2
ret_lbl:
	UNLINK 3
	RTD	prm_siz
excep:
endPRO					;---------- end PRO FIX_WITH_DECL_LIST
end if

