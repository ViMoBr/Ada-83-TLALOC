; CODE_VC_NAME DN_VARIABLE_ID
	La 2, H_disp
					; Assign_record_aggregate type DN_RECORD
	DUP
	LVA	, STANDARD.IDL.SEM_PHASE_L11.SEM_GLOB.H_TYPE.REGION_DEF
	LI	STANDARD.IDL.TREE.size
	La  2,	-REGION_DEF_IN_ofs
	La  ,  0
	BLKMOV
	DUP
	LVA	, STANDARD.IDL.SEM_PHASE_L11.SEM_GLOB.H_TYPE.LEX_LEVEL
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	0
	Sd
	DUP
	LVA	, STANDARD.IDL.SEM_PHASE_L11.SEM_GLOB.H_TYPE.IS_IN_SPEC
	Lb  2,	-IN_SPEC_IN_ofs
	Sb
	DUP
	LVA	, STANDARD.IDL.SEM_PHASE_L11.SEM_GLOB.H_TYPE.IS_IN_BODY
	LI	0
	Sb
	DUP
	LVA	, STANDARD.IDL.SEM_PHASE_L11.SEM_GLOB.H_TYPE.SUBP_SYMREP
	LI	STANDARD.IDL.TREE.size
	LVA 0,	STANDARD.IDL.TREE_VOID_disp
	La  ,  0
	BLKMOV
	DUP
	LVA	, STANDARD.IDL.SEM_PHASE_L11.SEM_GLOB.H_TYPE.RETURN_TYPE
	LI	STANDARD.IDL.TREE.size
	LVA 0,	STANDARD.IDL.TREE_VOID_disp
	La  ,  0
	BLKMOV
	DUP
	LVA	, STANDARD.IDL.SEM_PHASE_L11.SEM_GLOB.H_TYPE.ENCLOSING_LOOP_ID
	LI	STANDARD.IDL.TREE.size
	LVA 0,	STANDARD.IDL.TREE_VOID_disp
	La  ,  0
	BLKMOV
	DROP

