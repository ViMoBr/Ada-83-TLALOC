if defined ADD_BLTN_IDS_TO_TABLE_L9_
PRO	ADD_BLTN_IDS_TO_TABLE_L9			;---------- PRO ADD_BLTN_IDS_TO_TABLE
PRMS					;    debut parametrage
	PRM DECL_S2_ofs				; in
endPRMS					;    fin parametrage
ELB 2					;    BODY ELAB

					; OP_CLASS ENUMERATION SUBTYPE INFO
OP_CLASS = 'OP_CLASS'
namespace OP_CLASS
VAR use__info, q
VAR SIZ, d
	LVA	2, SIZ
	Sa	2, use__info
VAR FST, b
VAR LST, b
	LI	8
	Sd	2, SIZ
	LI	0
	Sb	2, FST
	LI	20
	Sb	2, LST
VAR PARENT__u, q
	La	2, STANDARD.IDL.SEM_PHASE_L11.FIX_WITH.FIX_WITH_CLAUSES_L1.ADD_BLTN_IDS_TO_TABLE_L9.OP_CLASS.use__info
	Sa	2, PARENT__u
end namespace
VAR ID_LIST_disp, q				; variable record : pointeur aux data record
VAR ID_LIST__u, q				; variable record : pointeur aux useinfo
VAR ID_LIST__dat, STANDARD.IDL.SEQ_TYPE.size
	LVA	2, ID_LIST__dat
	Sa	2, ID_LIST_disp				; record fin
	LVA	2, STANDARD.IDL.SEQ_TYPE.SIZ
	Sa	2, ID_LIST__u
; CODE_VC_NAME DN_VARIABLE_ID
	La  2, ID_LIST_disp
	LI	STANDARD.IDL.SEQ_TYPE.size
VAR	ANON_72_29_disp, q
VAR	ANON_72_29__u,    q
VAR	ANON_72_29__dat, STANDARD.IDL.SEQ_TYPE.size
	LVA 2, ANON_72_29__dat
	Sa  2, ANON_72_29_disp
	La  0, STANDARD.IDL.SEQ_TYPE.use__info
	Sa  2, ANON_72_29__u
	LVA 2, ANON_72_29_disp
					; doublet resultat record anonyme
	La  2,	-DECL_S2_ofs
	CALL	STANDARD.IDL. ,LIST_L22
	La  ,  0
	BLKMOV

VAR ID_disp, q				; variable record : pointeur aux data record
VAR ID__u, q				; variable record : pointeur aux useinfo
VAR ID__dat, STANDARD.IDL.TREE.size
	LVA	2, ID__dat
	Sa	2, ID_disp				; record fin
	LVA	2, STANDARD.IDL.TREE.SIZ
	Sa	2, ID__u
; CODE_VC_NAME DN_VARIABLE_ID

VAR SYMREP_disp, q				; variable record : pointeur aux data record
VAR SYMREP__u, q				; variable record : pointeur aux useinfo
VAR SYMREP__dat, STANDARD.IDL.TREE.size
	LVA	2, SYMREP__dat
	Sa	2, SYMREP_disp				; record fin
	LVA	2, STANDARD.IDL.TREE.SIZ
	Sa	2, SYMREP__u
; CODE_VC_NAME DN_VARIABLE_ID

					;    end elab
begin:					;---------- BDY INSTRUCTIONS
LOOP__1:
	LI	0					; lieu resultat sur pile
	LVA 2,	ID_LIST_disp
	CALL	STANDARD.IDL. ,IS_EMPTY_L23
	LI	1
	OUX
	BF	L10
	LVA  2,	ID_disp
	LVA  2,	ID_LIST_disp
	CALL	STANDARD.IDL. ,POP_L24
					; debut if
	La	2, ID_disp
	Ld
	LI	24
	LI	8
	UBFX
	LI	40
	CEQ
	BF	L12
	LVA 2,	SYMREP_disp
	La
	LI	STANDARD.IDL.TREE.size
VAR	ANON_82_12_disp, q
VAR	ANON_82_12__u,    q
VAR	ANON_82_12__dat, STANDARD.IDL.TREE.size
	LVA 2, ANON_82_12__dat
	Sa  2, ANON_82_12_disp
	La  0, STANDARD.IDL.TREE.use__info
	Sa  2, ANON_82_12__u
	LVA 2, ANON_82_12_disp
					; doublet resultat record anonyme
	LVA 2,	ID_disp
	LI  13
	CALL	STANDARD.IDL. ,D_L17
	La
	BLKMOV
					; debut if
	La	2, SYMREP_disp
	Ld
	LI	24
	LI	8
	UBFX
	LI	1
	CEQ
	BF	L14
	LVA 2,	SYMREP_disp
	La
	LI	STANDARD.IDL.TREE.size
VAR	ANON_84_14_disp, q
VAR	ANON_84_14__u,    q
VAR	ANON_84_14__dat, STANDARD.IDL.TREE.size
	LVA 2, ANON_84_14__dat
	Sa  2, ANON_84_14_disp
	La  0, STANDARD.IDL.TREE.use__info
	Sa  2, ANON_84_14__u
	LVA 2, ANON_84_14_disp
					; doublet resultat record anonyme
VAR	ANON_84_26_disp, q
VAR	ANON_84_26__u,   q
namespace ANON_84_26_info
  VAR SIZ, d
  VAR _COMP_SIZ, d
  VAR _FST_1, d
  VAR _LST_1, d
end namespace
	LVA 2, ANON_84_26_info.SIZ
	Sa  2, ANON_84_26__u
	LVA 2, ANON_84_26_disp
	LVA 2,	SYMREP_disp
	CALL	STANDARD.IDL. ,PRINT_NAME_L25
	CALL	STANDARD.IDL.IDL_MAN. ,STORE_SYM_L40
	La
	BLKMOV
					; debut if
	LVA 2,	SYMREP_disp
	LVA 0,	STANDARD.IDL.TREE_VOID_disp
	CNE
	BF	L16
	LVA 2,	SYMREP_disp
	LVA 2,	ID_disp
	LI  13
	CALL	STANDARD.IDL. ,D_L16
	BRA	L15
L16:
L15:					; post if
	BRA	L13
L14:
L13:					; post if
					; debut if
	LVA 2,	SYMREP_disp
	LVA 0,	STANDARD.IDL.TREE_VOID_disp
	CNE
	BF	L18
	La	 1, BLTN_ID_ARRAY_disp			; array data start address on stack
	LI	0					; lieu resultat sur pile
	LVA 2,	ID_disp
	LI  152
	CALL	STANDARD.IDL. ,DI_L21
	LId	1, BLTN_ID_ARRAY__u, STANDARD.IDL.SEM_PHASE_L11.PRENAME.BLTN_ID_ARRAY.FST_1	; (index - FST_1) * SIZ_1
	SUB
	LId	1, BLTN_ID_ARRAY__u, STANDARD.IDL.SEM_PHASE_L11.PRENAME.BLTN_ID_ARRAY.COMP_SIZ
	LI	8
	DIV
	MUL
	ADD					; add offset to start address
	LI	STANDARD.IDL.TREE.size
	LVA 2,	ID_disp
	La
	BLKMOV
	BRA	L17
L18:
L17:					; post if
	BRA	L11
L12:
L11:					; post if
	BRA	LOOP__1
L10:					; post loop LOOP__1
ret_lbl:
	UNLINK 2
	RTD	prm_siz
excep:
endPRO					;---------- end PRO ADD_BLTN_IDS_TO_TABLE
end if

if defined FIX_WITH_ONE_DECL_L19_
PRO	FIX_WITH_ONE_DECL_L19			;---------- PRO FIX_WITH_ONE_DECL
PRMS					;    debut parametrage
	PRM DECL_ofs				; in
	PRM REGION_DEF_IN_ofs			; in
	PRM IN_SPEC_IN_ofs				; in
	PRM SUBUNIT_IN_ofs				; in
