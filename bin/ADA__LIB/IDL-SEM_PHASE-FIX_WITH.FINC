endPRMS					;    fin parametrage
ELB 1					;    BODY ELAB
					;    end elab
begin:					;---------- BDY INSTRUCTIONS
; CODE_RETURN : EXPR TYPE = DN_RECORD
	La   1,	-result__ofs
	La  ,  0
	LI	STANDARD.IDL._TREE.size
VAR	ANON_21_17_disp, q
VAR	ANON_21_17__u,    q
VAR	ANON_21_17__dat, STANDARD.IDL._TREE.size
	LVA 1, ANON_21_17__dat
	Sa  1, ANON_21_17_disp
	La  0, STANDARD.IDL._TREE.use__info
	Sa  1, ANON_21_17__u
	LVA 1, ANON_21_17_disp
