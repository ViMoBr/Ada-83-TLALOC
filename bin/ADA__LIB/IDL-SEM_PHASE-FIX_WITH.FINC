					;    BODY ELAB

if defined STORE_SYM_L1_
PRO	STORE_SYM_L1				;---------- PRO STORE_SYM
 hexa_show 'STORE_SYM_L1 ', $
PRMS					;    debut parametrage
	PRM TXTREP_ofs				; in
	PRM result__ofs				; resultat de fonction
endPRMS					;    fin parametrage
ELB 1					;    BODY ELAB
					;    end elab
begin:					;---------- BDY INSTRUCTIONS
; CODE_RETURN : EXPR TYPE = DN_RECORD  VUE COMPLETE = DN_RECORD
	La   1,	-result__ofs
	La  ,  0
	LI	STANDARD.IDL._TREE.size
VAR	ANON_21_17_disp, q
VAR	ANON_21_17__u,    q
VAR	ANON_21_17__dat, STANDARD.IDL._TREE.size
	LVA 1, ANON_21_17__dat
	Sa  1, ANON_21_17_disp
	La  0, STANDARD.IDL._TREE.use__info
	Sa  1, ANON_21_17__u
	LVA 1, ANON_21_17_disp
					; doublet resultat record anonyme
VAR	ANON_21_29_disp, q
VAR	ANON_21_29__u,   q
namespace ANON_21_29_info
  VAR SIZ, d
  VAR _COMP_SIZ, d
  VAR _FST_1, d
  VAR _LST_1, d
end namespace
	LVA 1, ANON_21_29_info.SIZ
	Sa  1, ANON_21_29__u
	LVA 1, ANON_21_29_disp
	La  1,	-TXTREP_ofs
	CALL	STANDARD.IDL. ,PRINT_NAME_L25
	CALL	STANDARD.IDL.IDL_MAN. ,STORE_SYM_L40
	La  ,  0
	BLKMOV
	BRA ret_lbl
ret_lbl:
	UNLINK 1
	RTD	prm_siz-8
excep:
endPRO					;---------- end PRO STORE_SYM
end if

if defined MAKE_DEF_FOR_ID_L4_
PRO	MAKE_DEF_FOR_ID_L4			;---------- PRO MAKE_DEF_FOR_ID
 hexa_show 'MAKE_DEF_FOR_ID_L4 ', $
PRMS					;    debut parametrage
	PRM ID_ofs				; in
	PRM REGION_DEF_ofs				; in
	PRM IN_SPEC_ofs				; in
	PRM result__ofs				; resultat de fonction
endPRMS					;    fin parametrage
ELB 1					;    BODY ELAB
 hexa_show 'var elab H ', $
 hexa_show ' disp ', H_disp
VAR H_disp, q				; variable record : pointeur aux data record
VAR H__u, q				; variable record : pointeur aux useinfo
VAR H__dat, STANDARD.IDL.SEM_PHASE_L11.SEM_GLOB._H_TYPE.size
	LVA	1, H__dat
	Sa	1, H_disp				; record fin
	LVA	1, STANDARD.IDL.SEM_PHASE_L11.SEM_GLOB._H_TYPE.SIZ
	Sa	1, H__u
; CODE_VC_NAME DN_VARIABLE_ID
	La 1, H_disp
					; Assign_record_aggregate type DN_RECORD
	DUP
	LVA	, STANDARD.IDL.SEM_PHASE_L11.SEM_GLOB._H_TYPE.REGION_DEF
	LI	STANDARD.IDL._TREE.size
	La  1,	-REGION_DEF_ofs
	La  ,  0
	BLKMOV
	DUP
	LVA	, STANDARD.IDL.SEM_PHASE_L11.SEM_GLOB._H_TYPE.LEX_LEVEL
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	0
	Sd
	DUP
	LVA	, STANDARD.IDL.SEM_PHASE_L11.SEM_GLOB._H_TYPE.IS_IN_SPEC
	Lb  1,	-IN_SPEC_ofs
	Sb
	DUP
	LVA	, STANDARD.IDL.SEM_PHASE_L11.SEM_GLOB._H_TYPE.IS_IN_BODY
	LI	0
	Sb
	DUP
	LVA	, STANDARD.IDL.SEM_PHASE_L11.SEM_GLOB._H_TYPE.SUBP_SYMREP
	LI	STANDARD.IDL._TREE.size
	LVA 0,	STANDARD.IDL.TREE_VOID_disp
	La  ,  0
	BLKMOV
	DUP
	LVA	, STANDARD.IDL.SEM_PHASE_L11.SEM_GLOB._H_TYPE.RETURN_TYPE
	LI	STANDARD.IDL._TREE.size
	LVA 0,	STANDARD.IDL.TREE_VOID_disp
	La  ,  0
	BLKMOV
	DUP
	LVA	, STANDARD.IDL.SEM_PHASE_L11.SEM_GLOB._H_TYPE.ENCLOSING_LOOP_ID
	LI	STANDARD.IDL._TREE.size
	LVA 0,	STANDARD.IDL.TREE_VOID_disp
	La  ,  0
	BLKMOV
	DROP

					;    end elab
begin:					;---------- BDY INSTRUCTIONS
					; debut if
; CODE record equality "/=" _TREE
	La  1,	-REGION_DEF_ofs
	La  ,  0
	Ld
	LVA 0,	STANDARD.IDL.TREE_VOID_disp
	La  ,  0
	Ld
	CEQ
	LI	1
	OUX
	BF	L8
	LIVA 	1, STANDARD.IDL.SEM_PHASE_L11.FIX_WITH.MAKE_DEF_FOR_ID_L4.H_disp, STANDARD.IDL.SEM_PHASE_L11.SEM_GLOB._H_TYPE.LEX_LEVEL
	LI	0					; lieu resultat sur pile
	La  1,	-REGION_DEF_ofs
	LI  171
	CALL	STANDARD.IDL. ,DI_L21
	Sd
	BRA	L7
L8:
L7:					; post if
					; debut if
	LI	1
	CEQ
	BF	L10
VAR	ANON_45_21_disp, q
VAR	ANON_45_21__u,    q
VAR	ANON_45_21__dat, STANDARD.IDL._TREE.size
	LVA 1, ANON_45_21__dat
	Sa  1, ANON_45_21_disp
	La  0, STANDARD.IDL._TREE.use__info
	Sa  1, ANON_45_21__u
	LVA 1, ANON_45_21_disp
					; doublet resultat record anonyme
VAR	ANON_45_32_disp, q
VAR	ANON_45_32__u,    q
VAR	ANON_45_32__dat, STANDARD.IDL._TREE.size
	LVA 1, ANON_45_32__dat
	Sa  1, ANON_45_32_disp
	La  0, STANDARD.IDL._TREE.use__info
	Sa  1, ANON_45_32__u
	LVA 1, ANON_45_32_disp
					; doublet resultat record anonyme
	La  1,	-ID_ofs
	LI  13
	CALL	STANDARD.IDL. ,D_L17
	CALL	STANDARD.IDL.SEM_PHASE_L11.FIX_WITH. ,STORE_SYM_L1
	La  1,	-ID_ofs
	LI  13
	CALL	STANDARD.IDL. ,D_L16
	BRA	L9
L10:
L9:					; post if
; CODE_RETURN : EXPR TYPE = DN_RECORD  VUE COMPLETE = DN_RECORD
	La   1,	-result__ofs
	La  ,  0
	LI	STANDARD.IDL._TREE.size
	LI	0					; lieu resultat sur pile
	LVA 1,	H_disp
	La  1,	-ID_ofs
	CALL	STANDARD.IDL.SEM_PHASE_L11.DEF_UTIL. ,MAKE_DEF_FOR_ID_L52
	La  ,  0
	BLKMOV
	BRA ret_lbl
ret_lbl:
	UNLINK 1
	RTD	prm_siz-8
excep:
endPRO					;---------- end PRO MAKE_DEF_FOR_ID
end if

