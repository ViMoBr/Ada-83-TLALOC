	LI  154
	CALL	STANDARD.IDL. ,D_L17
	LVA 2,	PARAM_S_disp
	LI  154
	CALL	STANDARD.IDL. ,D_L16
VAR	ANON_297_32_disp, q
VAR	ANON_297_32__u,    q
VAR	ANON_297_32__dat, STANDARD.IDL.TREE.size
	LVA 2, ANON_297_32__dat
