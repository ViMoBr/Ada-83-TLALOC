namespace STACK_TYPE
VAR use__info, q
VAR SIZ, d
	LVA	2, SIZ
	Sa	2, use__info
USEINFO 2, STATE, 	La 0, STANDARD.POSITIVE.use__info
USEINFO 2, SRCPOS, 	La 0, STANDARD.IDL.TREE.use__info
