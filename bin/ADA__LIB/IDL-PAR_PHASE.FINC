					; doublet resultat record anonyme
	LVA 2,	PARAM_S_disp
	LI  154
	CALL	STANDARD.IDL. ,D_L17
	LVA 2,	USED_STRING_disp
	LI  154
	CALL	STANDARD.IDL. ,D_L16
	La  2,	-AP_ofs
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	1
	ADD
	SId  2,	-AP_ofs
	VAR ANON_300_10_disp, q
	VAR ANON_300_10__u, q
	VAR ANON_300_10__dat, STANDARD.IDL.TREE.SIZ
