	Sa	1, SOURCE_LIST_disp			; record fin
	LVA	1, STANDARD.IDL.SEQ_TYPE.SIZ
	Sa	1, SOURCE_LIST__u
; CODE_VC_NAME DN_VARIABLE_ID
	La 1, SOURCE_LIST_disp
					; Assign_record_aggregate type DN_RECORD
	DUP
	LVA	, STANDARD.IDL.SEQ_TYPE.FIRST
	LI	STANDARD.IDL.TREE.size
	LVA 0,	STANDARD.IDL.TREE_NIL_disp
	La  ,  0
	BLKMOV
	DUP
	LVA	, STANDARD.IDL.SEQ_TYPE.NEXT
	LI	STANDARD.IDL.TREE.size
	LVA 0,	STANDARD.IDL.TREE_NIL_disp
	La  ,  0
	BLKMOV
	DROP

VAR SOURCE_LINE_disp, q			; variable record : pointeur aux data record
VAR SOURCE_LINE__u, q			; variable record : pointeur aux useinfo
VAR SOURCE_LINE__dat, STANDARD.IDL.TREE.size
