	LVA  1,	STANDARD.IDL.PAR_PHASE_L9.IFILE_disp
	CALL	STANDARD.TEXT_IO. ,CLOSE_L3
	CALL	STANDARD.IDL.PAGE_MAN. ,CLOSE_PAGE_MANAGER_L19
ret_lbl:
	UNLINK 1
	RTD	prm_siz
excep:
endPRO					;---------- end PRO PAR_PHASE
