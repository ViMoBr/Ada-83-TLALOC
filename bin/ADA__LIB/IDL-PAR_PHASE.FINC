	Sa 2, ANON_300_10_disp
	La 0, STANDARD.IDL.TREE.use__info
	Sa 2, ANON_300_10__u
	LVA 2, ANON_300_10__dat
					; Assign_represented_record_aggregate size 32 bits
	DUP
	LI	0
					; pack PT range 0 .. 1 width 2
	LI	0
	LI	0
	LI	2
	BFI
					; pack TY range 24 .. 31 width 8
	LI	9
	LI	24
	LI	8
	BFI
					; pack PG range 9 .. 23 width 15
	Ld  2,	-ACTION_ofs
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	1000
	MODI
; CODE CONVERSION SOURCE DN_INTEGER TARGET DN_INTEGER
	LI	9
	LI	15
	BFI
					; pack LN range 2 .. 8 width 7
	LVA	, STANDARD.GRMR_TBL.GRMR_TBL_RECORD.AC_TBL
; EXPRESSIONS.CODE_INDEXED adresse component id
	La  2,	-AP_ofs
	Ld	 0, STANDARD.GRMR_TBL.AC_TBL_TYPE._FST_1	; (index - FST_1) * SIZ_1
	SUB
	Ld	 0, STANDARD.GRMR_TBL.AC_TBL_TYPE._COMP_SIZ
	LI	8
	DIV
	MUL
	ADD					; add offset to start address
	Lw
; CODE CONVERSION SOURCE DN_INTEGER TARGET DN_INTEGER
	LI	2
	LI	7
	BFI
	Sd
	DROP
	LVA 2, ANON_300_10_disp
	LVA 2,	USED_STRING_disp
	LI  13
	CALL	STANDARD.IDL. ,D_L16
	LI	138
	CALL	STANDARD.IDL.PAR_PHASE_L9. ,MAKE_AUXA_NODE_L27
	VAR SELARG_L63_disp, q
	VAR SELARG_L63__u, q
	LIVA 	1, AUXA_disp, STANDARD.IDL.PAR_PHASE_L9.SEMSTAK_UNIT.ELMT
	Sa	2, SELARG_L63_disp
	La 0, STANDARD.IDL.TREE.use__info
	Sa	2, SELARG_L63__u
	LVA 2, SELARG_L63_disp
