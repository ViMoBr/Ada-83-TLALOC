; CODE_VC_NAME DN_VARIABLE_ID

VAR IFILE_disp, q				; variable record : pointeur aux data record
VAR IFILE__u, q				; variable record : pointeur aux useinfo
VAR IFILE__dat, STANDARD.TEXT_IO._FILE_TYPE.size
	LVA	1, IFILE__dat
	Sa	1, IFILE_disp				; record fin
	LVA	1, STANDARD.TEXT_IO._FILE_TYPE.SIZ
	Sa	1, IFILE__u
; CODE_VC_NAME DN_VARIABLE_ID
	LIVa 1, IFILE_disp, STANDARD.TEXT_IO._FILE_TYPE.ID
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	1
	NEG
	Sd
	LIVa 1, IFILE_disp, STANDARD.TEXT_IO._FILE_TYPE.IS_OPENED
	LI	0
	Sb
	LIVa 1, IFILE_disp, STANDARD.TEXT_IO._FILE_TYPE.PAGE_LENGTH
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	72
	Sd
	LIVa 1, IFILE_disp, STANDARD.TEXT_IO._FILE_TYPE.LINE_LENGTH
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	256
	Sd
	LIVa 1, IFILE_disp, STANDARD.TEXT_IO._FILE_TYPE.PAGE
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	1
	Sd
	LIVa 1, IFILE_disp, STANDARD.TEXT_IO._FILE_TYPE.LINE
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	1
	Sd
	LIVa 1, IFILE_disp, STANDARD.TEXT_IO._FILE_TYPE.COL
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	1
	Sd
	LIVa 1, IFILE_disp, STANDARD.TEXT_IO._FILE_TYPE.IS_DEFAULT_IO
	LI	0
	Sb
	LIVa 1, IFILE_disp, STANDARD.TEXT_IO._FILE_TYPE.LOOK_AHEAD
	LI	 0
	Sb
	LIVa 1, IFILE_disp, STANDARD.TEXT_IO._FILE_TYPE.HAS_LOOK_AHEAD
	LI	0
