	LVA	1, STANDARD.IDL._TREE.SIZ
	Sa	1, USER_ROOT__u
; CODE_VC_NAME DN_VARIABLE_ID
	LIVA 1, USER_ROOT_disp, STANDARD.IDL._TREE.PT
