					; SEMSTAK_ELMT_KIND ENUMERATION TYPE INFO
SEMSTAK_ELMT_KIND = 'SEMSTAK_ELMT_KIND'
namespace SEMSTAK_ELMT_KIND
VAR use__info, q
BEGIN_BLOC_DEF
db 0, 9, "NODE_ELMT"
db 1, 10, "TOKEN_ELMT"
db 2, 9, "LIST_ELMT"
END_BLOC_DEF
IMAGES	BYTES_BLOC
CST LST, d, 2
CST FST, d, 0
CST SIZ, d, 8	; SIZ en bits !
postpone
  align_q
end postpone
	LCA	SIZ
	Sa	1, use__info
end namespace

					; SEMSTAK_UNIT RECORD TYPE INFO
SEMSTAK_UNIT = 'SEMSTAK_UNIT'
namespace SEMSTAK_UNIT
VAR use__info, q
VAR SIZ, d
	LVA	1, SIZ
	Sa	1, use__info
USEINFO 1, KIND, 	La 1, STANDARD.IDL.PAR_PHASE_L9.SEMSTAK_ELMT_KIND.use__info
USEINFO 1, SPOS, 	La 0, STANDARD.IDL.TREE.use__info
virtual at 0				; calcul des offsets statiques
	LI 0	 ; offset a faire
	Sd	1, KIND__o
STATOFS SPOS, 4
size = $
end virtual
	LI	 size*8
	Sd	1, SIZ
end namespace
SEMSTAK = 'SEMSTAK'
namespace SEMSTAK				; array var constrained array type info
VAR use__info, q
VAR SIZ, d
	LVA	1, SIZ
	Sa	1, use__info
VAR _COMP_SIZ, d
VAR _FST_1, d
VAR _LST_1, d
	LI	32
	Sd	1, _COMP_SIZ
	Ld	1, _COMP_SIZ
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	1
	Sd	1, _FST_1
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	100
	Sd	1, _LST_1
	Ld	1, _LST_1
	Ld	1, _FST_1
	SUB
	INC
	MUL
	Sd	1, SIZ
  virtual at 4
COMP_SIZ = $
	rd 1 
FST_1 = $
	rd 1 
LST_1 = $
	rd 1 
  end virtual
end namespace
VAR SEMSTAK_disp, q				; variable array : pointeur aux data
VAR SEMSTAK__u, q				; variable array : useinfo pointeur au rec info
	La 1, SEMSTAK.use__info
	Sa	1, SEMSTAK__u				; array info ptr at __u
	Ld	1, SEMSTAK.SIZ
	LI	8
	DIV
	CO_VAR
	Sa	1, SEMSTAK_disp				; array data ptr at _disp

VAR SSITOP_disp, d				; variable entiere

VAR AUXA_disp, q				; variable record : pointeur aux data record
VAR AUXA__u, q				; variable record : pointeur aux useinfo
VAR AUXA__dat, STANDARD.IDL.PAR_PHASE_L9.SEMSTAK_UNIT.size
	LVA	1, AUXA__dat
	Sa	1, AUXA_disp				; record fin
	LVA	1, STANDARD.IDL.PAR_PHASE_L9.SEMSTAK_UNIT.SIZ
	Sa	1, AUXA__u
; CODE_VC_NAME DN_VARIABLE_ID

VAR TT_disp, q				; variable record : pointeur aux data record
VAR TT__u, q				; variable record : pointeur aux useinfo
VAR TT__dat, STANDARD.IDL.PAR_PHASE_L9.SEMSTAK_UNIT.size
	LVA	1, TT__dat
	Sa	1, TT_disp				; record fin
	LVA	1, STANDARD.IDL.PAR_PHASE_L9.SEMSTAK_UNIT.SIZ
	Sa	1, TT__u
; CODE_VC_NAME DN_VARIABLE_ID

VAR NODE_CREATED_disp, d			; variable bool char enum


