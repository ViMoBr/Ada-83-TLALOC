					; _SEMSTAK_ELMT_KIND ENUMERATION TYPE INFO
_SEMSTAK_ELMT_KIND = '_SEMSTAK_ELMT_KIND'
namespace _SEMSTAK_ELMT_KIND
VAR use__info, q
BEGIN_BLOC_DEF
db 0, 9, "NODE_ELMT"
db 1, 10, "TOKEN_ELMT"
db 2, 9, "LIST_ELMT"
END_BLOC_DEF
IMAGES	BYTES_BLOC
CST LST, d, 2
CST FST, d, 0
CST SIZ, d, 8	; SIZ en bits !
postpone
  align_q
end postpone
	LCA	SIZ
	Sa	1, use__info
end namespace

					; _SEMSTAK_UNIT RECORD TYPE INFO
_SEMSTAK_UNIT = '_SEMSTAK_UNIT'
namespace _SEMSTAK_UNIT
VAR use__info, q
VAR SIZ, d
	LVA	1, SIZ
	Sa	1, use__info
USEINFO 1, KIND, 	La 1, STANDARD.IDL.PAR_PHASE_L9._SEMSTAK_ELMT_KIND.use__info
USEINFO 1, SPOS, 	La 0, STANDARD.IDL._TREE.use__info
USEINFO 1, ELMT, 	La 0, STANDARD.IDL._TREE.use__info
USEINFO 1, SEQ, 	La 0, STANDARD.IDL._SEQ_TYPE.use__info
virtual at 0				; calcul des offsets statiques
STATOFS KIND, 1
STATOFS SPOS, 4
STATOFS ELMT, 4
STATOFS SEQ, 8
size = $
end virtual
	LI	 size*8
	Sd	1, SIZ
end namespace
_SEMSTAK__type = '_SEMSTAK__type'
namespace _SEMSTAK__type			; array var constrained array type info
VAR use__info, q
VAR SIZ, d
	LVA	1, SIZ
	Sa	1, use__info
VAR _COMP_SIZ, d
VAR _FST_1, d
VAR _LST_1, d
	LI	136
	Sd	1, _COMP_SIZ
	Ld	1, _COMP_SIZ
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	1
	Sd	1, _FST_1
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	100
	Sd	1, _LST_1
	Ld	1, _LST_1
	Ld	1, _FST_1
	SUB
	INC
	MUL
	Sd	1, SIZ
  virtual at 4
COMP_SIZ = $
	rd 1 
FST_1 = $
	rd 1 
LST_1 = $
	rd 1 
  end virtual
end namespace
VAR SEMSTAK_disp, q				; variable array : pointeur aux data
VAR SEMSTAK__u, q				; variable array : useinfo pointeur au rec info
	La 1, _SEMSTAK__type.use__info
	Sa	1, SEMSTAK__u				; array info ptr at __u
	Ld	1, _SEMSTAK__type.SIZ
	LI	8
	DIV
	CO_VAR
	Sa	1, SEMSTAK_disp				; array data ptr at _disp

VAR SSITOP_disp, d				; variable entiere

VAR AUXA_disp, q				; variable record : pointeur aux data record
VAR AUXA__u, q				; variable record : pointeur aux useinfo
VAR AUXA__dat, STANDARD.IDL.PAR_PHASE_L9._SEMSTAK_UNIT.size
