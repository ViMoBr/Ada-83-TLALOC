endPRMS					;    fin parametrage
ELB 1					;    BODY ELAB
VAR USER_ROOT_disp, q			; variable record : pointeur aux data record
VAR USER_ROOT__u, q				; variable record : pointeur aux useinfo
VAR USER_ROOT__dat, STANDARD.IDL._TREE.size
