	LVA	1, STANDARD.IDL.PAR_PHASE_L9._SEMSTAK_UNIT.SIZ
	Sa	1, AUXA__u
; CODE_VC_NAME DN_VARIABLE_ID
	LIVA 1, AUXA_disp, STANDARD.IDL.PAR_PHASE_L9._SEMSTAK_UNIT.KIND
