					;    end elab
begin:					;---------- BDY INSTRUCTIONS
VAR	exc_ctx_L7, q, 12
	La	0, STANDARD.EXCEPTIONS_TOP_CTX_disp
	Sa  4,	exc_ctx_L7
	LCA	L7
	Sa  4,	exc_ctx_L7 + STANDARD._EXCEPTION_CONTEXT.DISPATCH
	EXC_MACH  4,	exc_ctx_L7
	LVA  4,	exc_ctx_L7
	Sa	0, STANDARD.EXCEPTIONS_TOP_CTX_disp
STR STR_L9, ""				; constante string=""
	LCA	STR_L9.data_ptr
STR STR_L10, "parse.bin"			; constante string="parse.bin"
	LCA	STR_L10.data_ptr
	LI  0
	LVA  3,	STANDARD.IDL.PAR_PHASE_L9.READ_PARSE_TABLES_L2.BLOCK__1.BIN_FILE_disp
	CALL	STANDARD.GRMR_TBL.GRMR_TBL_IO. ,OPEN_L2
	La 0,	STANDARD.EXCEPTIONS_TOP_CTX_disp
	La , 0
	Sa 0,	STANDARD.EXCEPTIONS_TOP_CTX_disp
	BRA	L8
L7:
	La	0, STANDARD.EXCEPTIONS_CURRENT_disp
	Sa  4,	exc_ctx_L7
	La	0, STANDARD.EXCEPTIONS_CURRENT_disp
	LCA	STANDARD.IO_EXCEPTIONS.NAME_ERROR__exc.data_ptr
	CEQ
	BT	L12
	BRA	L13
L12:
STR STR_L14, "parse.bin FILE MISSING"		; constante string="parse.bin FILE MISSING"
	LCA	STR_L14.data_ptr
	CALL	STANDARD.TEXT_IO. ,PUT_LINE_L60
	LCA	STANDARD.PROGRAM_ERROR__exc.data_ptr
	Sa	0, STANDARD.EXCEPTIONS_CURRENT_disp
	BRA	STANDARD.exc_raise_
	BRA	L11
L13:
	BRA	STANDARD.exc_raise_
L11:
L8:
	UNLINK 4
endPRO
	VAR SELARG_L15_disp, q
	VAR SELARG_L15__u, q
	La 0, STANDARD.GRMR_TBL.GRMR_disp
	Sa	3, SELARG_L15_disp
	La 0, STANDARD.GRMR_TBL._GRMR_TBL_RECORD.use__info
	Sa	3, SELARG_L15__u
	LVA 3, SELARG_L15_disp
	LVA 3,	BIN_FILE_disp
