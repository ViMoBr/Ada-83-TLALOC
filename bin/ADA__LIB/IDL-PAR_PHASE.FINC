	Sa	2, SELARG_L64_disp
	La 0, STANDARD.IDL.TREE.use__info
	Sa	2, SELARG_L64__u
	LVA 2, SELARG_L64_disp
	LI  48
	CALL	STANDARD.IDL. ,D_L16
	LI  0
	VAR SELARG_L65_disp, q
	VAR SELARG_L65__u, q
	LIVA 	1, AUXA_disp, STANDARD.IDL.PAR_PHASE_L9.SEMSTAK_UNIT.ELMT
	Sa	2, SELARG_L65_disp
	La 0, STANDARD.IDL.TREE.use__info
	Sa	2, SELARG_L65__u
	LVA 2, SELARG_L65_disp
	LI  125
	CALL	STANDARD.IDL. ,DB_L18
	LVA 2,	PARAM_S_disp
	VAR SELARG_L66_disp, q
	VAR SELARG_L66__u, q
	LIVA 	1, AUXA_disp, STANDARD.IDL.PAR_PHASE_L9.SEMSTAK_UNIT.ELMT
	Sa	2, SELARG_L66_disp
	La 0, STANDARD.IDL.TREE.use__info
	Sa	2, SELARG_L66__u
	LVA 2, SELARG_L66_disp
	LI  18
	CALL	STANDARD.IDL. ,D_L16
ret_lbl:
	UNLINK 2
	RTD	prm_siz
excep:
endPRO					;---------- end PRO MAKE_FCN_NODE
end if

