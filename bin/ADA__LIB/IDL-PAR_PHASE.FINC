	Sd	1, _FST_1
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	100
	Sd	1, _LST_1
	Ld	1, _LST_1
	Ld	1, _FST_1
	SUB
	INC
	CLAMP0
	MUL
	Sd	1, SIZ
  virtual at 4
COMP_SIZ = $
	rd 1 
FST_1 = $
	rd 1 
LST_1 = $
	rd 1 
  end virtual
end namespace
VAR SEMSTAK_disp, q				; variable array : pointeur aux data
