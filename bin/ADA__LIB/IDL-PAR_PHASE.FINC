	Sa	1, SOURCE_LINE_disp			; record fin
	LVA	1, STANDARD.IDL.TREE.SIZ
	Sa	1, SOURCE_LINE__u
; CODE_VC_NAME DN_VARIABLE_ID

VAR SOURCEPOS_disp, q			; variable record : pointeur aux data record
VAR SOURCEPOS__u, q				; variable record : pointeur aux useinfo
VAR SOURCEPOS__dat, STANDARD.IDL.TREE.size
	LVA	1, SOURCEPOS__dat
	Sa	1, SOURCEPOS_disp			; record fin
	LVA	1, STANDARD.IDL.TREE.SIZ
	Sa	1, SOURCEPOS__u
; CODE_VC_NAME DN_VARIABLE_ID

VAR TOKENSYM_disp, b			; variable entiere

VAR DEBUG_PARSE_disp, d			; variable bool char enum
