					; VPTR_TYPE ENUMERATION TYPE INFO
VPTR_TYPE = 'VPTR_TYPE'
namespace VPTR_TYPE
VAR use__info, q
BEGIN_BLOC_DEF
db 0, 1, "P"
db 1, 1, "S"
db 2, 1, "L"
db 3, 2, "HI"
END_BLOC_DEF
IMAGES	BYTES_BLOC
CST LST, d, 3
CST FST, d, 0
CST SIZ, d, 8	; SIZ en bits !
postpone
  align_q
end postpone
	LCA	SIZ
	Sa	1, use__info
end namespace

					; TREE REPRESENTED RECORD TYPE INFO
TREE = 'TREE'
namespace TREE
VAR use__info, q
VAR SIZ, d
	LVA	1, SIZ
	Sa	1, use__info
	LI	32
	Sd	1, SIZ
size = 4
;   PT at 0 range 0 .. 1 width 2
;   LN at 0 range 2 .. 8 width 7
;   SLN at 0 range 2 .. 8 width 7
;   NSIZ at 0 range 2 .. 8 width 7
;   PG at 0 range 9 .. 23 width 15
;   SPG at 0 range 9 .. 23 width 15
;   ABSS at 0 range 9 .. 23 width 15
;   COL at 0 range 24 .. 31 width 8
;   TY at 0 range 24 .. 31 width 8
;   NOTY at 0 range 24 .. 31 width 8
end namespace
VAR MAX_VPG_disp, w				; variable entiere
	LI	 32767
	Sw  1,	MAX_VPG_disp


					; VPG_IDX INTEGER SUBTYPE INFO
VPG_IDX = 'VPG_IDX'
namespace VPG_IDX
VAR use__info, q
VAR SIZ, d
	LVA	1, SIZ
	Sa	1, use__info
VAR FST, w
VAR LST, w
	LI	15
	Sd	1, SIZ
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	0
	Sw	1, FST
	Lw 1,	MAX_VPG_disp
	Sw	1, LST
VAR PARENT__u, q
	La	1, STANDARD.TEST_NEW_L1.PAGE_IDX.use__info
	Sa	1, PARENT__u
end namespace

					; RPG_IDX TYPE RANGE INFO
RPG_IDX = 'RPG_IDX'
