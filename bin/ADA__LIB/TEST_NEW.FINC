	Sa	1, use__info
VAR FST, d
VAR LST, d
	LI	32
	Sd	1, SIZ
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	0
	Sd	1, FST
; CODE_NUMERIC_LITERAL DN_UNIVERSAL_INTEGER
	LI	50
	Sd	1, LST
end namespace

					; RPG_NUM INTEGER SUBTYPE INFO
RPG_NUM = 'RPG_NUM'
namespace RPG_NUM
VAR use__info, q
