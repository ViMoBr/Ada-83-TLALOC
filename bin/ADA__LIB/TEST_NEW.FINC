	La	1, STANDARD.TEST_NEW_L1.LINE_IDX.use__info
	Sa	1, PARENT__u
end namespace

					; LINE_NBR TYPE RANGE INFO
LINE_NBR = 'LINE_NBR'
namespace LINE_NBR
