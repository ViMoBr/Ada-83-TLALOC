if ~ definite DIRECT_IO
include 'DIRECT_IO.FINC'
end if
PRO	TEST_NEW_L1				;---------- PRO TEST_NEW
ELB 1					;    BODY ELAB

					; NODE_NAME ENUMERATION TYPE INFO
NODE_NAME = 'NODE_NAME'
namespace NODE_NAME
VAR use__info, q
BEGIN_BLOC_DEF
db 0, 6, "DN_NIL"
db 1, 7, "DN_VOID"
db 2, 7, "DN_ROOT"
END_BLOC_DEF
IMAGES	BYTES_BLOC
CST LST, d, 2
CST FST, d, 0
CST SIZ, d, 8	; SIZ en bits !
postpone
  align_q
end postpone
	LCA	SIZ
	Sa	1, use__info
end namespace

					; SHORT TYPE RANGE INFO
SHORT = 'SHORT'
namespace SHORT
VAR use__info, q
VAR SIZ, d
	LVA	1, SIZ
	Sa	1, use__info
VAR FST, w
VAR LST, w
	LI	16
	Sd	1, SIZ
; CODE_NUMERIC_LITERAL DN_UNIVERSAL_INTEGER
	LI	00032768
	NEG
	Sw	1, FST
; CODE_NUMERIC_LITERAL DN_UNIVERSAL_INTEGER
	LI	32767
	Sw	1, LST
end namespace

					; POSITIVE_SHORT TYPE RANGE INFO
