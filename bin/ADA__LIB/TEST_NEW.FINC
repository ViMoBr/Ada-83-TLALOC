	LVA	1, SIZ
	Sa	1, use__info
VAR FST, d
VAR LST, d
	LI	32
	Sd	1, SIZ
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	1
	Sd	1, FST
; CODE_NUMERIC_LITERAL DN_UNIVERSAL_INTEGER
	LI	50
	Sd	1, LST
VAR PARENT__u, q
	La	1, STANDARD.TEST_NEW_L1.RPG_IDX.use__info
	Sa	1, PARENT__u
end namespace

					; AREA_IDX TYPE RANGE INFO
AREA_IDX = 'AREA_IDX'
namespace AREA_IDX
VAR use__info, q
VAR SIZ, d
	LVA	1, SIZ
	Sa	1, use__info
VAR FST, d
VAR LST, d
	LI	32
	Sd	1, SIZ
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	0
	Sd	1, FST
; CODE_NUMERIC_LITERAL DN_UNIVERSAL_INTEGER
	LI	10
	Sd	1, LST
end namespace

					; array decl constrained array type info
SECTOR = 'SECTOR'
namespace SECTOR
VAR use__info, q
VAR SIZ, d
	LVA	1, SIZ
	Sa	1, use__info
VAR _COMP_SIZ, d
VAR _FST_1, d
VAR _LST_1, d
	LI	32
	Sd	1, _COMP_SIZ
	Ld	1, _COMP_SIZ
; CODE_NUMERIC_LITERAL DN_UNIVERSAL_INTEGER
	LI	0
	Sd	1, _FST_1
; CODE_NUMERIC_LITERAL DN_UNIVERSAL_INTEGER
	LI	127
	Sd	1, _LST_1
	Ld	1, _LST_1
	INC
	Ld	1, _FST_1
	SUB
	MUL
	Sd	1, SIZ
  virtual at 4
COMP_SIZ = $
	rd 1 
FST_1 = $
	rd 1 
LST_1 = $
	rd 1 
  end virtual
end namespace

					; A_SECTOR ACCESS TYPE INFO
A_SECTOR = 'A_SECTOR'
namespace A_SECTOR
VAR use__info, q
VAR SIZ, d
	LVA	1, SIZ
	Sa	1, use__info
	LI	64
	Sd	1, SIZ
VAR DESIG__u, q
	La 1, STANDARD.TEST_NEW_L1.SECTOR.use__info
	Sa	1, DESIG__u
end namespace

					; RPG_DATA RECORD TYPE INFO
RPG_DATA = 'RPG_DATA'
namespace RPG_DATA
VAR use__info, q
VAR SIZ, d
	LVA	1, SIZ
	Sa	1, use__info
USEINFO 1, VP, 	La 1, STANDARD.TEST_NEW_L1.VPG_IDX.use__info
USEINFO 1, AREA, 	La 1, STANDARD.TEST_NEW_L1.AREA_IDX.use__info
USEINFO 1, CHANGED, 	La 0, STANDARD.BOOLEAN.use__info
USEINFO 1, RECUPERABLE, 	La 0, STANDARD.BOOLEAN.use__info
USEINFO 1, DATA, 	La 1, STANDARD.TEST_NEW_L1.A_SECTOR.use__info
virtual at 0				; calcul des offsets statiques
STATOFS VP, 2
STATOFS AREA, 4
STATOFS CHANGED, 1
STATOFS RECUPERABLE, 1
STATOFS DATA, 8
size = $
end virtual
	LI	 size*8
	Sd	1, SIZ
end namespace
PAG = 'PAG'
namespace PAG				; array var constrained array type info
VAR use__info, q
VAR SIZ, d
	LVA	1, SIZ
	Sa	1, use__info
VAR _COMP_SIZ, d
VAR _FST_1, d
VAR _LST_1, d
	LI	128
	Sd	1, _COMP_SIZ
	Ld	1, _COMP_SIZ
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	1
	Sd	1, _FST_1
; CODE_NUMERIC_LITERAL DN_UNIVERSAL_INTEGER
	LI	50
	Sd	1, _LST_1
	Ld	1, _LST_1
	INC
	Ld	1, _FST_1
	SUB
	MUL
	Sd	1, SIZ
  virtual at 4
COMP_SIZ = $
	rd 1 
FST_1 = $
	rd 1 
LST_1 = $
	rd 1 
  end virtual
end namespace
VAR PAG_disp, q				; variable array : pointeur aux data
VAR PAG__u, q				; variable array : useinfo pointeur au rec info
	La 1, PAG.use__info
	Sa	1, PAG__u				; array info ptr at __u
	Ld	1, PAG.SIZ
	LI	8
	DIV
	CO_VAR
	Sa	1, PAG_disp				; array data ptr at _disp

VAR CUR_RP_disp, d				; variable entiere

VAR HIGH_VPG_disp, w			; variable entiere

					;    end elab
begin:					;---------- BDY INSTRUCTIONS
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	1
	Sd  1,	CUR_RP_disp
	La	 1, PAG_disp				; array data start address on stack
	Ld 1,	CUR_RP_disp
	LId	1, PAG__u, STANDARD.TEST_NEW_L1.PAG.FST_1	; (index - FST_1) * SIZ_1
	SUB
	LId	1, PAG__u, STANDARD.TEST_NEW_L1.PAG.COMP_SIZ
	LI	8
	DIV
	MUL
	ADD					; add offset to start address
	LVA	, STANDARD.TEST_NEW_L1.RPG_DATA.DATA
	Ld	STANDARD.TEST_NEW_L1.SECTOR.SIZ
	LI	8
	DIV
	HEAP_ALLOC
	Sa
	La	 1, PAG_disp				; array data start address on stack
	Ld 1,	CUR_RP_disp
	LId	1, PAG__u, STANDARD.TEST_NEW_L1.PAG.FST_1	; (index - FST_1) * SIZ_1
	SUB
	LId	1, PAG__u, STANDARD.TEST_NEW_L1.PAG.COMP_SIZ
	LI	8
	DIV
	MUL
	ADD					; add offset to start address
	Lq	, STANDARD.TEST_NEW_L1.RPG_DATA.DATA
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	1
	Ld	 1, STANDARD.TEST_NEW_L1.SECTOR._FST_1
	SUB
	Ld	 1, STANDARD.TEST_NEW_L1.SECTOR._COMP_SIZ
	LI	8
	DIV
	MUL
	ADD
	Ld
	LI	9
	LI	15
	UBFX
; CODE CONVERSION SOURCE DN_INTEGER TARGET DN_INTEGER
	Sw  1,	HIGH_VPG_disp
ret_lbl:
	UNLINK 1
	RTD
excep:
endPRO					;---------- end PRO TEST_NEW
