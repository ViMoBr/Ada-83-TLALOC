L39:
STR STR_L41, "CHK_CSTPRM0 6 KO"		; constante string="CHK_CSTPRM0 6 KO"
	LCA	STR_L41.data_ptr
	CALL	STANDARD.TEXT_IO. ,PUT_LINE_L60
L38:					; post if
ret_lbl:
