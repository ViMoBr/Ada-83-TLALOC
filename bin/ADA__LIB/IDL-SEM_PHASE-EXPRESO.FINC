	La  0, STANDARD.IDL.TREE.use__info
	Sa  1, ANON_58_39__u
	LVA 1, ANON_58_39_disp
					; doublet resultat record anonyme
	LVA 1,	TYPE_STRUCT_disp
	LI  81
	CALL	STANDARD.IDL. ,D_L13
	CALL	STANDARD.IDL.SEM_PHASE_L7.REQ_UTIL. ,GET_BASE_STRUCT_L108
	La
	BLKMOV
