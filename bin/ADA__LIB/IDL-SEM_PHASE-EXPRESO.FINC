					; doublet resultat record anonyme
VAR	ANON_765_30_disp, q
VAR	ANON_765_30__u,    q
VAR	ANON_765_30__dat, STANDARD.IDL.TREE.size
	LVA 1, ANON_765_30__dat
	Sa  1, ANON_765_30_disp
	La  0, STANDARD.IDL.TREE.use__info
	Sa  1, ANON_765_30__u
	LVA 1, ANON_765_30_disp
					; doublet resultat record anonyme
	LVA 1,	TEMP_TYPESET_disp
	CALL	STANDARD.IDL.SEM_PHASE_L7.SET_UTIL. ,GET_THE_TYPE_L91
	La  1,	-EXP_ofs
	CALL	STANDARD.IDL.SEM_PHASE_L7.EXPRESO. ,RESOLVE_EXP_L3
	La  ,  0
	BLKMOV
	BRA ret_lbl
ret_lbl:
	UNLINK 1
	RTD	prm_siz-8
excep:
endPRO					;---------- end PRO RESOLVE_EXP
end if

