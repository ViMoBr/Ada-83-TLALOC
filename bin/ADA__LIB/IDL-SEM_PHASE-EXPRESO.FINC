	CALL	STANDARD.IDL.SEM_PHASE_L7.SET_UTIL. ,REQUIRE_UNIQUE_TYPE_L100
; CODE_RETURN : EXPR TYPE = DN_RECORD
	La   1,	-result__ofs
	La  ,  0
	LI	STANDARD.IDL.TREE.size
VAR	ANON_765_12_disp, q
VAR	ANON_765_12__u,    q
VAR	ANON_765_12__dat, STANDARD.IDL.TREE.size
	LVA 1, ANON_765_12__dat
	Sa  1, ANON_765_12_disp
	La  0, STANDARD.IDL.TREE.use__info
	Sa  1, ANON_765_12__u
