	La  ,  0
	LI	STANDARD.IDL.TREE.size
	LVA 1,	TYPE_STRUCT_disp
	La  ,  0
	BLKMOV
	BRA ret_lbl
ret_lbl:
	UNLINK 1
	RTD	prm_siz-8
excep:
endPRO					;---------- end PRO APPROP_STRUCT
