VAR TYPESET_disp, q				; variable record : pointeur aux data record
VAR TYPESET__u, q				; variable record : pointeur aux useinfo
VAR TYPESET__dat, STANDARD.IDL.SEM_PHASE_L7.SET_UTIL.TYPESET_TYPE.size
	LVA	2, TYPESET__dat
	Sa	2, TYPESET_disp				; record fin
	LVA	2, STANDARD.IDL.SEM_PHASE_L7.SET_UTIL.TYPESET_TYPE.SIZ
	Sa	2, TYPESET__u

VAR IS_TYPE_disp, d				; variable bool char enum

					;    end elab
begin:					;---------- BDY INSTRUCTIONS
	LI  0
	LVA  2,	IS_TYPE_disp
	LVA  2,	TYPESET_disp
	LVA 1,	STANDARD.IDL.SEM_PHASE_L7.EXPRESO.RESOLVE_SUBTYPE_INDICATION_L6.CONSTRAINT_disp
	CALL	STANDARD.IDL.SEM_PHASE_L7.ATT_WALK. ,EVAL_ATTRIBUTE_L196
	LVA 1,	STANDARD.IDL.SEM_PHASE_L7.EXPRESO.RESOLVE_SUBTYPE_INDICATION_L6.CONSTRAINT_disp
	La
	LI	STANDARD.IDL.TREE.size
VAR	ANON_566_23_disp, q
VAR	ANON_566_23__u,    q
VAR	ANON_566_23__dat, STANDARD.IDL.TREE.size
	LVA 2, ANON_566_23__dat
	Sa  2, ANON_566_23_disp
	La  0, STANDARD.IDL.TREE.use__info
	Sa  2, ANON_566_23__u
	LVA 2, ANON_566_23_disp
					; doublet resultat record anonyme
	LVA 1,	STANDARD.IDL.SEM_PHASE_L7.EXPRESO.RESOLVE_SUBTYPE_INDICATION_L6.CONSTRAINT_disp
	CALL	STANDARD.IDL.SEM_PHASE_L7.ATT_WALK. ,RESOLVE_ATTRIBUTE_L197
	La
	BLKMOV
					; debut if
	LI	0					; lieu resultat sur pile
	LVA 2,	TYPESET_disp
	CALL	STANDARD.IDL.SEM_PHASE_L7.SET_UTIL. ,IS_EMPTY_L88
	Lb 2,	IS_TYPE_disp
	LI	1
	OUX
	BF	L56
	LVA 1,	STANDARD.IDL.SEM_PHASE_L7.EXPRESO.RESOLVE_SUBTYPE_INDICATION_L6.CONSTRAINT_disp
	La
	LI	STANDARD.IDL.TREE.size
	LVA 0,	STANDARD.IDL.TREE_VOID_disp
	La
	BLKMOV
	BRA	L55
L56:
L55:					; post if
	LVA 1,	STANDARD.IDL.SEM_PHASE_L7.EXPRESO.RESOLVE_SUBTYPE_INDICATION_L6.CONSTRAINT_disp
	LId  1,	-EXP_ofs
	LI  47
	CALL	STANDARD.IDL. ,D_L12
	UNLINK 2
endPRO
	BRA	L51
L52:
L51:					; post if
	La  1,	-SUBTYPE_SPEC_ofs
	La
	LI	STANDARD.IDL.TREE.size
	LVA 1,	NEW_TYPE_SPEC_disp
	La
	BLKMOV
ret_lbl:
	UNLINK 1
	RTD	prm_siz
excep:
endPRO					;---------- end PRO RESOLVE_SUBTYPE_INDICATION
end if

