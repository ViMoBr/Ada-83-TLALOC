if defined LENGTH_L12_
PRO	LENGTH_L12				;---------- PRO LENGTH
PRMS					;    debut parametrage
	PRM A_ofs				; in
	PRM result__ofs				; resultat de fonction
endPRMS					;    fin parametrage
ELB 1					;    BODY ELAB
VAR COUNT_disp, d				; variable entiere
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	0
	Sd  1,	COUNT_disp

VAR ATAIL_disp, q				; variable record : pointeur aux data record
VAR ATAIL__u, q				; variable record : pointeur aux useinfo
VAR ATAIL__dat, STANDARD.IDL.SEQ_TYPE.size
	LVA	1, ATAIL__dat
	Sa	1, ATAIL_disp				; record fin
	LVA	1, STANDARD.IDL.SEQ_TYPE.SIZ
	Sa	1, ATAIL__u
	La  1, ATAIL_disp
	LI	STANDARD.IDL.SEQ_TYPE.size
	La  1,	-A_ofs
	La  ,  0
	BLKMOV

					;    end elab
begin:					;---------- BDY INSTRUCTIONS
LOOP__1:
	LI	0					; lieu resultat sur pile
	LVA 1,	ATAIL_disp
	CALL	STANDARD.IDL. ,IS_EMPTY_L19
	LI	1
	OUX
	BF	L13
	Ld 1,	COUNT_disp
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	1
	ADD
	Sd  1,	COUNT_disp
	LVA 1,	ATAIL_disp
	La
	LI	STANDARD.IDL.SEQ_TYPE.size
VAR	ANON_49_16_disp, q
VAR	ANON_49_16__u,    q
VAR	ANON_49_16__dat, STANDARD.IDL.SEQ_TYPE.size
	LVA 1, ANON_49_16__dat
	Sa  1, ANON_49_16_disp
	La  0, STANDARD.IDL.SEQ_TYPE.use__info
	Sa  1, ANON_49_16__u
	LVA 1, ANON_49_16_disp
					; doublet resultat record anonyme
	LVA 1,	ATAIL_disp
	CALL	STANDARD.IDL.IDL_MAN. ,TAIL_L24
	La
	BLKMOV
	BRA	LOOP__1
L13:					; post loop LOOP__1
; CODE_RETURN : EXPR TYPE = DN_INTEGER
	Ld 1,	COUNT_disp
	Sd  1,	-result__ofs
	BRA ret_lbl
ret_lbl:
	UNLINK 1
	RTD	prm_siz-8
excep:
endPRO					;---------- end PRO LENGTH
end if

