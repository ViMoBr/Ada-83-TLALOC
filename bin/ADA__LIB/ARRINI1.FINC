	Sd	1, _FST_1
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	5
	Sd	1, _LST_1
	Ld	1, _LST_1
	Ld	1, _FST_1
	SUB
	INC
	CLAMP0
	MUL
	Sd	1, SIZ
  virtual at 4
