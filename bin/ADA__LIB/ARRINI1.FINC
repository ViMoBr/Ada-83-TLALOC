if defined CHECK_L8_
PRO	CHECK_L8				;---------- PRO CHECK
 hexa_show 'CHECK_L8 ', $
PRMS					;    debut parametrage
	PRM COND_ofs				; in
	PRM SECTION_ofs				; in
	PRM NUM_ofs				; in
endPRMS					;    fin parametrage
ELB 2					;    BODY ELAB
					;    end elab
begin:					;---------- BDY INSTRUCTIONS
					; debut if
	ULb  2,	-COND_ofs
	BF	L12
	Ld 1,	STANDARD.ARRINI1_L1.OK_COUNT_disp
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	1
	ADD
	Sd  1,	STANDARD.ARRINI1_L1.OK_COUNT_disp
	BRA	L11
L12:
	Ld 1,	STANDARD.ARRINI1_L1.FAIL_COUNT_disp
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	1
	ADD
	Sd  1,	STANDARD.ARRINI1_L1.FAIL_COUNT_disp
STR STR_L13, "* ECHEC section"		; constante string="* ECHEC section"
	LCA	STR_L13.data_ptr
	CALL	STANDARD.TEXT_IO. ,PUT_L56
	Ld 1,	STANDARD.ARRINI1_L1.INT_IO.DEFAULT_BASE_disp
	DUP
	Ld	0, STANDARD.TEXT_IO._NUMBER_BASE.FST
	CLT
	BT	STANDARD.ce_raise_
	DUP
	Ld	0, STANDARD.TEXT_IO._NUMBER_BASE.LST
	CGT
	BT	STANDARD.ce_raise_
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	2
	DUP
	Ld	0, STANDARD.TEXT_IO._FIELD.FST
	CLT
	BT	STANDARD.ce_raise_
	DUP
	Ld	0, STANDARD.TEXT_IO._FIELD.LST
	CGT
	BT	STANDARD.ce_raise_
	Ld  2,	-SECTION_ofs
	CALL	STANDARD.ARRINI1_L1.INT_IO. ,PUT_L5
STR STR_L14, " test"			; constante string=" test"
	LCA	STR_L14.data_ptr
	CALL	STANDARD.TEXT_IO. ,PUT_L56
	Ld 1,	STANDARD.ARRINI1_L1.INT_IO.DEFAULT_BASE_disp
	DUP
	Ld	0, STANDARD.TEXT_IO._NUMBER_BASE.FST
	CLT
	BT	STANDARD.ce_raise_
	DUP
	Ld	0, STANDARD.TEXT_IO._NUMBER_BASE.LST
	CGT
	BT	STANDARD.ce_raise_
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	3
	DUP
	Ld	0, STANDARD.TEXT_IO._FIELD.FST
	CLT
	BT	STANDARD.ce_raise_
	DUP
	Ld	0, STANDARD.TEXT_IO._FIELD.LST
	CGT
	BT	STANDARD.ce_raise_
	Ld  2,	-NUM_ofs
	CALL	STANDARD.ARRINI1_L1.INT_IO. ,PUT_L5
; CODE_NUMERIC_LITERAL DN_INTEGER
