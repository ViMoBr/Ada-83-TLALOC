PRO	EXC_TEST1U_L1				;---------- PRO EXC_TEST1U
ELB 1					;    BODY ELAB
STR PERDUE__exc, "PERDUE"

if defined LEVE_L2_
PRO	LEVE_L2				;---------- PRO LEVE
ELB 2					;    BODY ELAB
					;    end elab
begin:					;---------- BDY INSTRUCTIONS
	LCA	STANDARD.EXC_TEST1U_L1.PERDUE__exc.data_ptr
	Sa	0, STANDARD.EXCEPTIONS_CURRENT_disp
	BRA	STANDARD.exc_raise_
ret_lbl:
	UNLINK 2
	RTD
excep:
endPRO					;---------- end PRO LEVE
end if
					;    end elab
begin:					;---------- BDY INSTRUCTIONS
	CALL	STANDARD.EXC_TEST1U_L1. ,LEVE_L2
ret_lbl:
	UNLINK 1
	RTD
excep:
endPRO					;---------- end PRO EXC_TEST1U
