					; sub program entry decl (in instantiation TRUE )
if defined PUT_L7_
PRO	PUT_L7				;---------- PRO PUT
 hexa_show 'PUT_L7 ', $
PRMS					;    debut parametrage
	PRM TO_ofs				; out
	PRM ITEM_ofs				; in
	PRM BASE_ofs				; in
endPRMS					;    fin parametrage
ELB 2
begin:
	LVA	 1, GFP_disp
	Ld	 2, -BASE_ofs
