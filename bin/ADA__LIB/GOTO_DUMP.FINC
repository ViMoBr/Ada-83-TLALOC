GOTO_DUMP = 'GOTO_DUMP'
PRO	GOTO_DUMP_L1				;---------- PRO GOTO_DUMP
 hexa_show 'GOTO_DUMP_L1 ', $
ELB 1					;    BODY ELAB
 hexa_show 'var elab A ', $
 hexa_show ' disp ', A_disp
VAR A_disp, d				; variable entiere
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	0
	Sd  1,	A_disp

 hexa_show 'var elab N ', $
 hexa_show ' disp ', N_disp
VAR N_disp, d				; variable entiere
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	0
	Sd  1,	N_disp

					;    end elab
begin:					;---------- BDY INSTRUCTIONS
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	1
	Sd  1,	A_disp
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	2
	Sd  1,	A_disp
					; debut if
	Ld 1,	N_disp
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	3
	CLT
	BF	L5
	BRA	L4
L5:
L4:					; post if
namespace	BLOCK__1
ELB 2					;    BODY ELAB
 hexa_show 'var elab B ', $
 hexa_show ' disp ', B_disp
VAR B_disp, d				; variable entiere
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	10
	Sd  2,	B_disp

					;    end elab
begin:					;---------- BDY INSTRUCTIONS
	Ld 2,	B_disp
	Ld 1,	STANDARD.GOTO_DUMP_L1.A_disp
	ADD
	Sd  2,	B_disp
					; debut if
	Ld 1,	STANDARD.GOTO_DUMP_L1.A_disp
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	6
	CLT
	BF	L9
	BRA	L8
L9:
L8:					; post if
	Ld 2,	B_disp
	Sd  1,	STANDARD.GOTO_DUMP_L1.A_disp
	UNLINK 2
endPRO
ret_lbl:
	UNLINK 1
	RTD
excep:
endPRO					;---------- end PRO GOTO_DUMP
