UARITH = 'UARITH'
namespace UARITH				;---------- PACKAGE
elab_spec:				;    SPEC ELAB

					;    BODY ELAB

if defined IS_ZERO_L28_
PRO	IS_ZERO_L28				;---------- PRO IS_ZERO
PRMS					;    debut parametrage
	PRM V_ofs				; in
	PRM result__ofs				; resultat de fonction
endPRMS					;    fin parametrage
ELB 1					;    BODY ELAB
					;    end elab
begin:					;---------- BDY INSTRUCTIONS
; CODE_RETURN : EXPR TYPE = DN_ENUMERATION
	La 1, -V_ofs
	LIVA 	, 0, STANDARD.IDL.SEM_PHASE_L7.UNIV_OPS.VECTOR.D
	La 1, -V_ofs
	LId	, 0, STANDARD.IDL.SEM_PHASE_L7.UNIV_OPS.VECTOR.L
	INC
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	1
	SUB
	LI	2
	MUL
!! FUNCTION D : PAS D ATTRIBUT XD_SOURCE_NAME DANS [DN_VOID<0.0]>
