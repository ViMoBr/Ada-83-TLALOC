	La 1, -V_ofs
	LId	, 0, STANDARD.IDL.SEM_PHASE_L11.UNIV_OPS._VECTOR.L
	INC
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	1
	SUB
	LI	2
	MUL
					; Assign_array_aggregate dynamic type DN_ARRAY
namespace ANON_20_31_aga
  VAR _FST_1, d
  VAR _LST_1, d
  VAR _LEN_1, d
  VAR _STR_1, d
  VAR _PTR_1, q
  VAR _CNT_1, d
  VAR _EMIS_1, d
end namespace
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	1
	Sd  1, ANON_20_31_aga._FST_1
	La 1, -V_ofs
	LId	, 0, STANDARD.IDL.SEM_PHASE_L11.UNIV_OPS._VECTOR.L
	Sd  1, ANON_20_31_aga._LST_1
	Ld  1, ANON_20_31_aga._LST_1
	Ld  1, ANON_20_31_aga._FST_1
	SUB
	INC
	Sd  1, ANON_20_31_aga._LEN_1
	LI	2
	Sd  1, ANON_20_31_aga._STR_1
	Sa  1, ANON_20_31_aga._PTR_1
	LI	0
	Sd  1, ANON_20_31_aga._EMIS_1
	La 1, -V_ofs
	LId	, 0, STANDARD.IDL.SEM_PHASE_L11.UNIV_OPS._VECTOR.L
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	1
	SUB
	INC
	Sd  1, ANON_20_31_aga._CNT_1
	Ld  1, ANON_20_31_aga._CNT_1
	LI	0
	CLE
	BT  L3
L2:
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	0
	SIw  1, ANON_20_31_aga._PTR_1, 0
	La  1, ANON_20_31_aga._PTR_1
	Ld  1, ANON_20_31_aga._STR_1
	ADD
	Sa  1, ANON_20_31_aga._PTR_1
	Ld  1, ANON_20_31_aga._EMIS_1
	INC
	Sd  1, ANON_20_31_aga._EMIS_1
	Ld  1, ANON_20_31_aga._CNT_1
	DEC
	DUP
	Sd  1, ANON_20_31_aga._CNT_1
	LI	0
	CGT
	BT  L2
L3:
	CEQ
	Sb  1,	-result__ofs
	BRA ret_lbl
ret_lbl:
	UNLINK 1
	RTD	prm_siz-8
excep:
endPRO					;---------- end PRO IS_ZERO
end if

