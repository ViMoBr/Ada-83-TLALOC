if defined IS_ZERO_L28_
PRO	IS_ZERO_L28				;---------- PRO IS_ZERO
PRMS					;    debut parametrage
	PRM V_ofs				; in
	PRM result__ofs				; resultat de fonction
endPRMS					;    fin parametrage
ELB 1					;    BODY ELAB
					;    end elab
begin:					;---------- BDY INSTRUCTIONS
; CODE_RETURN : EXPR TYPE = DN_ENUMERATION
	La 1, -V_ofs
	LIVA 	, 0, STANDARD.IDL.SEM_PHASE_L11.UNIV_OPS.VECTOR.D
	La 1, -V_ofs
	LId	, 0, STANDARD.IDL.SEM_PHASE_L11.UNIV_OPS.VECTOR.L
	INC
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	1
	SUB
	LI	2
	MUL
					; Assign_array_aggregate dynamic type DN_ARRAY
namespace ANON_20_31_aga
  VAR FST_1,  d
  VAR LST_1,  d
  VAR LEN_1,  d
  VAR STR_1,  d
  VAR PTR_1,  q
  VAR CNT_1,  d
  VAR EMIS_1, d
end namespace
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	1
	Sd  1, ANON_20_31_aga.FST_1
	La 1, -V_ofs
	LId	, 0, STANDARD.IDL.SEM_PHASE_L11.UNIV_OPS.VECTOR.L
	Sd  1, ANON_20_31_aga.LST_1
	Ld  1, ANON_20_31_aga.LST_1
	Ld  1, ANON_20_31_aga.FST_1
	SUB
	INC
	Sd  1, ANON_20_31_aga.LEN_1
	LI	2
	Sd  1, ANON_20_31_aga.STR_1
	Sa  1, ANON_20_31_aga.PTR_1
	LI	0
	Sd  1, ANON_20_31_aga.EMIS_1
	La 1, -V_ofs
	LId	, 0, STANDARD.IDL.SEM_PHASE_L11.UNIV_OPS.VECTOR.L
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	1
	SUB
	INC
	Sd  1, ANON_20_31_aga.CNT_1
	Ld  1, ANON_20_31_aga.CNT_1
	LI	0
	CLE
	BT  L30
L29:
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	0
	SIw  1, ANON_20_31_aga.PTR_1, 0
	La  1, ANON_20_31_aga.PTR_1
	Ld  1, ANON_20_31_aga.STR_1
	ADD
	Sa  1, ANON_20_31_aga.PTR_1
	Ld  1, ANON_20_31_aga.EMIS_1
	INC
	Sd  1, ANON_20_31_aga.EMIS_1
	Ld  1, ANON_20_31_aga.CNT_1
	DEC
	DUP
	Sd  1, ANON_20_31_aga.CNT_1
	LI	0
	CGT
	BT  L29
L30:
	CEQ
	Sb  1,	-result__ofs
	BRA ret_lbl
ret_lbl:
	UNLINK 1
	RTD	prm_siz-8
excep:
endPRO					;---------- end PRO IS_ZERO
end if

