	Sd	1, SIZ
	LI	1
	Sd	1, FST
	LI	2147483647
	Sd	1, LST
VAR PARENT__u, q
	La	1, STANDARD.DIRECT_IO_TEST_L1.LONG_FLOAT_DIRECT_IO.COUNT.use__info
	Sa	1, PARENT__u
end namespace
