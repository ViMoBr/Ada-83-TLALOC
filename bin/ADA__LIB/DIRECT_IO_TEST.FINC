PRO	DIRECT_IO_TEST_L1			;---------- PRO DIRECT_IO_TEST
ELB 1					;    BODY ELAB
VAR B_disp, d				; variable bool char enum
	LI	1
	Sb  1,	B_disp

INT_IO = 'INT_IO'
namespace INT_IO				;---------- GENERIC PACKAGE INSTANTIATION
elab_spec:				;    SPEC ELAB

BRA post_LD_INTEGER
LD_INTEGER.elab:
	Ld -1, 0
	RTD 0
post_LD_INTEGER:
BRA post_ST_INTEGER
ST_INTEGER.elab:
	SId -1, 0
	RTD 0
post_ST_INTEGER:
VAR INTEGER__st_ofs, q
	LCA ST_INTEGER.elab
	Sa	 1, INTEGER__st_ofs
VAR INTEGER__ld_ofs, q
	LCA LD_INTEGER.elab
	Sa	 1, INTEGER__ld_ofs
VAR INTEGER__u_ofs, q
	La	 0, STANDARD.INTEGER.use__info
	Sa	 1, INTEGER__u_ofs
VAR GFP_disp, q				; Lieu du Generic Frame Pointer 
VAR DEFAULT_WIDTH_disp, d			; variable entiere
	Sd  1,	DEFAULT_WIDTH_disp

VAR DEFAULT_BASE_disp, d			; variable entiere
	LI	10
	Sd  1,	DEFAULT_BASE_disp

if defined GET_L2_
PRO	GET_L2				;---------- PRO GET
PRMS					;    debut parametrage
	PRM FILE_ofs				; in
	PRM ITEM_ofs				; out
	PRM WIDTH_ofs				; in
endPRMS					;    fin parametrage
ELB 2
begin:
	LVA	 1, GFP_disp
	Lq	 2, -WIDTH_ofs
	La 	 2, -ITEM_ofs
	La 	 2, -FILE_ofs
	CALL	STANDARD.TEXT_IO.INTEGER_IO. ,GET_L61
	UNLINK	 2
	RTD	prm_siz
endPRO					;---------- end PRO GET
end if
