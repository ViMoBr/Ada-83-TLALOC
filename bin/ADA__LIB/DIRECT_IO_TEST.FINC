FILE_NAME_BUFFER = 'FILE_NAME_BUFFER'
namespace FILE_NAME_BUFFER			; FILE_NAME_BUFFER CONSTRAINED ARRAY SUBTYPE INFO
VAR use__info, q
VAR SIZ, d
	LVA	1, SIZ
	Sa	1, use__info
VAR COMP_SIZ, d
VAR FST_1, d
VAR LST_1, d
	LI	8
	Sd	1, COMP_SIZ
	Ld	1, COMP_SIZ
	LI	1
	Sd	1, FST_1
	LI	256
	Sd	1, LST_1
	Ld	1, LST_1
	INC
	Ld	1, FST_1
	SUB
	MUL
	Sd	1, SIZ
  virtual at 4
COMP_SIZ = $
	rd 1 
FST_1 = $
	rd 1 
LST_1 = $
	rd 1 
  end virtual
end namespace

					; FILE_TYPE RECORD TYPE INFO
FILE_TYPE = 'FILE_TYPE'
namespace FILE_TYPE
VAR use__info, q
VAR SIZ, d
	LVA	1, SIZ
	Sa	1, use__info
USEINFO 1, ID, 	La 0, STANDARD.INTEGER.use__info
USEINFO 1, NAME, 	La 1, STANDARD.DIRECT_IO_TEST_L1.LF_IO.FILE_NAME_BUFFER.use__info
USEINFO 1, NAME_LEN, 	La 0, STANDARD.POSITIVE.use__info
USEINFO 1, IS_OPENED, 	La 0, STANDARD.BOOLEAN.use__info
USEINFO 1, MODE, 	La 1, STANDARD.DIRECT_IO_TEST_L1.LF_IO.FILE_MODE.use__info
USEINFO 1, INDEX, 	La 1, STANDARD.DIRECT_IO_TEST_L1.LF_IO.POSITIVE_COUNT.use__info
USEINFO 1, AT_END_OF_FILE, 	La 0, STANDARD.BOOLEAN.use__info
virtual at 0				; calcul des offsets statiques
STATOFS ID, 4
STATOFS NAME, 256
STATOFS NAME_LEN, 4
STATOFS IS_OPENED, 1
STATOFS MODE, 1
STATOFS INDEX, 4
STATOFS AT_END_OF_FILE, 1
size = $
	LI	 size* 8
end virtual
	Sd	1, SIZ
end namespace
					;---------- end generic package instantiation LF_IO
end namespace

VAR F_disp, q				; variable record : pointeur aux data record
VAR F__u, q				; variable record : pointeur aux useinfo
VAR F__dat, STANDARD.DIRECT_IO_TEST_L1.LF_IO.FILE_TYPE.size
	LVA	1, F__dat
	Sa	1, F_disp				; record fin
