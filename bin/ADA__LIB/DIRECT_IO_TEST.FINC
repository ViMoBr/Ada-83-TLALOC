if ~ definite TEXT_IO
include 'TEXT_IO.FINC'
end if
if ~ definite DIRECT_IO
include 'DIRECT_IO.FINC'
end if
PRO	DIRECT_IO_TEST_L1			;---------- PRO DIRECT_IO_TEST
ELB 1					;    BODY ELAB

					; _COULEUR ENUMERATION TYPE INFO
_COULEUR = '_COULEUR'
namespace _COULEUR
VAR use__info, q
BEGIN_BLOC_DEF
db 0, 5, "ROUGE"
db 1, 4, "VERT"
db 2, 4, "BLEU"
db 3, 5, "BLANC"
db 4, 4, "NOIR"
END_BLOC_DEF
IMAGES	BYTES_BLOC
CST LST, d, 4
CST FST, d, 0
CST SIZ, d, 8	; SIZ en bits !
postpone
  align_q
end postpone
	LCA	SIZ
	Sa	1, use__info
end namespace

					; _POINT RECORD TYPE INFO
_POINT = '_POINT'
namespace _POINT
VAR use__info, q
VAR SIZ, d
	LVA	1, SIZ
	Sa	1, use__info
USEINFO 1, X, 	La 0, STANDARD._INTEGER.use__info
USEINFO 1, Y, 	La 0, STANDARD._INTEGER.use__info
USEINFO 1, Z, 	La 0, STANDARD._INTEGER.use__info
virtual at 0				; calcul des offsets statiques
STATOFS X, 4
STATOFS Y, 4
STATOFS Z, 4
size = $
end virtual
	LI	 size*8
	Sd	1, SIZ
end namespace

					; array decl constrained array type info
_VECTEUR = '_VECTEUR'
namespace _VECTEUR
VAR use__info, q
VAR SIZ, d
	LVA	1, SIZ
	Sa	1, use__info
VAR _COMP_SIZ, d
VAR _FST_1, d
VAR _LST_1, d
	LI	32
	Sd	1, _COMP_SIZ
	Ld	1, _COMP_SIZ
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	1
	Sd	1, _FST_1
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	4
	Sd	1, _LST_1
	Ld	1, _LST_1
	Ld	1, _FST_1
	SUB
	INC
	CLAMP0
	MUL
	Sd	1, SIZ
  virtual at 4
COMP_SIZ = $
	rd 1 
FST_1 = $
	rd 1 
LST_1 = $
	rd 1 
  end virtual
end namespace
INT_IO = 'INT_IO'
namespace INT_IO				;---------- GENERIC PACKAGE INSTANTIATION
elab_spec:				;    SPEC ELAB

BRA post_LD_NUM
LD_NUM.elab:
	Ld -1, 0
	RTD 0
