_FILE_TYPE = '_FILE_TYPE'
namespace _FILE_TYPE
VAR use__info, Q
VAR SIZ__, D
	LVA	1, SIZ__
	SA	1, use__info
USEINFO 1, ID, 	LA 0, STANDARD._INTEGER.use__info
USEINFO 1, NAME, 	LA 1, STANDARD.DIRECT_IO_TEST_L1.POINT_DIO._FILE_NAME_BUFFER.use__info
USEINFO 1, NAME_LEN, 	LA 0, STANDARD._POSITIVE.use__info
USEINFO 1, IS_OPENED, 	LA 0, STANDARD._BOOLEAN.use__info
USEINFO 1, MODE, 	LA 1, STANDARD.DIRECT_IO_TEST_L1.POINT_DIO._FILE_MODE.use__info
USEINFO 1, INDEX, 	LA 1, STANDARD.DIRECT_IO_TEST_L1.POINT_DIO._POSITIVE_COUNT.use__info
USEINFO 1, AT_END_OF_FILE, 	LA 0, STANDARD._BOOLEAN.use__info
virtual at 0
STATOFS ID, 4, 4
STATOFS NAME, 256, 1
STATOFS NAME_LEN, 4, 4
STATOFS IS_OPENED, 1, 1
STATOFS MODE, 1, 1
STATOFS INDEX, 4, 4
STATOFS AT_END_OF_FILE, 1, 1
size = $
end virtual
	LI	 size*8
	SD	1, SIZ__
end namespace

end namespace
VEC_DIO = 'VEC_DIO'
namespace VEC_DIO
elab_spec:
BRA post_LD_ELEMENT_TYPE
LD_ELEMENT_TYPE.elab:
	LI 0
	RTD 0
post_LD_ELEMENT_TYPE:
BRA post_ST_ELEMENT_TYPE
ST_ELEMENT_TYPE.elab:
	DROP
	RTD 0
post_ST_ELEMENT_TYPE:
BRA post_INADR_ELEMENT_TYPE
INADR_ELEMENT_TYPE.elab:
	LIA
	RTD 0
post_INADR_ELEMENT_TYPE:
BRA post_OUTADR_ELEMENT_TYPE
OUTADR_ELEMENT_TYPE.elab:
	LIA
	RTD 0
post_OUTADR_ELEMENT_TYPE:
VAR ELEMENT_TYPE__outadr_ofs, Q
	LCA OUTADR_ELEMENT_TYPE.elab
	SA	 1, ELEMENT_TYPE__outadr_ofs
VAR ELEMENT_TYPE__inadr_ofs, Q
	LCA INADR_ELEMENT_TYPE.elab
	SA	 1, ELEMENT_TYPE__inadr_ofs
VAR ELEMENT_TYPE__st_ofs, Q
	LCA ST_ELEMENT_TYPE.elab
	SA	 1, ELEMENT_TYPE__st_ofs
VAR ELEMENT_TYPE__ld_ofs, Q
	LCA LD_ELEMENT_TYPE.elab
	SA	 1, ELEMENT_TYPE__ld_ofs
VAR ELEMENT_TYPE__u_ofs, Q
	LA	 1, STANDARD.DIRECT_IO_TEST_L1._VECTEUR.use__info
	SA	 1, ELEMENT_TYPE__u_ofs
VAR GFP_disp, Q

 hexa_show ' spec ', $
_FILE_MODE = '_FILE_MODE'
