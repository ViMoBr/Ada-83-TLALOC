	Sa	 1, LONG_FLOAT__u_ofs
VAR GFP_disp, q				; Lieu du Generic Frame Pointer 
; CODE_TYPE_DECL : skip PRIVATE FILE_TYPE (deferred to full type)

					; FILE_MODE ENUMERATION TYPE INFO
FILE_MODE = 'FILE_MODE'
namespace FILE_MODE
VAR use__info, q
BEGIN_BLOC_DEF
db 0, 7, "IN_FILE"
db 1, 10, "INOUT_FILE"
db 2, 8, "OUT_FILE"
END_BLOC_DEF
IMAGES	BYTES_BLOC
CST LST, d, 2
CST FST, d, 0
CST SIZ, d, 8	; SIZ en bits !
postpone
  align_q
end postpone
	LCA	SIZ
	Sa	1, use__info
end namespace

					; COUNT TYPE RANGE INFO
COUNT = 'COUNT'
namespace COUNT
VAR use__info, q
VAR SIZ, d
	LVA	1, SIZ
	Sa	1, use__info
VAR FST, d
VAR LST, d
	LI	32
	Sd	1, SIZ
	LI	0
	Sd	1, FST
	LI	2147483647
	Sd	1, LST
end namespace

					; POSITIVE_COUNT INTEGER SUBTYPE INFO
POSITIVE_COUNT = 'POSITIVE_COUNT'
namespace POSITIVE_COUNT
VAR use__info, q
VAR SIZ, d
	LVA	1, SIZ
	Sa	1, use__info
VAR FST, d
VAR LST, d
	LI	32
	Sd	1, SIZ
	LI	1
	Sd	1, FST
	LI	2147483647
	Sd	1, LST
VAR PARENT__u, q
	La	1, STANDARD.DIRECT_IO_TEST_L1.LF_IO.COUNT.use__info
	Sa	1, PARENT__u
end namespace
