_FILE_NAME_BUFFER = '_FILE_NAME_BUFFER'
namespace _FILE_NAME_BUFFER
VAR use__info, Q
VAR SIZ__, D
	LVA	1, SIZ__
	SA	1, use__info
VAR _COMP_SIZ, D
VAR _FST_1, D
VAR _LST_1, D
	LI	8
	SD	1, _COMP_SIZ
	LD	1, _COMP_SIZ
	LI	1
	SD	1, _FST_1
	LI	256
	SD	1, _LST_1
	LD	1, _LST_1
	LD	1, _FST_1
	SUB
	INC
	CLAMP0
	MUL
	SD	1, SIZ__
  virtual at 4
COMP_SIZ = $
	rd 1 
FST_1 = $
	rd 1 
LST_1 = $
	rd 1 
  end virtual
end namespace
_FILE_TYPE = '_FILE_TYPE'
namespace _FILE_TYPE
VAR use__info, Q
VAR SIZ__, D
	LVA	1, SIZ__
	SA	1, use__info
USEINFO 1, ID, 	LA 0, STANDARD._INTEGER.use__info
USEINFO 1, NAME, 	LA 1, STANDARD.DIRECT_IO_TEST_L1.CLR_DIO._FILE_NAME_BUFFER.use__info
USEINFO 1, NAME_LEN, 	LA 0, STANDARD._POSITIVE.use__info
USEINFO 1, IS_OPENED, 	LA 0, STANDARD._BOOLEAN.use__info
USEINFO 1, MODE, 	LA 1, STANDARD.DIRECT_IO_TEST_L1.CLR_DIO._FILE_MODE.use__info
USEINFO 1, INDEX, 	LA 1, STANDARD.DIRECT_IO_TEST_L1.CLR_DIO._POSITIVE_COUNT.use__info
USEINFO 1, AT_END_OF_FILE, 	LA 0, STANDARD._BOOLEAN.use__info
virtual at 0
STATOFS ID, 4, 4
STATOFS NAME, 256, 1
STATOFS NAME_LEN, 4, 4
STATOFS IS_OPENED, 1, 1
STATOFS MODE, 1, 1
STATOFS INDEX, 4, 4
STATOFS AT_END_OF_FILE, 1, 1
size = $
end virtual
	LI	 size*8
	SD	1, SIZ__
end namespace

end namespace
