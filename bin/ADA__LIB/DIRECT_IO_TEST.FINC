PRO	DIRECT_IO_TEST_L1
 hexa_show 'DIRECT_IO_TEST_L1 ', $
ELB 1
_COULEUR = '_COULEUR'
namespace _COULEUR
VAR use__info, Q
BEGIN_BLOC_DEF
db 0, 5, "ROUGE"
db 1, 4, "VERT"
db 2, 4, "BLEU"
db 3, 5, "BLANC"
db 4, 4, "NOIR"
END_BLOC_DEF 8, 0, 4

	LCA	SIZ
	SA	1, use__info
end namespace
_POINT = '_POINT'
namespace _POINT
VAR use__info, Q
VAR SIZ__, D
	LVA	1, SIZ__
	SA	1, use__info
USEINFO 1, X, 	LA 0, STANDARD._INTEGER.use__info
USEINFO 1, Y, 	LA 0, STANDARD._INTEGER.use__info
USEINFO 1, Z, 	LA 0, STANDARD._INTEGER.use__info
virtual at 0
STATOFS X, 4, 4
STATOFS Y, 4, 4
STATOFS Z, 4, 4
size = $
end virtual
	LI	 size*8
	SD	1, SIZ__
end namespace
_VECTEUR = '_VECTEUR'
namespace _VECTEUR
VAR use__info, Q
VAR SIZ__, D
	LVA	1, SIZ__
	SA	1, use__info
VAR _COMP_SIZ, D
VAR _FST_1, D
VAR _LST_1, D
	LI	32
	SD	1, _COMP_SIZ
	LD	1, _COMP_SIZ
	LI	1
	SD	1, _FST_1
	LI	4
	SD	1, _LST_1
	LD	1, _LST_1
	LD	1, _FST_1
	SUB
	INC
	CLAMP0
	MUL
	SD	1, SIZ__
  virtual at 4
COMP_SIZ = $
	rd 1 
FST_1 = $
	rd 1 
LST_1 = $
	rd 1 
  end virtual
end namespace
INT_IO = 'INT_IO'
namespace INT_IO
elab_spec:
BRA post_LD_NUM
LD_NUM.elab:
	LD -1, 0
	RTD 0
post_LD_NUM:
BRA post_ST_NUM
ST_NUM.elab:
	SD -1, 0
	RTD 0
post_ST_NUM:
BRA post_INADR_NUM
INADR_NUM.elab:
	RTD 0
post_INADR_NUM:
BRA post_OUTADR_NUM
OUTADR_NUM.elab:
	LA
	RTD 0
post_OUTADR_NUM:
VAR NUM__outadr_ofs, Q
	LCA OUTADR_NUM.elab
	SA	 1, NUM__outadr_ofs
VAR NUM__inadr_ofs, Q
	LCA INADR_NUM.elab
	SA	 1, NUM__inadr_ofs
VAR NUM__st_ofs, Q
	LCA ST_NUM.elab
	SA	 1, NUM__st_ofs
VAR NUM__ld_ofs, Q
	LCA LD_NUM.elab
	SA	 1, NUM__ld_ofs
VAR NUM__u_ofs, Q
	LA	 0, STANDARD._INTEGER.use__info
	SA	 1, NUM__u_ofs
VAR GFP_disp, Q

 hexa_show ' spec ', $
 hexa_show 'var elab DEFAULT_WIDTH ', $
VAR DEFAULT_WIDTH_disp, D
	LI	 11
	DUP
	LD	0, STANDARD.TEXT_IO._FIELD.FST
	CLT
	BT	STANDARD.ce_raise_
	DUP
	LD	0, STANDARD.TEXT_IO._FIELD.LST
	CGT
	BT	STANDARD.ce_raise_
	SD  1,	STANDARD.DIRECT_IO_TEST_L1.INT_IO.DEFAULT_WIDTH_disp

 hexa_show ' disp ', DEFAULT_WIDTH_disp
 hexa_show 'var elab DEFAULT_BASE ', $
VAR DEFAULT_BASE_disp, D
	LI	10
	DUP
	LD	0, STANDARD.TEXT_IO._NUMBER_BASE.FST
	CLT
	BT	STANDARD.ce_raise_
	DUP
	LD	0, STANDARD.TEXT_IO._NUMBER_BASE.LST
	CGT
	BT	STANDARD.ce_raise_
	SD  1,	STANDARD.DIRECT_IO_TEST_L1.INT_IO.DEFAULT_BASE_disp

 hexa_show ' disp ', DEFAULT_BASE_disp

