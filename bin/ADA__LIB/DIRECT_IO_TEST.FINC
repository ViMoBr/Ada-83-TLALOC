include 'DIRECT_IO.FINC'
PRO	DIRECT_IO_TEST_L1			;---------- PRO DIRECT_IO_TEST
ELB 1					;    BODY ELAB
FLT_DIRECT_IO = 'FLT_DIRECT_IO'
namespace FLT_DIRECT_IO			;---------- GENERIC PACKAGE INSTANTIATION
elab_spec:				;    SPEC ELAB

BRA post_LD_FLOAT
LD_FLOAT.elab:
	Lq -1, 0
	RTD 0
post_LD_FLOAT:
BRA post_ST_FLOAT
ST_FLOAT.elab:
	SIq -1, 0
	RTD 0
post_ST_FLOAT:
VAR FLOAT__st_ofs, q
	LCA ST_FLOAT.elab
	Sa	 1, FLOAT__st_ofs
VAR FLOAT__ld_ofs, q
	LCA LD_FLOAT.elab
	Sa	 1, FLOAT__ld_ofs
VAR FLOAT__u_ofs, q
	La	 0, STANDARD.FLOAT.use__info
	Sa	 1, FLOAT__u_ofs
VAR GFP_disp, q				; Lieu du Generic Frame Pointer 
; CODE_TYPE_DECL : skip PRIVATE FILE_TYPE (deferred to full type)
FILE_MODE = 'FILE_MODE'
namespace FILE_MODE				; FILE_MODE ENUMERATION TYPE INFO
BEGIN_BLOC_DEF
db 0, 7, "IN_FILE"
db 1, 10, "INOUT_FILE"
db 2, 8, "OUT_FILE"
END_BLOC_DEF
IMAGES	BYTES_BLOC
CST LST, d, 2
CST FST, d, 0
CST SIZ, d, 8	; SIZ en bits !
postpone
  align_q
end postpone
VAR use__info, q
	LCA	SIZ
	Sa	1, use__info
end namespace

COUNT = 'COUNT'
namespace COUNT				; COUNT TYPE RANGE INFO
VAR use__info, q
VAR SIZ, d
	LVA	1, SIZ
	Sa	1, use__info
VAR FST, d
VAR LST, d
	LI	32
	Sb	1, SIZ
	LI	0
	Sd	1, FST
	LI	2147483647
	Sd	1, LST
end namespace

POSITIVE_COUNT = 'POSITIVE_COUNT'
namespace POSITIVE_COUNT			; POSITIVE_COUNT INTEGER SUBTYPE INFO
VAR use__info, q
VAR SIZ, d
	LVA	 1, SIZ
	Sa	 1, use__info
end namespace

if defined CREATE_L1_
PRO	CREATE_L1				;---------- PRO CREATE
PRMS					;    debut parametrage
	PRM FILE_ofs				; in out
	PRM MODE_ofs				; in
	PRM NAME_ofs				; in
	PRM FORM_ofs				; in
endPRMS					;    fin parametrage
ELB 2
begin:
	LVA	 1, GFP_disp
	La 	 2, -FORM_ofs
	La 	 2, -NAME_ofs
	Lq	 2, -MODE_ofs
	La 	 2, -FILE_ofs
	CALL	STANDARD.DIRECT_IO. ,CREATE_L1
	UNLINK	 2
	RTD	prm_siz
endPRO					;---------- end PRO CREATE
end if
