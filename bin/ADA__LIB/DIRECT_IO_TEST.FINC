LD_LONG_FLOAT.elab:
	Lq -1, 0
	RTD 0
post_LD_LONG_FLOAT:
BRA post_ST_LONG_FLOAT
ST_LONG_FLOAT.elab:
	SIq -1, 0
	RTD 0
post_ST_LONG_FLOAT:
VAR LONG_FLOAT__st_ofs, q
	LCA ST_LONG_FLOAT.elab
	Sa	 1, LONG_FLOAT__st_ofs
