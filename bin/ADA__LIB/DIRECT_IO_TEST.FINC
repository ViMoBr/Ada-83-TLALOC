USEINFO 1, ID, 	La 0, STANDARD._INTEGER.use__info
USEINFO 1, NAME, 	La 1, STANDARD.DIRECT_IO_TEST_L1.POINT_DIO._FILE_NAME_BUFFER.use__info
; STSB
USEINFO 1, NAME_LEN, 	La 0, STANDARD._POSITIVE.use__info
USEINFO 1, IS_OPENED, 	La 0, STANDARD._BOOLEAN.use__info
USEINFO 1, MODE, 	La 1, STANDARD.DIRECT_IO_TEST_L1.POINT_DIO._FILE_MODE.use__info
USEINFO 1, INDEX, 	La 1, STANDARD.DIRECT_IO_TEST_L1.POINT_DIO._POSITIVE_COUNT.use__info
USEINFO 1, AT_END_OF_FILE, 	La 0, STANDARD._BOOLEAN.use__info
virtual at 0				; calcul des offsets statiques
STATOFS ID, 4
; STSB
STATOFS NAME, 256
STATOFS NAME_LEN, 4
STATOFS IS_OPENED, 1
STATOFS MODE, 1
STATOFS INDEX, 4
STATOFS AT_END_OF_FILE, 1
size = $
end virtual
	LI	 size*8
	Sd	1, SIZ
end namespace
