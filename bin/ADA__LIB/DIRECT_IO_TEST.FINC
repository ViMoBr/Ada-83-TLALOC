FILE_NAME_BUFFER = 'FILE_NAME_BUFFER'
namespace FILE_NAME_BUFFER			; FILE_NAME_BUFFER CONSTRAINED ARRAY SUBTYPE INFO
VAR SIZ, d
  namespace info
VAR COMP_SIZ, d
VAR FST_1, d
VAR LST_1, d
	LI	1
	Sd	1, COMP_SIZ
	Ld	1, COMP_SIZ
	LI	1
	Sd	1, FST_1
	LI	256
	Sd	1, LST_1
	Ld	1, LST_1
	INC
	Ld	1, FST_1
	SUB
	MUL
	Sd	1, SIZ
  end namespace
  virtual at 4
COMP_SIZ = $
	rd 1 
FST_1 = $
	rd 1 
LST_1 = $
	rd 1 
  end virtual
end namespace

FILE_TYPE = 'FILE_TYPE'
namespace FILE_TYPE				; FILE_TYPE RECORD TYPE INFO
VAR use__info, q
VAR SIZ, d
	LVA	1, SIZ
	Sa	1, use__info
USEINFO 1, ID, 	LVA	0, STANDARD.INTEGER.SIZ
USEINFO 1, NAME, 	LVA	1, STANDARD.DIRECT_IO_TEST_L1.FLT_DIRECT_IO.FILE_NAME_BUFFER.SIZ
USEINFO 1, NAME_LEN, 	LVA	0, STANDARD.POSITIVE.SIZ
USEINFO 1, IS_OPENED, 	LCA	STANDARD.BOOLEAN.SIZ
USEINFO 1, MODE, 	LCA	STANDARD.DIRECT_IO_TEST_L1.FLT_DIRECT_IO.FILE_MODE.SIZ
USEINFO 1, INDEX, 	LVA	1, STANDARD.DIRECT_IO_TEST_L1.FLT_DIRECT_IO.POSITIVE_COUNT.SIZ
USEINFO 1, AT_END_OF_FILE, 	LCA	STANDARD.BOOLEAN.SIZ
virtual at 0
STATOFS ID, 4
STATOFS NAME, 256
STATOFS NAME_LEN, 4
STATOFS IS_OPENED, 1
STATOFS MODE, 1
STATOFS INDEX, 4
STATOFS AT_END_OF_FILE, 1
size = $
end virtual
end namespace

					;---------- end generic package instantiation FLT_DIRECT_IO
end namespace

VAR F_disp, q				; variable record : pointeur aux data record
VAR F__u, q				; variable record : pointeur aux useinfo
VAR F__dat, STANDARD.DIRECT_IO_TEST_L1.FLT_DIRECT_IO.FILE_TYPE.size
	LVA	1, F__dat
	Sa	1, F_disp				; record fin
	LVA	1, STANDARD.DIRECT_IO_TEST_L1.FLT_DIRECT_IO.FILE_TYPE.SIZ
	Sa	1, F__u
	LIVa 1, F_disp, STANDARD.DIRECT_IO_TEST_L1.FLT_DIRECT_IO.FILE_TYPE.ID
	LI	1
	NEG
	Sd
	LIVa 1, F_disp, STANDARD.DIRECT_IO_TEST_L1.FLT_DIRECT_IO.FILE_TYPE.IS_OPENED
	LI	0
	Sb
	LIVa 1, F_disp, STANDARD.DIRECT_IO_TEST_L1.FLT_DIRECT_IO.FILE_TYPE.AT_END_OF_FILE
	LI	0
	Sb

VAR R_disp, q				; variable flottante
	LIF	3.5
	Sq  1,	R_disp

					;    end elab
begin:					;---------- BDY INSTRUCTIONS
STR STR_L20, ''				; constante string=''
	LCA	STR_L20.data_ptr
STR STR_L21, 'flt_direct.dat'			; constante string='flt_direct.dat'
	LCA	STR_L21.data_ptr
	LI  2
	LVA  1,	F_disp
	CALL	STANDARD.DIRECT_IO_TEST_L1.FLT_DIRECT_IO. ,CREATE_L1
	Lq 1,	R_disp
	LVa 1,	F_disp
	CALL	STANDARD.DIRECT_IO_TEST_L1.FLT_DIRECT_IO. ,WRITE_L14
	LVA  1,	F_disp
	CALL	STANDARD.DIRECT_IO_TEST_L1.FLT_DIRECT_IO. ,CLOSE_L3
ret_lbl:
	UNLINK 1
	RTD
excep:
endPRO					;---------- end PRO DIRECT_IO_TEST
