	Lq	 3, -ITEM_ofs
	La 	 3, -TO_ofs
	CALL	STANDARD.TEXT_IO.INTEGER_IO. ,PUT_L66
	UNLINK	 3
	RTD	prm_siz
endPRO					;---------- end PRO PUT
end if
