VAR P_disp, q				; variable fixed
	LIF	15.5
; CODE_NUMERIC_LITERAL NUM_LIT_TYPE.TY DN_FIXED
	LI	 16
	CVTIF
	FMUL
	CVTFI
	Sq  1,	P_disp

VAR ENT_P_disp, d				; variable entiere

					;    end elab
begin:					;---------- BDY INSTRUCTIONS
	Lq 1,	P_disp
	LI	 8
	ADD
	LI	 4
	SAR
	Sd  1,	ENT_P_disp
STR STR_L14, "ENT_P = "			; constante string="ENT_P = "
	LCA	STR_L14.data_ptr
	CALL	STANDARD.TEXT_IO. ,PUT_L56
	Ld 1,	STANDARD.TEST_FIXED_L1.INT_IO.DEFAULT_BASE_disp
	Ld 1,	STANDARD.TEST_FIXED_L1.INT_IO.DEFAULT_WIDTH_disp
	Ld 1,	ENT_P_disp
	CALL	STANDARD.TEST_FIXED_L1.INT_IO. ,PUT_L5
	LI	1
	CALL	STANDARD.TEXT_IO. ,NEW_LINE_L26
STR STR_L15, "P = "				; constante string="P = "
	LCA	STR_L15.data_ptr
	CALL	STANDARD.TEXT_IO. ,PUT_L56
	Ld 1,	STANDARD.TEST_FIXED_L1.POWER_IO.DEFAULT_EXP_disp
	Ld 1,	STANDARD.TEST_FIXED_L1.POWER_IO.DEFAULT_AFT_disp
	Ld 1,	STANDARD.TEST_FIXED_L1.POWER_IO.DEFAULT_FORE_disp
	Lq 1,	P_disp
	CALL	STANDARD.TEST_FIXED_L1.POWER_IO. ,PUT_L11
	LI	1
	CALL	STANDARD.TEXT_IO. ,NEW_LINE_L26
ret_lbl:
	UNLINK 1
	RTD
excep:
endPRO					;---------- end PRO TEST_FIXED
