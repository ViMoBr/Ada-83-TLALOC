PRMS					;    debut parametrage
	PRM FROM_ofs				; in
	PRM ITEM_ofs				; out
	PRM LAST_ofs				; out
endPRMS					;    fin parametrage
ELB 3
begin:
	LVA	 2, GFP_disp
	La 	 3, -LAST_ofs
	La 	 3, -ITEM_ofs
	La 	 3, -FROM_ofs
	CALL	STANDARD.TEXT_IO.INTEGER_IO. ,GET_L65
	UNLINK	 3
	RTD	prm_siz
endPRO					;---------- end PRO GET
end if
if defined PUT_L16_
PRO	PUT_L16				;---------- PRO PUT
PRMS					;    debut parametrage
	PRM TO_ofs				; out
	PRM ITEM_ofs				; in
