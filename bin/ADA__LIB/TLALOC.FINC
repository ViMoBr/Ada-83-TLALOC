ELB 1
_STOP_PHASE_KIND = '_STOP_PHASE_KIND'
namespace _STOP_PHASE_KIND
VAR use__info, Q
BEGIN_BLOC_DEF
db 0, 6, "SYNTAX"
db 1, 3, "LIB"
db 2, 9, "SEMANTICS"
db 3, 6, "EXPAND"
db 4, 8, "WRITELIB"
END_BLOC_DEF 8, 0, 4

	LCA	SIZ
	SA	1, use__info
end namespace
 hexa_show 'var elab CMD ', $
_CMD__type = '_CMD__type'
namespace _CMD__type
VAR use__info, Q
VAR SIZ__, D
	LVA	1, SIZ__
	SA	1, use__info
VAR _COMP_SIZ, D
VAR _FST_1, D
VAR _LST_1, D
	LI	8
	SD	1, _COMP_SIZ
	LD	1, _COMP_SIZ
	LI	1
	SD	1, _FST_1
	LI	512
	SD	1, _LST_1
	LD	1, _LST_1
	LD	1, _FST_1
	SUB
	INC
	CLAMP0
	MUL
	SD	1, SIZ__
  virtual at 4
COMP_SIZ = $
	rd 1 
FST_1 = $
	rd 1 
LST_1 = $
	rd 1 
  end virtual
end namespace
VAR CMD_disp, Q
VAR CMD__u, Q
	LA 1, _CMD__type.use__info
	SA	1, CMD__u
	LD	1, _CMD__type.SIZ__
	LI	8
	DIV
	CO_VAR
	SA	1, CMD_disp

 hexa_show ' disp ', CMD_disp
 hexa_show 'var elab CMD_LENGTH ', $
VAR CMD_LENGTH_disp, D

 hexa_show ' disp ', CMD_LENGTH_disp

