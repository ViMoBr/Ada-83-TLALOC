end namespace
	Ld 0,	STANDARD.IDL.LIB_PATH_LENGTH_disp
	INC
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	1
	SUB
	LI	1
	MUL
	Sa  2, ANON_42_23_slice_len
	Sa  2, ANON_42_23_slice_data
