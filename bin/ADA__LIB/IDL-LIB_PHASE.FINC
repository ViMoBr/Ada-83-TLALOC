if defined READ_LIB_CTL_FILE_L1_
PRO	READ_LIB_CTL_FILE_L1			;---------- PRO READ_LIB_CTL_FILE
ELB 2					;    BODY ELAB
VAR FCTL_disp, q				; variable record : pointeur aux data record
VAR FCTL__u, q				; variable record : pointeur aux useinfo
VAR FCTL__dat, STANDARD.TEXT_IO.FILE_TYPE.size
	LVA	2, FCTL__dat
	Sa	2, FCTL_disp				; record fin
	LVA	2, STANDARD.TEXT_IO.FILE_TYPE.SIZ
	Sa	2, FCTL__u
; CODE_VC_NAME DN_VARIABLE_ID
