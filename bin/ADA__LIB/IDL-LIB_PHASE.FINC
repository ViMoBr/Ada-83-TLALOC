PRO	LIB_PHASE_L10				;---------- PRO LIB_PHASE
ELB 1					;    BODY ELAB
VAR INITIAL_TIMESTAMP_disp, d			; variable entiere

VAR CUR_TIMESTAMP_disp, d			; variable entiere

VAR LIB_INFO_SEQ_disp, q			; variable record : pointeur aux data record
