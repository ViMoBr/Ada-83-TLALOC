	La  2, ANON_42_23_len
	La  2, ANON_42_23_data
	BLKMOV
	La  2, ANON_42_23_disp
	La  2, ANON_42_23_len
	ADD
	La  2, ANON_42_60_len
	La  2, ANON_42_60_data
	BLKMOV
	LVA 2, ANON_42_23_disp
	CALL	STANDARD.IDL. ,OPEN_IDL_TREE_FILE_L6
					; debut if
	LI	0					; lieu resultat sur pile
	LI  3
	CALL	STANDARD.IDL. ,DI_L21
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	0
	CEQ
	BF	L9
