_CHTABLE__type = '_CHTABLE__type'
namespace _CHTABLE__type			; array var constrained array type info
VAR use__info, q
VAR SIZ, d
	LVA	1, SIZ
	Sa	1, use__info
VAR _COMP_SIZ, d
VAR _FST_1, d
VAR _LST_1, d
	LI	8
	Sd	1, _COMP_SIZ
	Ld	1, _COMP_SIZ
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	1
	Sd	1, _FST_1
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	32
	Sd	1, _LST_1
	Ld	1, _LST_1
	Ld	1, _FST_1
	SUB
	INC
	CLAMP0
	MUL
	Sd	1, SIZ
  virtual at 4
COMP_SIZ = $
	rd 1 
FST_1 = $
	rd 1 
LST_1 = $
	rd 1 
  end virtual
end namespace
VAR CHTABLE_disp, q				; variable array : pointeur aux data
VAR CHTABLE__u, q				; variable array : useinfo pointeur au rec info
	La 1, _CHTABLE__type.use__info
	Sa	1, CHTABLE__u				; array info ptr at __u
STR CHTABLE, "0123456789ABCDEFGHJKLMNPRSTVWXYZ"	; constante string="0123456789ABCDEFGHJKLMNPRSTVWXYZ"
	LCA	CHTABLE.data_ptr
	La
	Sa	1, CHTABLE_disp				; array data ptr at _disp
	LCA	CHTABLE.info_ptr
	La
	Sa	1, CHTABLE__u				; array info ptr at __u

VAR DEBUG_LIB_disp, d			; variable bool char enum
