; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	1
	NEG
	Sd
	LIVa 2, FCTL_disp, STANDARD.TEXT_IO.FILE_TYPE.IS_OPENED
	LI	0
	Sb
	LIVa 2, FCTL_disp, STANDARD.TEXT_IO.FILE_TYPE.PAGE_LENGTH
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	72
	Sd
	LIVa 2, FCTL_disp, STANDARD.TEXT_IO.FILE_TYPE.LINE_LENGTH
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	256
	Sd
	LIVa 2, FCTL_disp, STANDARD.TEXT_IO.FILE_TYPE.PAGE
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	1
	Sd
	LIVa 2, FCTL_disp, STANDARD.TEXT_IO.FILE_TYPE.LINE
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	1
	Sd
	LIVa 2, FCTL_disp, STANDARD.TEXT_IO.FILE_TYPE.COL
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	1
	Sd
	LIVa 2, FCTL_disp, STANDARD.TEXT_IO.FILE_TYPE.IS_DEFAULT_IO
	LI	0
	Sb
	LIVa 2, FCTL_disp, STANDARD.TEXT_IO.FILE_TYPE.LOOK_AHEAD
	LI	 0
	Sb
	LIVa 2, FCTL_disp, STANDARD.TEXT_IO.FILE_TYPE.HAS_LOOK_AHEAD
	LI	0
	Sb
	LIVa 2, FCTL_disp, STANDARD.TEXT_IO.FILE_TYPE.AT_END_OF_FILE
	LI	0
	Sb

