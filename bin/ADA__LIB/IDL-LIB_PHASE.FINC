if defined READ_LIB_CTL_FILE_L1_
PRO	READ_LIB_CTL_FILE_L1			;---------- PRO READ_LIB_CTL_FILE
ELB 2					;    BODY ELAB
VAR FCTL_disp, q				; variable record : pointeur aux data record
VAR FCTL__u, q				; variable record : pointeur aux useinfo
VAR FCTL__dat, STANDARD.TEXT_IO._FILE_TYPE.size
	LVA	2, FCTL__dat
	Sa	2, FCTL_disp				; record fin
	LVA	2, STANDARD.TEXT_IO._FILE_TYPE.SIZ
	Sa	2, FCTL__u
; CODE_VC_NAME DN_VARIABLE_ID
	LIVa 2, FCTL_disp, STANDARD.TEXT_IO._FILE_TYPE.ID
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	1
	NEG
	Sd
	LIVa 2, FCTL_disp, STANDARD.TEXT_IO._FILE_TYPE.IS_OPENED
	LI	0
	Sb
	LIVa 2, FCTL_disp, STANDARD.TEXT_IO._FILE_TYPE.PAGE_LENGTH
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	72
	Sd
	LIVa 2, FCTL_disp, STANDARD.TEXT_IO._FILE_TYPE.LINE_LENGTH
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	256
	Sd
	LIVa 2, FCTL_disp, STANDARD.TEXT_IO._FILE_TYPE.PAGE
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	1
	Sd
	LIVa 2, FCTL_disp, STANDARD.TEXT_IO._FILE_TYPE.LINE
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	1
	Sd
	LIVa 2, FCTL_disp, STANDARD.TEXT_IO._FILE_TYPE.COL
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	1
	Sd
	LIVa 2, FCTL_disp, STANDARD.TEXT_IO._FILE_TYPE.IS_DEFAULT_IO
	LI	0
	Sb
