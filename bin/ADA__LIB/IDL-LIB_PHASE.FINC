	Sa	1, LIB_INFO_SEQ_disp			; record fin
	LVA	1, STANDARD.IDL.SEQ_TYPE.SIZ
	Sa	1, LIB_INFO_SEQ__u
; CODE_VC_NAME DN_VARIABLE_ID
	La 1, LIB_INFO_SEQ_disp
					; Assign_record_aggregate type DN_RECORD
	DUP
	LVA	, STANDARD.IDL.SEQ_TYPE.FIRST
	LI	STANDARD.IDL.TREE.size
	LVA 0,	STANDARD.IDL.TREE_NIL_disp
	La  ,  0
	BLKMOV
	DUP
	LVA	, STANDARD.IDL.SEQ_TYPE.NEXT
	LI	STANDARD.IDL.TREE.size
	LVA 0,	STANDARD.IDL.TREE_NIL_disp
	La  ,  0
	BLKMOV
	DROP

