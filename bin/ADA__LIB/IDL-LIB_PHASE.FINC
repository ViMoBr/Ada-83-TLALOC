	Sd  2, ANON_42_23_info._FST_1
	La  2, ANON_42_23_slice_len
	Sd  2, ANON_42_23_info._LST_1
	LI	8
	Sd  2, ANON_42_23_info._COMP_SIZ
	La  2, ANON_42_23_slice_len
	LI	8
	MUL
	Sd  2, ANON_42_23_info.SIZ
	LVA 2, ANON_42_23_disp
	DUP
	La  ,  0
	Sa  2, ANON_42_23_data
	La  ,  8
	Sa  2, ANON_42_23_info
	LId 2, ANON_42_23_info, STRING.LST_1
	LId 2, ANON_42_23_info, STRING.FST_1
	SUB
	INC
	Sa  2, ANON_42_23_len
STR ANON_42_60, "$$$.TMP"			; constante string="$$$.TMP"
	LCA	ANON_42_60.data_ptr
	DUP
	La  ,  0
	Sa  2, ANON_42_60_data
	La  ,  8
	Sa  2, ANON_42_60_info
	LId 2, ANON_42_60_info, STRING.LST_1
	LId 2, ANON_42_60_info, STRING.FST_1
	SUB
	INC
	Sa  2, ANON_42_60_len
	La  2, ANON_42_23_len
	La  2, ANON_42_60_len
	ADD
	CO_VAR
	Sa  2, ANON_42_23_disp
	LI	1
	Sd  2, ANON_42_23_info._FST_1
	La  2, ANON_42_23_len
	La  2, ANON_42_60_len
	ADD
	Sd  2, ANON_42_23_info._LST_1
	LI	8
	Sd  2, ANON_42_23_info._COMP_SIZ
	La  2, ANON_42_23_len
	La  2, ANON_42_60_len
