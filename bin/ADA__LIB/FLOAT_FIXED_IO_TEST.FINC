VAR F_disp, q				; variable record : pointeur aux data record
VAR F__u, q				; variable record : pointeur aux useinfo
VAR F__dat, STANDARD.TEXT_IO.FILE_TYPE.size
	LVA	1, F__dat
	Sa	1, F_disp				; record fin
	LVA	1, STANDARD.TEXT_IO.FILE_TYPE.SIZ
	Sa	1, F__u
	LIVa 1, F_disp, STANDARD.TEXT_IO.FILE_TYPE.ID
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	1
	NEG
	Sd
	LIVa 1, F_disp, STANDARD.TEXT_IO.FILE_TYPE.IS_OPENED
	LI	0
	Sb
	LIVa 1, F_disp, STANDARD.TEXT_IO.FILE_TYPE.PAGE_LENGTH
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	72
	Sd
	LIVa 1, F_disp, STANDARD.TEXT_IO.FILE_TYPE.LINE_LENGTH
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	256
	Sd
	LIVa 1, F_disp, STANDARD.TEXT_IO.FILE_TYPE.PAGE
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	1
	Sd
	LIVa 1, F_disp, STANDARD.TEXT_IO.FILE_TYPE.LINE
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	1
	Sd
	LIVa 1, F_disp, STANDARD.TEXT_IO.FILE_TYPE.COL
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	1
	Sd
	LIVa 1, F_disp, STANDARD.TEXT_IO.FILE_TYPE.IS_DEFAULT_IO
	LI	0
	Sb
	LIVa 1, F_disp, STANDARD.TEXT_IO.FILE_TYPE.LOOK_AHEAD
	LI	 0
	Sb
	LIVa 1, F_disp, STANDARD.TEXT_IO.FILE_TYPE.HAS_LOOK_AHEAD
	LI	0
	Sb
	LIVa 1, F_disp, STANDARD.TEXT_IO.FILE_TYPE.AT_END_OF_FILE
	LI	0
	Sb

VAR LF_VAL_disp, q				; variable flottante

VAR F_VAL_disp, q				; variable flottante

VAR D_VAL_disp, q				; variable fixed

					;    end elab
begin:					;---------- BDY INSTRUCTIONS
STR STR_L20, "=== 1. FLOAT_IO PUT LONG_FLOAT — formats ==="	; constante string="=== 1. FLOAT_IO PUT LONG_FLOAT — formats ==="
	LCA	STR_L20.data_ptr
	CALL	STANDARD.TEXT_IO. ,PUT_LINE_L60
STR STR_L21, "  pi        : "			; constante string="  pi        : "
	LCA	STR_L21.data_ptr
	CALL	STANDARD.TEXT_IO. ,PUT_L56
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	2
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	6
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	1
; CODE_NUMERIC_LITERAL DN_FLOAT
	LIF	3.14159265358979
	CALL	STANDARD.FLOAT_FIXED_IO_TEST_L1.LF_IO. ,PUT_L5
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	1
	CALL	STANDARD.TEXT_IO. ,NEW_LINE_L26
STR STR_L22, "  grand     : "			; constante string="  grand     : "
	LCA	STR_L22.data_ptr
	CALL	STANDARD.TEXT_IO. ,PUT_L56
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	2
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	4
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	1
; CODE_NUMERIC_LITERAL DN_FLOAT
	LIF	1.23456789E+15
	CALL	STANDARD.FLOAT_FIXED_IO_TEST_L1.LF_IO. ,PUT_L5
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	1
	CALL	STANDARD.TEXT_IO. ,NEW_LINE_L26
STR STR_L23, "  petit     : "			; constante string="  petit     : "
	LCA	STR_L23.data_ptr
	CALL	STANDARD.TEXT_IO. ,PUT_L56
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	2
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	4
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	1
; CODE_NUMERIC_LITERAL DN_FLOAT
	LIF	4.56789E-08
	FNEG
	CALL	STANDARD.FLOAT_FIXED_IO_TEST_L1.LF_IO. ,PUT_L5
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	1
	CALL	STANDARD.TEXT_IO. ,NEW_LINE_L26
STR STR_L24, "  zero      : "			; constante string="  zero      : "
	LCA	STR_L24.data_ptr
	CALL	STANDARD.TEXT_IO. ,PUT_L56
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	2
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	3
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	1
; CODE_NUMERIC_LITERAL DN_FLOAT
	LIF	0.0
	CALL	STANDARD.FLOAT_FIXED_IO_TEST_L1.LF_IO. ,PUT_L5
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	1
	CALL	STANDARD.TEXT_IO. ,NEW_LINE_L26
STR STR_L25, "  un        : "			; constante string="  un        : "
	LCA	STR_L25.data_ptr
	CALL	STANDARD.TEXT_IO. ,PUT_L56
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	2
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	2
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	1
; CODE_NUMERIC_LITERAL DN_FLOAT
	LIF	1.0
	CALL	STANDARD.FLOAT_FIXED_IO_TEST_L1.LF_IO. ,PUT_L5
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	1
	CALL	STANDARD.TEXT_IO. ,NEW_LINE_L26
STR STR_L26, "  negatif   : "			; constante string="  negatif   : "
	LCA	STR_L26.data_ptr
	CALL	STANDARD.TEXT_IO. ,PUT_L56
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	2
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	2
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	1
; CODE_NUMERIC_LITERAL DN_FLOAT
	LIF	1.0
	FNEG
	CALL	STANDARD.FLOAT_FIXED_IO_TEST_L1.LF_IO. ,PUT_L5
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	1
	CALL	STANDARD.TEXT_IO. ,NEW_LINE_L26
STR STR_L27, "  FORE pad  : "			; constante string="  FORE pad  : "
	LCA	STR_L27.data_ptr
	CALL	STANDARD.TEXT_IO. ,PUT_L56
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	2
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	2
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	4
; CODE_NUMERIC_LITERAL DN_FLOAT
	LIF	2.5
	CALL	STANDARD.FLOAT_FIXED_IO_TEST_L1.LF_IO. ,PUT_L5
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	1
	CALL	STANDARD.TEXT_IO. ,NEW_LINE_L26
STR STR_L28, "=== 2. FLOAT_IO PUT FLOAT ==="	; constante string="=== 2. FLOAT_IO PUT FLOAT ==="
	LCA	STR_L28.data_ptr
	CALL	STANDARD.TEXT_IO. ,PUT_LINE_L60
