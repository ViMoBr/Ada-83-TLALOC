 hexa_show 'var elab F ', $
VAR F_disp, q				; variable record : pointeur aux data record
VAR F__u, q				; variable record : pointeur aux useinfo
VAR F__dat, STANDARD.TEXT_IO._FILE_TYPE.size
	LVA	1, F__dat
	Sa	1, F_disp				; record fin
	LVA	1, STANDARD.TEXT_IO._FILE_TYPE.SIZ
	Sa	1, F__u
	LIVa 1, STANDARD.FLOAT_FIXED_IO_TEST_L1.F_disp, STANDARD.TEXT_IO._FILE_TYPE.ID
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	1
	NEG
	Sd
	LIVa 1, STANDARD.FLOAT_FIXED_IO_TEST_L1.F_disp, STANDARD.TEXT_IO._FILE_TYPE.IS_OPENED
	LI	0
	Sb
	LIVa 1, STANDARD.FLOAT_FIXED_IO_TEST_L1.F_disp, STANDARD.TEXT_IO._FILE_TYPE.PAGE_LENGTH
	ULd 0,	STANDARD.TEXT_IO.UNBOUNDED_disp
	Sd
	LIVa 1, STANDARD.FLOAT_FIXED_IO_TEST_L1.F_disp, STANDARD.TEXT_IO._FILE_TYPE.LINE_LENGTH
	ULd 0,	STANDARD.TEXT_IO.UNBOUNDED_disp
	Sd
	LIVa 1, STANDARD.FLOAT_FIXED_IO_TEST_L1.F_disp, STANDARD.TEXT_IO._FILE_TYPE.PAGE
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	1
	Sd
	LIVa 1, STANDARD.FLOAT_FIXED_IO_TEST_L1.F_disp, STANDARD.TEXT_IO._FILE_TYPE.LINE
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	1
	Sd
	LIVa 1, STANDARD.FLOAT_FIXED_IO_TEST_L1.F_disp, STANDARD.TEXT_IO._FILE_TYPE.COL
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	1
	Sd
