	LVA	 1, GFP_disp
	Ld	 2, -EXP_ofs
	Ld	 2, -AFT_ofs
	Ld	 2, -FORE_ofs
	Lq	 2, -ITEM_ofs
	La 	 2, -FILE_ofs
	CALL	STANDARD.TEXT_IO.FLOAT_IO. ,PUT_L69
	UNLINK	 2
	RTD	prm_siz
endPRO					;---------- end PRO PUT
end if
