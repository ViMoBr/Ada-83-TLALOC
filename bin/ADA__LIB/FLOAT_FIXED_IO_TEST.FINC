FLOAT_FIXED_IO_TEST = 'FLOAT_FIXED_IO_TEST'
PRO	FLOAT_FIXED_IO_TEST_L1			;---------- PRO FLOAT_FIXED_IO_TEST
 hexa_show 'FLOAT_FIXED_IO_TEST_L1 ', $
ELB 1					;    BODY ELAB
LF_IO = 'LF_IO'
namespace LF_IO				;---------- GENERIC PACKAGE INSTANTIATION
elab_spec:				;    SPEC ELAB

; F4A SET  cle=NUM  actuel=DN_FLOAT
BRA post_LD_NUM
LD_NUM.elab:
	Lq -1, 0
	RTD 0
post_LD_NUM:
BRA post_ST_NUM
ST_NUM.elab:
	Sq -1, 0
	RTD 0
post_ST_NUM:
BRA post_INADR_NUM
INADR_NUM.elab:
	RTD 0
post_INADR_NUM:
BRA post_OUTADR_NUM
OUTADR_NUM.elab:
	La
	RTD 0
post_OUTADR_NUM:
VAR NUM__outadr_ofs, q
	LCA OUTADR_NUM.elab
	Sa	 1, NUM__outadr_ofs
VAR NUM__inadr_ofs, q
	LCA INADR_NUM.elab
	Sa	 1, NUM__inadr_ofs
VAR NUM__st_ofs, q
	LCA ST_NUM.elab
	Sa	 1, NUM__st_ofs
VAR NUM__ld_ofs, q
	LCA LD_NUM.elab
	Sa	 1, NUM__ld_ofs
VAR NUM__u_ofs, q
	La	 0, STANDARD._LONG_FLOAT.use__info
	Sa	 1, NUM__u_ofs
VAR GFP_disp, q				; Lieu du Generic Frame Pointer 
					; CODE_PACKAGE_SPEC
 hexa_show ' spec ', $
 hexa_show 'var elab DEFAULT_FORE ', $
VAR DEFAULT_FORE_disp, d			; variable entiere
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	2
	DUP
	Ld	0, STANDARD.TEXT_IO._FIELD.FST
	CLT
	BT	STANDARD.ce_raise_
	DUP
	Ld	0, STANDARD.TEXT_IO._FIELD.LST
	CGT
	BT	STANDARD.ce_raise_
	Sd  1,	STANDARD.FLOAT_FIXED_IO_TEST_L1.LF_IO.DEFAULT_FORE_disp

 hexa_show ' disp ', DEFAULT_FORE_disp
 hexa_show 'var elab DEFAULT_AFT ', $
VAR DEFAULT_AFT_disp, d			; variable entiere
	LI	15
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	1
	SUB
	DUP
	Ld	0, STANDARD.TEXT_IO._FIELD.FST
	CLT
	BT	STANDARD.ce_raise_
	DUP
	Ld	0, STANDARD.TEXT_IO._FIELD.LST
	CGT
	BT	STANDARD.ce_raise_
	Sd  1,	STANDARD.FLOAT_FIXED_IO_TEST_L1.LF_IO.DEFAULT_AFT_disp

 hexa_show ' disp ', DEFAULT_AFT_disp
 hexa_show 'var elab DEFAULT_EXP ', $
VAR DEFAULT_EXP_disp, d			; variable entiere
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	3
	DUP
	Ld	0, STANDARD.TEXT_IO._FIELD.FST
	CLT
	BT	STANDARD.ce_raise_
	DUP
	Ld	0, STANDARD.TEXT_IO._FIELD.LST
	CGT
	BT	STANDARD.ce_raise_
	Sd  1,	STANDARD.FLOAT_FIXED_IO_TEST_L1.LF_IO.DEFAULT_EXP_disp

 hexa_show ' disp ', DEFAULT_EXP_disp
					; sub program entry decl (in instantiation TRUE )
if defined GET_L2_
PRO	GET_L2				;---------- PRO GET
 hexa_show 'GET_L2 ', $
PRMS					;    debut parametrage
	PRM FILE_ofs				; in
	PRM ITEM_ofs				; out
	PRM WIDTH_ofs				; in
endPRMS					;    fin parametrage
ELB 2
begin:
	LVA	 1, GFP_disp
	Ld	 2, -WIDTH_ofs
	La 	 2, -ITEM_ofs
	La 	 2, -FILE_ofs
	CALL	STANDARD.TEXT_IO.FLOAT_IO. ,GET_L67
	UNLINK	 2
	RTD	prm_siz
endPRO					;---------- end PRO GET
end if
					; sub program entry decl (in instantiation TRUE )
if defined GET_L3_
PRO	GET_L3				;---------- PRO GET
 hexa_show 'GET_L3 ', $
PRMS					;    debut parametrage
	PRM ITEM_ofs				; out
	PRM WIDTH_ofs				; in
endPRMS					;    fin parametrage
ELB 2
begin:
