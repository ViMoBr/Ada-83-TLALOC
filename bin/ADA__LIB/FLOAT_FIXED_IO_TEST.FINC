	Ld	 2, -WIDTH_ofs
	La 	 2, -ITEM_ofs
	CALL	STANDARD.TEXT_IO.FLOAT_IO. ,GET_L68
	UNLINK	 2
	RTD	prm_siz
endPRO					;---------- end PRO GET
end if
					; sub program entry decl (in instantiation TRUE )
if defined PUT_L4_
PRO	PUT_L4				;---------- PRO PUT
 hexa_show 'PUT_L4 ', $
