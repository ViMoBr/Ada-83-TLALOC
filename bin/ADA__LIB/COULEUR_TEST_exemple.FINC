include 'TEXT_IO.FINC'
PRO	COULEUR_TEST_L1				;---------- PRO COULEUR_TEST
ELB 1					;    BODY ELAB


COULEUR = 'COULEUR'
namespace COULEUR				; COULEUR ENUMERATION TYPE INFO
BEGIN_BLOC_DEF						; pour une constante les caracteres suivent (pour une chaine variable ce n'est pas le cas, les octets sont dans la co-pile)
db 0, 4, 'BLEU'
db 1, 5, 'BLANC'
db 2, 5, 'ROUGE'
END_BLOC_DEF
IMAGES	BYTES_BLOC
CST LST, d, 2
CST FST, d, 0
CST SIZ, d, 1
end namespace


VAR COUL_disp, b				; variable entiere
	LI	1
	Sb  1,	COUL_disp
VAR COUL__u, q				; enumeration useinfo
	LVA	1, STANDARD.COULEUR_TEST_L1.COULEUR.IMAGES.data_ptr
	Sa	1, COUL__u

IO_COULEUR = 'IO_COULEUR'
namespace IO_COULEUR			;---------- GENERIC PACKAGE INSTANTIATION
elab_spec:				;    SPEC ELAB

VAR GFP_disp, q
VAR DEFAULT_WIDTH_disp, d			; variable entiere
	LI	0
	Sd  1,	DEFAULT_WIDTH_disp

VAR DEFAULT_SETTING_disp, b			; variable entiere
	LI	1
	Sb  1,	DEFAULT_SETTING_disp
VAR DEFAULT_SETTING__u, q			; enumeration useinfo
	LVA	0, STANDARD.TEXT_IO.TYPE_SET.SIZ
	Sa	1, DEFAULT_SETTING__u

if defined GET_L79_
PRO	GET_L79				;---------- PRO GET
PRMS					;    debut parametrage
	PRM FILE_ofs				; in
	PRM ITEM_ofs				; out
endPRMS					;    fin parametrage
ELB 2
begin:
	LVA	 2, GFP_disp
	La 	 2, -ITEM_ofs
	La 	 2, -FILE_ofs
	CALL	STANDARD.TEXT_IO.ENUMERATION_IO. ,GET_L79
	UNLINK	 2
	RTD	prm_siz
endPRO					;---------- end PRO GET
end if
if defined GET_L80_
PRO	GET_L80				;---------- PRO GET
PRMS					;    debut parametrage
	PRM ITEM_ofs				; out
endPRMS					;    fin parametrage
ELB 2
begin:
	LVA	 2, GFP_disp
	La 	 2, -ITEM_ofs
	CALL	STANDARD.TEXT_IO.ENUMERATION_IO. ,GET_L80
	UNLINK	 2
	RTD	prm_siz
endPRO					;---------- end PRO GET
end if
if defined PUT_L81_
PRO	PUT_L81				;---------- PRO PUT
PRMS					;    debut parametrage
	PRM FILE_ofs				; in
	PRM ITEM_ofs				; in
	PRM WIDTH_ofs				; in
	PRM SET_ofs				; in
endPRMS					;    fin parametrage
ELB 2
begin:
	LVA	 2, GFP_disp
	Lq	 2, -SET_ofs
	Lq	 2, -WIDTH_ofs
	Lq	 2, -ITEM_ofs
	La 	 2, -FILE_ofs
	CALL	STANDARD.TEXT_IO.ENUMERATION_IO. ,PUT_L81
	UNLINK	 2
	RTD	prm_siz
endPRO					;---------- end PRO PUT
end if
if defined PUT_L82_
PRO	PUT_L82				;---------- PRO PUT
PRMS					;    debut parametrage
	PRM ITEM_ofs				; in
	PRM WIDTH_ofs				; in
	PRM SET_ofs				; in
endPRMS					;    fin parametrage
ELB 2
begin:
	LVA	 2, GFP_disp
	Lq	 2, -SET_ofs
	Lq	 2, -WIDTH_ofs
	Lq	 2, -ITEM_ofs
	CALL	STANDARD.TEXT_IO.ENUMERATION_IO. ,PUT_L82
	UNLINK	 2
	RTD	prm_siz
endPRO					;---------- end PRO PUT
end if
if defined GET_L83_
PRO	GET_L83				;---------- PRO GET
PRMS					;    debut parametrage
	PRM FROM_ofs				; in
	PRM ITEM_ofs				; out
	PRM LAST_ofs				; out
endPRMS					;    fin parametrage
ELB 2
begin:
	LVA	 2, GFP_disp
	La 	 2, -LAST_ofs
	La 	 2, -ITEM_ofs
	La 	 2, -FROM_ofs
	CALL	STANDARD.TEXT_IO.ENUMERATION_IO. ,GET_L83
	UNLINK	 2
	RTD	prm_siz
endPRO					;---------- end PRO GET
end if
if defined PUT_L84_
PRO	PUT_L84				;---------- PRO PUT
PRMS					;    debut parametrage
	PRM TO_ofs				; out
	PRM ITEM_ofs				; in
	PRM SET_ofs				; in
endPRMS					;    fin parametrage
ELB 2
begin:
	LVA	 2, GFP_disp
	Lq	 2, -SET_ofs
	Lq	 2, -ITEM_ofs
	La 	 2, -TO_ofs
	CALL	STANDARD.TEXT_IO.ENUMERATION_IO. ,PUT_L84
	UNLINK	 2
	RTD	prm_siz
endPRO					;---------- end PRO PUT
end if
					;---------- end generic package instantiation IO_COULEUR
end namespace

					;    end elab
begin:					;---------- BDY INSTRUCTIONS
	Lb 1,	STANDARD.COULEUR_TEST_L1.IO_COULEUR.DEFAULT_SETTING_disp
	Ld 1,	STANDARD.COULEUR_TEST_L1.IO_COULEUR.DEFAULT_WIDTH_disp
	Lb 1,	COUL_disp
	CALL	STANDARD.COULEUR_TEST_L1.IO_COULEUR. ,PUT_L82
ret_lbl:
	UNLINK 1
	RTD
excep:
endPRO					;---------- end PRO COULEUR_TEST
