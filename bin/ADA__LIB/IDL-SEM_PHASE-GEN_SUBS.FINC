	Sa	1, OLD_ATTRIBUTE_disp			; record fin
	LVA	1, STANDARD.IDL._TREE.SIZ
	Sa	1, OLD_ATTRIBUTE__u
; CODE_VC_NAME DN_VARIABLE_ID
	LIVA 1, OLD_ATTRIBUTE_disp, STANDARD.IDL._TREE.PT
	LI	0
	Sb

VAR ATTRIBUTE_disp, q			; variable record : pointeur aux data record
VAR ATTRIBUTE__u, q				; variable record : pointeur aux useinfo
VAR ATTRIBUTE__dat, STANDARD.IDL._TREE.size
	LVA	1, ATTRIBUTE__dat
	Sa	1, ATTRIBUTE_disp			; record fin
	LVA	1, STANDARD.IDL._TREE.SIZ
	Sa	1, ATTRIBUTE__u
; CODE_VC_NAME DN_VARIABLE_ID
	LIVA 1, ATTRIBUTE_disp, STANDARD.IDL._TREE.PT
	LI	0
	Sb

					;    end elab
begin:					;---------- BDY INSTRUCTIONS
VAR	IL28_disp, b				; compteur boucle LOOP__2
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	1
	Sb  1,	IL28_disp
VAR	LMT_IL28_disp, b			; limite boucle LOOP__2
	La	 0, N_SPEC_disp				; array data start address on stack
	La 1, -NODE_ofs
	La	-1, 0
	Ld
	LI	24
	LI	8
	UBFX
	DUP
	LId	0, N_SPEC__u, STANDARD.IDL.IDL_TBL._NODE_SPECIF_TABLE.FST_1
	CLT
	BT	STANDARD.ce_raise_
	DUP
	LId	0, N_SPEC__u, STANDARD.IDL.IDL_TBL._NODE_SPECIF_TABLE.LST_1
	CGT
	BT	STANDARD.ce_raise_
	LId	0, N_SPEC__u, STANDARD.IDL.IDL_TBL._NODE_SPECIF_TABLE.FST_1	; (index - FST_1) * SIZ_1
	SUB
	LId	0, N_SPEC__u, STANDARD.IDL.IDL_TBL._NODE_SPECIF_TABLE.COMP_SIZ
	LI	8
	DIV
	MUL
	ADD					; add offset to start address
	Lw	, STANDARD.IDL.IDL_TBL._NODE_SPECIF.NS_SIZE
	Sb  1,	LMT_IL28_disp
	Lb  1,	IL28_disp				; test null range LOOP__2
	Lb  1,	LMT_IL28_disp
	CGT
	BT	L27
LOOP__2:					; corps boucle LOOP__2
	LVA 1,	ATTRIBUTE_disp
	La
	LI	STANDARD.IDL._TREE.size
VAR	ANON_99_20_disp, q
VAR	ANON_99_20__u,    q
VAR	ANON_99_20__dat, STANDARD.IDL._TREE.size
	LVA 1, ANON_99_20__dat
	Sa  1, ANON_99_20_disp
	La  0, STANDARD.IDL._TREE.use__info
	Sa  1, ANON_99_20__u
	LVA 1, ANON_99_20_disp
					; doublet resultat record anonyme
	La  1,	-NODE_ofs
	Lb  1,	IL28_disp
	CALL	STANDARD.IDL.IDL_MAN. ,DABS_L38
	La
	BLKMOV
	LVA 1,	OLD_ATTRIBUTE_disp
	La
	LI	STANDARD.IDL._TREE.size
	LVA 1,	ATTRIBUTE_disp
	La
	BLKMOV
	LVA	1, H_disp
	La  1,	-NODE_HASH_ofs
	LVA  1,	ATTRIBUTE_disp
	CALL	STANDARD.IDL.SEM_PHASE_L11.GEN_SUBS. ,SUBSTITUTE_L437
					; debut if
; CODE record equality "/=" _TREE
VAR	EQA_L31, q
VAR	EQB_L31, q
	LVA 1,	ATTRIBUTE_disp
	La  ,  0
	Sa  1, EQA_L31
	LVA 1,	OLD_ATTRIBUTE_disp
	La  ,  0
	Sa  1, EQB_L31
	LI	1
	LIb	1, EQA_L31, STANDARD.IDL._TREE.PT
	LIb	1, EQB_L31, STANDARD.IDL._TREE.PT
