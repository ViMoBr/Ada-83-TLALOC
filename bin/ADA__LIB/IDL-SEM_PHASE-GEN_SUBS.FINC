; CODE_VC_NAME DN_VARIABLE_ID

					;    end elab
begin:					;---------- BDY INSTRUCTIONS
VAR	IL13_disp, b				; compteur boucle LOOP__3
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	1
	Sb  1,	IL13_disp
VAR	LMT_IL13_disp, b			; limite boucle LOOP__3
	La	 0, N_SPEC_disp				; array data start address on stack
	La 1, -NODE_ofs
	La	-1, 0
	Ld
	LI	24
	LI	8
	UBFX
	LId	0, N_SPEC__u, STANDARD.IDL.IDL_TBL._NODE_SPECIF_TABLE.FST_1	; (index - FST_1) * SIZ_1
	SUB
	LId	0, N_SPEC__u, STANDARD.IDL.IDL_TBL._NODE_SPECIF_TABLE.COMP_SIZ
	LI	8
	DIV
	MUL
	ADD					; add offset to start address
	Lw	, STANDARD.IDL.IDL_TBL._NODE_SPECIF.NS_SIZE
	Sb  1,	LMT_IL13_disp
	Lb  1,	IL13_disp				; test null range LOOP__3
	Lb  1,	LMT_IL13_disp
	CGT
	BT	L12
LOOP__3:					; corps boucle LOOP__3
	LVA 1,	ATTRIBUTE_disp
	La
	LI	STANDARD.IDL._TREE.size
VAR	ANON_128_20_disp, q
VAR	ANON_128_20__u,    q
VAR	ANON_128_20__dat, STANDARD.IDL._TREE.size
	LVA 1, ANON_128_20__dat
	Sa  1, ANON_128_20_disp
	La  0, STANDARD.IDL._TREE.use__info
