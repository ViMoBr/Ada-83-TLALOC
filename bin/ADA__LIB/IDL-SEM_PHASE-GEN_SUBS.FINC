	LVA 1,	OLD_ATTRIBUTE_disp
	CNE
	BF	L15
					; debut if
	La  1,	-NODE_ofs
	LVA 1,	OLD_NODE_disp
	CEQ
	BF	L17
	La  1,	-NODE_ofs
	La
	LI	STANDARD.IDL._TREE.size
VAR	ANON_135_41_disp, q
VAR	ANON_135_41__u,    q
VAR	ANON_135_41__dat, STANDARD.IDL._TREE.size
	LVA 1, ANON_135_41__dat
	Sa  1, ANON_135_41_disp
