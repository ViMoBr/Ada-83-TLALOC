	LVA	1, HASH_CHAIN__dat
	Sa	1, HASH_CHAIN_disp			; record fin
	LVA	1, STANDARD.IDL._TREE.SIZ
	Sa	1, HASH_CHAIN__u
; CODE_VC_NAME DN_VARIABLE_ID
	La  1, HASH_CHAIN_disp
	LI	STANDARD.IDL._TREE.size
	La 1, -NODE_HASH_ofs
	LIVA 	, 0, STANDARD.IDL.SEM_PHASE_L11.GEN_SUBS._NODE_HASH_TYPE.A
; EXPRESSIONS.CODE_INDEXED adresse component id
	Ld 1,	HASH_INDEX_disp
	DUP
	Ld	 1, STANDARD.IDL.SEM_PHASE_L11.GEN_SUBS._NODE_ARRAY_TYPE._FST_1
	CLT
	BT	STANDARD.ce_raise_
	DUP
	Ld	 1, STANDARD.IDL.SEM_PHASE_L11.GEN_SUBS._NODE_ARRAY_TYPE._LST_1
	CGT
	BT	STANDARD.ce_raise_
	Ld	 1, STANDARD.IDL.SEM_PHASE_L11.GEN_SUBS._NODE_ARRAY_TYPE._FST_1	; (index - FST_1) * SIZ_1
	SUB
	Ld	 1, STANDARD.IDL.SEM_PHASE_L11.GEN_SUBS._NODE_ARRAY_TYPE._COMP_SIZ
	LI	8
	DIV
	MUL
	ADD					; add offset to start address
	La  ,  0
	BLKMOV

					;    end elab
begin:					;---------- BDY INSTRUCTIONS
LOOP__1:
; CODE record equality "/=" _TREE
VAR	EQA_L10, q
VAR	EQB_L10, q
	LVA 1,	HASH_CHAIN_disp
	La  ,  0
	Sa  1, EQA_L10
	LVA 0,	STANDARD.IDL.TREE_VOID_disp
	La  ,  0
	Sa  1, EQB_L10
	LI	1
	LIb	1, EQA_L10, STANDARD.IDL._TREE.PT
	LIb	1, EQB_L10, STANDARD.IDL._TREE.PT
	CEQ
	ET
	LIb	1, EQA_L10, STANDARD.IDL._TREE.PT
	LI	0
	CEQ
	LIb	1, EQA_L10, STANDARD.IDL._TREE.PT
	LI	2
	CEQ
	OU
	BF	L12
	LIb	1, EQA_L10, STANDARD.IDL._TREE.TY
	LIb	1, EQB_L10, STANDARD.IDL._TREE.TY
	CEQ
	ET
	LIw	1, EQA_L10, STANDARD.IDL._TREE.PG
	LIw	1, EQB_L10, STANDARD.IDL._TREE.PG
	CEQ
	ET
	LIw	1, EQA_L10, STANDARD.IDL._TREE.LN
	LIw	1, EQB_L10, STANDARD.IDL._TREE.LN
	CEQ
	ET
	BRA	L11
L12:
	LIb	1, EQA_L10, STANDARD.IDL._TREE.PT
	LI	1
	CEQ
	BF	L13
	LIw	1, EQA_L10, STANDARD.IDL._TREE.COL
	LIw	1, EQB_L10, STANDARD.IDL._TREE.COL
	CEQ
	ET
	LIw	1, EQA_L10, STANDARD.IDL._TREE.SPG
	LIw	1, EQB_L10, STANDARD.IDL._TREE.SPG
	CEQ
	ET
	LIw	1, EQA_L10, STANDARD.IDL._TREE.SLN
	LIw	1, EQB_L10, STANDARD.IDL._TREE.SLN
	CEQ
	ET
	BRA	L11
L13:
	LIb	1, EQA_L10, STANDARD.IDL._TREE.PT
	LI	3
	CEQ
	BF	L14
	LIb	1, EQA_L10, STANDARD.IDL._TREE.NOTY
	LIb	1, EQB_L10, STANDARD.IDL._TREE.NOTY
	CEQ
	ET
	LIw	1, EQA_L10, STANDARD.IDL._TREE.ABSS
	LIw	1, EQB_L10, STANDARD.IDL._TREE.ABSS
	CEQ
	ET
	LIw	1, EQA_L10, STANDARD.IDL._TREE.NSIZ
	LIw	1, EQB_L10, STANDARD.IDL._TREE.NSIZ
	CEQ
	ET
	BRA	L11
L14:
L11:
	LI	1
	OUX
	BF	L9
					; debut if
; CODE record equality "=" _TREE
VAR	EQA_L17, q
VAR	EQB_L17, q
VAR	ANON_60_10_disp, q
VAR	ANON_60_10__u,    q
VAR	ANON_60_10__dat, STANDARD.IDL._TREE.size
	LVA 1, ANON_60_10__dat
	Sa  1, ANON_60_10_disp
	La  0, STANDARD.IDL._TREE.use__info
	Sa  1, ANON_60_10__u
	LVA 1, ANON_60_10_disp
					; doublet resultat record anonyme
	LVA 1,	HASH_CHAIN_disp
	LI  165
	CALL	STANDARD.IDL. ,D_L17
	La  ,  0
	Sa  1, EQA_L17
	La  1,	-NODE_ofs
	La  ,  0
	Sa  1, EQB_L17
	LI	1
	LIb	1, EQA_L17, STANDARD.IDL._TREE.PT
	LIb	1, EQB_L17, STANDARD.IDL._TREE.PT
	CEQ
	ET
	LIb	1, EQA_L17, STANDARD.IDL._TREE.PT
	LI	0
	CEQ
	LIb	1, EQA_L17, STANDARD.IDL._TREE.PT
	LI	2
	CEQ
	OU
	BF	L19
	LIb	1, EQA_L17, STANDARD.IDL._TREE.TY
	LIb	1, EQB_L17, STANDARD.IDL._TREE.TY
	CEQ
	ET
	LIw	1, EQA_L17, STANDARD.IDL._TREE.PG
	LIw	1, EQB_L17, STANDARD.IDL._TREE.PG
	CEQ
	ET
	LIw	1, EQA_L17, STANDARD.IDL._TREE.LN
	LIw	1, EQB_L17, STANDARD.IDL._TREE.LN
	CEQ
	ET
	BRA	L18
L19:
	LIb	1, EQA_L17, STANDARD.IDL._TREE.PT
	LI	1
	CEQ
	BF	L20
	LIw	1, EQA_L17, STANDARD.IDL._TREE.COL
	LIw	1, EQB_L17, STANDARD.IDL._TREE.COL
	CEQ
	ET
	LIw	1, EQA_L17, STANDARD.IDL._TREE.SPG
	LIw	1, EQB_L17, STANDARD.IDL._TREE.SPG
	CEQ
	ET
	LIw	1, EQA_L17, STANDARD.IDL._TREE.SLN
	LIw	1, EQB_L17, STANDARD.IDL._TREE.SLN
	CEQ
	ET
	BRA	L18
L20:
	LIb	1, EQA_L17, STANDARD.IDL._TREE.PT
	LI	3
	CEQ
	BF	L21
	LIb	1, EQA_L17, STANDARD.IDL._TREE.NOTY
	LIb	1, EQB_L17, STANDARD.IDL._TREE.NOTY
	CEQ
	ET
	LIw	1, EQA_L17, STANDARD.IDL._TREE.ABSS
	LIw	1, EQB_L17, STANDARD.IDL._TREE.ABSS
	CEQ
	ET
	LIw	1, EQA_L17, STANDARD.IDL._TREE.NSIZ
	LIw	1, EQB_L17, STANDARD.IDL._TREE.NSIZ
	CEQ
	ET
	BRA	L18
L21:
L18:
	BF	L16
	La  1,	-NODE_ofs
	La
	LI	STANDARD.IDL._TREE.size
VAR	ANON_61_17_disp, q
VAR	ANON_61_17__u,    q
VAR	ANON_61_17__dat, STANDARD.IDL._TREE.size
	LVA 1, ANON_61_17__dat
	Sa  1, ANON_61_17_disp
	La  0, STANDARD.IDL._TREE.use__info
	Sa  1, ANON_61_17__u
	LVA 1, ANON_61_17_disp
					; doublet resultat record anonyme
	LVA 1,	HASH_CHAIN_disp
	LI  166
	CALL	STANDARD.IDL. ,D_L17
	La
	BLKMOV
	BRA	L9
	BRA	L15
L16:
L15:					; post if
	LVA 1,	HASH_CHAIN_disp
	La
	LI	STANDARD.IDL._TREE.size
VAR	ANON_64_21_disp, q
VAR	ANON_64_21__u,    q
VAR	ANON_64_21__dat, STANDARD.IDL._TREE.size
	LVA 1, ANON_64_21__dat
