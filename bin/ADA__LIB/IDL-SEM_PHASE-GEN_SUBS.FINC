GEN_SUBS = 'GEN_SUBS'
namespace GEN_SUBS				;---------- PACKAGE (BDY)
					;    BODY ELAB

if defined HASH_NODE_HASH_L1_
PRO	HASH_NODE_HASH_L1			;---------- PRO HASH_NODE_HASH
PRMS					;    debut parametrage
	PRM NODE_HASH_ofs				; in
	PRM NODE_ofs				; in
	PRM result__ofs				; resultat de fonction
endPRMS					;    fin parametrage
ELB 1					;    BODY ELAB
VAR HASH_CODE_disp, d			; variable entiere
	La 1, -NODE_ofs
	La	-1, 0
	Ld
	LI	9
	LI	15
	UBFX
; CODE CONVERSION SOURCE DN_INTEGER TARGET DN_INTEGER
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	79
	La 1, -NODE_ofs
	La	-1, 0
	Ld
	LI	2
	LI	7
	UBFX
; CODE CONVERSION SOURCE DN_INTEGER TARGET DN_INTEGER
	MUL
	SUB
	ABS
	DUP
	Ld	0, STANDARD._NATURAL.FST
	CLT
	BT	STANDARD.ce_raise_
	DUP
	Ld	0, STANDARD._NATURAL.LST
	CGT
	BT	STANDARD.ce_raise_
	Sd  1,	HASH_CODE_disp

					;    end elab
begin:					;---------- BDY INSTRUCTIONS
	Ld 1,	HASH_CODE_disp
	LId	1, STANDARD.IDL.SEM_PHASE_L11.GEN_SUBS._NODE_HASH_TYPE.A__u, STANDARD.IDL.SEM_PHASE_L11.GEN_SUBS._NODE_ARRAY_TYPE.LST_1
	LId	1, STANDARD.IDL.SEM_PHASE_L11.GEN_SUBS._NODE_HASH_TYPE.A__u, STANDARD.IDL.SEM_PHASE_L11.GEN_SUBS._NODE_ARRAY_TYPE.FST_1
	SUB
	INC
	CLAMP0
	DUP
	LI	0
	CEQ
	BT	STANDARD.ne_raise_
	MODI
	DUP
	Ld	0, STANDARD._NATURAL.FST
	CLT
	BT	STANDARD.ce_raise_
	DUP
	Ld	0, STANDARD._NATURAL.LST
	CGT
	BT	STANDARD.ce_raise_
	Sd  1,	HASH_CODE_disp
; CODE_RETURN : EXPR TYPE = DN_INTEGER  VUE COMPLETE = DN_INTEGER
	Ld 1,	HASH_CODE_disp
	DUP
	Ld	0, STANDARD._NATURAL.FST
	CLT
	BT	STANDARD.ce_raise_
	DUP
	Ld	0, STANDARD._NATURAL.LST
	CGT
	BT	STANDARD.ce_raise_
	Sd  1,	-result__ofs
	BRA ret_lbl
ret_lbl:
	UNLINK 1
	RTD	prm_siz-8
excep:
endPRO					;---------- end PRO HASH_NODE_HASH
end if

if defined INSERT_NODE_HASH_L434_
PRO	INSERT_NODE_HASH_L434			;---------- PRO INSERT_NODE_HASH
PRMS					;    debut parametrage
	PRM NODE_HASH_ofs				; in out
	PRM NEW_NODE_ofs				; in
	PRM OLD_NODE_ofs				; in
endPRMS					;    fin parametrage
ELB 1					;    BODY ELAB
VAR HASH_INDEX_disp, d			; variable entiere
	LI	0					; lieu resultat sur pile
	La  1,	-OLD_NODE_ofs
	La  1,	-NODE_HASH_ofs
	CALL	STANDARD.IDL.SEM_PHASE_L11.GEN_SUBS. ,HASH_NODE_HASH_L1
	DUP
	Ld	0, STANDARD._NATURAL.FST
	CLT
	BT	STANDARD.ce_raise_
	DUP
	Ld	0, STANDARD._NATURAL.LST
	CGT
	BT	STANDARD.ce_raise_
	Sd  1,	HASH_INDEX_disp

VAR HASH_CHAIN_disp, q			; variable record : pointeur aux data record
VAR HASH_CHAIN__u, q			; variable record : pointeur aux useinfo
VAR HASH_CHAIN__dat, STANDARD.IDL._TREE.size
	LVA	1, HASH_CHAIN__dat
	Sa	1, HASH_CHAIN_disp			; record fin
	LVA	1, STANDARD.IDL._TREE.SIZ
	Sa	1, HASH_CHAIN__u
; CODE_VC_NAME DN_VARIABLE_ID
	La  1, HASH_CHAIN_disp
	LI	STANDARD.IDL._TREE.size
	La 1, -NODE_HASH_ofs
	LIVA 	, 0, STANDARD.IDL.SEM_PHASE_L11.GEN_SUBS._NODE_HASH_TYPE.A
; EXPRESSIONS.CODE_INDEXED adresse component id
	Ld 1,	HASH_INDEX_disp
	DUP
	Ld	 1, STANDARD.IDL.SEM_PHASE_L11.GEN_SUBS._NODE_ARRAY_TYPE._FST_1
	CLT
	BT	STANDARD.ce_raise_
	DUP
	Ld	 1, STANDARD.IDL.SEM_PHASE_L11.GEN_SUBS._NODE_ARRAY_TYPE._LST_1
	CGT
	BT	STANDARD.ce_raise_
	Ld	 1, STANDARD.IDL.SEM_PHASE_L11.GEN_SUBS._NODE_ARRAY_TYPE._FST_1	; (index - FST_1) * SIZ_1
	SUB
	Ld	 1, STANDARD.IDL.SEM_PHASE_L11.GEN_SUBS._NODE_ARRAY_TYPE._COMP_SIZ
	LI	8
	DIV
	MUL
	ADD					; add offset to start address
	La  ,  0
	BLKMOV

VAR NEW_HASH_CHAIN_disp, q			; variable record : pointeur aux data record
VAR NEW_HASH_CHAIN__u, q			; variable record : pointeur aux useinfo
VAR NEW_HASH_CHAIN__dat, STANDARD.IDL._TREE.size
	LVA	1, NEW_HASH_CHAIN__dat
	Sa	1, NEW_HASH_CHAIN_disp			; record fin
	LVA	1, STANDARD.IDL._TREE.SIZ
	Sa	1, NEW_HASH_CHAIN__u
; CODE_VC_NAME DN_VARIABLE_ID
	La  1, NEW_HASH_CHAIN_disp
	LI	STANDARD.IDL._TREE.size
VAR	ANON_40_30_disp, q
VAR	ANON_40_30__u,    q
VAR	ANON_40_30__dat, STANDARD.IDL._TREE.size
	LVA 1, ANON_40_30__dat
	Sa  1, ANON_40_30_disp
	La  0, STANDARD.IDL._TREE.use__info
	Sa  1, ANON_40_30__u
	LVA 1, ANON_40_30_disp
					; doublet resultat record anonyme
	LI  221
	CALL	STANDARD.IDL. ,MAKE_L15
	La  ,  0
	BLKMOV

					;    end elab
begin:					;---------- BDY INSTRUCTIONS
	LVA 1,	HASH_CHAIN_disp
	LVA 1,	NEW_HASH_CHAIN_disp
	LI  164
	CALL	STANDARD.IDL. ,D_L16
	La  1,	-OLD_NODE_ofs
	LVA 1,	NEW_HASH_CHAIN_disp
	LI  165
	CALL	STANDARD.IDL. ,D_L16
	La  1,	-NEW_NODE_ofs
	LVA 1,	NEW_HASH_CHAIN_disp
	LI  166
	CALL	STANDARD.IDL. ,D_L16
	La 1, -NODE_HASH_ofs
	LIVA 	, 0, STANDARD.IDL.SEM_PHASE_L11.GEN_SUBS._NODE_HASH_TYPE.A
; EXPRESSIONS.CODE_INDEXED adresse component id
	Ld 1,	HASH_INDEX_disp
	DUP
	Ld	 1, STANDARD.IDL.SEM_PHASE_L11.GEN_SUBS._NODE_ARRAY_TYPE._FST_1
	CLT
	BT	STANDARD.ce_raise_
	DUP
	Ld	 1, STANDARD.IDL.SEM_PHASE_L11.GEN_SUBS._NODE_ARRAY_TYPE._LST_1
	CGT
	BT	STANDARD.ce_raise_
	Ld	 1, STANDARD.IDL.SEM_PHASE_L11.GEN_SUBS._NODE_ARRAY_TYPE._FST_1	; (index - FST_1) * SIZ_1
	SUB
	Ld	 1, STANDARD.IDL.SEM_PHASE_L11.GEN_SUBS._NODE_ARRAY_TYPE._COMP_SIZ
	LI	8
	DIV
	MUL
	ADD					; add offset to start address
	LI	STANDARD.IDL._TREE.size
	LVA 1,	NEW_HASH_CHAIN_disp
	La
	BLKMOV
ret_lbl:
	UNLINK 1
	RTD	prm_siz
excep:
endPRO					;---------- end PRO INSERT_NODE_HASH
end if

if defined SEARCH_NODE_HASH_L6_
PRO	SEARCH_NODE_HASH_L6			;---------- PRO SEARCH_NODE_HASH
PRMS					;    debut parametrage
	PRM NODE_HASH_ofs				; in out
	PRM NODE_ofs				; in out
endPRMS					;    fin parametrage
ELB 1					;    BODY ELAB
VAR HASH_INDEX_disp, d			; variable entiere
	LI	0					; lieu resultat sur pile
	La  1,	-NODE_ofs
	La  1,	-NODE_HASH_ofs
	CALL	STANDARD.IDL.SEM_PHASE_L11.GEN_SUBS. ,HASH_NODE_HASH_L1
	DUP
	Ld	0, STANDARD._NATURAL.FST
	CLT
	BT	STANDARD.ce_raise_
	DUP
	Ld	0, STANDARD._NATURAL.LST
	CGT
	BT	STANDARD.ce_raise_
	Sd  1,	HASH_INDEX_disp

VAR HASH_CHAIN_disp, q			; variable record : pointeur aux data record
VAR HASH_CHAIN__u, q			; variable record : pointeur aux useinfo
VAR HASH_CHAIN__dat, STANDARD.IDL._TREE.size
	LVA	1, HASH_CHAIN__dat
	Sa	1, HASH_CHAIN_disp			; record fin
	LVA	1, STANDARD.IDL._TREE.SIZ
	Sa	1, HASH_CHAIN__u
; CODE_VC_NAME DN_VARIABLE_ID
	La  1, HASH_CHAIN_disp
	LI	STANDARD.IDL._TREE.size
	La 1, -NODE_HASH_ofs
	LIVA 	, 0, STANDARD.IDL.SEM_PHASE_L11.GEN_SUBS._NODE_HASH_TYPE.A
; EXPRESSIONS.CODE_INDEXED adresse component id
	Ld 1,	HASH_INDEX_disp
	DUP
	Ld	 1, STANDARD.IDL.SEM_PHASE_L11.GEN_SUBS._NODE_ARRAY_TYPE._FST_1
	CLT
	BT	STANDARD.ce_raise_
	DUP
	Ld	 1, STANDARD.IDL.SEM_PHASE_L11.GEN_SUBS._NODE_ARRAY_TYPE._LST_1
	CGT
	BT	STANDARD.ce_raise_
	Ld	 1, STANDARD.IDL.SEM_PHASE_L11.GEN_SUBS._NODE_ARRAY_TYPE._FST_1	; (index - FST_1) * SIZ_1
	SUB
	Ld	 1, STANDARD.IDL.SEM_PHASE_L11.GEN_SUBS._NODE_ARRAY_TYPE._COMP_SIZ
	LI	8
	DIV
	MUL
	ADD					; add offset to start address
	La  ,  0
	BLKMOV

					;    end elab
begin:					;---------- BDY INSTRUCTIONS
LOOP__1:
; CODE record equality "/=" _TREE
	LVA 1,	HASH_CHAIN_disp
	La  ,  0
	Ld
	LVA 0,	STANDARD.IDL.TREE_VOID_disp
	La  ,  0
	Ld
	CEQ
	LI	1
	OUX
	BF	L9
					; debut if
; CODE record equality "=" _TREE
VAR	ANON_60_10_disp, q
VAR	ANON_60_10__u,    q
VAR	ANON_60_10__dat, STANDARD.IDL._TREE.size
	LVA 1, ANON_60_10__dat
	Sa  1, ANON_60_10_disp
	La  0, STANDARD.IDL._TREE.use__info
	Sa  1, ANON_60_10__u
	LVA 1, ANON_60_10_disp
					; doublet resultat record anonyme
	LVA 1,	HASH_CHAIN_disp
	LI  165
	CALL	STANDARD.IDL. ,D_L17
	La  ,  0
	Ld
	La  1,	-NODE_ofs
	La  ,  0
	Ld
	CEQ
	BF	L11
	La  1,	-NODE_ofs
	La
	LI	STANDARD.IDL._TREE.size
VAR	ANON_61_17_disp, q
VAR	ANON_61_17__u,    q
VAR	ANON_61_17__dat, STANDARD.IDL._TREE.size
	LVA 1, ANON_61_17__dat
	Sa  1, ANON_61_17_disp
	La  0, STANDARD.IDL._TREE.use__info
	Sa  1, ANON_61_17__u
	LVA 1, ANON_61_17_disp
					; doublet resultat record anonyme
	LVA 1,	HASH_CHAIN_disp
	LI  166
	CALL	STANDARD.IDL. ,D_L17
	La
	BLKMOV
	BRA	L9
	BRA	L10
L11:
L10:					; post if
	LVA 1,	HASH_CHAIN_disp
	La
	LI	STANDARD.IDL._TREE.size
VAR	ANON_64_21_disp, q
VAR	ANON_64_21__u,    q
VAR	ANON_64_21__dat, STANDARD.IDL._TREE.size
	LVA 1, ANON_64_21__dat
	Sa  1, ANON_64_21_disp
	La  0, STANDARD.IDL._TREE.use__info
	Sa  1, ANON_64_21__u
	LVA 1, ANON_64_21_disp
					; doublet resultat record anonyme
	LVA 1,	HASH_CHAIN_disp
	LI  164
	CALL	STANDARD.IDL. ,D_L17
	La
	BLKMOV
	BRA	LOOP__1
L9:					; post loop LOOP__1
ret_lbl:
	UNLINK 1
	RTD	prm_siz
excep:
endPRO					;---------- end PRO SEARCH_NODE_HASH
end if

if defined REPLACE_NODE_L435_
PRO	REPLACE_NODE_L435			;---------- PRO REPLACE_NODE
PRMS					;    debut parametrage
	PRM NODE_ofs				; in out
	PRM NODE_HASH_ofs				; in out
endPRMS					;    fin parametrage
ELB 1					;    BODY ELAB
VAR OLD_NODE_disp, q			; variable record : pointeur aux data record
VAR OLD_NODE__u, q				; variable record : pointeur aux useinfo
VAR OLD_NODE__dat, STANDARD.IDL._TREE.size
	LVA	1, OLD_NODE__dat
	Sa	1, OLD_NODE_disp			; record fin
	LVA	1, STANDARD.IDL._TREE.SIZ
	Sa	1, OLD_NODE__u
; CODE_VC_NAME DN_CONSTANT_ID
	La  1, OLD_NODE_disp
	LI	STANDARD.IDL._TREE.size
	La  1,	-NODE_ofs
	La  ,  0
	BLKMOV

					;    end elab
begin:					;---------- BDY INSTRUCTIONS
	La  1,	-NODE_ofs
	La
	LI	STANDARD.IDL._TREE.size
VAR	ANON_78_13_disp, q
VAR	ANON_78_13__u,    q
VAR	ANON_78_13__dat, STANDARD.IDL._TREE.size
	LVA 1, ANON_78_13__dat
	Sa  1, ANON_78_13_disp
	La  0, STANDARD.IDL._TREE.use__info
	Sa  1, ANON_78_13__u
	LVA 1, ANON_78_13_disp
					; doublet resultat record anonyme
	La  1,	-NODE_ofs
	CALL	STANDARD.IDL.SEM_PHASE_L11.VIS_UTIL. ,COPY_NODE_L179
	La
	BLKMOV
	LVA  1,	STANDARD.IDL.SEM_PHASE_L11.GEN_SUBS.REPLACE_NODE_L435.OLD_NODE_disp	; array actual
	La  1,	-NODE_ofs
	La  1,	-NODE_HASH_ofs
	CALL	STANDARD.IDL.SEM_PHASE_L11.GEN_SUBS. ,INSERT_NODE_HASH_L434
ret_lbl:
	UNLINK 1
	RTD	prm_siz
excep:
endPRO					;---------- end PRO REPLACE_NODE
end if

if defined SUBSTITUTE_ATTRIBUTES_L436_
PRO	SUBSTITUTE_ATTRIBUTES_L436		;---------- PRO SUBSTITUTE_ATTRIBUTES
PRMS					;    debut parametrage
	PRM NODE_ofs				; in out
	PRM NODE_HASH_ofs				; in out
	PRM H_IN_ofs				; in
endPRMS					;    fin parametrage
ELB 1					;    BODY ELAB
VAR H_disp, q
	La	1, -H_IN_ofs
	La	, 0
	Sa	1, H_disp
VAR H__u, q
	LVA	1, STANDARD.IDL.SEM_PHASE_L11.SEM_GLOB._H_TYPE.SIZ
	Sa	1, H__u
VAR OLD_ATTRIBUTE_disp, q			; variable record : pointeur aux data record
VAR OLD_ATTRIBUTE__u, q			; variable record : pointeur aux useinfo
VAR OLD_ATTRIBUTE__dat, STANDARD.IDL._TREE.size
	LVA	1, OLD_ATTRIBUTE__dat
	Sa	1, OLD_ATTRIBUTE_disp			; record fin
	LVA	1, STANDARD.IDL._TREE.SIZ
	Sa	1, OLD_ATTRIBUTE__u
; CODE_VC_NAME DN_VARIABLE_ID
	La  1, OLD_ATTRIBUTE_disp
					; store represented component PT range 0 .. 1 width 2
	DUP
	Ld
	LI	0
	LI	0
	LI	2
	BFI
	Sd

VAR ATTRIBUTE_disp, q			; variable record : pointeur aux data record
VAR ATTRIBUTE__u, q				; variable record : pointeur aux useinfo
VAR ATTRIBUTE__dat, STANDARD.IDL._TREE.size
	LVA	1, ATTRIBUTE__dat
	Sa	1, ATTRIBUTE_disp			; record fin
	LVA	1, STANDARD.IDL._TREE.SIZ
	Sa	1, ATTRIBUTE__u
; CODE_VC_NAME DN_VARIABLE_ID
	La  1, ATTRIBUTE_disp
					; store represented component PT range 0 .. 1 width 2
	DUP
	Ld
	LI	0
	LI	0
	LI	2
	BFI
	Sd

					;    end elab
begin:					;---------- BDY INSTRUCTIONS
VAR	IL18_disp, b				; compteur boucle LOOP__2
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	1
	Sb  1,	IL18_disp
VAR	LMT_IL18_disp, b			; limite boucle LOOP__2
	La	 0, STANDARD.IDL.IDL_TBL.N_SPEC_disp	; array data start address on stack
	La 1, -NODE_ofs
	La	-1, 0
	Ld
	LI	24
	LI	8
	UBFX
	DUP
	LId	0, STANDARD.IDL.IDL_TBL.N_SPEC__u, STANDARD.IDL.IDL_TBL._NODE_SPECIF_TABLE.FST_1
	CLT
	BT	STANDARD.ce_raise_
	DUP
	LId	0, STANDARD.IDL.IDL_TBL.N_SPEC__u, STANDARD.IDL.IDL_TBL._NODE_SPECIF_TABLE.LST_1
	CGT
	BT	STANDARD.ce_raise_
	LId	0, STANDARD.IDL.IDL_TBL.N_SPEC__u, STANDARD.IDL.IDL_TBL._NODE_SPECIF_TABLE.FST_1	; (index - FST_1) * SIZ_1
	SUB
	LId	0, STANDARD.IDL.IDL_TBL.N_SPEC__u, STANDARD.IDL.IDL_TBL._NODE_SPECIF_TABLE.COMP_SIZ
	LI	8
	DIV
	MUL
	ADD					; add offset to start address
	ULb	, STANDARD.IDL.IDL_TBL._NODE_SPECIF.NS_SIZE
	Sb  1,	LMT_IL18_disp
	ULb  1,	IL18_disp				; test null range LOOP__2
	ULb  1,	LMT_IL18_disp
	CGT
	BT	L17
LOOP__2:					; corps boucle LOOP__2
	LVA 1,	ATTRIBUTE_disp
	La
	LI	STANDARD.IDL._TREE.size
VAR	ANON_99_20_disp, q
VAR	ANON_99_20__u,    q
VAR	ANON_99_20__dat, STANDARD.IDL._TREE.size
	LVA 1, ANON_99_20__dat
	Sa  1, ANON_99_20_disp
	La  0, STANDARD.IDL._TREE.use__info
	Sa  1, ANON_99_20__u
	LVA 1, ANON_99_20_disp
					; doublet resultat record anonyme
	La  1,	-NODE_ofs
	ULb  1,	IL18_disp
	DUP
	ULb	0, STANDARD.IDL._ATTR_NBR.FST
	CLT
	BT	STANDARD.ce_raise_
	DUP
	ULb	0, STANDARD.IDL._ATTR_NBR.LST
	CGT
	BT	STANDARD.ce_raise_
	CALL	STANDARD.IDL.IDL_MAN. ,DABS_L38
	La
	BLKMOV
	LVA 1,	OLD_ATTRIBUTE_disp
	La
	LI	STANDARD.IDL._TREE.size
	LVA 1,	ATTRIBUTE_disp
	La
	BLKMOV
	LVA	1, H_disp
	La  1,	-NODE_HASH_ofs
	LVA  1,	STANDARD.IDL.SEM_PHASE_L11.GEN_SUBS.SUBSTITUTE_ATTRIBUTES_L436.ATTRIBUTE_disp
	CALL	STANDARD.IDL.SEM_PHASE_L11.GEN_SUBS. ,SUBSTITUTE_L437
					; debut if
; CODE record equality "/=" _TREE
	LVA 1,	ATTRIBUTE_disp
	La  ,  0
	Ld
	LVA 1,	OLD_ATTRIBUTE_disp
	La  ,  0
	Ld
	CEQ
	LI	1
	OUX
	BF	L20
	LVA 1,	ATTRIBUTE_disp
	La  1,	-NODE_ofs
	ULb  1,	IL18_disp
	DUP
	ULb	0, STANDARD.IDL._ATTR_NBR.FST
	CLT
	BT	STANDARD.ce_raise_
	DUP
	ULb	0, STANDARD.IDL._ATTR_NBR.LST
	CGT
	BT	STANDARD.ce_raise_
	CALL	STANDARD.IDL.IDL_MAN. ,DABS_L37
	BRA	L19
L20:
L19:					; post if
	ULb  1,	IL18_disp				; test de sortie LOOP__2
	ULb  1,	LMT_IL18_disp
	CEQ
	BT	L17
	ULb  1,	IL18_disp				; mise a jour compteur LOOP__2
	INC
	Sb  1,	IL18_disp
	BRA	LOOP__2				; iteration suivante LOOP__2
L17:					; post loop LOOP__2
ret_lbl:
	UNLINK 1
	RTD	prm_siz
excep:
endPRO					;---------- end PRO SUBSTITUTE_ATTRIBUTES
end if

if defined SUBSTITUTE_ATTRIBUTES_ON_NODE_COPY_L21_
