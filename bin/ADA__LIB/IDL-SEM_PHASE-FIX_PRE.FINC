if defined COPY_NODE_L1_
PRO	COPY_NODE_L1				;---------- PRO COPY_NODE
 hexa_show 'COPY_NODE_L1 ', $
PRMS					;    debut parametrage
	PRM NODE_ofs				; in
	PRM result__ofs				; resultat de fonction
endPRMS					;    fin parametrage
ELB 2					;    BODY ELAB
					;    end elab
begin:					;---------- BDY INSTRUCTIONS
					; debut if
	La 2, -NODE_ofs
	La	-1, 0
	Ld
	LI	0
	LI	2
	UBFX
	LI	3
	CEQ
	La 2, -NODE_ofs
	La	-1, 0
	Ld
	LI	0
	LI	2
	UBFX
	LI	1
	CEQ
	OU
	BF	L5
; CODE_RETURN : EXPR TYPE = DN_RECORD  VUE COMPLETE = DN_RECORD
	La   2,	-result__ofs
	La  ,  0
	LI	STANDARD.IDL._TREE.size
	La  2,	-NODE_ofs
	La  ,  0
	BLKMOV
	BRA ret_lbl
	BRA	L4
L5:
namespace	BLOCK__1
ELB 3					;    BODY ELAB
 hexa_show 'var elab LEN ', $
 hexa_show ' disp ', LEN_disp
VAR LEN_disp, b				; variable entiere
	DUP
	ULb	0, STANDARD.IDL._ATTR_NBR.FST
	CLT
	BT	STANDARD.ce_raise_
	DUP
	ULb	0, STANDARD.IDL._ATTR_NBR.LST
	CGT
	BT	STANDARD.ce_raise_
	Sb  3,	LEN_disp

 hexa_show 'var elab RESULT ', $
 hexa_show ' disp ', RESULT_disp
VAR RESULT_disp, q				; variable record : pointeur aux data record
VAR RESULT__u, q				; variable record : pointeur aux useinfo
VAR RESULT__dat, STANDARD.IDL._TREE.size
	LVA	3, RESULT__dat
	Sa	3, RESULT_disp				; record fin
	LVA	3, STANDARD.IDL._TREE.SIZ
	Sa	3, RESULT__u
; CODE_VC_NAME DN_VARIABLE_ID
	La  3, RESULT_disp
	LI	STANDARD.IDL._TREE.size
VAR	ANON_22_27_disp, q
VAR	ANON_22_27__u,    q
VAR	ANON_22_27__dat, STANDARD.IDL._TREE.size
	LVA 3, ANON_22_27__dat
	Sa  3, ANON_22_27_disp
	La  0, STANDARD.IDL._TREE.use__info
	Sa  3, ANON_22_27__u
	LVA 3, ANON_22_27_disp
					; doublet resultat record anonyme
	ULb 3,	LEN_disp
	DUP
	ULb	0, STANDARD.IDL._ATTR_NBR.FST
	CLT
	BT	STANDARD.ce_raise_
	DUP
	ULb	0, STANDARD.IDL._ATTR_NBR.LST
	CGT
	BT	STANDARD.ce_raise_
	La 2, -NODE_ofs
	La	-1, 0
	Ld
	LI	24
	LI	8
	UBFX
	CALL	STANDARD.IDL.IDL_MAN. ,MAKE_L48
	La  ,  0
	BLKMOV

					;    end elab
begin:					;---------- BDY INSTRUCTIONS
VAR	IL9_disp, b				; compteur boucle LOOP__2
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	0
	Sb  3,	IL9_disp
VAR	LMT_IL9_disp, b				; limite boucle LOOP__2
	ULb 3,	LEN_disp
	Sb  3,	LMT_IL9_disp
	ULb  3,	IL9_disp				; test null range LOOP__2
	ULb  3,	LMT_IL9_disp
	CGT
	BT	L8
LOOP__2:					; corps boucle LOOP__2
VAR	ANON_25_19_disp, q
VAR	ANON_25_19__u,    q
VAR	ANON_25_19__dat, STANDARD.IDL._TREE.size
	LVA 3, ANON_25_19__dat
	Sa  3, ANON_25_19_disp
	La  0, STANDARD.IDL._TREE.use__info
	Sa  3, ANON_25_19__u
	LVA 3, ANON_25_19_disp
					; doublet resultat record anonyme
	La  2,	-NODE_ofs
	ULb  3,	IL9_disp
	DUP
	ULb	0, STANDARD.IDL._ATTR_NBR.FST
	CLT
	BT	STANDARD.ce_raise_
	DUP
	ULb	0, STANDARD.IDL._ATTR_NBR.LST
	CGT
	BT	STANDARD.ce_raise_
	CALL	STANDARD.IDL.IDL_MAN. ,DABS_L38
	LVA 3,	RESULT_disp
	ULb  3,	IL9_disp
	DUP
	ULb	0, STANDARD.IDL._ATTR_NBR.FST
	CLT
	BT	STANDARD.ce_raise_
	DUP
	ULb	0, STANDARD.IDL._ATTR_NBR.LST
	CGT
	BT	STANDARD.ce_raise_
	CALL	STANDARD.IDL.IDL_MAN. ,DABS_L37
	ULb  3,	IL9_disp				; test de sortie LOOP__2
	ULb  3,	LMT_IL9_disp
	CEQ
	BT	L8
	ULb  3,	IL9_disp				; mise a jour compteur LOOP__2
	INC
	Sb  3,	IL9_disp
	BRA	LOOP__2				; iteration suivante LOOP__2
L8:					; post loop LOOP__2
; CODE_RETURN : EXPR TYPE = DN_RECORD  VUE COMPLETE = DN_RECORD
	La   3,	-result__ofs
	La  ,  0
	LI	STANDARD.IDL._TREE.size
	LVA 3,	RESULT_disp
	La  ,  0
	BLKMOV
	UNLINK 3
	BRA ret_lbl
	UNLINK 3
endPRO
L4:					; post if
ret_lbl:
	UNLINK 2
	RTD	prm_siz-8
excep:
endPRO					;---------- end PRO COPY_NODE
end if

