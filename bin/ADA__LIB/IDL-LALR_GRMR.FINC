begin:					;---------- BDY INSTRUCTIONS
LOOP__1:
	LI	0					; lieu resultat sur pile
	LVA 2,	STATE_SEQ_disp
	CALL	STANDARD.IDL. ,IS_EMPTY_L20
	LI	1
	OUX
	BF	L13
	LVA  2,	STANDARD.IDL.LALR_GRMR_L8.INITIALIZE_L10.STATE_disp
	LVA  2,	STANDARD.IDL.LALR_GRMR_L8.INITIALIZE_L10.STATE_SEQ_disp
	CALL	STANDARD.IDL. ,POP_L21
	LI	0					; lieu resultat sur pile
	LVA 2,	STATE_disp
	LI  35
	CALL	STANDARD.IDL. ,DI_L18
	Sd  2,	STATE_NBR_disp
STR STR_L14, "INIT"				; constante string="INIT"
	LCA	STR_L14.data_ptr
	CALL	STANDARD.TEXT_IO. ,PUT_L56
	Ld 0,	STANDARD.IDL.INT_IO.DEFAULT_BASE_disp
	DUP
	Ld	0, STANDARD.TEXT_IO._NUMBER_BASE.FST
	CLT
	BT	STANDARD.ce_raise_
	DUP
	Ld	0, STANDARD.TEXT_IO._NUMBER_BASE.LST
	CGT
	BT	STANDARD.ce_raise_
	Ld 0,	STANDARD.IDL.INT_IO.DEFAULT_WIDTH_disp
	DUP
	Ld	0, STANDARD.TEXT_IO._FIELD.FST
	CLT
	BT	STANDARD.ce_raise_
	DUP
	Ld	0, STANDARD.TEXT_IO._FIELD.LST
	CGT
	BT	STANDARD.ce_raise_
	Ld 2,	STATE_NBR_disp
	CALL	STANDARD.IDL.INT_IO. ,PUT_L64
; CODE_NUMERIC_LITERAL DN_INTEGER
