	DUP
	Ld	0, STANDARD.TEXT_IO._POSITIVE_COUNT.FST
	CLT
	BT	STANDARD.ce_raise_
	DUP
	Ld	0, STANDARD.TEXT_IO._POSITIVE_COUNT.LST
	CGT
	BT	STANDARD.ce_raise_
	CALL	STANDARD.TEXT_IO. ,NEW_LINE_L26
	La	 1, STANDARD.IDL.LALR_GRMR_L8.STBL_disp	; array data start address on stack
	Ld 2,	STATE_NBR_disp
	DUP
	LId	1, STANDARD.IDL.LALR_GRMR_L8.STBL__u, STANDARD.IDL.LALR_GRMR_L8._STBL__type.FST_1
	CLT
	BT	STANDARD.ce_raise_
	DUP
	LId	1, STANDARD.IDL.LALR_GRMR_L8.STBL__u, STANDARD.IDL.LALR_GRMR_L8._STBL__type.LST_1
	CGT
	BT	STANDARD.ce_raise_
	LId	1, STANDARD.IDL.LALR_GRMR_L8.STBL__u, STANDARD.IDL.LALR_GRMR_L8._STBL__type.FST_1	; (index - FST_1) * SIZ_1
	SUB
	LId	1, STANDARD.IDL.LALR_GRMR_L8.STBL__u, STANDARD.IDL.LALR_GRMR_L8._STBL__type.COMP_SIZ
	LI	8
	DIV
	MUL
	ADD					; add offset to start address
	LVA	, STANDARD.IDL.LALR_GRMR_L8._STBL_TYPE.STATE
	LI	STANDARD.IDL._TREE.size
	LVA 2,	STATE_disp
	La
	BLKMOV
	LVA 2,	ITEM_SEQ_disp
	La
	LI	STANDARD.IDL._SEQ_TYPE.size
