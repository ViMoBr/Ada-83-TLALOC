	PRM result__ofs				; resultat de fonction
endPRMS					;    fin parametrage
ELB 2					;    BODY ELAB
 hexa_show 'var elab SYL ', $
 hexa_show ' disp ', SYL_disp
VAR SYL_disp, q				; variable record : pointeur aux data record
VAR SYL__u, q				; variable record : pointeur aux useinfo
VAR SYL__dat, STANDARD.IDL._TREE.size
	LVA	2, SYL__dat
	Sa	2, SYL_disp				; record fin
	LVA	2, STANDARD.IDL._TREE.SIZ
	Sa	2, SYL__u
; CODE_VC_NAME DN_VARIABLE_ID
	La  2, SYL_disp
					; store represented component PT range 0 .. 1 width 2
	DUP
	Ld
	LI	0
	LI	0
	LI	2
	BFI
	Sd

 hexa_show 'var elab RULE ', $
 hexa_show ' disp ', RULE_disp
VAR RULE_disp, q				; variable record : pointeur aux data record
VAR RULE__u, q				; variable record : pointeur aux useinfo
VAR RULE__dat, STANDARD.IDL._TREE.size
	LVA	2, RULE__dat
	Sa	2, RULE_disp				; record fin
	LVA	2, STANDARD.IDL._TREE.SIZ
	Sa	2, RULE__u
; CODE_VC_NAME DN_VARIABLE_ID
	La  2, RULE_disp
					; store represented component PT range 0 .. 1 width 2
	DUP
	Ld
	LI	0
	LI	0
	LI	2
	BFI
	Sd

					;    end elab
begin:					;---------- BDY INSTRUCTIONS
					; debut if
	LI	0					; lieu resultat sur pile
	La  2,	-SYL_LIST_ofs
	CALL	STANDARD.IDL. ,IS_EMPTY_L20
	BF	L5
; CODE_RETURN : EXPR TYPE = DN_INTEGER  VUE COMPLETE = DN_INTEGER
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	0
	Sd  2,	-result__ofs
	BRA ret_lbl
	BRA	L4
L5:
L4:					; post if
	LVA 2,	SYL_disp
	La
	LI	STANDARD.IDL._TREE.size
VAR	ANON_38_12_disp, q
VAR	ANON_38_12__u,    q
VAR	ANON_38_12__dat, STANDARD.IDL._TREE.size
	LVA 2, ANON_38_12__dat
	Sa  2, ANON_38_12_disp
	La  0, STANDARD.IDL._TREE.use__info
	Sa  2, ANON_38_12__u
	LVA 2, ANON_38_12_disp
					; doublet resultat record anonyme
	La  2,	-SYL_LIST_ofs
	CALL	STANDARD.IDL.IDL_MAN. ,HEAD_L26
	La
	BLKMOV
					; debut if
	La	2, STANDARD.IDL.LALR_GRMR_L8.GET_RULE_NBR_L1.SYL_disp
	Ld
	LI	24
	LI	8
	UBFX
	LI	16
	CNE
	BF	L7
; CODE_RETURN : EXPR TYPE = DN_INTEGER  VUE COMPLETE = DN_INTEGER
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	0
	Sd  2,	-result__ofs
	BRA ret_lbl
	BRA	L6
L7:
L6:					; post if
	LVA 2,	RULE_disp
	La
	LI	STANDARD.IDL._TREE.size
VAR	ANON_42_13_disp, q
VAR	ANON_42_13__u,    q
VAR	ANON_42_13__dat, STANDARD.IDL._TREE.size
	LVA 2, ANON_42_13__dat
	Sa  2, ANON_42_13_disp
	La  0, STANDARD.IDL._TREE.use__info
	Sa  2, ANON_42_13__u
	LVA 2, ANON_42_13_disp
					; doublet resultat record anonyme
	LVA 2,	SYL_disp
	LI  24
	CALL	STANDARD.IDL. ,D_L14
	La
	BLKMOV
					; debut if
	La	2, STANDARD.IDL.LALR_GRMR_L8.GET_RULE_NBR_L1.RULE_disp
	Ld
	LI	24
	LI	8
	UBFX
	LI	20
	CEQ
	BF	L9
; CODE_RETURN : EXPR TYPE = DN_INTEGER  VUE COMPLETE = DN_INTEGER
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	0
	Sd  2,	-result__ofs
	BRA ret_lbl
	BRA	L8
L9:
L8:					; post if
; CODE_RETURN : EXPR TYPE = DN_INTEGER  VUE COMPLETE = DN_INTEGER
	LI	0					; lieu resultat sur pile
VAR	ANON_46_29_disp, q
VAR	ANON_46_29__u,    q
VAR	ANON_46_29__dat, STANDARD.IDL._TREE.size
	LVA 2, ANON_46_29__dat
	Sa  2, ANON_46_29_disp
	La  0, STANDARD.IDL._TREE.use__info
	Sa  2, ANON_46_29__u
	LVA 2, ANON_46_29_disp
					; doublet resultat record anonyme
	LVA 2,	RULE_disp
	LI  21
	CALL	STANDARD.IDL. ,D_L14
	LI  33
	CALL	STANDARD.IDL. ,DI_L18
	Sd  2,	-result__ofs
	BRA ret_lbl
ret_lbl:
	UNLINK 2
	RTD	prm_siz-8
excep:
endPRO					;---------- end PRO GET_RULE_NBR
end if

