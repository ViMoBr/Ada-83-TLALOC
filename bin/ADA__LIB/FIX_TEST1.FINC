VAR NB_OK_disp, d				; variable entiere
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	0
	Sd  1,	NB_OK_disp

VAR NB_KO_disp, d				; variable entiere
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	0
	Sd  1,	NB_KO_disp

VAR A_disp, q				; variable fixed
; CODE_NUMERIC_LITERAL DN_FIXED
	LI	 5
	LI	 16
	LI	 2
	CVTIX
	Sq  1,	A_disp

VAR B_disp, q				; variable fixed
; CODE_NUMERIC_LITERAL DN_FIXED
	LI	 4
	LI	 16
	LI	 1
	CVTIX
	Sq  1,	B_disp

VAR AN_disp, q				; variable fixed
	LI	-5
	LI	 16
	LI	 2
	CVTIX
	Sq  1,	AN_disp

VAR C_disp, q				; variable fixed
; CODE_NUMERIC_LITERAL DN_FIXED
	LI	 0
	LI	 32
	LI	 1
	CVTIX
	Sq  1,	C_disp

VAR D_disp, q				; variable fixed
; CODE_NUMERIC_LITERAL DN_FIXED
	LI	 6
	LI	 4
	LI	 3
	CVTIX
	Sq  1,	D_disp

VAR E_disp, q				; variable fixed
; CODE_NUMERIC_LITERAL DN_FIXED
	LI	 0
	LI	 16
	LI	 1
	CVTIX
	Sq  1,	E_disp

VAR S_disp, q				; variable fixed
; CODE_NUMERIC_LITERAL DN_FIXED
	LI	 1
	LI	 16
	LI	 2
	CVTIX
	Sq  1,	S_disp

VAR N_disp, d				; variable entiere
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	3
	Sd  1,	N_disp

VAR NZ_disp, d				; variable entiere
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	0
	Sd  1,	NZ_disp


if defined CHECK_L8_
PRO	CHECK_L8				;---------- PRO CHECK
PRMS					;    debut parametrage
	PRM COND_ofs				; in
	PRM SECTION_ofs				; in
	PRM NUM_ofs				; in
endPRMS					;    fin parametrage
ELB 2					;    BODY ELAB
					;    end elab
begin:					;---------- BDY INSTRUCTIONS
					; debut if
	Lb  2,	-COND_ofs
	BF	L12
	Ld 1,	STANDARD.FIX_TEST1_L1.NB_OK_disp
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	1
	ADD
	Sd  1,	NB_OK_disp
	BRA	L11
L12:
	Ld 1,	STANDARD.FIX_TEST1_L1.NB_KO_disp
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	1
	ADD
	Sd  1,	NB_KO_disp
STR STR_L13, "* ECHEC section "		; constante string="* ECHEC section "
	LCA	STR_L13.data_ptr
	CALL	STANDARD.TEXT_IO. ,PUT_L56
	La  2,	-SECTION_ofs
	CALL	STANDARD.TEXT_IO. ,PUT_L56
STR STR_L14, " test"			; constante string=" test"
	LCA	STR_L14.data_ptr
	CALL	STANDARD.TEXT_IO. ,PUT_L56
	Ld 1,	STANDARD.FIX_TEST1_L1.INT_IO.DEFAULT_BASE_disp
	DUP
	Ld	0, STANDARD.TEXT_IO._NUMBER_BASE.FST
	CLT
	BT	STANDARD.ce_raise_
	DUP
	Ld	0, STANDARD.TEXT_IO._NUMBER_BASE.LST
	CGT
	BT	STANDARD.ce_raise_
	Ld 1,	STANDARD.FIX_TEST1_L1.INT_IO.DEFAULT_WIDTH_disp
	DUP
	Ld	0, STANDARD.TEXT_IO._FIELD.FST
	CLT
	BT	STANDARD.ce_raise_
	DUP
	Ld	0, STANDARD.TEXT_IO._FIELD.LST
	CGT
	BT	STANDARD.ce_raise_
	Ld  2,	-NUM_ofs
	CALL	STANDARD.FIX_TEST1_L1.INT_IO. ,PUT_L64
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	1
	DUP
	Ld	0, STANDARD.TEXT_IO._POSITIVE_COUNT.FST
	CLT
	BT	STANDARD.ce_raise_
	DUP
	Ld	0, STANDARD.TEXT_IO._POSITIVE_COUNT.LST
	CGT
	BT	STANDARD.ce_raise_
	CALL	STANDARD.TEXT_IO. ,NEW_LINE_L26
L11:					; post if
ret_lbl:
	UNLINK 2
	RTD	prm_siz
excep:
endPRO					;---------- end PRO CHECK
end if
					;    end elab
begin:					;---------- BDY INSTRUCTIONS
STR STR_L17, "=== S1. Multiplicatif T(X*Y), T(X/Y), elision FIX.INT ==="	; constante string="=== S1. Multiplicatif T(X*Y), T(X/Y), elision FIX.INT ==="
	LCA	STR_L17.data_ptr
	CALL	STANDARD.TEXT_IO. ,PUT_LINE_L60
	Lq 1,	A_disp
	Lq 1,	B_disp
	MUL
	LI	 1
	LI	 8
	CVTIX
	Sq  1,	C_disp
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	1
STR STR_L18, "S1"				; constante string="S1"
	LCA	STR_L18.data_ptr
	Lq 1,	C_disp
; CODE_NUMERIC_LITERAL DN_FIXED
	LI	 10
	LI	 32
	LI	 1
	CVTIX
	CEQ
	CALL	STANDARD.FIX_TEST1_L1. ,CHECK_L8
	Lq 1,	A_disp
	LI	 32
	LI	 1
	CVTIX
	Lq 1,	B_disp
	DUP
	LI	0
	CEQ
	BT	STANDARD.ne_raise_
	DIV
	Sq  1,	C_disp
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	2
