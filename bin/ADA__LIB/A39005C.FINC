	Sd	1, _FST_1
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	5
	Sd	1, _LST_1
	Ld	1, _LST_1
	Ld	1, _FST_1
	SUB
	INC
	CLAMP0
	MUL
	Sd	1, SIZ
  virtual at 4
COMP_SIZ = $
	rd 1 
FST_1 = $
	rd 1 
LST_1 = $
	rd 1 
  end virtual
end namespace
VAR POINT_disp, q				; variable array : pointeur aux data
VAR POINT__u, q				; variable array : useinfo pointeur au rec info
	La 1, STANDARD.A39005C_L1._LIST_ARRAY.use__info
	Sa	1, POINT__u				; array info ptr at __u
	Ld	1, STANDARD.A39005C_L1._LIST_ARRAY.SIZ
	LI	8
	DIV
	CO_VAR
	Sa	1, POINT_disp				; array data ptr at _disp

