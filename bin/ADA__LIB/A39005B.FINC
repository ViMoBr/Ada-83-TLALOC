_COLOR = '_COLOR'
namespace _COLOR
VAR use__info, q
BEGIN_BLOC_DEF
db 0, 5, "WHITE"
db 1, 3, "RED"
db 2, 6, "YELLOW"
db 3, 5, "GREEN"
db 4, 4, "BLUE"
db 5, 5, "BROWN"
db 6, 5, "BLACK"
END_BLOC_DEF
IMAGES	BYTES_BLOC
CST LST, d, 6
CST FST, d, 0
CST SIZ, d, 8	; SIZ en bits !
postpone
  align_q
end postpone
	LCA	SIZ
	Sa	1, use__info
end namespace

