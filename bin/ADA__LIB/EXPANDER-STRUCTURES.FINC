	CALL	STANDARD.EXPANDER_L1.DECLARATIONS. ,CODE_GENERIC_DECL_L79
	BRA	L7
L11:
	DROP
	LVA 1,	UNIT_ALL_DECL_disp
	CALL	STANDARD.EXPANDER_L1.STRUCTURES. ,CODE_SUBPROGRAM_BODY_L136
	BRA	L7
L12:
