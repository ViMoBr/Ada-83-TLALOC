SEM_GLOB = 'SEM_GLOB'
namespace SEM_GLOB				;---------- PACKAGE
elab_spec:				;    SPEC ELAB


					; SU_TYPE RECORD TYPE INFO
SU_TYPE = 'SU_TYPE'
namespace SU_TYPE
VAR use__info, q
VAR SIZ, d
	LVA	0, SIZ
	Sa	0, use__info
USEINFO 0, USED_PACKAGE_LIST, 	La 0, STANDARD.IDL.SEQ_TYPE.use__info
USEINFO 0, INCOMPLETE_TYPE_LIST, 	La 0, STANDARD.IDL.SEQ_TYPE.use__info
USEINFO 0, PRIVATE_TYPE_LIST, 	La 0, STANDARD.IDL.SEQ_TYPE.use__info
virtual at 0				; calcul des offsets statiques
STATOFS USED_PACKAGE_LIST, 8
STATOFS INCOMPLETE_TYPE_LIST, 8
STATOFS PRIVATE_TYPE_LIST, 8
size = $
end virtual
	LI	 size*8
	Sd	0, SIZ
end namespace

					; H_TYPE RECORD TYPE INFO
H_TYPE = 'H_TYPE'
namespace H_TYPE
VAR use__info, q
VAR SIZ, d
	LVA	0, SIZ
	Sa	0, use__info
USEINFO 0, REGION_DEF, 	La 0, STANDARD.IDL.TREE.use__info
USEINFO 0, LEX_LEVEL, 	La 0, STANDARD.NATURAL.use__info
USEINFO 0, IS_IN_SPEC, 	La 0, STANDARD.BOOLEAN.use__info
USEINFO 0, IS_IN_BODY, 	La 0, STANDARD.BOOLEAN.use__info
USEINFO 0, SUBP_SYMREP, 	La 0, STANDARD.IDL.TREE.use__info
USEINFO 0, RETURN_TYPE, 	La 0, STANDARD.IDL.TREE.use__info
USEINFO 0, ENCLOSING_LOOP_ID, 	La 0, STANDARD.IDL.TREE.use__info
virtual at 0				; calcul des offsets statiques
STATOFS REGION_DEF, 4
STATOFS LEX_LEVEL, 4
STATOFS IS_IN_SPEC, 1
STATOFS IS_IN_BODY, 1
STATOFS SUBP_SYMREP, 4
STATOFS RETURN_TYPE, 4
STATOFS ENCLOSING_LOOP_ID, 4
size = $
end virtual
	LI	 size*8
	Sd	0, SIZ
end namespace
VAR SU_disp, q				; variable record : pointeur aux data record
VAR SU__u, q				; variable record : pointeur aux useinfo
VAR SU__dat, STANDARD.IDL.SEM_PHASE_L11.SEM_GLOB.SU_TYPE.size
	LVA	0, SU__dat
	Sa	0, SU_disp				; record fin
	LVA	0, STANDARD.IDL.SEM_PHASE_L11.SEM_GLOB.SU_TYPE.SIZ
	Sa	0, SU__u
; CODE_VC_NAME DN_VARIABLE_ID

