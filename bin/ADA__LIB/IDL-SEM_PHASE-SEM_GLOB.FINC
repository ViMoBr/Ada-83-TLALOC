	La  0, STANDARD.IDL._TREE.use__info
	Sa  2, ANON_44_35__u
	LVA 2, ANON_44_35_disp
					; doublet resultat record anonyme
	La  2,	-X_ofs
	CALL	STANDARD.IDL.IDL_MAN. ,STORE_SYM_L40
	CALL	STANDARD.IDL. ,LIST_L22
	La  ,  0
	BLKMOV

VAR DEF_disp, q				; variable record : pointeur aux data record
VAR DEF__u, q				; variable record : pointeur aux useinfo
VAR DEF__dat, STANDARD.IDL._TREE.size
	LVA	2, DEF__dat
	Sa	2, DEF_disp				; record fin
	LVA	2, STANDARD.IDL._TREE.SIZ
	Sa	2, DEF__u
; CODE_VC_NAME DN_VARIABLE_ID
	LIVA 2, DEF_disp, STANDARD.IDL._TREE.PT
	LI	0
	Sb

					;    end elab
begin:					;---------- BDY INSTRUCTIONS
LOOP__1:
	LI	0					; lieu resultat sur pile
	LVA 2,	DEFLIST_disp
	CALL	STANDARD.IDL. ,IS_EMPTY_L23
	LI	1
	OUX
	BF	L6
	LVA  2,	DEF_disp
	LVA  2,	DEFLIST_disp
	CALL	STANDARD.IDL. ,POP_L24
					; debut if
; CODE record equality "=" _TREE
VAR	EQA_L9, q
VAR	EQB_L9, q
VAR	ANON_49_13_disp, q
VAR	ANON_49_13__u,    q
VAR	ANON_49_13__dat, STANDARD.IDL._TREE.size
	LVA 2, ANON_49_13__dat
	Sa  2, ANON_49_13_disp
	La  0, STANDARD.IDL._TREE.use__info
	Sa  2, ANON_49_13__u
	LVA 2, ANON_49_13_disp
					; doublet resultat record anonyme
	LVA 2,	DEF_disp
	LI  169
	CALL	STANDARD.IDL. ,D_L17
	La  ,  0
	Sa  2, EQA_L9
	LVA 1,	STANDARD.IDL.SEM_PHASE_L11.SEM_GLOB.PREDEFINED_STANDARD_DEF_disp
	La  ,  0
	Sa  2, EQB_L9
	LI	1
	LIb	2, EQA_L9, STANDARD.IDL._TREE.PT
	LIb	2, EQB_L9, STANDARD.IDL._TREE.PT
	CEQ
	ET
	LIb	2, EQA_L9, STANDARD.IDL._TREE.PT
	LI	0
	CEQ
	LIb	2, EQA_L9, STANDARD.IDL._TREE.PT
	LI	2
	CEQ
	OU
	BF	L11
	LIb	2, EQA_L9, STANDARD.IDL._TREE.TY
	LIb	2, EQB_L9, STANDARD.IDL._TREE.TY
	CEQ
	ET
	LIw	2, EQA_L9, STANDARD.IDL._TREE.PG
	LIw	2, EQB_L9, STANDARD.IDL._TREE.PG
	CEQ
	ET
	LIw	2, EQA_L9, STANDARD.IDL._TREE.LN
	LIw	2, EQB_L9, STANDARD.IDL._TREE.LN
	CEQ
	ET
	BRA	L10
L11:
	LIb	2, EQA_L9, STANDARD.IDL._TREE.PT
	LI	1
	CEQ
	BF	L12
	LIw	2, EQA_L9, STANDARD.IDL._TREE.COL
	LIw	2, EQB_L9, STANDARD.IDL._TREE.COL
	CEQ
	ET
	LIw	2, EQA_L9, STANDARD.IDL._TREE.SPG
	LIw	2, EQB_L9, STANDARD.IDL._TREE.SPG
	CEQ
	ET
	LIw	2, EQA_L9, STANDARD.IDL._TREE.SLN
	LIw	2, EQB_L9, STANDARD.IDL._TREE.SLN
	CEQ
	ET
	BRA	L10
L12:
	LIb	2, EQA_L9, STANDARD.IDL._TREE.PT
	LI	3
	CEQ
	BF	L13
	LIb	2, EQA_L9, STANDARD.IDL._TREE.NOTY
	LIb	2, EQB_L9, STANDARD.IDL._TREE.NOTY
	CEQ
	ET
	LIw	2, EQA_L9, STANDARD.IDL._TREE.ABSS
	LIw	2, EQB_L9, STANDARD.IDL._TREE.ABSS
	CEQ
	ET
	LIw	2, EQA_L9, STANDARD.IDL._TREE.NSIZ
	LIw	2, EQB_L9, STANDARD.IDL._TREE.NSIZ
	CEQ
	ET
	BRA	L10
L13:
L10:
	BF	L8
; CODE_RETURN : EXPR TYPE = DN_RECORD
	La   2,	-result__ofs
	La  ,  0
	LI	STANDARD.IDL._TREE.size
VAR	ANON_50_18_disp, q
VAR	ANON_50_18__u,    q
VAR	ANON_50_18__dat, STANDARD.IDL._TREE.size
	LVA 2, ANON_50_18__dat
	Sa  2, ANON_50_18_disp
	La  0, STANDARD.IDL._TREE.use__info
	Sa  2, ANON_50_18__u
	LVA 2, ANON_50_18_disp
					; doublet resultat record anonyme
VAR	ANON_50_35_disp, q
VAR	ANON_50_35__u,    q
VAR	ANON_50_35__dat, STANDARD.IDL._TREE.size
	LVA 2, ANON_50_35__dat
	Sa  2, ANON_50_35_disp
	La  0, STANDARD.IDL._TREE.use__info
	Sa  2, ANON_50_35__u
	LVA 2, ANON_50_35_disp
					; doublet resultat record anonyme
	LVA 2,	DEF_disp
	LI  35
	CALL	STANDARD.IDL. ,D_L17
	LI  33
	CALL	STANDARD.IDL. ,D_L17
	La  ,  0
	BLKMOV
	BRA ret_lbl
	BRA	L7
L8:
L7:					; post if
	BRA	LOOP__1
L6:					; post loop LOOP__1
; CODE_RETURN : EXPR TYPE = DN_RECORD
	La   2,	-result__ofs
	La  ,  0
	LI	STANDARD.IDL._TREE.size
	LVA 0,	STANDARD.IDL.TREE_VOID_disp
	La  ,  0
	BLKMOV
	BRA ret_lbl
ret_lbl:
	UNLINK 2
	RTD	prm_siz-8
excep:
endPRO					;---------- end PRO INIT
end if

