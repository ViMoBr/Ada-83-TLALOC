if defined INITIALIZE_GLOBAL_DATA_L1_
PRO	INITIALIZE_GLOBAL_DATA_L1			;---------- PRO INITIALIZE_GLOBAL_DATA
ELB 1					;    BODY ELAB
					;    end elab
begin:					;---------- BDY INSTRUCTIONS
	LIVA 	0, SU_disp, STANDARD.IDL.SEM_PHASE_L11.SEM_GLOB.SU_TYPE.USED_PACKAGE_LIST
					; Assign_record_aggregate type DN_RECORD
	DUP
	LVA	, STANDARD.IDL.SEQ_TYPE.FIRST
	LI	STANDARD.IDL.TREE.size
	LVA 0,	STANDARD.IDL.TREE_NIL_disp
	La  ,  0
	BLKMOV
	DUP
	LVA	, STANDARD.IDL.SEQ_TYPE.NEXT
	LI	STANDARD.IDL.TREE.size
	LVA 0,	STANDARD.IDL.TREE_NIL_disp
	La  ,  0
	BLKMOV
	DROP
	LIVA 	0, SU_disp, STANDARD.IDL.SEM_PHASE_L11.SEM_GLOB.SU_TYPE.INCOMPLETE_TYPE_LIST
					; Assign_record_aggregate type DN_RECORD
	DUP
	LVA	, STANDARD.IDL.SEQ_TYPE.FIRST
	LI	STANDARD.IDL.TREE.size
	LVA 0,	STANDARD.IDL.TREE_NIL_disp
	La  ,  0
	BLKMOV
	DUP
	LVA	, STANDARD.IDL.SEQ_TYPE.NEXT
	LI	STANDARD.IDL.TREE.size
	LVA 0,	STANDARD.IDL.TREE_NIL_disp
	La  ,  0
	BLKMOV
	DROP
	LIVA 	0, SU_disp, STANDARD.IDL.SEM_PHASE_L11.SEM_GLOB.SU_TYPE.PRIVATE_TYPE_LIST
					; Assign_record_aggregate type DN_RECORD
	DUP
	LVA	, STANDARD.IDL.SEQ_TYPE.FIRST
	LI	STANDARD.IDL.TREE.size
	LVA 0,	STANDARD.IDL.TREE_NIL_disp
	La  ,  0
	BLKMOV
	DUP
	LVA	, STANDARD.IDL.SEQ_TYPE.NEXT
	LI	STANDARD.IDL.TREE.size
	LVA 0,	STANDARD.IDL.TREE_NIL_disp
	La  ,  0
	BLKMOV
	DROP
	LVA 0,	STANDARD.IDL.SEM_PHASE_L11.SEM_GLOB.INITIAL_H_disp
	La
	LI	STANDARD.IDL.SEM_PHASE_L11.SEM_GLOB.H_TYPE.size
					; Assign_record_aggregate type DN_RECORD
	DUP
	LVA	, STANDARD.IDL.SEM_PHASE_L11.SEM_GLOB.H_TYPE.REGION_DEF
	LI	STANDARD.IDL.TREE.size
	LVA 0,	STANDARD.IDL.TREE_VOID_disp
	La  ,  0
	BLKMOV
	DUP
	LVA	, STANDARD.IDL.SEM_PHASE_L11.SEM_GLOB.H_TYPE.LEX_LEVEL
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	1
	Sd
	DUP
	LVA	, STANDARD.IDL.SEM_PHASE_L11.SEM_GLOB.H_TYPE.IS_IN_SPEC
	LI	1
	Sb
	DUP
	LVA	, STANDARD.IDL.SEM_PHASE_L11.SEM_GLOB.H_TYPE.IS_IN_BODY
	LI	0
	Sb
	DUP
	LVA	, STANDARD.IDL.SEM_PHASE_L11.SEM_GLOB.H_TYPE.SUBP_SYMREP
	LI	STANDARD.IDL.TREE.size
	LVA 0,	STANDARD.IDL.TREE_VOID_disp
	La  ,  0
	BLKMOV
	DUP
	LVA	, STANDARD.IDL.SEM_PHASE_L11.SEM_GLOB.H_TYPE.RETURN_TYPE
	LI	STANDARD.IDL.TREE.size
	LVA 0,	STANDARD.IDL.TREE_VOID_disp
	La  ,  0
	BLKMOV
	DUP
	LVA	, STANDARD.IDL.SEM_PHASE_L11.SEM_GLOB.H_TYPE.ENCLOSING_LOOP_ID
	LI	STANDARD.IDL.TREE.size
	LVA 0,	STANDARD.IDL.TREE_VOID_disp
	La  ,  0
	BLKMOV
	DROP
ret_lbl:
	UNLINK 1
	RTD
excep:
endPRO					;---------- end PRO INITIALIZE_GLOBAL_DATA
end if

if defined INITIALIZE_PREDEFINED_TYPES_L2_
PRO	INITIALIZE_PREDEFINED_TYPES_L2		;---------- PRO INITIALIZE_PREDEFINED_TYPES
ELB 1					;    BODY ELAB

if defined INIT_L3_
PRO	INIT_L3				;---------- PRO INIT
PRMS					;    debut parametrage
	PRM X_ofs				; in
	PRM result__ofs				; resultat de fonction
endPRMS					;    fin parametrage
ELB 2					;    BODY ELAB
VAR DEFLIST_disp, q				; variable record : pointeur aux data record
VAR DEFLIST__u, q				; variable record : pointeur aux useinfo
VAR DEFLIST__dat, STANDARD.IDL.SEQ_TYPE.size
	LVA	2, DEFLIST__dat
	Sa	2, DEFLIST_disp				; record fin
	LVA	2, STANDARD.IDL.SEQ_TYPE.SIZ
	Sa	2, DEFLIST__u
; CODE_VC_NAME DN_VARIABLE_ID
	La  2, DEFLIST_disp
	LI	STANDARD.IDL.SEQ_TYPE.size
VAR	ANON_44_29_disp, q
VAR	ANON_44_29__u,    q
VAR	ANON_44_29__dat, STANDARD.IDL.SEQ_TYPE.size
	LVA 2, ANON_44_29__dat
	Sa  2, ANON_44_29_disp
	La  0, STANDARD.IDL.SEQ_TYPE.use__info
	Sa  2, ANON_44_29__u
	LVA 2, ANON_44_29_disp
					; doublet resultat record anonyme
VAR	ANON_44_35_disp, q
VAR	ANON_44_35__u,    q
VAR	ANON_44_35__dat, STANDARD.IDL.TREE.size
	LVA 2, ANON_44_35__dat
	Sa  2, ANON_44_35_disp
	La  0, STANDARD.IDL.TREE.use__info
	Sa  2, ANON_44_35__u
	LVA 2, ANON_44_35_disp
					; doublet resultat record anonyme
	La  2,	-X_ofs
	CALL	STANDARD.IDL.IDL_MAN. ,STORE_SYM_L40
	CALL	STANDARD.IDL. ,LIST_L22
	La  ,  0
	BLKMOV

VAR DEF_disp, q				; variable record : pointeur aux data record
VAR DEF__u, q				; variable record : pointeur aux useinfo
VAR DEF__dat, STANDARD.IDL.TREE.size
	LVA	2, DEF__dat
	Sa	2, DEF_disp				; record fin
	LVA	2, STANDARD.IDL.TREE.SIZ
	Sa	2, DEF__u
; CODE_VC_NAME DN_VARIABLE_ID

					;    end elab
begin:					;---------- BDY INSTRUCTIONS
LOOP__1:
	LI	0					; lieu resultat sur pile
	LVA 2,	DEFLIST_disp
	CALL	STANDARD.IDL. ,IS_EMPTY_L23
	LI	1
	OUX
	BF	L4
	LVA  2,	DEF_disp
	LVA  2,	DEFLIST_disp
	CALL	STANDARD.IDL. ,POP_L24
					; debut if
VAR	ANON_49_13_disp, q
VAR	ANON_49_13__u,    q
VAR	ANON_49_13__dat, STANDARD.IDL.TREE.size
	LVA 2, ANON_49_13__dat
	Sa  2, ANON_49_13_disp
	La  0, STANDARD.IDL.TREE.use__info
	Sa  2, ANON_49_13__u
	LVA 2, ANON_49_13_disp
					; doublet resultat record anonyme
	LVA 2,	DEF_disp
	LI  169
	CALL	STANDARD.IDL. ,D_L17
