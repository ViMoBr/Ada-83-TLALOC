SEM_GLOB = 'SEM_GLOB'
namespace SEM_GLOB				;---------- PACKAGE (BDY)
					;    BODY ELAB

if defined INITIALIZE_GLOBAL_DATA_L1_
PRO	INITIALIZE_GLOBAL_DATA_L1			;---------- PRO INITIALIZE_GLOBAL_DATA
 hexa_show 'INITIALIZE_GLOBAL_DATA_L1 ', $
ELB 1					;    BODY ELAB
					;    end elab
begin:					;---------- BDY INSTRUCTIONS
	LIVA 	1, STANDARD.IDL.SEM_PHASE_L11.SEM_GLOB.SU_disp, STANDARD.IDL.SEM_PHASE_L11.SEM_GLOB._SU_TYPE.USED_PACKAGE_LIST
					; Assign_record_aggregate type DN_RECORD
	DUP
	LVA	, STANDARD.IDL._SEQ_TYPE.FIRST
	LI	STANDARD.IDL._TREE.size
	LVA 0,	STANDARD.IDL.TREE_NIL_disp
	La
	BLKMOV
	DUP
	LVA	, STANDARD.IDL._SEQ_TYPE.NEXT
	LI	STANDARD.IDL._TREE.size
	LVA 0,	STANDARD.IDL.TREE_NIL_disp
	La
	BLKMOV
	DROP
	LIVA 	1, STANDARD.IDL.SEM_PHASE_L11.SEM_GLOB.SU_disp, STANDARD.IDL.SEM_PHASE_L11.SEM_GLOB._SU_TYPE.INCOMPLETE_TYPE_LIST
					; Assign_record_aggregate type DN_RECORD
	DUP
	LVA	, STANDARD.IDL._SEQ_TYPE.FIRST
	LI	STANDARD.IDL._TREE.size
	LVA 0,	STANDARD.IDL.TREE_NIL_disp
	La
	BLKMOV
	DUP
	LVA	, STANDARD.IDL._SEQ_TYPE.NEXT
	LI	STANDARD.IDL._TREE.size
	LVA 0,	STANDARD.IDL.TREE_NIL_disp
	La
	BLKMOV
	DROP
	LIVA 	1, STANDARD.IDL.SEM_PHASE_L11.SEM_GLOB.SU_disp, STANDARD.IDL.SEM_PHASE_L11.SEM_GLOB._SU_TYPE.PRIVATE_TYPE_LIST
					; Assign_record_aggregate type DN_RECORD
	DUP
	LVA	, STANDARD.IDL._SEQ_TYPE.FIRST
	LI	STANDARD.IDL._TREE.size
	LVA 0,	STANDARD.IDL.TREE_NIL_disp
	La
	BLKMOV
	DUP
	LVA	, STANDARD.IDL._SEQ_TYPE.NEXT
	LI	STANDARD.IDL._TREE.size
	LVA 0,	STANDARD.IDL.TREE_NIL_disp
	La
	BLKMOV
	DROP
	LVA 1,	STANDARD.IDL.SEM_PHASE_L11.SEM_GLOB.INITIAL_H_disp
	La
					; Assign_record_aggregate type DN_RECORD
	DUP
	LVA	, STANDARD.IDL.SEM_PHASE_L11.SEM_GLOB._H_TYPE.REGION_DEF
	LI	STANDARD.IDL._TREE.size
	LVA 0,	STANDARD.IDL.TREE_VOID_disp
	La
	BLKMOV
	DUP
	LVA	, STANDARD.IDL.SEM_PHASE_L11.SEM_GLOB._H_TYPE.LEX_LEVEL
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	1
	Sd
	DUP
	LVA	, STANDARD.IDL.SEM_PHASE_L11.SEM_GLOB._H_TYPE.IS_IN_SPEC
	LI	1
	Sb
	DUP
	LVA	, STANDARD.IDL.SEM_PHASE_L11.SEM_GLOB._H_TYPE.IS_IN_BODY
	LI	0
	Sb
	DUP
	LVA	, STANDARD.IDL.SEM_PHASE_L11.SEM_GLOB._H_TYPE.SUBP_SYMREP
	LI	STANDARD.IDL._TREE.size
	LVA 0,	STANDARD.IDL.TREE_VOID_disp
	La
	BLKMOV
	DUP
	LVA	, STANDARD.IDL.SEM_PHASE_L11.SEM_GLOB._H_TYPE.RETURN_TYPE
	LI	STANDARD.IDL._TREE.size
	LVA 0,	STANDARD.IDL.TREE_VOID_disp
	La
	BLKMOV
	DUP
	LVA	, STANDARD.IDL.SEM_PHASE_L11.SEM_GLOB._H_TYPE.ENCLOSING_LOOP_ID
	LI	STANDARD.IDL._TREE.size
	LVA 0,	STANDARD.IDL.TREE_VOID_disp
	La
	BLKMOV
	DROP
ret_lbl:
	UNLINK 1
	RTD
excep:
endPRO					;---------- end PRO INITIALIZE_GLOBAL_DATA
end if

if defined INITIALIZE_PREDEFINED_TYPES_L2_
PRO	INITIALIZE_PREDEFINED_TYPES_L2		;---------- PRO INITIALIZE_PREDEFINED_TYPES
 hexa_show 'INITIALIZE_PREDEFINED_TYPES_L2 ', $
ELB 1					;    BODY ELAB

if defined INIT_L3_
PRO	INIT_L3				;---------- PRO INIT
 hexa_show 'INIT_L3 ', $
PRMS					;    debut parametrage
	PRM X_ofs				; in
	PRM result__ofs				; resultat de fonction
endPRMS					;    fin parametrage
ELB 2					;    BODY ELAB
 hexa_show 'var elab DEFLIST ', $
VAR DEFLIST_disp, q				; variable record : pointeur aux data record
VAR DEFLIST__u, q				; variable record : pointeur aux useinfo
VAR DEFLIST__dat, STANDARD.IDL._SEQ_TYPE.size
	LVA	2, DEFLIST__dat
	Sa	2, DEFLIST_disp				; record fin
	LVA	2, STANDARD.IDL._SEQ_TYPE.SIZ
	Sa	2, DEFLIST__u
	La  2, DEFLIST_disp
	LI	STANDARD.IDL._SEQ_TYPE.size
VAR	ANON_44_29_disp, q
VAR	ANON_44_29__u,    q
VAR	ANON_44_29__dat, STANDARD.IDL._SEQ_TYPE.size
	LVA 2, ANON_44_29__dat
	Sa  2, ANON_44_29_disp
	La  0, STANDARD.IDL._SEQ_TYPE.use__info
	Sa  2, ANON_44_29__u
	LVA 2, ANON_44_29_disp
					; doublet resultat record anonyme
VAR	ANON_44_36_disp, q
VAR	ANON_44_36__u,    q
VAR	ANON_44_36__dat, STANDARD.IDL._TREE.size
	LVA 2, ANON_44_36__dat
	Sa  2, ANON_44_36_disp
	La  0, STANDARD.IDL._TREE.use__info
	Sa  2, ANON_44_36__u
	LVA 2, ANON_44_36_disp
					; doublet resultat record anonyme
	La  2,	-X_ofs
	CALL	STANDARD.IDL.IDL_MAN. ,STORE_SYM_L40
	CALL	STANDARD.IDL. ,LIST_L22
	La  ,  0
	BLKMOV

 hexa_show ' disp ', DEFLIST_disp
 hexa_show 'var elab DEF ', $
VAR DEF_disp, q				; variable record : pointeur aux data record
VAR DEF__u, q				; variable record : pointeur aux useinfo
VAR DEF__dat, STANDARD.IDL._TREE.size
	LVA	2, DEF__dat
	Sa	2, DEF_disp				; record fin
	LVA	2, STANDARD.IDL._TREE.SIZ
	Sa	2, DEF__u
	La  2, DEF_disp
					; store represented component PT range 0 .. 1 width 2
	DUP
	Ld
	LI	0
	LI	0
	LI	2
	BFI
	Sd

 hexa_show ' disp ', DEF_disp
					;    end elab
begin:					;---------- BDY INSTRUCTIONS
LOOP__1:
	LI	0					; lieu resultat sur pile
	LVA 2,	DEFLIST_disp
	CALL	STANDARD.IDL. ,IS_EMPTY_L23
	LI	1
	OUX
	BF	L6
	LVA  2,	STANDARD.IDL.SEM_PHASE_L11.SEM_GLOB.INITIALIZE_PREDEFINED_TYPES_L2.INIT_L3.DEF_disp
	LVA  2,	STANDARD.IDL.SEM_PHASE_L11.SEM_GLOB.INITIALIZE_PREDEFINED_TYPES_L2.INIT_L3.DEFLIST_disp
	CALL	STANDARD.IDL. ,POP_L24
					; debut if
; CODE record equality "=" _TREE
VAR	ANON_49_13_disp, q
VAR	ANON_49_13__u,    q
VAR	ANON_49_13__dat, STANDARD.IDL._TREE.size
	LVA 2, ANON_49_13__dat
	Sa  2, ANON_49_13_disp
	La  0, STANDARD.IDL._TREE.use__info
	Sa  2, ANON_49_13__u
	LVA 2, ANON_49_13_disp
					; doublet resultat record anonyme
	LVA 2,	DEF_disp
	LI  169
	CALL	STANDARD.IDL. ,D_L17
	La  ,  0
	Ld
	LVA 1,	STANDARD.IDL.SEM_PHASE_L11.SEM_GLOB.PREDEFINED_STANDARD_DEF_disp
	La  ,  0
	Ld
	CEQ
	BF	L8
; CODE_RETURN : EXPR TYPE = DN_RECORD  VUE COMPLETE = DN_RECORD
	La   2,	-result__ofs
	La  ,  0
	LI	STANDARD.IDL._TREE.size
VAR	ANON_50_9_disp, q
VAR	ANON_50_9__u,    q
VAR	ANON_50_9__dat, STANDARD.IDL._TREE.size
	LVA 2, ANON_50_9__dat
	Sa  2, ANON_50_9_disp
	La  0, STANDARD.IDL._TREE.use__info
	Sa  2, ANON_50_9__u
	LVA 2, ANON_50_9_disp
					; doublet resultat record anonyme
VAR	ANON_50_26_disp, q
VAR	ANON_50_26__u,    q
VAR	ANON_50_26__dat, STANDARD.IDL._TREE.size
	LVA 2, ANON_50_26__dat
	Sa  2, ANON_50_26_disp
	La  0, STANDARD.IDL._TREE.use__info
	Sa  2, ANON_50_26__u
	LVA 2, ANON_50_26_disp
					; doublet resultat record anonyme
	LVA 2,	DEF_disp
	LI  35
	CALL	STANDARD.IDL. ,D_L17
	LI  33
	CALL	STANDARD.IDL. ,D_L17
	La
	BLKMOV
	BRA ret_lbl
	BRA	L7
L8:
L7:					; post if
	BRA	LOOP__1
L6:					; post loop LOOP__1
; CODE_RETURN : EXPR TYPE = DN_RECORD  VUE COMPLETE = DN_RECORD
	La   2,	-result__ofs
	La  ,  0
	LI	STANDARD.IDL._TREE.size
	LVA 0,	STANDARD.IDL.TREE_VOID_disp
	La
	BLKMOV
	BRA ret_lbl
ret_lbl:
	UNLINK 2
	RTD	prm_siz-8
excep:
endPRO					;---------- end PRO INIT
end if

if defined SET_RANGE_BOUNDS_L9_
PRO	SET_RANGE_BOUNDS_L9			;---------- PRO SET_RANGE_BOUNDS
 hexa_show 'SET_RANGE_BOUNDS_L9 ', $
PRMS					;    debut parametrage
	PRM TYPE_NODE_ofs				; in
	PRM LOW_ofs				; out
	PRM HIGH_ofs				; out
endPRMS					;    fin parametrage
ELB 2					;    BODY ELAB
 hexa_show 'var elab RANGE_NODE ', $
VAR RANGE_NODE_disp, q			; variable record : pointeur aux data record
VAR RANGE_NODE__u, q			; variable record : pointeur aux useinfo
VAR RANGE_NODE__dat, STANDARD.IDL._TREE.size
	LVA	2, RANGE_NODE__dat
	Sa	2, RANGE_NODE_disp			; record fin
	LVA	2, STANDARD.IDL._TREE.SIZ
	Sa	2, RANGE_NODE__u
	La  2, RANGE_NODE_disp
					; store represented component PT range 0 .. 1 width 2
	DUP
	Ld
	LI	0
	LI	0
	LI	2
	BFI
	Sd

 hexa_show ' disp ', RANGE_NODE_disp
					;    end elab
begin:					;---------- BDY INSTRUCTIONS
					; debut if
; CODE record equality "/=" _TREE
	La  2,	-TYPE_NODE_ofs
	La  ,  0
	Ld
	LVA 0,	STANDARD.IDL.TREE_VOID_disp
	La  ,  0
	Ld
	CEQ
	LI	1
	OUX
	BF	L13
	LVA 2,	RANGE_NODE_disp
	La
	LI	STANDARD.IDL._TREE.size
VAR	ANON_66_23_disp, q
VAR	ANON_66_23__u,    q
VAR	ANON_66_23__dat, STANDARD.IDL._TREE.size
	LVA 2, ANON_66_23__dat
	Sa  2, ANON_66_23_disp
	La  0, STANDARD.IDL._TREE.use__info
	Sa  2, ANON_66_23__u
	LVA 2, ANON_66_23_disp
					; doublet resultat record anonyme
	La  2,	-TYPE_NODE_ofs
	LI  39
	CALL	STANDARD.IDL. ,D_L17
	La
	BLKMOV
	La  2,	-LOW_ofs
	La
	LI	STANDARD.IDL._TREE.size
	LI	0					; lieu resultat sur pile
VAR	ANON_67_42_disp, q
VAR	ANON_67_42__u,    q
VAR	ANON_67_42__dat, STANDARD.IDL._TREE.size
	LVA 2, ANON_67_42__dat
	Sa  2, ANON_67_42_disp
	La  0, STANDARD.IDL._TREE.use__info
	Sa  2, ANON_67_42__u
	LVA 2, ANON_67_42_disp
					; doublet resultat record anonyme
	LVA 2,	RANGE_NODE_disp
	LI  50
	CALL	STANDARD.IDL. ,D_L17
	CALL	STANDARD.IDL.SEM_PHASE_L11.EXPRESO. ,GET_STATIC_VALUE_L157
	La
	BLKMOV
	La  2,	-HIGH_ofs
	La
	LI	STANDARD.IDL._TREE.size
	LI	0					; lieu resultat sur pile
VAR	ANON_68_43_disp, q
VAR	ANON_68_43__u,    q
VAR	ANON_68_43__dat, STANDARD.IDL._TREE.size
	LVA 2, ANON_68_43__dat
	Sa  2, ANON_68_43_disp
	La  0, STANDARD.IDL._TREE.use__info
	Sa  2, ANON_68_43__u
	LVA 2, ANON_68_43_disp
					; doublet resultat record anonyme
	LVA 2,	RANGE_NODE_disp
	LI  51
	CALL	STANDARD.IDL. ,D_L17
	CALL	STANDARD.IDL.SEM_PHASE_L11.EXPRESO. ,GET_STATIC_VALUE_L157
	La
	BLKMOV
	BRA	L12
L13:
	La  2,	-LOW_ofs
	La
	LI	STANDARD.IDL._TREE.size
	LI	0					; lieu resultat sur pile
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	0
	CALL	STANDARD.IDL.SEM_PHASE_L11.UARITH. ,U_VAL_L21
	La
	BLKMOV
	La  2,	-HIGH_ofs
	La
	LI	STANDARD.IDL._TREE.size
	LI	0					; lieu resultat sur pile
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	0
	CALL	STANDARD.IDL.SEM_PHASE_L11.UARITH. ,U_VAL_L21
	La
	BLKMOV
L12:					; post if
ret_lbl:
	UNLINK 2
	RTD	prm_siz
excep:
endPRO					;---------- end PRO SET_RANGE_BOUNDS
end if

