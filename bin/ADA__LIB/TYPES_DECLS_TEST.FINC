PRO	TYPES_DECLS_TEST_L1			;---------- PRO TYPES_DECLS_TEST
ELB 1					;    BODY ELAB

					; COULEUR ENUMERATION TYPE INFO
COULEUR = 'COULEUR'
namespace COULEUR
BEGIN_BLOC_DEF
db 0, 4, "BLEU"
db 1, 5, "BLANC"
db 2, 5, "ROUGE"
db 3, 4, "VERT"
db 4, 4, "NOIR"
END_BLOC_DEF
IMAGES	BYTES_BLOC
CST LST, d, 4
CST FST, d, 0
CST SIZ, d, 8	; SIZ en bits !
postpone
  align_q
end postpone
VAR use__info, q
	LCA	SIZ
	Sa	1, use__info
end namespace

					; COULEUR_DRAPEAU ENUMERATION SUBTYPE INFO
COULEUR_DRAPEAU = 'COULEUR_DRAPEAU'
namespace COULEUR_DRAPEAU
VAR use__info, q
VAR SIZ, d
	LVA	1, SIZ
	Sa	1, use__info
VAR FST, b
VAR LST, b
	LI	8
	Sd	1, SIZ
	LI	0
	Sb	1, FST
	LI	2
	Sb	1, LST
VAR PARENT__u, q
	La	1, STANDARD.TYPES_DECLS_TEST_L1.COULEUR.use__info
	Sa	1, PARENT__u
end namespace

					; ENTIER_1 TYPE RANGE INFO
