					; U_MAT_1 UNCONSTRAINED ARRAY SUBTYPE INFO
U_MAT_1 = 'U_MAT_1'
namespace U_MAT_1
VAR use__info, q
VAR SIZ, d
	LVA	1, SIZ
	Sa	1, use__info
	LI	1
	NEG
	Sd	1, SIZ
  virtual at 4				 use info offsets pour acces sur array contraint

COMP_SIZ = $
	rd 1 
FST_2 = $
	rd 1 
LST_2 = $
	rd 1 
SIZ_1 = $
	rd 1 
FST_1 = $
	rd 1 
LST_1 = $
	rd 1 
  end virtual
end namespace

					; array decl constrained array type info
MATRICE_1 = 'MATRICE_1'
namespace MATRICE_1
VAR use__info, q
VAR SIZ, d
	LVA	1, SIZ
	Sa	1, use__info
VAR COMP_SIZ, d
VAR FST_2, d
VAR LST_2, d
	LI	64
	Sd	1, COMP_SIZ
	Ld	1, COMP_SIZ
	LI	0
	Sd	1, FST_2
	LI	9
	Sd	1, LST_2
	Ld	1, LST_2
	INC
	Ld	1, FST_2
	SUB
VAR SIZ_1, d
VAR FST_1, d
VAR LST_1, d
	MUL
	Sd	1, SIZ_1
	Ld	1, SIZ_1
	LI	1
	Sd	1, FST_1
	LI	10
	Sd	1, LST_1
	Ld	1, LST_1
	INC
	Ld	1, FST_1
	SUB
	MUL
	Sd	1, SIZ
  virtual at 4
COMP_SIZ = $
	rd 1 
FST_2 = $
	rd 1 
LST_2 = $
	rd 1 
SIZ_1 = $
	rd 1 
FST_1 = $
	rd 1 
LST_1 = $
	rd 1 
  end virtual
end namespace

					; SIMPLE_RECORD RECORD TYPE INFO
SIMPLE_RECORD = 'SIMPLE_RECORD'
namespace SIMPLE_RECORD
VAR use__info, q
VAR SIZ, d
	LVA	1, SIZ
	Sa	1, use__info
USEINFO 1, COMP_1, 	La 0, STANDARD.NATURAL.use__info
USEINFO 1, MAT, 	La 1, STANDARD.TYPES_DECLS_TEST_L1.MATRICE_1.use__info
virtual at 0				; calcul des offsets statiques
STATOFS COMP_1, 4
STATOFS MAT, 800
size = $
	LI	 size* 8
end virtual
	Sd	1, SIZ
end namespace

					; DISCRIM_RECORD_2 RECORD TYPE INFO
DISCRIM_RECORD_2 = 'DISCRIM_RECORD_2'
namespace DISCRIM_RECORD_2
VAR use__info, q
VAR SIZ, d
	LVA	1, SIZ
	Sa	1, use__info
USEINFO 1, DX, 	La 0, STANDARD.INTEGER.use__info
USEINFO 1, DY, 	La 0, STANDARD.INTEGER.use__info
USEINFO 1, COMP_1, 	La 0, STANDARD.NATURAL.use__info
USEINFO 1, MAT, 	La 1, STANDARD.TYPES_DECLS_TEST_L1.MATRICE_1.use__info
virtual at 0				; calcul des offsets statiques
	LI 0	 ; offset a faire
	Sd	1, DX__o
	LI 0	 ; offset a faire
	Sd	1, DY__o
STATOFS COMP_1, 4
STATOFS MAT, 800
size = $
	LI	 size* 8
end virtual
	Sd	1, SIZ
end namespace

					; DISCRIM_RECORD RECORD TYPE INFO
DISCRIM_RECORD = 'DISCRIM_RECORD'
namespace DISCRIM_RECORD
VAR use__info, q
VAR SIZ, d
	LVA	1, SIZ
	Sa	1, use__info
USEINFO 1, DX, 	La 0, STANDARD.NATURAL.use__info
USEINFO 1, DY, 	La 0, STANDARD.NATURAL.use__info
USEINFO 1, INFO, 	La 0, STANDARD.INTEGER.use__info
MAT = 'MAT'
 namespace U_MAT_1
VAR use__info, q
VAR SIZ, d
	LVA	1, SIZ
	Sa	1, use__info
VAR COMP_SIZ, d
VAR FST_2, d
VAR LST_2, d
	LI	32
	Sd	1, COMP_SIZ
	Ld	1, COMP_SIZ
	LI	1
	Sd	1, FST_2
; CODE_USED_OBJECT_ID : DISCRIMINANT_ID a faire 
	Sd	1, LST_2
	Ld	1, LST_2
	INC
	Ld	1, FST_2
	SUB
VAR SIZ_1, d
VAR FST_1, d
VAR LST_1, d
	MUL
	Sd	1, SIZ_1
	Ld	1, SIZ_1
	LI	1
	Sd	1, FST_1
; CODE_USED_OBJECT_ID : DISCRIMINANT_ID a faire 
	Sd	1, LST_1
	Ld	1, LST_1
	INC
	Ld	1, FST_1
	SUB
	MUL
	Sd	1, SIZ
  virtual at 4
COMP_SIZ = $
	rd 1 
FST_2 = $
	rd 1 
LST_2 = $
	rd 1 
SIZ_1 = $
	rd 1 
FST_1 = $
	rd 1 
LST_1 = $
	rd 1 
  end virtual
end namespace
USEINFO 1, MAT, 	La 1, STANDARD.TYPES_DECLS_TEST_L1.U_MAT_1.use__info
virtual at 0				; calcul des offsets statiques
	LI 0	 ; offset a faire
	Sd	1, DX__o
	LI 0	 ; offset a faire
	Sd	1, DY__o
STATOFS INFO, 4
STATOFS MAT, 1
size = $
	LI	 size* 8
end virtual
	Sd	1, SIZ
end namespace
;  CODE_SUBTYPE_DECL : TYPE_SPEC.TY PAS FAIT DN_CONSTRAINED_RECORD

					; REC_RECORD RECORD TYPE INFO
REC_RECORD = 'REC_RECORD'
namespace REC_RECORD
VAR use__info, q
VAR SIZ, d
	LVA	1, SIZ
	Sa	1, use__info
USEINFO 1, L, 	La 0, STANDARD.NATURAL.use__info
USEINFO 1, DX, 	La 0, STANDARD.NATURAL.use__info
USEINFO 1, DY, 	La 0, STANDARD.NATURAL.use__info
USEINFO 1, CHAMP, 	La 0, STANDARD.INTEGER.use__info
USEINFO 1, SOUS_REC, 	La 0, STANDARD.TYPES_DECLS_TEST_L1.DISCRIM_RECORD.use__info
virtual at 0				; calcul des offsets statiques
	LI 0	 ; offset a faire
	Sd	1, L__o
	LI 0	 ; offset a faire
	Sd	1, DX__o
	LI 0	 ; offset a faire
	Sd	1, DY__o
STATOFS CHAMP, 4
STATOFS SOUS_REC, 1
size = $
	LI	 size* 8
end virtual
	Sd	1, SIZ
end namespace
