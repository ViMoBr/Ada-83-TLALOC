	ULb	1, STANDARD.EXPANDER_L1.UTILS.DEBUG_disp
	BF	L1709
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	1
	DUP
	ULd	0, STANDARD.TEXT_IO._POSITIVE_COUNT.FST
	CLT
	BT	STANDARD.ce_raise_
	DUP
	ULd	0, STANDARD.TEXT_IO._POSITIVE_COUNT.LST
	CGT
	BT	STANDARD.ce_raise_
	CALL	STANDARD.TEXT_IO. ,NEW_LINE_L26
	BRA	L1708
L1709:
L1708:					; post if
	LVA	1, STANDARD.EXPANDER_L1.UTILS.NO_SUBP_PARAMS_disp
	ULb 1,	SAVE_NO_SUB_PARAM_disp
	Sb
	LVA	1, STANDARD.EXPANDER_L1.UTILS.IN_GENERIC_INSTANTIATION_disp
	ULb 1,	SAVE_IN_GENERIC_INSTANTIATION_disp
	Sb
	La 1, STANDARD.EXPANDER_L1.UTILS.INSTANTIATION_MODEL_NAME_disp
	LI	STANDARD.IDL._TREE.size
	LVA 1,	SAVE_INSTANTIATION_MODEL_NAME_disp
	La
	BLKMOV
	LVA	1, STANDARD.EXPANDER_L1.UTILS.OUTPUT_CODE_disp
	ULb 1,	SAVE_OUTPUT_CODE_disp
	Sb
ret_lbl:
	UNLINK 1
	RTD	prm_siz
excep:
endPRO					;---------- end PRO CODE_PACKAGE_DECL
end if

