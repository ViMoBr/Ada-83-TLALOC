if ~ definite TEXT_IO
include 'TEXT_IO.FINC'
display 'including withed unit TEXT_IO.FINC', 10
end if
if ~ definite IO_EXCEPTIONS
include 'IO_EXCEPTIONS.FINC'
display 'including trans withed unit IO_EXCEPTIONS.FINC', 10
end if
if ~ definite TEXT_IO
include 'TEXT_IO.FINC'
display 'including trans withed unit TEXT_IO.FINC', 10
end if
GET_LINE = 'GET_LINE'
PRO	GET_LINE_L1
 hexa_show 'GET_LINE_L1 ', $
ELB 1
 hexa_show 'var elab S ', $
_S__type = '_S__type'
namespace _S__type
VAR use__info, Q
VAR SIZ__, D
	LVA	1, SIZ__
	SA	1, use__info
VAR _COMP_SIZ, D
VAR _FST_1, D
VAR _LST_1, D
	LI	8
	SD	1, _COMP_SIZ
	LD	1, _COMP_SIZ
	LI	1
	SD	1, _FST_1
	LI	64
	SD	1, _LST_1
	LD	1, _LST_1
	LD	1, _FST_1
	SUB
	INC
	CLAMP0
	MUL
	SD	1, SIZ__
  virtual at 4
COMP_SIZ = $
	rd 1 
FST_1 = $
	rd 1 
LST_1 = $
	rd 1 
  end virtual
end namespace
VAR S_disp, Q
VAR S__u, Q
	LA 1, _S__type.use__info
	SA	1, S__u
	LD	1, _S__type.SIZ__
	LI	8
	DIV
	CO_VAR
	SA	1, S_disp

 hexa_show ' disp ', S_disp
 hexa_show 'var elab LAST ', $
VAR LAST_disp, D

 hexa_show ' disp ', LAST_disp

begin:
STR STR_L4, "Ligne : "
	LCA	STR_L4.data_ptr
	CALL	STANDARD.TEXT_IO. ,PUT_L56
	LVA  1,	STANDARD.GET_LINE_L1.LAST_disp
	LVA  1,	STANDARD.GET_LINE_L1.S_disp
	CALL	STANDARD.TEXT_IO. ,GET_LINE_L58
STR STR_L5, "Recu : "
	LCA	STR_L5.data_ptr
	CALL	STANDARD.TEXT_IO. ,PUT_L56
	LA 1, STANDARD.GET_LINE_L1.S_disp
	LI	1
	LID 1, STANDARD.GET_LINE_L1.S__u, STANDARD._STRING.FST_1
	SUB
	LI	1
	MUL
	ADD
namespace ANON_13_13
VAR ANON_13_13_disp, Q
VAR ANON_13_13__u, Q
VAR SIZ__, D
VAR COMP_SIZ, D
VAR _FST_1, D
VAR _LST_1, D
	SA	1, ANON_13_13_disp
	LVA	1, SIZ__
	SA	1, ANON_13_13__u
	LI	8
	SD	1, COMP_SIZ
	LI	1
	SD	1, _FST_1
	LD 1,	LAST_disp
	SD	1, _LST_1
	LD	1, _LST_1
	LD	1, _FST_1
	SUB
	INC
	CLAMP0
	LI	8
	MUL
	SD	1, SIZ__
	LVA	1, ANON_13_13_disp
end namespace
	CALL	STANDARD.TEXT_IO. ,PUT_LINE_L60
ret_lbl:
	UNLINKR 1
	RTD
excep:
endPRO
