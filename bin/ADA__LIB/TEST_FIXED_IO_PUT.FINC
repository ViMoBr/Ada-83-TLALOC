	LI	 1
	LI	000536870912
	LI	 2
	CVTIX
	CALL	STANDARD.TEST_FIXED_IO_PUT_L1.DUR_IO. ,PUT_L5
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	1
	CALL	STANDARD.TEXT_IO. ,NEW_LINE_L26
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	0
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	6
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	1
; CODE_QUALIFIED : DN_QUALIFIEDDN_NUMERIC_LITERAL
; CODE_NUMERIC_LITERAL DN_FIXED
	LI	 51
	LI	000536870912
	LI	 4
	CVTIX
	CALL	STANDARD.TEST_FIXED_IO_PUT_L1.DUR_IO. ,PUT_L5
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	1
	CALL	STANDARD.TEXT_IO. ,NEW_LINE_L26
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	0
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	6
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	1
; CODE_QUALIFIED : DN_QUALIFIEDDN_FUNCTION_CALL
	LI	-51
	LI	000536870912
	LI	 4
	CVTIX
	CALL	STANDARD.TEST_FIXED_IO_PUT_L1.DUR_IO. ,PUT_L5
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	1
	CALL	STANDARD.TEXT_IO. ,NEW_LINE_L26
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	0
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	6
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	1
; CODE_QUALIFIED : DN_QUALIFIEDDN_NUMERIC_LITERAL
; CODE_NUMERIC_LITERAL DN_FIXED
	LI	00345599
	LI	000536870912
	LI	 4
	CVTIX
	CALL	STANDARD.TEST_FIXED_IO_PUT_L1.DUR_IO. ,PUT_L5
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	1
	CALL	STANDARD.TEXT_IO. ,NEW_LINE_L26
ret_lbl:
	UNLINK 1
	RTD
excep:
endPRO					;---------- end PRO TEST_FIXED_IO_PUT
