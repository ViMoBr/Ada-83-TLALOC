if ~ definite TEXT_IO
include 'TEXT_IO.FINC'
end if
PRO	TEST_FIXED_IO_PUT_L1			;---------- PRO TEST_FIXED_IO_PUT
ELB 1					;    BODY ELAB
DUR_IO = 'DUR_IO'
namespace DUR_IO				;---------- GENERIC PACKAGE INSTANTIATION
elab_spec:				;    SPEC ELAB

BRA post_LD_DURATION
LD_DURATION.elab:
	Lq -1, 0
	RTD 0
post_LD_DURATION:
BRA post_ST_DURATION
ST_DURATION.elab:
	Sq -1, 0
	RTD 0
post_ST_DURATION:
BRA post_INADR_DURATION
INADR_DURATION.elab:
	RTD 0
post_INADR_DURATION:
BRA post_OUTADR_DURATION
OUTADR_DURATION.elab:
	La
	RTD 0
post_OUTADR_DURATION:
VAR DURATION__outadr_ofs, q
	LCA OUTADR_DURATION.elab
	Sa	 1, DURATION__outadr_ofs
VAR DURATION__inadr_ofs, q
	LCA INADR_DURATION.elab
	Sa	 1, DURATION__inadr_ofs
VAR DURATION__st_ofs, q
	LCA ST_DURATION.elab
	Sa	 1, DURATION__st_ofs
VAR DURATION__ld_ofs, q
	LCA LD_DURATION.elab
	Sa	 1, DURATION__ld_ofs
VAR DURATION__u_ofs, q
	La	 0, STANDARD.DURATION.use__info
	Sa	 1, DURATION__u_ofs
VAR GFP_disp, q				; Lieu du Generic Frame Pointer 
VAR DEFAULT_FORE_disp, d			; variable entiere
	LI	1
	Sd  1,	DEFAULT_FORE_disp

VAR DEFAULT_AFT_disp, d			; variable entiere
	LI	3
	Sd  1,	DEFAULT_AFT_disp

VAR DEFAULT_EXP_disp, d			; variable entiere
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	0
	Sd  1,	DEFAULT_EXP_disp

if defined GET_L2_
PRO	GET_L2				;---------- PRO GET
PRMS					;    debut parametrage
	PRM FILE_ofs				; in
	PRM ITEM_ofs				; out
	PRM WIDTH_ofs				; in
endPRMS					;    fin parametrage
ELB 2
begin:
	LVA	 1, GFP_disp
	Ld	 2, -WIDTH_ofs
	La 	 2, -ITEM_ofs
	La 	 2, -FILE_ofs
	CALL	STANDARD.TEXT_IO.FIXED_IO. ,GET_L73
	UNLINK	 2
	RTD	prm_siz
endPRO					;---------- end PRO GET
end if
if defined GET_L3_
PRO	GET_L3				;---------- PRO GET
PRMS					;    debut parametrage
	PRM ITEM_ofs				; out
	PRM WIDTH_ofs				; in
endPRMS					;    fin parametrage
ELB 2
begin:
	LVA	 1, GFP_disp
	Ld	 2, -WIDTH_ofs
	La 	 2, -ITEM_ofs
	CALL	STANDARD.TEXT_IO.FIXED_IO. ,GET_L74
	UNLINK	 2
	RTD	prm_siz
endPRO					;---------- end PRO GET
end if
if defined PUT_L4_
PRO	PUT_L4				;---------- PRO PUT
PRMS					;    debut parametrage
	PRM FILE_ofs				; in
	PRM ITEM_ofs				; in
	PRM FORE_ofs				; in
	PRM AFT_ofs				; in
	PRM EXP_ofs				; in
endPRMS					;    fin parametrage
ELB 2
begin:
	LVA	 1, GFP_disp
	Ld	 2, -EXP_ofs
	Ld	 2, -AFT_ofs
	Ld	 2, -FORE_ofs
	Lq	 2, -ITEM_ofs
	La 	 2, -FILE_ofs
	CALL	STANDARD.TEXT_IO.FIXED_IO. ,PUT_L75
	UNLINK	 2
	RTD	prm_siz
endPRO					;---------- end PRO PUT
end if
if defined PUT_L5_
PRO	PUT_L5				;---------- PRO PUT
PRMS					;    debut parametrage
	PRM ITEM_ofs				; in
	PRM FORE_ofs				; in
	PRM AFT_ofs				; in
	PRM EXP_ofs				; in
endPRMS					;    fin parametrage
ELB 2
begin:
	LVA	 1, GFP_disp
	Ld	 2, -EXP_ofs
	Ld	 2, -AFT_ofs
	Ld	 2, -FORE_ofs
	Lq	 2, -ITEM_ofs
	CALL	STANDARD.TEXT_IO.FIXED_IO. ,PUT_L76
	UNLINK	 2
	RTD	prm_siz
endPRO					;---------- end PRO PUT
end if
if defined GET_L6_
PRO	GET_L6				;---------- PRO GET
PRMS					;    debut parametrage
	PRM FROM_ofs				; in
	PRM ITEM_ofs				; out
	PRM LAST_ofs				; out
endPRMS					;    fin parametrage
ELB 2
begin:
	LVA	 1, GFP_disp
	La 	 2, -LAST_ofs
	La 	 2, -ITEM_ofs
	La 	 2, -FROM_ofs
	CALL	STANDARD.TEXT_IO.FIXED_IO. ,GET_L77
	UNLINK	 2
	RTD	prm_siz
endPRO					;---------- end PRO GET
end if
if defined PUT_L7_
PRO	PUT_L7				;---------- PRO PUT
PRMS					;    debut parametrage
	PRM TO_ofs				; out
	PRM ITEM_ofs				; in
	PRM AFT_ofs				; in
	PRM EXP_ofs				; in
endPRMS					;    fin parametrage
ELB 2
begin:
	LVA	 1, GFP_disp
	Ld	 2, -EXP_ofs
	Ld	 2, -AFT_ofs
	Lq	 2, -ITEM_ofs
	La 	 2, -TO_ofs
	CALL	STANDARD.TEXT_IO.FIXED_IO. ,PUT_L78
	UNLINK	 2
	RTD	prm_siz
endPRO					;---------- end PRO PUT
end if
					;---------- end generic package instantiation DUR_IO
end namespace

					;    end elab
begin:					;---------- BDY INSTRUCTIONS
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	0
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	6
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	1
; CODE_QUALIFIED : DN_QUALIFIEDDN_NUMERIC_LITERAL
; CODE_NUMERIC_LITERAL DN_FIXED
	LI	 0
	LI	000536870912
	LI	 1
	CVTIX
	CALL	STANDARD.TEST_FIXED_IO_PUT_L1.DUR_IO. ,PUT_L5
