	PRM FORE_ofs				; in
	PRM AFT_ofs				; in
	PRM EXP_ofs				; in
endPRMS					;    fin parametrage
ELB 2
begin:
	LVA	 1, GFP_disp
	Ld	 2, -EXP_ofs
	Ld	 2, -AFT_ofs
	Ld	 2, -FORE_ofs
	Lq	 2, -ITEM_ofs
	CALL	STANDARD.TEXT_IO.FLOAT_IO. ,PUT_L70
	UNLINK	 2
	RTD	prm_siz
endPRO					;---------- end PRO PUT
end if
					; sub program entry decl (in instantiation TRUE )
if defined GET_L6_
PRO	GET_L6				;---------- PRO GET
 hexa_show 'GET_L6 ', $
PRMS					;    debut parametrage
	PRM FROM_ofs				; in
	PRM ITEM_ofs				; out
	PRM LAST_ofs				; out
endPRMS					;    fin parametrage
ELB 2
begin:
	LVA	 1, GFP_disp
	La 	 2, -LAST_ofs
	La 	 2, -ITEM_ofs
	La 	 2, -FROM_ofs
	CALL	STANDARD.TEXT_IO.FLOAT_IO. ,GET_L71
	UNLINK	 2
	RTD	prm_siz
endPRO					;---------- end PRO GET
end if
					; sub program entry decl (in instantiation TRUE )
if defined PUT_L7_
PRO	PUT_L7				;---------- PRO PUT
 hexa_show 'PUT_L7 ', $
PRMS					;    debut parametrage
	PRM TO_ofs				; out
	PRM ITEM_ofs				; in
	PRM AFT_ofs				; in
	PRM EXP_ofs				; in
endPRMS					;    fin parametrage
ELB 2
begin:
	LVA	 1, GFP_disp
	Ld	 2, -EXP_ofs
	Ld	 2, -AFT_ofs
	Lq	 2, -ITEM_ofs
	La 	 2, -TO_ofs
	CALL	STANDARD.TEXT_IO.FLOAT_IO. ,PUT_L72
	UNLINK	 2
	RTD	prm_siz
endPRO					;---------- end PRO PUT
end if
					;---------- end generic package instantiation FIO
end namespace

