include 'TEXT_IO.FINC'
PRO	FLOAT_TEST_L1				;---------- PRO FLOAT_TEST
ELB 1					;    BODY ELAB
FIO = 'FIO'
namespace FIO				;---------- GENERIC PACKAGE INSTANTIATION
elab_spec:				;    SPEC ELAB

VAR GFP_disp, q
VAR DEFAULT_FORE_disp, d			; variable entiere
	LI	2
	Sd  1,	DEFAULT_FORE_disp

VAR DEFAULT_AFT_disp, d			; variable entiere
; CODE_ATTRIBUTE DIGITS : PREFIX PAS TYPE_ID
	LI	1
	SUB
	Sd  1,	DEFAULT_AFT_disp

VAR DEFAULT_EXP_disp, d			; variable entiere
	LI	3
	Sd  1,	DEFAULT_EXP_disp

if defined GET_L67_
PRO	GET_L67				;---------- PRO GET
PRMS					;    debut parametrage
	PRM FILE_ofs				; in
	PRM ITEM_ofs				; out
	PRM WIDTH_ofs				; in
endPRMS					;    fin parametrage
ELB 2
begin:
	LVA	 2, GFP_disp
	Lq	 2, -WIDTH_ofs
	Lq	 2, -ITEM_ofs
	Lq	 2, -FILE_ofs
	CALL	STANDARD.TEXT_IO.FLOAT_IO. ,GET_L67
	UNLINK	 2
	RTD	prm_siz
endPRO					;---------- end PRO GET
end if
if defined GET_L68_
PRO	GET_L68				;---------- PRO GET
PRMS					;    debut parametrage
	PRM ITEM_ofs				; out
	PRM WIDTH_ofs				; in
endPRMS					;    fin parametrage
ELB 2
begin:
	LVA	 2, GFP_disp
	Lq	 2, -WIDTH_ofs
	Lq	 2, -ITEM_ofs
	CALL	STANDARD.TEXT_IO.FLOAT_IO. ,GET_L68
	UNLINK	 2
	RTD	prm_siz
endPRO					;---------- end PRO GET
end if
if defined PUT_L69_
PRO	PUT_L69				;---------- PRO PUT
PRMS					;    debut parametrage
	PRM FILE_ofs				; in
	PRM ITEM_ofs				; in
	PRM FORE_ofs				; in
	PRM AFT_ofs				; in
	PRM EXP_ofs				; in
endPRMS					;    fin parametrage
ELB 2
begin:
	LVA	 2, GFP_disp
	Lq	 2, -EXP_ofs
	Lq	 2, -AFT_ofs
	Lq	 2, -FORE_ofs
	Lq	 2, -ITEM_ofs
	Lq	 2, -FILE_ofs
	CALL	STANDARD.TEXT_IO.FLOAT_IO. ,PUT_L69
	UNLINK	 2
	RTD	prm_siz
endPRO					;---------- end PRO PUT
end if
if defined PUT_L70_
PRO	PUT_L70				;---------- PRO PUT
PRMS					;    debut parametrage
	PRM ITEM_ofs				; in
	PRM FORE_ofs				; in
	PRM AFT_ofs				; in
	PRM EXP_ofs				; in
endPRMS					;    fin parametrage
ELB 2
begin:
	LVA	 2, GFP_disp
	Lq	 2, -EXP_ofs
	Lq	 2, -AFT_ofs
	Lq	 2, -FORE_ofs
	Lq	 2, -ITEM_ofs
	CALL	STANDARD.TEXT_IO.FLOAT_IO. ,PUT_L70
	UNLINK	 2
	RTD	prm_siz
endPRO					;---------- end PRO PUT
end if
if defined GET_L71_
PRO	GET_L71				;---------- PRO GET
PRMS					;    debut parametrage
	PRM FROM_ofs				; in
	PRM ITEM_ofs				; out
	PRM LAST_ofs				; out
endPRMS					;    fin parametrage
ELB 2
begin:
	LVA	 2, GFP_disp
	Lq	 2, -LAST_ofs
	Lq	 2, -ITEM_ofs
	Lq	 2, -FROM_ofs
	CALL	STANDARD.TEXT_IO.FLOAT_IO. ,GET_L71
	UNLINK	 2
	RTD	prm_siz
endPRO					;---------- end PRO GET
end if
if defined PUT_L72_
PRO	PUT_L72				;---------- PRO PUT
PRMS					;    debut parametrage
	PRM TO_ofs				; out
	PRM ITEM_ofs				; in
	PRM AFT_ofs				; in
	PRM EXP_ofs				; in
endPRMS					;    fin parametrage
ELB 2
begin:
	LVA	 2, GFP_disp
	Lq	 2, -EXP_ofs
	Lq	 2, -AFT_ofs
	Lq	 2, -ITEM_ofs
	Lq	 2, -TO_ofs
	CALL	STANDARD.TEXT_IO.FLOAT_IO. ,PUT_L72
	UNLINK	 2
	RTD	prm_siz
endPRO					;---------- end PRO PUT
end if
					;---------- end generic package instantiation FIO
end namespace

VAR X_disp, q				; variable flottante

VAR Y_disp, q				; variable flottante

VAR Z_disp, q				; variable flottante

					;    end elab
begin:					;---------- BDY INSTRUCTIONS
STR STR_L8, '=== 1. Constantes ==='		; constante string='=== 1. Constantes ==='
	LCA	STR_L8.data_ptr
	CALL	STANDARD.TEXT_IO. ,PUT_LINE_L60
	LI	3
	LI	5
	LI	2
	LIF	3.14159
	CALL	STANDARD.FLOAT_TEST_L1.FIO. ,PUT_L70
	LI	1
	CALL	STANDARD.TEXT_IO. ,NEW_LINE_L26
	LI	3
	LI	5
	LI	2
	LIF	3.14159
	FNEG
	CALL	STANDARD.FLOAT_TEST_L1.FIO. ,PUT_L70
	LI	1
	CALL	STANDARD.TEXT_IO. ,NEW_LINE_L26
	LI	3
	LI	5
	LI	2
	LIF	0.0
	CALL	STANDARD.FLOAT_TEST_L1.FIO. ,PUT_L70
	LI	1
	CALL	STANDARD.TEXT_IO. ,NEW_LINE_L26
	LI	3
	LI	5
	LI	2
	LIF	1.0
	CALL	STANDARD.FLOAT_TEST_L1.FIO. ,PUT_L70
	LI	1
	CALL	STANDARD.TEXT_IO. ,NEW_LINE_L26
STR STR_L9, '=== 2. Arithmetique ==='		; constante string='=== 2. Arithmetique ==='
	LCA	STR_L9.data_ptr
	CALL	STANDARD.TEXT_IO. ,PUT_LINE_L60
	LIF	2.5
	Sq  1,	X_disp
	LIF	3.0
	Sq  1,	Y_disp
	Lq 1,	X_disp
	Lq 1,	Y_disp
	FADD
	Sq  1,	Z_disp
	LI	3
	LI	2
	LI	2
	Lq 1,	Z_disp
	CALL	STANDARD.FLOAT_TEST_L1.FIO. ,PUT_L70
	LI	1
	CALL	STANDARD.TEXT_IO. ,NEW_LINE_L26
	Lq 1,	X_disp
	Lq 1,	Y_disp
	FSUB
	Sq  1,	Z_disp
	LI	3
	LI	2
	LI	2
	Lq 1,	Z_disp
	CALL	STANDARD.FLOAT_TEST_L1.FIO. ,PUT_L70
	LI	1
	CALL	STANDARD.TEXT_IO. ,NEW_LINE_L26
	Lq 1,	X_disp
	Lq 1,	Y_disp
	FMUL
	Sq  1,	Z_disp
	LI	3
	LI	2
	LI	2
	Lq 1,	Z_disp
	CALL	STANDARD.FLOAT_TEST_L1.FIO. ,PUT_L70
	LI	1
	CALL	STANDARD.TEXT_IO. ,NEW_LINE_L26
	Lq 1,	X_disp
	Lq 1,	Y_disp
	FDIV
	Sq  1,	Z_disp
	LI	3
	LI	4
	LI	2
	Lq 1,	Z_disp
	CALL	STANDARD.FLOAT_TEST_L1.FIO. ,PUT_L70
	LI	1
	CALL	STANDARD.TEXT_IO. ,NEW_LINE_L26
STR STR_L10, '=== 3. Negation et abs ==='	; constante string='=== 3. Negation et abs ==='
	LCA	STR_L10.data_ptr
	CALL	STANDARD.TEXT_IO. ,PUT_LINE_L60
	LIF	7.5
	FNEG
	Sq  1,	X_disp
	LI	3
	LI	2
	LI	2
	Lq 1,	X_disp
	CALL	STANDARD.FLOAT_TEST_L1.FIO. ,PUT_L70
	LI	1
	CALL	STANDARD.TEXT_IO. ,NEW_LINE_L26
	LI	3
	LI	2
	LI	2
	Lq 1,	X_disp
	FNEG
	CALL	STANDARD.FLOAT_TEST_L1.FIO. ,PUT_L70
	LI	1
	CALL	STANDARD.TEXT_IO. ,NEW_LINE_L26
	LI	3
	LI	2
	LI	2
	Lq 1,	X_disp
	FABS
	CALL	STANDARD.FLOAT_TEST_L1.FIO. ,PUT_L70
	LI	1
	CALL	STANDARD.TEXT_IO. ,NEW_LINE_L26
STR STR_L11, '=== 4. Comparaisons ==='		; constante string='=== 4. Comparaisons ==='
	LCA	STR_L11.data_ptr
	CALL	STANDARD.TEXT_IO. ,PUT_LINE_L60
	LIF	1.0
	Sq  1,	X_disp
	LIF	2.0
	Sq  1,	Y_disp
					; debut if
	Lq 1,	X_disp
	Lq 1,	Y_disp
	FCLT
	BF	L13
STR STR_L14, '1.0 < 2.0 : OK'			; constante string='1.0 < 2.0 : OK'
	LCA	STR_L14.data_ptr
	CALL	STANDARD.TEXT_IO. ,PUT_LINE_L60
	BRA	L12
L13:
L12:					; post if
					; debut if
	Lq 1,	Y_disp
	Lq 1,	X_disp
	FCGT
	BF	L16
STR STR_L17, '2.0 > 1.0 : OK'			; constante string='2.0 > 1.0 : OK'
	LCA	STR_L17.data_ptr
	CALL	STANDARD.TEXT_IO. ,PUT_LINE_L60
	BRA	L15
L16:
L15:					; post if
					; debut if
	Lq 1,	X_disp
	Lq 1,	X_disp
	FCLE
	BF	L19
STR STR_L20, '1.0 <= 1.0 : OK'		; constante string='1.0 <= 1.0 : OK'
	LCA	STR_L20.data_ptr
	CALL	STANDARD.TEXT_IO. ,PUT_LINE_L60
	BRA	L18
L19:
L18:					; post if
					; debut if
	Lq 1,	X_disp
	Lq 1,	X_disp
	FCGE
	BF	L22
STR STR_L23, '1.0 >= 1.0 : OK'		; constante string='1.0 >= 1.0 : OK'
	LCA	STR_L23.data_ptr
	CALL	STANDARD.TEXT_IO. ,PUT_LINE_L60
	BRA	L21
L22:
L21:					; post if
					; debut if
	Lq 1,	X_disp
	Lq 1,	Y_disp
	FCNE
	BF	L25
STR STR_L26, '1.0 /= 2.0 : OK'		; constante string='1.0 /= 2.0 : OK'
	LCA	STR_L26.data_ptr
	CALL	STANDARD.TEXT_IO. ,PUT_LINE_L60
	BRA	L24
L25:
L24:					; post if
	LIF	2.0
	Sq  1,	X_disp
					; debut if
	Lq 1,	X_disp
	Lq 1,	Y_disp
	FCEQ
	BF	L28
STR STR_L29, '2.0 = 2.0 : OK'			; constante string='2.0 = 2.0 : OK'
	LCA	STR_L29.data_ptr
	CALL	STANDARD.TEXT_IO. ,PUT_LINE_L60
	BRA	L27
L28:
L27:					; post if
STR STR_L30, '=== 5. Negatifs ==='		; constante string='=== 5. Negatifs ==='
	LCA	STR_L30.data_ptr
	CALL	STANDARD.TEXT_IO. ,PUT_LINE_L60
	LIF	1.0
	FNEG
	Sq  1,	X_disp
	LIF	2.0
	FNEG
	Sq  1,	Y_disp
					; debut if
	Lq 1,	X_disp
	Lq 1,	Y_disp
	FCGT
	BF	L32
STR STR_L33, '-1.0 > -2.0 : OK'		; constante string='-1.0 > -2.0 : OK'
	LCA	STR_L33.data_ptr
	CALL	STANDARD.TEXT_IO. ,PUT_LINE_L60
	BRA	L31
L32:
L31:					; post if
					; debut if
	Lq 1,	Y_disp
	Lq 1,	X_disp
	FCLT
	BF	L35
STR STR_L36, '-2.0 < -1.0 : OK'		; constante string='-2.0 < -1.0 : OK'
	LCA	STR_L36.data_ptr
	CALL	STANDARD.TEXT_IO. ,PUT_LINE_L60
	BRA	L34
L35:
L34:					; post if
STR STR_L37, '=== 6. Conversion ==='		; constante string='=== 6. Conversion ==='
	LCA	STR_L37.data_ptr
	CALL	STANDARD.TEXT_IO. ,PUT_LINE_L60
	LI	42
	CVTIF
	Sq  1,	X_disp
	LI	3
	LI	1
	LI	2
	Lq 1,	X_disp
	CALL	STANDARD.FLOAT_TEST_L1.FIO. ,PUT_L70
	LI	1
	CALL	STANDARD.TEXT_IO. ,NEW_LINE_L26
STR STR_L38, '=== 7. Grands/petits ==='		; constante string='=== 7. Grands/petits ==='
	LCA	STR_L38.data_ptr
	CALL	STANDARD.TEXT_IO. ,PUT_LINE_L60
	LIF	123456.789
	Sq  1,	X_disp
	LI	3
	LI	6
	LI	2
	Lq 1,	X_disp
	CALL	STANDARD.FLOAT_TEST_L1.FIO. ,PUT_L70
	LI	1
	CALL	STANDARD.TEXT_IO. ,NEW_LINE_L26
	LIF	0.000123
	Sq  1,	X_disp
	LI	3
	LI	6
	LI	2
	Lq 1,	X_disp
	CALL	STANDARD.FLOAT_TEST_L1.FIO. ,PUT_L70
	LI	1
	CALL	STANDARD.TEXT_IO. ,NEW_LINE_L26
STR STR_L39, '=== FIN ==='			; constante string='=== FIN ==='
	LCA	STR_L39.data_ptr
	CALL	STANDARD.TEXT_IO. ,PUT_LINE_L60
ret_lbl:
	UNLINK 1
	RTD
excep:
endPRO					;---------- end PRO FLOAT_TEST
