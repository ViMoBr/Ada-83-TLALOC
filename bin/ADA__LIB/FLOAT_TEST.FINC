begin:					;---------- BDY INSTRUCTIONS
STR STR_L10, "=== 1. Constantes ==="		; constante string="=== 1. Constantes ==="
	LCA	STR_L10.data_ptr
	CALL	STANDARD.TEXT_IO. ,PUT_LINE_L60
