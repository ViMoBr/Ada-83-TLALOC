TEST_TROU = 'TEST_TROU'
PRO	TEST_TROU_L1				;---------- PRO TEST_TROU
 hexa_show 'TEST_TROU_L1 ', $
ELB 1					;    BODY ELAB
 hexa_show 'var elab B ', $
VAR B_disp, b				; variable bool char enum

 hexa_show ' disp ', B_disp
					;    end elab
begin:					;---------- BDY INSTRUCTIONS
; !! TROU CODE_ATTRIBUTE : DN_ATTRIBUTE
	Sb  1,	B_disp
ret_lbl:
	UNLINK 1
	RTD
excep:
endPRO					;---------- end PRO TEST_TROU
