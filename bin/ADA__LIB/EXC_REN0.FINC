if ~ definite REN0_PACK
include 'REN0_PACK.FINC'
end if
PRO	EXC_REN0_L1				;---------- PRO EXC_REN0
ELB 1					;    BODY ELAB
					;    end elab
begin:					;---------- BDY INSTRUCTIONS
VAR	exc_ctx, q, 9
	La	0, STANDARD.EXCEPTIONS_TOP_CTX_disp
	Sa  1,	exc_ctx
	LCA	L2
	Sa  1,	exc_ctx + STANDARD._EXCEPTION_CONTEXT.DISPATCH
	EXC_MACH  1,	exc_ctx
	LVA  1,	exc_ctx
	Sa	0, STANDARD.EXCEPTIONS_TOP_CTX_disp
	LCA	STANDARD.EXC_REN0_L1.ALIAS__exc.data_ptr
	Sa	0, STANDARD.EXCEPTIONS_CURRENT_disp
	BRA	STANDARD.exc_raise_
	La 0,	STANDARD.EXCEPTIONS_TOP_CTX_disp
	La , 0
	Sa 0,	STANDARD.EXCEPTIONS_TOP_CTX_disp
	BRA	L3
L2:
	La	0, STANDARD.EXCEPTIONS_CURRENT_disp
	LCA	STANDARD.REN0_PACK.ORIGINE__exc.data_ptr
	CEQ
	BT	L5
	BRA	L6
L5:
	BRA	L4
L6:
	BRA	STANDARD.exc_raise_
L4:
L3:
ret_lbl:
	UNLINK 1
	RTD
excep:
endPRO					;---------- end PRO EXC_REN0
