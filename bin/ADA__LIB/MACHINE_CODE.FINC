MACHINE_CODE = 'MACHINE_CODE'
namespace MACHINE_CODE			;---------- PACKAGE DECLARATION
ASM_OPCODE = 'ASM_OPCODE'
namespace ASM_OPCODE			; ASM_OPCODE ENUMERATION TYPE INFO
BEGIN_BLOC_DEF
db 0, 2, "ET"
db 1, 2, "OU"
db 2, 3, "NON"
db 3, 3, "OUX"
db 4, 7, "SYSCALL"
db 5, 12, "SYS_PUT_CHAR"
db 6, 11, "SYS_PUT_STR"
db 7, 12, "SYS_GET_CHAR"
db 8, 11, "SYS_GET_STR"
db 9, 15, "SYS_FILE_CREATE"
db 10, 13, "SYS_FILE_OPEN"
db 11, 14, "SYS_FILE_CLOSE"
db 12, 15, "SYS_FILE_DELETE"
db 13, 2, "DB"
db 14, 2, "LI"
db 15, 3, "LIF"
db 16, 3, "LCA"
db 17, 4, "LINK"
db 18, 6, "UNLINK"
db 19, 2, "LB"
db 20, 2, "LW"
db 21, 2, "LD"
db 22, 2, "LQ"
db 23, 2, "LA"
db 24, 3, "LIB"
db 25, 3, "LIW"
db 26, 3, "LID"
db 27, 3, "LIQ"
db 28, 3, "LIA"
db 29, 3, "LVA"
db 30, 2, "SB"
db 31, 2, "SW"
db 32, 2, "SD"
db 33, 2, "SQ"
db 34, 2, "SA"
db 35, 3, "SIB"
db 36, 3, "SIW"
db 37, 3, "SID"
db 38, 3, "SIQ"
db 39, 3, "SIA"
END_BLOC_DEF
IMAGES	BYTES_BLOC
CST LST, d, 39
CST FST, d, 0
CST SIZ, d, 8	; SIZ en bits !
end namespace

ASM_OPCODE_0 = 'ASM_OPCODE_0'
namespace ASM_OPCODE_0			; ASM_OPCODE_0 ENUMERATION SUBTYPE INFO
VAR SIZ, d
end namespace

ASM_OPCODE_1 = 'ASM_OPCODE_1'
namespace ASM_OPCODE_1			; ASM_OPCODE_1 ENUMERATION SUBTYPE INFO
VAR SIZ, d
end namespace

ASM_OPCODE_2 = 'ASM_OPCODE_2'
namespace ASM_OPCODE_2			; ASM_OPCODE_2 ENUMERATION SUBTYPE INFO
VAR SIZ, d
end namespace

ASM_OP_0 = 'ASM_OP_0'
namespace ASM_OP_0				; ASM_OP_0 RECORD TYPE INFO
VAR SIZ, d
USEINFO 0, OPCODE, 	LCA	STANDARD.MACHINE_CODE.ASM_OPCODE_0.SIZ
virtual at 0
STATOFS OPCODE, 1
size = $
end virtual
end namespace

ASM_OP_1 = 'ASM_OP_1'
namespace ASM_OP_1				; ASM_OP_1 RECORD TYPE INFO
VAR SIZ, d
USEINFO 0, OPCODE, 	LCA	STANDARD.MACHINE_CODE.ASM_OPCODE_1.SIZ
USEINFO 0, VAL, 	LVA	0, STANDARD.INTEGER.SIZ
virtual at 0
STATOFS OPCODE, 1
STATOFS VAL, 4
size = $
end virtual
end namespace

ASM_OP_2 = 'ASM_OP_2'
namespace ASM_OP_2				; ASM_OP_2 RECORD TYPE INFO
VAR SIZ, d
USEINFO 0, OPCODE, 	LCA	STANDARD.MACHINE_CODE.ASM_OPCODE_2.SIZ
USEINFO 0, LVL, 	LVA	0, STANDARD.NATURAL.SIZ
USEINFO 0, OFS, 	LVA	0, STANDARD.INTEGER.SIZ
virtual at 0
STATOFS OPCODE, 1
STATOFS LVL, 4
STATOFS OFS, 4
size = $
end virtual
end namespace

; EXC_LBL	L1
end namespace

