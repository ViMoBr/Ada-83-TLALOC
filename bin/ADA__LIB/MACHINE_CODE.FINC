MACHINE_CODE = 'MACHINE_CODE'
namespace MACHINE_CODE			;---------- PACKAGE DECLARATION

					; ASM_OPCODE ENUMERATION TYPE INFO
ASM_OPCODE = 'ASM_OPCODE'
namespace ASM_OPCODE
VAR use__info, q
BEGIN_BLOC_DEF
db 0, 2, "ET"
db 1, 2, "OU"
db 2, 3, "NON"
db 3, 3, "OUX"
db 4, 7, "SYSCALL"
db 5, 17, "SYS_CLOCK_GETTIME"
db 6, 12, "SYS_PUT_CHAR"
db 7, 11, "SYS_PUT_STR"
db 8, 12, "SYS_GET_CHAR"
db 9, 11, "SYS_GET_STR"
db 10, 15, "SYS_FILE_CREATE"
db 11, 13, "SYS_FILE_OPEN"
db 12, 16, "SYS_FILE_SET_POS"
db 13, 16, "SYS_FILE_GET_POS"
db 14, 17, "SYS_FILE_GET_SIZE"
db 15, 14, "SYS_FILE_WRITE"
db 16, 13, "SYS_FILE_READ"
db 17, 14, "SYS_FILE_CLOSE"
db 18, 15, "SYS_FILE_DELETE"
db 19, 2, "DB"
db 20, 2, "LI"
db 21, 3, "LIF"
db 22, 3, "LCA"
db 23, 4, "LINK"
db 24, 6, "UNLINK"
db 25, 3, "LVA"
db 26, 2, "LB"
db 27, 2, "LW"
db 28, 2, "LD"
db 29, 2, "LQ"
db 30, 2, "LA"
db 31, 2, "SB"
db 32, 2, "SW"
db 33, 2, "SD"
db 34, 2, "SQ"
db 35, 2, "SA"
db 36, 3, "LIB"
db 37, 3, "LIW"
db 38, 3, "LID"
db 39, 3, "LIQ"
db 40, 3, "LIA"
db 41, 3, "SIB"
db 42, 3, "SIW"
db 43, 3, "SID"
db 44, 3, "SIQ"
db 45, 3, "SIA"
END_BLOC_DEF
IMAGES	BYTES_BLOC
CST LST, d, 45
CST FST, d, 0
CST SIZ, d, 8	; SIZ en bits !
postpone
  align_q
end postpone
	LCA	SIZ
	Sa	0, use__info
end namespace

					; ASM_OPCODE_0 ENUMERATION SUBTYPE INFO
ASM_OPCODE_0 = 'ASM_OPCODE_0'
namespace ASM_OPCODE_0
VAR use__info, q
VAR SIZ, d
	LVA	0, SIZ
	Sa	0, use__info
VAR FST, b
VAR LST, b
	LI	8
	Sd	0, SIZ
	LI	0
	Sb	0, FST
	LI	18
	Sb	0, LST
VAR PARENT__u, q
	La	0, STANDARD.MACHINE_CODE.ASM_OPCODE.use__info
	Sa	0, PARENT__u
end namespace

