					; ASM_OP_0 RECORD TYPE INFO
ASM_OP_0 = 'ASM_OP_0'
namespace ASM_OP_0
VAR use__info, q
VAR SIZ, d
	LVA	0, SIZ
	Sa	0, use__info
USEINFO 0, OPCODE, 	La 0, STANDARD.MACHINE_CODE.ASM_OPCODE_0.use__info
virtual at 0				; calcul des offsets statiques
STATOFS OPCODE, 1
size = $
end virtual
	LI	 size*8
	Sd	0, SIZ
end namespace

					; ASM_OP_1 RECORD TYPE INFO
ASM_OP_1 = 'ASM_OP_1'
namespace ASM_OP_1
VAR use__info, q
VAR SIZ, d
	LVA	0, SIZ
	Sa	0, use__info
USEINFO 0, OPCODE, 	La 0, STANDARD.MACHINE_CODE.ASM_OPCODE_1.use__info
USEINFO 0, VAL, 	La 0, STANDARD.INTEGER.use__info
virtual at 0				; calcul des offsets statiques
STATOFS OPCODE, 1
STATOFS VAL, 4
size = $
end virtual
	LI	 size*8
	Sd	0, SIZ
end namespace

