					;---------- end generic package instantiation INT_IO
end namespace


if defined CHECK_L8_
PRO	CHECK_L8				;---------- PRO CHECK
 hexa_show 'CHECK_L8 ', $
PRMS					;    debut parametrage
	PRM COND_ofs				; in
	PRM SECTION_ofs				; in
	PRM NUM_ofs				; in
endPRMS					;    fin parametrage
ELB 2					;    BODY ELAB
					;    end elab
begin:					;---------- BDY INSTRUCTIONS
					; debut if
	ULb  2,	-COND_ofs
	BF	L12
	Ld 1,	STANDARD.OUT_RD1_L1.OK_COUNT_disp
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	1
	ADD
	Sd  1,	STANDARD.OUT_RD1_L1.OK_COUNT_disp
	BRA	L11
L12:
	Ld 1,	STANDARD.OUT_RD1_L1.FAIL_COUNT_disp
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	1
	ADD
	Sd  1,	STANDARD.OUT_RD1_L1.FAIL_COUNT_disp
STR STR_L13, "* ECHEC section"		; constante string="* ECHEC section"
	LCA	STR_L13.data_ptr
	CALL	STANDARD.TEXT_IO. ,PUT_L56
	Ld 1,	STANDARD.OUT_RD1_L1.INT_IO.DEFAULT_BASE_disp
	DUP
	Ld	0, STANDARD.TEXT_IO._NUMBER_BASE.FST
	CLT
	BT	STANDARD.ce_raise_
	DUP
	Ld	0, STANDARD.TEXT_IO._NUMBER_BASE.LST
	CGT
	BT	STANDARD.ce_raise_
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	2
	DUP
	Ld	0, STANDARD.TEXT_IO._FIELD.FST
	CLT
	BT	STANDARD.ce_raise_
	DUP
	Ld	0, STANDARD.TEXT_IO._FIELD.LST
	CGT
	BT	STANDARD.ce_raise_
	Ld  2,	-SECTION_ofs
	CALL	STANDARD.OUT_RD1_L1.INT_IO. ,PUT_L5
STR STR_L14, " test"			; constante string=" test"
	LCA	STR_L14.data_ptr
	CALL	STANDARD.TEXT_IO. ,PUT_L56
	Ld 1,	STANDARD.OUT_RD1_L1.INT_IO.DEFAULT_BASE_disp
	DUP
	Ld	0, STANDARD.TEXT_IO._NUMBER_BASE.FST
	CLT
	BT	STANDARD.ce_raise_
	DUP
	Ld	0, STANDARD.TEXT_IO._NUMBER_BASE.LST
	CGT
	BT	STANDARD.ce_raise_
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	3
	DUP
	Ld	0, STANDARD.TEXT_IO._FIELD.FST
	CLT
	BT	STANDARD.ce_raise_
	DUP
	Ld	0, STANDARD.TEXT_IO._FIELD.LST
	CGT
	BT	STANDARD.ce_raise_
	Ld  2,	-NUM_ofs
	CALL	STANDARD.OUT_RD1_L1.INT_IO. ,PUT_L5
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	1
	DUP
	ULd	0, STANDARD.TEXT_IO._POSITIVE_COUNT.FST
	CLT
	BT	STANDARD.ce_raise_
	DUP
	ULd	0, STANDARD.TEXT_IO._POSITIVE_COUNT.LST
	CGT
	BT	STANDARD.ce_raise_
	CALL	STANDARD.TEXT_IO. ,NEW_LINE_L26
L11:					; post if
ret_lbl:
	UNLINK 2
	RTD	prm_siz
excep:
endPRO					;---------- end PRO CHECK
end if

if defined SPLIT_L15_
PRO	SPLIT_L15				;---------- PRO SPLIT
 hexa_show 'SPLIT_L15 ', $
PRMS					;    debut parametrage
	PRM N_ofs				; in
	PRM Q_ofs				; out
	PRM R_ofs				; out
endPRMS					;    fin parametrage
ELB 2					;    BODY ELAB
					;    end elab
begin:					;---------- BDY INSTRUCTIONS
	Ld  2,	-N_ofs
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	10
	DUP
	LI	0
	CEQ
	BT	STANDARD.ne_raise_
	DIV
	SId  2,	-Q_ofs
	Ld  2,	-N_ofs
	LId  2,	-Q_ofs
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	10
	MUL
	SUB
	SId  2,	-R_ofs
ret_lbl:
	UNLINK 2
	RTD	prm_siz
excep:
endPRO					;---------- end PRO SPLIT
end if

if defined BUMP_L18_
PRO	BUMP_L18				;---------- PRO BUMP
 hexa_show 'BUMP_L18 ', $
PRMS					;    debut parametrage
	PRM B_ofs				; out
	PRM CNT_ofs				; out
endPRMS					;    fin parametrage
ELB 2					;    BODY ELAB
					;    end elab
begin:					;---------- BDY INSTRUCTIONS
	LI	1
	SIb  2,	-B_ofs
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	0
	SId  2,	-CNT_ofs
					; debut if
	ULIb  2,	-B_ofs
	BF	L22
	LId  2,	-CNT_ofs
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	1
	ADD
	SId  2,	-CNT_ofs
	BRA	L21
L22:
L21:					; post if
ret_lbl:
	UNLINK 2
	RTD	prm_siz
excep:
endPRO					;---------- end PRO BUMP
end if

if defined ACCUM_L23_
PRO	ACCUM_L23				;---------- PRO ACCUM
 hexa_show 'ACCUM_L23 ', $
PRMS					;    debut parametrage
	PRM N_ofs				; in
	PRM S_ofs				; out
endPRMS					;    fin parametrage
ELB 2					;    BODY ELAB
					;    end elab
begin:					;---------- BDY INSTRUCTIONS
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	0
	SId  2,	-S_ofs
VAR	IL27_disp, d				; compteur boucle LOOP__1
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	1
	Sd  2,	IL27_disp
VAR	LMT_IL27_disp, d			; limite boucle LOOP__1
	Ld  2,	-N_ofs
	Sd  2,	LMT_IL27_disp
	Ld  2,	IL27_disp				; test null range LOOP__1
	Ld  2,	LMT_IL27_disp
	CGT
	BT	L26
LOOP__1:					; corps boucle LOOP__1
	LId  2,	-S_ofs
	Ld 2,	IL27_disp
	ADD
	SId  2,	-S_ofs
	Ld  2,	IL27_disp				; test de sortie LOOP__1
	Ld  2,	LMT_IL27_disp
	CEQ
	BT	L26
	Ld  2,	IL27_disp				; mise a jour compteur LOOP__1
	INC
	Sd  2,	IL27_disp
	BRA	LOOP__1				; iteration suivante LOOP__1
L26:					; post loop LOOP__1
ret_lbl:
	UNLINK 2
	RTD	prm_siz
excep:
endPRO					;---------- end PRO ACCUM
end if
					;    end elab
begin:					;---------- BDY INSTRUCTIONS
STR STR_L30, "=== OUT_RD1 : relecture d'un parametre out ==="	; constante string="=== OUT_RD1 : relecture d'un parametre out ==="
	LCA	STR_L30.data_ptr
	CALL	STANDARD.TEXT_IO. ,PUT_LINE_L60
	LVA  1,	STANDARD.OUT_RD1_L1.R_disp
	LVA  1,	STANDARD.OUT_RD1_L1.Q_disp
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	37
	CALL	STANDARD.OUT_RD1_L1. ,SPLIT_L15
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	1
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	1
	Ld 1,	Q_disp
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	3
	CEQ
	CALL	STANDARD.OUT_RD1_L1. ,CHECK_L8
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	2
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	1
	Ld 1,	R_disp
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	7
	CEQ
	CALL	STANDARD.OUT_RD1_L1. ,CHECK_L8
	LVA  1,	STANDARD.OUT_RD1_L1.R_disp
	LVA  1,	STANDARD.OUT_RD1_L1.Q_disp
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	140
	CALL	STANDARD.OUT_RD1_L1. ,SPLIT_L15
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	3
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	1
	Ld 1,	Q_disp
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	14
	CEQ
	CALL	STANDARD.OUT_RD1_L1. ,CHECK_L8
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	4
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	1
	Ld 1,	R_disp
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	0
	CEQ
	CALL	STANDARD.OUT_RD1_L1. ,CHECK_L8
	LVA  1,	STANDARD.OUT_RD1_L1.R_disp
	LVA  1,	STANDARD.OUT_RD1_L1.Q_disp
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	5
	CALL	STANDARD.OUT_RD1_L1. ,SPLIT_L15
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	5
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	1
	Ld 1,	Q_disp
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	0
	CEQ
	CALL	STANDARD.OUT_RD1_L1. ,CHECK_L8
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	6
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	1
	Ld 1,	R_disp
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	5
	CEQ
	CALL	STANDARD.OUT_RD1_L1. ,CHECK_L8
	LVA  1,	STANDARD.OUT_RD1_L1.C_disp
	LVA  1,	STANDARD.OUT_RD1_L1.B_disp
	CALL	STANDARD.OUT_RD1_L1. ,BUMP_L18
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	1
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	2
	ULb 1,	B_disp
	CALL	STANDARD.OUT_RD1_L1. ,CHECK_L8
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	2
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	2
	Ld 1,	C_disp
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	1
	CEQ
	CALL	STANDARD.OUT_RD1_L1. ,CHECK_L8
	LVA  1,	STANDARD.OUT_RD1_L1.A_disp
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	4
	CALL	STANDARD.OUT_RD1_L1. ,ACCUM_L23
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	1
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	3
	Ld 1,	A_disp
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	10
	CEQ
	CALL	STANDARD.OUT_RD1_L1. ,CHECK_L8
	LVA  1,	STANDARD.OUT_RD1_L1.A_disp
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	0
	CALL	STANDARD.OUT_RD1_L1. ,ACCUM_L23
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	2
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	3
	Ld 1,	A_disp
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	0
	CEQ
	CALL	STANDARD.OUT_RD1_L1. ,CHECK_L8
STR STR_L31, "RESULTAT :"			; constante string="RESULTAT :"
	LCA	STR_L31.data_ptr
	CALL	STANDARD.TEXT_IO. ,PUT_L56
	Ld 1,	STANDARD.OUT_RD1_L1.INT_IO.DEFAULT_BASE_disp
	DUP
	Ld	0, STANDARD.TEXT_IO._NUMBER_BASE.FST
	CLT
	BT	STANDARD.ce_raise_
	DUP
	Ld	0, STANDARD.TEXT_IO._NUMBER_BASE.LST
	CGT
	BT	STANDARD.ce_raise_
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	3
	DUP
	Ld	0, STANDARD.TEXT_IO._FIELD.FST
	CLT
	BT	STANDARD.ce_raise_
	DUP
	Ld	0, STANDARD.TEXT_IO._FIELD.LST
	CGT
	BT	STANDARD.ce_raise_
	Ld 1,	OK_COUNT_disp
	CALL	STANDARD.OUT_RD1_L1.INT_IO. ,PUT_L5
STR STR_L32, " OK,"				; constante string=" OK,"
	LCA	STR_L32.data_ptr
	CALL	STANDARD.TEXT_IO. ,PUT_L56
	Ld 1,	STANDARD.OUT_RD1_L1.INT_IO.DEFAULT_BASE_disp
	DUP
	Ld	0, STANDARD.TEXT_IO._NUMBER_BASE.FST
	CLT
	BT	STANDARD.ce_raise_
	DUP
	Ld	0, STANDARD.TEXT_IO._NUMBER_BASE.LST
	CGT
	BT	STANDARD.ce_raise_
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	3
	DUP
	Ld	0, STANDARD.TEXT_IO._FIELD.FST
	CLT
	BT	STANDARD.ce_raise_
	DUP
	Ld	0, STANDARD.TEXT_IO._FIELD.LST
	CGT
	BT	STANDARD.ce_raise_
	Ld 1,	FAIL_COUNT_disp
	CALL	STANDARD.OUT_RD1_L1.INT_IO. ,PUT_L5
STR STR_L33, " ECHECS"			; constante string=" ECHECS"
	LCA	STR_L33.data_ptr
	CALL	STANDARD.TEXT_IO. ,PUT_LINE_L60
					; debut if
	Ld 1,	FAIL_COUNT_disp
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	0
	CEQ
	BF	L35
STR STR_L36, "OUT_RD1 PASSE"			; constante string="OUT_RD1 PASSE"
	LCA	STR_L36.data_ptr
	CALL	STANDARD.TEXT_IO. ,PUT_LINE_L60
	BRA	L34
L35:
L34:					; post if
ret_lbl:
	UNLINK 1
	RTD
excep:
endPRO					;---------- end PRO OUT_RD1
