if ~ definite TEXT_IO
include 'TEXT_IO.FINC'
end if
PRO	RECORD_TEST2_L1				;---------- PRO RECORD_TEST2
ELB 1					;    BODY ELAB

					; _KIND ENUMERATION TYPE INFO
_KIND = '_KIND'
namespace _KIND
VAR use__info, q
BEGIN_BLOC_DEF
db 0, 4, "LEAF"
db 1, 5, "UNARY"
db 2, 6, "BINARY"
END_BLOC_DEF
IMAGES	BYTES_BLOC
CST LST, d, 2
CST FST, d, 0
CST SIZ, d, 8	; SIZ en bits !
postpone
  align_q
end postpone
	LCA	SIZ
	Sa	1, use__info
end namespace

					; _MUT RECORD TYPE INFO
_MUT = '_MUT'
namespace _MUT
VAR use__info, q
VAR SIZ, d
	LVA	1, SIZ
	Sa	1, use__info
USEINFO 1, PT, 	La 1, STANDARD.RECORD_TEST2_L1._KIND.use__info
USEINFO 1, COL, 	La 0, STANDARD._INTEGER.use__info
USEINFO 1, VAL, 	La 0, STANDARD._INTEGER.use__info
USEINFO 1, OPU, 	La 0, STANDARD._INTEGER.use__info
USEINFO 1, GAU, 	La 0, STANDARD._INTEGER.use__info
USEINFO 1, DTE, 	La 0, STANDARD._INTEGER.use__info
virtual at 0				; calcul des offsets statiques
STATOFS PT, 1
STATOFS COL, 4
STATOFS VAL, 4
STATOFS OPU, 4
STATOFS GAU, 4
STATOFS DTE, 4
size = $
end virtual
	LI	 size*8
	Sd	1, SIZ
end namespace

					; _MLEAF CONSTRAINED RECORD VIEW
_MLEAF = '_MLEAF'
namespace _MLEAF
use__info = STANDARD.RECORD_TEST2_L1._MUT.use__info
SIZ = STANDARD.RECORD_TEST2_L1._MUT.SIZ
size = STANDARD.RECORD_TEST2_L1._MUT.size
PT = STANDARD.RECORD_TEST2_L1._MUT.PT
COL = STANDARD.RECORD_TEST2_L1._MUT.COL
VAL = STANDARD.RECORD_TEST2_L1._MUT.VAL
OPU = STANDARD.RECORD_TEST2_L1._MUT.OPU
GAU = STANDARD.RECORD_TEST2_L1._MUT.GAU
DTE = STANDARD.RECORD_TEST2_L1._MUT.DTE
end namespace

					; _BOX RECORD TYPE INFO
_BOX = '_BOX'
namespace _BOX
VAR use__info, q
VAR SIZ, d
	LVA	1, SIZ
	Sa	1, use__info
USEINFO 1, ID, 	La 0, STANDARD._INTEGER.use__info
USEINFO 1, N, 	La 1, STANDARD.RECORD_TEST2_L1._MUT.use__info
virtual at 0				; calcul des offsets statiques
STATOFS ID, 4
STATOFS N, 21
size = $
end virtual
	LI	 size*8
	Sd	1, SIZ
end namespace
VAR M_disp, q				; variable record : pointeur aux data record
VAR M__u, q				; variable record : pointeur aux useinfo
VAR M__dat, STANDARD.RECORD_TEST2_L1._MUT.size
	LVA	1, M__dat
	Sa	1, M_disp				; record fin
	LVA	1, STANDARD.RECORD_TEST2_L1._MUT.SIZ
	Sa	1, M__u
; CODE_VC_NAME DN_VARIABLE_ID
	LIVA 1, M_disp, STANDARD.RECORD_TEST2_L1._MUT.PT
	LI	0
	Sb

VAR K_disp, q				; variable record : pointeur aux data record
VAR K__u, q				; variable record : pointeur aux useinfo
VAR K__dat, STANDARD.RECORD_TEST2_L1._MUT.size
	LVA	1, K__dat
	Sa	1, K_disp				; record fin
	LVA	1, STANDARD.RECORD_TEST2_L1._MUT.SIZ
	Sa	1, K__u
; CODE_VC_NAME DN_VARIABLE_ID
	LIVA 1, K_disp, STANDARD.RECORD_TEST2_L1._MUT.PT
	LI	2
	Sb

VAR L_disp, q				; variable record : pointeur aux data record
VAR L__u, q				; variable record : pointeur aux useinfo
VAR L__dat, STANDARD.RECORD_TEST2_L1._MLEAF.size
	LVA	1, L__dat
	Sa	1, L_disp				; record fin
	LVA	1, STANDARD.RECORD_TEST2_L1._MLEAF.SIZ
	Sa	1, L__u
; CODE_VC_NAME DN_VARIABLE_ID
	LIVA 1, L_disp, STANDARD.RECORD_TEST2_L1._MUT.PT
	LI	0
	Sb

VAR BX_disp, q				; variable record : pointeur aux data record
VAR BX__u, q				; variable record : pointeur aux useinfo
VAR BX__dat, STANDARD.RECORD_TEST2_L1._BOX.size
	LVA	1, BX__dat
	Sa	1, BX_disp				; record fin
	LVA	1, STANDARD.RECORD_TEST2_L1._BOX.SIZ
	Sa	1, BX__u
; CODE_VC_NAME DN_VARIABLE_ID


if defined FLIP_L2_
PRO	FLIP_L2				;---------- PRO FLIP
PRMS					;    debut parametrage
	PRM R_ofs				; in out
endPRMS					;    fin parametrage
ELB 2					;    BODY ELAB
					;    end elab
begin:					;---------- BDY INSTRUCTIONS
	La  2,	-R_ofs
	La
					; Assign_record_aggregate type DN_RECORD
	DUP
	LVA	, STANDARD.RECORD_TEST2_L1._MUT.PT
	LI	1
	Sb
	DUP
	LVA	, STANDARD.RECORD_TEST2_L1._MUT.COL
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	9
	Sd
	DUP
	LVA	, STANDARD.RECORD_TEST2_L1._MUT.OPU
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	55
	Sd
	DROP
ret_lbl:
	UNLINK 2
	RTD	prm_siz
excep:
endPRO					;---------- end PRO FLIP
end if

if defined GEN_L3_
PRO	GEN_L3				;---------- PRO GEN
PRMS					;    debut parametrage
	PRM result__ofs				; resultat de fonction
endPRMS					;    fin parametrage
ELB 2					;    BODY ELAB
					;    end elab
begin:					;---------- BDY INSTRUCTIONS
; CODE_RETURN : EXPR TYPE = DN_RECORD
	La   2,	-result__ofs
	La  ,  0
					; Assign_record_aggregate type DN_RECORD
	DUP
	LVA	, STANDARD.RECORD_TEST2_L1._MUT.PT
	LI	2
	Sb
	DUP
	LVA	, STANDARD.RECORD_TEST2_L1._MUT.COL
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	2
	Sd
	DUP
	LVA	, STANDARD.RECORD_TEST2_L1._MUT.GAU
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	6
	Sd
	DUP
	LVA	, STANDARD.RECORD_TEST2_L1._MUT.DTE
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	7
	Sd
	DROP
	BRA ret_lbl
ret_lbl:
	UNLINK 2
	RTD
excep:
endPRO					;---------- end PRO GEN
end if
					;    end elab
begin:					;---------- BDY INSTRUCTIONS
STR STR_L4, "=== E1 : defauts et mutation par affectation ==="	; constante string="=== E1 : defauts et mutation par affectation ==="
