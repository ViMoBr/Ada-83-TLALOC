VAR PARAM__u, q				; variable record : pointeur aux useinfo
VAR PARAM__dat, STANDARD.IDL._TREE.size
	LVA	1, PARAM__dat
	Sa	1, PARAM_disp				; record fin
	LVA	1, STANDARD.IDL._TREE.SIZ
	Sa	1, PARAM__u
	La  1, PARAM_disp
					; store represented component PT range 0 .. 1 width 2
	DUP
	Ld
	LI	0
	LI	0
	LI	2
	BFI
	Sd

 hexa_show ' disp ', PARAM_disp
					;    end elab
begin:					;---------- BDY INSTRUCTIONS
LOOP__37:
	LI	0					; lieu resultat sur pile
	LVA 1,	PARAM_LIST_disp
	CALL	STANDARD.IDL. ,IS_EMPTY_L23
	LI	1
	OUX
	BF	L509
	LVA  1,	STANDARD.IDL.SEM_PHASE_L11.RED_SUBP.RESOLVE_ERRONEOUS_PARAM_S_L492.PARAM_disp
	LVA  1,	STANDARD.IDL.SEM_PHASE_L11.RED_SUBP.RESOLVE_ERRONEOUS_PARAM_S_L492.PARAM_LIST_disp
	CALL	STANDARD.IDL. ,POP_L24
					; debut if
	La	1, STANDARD.IDL.SEM_PHASE_L11.RED_SUBP.RESOLVE_ERRONEOUS_PARAM_S_L492.PARAM_disp
	Ld
	LI	24
	LI	8
	UBFX
	LI	131
	CEQ
	BF	L511
	LVA 1,	PARAM_disp
	La
	LI	STANDARD.IDL._TREE.size
VAR	ANON_1308_18_disp, q
VAR	ANON_1308_18__u,    q
VAR	ANON_1308_18__dat, STANDARD.IDL._TREE.size
	LVA 1, ANON_1308_18__dat
	Sa  1, ANON_1308_18_disp
	La  0, STANDARD.IDL._TREE.use__info
	Sa  1, ANON_1308_18__u
	LVA 1, ANON_1308_18_disp
					; doublet resultat record anonyme
	LVA 1,	PARAM_disp
	LI  22
	CALL	STANDARD.IDL. ,D_L17
	La
	BLKMOV
	BRA	L510
L511:
L510:					; post if
	LVA 1,	PARAM_disp
	La
	LI	STANDARD.IDL._TREE.size
VAR	ANON_1312_16_disp, q
VAR	ANON_1312_16__u,    q
VAR	ANON_1312_16__dat, STANDARD.IDL._TREE.size
	LVA 1, ANON_1312_16__dat
	Sa  1, ANON_1312_16_disp
	La  0, STANDARD.IDL._TREE.use__info
	Sa  1, ANON_1312_16__u
	LVA 1, ANON_1312_16_disp
					; doublet resultat record anonyme
	LVA  0,	STANDARD.IDL.TREE_VOID_disp		; array actual
	LVA 1,	PARAM_disp
	CALL	STANDARD.IDL.SEM_PHASE_L11.EXPRESO. ,RESOLVE_EXP_L158
	La
	BLKMOV
	BRA	LOOP__37
L509:					; post loop LOOP__37
ret_lbl:
	UNLINK 1
	RTD	prm_siz
excep:
endPRO					;---------- end PRO RESOLVE_ERRONEOUS_PARAM_S
end if

