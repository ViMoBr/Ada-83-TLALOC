					; _ACTUAL_TYPE RECORD TYPE INFO
_ACTUAL_TYPE = '_ACTUAL_TYPE'
namespace _ACTUAL_TYPE
VAR use__info, q
VAR SIZ, d
	LVA	1, SIZ
