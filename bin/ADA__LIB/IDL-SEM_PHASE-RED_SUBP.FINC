	LVA	1, STANDARD.IDL.SEM_PHASE_L11.SET_UTIL.EXTRAINFO_TYPE.SIZ
	Sa	1, SUB_EXTRAINFO__u
; CODE_VC_NAME DN_VARIABLE_ID

					;    end elab
begin:					;---------- BDY INSTRUCTIONS
VAR	IL249_disp, d				; compteur boucle LOOP__29
	LVA	1, -ACTUAL_ofs
	LIa	, , 8
	Ld	, ACTUAL_ARRAY_TYPE.FST_1
	Sd  1,	IL249_disp
VAR	LMT_IL249_disp, d			; limite boucle LOOP__29
	LVA	1, -ACTUAL_ofs
	LIa	, , 8
	Ld	, ACTUAL_ARRAY_TYPE.LST_1
	Sd  1,	LMT_IL249_disp
	Ld  1,	IL249_disp				; test null range LOOP__29
	Ld  1,	LMT_IL249_disp
	CGT
	BT	L248
LOOP__29:					; corps boucle LOOP__29
					; debut if
	LI	0					; lieu resultat sur pile
	LVA 1,	INDEX_LIST_disp
	CALL	STANDARD.IDL. ,IS_EMPTY_L23
	BF	L251
	LI	0
	SIb  1,	-ACTUALS_OK_ofs
	La  1,	-EXTRAINFO_ofs
	La
	LI	STANDARD.IDL.SEM_PHASE_L11.SET_UTIL.EXTRAINFO_TYPE.size
	LVA 1,	STANDARD.IDL.SEM_PHASE_L11.SET_UTIL.NULL_EXTRAINFO_disp
	La
	BLKMOV
	BRA ret_lbl
	BRA	L250
L251:
L250:					; post if
	LVA  1,	INDEX_disp
	LVA  1,	INDEX_LIST_disp
	CALL	STANDARD.IDL. ,POP_L24
	LVA  1,	SUB_EXTRAINFO_disp
	LVA  1,	NEW_ACTUALS_OK_disp
	VAR SELARG_L252_disp, q
	VAR SELARG_L252__u, q
	LVA	1, -ACTUAL_ofs
	LIa	, , 0				; array data start address on stack
	Ld	1, IL249_disp
	LVA	1, -ACTUAL_ofs
	LIa	, 0,  8
	Ld	, STANDARD.IDL.SEM_PHASE_L11.RED_SUBP.ACTUAL_ARRAY_TYPE.FST_1	; (index - FST_1) * SIZ_1
	SUB
	LVA	1, -ACTUAL_ofs
	LIa	, , 8
	Ld	, STANDARD.IDL.SEM_PHASE_L11.RED_SUBP.ACTUAL_ARRAY_TYPE.COMP_SIZ
	LI	8
	DIV
	MUL
	ADD					; add offset to start address
	LVA	, STANDARD.IDL.SEM_PHASE_L11.RED_SUBP.ACTUAL_TYPE.TYPESET
	Sa	1, SELARG_L252_disp
	La 1, STANDARD.IDL.SEM_PHASE_L11.SET_UTIL.TYPESET_TYPE.use__info
	Sa	1, SELARG_L252__u
	LVA 1, SELARG_L252_disp
VAR	ANON_1035_26_disp, q
VAR	ANON_1035_26__u,    q
VAR	ANON_1035_26__dat, STANDARD.IDL.TREE.size
	LVA 1, ANON_1035_26__dat
	Sa  1, ANON_1035_26_disp
	La  0, STANDARD.IDL.TREE.use__info
	Sa  1, ANON_1035_26__u
	LVA 1, ANON_1035_26_disp
					; doublet resultat record anonyme
VAR	ANON_1035_41_disp, q
VAR	ANON_1035_41__u,    q
VAR	ANON_1035_41__dat, STANDARD.IDL.TREE.size
	LVA 1, ANON_1035_41__dat
	Sa  1, ANON_1035_41_disp
	La  0, STANDARD.IDL.TREE.use__info
	Sa  1, ANON_1035_41__u
	LVA 1, ANON_1035_41_disp
					; doublet resultat record anonyme
	LVA 1,	INDEX_disp
	LI  33
	CALL	STANDARD.IDL. ,D_L17
	CALL	STANDARD.IDL.SEM_PHASE_L11.DEF_UTIL. ,GET_BASE_TYPE_L71
	CALL	STANDARD.IDL.SEM_PHASE_L11.RED_SUBP. ,CHECK_ACTUAL_TYPE_L6
					; debut if
	Lb 1,	NEW_ACTUALS_OK_disp
	BF	L254
	LVA 1,	SUB_EXTRAINFO_disp
	LVA  1,	NEW_EXTRAINFO_disp
	CALL	STANDARD.IDL.SEM_PHASE_L11.SET_UTIL. ,ADD_EXTRAINFO_L87
	BRA	L253
L254:
	LI	0
	SIb  1,	-ACTUALS_OK_ofs
	La  1,	-EXTRAINFO_ofs
	La
	LI	STANDARD.IDL.SEM_PHASE_L11.SET_UTIL.EXTRAINFO_TYPE.size
	LVA 1,	STANDARD.IDL.SEM_PHASE_L11.SET_UTIL.NULL_EXTRAINFO_disp
	La
	BLKMOV
	BRA ret_lbl
L253:					; post if
	Ld  1,	IL249_disp				; test de sortie LOOP__29
	Ld  1,	LMT_IL249_disp
	CEQ
	BT	L248
	Ld  1,	IL249_disp				; mise a jour compteur LOOP__29
	INC
	Sd  1,	IL249_disp
	BRA	LOOP__29				; iteration suivante LOOP__29
L248:					; post loop LOOP__29
					; debut if
	LI	0					; lieu resultat sur pile
	LVA 1,	INDEX_LIST_disp
	CALL	STANDARD.IDL. ,IS_EMPTY_L23
	LI	1
	OUX
	BF	L256
	LI	0
	SIb  1,	-ACTUALS_OK_ofs
	La  1,	-EXTRAINFO_ofs
	La
	LI	STANDARD.IDL.SEM_PHASE_L11.SET_UTIL.EXTRAINFO_TYPE.size
	LVA 1,	STANDARD.IDL.SEM_PHASE_L11.SET_UTIL.NULL_EXTRAINFO_disp
	La
	BLKMOV
	BRA ret_lbl
	BRA	L255
L256:
L255:					; post if
	LI	1
	SIb  1,	-ACTUALS_OK_ofs
	La  1,	-EXTRAINFO_ofs
	La
	LI	STANDARD.IDL.SEM_PHASE_L11.SET_UTIL.EXTRAINFO_TYPE.size
	LVA 1,	NEW_EXTRAINFO_disp
	La
	BLKMOV
ret_lbl:
	UNLINK 1
	RTD	prm_siz
excep:
endPRO					;---------- end PRO CHECK_SUBSCRIPT_LIST
end if

