if defined LENGTH_L1_
PRO	LENGTH_L1				;---------- PRO LENGTH
 hexa_show 'LENGTH_L1 ', $
PRMS					;    debut parametrage
	PRM LIST_ofs				; in
	PRM result__ofs				; resultat de fonction
endPRMS					;    fin parametrage
ELB 1					;    BODY ELAB
 hexa_show 'var elab LIST_TAIL ', $
VAR LIST_TAIL_disp, q			; variable record : pointeur aux data record
VAR LIST_TAIL__u, q				; variable record : pointeur aux useinfo
VAR LIST_TAIL__dat, STANDARD.IDL._SEQ_TYPE.size
	LVA	1, LIST_TAIL__dat
	Sa	1, LIST_TAIL_disp			; record fin
	LVA	1, STANDARD.IDL._SEQ_TYPE.SIZ
	Sa	1, LIST_TAIL__u
	La  1, LIST_TAIL_disp
	LI	STANDARD.IDL._SEQ_TYPE.size
	La  1,	-LIST_ofs
	La  ,  0
	BLKMOV

 hexa_show ' disp ', LIST_TAIL_disp
 hexa_show 'var elab COUNT ', $
VAR COUNT_disp, d				; variable entiere
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	0
	DUP
	Ld	0, STANDARD._NATURAL.FST
	CLT
	BT	STANDARD.ce_raise_
	DUP
	Ld	0, STANDARD._NATURAL.LST
	CGT
	BT	STANDARD.ce_raise_
	Sd  1,	COUNT_disp

 hexa_show ' disp ', COUNT_disp
					;    end elab
begin:					;---------- BDY INSTRUCTIONS
LOOP__1:
	LI	0					; lieu resultat sur pile
	LVA 1,	LIST_TAIL_disp
	CALL	STANDARD.IDL. ,IS_EMPTY_L23
	LI	1
	OUX
	BF	L17
	LVA 1,	LIST_TAIL_disp
	La
	LI	STANDARD.IDL._SEQ_TYPE.size
VAR	ANON_55_20_disp, q
VAR	ANON_55_20__u,    q
VAR	ANON_55_20__dat, STANDARD.IDL._SEQ_TYPE.size
	LVA 1, ANON_55_20__dat
	Sa  1, ANON_55_20_disp
	La  0, STANDARD.IDL._SEQ_TYPE.use__info
	Sa  1, ANON_55_20__u
	LVA 1, ANON_55_20_disp
					; doublet resultat record anonyme
	LVA 1,	LIST_TAIL_disp
	CALL	STANDARD.IDL.IDL_MAN. ,TAIL_L32
	La
	BLKMOV
	Ld 1,	COUNT_disp
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	1
	ADD
	DUP
	Ld	0, STANDARD._NATURAL.FST
	CLT
	BT	STANDARD.ce_raise_
	DUP
	Ld	0, STANDARD._NATURAL.LST
	CGT
	BT	STANDARD.ce_raise_
	Sd  1,	COUNT_disp
	BRA	LOOP__1
L17:					; post loop LOOP__1
; CODE_RETURN : EXPR TYPE = DN_INTEGER  VUE COMPLETE = DN_INTEGER
	Ld 1,	COUNT_disp
	DUP
	Ld	0, STANDARD._NATURAL.FST
	CLT
	BT	STANDARD.ce_raise_
	DUP
	Ld	0, STANDARD._NATURAL.LST
	CGT
	BT	STANDARD.ce_raise_
	Sq  1,	-result__ofs
	BRA ret_lbl
ret_lbl:
	UNLINK 1
	RTD	prm_siz-8
excep:
endPRO					;---------- end PRO LENGTH
end if

