					; _ACTUAL_TYPE RECORD TYPE INFO
_ACTUAL_TYPE = '_ACTUAL_TYPE'
namespace _ACTUAL_TYPE
VAR use__info, q
VAR SIZ, d
	LVA	0, SIZ
	Sa	0, use__info
USEINFO 0, SYM, 	La 0, STANDARD.IDL._TREE.use__info
USEINFO 0, EXP, 	La 0, STANDARD.IDL._TREE.use__info
USEINFO 0, TYPESET, 	La 1, STANDARD.IDL.SEM_PHASE_L11.SET_UTIL._TYPESET_TYPE.use__info
virtual at 0				; calcul des offsets statiques
STATOFS SYM, 4
STATOFS EXP, 4
STATOFS TYPESET, 8
size = $
end virtual
	LI	 size*8
	Sd	0, SIZ
end namespace

					; _ACTUAL_ARRAY_TYPE UNCONSTRAINED ARRAY SUBTYPE INFO
_ACTUAL_ARRAY_TYPE = '_ACTUAL_ARRAY_TYPE'
namespace _ACTUAL_ARRAY_TYPE
VAR use__info, q
VAR SIZ, d
	LVA	0, SIZ
	Sa	0, use__info
	LI	1
	NEG
	Sd	0, SIZ
  virtual at 4				; use info offsets pour acces sur array contraint

COMP_SIZ = $
	rd 1 
FST_1 = $
	rd 1 
LST_1 = $
	rd 1 
  end virtual
end namespace
