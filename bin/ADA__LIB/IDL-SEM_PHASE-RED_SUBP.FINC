	LVA	1, STANDARD.IDL.SEQ_TYPE.SIZ
	Sa	1, LIST_TAIL__u
; CODE_VC_NAME DN_VARIABLE_ID
	La  1, LIST_TAIL_disp
	LI	STANDARD.IDL.SEQ_TYPE.size
	La  1,	-LIST_ofs
	La  ,  0
	BLKMOV

VAR COUNT_disp, d				; variable entiere
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	0
	Sd  1,	COUNT_disp

					;    end elab
begin:					;---------- BDY INSTRUCTIONS
LOOP__1:
	LI	0					; lieu resultat sur pile
	LVA 1,	LIST_TAIL_disp
	CALL	STANDARD.IDL. ,IS_EMPTY_L23
	LI	1
	OUX
	BF	L22
	LVA 1,	LIST_TAIL_disp
	La
	LI	STANDARD.IDL.SEQ_TYPE.size
VAR	ANON_55_20_disp, q
VAR	ANON_55_20__u,    q
VAR	ANON_55_20__dat, STANDARD.IDL.SEQ_TYPE.size
	LVA 1, ANON_55_20__dat
	Sa  1, ANON_55_20_disp
	La  0, STANDARD.IDL.SEQ_TYPE.use__info
	Sa  1, ANON_55_20__u
	LVA 1, ANON_55_20_disp
					; doublet resultat record anonyme
	LVA 1,	LIST_TAIL_disp
	CALL	STANDARD.IDL.IDL_MAN. ,TAIL_L32
	La
	BLKMOV
	Ld 1,	COUNT_disp
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	1
	ADD
	Sd  1,	COUNT_disp
	BRA	LOOP__1
L22:					; post loop LOOP__1
; CODE_RETURN : EXPR TYPE = DN_INTEGER
	Ld 1,	COUNT_disp
	Sd  1,	-result__ofs
	BRA ret_lbl
ret_lbl:
	UNLINK 1
	RTD	prm_siz-8
excep:
endPRO					;---------- end PRO LENGTH
end if

