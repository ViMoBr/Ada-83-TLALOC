include 'TEXT_IO.FINC'
PRO	GET_CHAR_L1				;---------- PRO GET_CHAR
ELB 1					;    BODY ELAB
VAR C_disp, b				; variable bool char

					;    end elab
begin:					;---------- BDY INSTRUCTIONS
STR STR_L2, 'Tapez un caractere : '		; constante string='Tapez un caractere : '
	LCA	STR_L2.data_ptr
	CALL	STANDARD.TEXT_IO. ,PUT_L56
	LVA  1,	C_disp
	CALL	STANDARD.TEXT_IO. ,GET_L50
	LI	60
	CALL	STANDARD.TEXT_IO. ,PUT_L52
	Lb 1,	C_disp
	CALL	STANDARD.TEXT_IO. ,PUT_L52
	LI	62
	CALL	STANDARD.TEXT_IO. ,PUT_L52
	LI	1
	CALL	STANDARD.TEXT_IO. ,NEW_LINE_L26
ret_lbl:
	UNLINK 1
	RTD
excep:
endPRO					;---------- end PRO GET_CHAR
