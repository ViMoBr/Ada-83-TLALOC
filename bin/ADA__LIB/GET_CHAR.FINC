if ~ definite TEXT_IO
include 'TEXT_IO.FINC'
display 'including withed unit TEXT_IO.FINC', 10
end if
if ~ definite IO_EXCEPTIONS
include 'IO_EXCEPTIONS.FINC'
display 'including trans withed unit IO_EXCEPTIONS.FINC', 10
end if
if ~ definite TEXT_IO
include 'TEXT_IO.FINC'
display 'including trans withed unit TEXT_IO.FINC', 10
end if
GET_CHAR = 'GET_CHAR'
PRO	GET_CHAR_L1
 hexa_show 'GET_CHAR_L1 ', $
ELB 1
 hexa_show 'var elab C ', $
VAR C_disp, B

 hexa_show ' disp ', C_disp

begin:
STR STR_L4, "Tape un caractere : "
	LCA	STR_L4.data_ptr
	CALL	STANDARD.TEXT_IO. ,PUT_L56
	LVA  1,	STANDARD.GET_CHAR_L1.C_disp
	CALL	STANDARD.TEXT_IO. ,GET_L50
STR STR_L5, ""
	LCA	STR_L5.data_ptr
	CALL	STANDARD.TEXT_IO. ,PUT_LINE_L60
STR STR_L6, "Lu = "
	LCA	STR_L6.data_ptr
	CALL	STANDARD.TEXT_IO. ,PUT_L56
	ULB 1,	C_disp
	CALL	STANDARD.TEXT_IO. ,PUT_L52
	LI	1
	DUP
	ULD	0, STANDARD.TEXT_IO._POSITIVE_COUNT.FST
	CLT
	BT	STANDARD.ce_raise_
	DUP
	ULD	0, STANDARD.TEXT_IO._POSITIVE_COUNT.LST
	CGT
	BT	STANDARD.ce_raise_
	CALL	STANDARD.TEXT_IO. ,NEW_LINE_L26
ret_lbl:
	UNLINKR 1
	RTD
excep:
endPRO
