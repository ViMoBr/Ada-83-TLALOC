FILE_TYPE = 'FILE_TYPE'
namespace FILE_TYPE
VAR use__info, q
VAR SIZ, d
	LVA	0, SIZ
	Sa	0, use__info
USEINFO 0, ID, 	La 0, STANDARD.INTEGER.use__info
USEINFO 0, NAME, 	La 0, STANDARD.IDL.PAGE_MAN.PAGE_IO.FILE_NAME_BUFFER.use__info
USEINFO 0, NAME_LEN, 	La 0, STANDARD.POSITIVE.use__info
USEINFO 0, IS_OPENED, 	La 0, STANDARD.BOOLEAN.use__info
USEINFO 0, MODE, 	La 0, STANDARD.IDL.PAGE_MAN.PAGE_IO.FILE_MODE.use__info
USEINFO 0, INDEX, 	La 0, STANDARD.IDL.PAGE_MAN.POSITIVE_COUNT.use__info
USEINFO 0, AT_END_OF_FILE, 	La 0, STANDARD.BOOLEAN.use__info
virtual at 0				; calcul des offsets statiques
STATOFS ID, 4
STATOFS NAME, 256
STATOFS NAME_LEN, 4
STATOFS IS_OPENED, 1
STATOFS MODE, 1
STATOFS INDEX, 4
STATOFS AT_END_OF_FILE, 1
size = $
end virtual
	LI	 size*8
	Sd	0, SIZ
end namespace
					;---------- end generic package instantiation PAGE_IO
