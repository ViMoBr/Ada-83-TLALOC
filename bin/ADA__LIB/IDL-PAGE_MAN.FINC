USEINFO 0, VP, 	La 0, STANDARD.IDL.PAGE_MAN.VPG_IDX.use__info
USEINFO 0, AREA, 	La 0, STANDARD.IDL.PAGE_MAN.AREA_IDX.use__info
USEINFO 0, CHANGED, 	La 0, STANDARD.BOOLEAN.use__info
USEINFO 0, RECUPERABLE, 	La 0, STANDARD.BOOLEAN.use__info
USEINFO 0, DATA, 	La 0, STANDARD.IDL.PAGE_MAN.A_SECTOR.use__info
virtual at 0				; calcul des offsets statiques
STATOFS VP, 2
STATOFS AREA, 4
STATOFS CHANGED, 1
STATOFS RECUPERABLE, 1
STATOFS DATA, 8
size = $
end virtual
	LI	 size*8
	Sd	0, SIZ
end namespace
