	Sw
	DUP
	LVA	, STANDARD.IDL.PAGE_MAN._AREA_DATA.FREE_LINE
	LI	 0
	Sw
	DROP
L144:					; post if
ret_lbl:
	UNLINK 1
	RTD	prm_siz
excep:
endPRO					;---------- end PRO ALLOC_PAGE
end if

