	ADD					; add offset to start address
	LVA	, STANDARD.IDL.PAGE_MAN.RPG_DATA.CHANGED
	LI	1
	Sb
	BRA	L107
L108:
L107:					; post if
	UNLINK 2
endPRO
VAR	IL110_disp, d				; compteur boucle LOOP__5
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	1
	Sd  1,	IL110_disp
VAR	LMT_IL110_disp, d			; limite boucle LOOP__5
; CODE_NUMERIC_LITERAL DN_UNIVERSAL_INTEGER
	LI	50
	Sd  1,	LMT_IL110_disp
	Ld  1,	IL110_disp				; test null range LOOP__5
	Ld  1,	LMT_IL110_disp
	CGT
	BT	L109
LOOP__5:					; corps boucle LOOP__5
	Ld  1,	IL110_disp
	CALL	STANDARD.IDL.PAGE_MAN. ,FREE_PAGE_L62
	Ld  1,	IL110_disp				; test de sortie LOOP__5
	Ld  1,	LMT_IL110_disp
	CEQ
	BT	L109
	Ld  1,	IL110_disp				; mise a jour compteur LOOP__5
	INC
	Sd  1,	IL110_disp
	BRA	LOOP__5				; iteration suivante LOOP__5
L109:					; post loop LOOP__5
					; debut if
	Lb 0,	STANDARD.IDL.PAGE_MAN.PAGE_MAN_DEBUG_disp
	BF	L112
STR STR_L113, "page_man : close_page_manager"	; constante string="page_man : close_page_manager"
	LCA	STR_L113.data_ptr
	CALL	STANDARD.TEXT_IO. ,PUT_LINE_L60
	BRA	L111
L112:
L111:					; post if
	LVA  0,	WORK_FILE_disp
	CALL	STANDARD.IDL.PAGE_MAN.PAGE_IO. ,CLOSE_L14
ret_lbl:
	UNLINK 1
	RTD
excep:
endPRO					;---------- end PRO CLOSE_PAGE_MANAGER
end if

