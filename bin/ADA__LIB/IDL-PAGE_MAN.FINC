					; debut if
	Lb 0,	STANDARD.IDL.PAGE_MAN.PAGE_MAN_DEBUG_disp
	BF	L153
STR STR_L154, "page_man : close_page_manager"	; constante string="page_man : close_page_manager"
	LCA	STR_L154.data_ptr
	CALL	STANDARD.TEXT_IO. ,PUT_LINE_L60
