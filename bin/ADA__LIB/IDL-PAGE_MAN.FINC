	LId	0, STANDARD.IDL.PAGE_MAN.AREA__u, STANDARD.IDL.PAGE_MAN._AREA__type.LST_1
	CGT
	BT	STANDARD.ce_raise_
	LId	0, STANDARD.IDL.PAGE_MAN.AREA__u, STANDARD.IDL.PAGE_MAN._AREA__type.FST_1	; (index - FST_1) * SIZ_1
