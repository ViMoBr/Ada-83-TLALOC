	Lb  2,	LMT_IL63_disp
	CGT
	BT	L62
LOOP__5:					; corps boucle LOOP__5
	LVA 2,	T_disp
	Lb  2,	IL63_disp
	CALL	STANDARD.IDL.IDL_MAN. ,DABS_L37
	Lb  2,	IL63_disp				; test de sortie LOOP__5
	Lb  2,	LMT_IL63_disp
	CEQ
	BT	L62
	Lb  2,	IL63_disp				; mise a jour compteur LOOP__5
	INC
	Sb  2,	IL63_disp
	BRA	LOOP__5				; iteration suivante LOOP__5
L62:					; post loop LOOP__5
	UNLINK 2
endPRO
