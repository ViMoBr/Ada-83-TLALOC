namespace	BLOCK__1
ELB 2					;    BODY ELAB
					;    end elab
begin:					;---------- BDY INSTRUCTIONS
VAR	exc_ctx_L59, q, 10
	La	0, STANDARD.EXCEPTIONS_TOP_CTX_disp
	Sa  2,	exc_ctx_L59
	LCA	L59
	Sa  2,	exc_ctx_L59 + STANDARD._EXCEPTION_CONTEXT.DISPATCH
	EXC_MACH  2,	exc_ctx_L59
	LVA  2,	exc_ctx_L59
	Sa	0, STANDARD.EXCEPTIONS_TOP_CTX_disp
STR STR_L61, "diana"			; constante string="diana"
	LCA	STR_L61.data_ptr
	CALL	STANDARD.IDL.IDL_TBL. ,READ_SPEC_L55
	La 0,	STANDARD.EXCEPTIONS_TOP_CTX_disp
	La , 0
	Sa 0,	STANDARD.EXCEPTIONS_TOP_CTX_disp
	BRA	L60
L59:
	La	0, STANDARD.EXCEPTIONS_CURRENT_disp
	Sa  2,	exc_ctx_L59
	La	0, STANDARD.EXCEPTIONS_CURRENT_disp
	LCA	STANDARD.IO_EXCEPTIONS.NAME_ERROR__exc.data_ptr
	CEQ
	BT	L63
	BRA	L64
L63:
STR STR_L65, "diana"			; constante string="diana"
	LCA	STR_L65.data_ptr
	CALL	STANDARD.IDL.IDL_TBL. ,INIT_SPEC_L53
STR STR_L66, "diana"			; constante string="diana"
	LCA	STR_L66.data_ptr
	CALL	STANDARD.IDL.IDL_TBL. ,WRITE_SPEC_L54
	BRA	L62
L64:
	BRA	STANDARD.exc_raise_
L62:
L60:
	UNLINK 2
endPRO
	La  1,	-PAGE_FILE_NAME_ofs
	CALL	STANDARD.IDL.PAGE_MAN. ,CREATE_PAGE_MANAGER_L14
