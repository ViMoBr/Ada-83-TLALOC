if defined OPEN_IDL_TREE_FILE_L6_
PRO	OPEN_IDL_TREE_FILE_L6			;---------- PRO OPEN_IDL_TREE_FILE
 hexa_show 'OPEN_IDL_TREE_FILE_L6 ', $
PRMS					;    debut parametrage
	PRM PAGE_FILE_NAME_ofs			; in
endPRMS					;    fin parametrage
ELB 1					;    BODY ELAB
					;    end elab
begin:					;---------- BDY INSTRUCTIONS
	La  1,	-PAGE_FILE_NAME_ofs
	CALL	STANDARD.IDL.PAGE_MAN. ,OPEN_PAGE_MANAGER_L15
namespace	BLOCK__6
ELB 2					;    BODY ELAB
					;    end elab
begin:					;---------- BDY INSTRUCTIONS
VAR	exc_ctx_L96, q, 10
	La	0, STANDARD.EXCEPTIONS_TOP_CTX_disp
	Sa  2,	exc_ctx_L96
	LCA	L96
	Sa  2,	exc_ctx_L96 + STANDARD._EXCEPTION_CONTEXT.DISPATCH
	EXC_MACH  2,	exc_ctx_L96
	LVA  2,	exc_ctx_L96
	Sa	0, STANDARD.EXCEPTIONS_TOP_CTX_disp
STR STR_L98, "diana"			; constante string="diana"
	LCA	STR_L98.data_ptr
	CALL	STANDARD.IDL.IDL_TBL. ,READ_SPEC_L55
	La 0,	STANDARD.EXCEPTIONS_TOP_CTX_disp
	La , 0
	Sa 0,	STANDARD.EXCEPTIONS_TOP_CTX_disp
	BRA	L97
L96:
	La	0, STANDARD.EXCEPTIONS_CURRENT_disp
	Sa  2,	exc_ctx_L96
	La	0, STANDARD.EXCEPTIONS_CURRENT_disp
	LCA	STANDARD.IO_EXCEPTIONS.NAME_ERROR__exc.data_ptr
	CEQ
	BT	L100
	BRA	L101
L100:
STR STR_L102, "diana.bin FILE MISSING"		; constante string="diana.bin FILE MISSING"
	LCA	STR_L102.data_ptr
	CALL	STANDARD.TEXT_IO. ,PUT_LINE_L60
	LCA	STANDARD.PROGRAM_ERROR__exc.data_ptr
	Sa	0, STANDARD.EXCEPTIONS_CURRENT_disp
	BRA	STANDARD.exc_raise_
	BRA	L99
L101:
	BRA	STANDARD.exc_raise_
L99:
L97:
	UNLINK 2
endPRO
ret_lbl:
	UNLINK 1
	RTD	prm_siz
excep:
endPRO					;---------- end PRO OPEN_IDL_TREE_FILE
end if

