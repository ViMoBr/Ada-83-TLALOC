if defined MAKE_L15_
PRO	MAKE_L15				;---------- PRO MAKE
PRMS					;    debut parametrage
	PRM NN_ofs				; in
	PRM result__ofs				; resultat de fonction
endPRMS					;    fin parametrage
ELB 1					;    BODY ELAB
					;    end elab
begin:					;---------- BDY INSTRUCTIONS
					; debut if
	La	 0, N_SPEC_disp				; array data start address on stack
	Lb  1,	-NN_ofs
	LId	0, N_SPEC__u, STANDARD.IDL.IDL_TBL._NODE_SPECIF_TABLE.FST_1	; (index - FST_1) * SIZ_1
	SUB
	LId	0, N_SPEC__u, STANDARD.IDL.IDL_TBL._NODE_SPECIF_TABLE.COMP_SIZ
	LI	8
	DIV
	MUL
	ADD					; add offset to start address
	Lw	, STANDARD.IDL.IDL_TBL._NODE_SPECIF.NS_SIZE
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	0
	CEQ
	BF	L88
; CODE_RETURN : EXPR TYPE = DN_RECORD
	La   1,	-result__ofs
	La  ,  0
					; Assign_represented_record_aggregate size 32 bits
	DUP
	LI	0
					; pack PT range 0 .. 1 width 2
	LI	0
	LI	0
	LI	2
	BFI
					; pack TY range 24 .. 31 width 8
	Lb  1,	-NN_ofs
	LI	24
	LI	8
	BFI
					; pack PG range 9 .. 23 width 15
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	0
	LI	9
	LI	15
	BFI
					; pack LN range 2 .. 8 width 7
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	0
	LI	2
	LI	7
	BFI
	Sd
	DROP
	BRA ret_lbl
	BRA	L87
L88:
; CODE_RETURN : EXPR TYPE = DN_RECORD
	La   1,	-result__ofs
	La  ,  0
	LI	STANDARD.IDL._TREE.size
VAR	ANON_294_14_disp, q
VAR	ANON_294_14__u,    q
VAR	ANON_294_14__dat, STANDARD.IDL._TREE.size
	LVA 1, ANON_294_14__dat
	Sa  1, ANON_294_14_disp
	La  0, STANDARD.IDL._TREE.use__info
	Sa  1, ANON_294_14__u
	LVA 1, ANON_294_14_disp
					; doublet resultat record anonyme
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	1
	La	 0, N_SPEC_disp				; array data start address on stack
	Lb  1,	-NN_ofs
