	LVA	0, TREE_NIL__dat
	Sa	0, TREE_NIL_disp			; record fin
	LVA	0, STANDARD.IDL.TREE.SIZ
	Sa	0, TREE_NIL__u
	La 0, TREE_NIL_disp
	DROP

VAR TREE_VOID_disp, q			; variable record : pointeur aux data record
