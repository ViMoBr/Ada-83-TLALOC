	Sa   1, RET_INFO_L144
	DROP
	La   1, -result__ofs
	La  ,  8
	LI	16
	La   1, RET_INFO_L144
	BLKMOV
	BRA ret_lbl
ret_lbl:
	UNLINK 1
	RTD	prm_siz-8
excep:
endPRO					;---------- end PRO ANONYMOUS_NAME_AT
end if

