IDL = 'IDL'
namespace IDL				;---------- PACKAGE
elab_spec:				;    SPEC ELAB

VAR PROJECT_PATH_disp, q			; variable array : pointeur aux data
VAR PROJECT_PATH__u, q			; variable array : useinfo pointeur au rec info
	La 0, STRING.use__info
	Sa	0, PROJECT_PATH__u			; array info ptr at __u
	Ld	0, STRING.SIZ
	LI	8
	DIV
	CO_VAR
	Sa	0, PROJECT_PATH_disp			; array data ptr at _disp
					; array data aggregate
	La	0, PROJECT_PATH_disp
VAR	CNT_ANON_14_48, d
	LI	256
	Sd 0,	CNT_ANON_14_48
ANON_14_48:
	DUP
	LI	32
	Sb
	LI	1
	ADD
	LI	0
	Ld 0,	CNT_ANON_14_48
	DEC
	CEQ
	BF	ANON_14_48
	DROP

VAR PROJECT_PATH_LENGTH_disp, d		; variable entiere
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	0
	Sd  0,	PROJECT_PATH_LENGTH_disp

VAR LIB_PATH_disp, q			; variable array : pointeur aux data
VAR LIB_PATH__u, q				; variable array : useinfo pointeur au rec info
	La 0, STRING.use__info
	Sa	0, LIB_PATH__u				; array info ptr at __u
	Ld	0, STRING.SIZ
	LI	8
	DIV
	CO_VAR
	Sa	0, LIB_PATH_disp			; array data ptr at _disp
					; array data aggregate
	La	0, LIB_PATH_disp
VAR	CNT_ANON_17_44, d
	LI	256
	Sd 0,	CNT_ANON_17_44
ANON_17_44:
	DUP
	LI	32
	Sb
	LI	1
	ADD
	LI	0
	Ld 0,	CNT_ANON_17_44
	DEC
	CEQ
	BF	ANON_17_44
	DROP

VAR LIB_PATH_LENGTH_disp, d			; variable entiere
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	0
	Sd  0,	LIB_PATH_LENGTH_disp

VAR DEFAULT_LIB_PATH_disp, q			; variable array : pointeur aux data
VAR DEFAULT_LIB_PATH__u, q			; variable array : useinfo pointeur au rec info
	La 0, STRING.use__info
	Sa	0, DEFAULT_LIB_PATH__u			; array info ptr at __u
STR DEFAULT_LIB_PATH, "ADA__LIB/"		; constante string="ADA__LIB/"
	LCA	DEFAULT_LIB_PATH.data_ptr
	La
	Sa	0, DEFAULT_LIB_PATH_disp			; array data ptr at _disp
	LCA	DEFAULT_LIB_PATH.info_ptr
	La
	Sa	0, DEFAULT_LIB_PATH__u			; array info ptr at __u


