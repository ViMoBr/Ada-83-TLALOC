VAR	LMT_NL120_disp, b			; limite boucle LOOP__9
	Lw 2,	NB_DOUBLETS_disp
	Sb  2,	LMT_NL120_disp
	Lb  2,	NL120_disp				; test null range LOOP__9
	Lb  2,	LMT_NL120_disp
	CGT
	BT	L119
LOOP__9:					; corps boucle LOOP__9
	La	 2, DD_disp				; array data start address on stack
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	1
	LId	2, DD__u, STANDARD.IDL.DI_L20.INTEGER_OVER_SHORT._DOUBLET.FST_1	; (index - FST_1) * SIZ_1
