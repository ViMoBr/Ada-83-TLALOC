	Ld 2,	Q_disp
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	10000
	MODI
; CODE CONVERSION SOURCE DN_INTEGER TARGET DN_INTEGER
	Sw
	Ld 2,	Q_disp
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	10000
	DIV
	Sd  2,	Q_disp
	La	 2, DD_disp				; array data start address on stack
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	2
	LId	2, DD__u, STANDARD.IDL.DI_L20.INTEGER_OVER_SHORT._DOUBLET.FST_1	; (index - FST_1) * SIZ_1
	SUB
	LId	2, DD__u, STANDARD.IDL.DI_L20.INTEGER_OVER_SHORT._DOUBLET.COMP_SIZ
	LI	8
	DIV
	MUL
	ADD					; add offset to start address
	Ld 2,	Q_disp
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	10000
	MODI
; CODE CONVERSION SOURCE DN_INTEGER TARGET DN_INTEGER
	Sw
	Ld 2,	Q_disp
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	10000
	DIV
	Sd  2,	Q_disp
VAR	ANON_400_20_disp, q
VAR	ANON_400_20__u,    q
VAR	ANON_400_20__dat, STANDARD.IDL._TREE.size
