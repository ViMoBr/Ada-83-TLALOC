					; VPTR_TYPE ENUMERATION TYPE INFO
VPTR_TYPE = 'VPTR_TYPE'
namespace VPTR_TYPE
VAR use__info, q
BEGIN_BLOC_DEF
db 0, 1, "P"
db 1, 1, "S"
db 2, 1, "L"
db 3, 2, "HI"
END_BLOC_DEF
IMAGES	BYTES_BLOC
CST LST, d, 3
CST FST, d, 0
CST SIZ, d, 8	; SIZ en bits !
postpone
  align_q
end postpone
	LCA	SIZ
	Sa	0, use__info
end namespace

					; TREE RECORD TYPE INFO
TREE = 'TREE'
namespace TREE
VAR use__info, q
VAR SIZ, d
	LVA	0, SIZ
	Sa	0, use__info
USEINFO 0, PT, 	La 0, STANDARD.IDL.VPTR_TYPE.use__info
virtual at 0				; calcul des offsets statiques
	LI 0	 ; offset a faire
	Sd	0, PT__o
size = $
end virtual
	LI	 size*8
	Sd	0, SIZ
; TRAITER_LES_CHAMPS SM_SIZETREE
end namespace
VAR TREE_NIL_disp, q			; variable record : pointeur aux data record
VAR TREE_NIL__u, q				; variable record : pointeur aux useinfo
