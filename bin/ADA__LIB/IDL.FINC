	Ld 2,	Q_disp
	NEG
	Sd  2,	Q_disp
	La	2, ENTETE_disp
					; store represented component ABSS range 9 .. 23 width 15
	DUP
	Ld
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	1
	LI	9
	LI	15
	BFI
	Sd
	LVA 2,	ENTETE_disp
	LVA 2,	NUM_VAL_disp
; CODE_NUMERIC_LITERAL DN_INTEGER
