 hexa_show ' disp ', APOS_disp
VAR APOS_disp, d				; variable entiere
	La	 0, STANDARD.IDL.IDL_TBL.N_SPEC_disp	; array data start address on stack
	La 1, -T_ofs
	La	-1, 0
