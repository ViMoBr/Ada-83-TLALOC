	Sd  1,	APOS_disp

					;    end elab
begin:					;---------- BDY INSTRUCTIONS
VAR	IL114_disp, b				; compteur boucle LOOP__7
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	1
	Sb  1,	IL114_disp
